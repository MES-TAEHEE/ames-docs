# PDF build intermediates (per-file PDFs / cover / toc HTML)
build/

# .NET build artifacts (solution under src/ and every console tool under tools/)
src/**/bin/
src/**/obj/
tools/**/bin/
tools/**/obj/
publish/
bin/
obj/
*.pdb
# Ignore Visual Studio publish profiles created per-project
**/Properties/PublishProfiles/
# Ignore executable binaries
*.exe
*.user
.vs/

# Temp commit messages (heredoc workaround)
COMMIT_MSG.tmp

