@inject AppState State
@implements IDisposable

@*  AppRoot subscribes to AppState changes and re-cascades the current
    Session down to every page. Login.razor sets the session; logout clears
    it; the router does the rest. *@

<CascadingValue Value="State.Session">
    <CascadingValue Value="State">
        <App />
    </CascadingValue>
</CascadingValue>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= OnStateChanged;
}
