@*  Top-level Blazor wrapper used by PopBlazorForm.
    Cascades the operator's PopSessionDto down to every page so they don't
    each have to pull it from a service. Initial route is supplied via
    BlazorWebView.StartPath. *@

<CascadingValue Value="@Session">
    <App />
</CascadingValue>

@code {
    [Parameter] public PopSessionDto Session { get; set; } = null!;
}
