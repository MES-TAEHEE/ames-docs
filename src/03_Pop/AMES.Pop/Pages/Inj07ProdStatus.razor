@page "/inj07"
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">INJ-07 · PRODUCTION STATUS · SUPERVISOR VIEW</span>
        </div>
        <div class="pop-tbar-r">
            <span>@Session?.EmployeeName · @Session?.ShiftCode</span>
            <span>@_now.ToString("yyyy-MM-dd HH:mm")</span>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.Inj07Help))" />
        </div>
    </div>

    <div class="pop-bd">
        <div class="kpi-row">
            <div class="kpi-card">
                <div class="l">Today Good</div>
                <div class="v ok">@_totalGood.ToString("N0")</div>
                <div class="s">EA · today across all INJ lines</div>
            </div>
            <div class="kpi-card">
                <div class="l">Today Defect</div>
                <div class="v warn">@_totalDef.ToString("N0")</div>
                <div class="s">EA · @_ratePct%</div>
            </div>
            <div class="kpi-card">
                <div class="l">Defect %</div>
                <div class="v @_rateClass">@_ratePct%</div>
                <div class="s">limit 5%</div>
            </div>
            <div class="kpi-card">
                <div class="l">INJ Lines</div>
                <div class="v">@_lines.Count</div>
                <div class="s">@_lines.Count(l => l.EquipStatus == "RUN") running</div>
            </div>
            <div class="kpi-card">
                <div class="l">Down Machines</div>
                <div class="v @(_downCount > 0 ? "alert" : "ok")">@_downCount</div>
                <div class="s">@(_downCount > 0 ? "needs attention" : "all clear")</div>
            </div>
        </div>

        <div class="pop-card hourly-chart">
            <div class="pop-card-h">▼ HOURLY OUTPUT · @Session?.LineId · today</div>
            <div class="hc-bars">
                @for (var h = 6; h <= 17; h++)
                {
                    var bucket = _hourly?.FirstOrDefault(x => x.Hour == h);
                    var max = Math.Max(20, _hourlyMax);
                    var pct = bucket is null ? 0 : (int)((bucket.GoodQty + bucket.DefectQty) * 100.0 / max);
                    var cls = h == _now.Hour ? "hc-bar now" : (h > _now.Hour ? "hc-bar target" : "hc-bar");
                    <div class="@cls" style="height:@(h > _now.Hour ? 100 : Math.Clamp(pct, 2, 100))%;"></div>
                }
            </div>
            <div class="hc-labels">
                @for (var h = 6; h <= 17; h++) { <div class="@(h == _now.Hour ? "now" : "")">@h.ToString("00")</div> }
            </div>
        </div>

        <table class="line-tbl">
            <thead>
                <tr><th>Line</th><th>Name</th><th>Status</th><th>Today Good</th><th>Today Defect</th><th>Defect %</th></tr>
            </thead>
            <tbody>
                @foreach (var l in _lines)
                {
                    var statusPill = l.EquipStatus switch
                    {
                        "RUN"  => "<span class=\"pill run\">● RUN</span>",
                        "STOP" => "<span class=\"pill mc\">⚙ STOP</span>",
                        _      => $"<span class=\"pill mc\">{l.EquipStatus ?? "—"}</span>"
                    };
                    <tr>
                        <td class="mono"><strong>@l.LineId</strong></td>
                        <td>@l.LineName</td>
                        <td>@((MarkupString)statusPill)</td>
                        <td>@l.TodayGood.ToString("N0")</td>
                        <td>@l.TodayDefect.ToString("N0")</td>
                        <td>@l.DefectRatePct.ToString("0.0")%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pop-nav" style="--nav-cols:8;">
        <button class="nav-btn" @onclick="@(() => Go("inj02"))">INJ-02<small>Dashboard</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj03"))">INJ-03<small>WO Confirm</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj04"))">INJ-04<small>Prod Entry</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj05"))">INJ-05<small>Defect</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj06"))">INJ-06<small>Mold Change</small></button>
        <button class="nav-btn active" @onclick="@(() => Go("inj07"))">INJ-07<small>Prod Status</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj08"))">INJ-08<small>Andon</small></button>
        <button class="nav-btn muted" @onclick="Logout">LOGOUT<small>End shift</small></button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }

    List<LineSummaryDto>           _lines = new();
    IReadOnlyList<HourlyOutputDto>? _hourly;
    int _totalGood, _totalDef, _downCount, _hourlyMax = 1;
    string _ratePct = "0.0", _rateClass = "ok";
    DateTime _now = DateTime.Now;
    System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        Refresh();
        _timer = new System.Threading.Timer(_ => InvokeAsync(() => { _now = DateTime.Now; Refresh(); StateHasChanged(); }),
                                            null, 10_000, 10_000);
    }

    void Refresh()
    {
        if (Session is null) return;
        _lines = PopServices.Dashboard.GetLinesForProcess("INJ");
        _totalGood = _lines.Sum(l => l.TodayGood);
        _totalDef  = _lines.Sum(l => l.TodayDefect);
        var rate   = (_totalGood + _totalDef) == 0 ? 0 : _totalDef * 100.0 / (_totalGood + _totalDef);
        _ratePct   = rate.ToString("0.0");
        _rateClass = rate >= 5 ? "alert" : rate >= 4 ? "warn" : "ok";
        _downCount = _lines.Count(l => l.EquipStatus is "STOP" or "ALARM" or "OFFLINE");

        _hourly = PopServices.Production.GetHourlyToday(Session.LineId);
        _hourlyMax = _hourly?.Max(h => h.GoodQty + h.DefectQty) ?? 1;
    }

    void Logout() { State.SignOut(); Nav.NavigateTo("/login"); }
    public void Dispose() => _timer?.Dispose();
    private void Go(string r) => Nav.NavigateTo("/" + r);
}
