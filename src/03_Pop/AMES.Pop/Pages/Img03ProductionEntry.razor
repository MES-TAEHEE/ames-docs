@page "/img03"
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject ConfirmService Confirmer

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">IMG-003 · PRODUCTION ENTRY · @Session?.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span class="stat-on">● RUN</span>
            <span>@Session?.EmployeeName · @Session?.ShiftCode</span>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.Img03Help))" />
        </div>
    </div>

    <div class="pop-bd">
        <div class="entry-grid">
            <div class="entry-info">
                <div class="entry-h">▼ CURRENT WO</div>
                <div class="entry-wo">@(_wo?.WoNumber ?? "—")</div>
                <div class="entry-name">@(_wo?.ItemName ?? "—")</div>

                <div class="entry-h" style="margin-top:14px;">▼ PROGRESS</div>
                <div class="entry-prog">
                    <span class="entry-prog-v">@(_wo?.CompletedQty.ToString("0") ?? "—")</span>
                    <span class="entry-prog-t">/ @(_wo?.OrderQty.ToString("0") ?? "—")</span>
                </div>
                <div class="entry-bar"><div class="entry-bar-fill" style="width:@_pct%;"></div></div>

                <div class="entry-h" style="margin-top:14px;">▼ STATS</div>
                <div class="entry-stats">
                    <div class="es"><div class="es-l">Today Good</div><div class="es-v">@_todayGood</div></div>
                    <div class="es"><div class="es-l">Today Defect</div><div class="es-v @_defClass">@_todayDef · @_defectPct</div></div>
                    <div class="es" style="grid-column:span 2;">
                        <div class="es-l">Fabric Roll · 원단</div>
                        <div class="es-v @_fabricClass">@_fabricLabel<br>@_fabricSub</div>
                    </div>
                    <div class="es" style="grid-column:span 2;">
                        <div class="es-l">Bond Recipe</div>
                        <div class="es-v">@_bondLabel</div>
                    </div>
                </div>
            </div>

            <div class="entry-input">
                <div class="input-label">Good Qty This Cycle · 사이클당 양품 (EA)</div>
                <div class="input-display">@(_buf.Length == 0 ? "0" : _buf.ToString())</div>
                <div class="keypad">
                    @foreach (var d in new[] { "1","2","3","4","5","6","7","8","9" })
                    { var k = d; <div class="kp" @onclick="@(() => Press(k))">@k</div> }
                    <div class="kp ct"  @onclick="LoadCt">CT</div>
                    <div class="kp"     @onclick="@(() => Press("0"))">0</div>
                    <div class="kp del" @onclick="Backspace">←</div>
                </div>
                <div class="entry-btn-row">
                    <button class="entry-btn entry-btn-warn" @onclick="@(() => Nav.NavigateTo("/img05"))">❌ Defect → IMG-005</button>
                    <button class="entry-btn entry-btn-ok" disabled="@(!CanConfirm)" @onclick="Confirm">
                        ✓ Confirm · deduct @(MetresPerUnit * (int.TryParse(_buf.ToString(), out var q) ? q : 0)) m
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:3;">
        <button class="nav-btn active" @onclick="@(() => Go("img03"))">IMG-003<small>Prod Entry</small></button>
        <button class="nav-btn" @onclick="@(() => Go("img05"))">IMG-005<small>Defect</small></button>
        <button class="nav-btn muted" @onclick="Logout">LOGOUT<small>End shift</small></button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }
    const decimal MetresPerUnit = 0.25m;

    WorkOrderDto?   _wo;
    FabricRollDto?  _roll;
    BondSetupDto?   _bond;
    int             _cycle = 38, _pct, _todayGood, _todayDef, _lastResultId;
    string          _defectPct = "0.0%", _defClass = "ok";
    string          _fabricLabel = "—", _fabricSub = "(no roll)", _fabricClass = "alert";
    string          _bondLabel = "(no recipe)";
    System.Text.StringBuilder _buf = new();

    bool CanConfirm => _wo is not null
                      && int.TryParse(_buf.ToString(), out var q) && q > 0
                      && (_roll is null || _roll.RemainingM >= q * MetresPerUnit);

    protected override void OnInitialized() => Refresh();

    void Refresh()
    {
        if (Session is null) return;
        _wo   = PopServices.WorkOrders.GetActiveForTerminal(Session.LineId, Session.TerminalId)
             ?? PopServices.WorkOrders.ListForLine(Session.LineId).FirstOrDefault();
        _roll = PopServices.Fabric.GetMountedRoll(Session.LineId);
        _bond = PopServices.Bond.GetActiveForLine(Session.LineId);

        if (_wo is not null)
        {
            _pct       = (int)Math.Clamp(_wo.ProgressPct, 0, 100);
            _todayGood = PopServices.Production.GetTodayGoodForWo(_wo.WoId);
            var (g, d) = PopServices.Defects.GetWoTotals(_wo.WoId);
            _todayDef  = d;
            var pct    = (g + d) == 0 ? 0 : d * 100.0 / (g + d);
            _defectPct = $"{pct:0.0}%";
            _defClass  = pct >= 5 ? "alert" : pct >= 4 ? "warn" : "ok";
            if (!string.IsNullOrEmpty(_wo.RecipeId)) _cycle = PopServices.Master.GetRecipeCycleTime(_wo.RecipeId) ?? 38;
        }
        if (_roll is not null)
        {
            _fabricLabel = $"{_roll.LotCode} · {_roll.ColorCode}";
            _fabricSub   = $"{_roll.RemainingM:0.0} m · 0.25 m/EA";
            _fabricClass = _roll.RemainingM <= 5 ? "alert" : _roll.RemainingM <= 10 ? "warn" : "ok";
        }
        if (_bond is not null)
        {
            _bondLabel = $"{_bond.RecipeId} · {_bond.TempSp:0}°C / {_bond.PressureSp:0.0}bar / {_bond.HoldSecSp}s";
        }
    }

    void Press(string d) { if (_buf.Length >= 2) return; if (_buf.Length == 0 && d == "0") return; _buf.Append(d); }
    void Backspace()     { if (_buf.Length > 0) _buf.Length--; }
    void LoadCt()        { _buf.Clear(); _buf.Append('1'); }

    void Confirm()
    {
        if (_wo is null || Session is null) return;
        if (!int.TryParse(_buf.ToString(), out var qty) || qty <= 0) return;
        var required = qty * MetresPerUnit;
        if (_roll is not null && _roll.RemainingM < required) return;
        try
        {
            var (resultId, _, _) = PopServices.Production.RecordCycle(
                _wo.WoId, _wo.ItemNo, _wo.LineId, "IMG", qty, _cycle, moldId: null,
                Session.OperatorId, Session.SessionId, Session.EmployeeNo, defectFlag: false);
            if (_roll is not null)
                PopServices.Fabric.DeductFromRoll(_roll.LotId, required, resultId, Session.EmployeeNo, Session.OperatorId);
            if (_bond is not null)
                PopServices.Bond.LogCycle(resultId, _bond.BondSetupId,
                    _bond.PressureSp, _bond.TempSp, _bond.HoldSecSp,
                    _bond.TensionSp, withinSpec: true, Session.EmployeeNo);
            _lastResultId = resultId;
            _buf.Clear();
            Refresh();
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[IMG-003 Confirm] {ex.Message}"); }
    }

    async Task Logout() { if (!await Confirmer.AskAsync("Log out?", "End your shift and return to the login screen?", "Log out", "Stay", destructive: true)) return; Nav.NavigateTo("/login", replace: true); State.SignOut(); }
    public void Dispose() { }
    private void Go(string r) => Nav.NavigateTo("/" + r);
}
