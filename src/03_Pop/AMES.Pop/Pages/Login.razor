@page "/login"
@implements IDisposable
@using AMES.Data.Repositories
@inject AppState State
@inject NavigationManager Nav

@*  Mirrors the VOL05_INJ01 SHIFT-LOGIN mockup: top bar with terminal id,
    centered card with badge-scan zone + PIN keypad + info row, animated
    LED clock. Dev convenience: a SELECT USER button opens a modal list
    of seeded operators so testers don't have to type the badge number.
*@

<div class="login-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">@(_selLine?.ProcessCode ?? "—") · @(_selStation?.StationCode ?? "—") · @(_selLine?.LineID ?? "—")</span>
        </div>
        <div class="pop-tbar-r">
            <span class="stat-on">● @T("Online")</span>
            <span>@_now.ToString("yyyy-MM-dd HH:mm:ss")</span>
            <button class="injm-lang-btn" @onclick="ToggleLang">@(PopLang.IsKo ? "EN" : "한국어")</button>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.LoginHelp))" />
        </div>
    </div>

    <div class="login-body">
        <div class="login-card">
            <div class="login-title">@T("ShiftLogin")</div>
            <div class="login-sub">@T("ScanYourBadgeOrEnterYourPin")</div>

            <div class="login-sel-row">
                <button class="login-sel-btn @(_selLine is null ? "need" : "")"
                        @onclick="@(() => _showLinePicker = true)">
                    <div class="lsb-l">@T("Line")</div>
                    <div class="lsb-v">@(_selLine is null ? T("SelectLine") : LineLabel(_selLine)) ▾</div>
                </button>
                <button class="login-sel-btn @(_selLine is not null && _selStation is null ? "need" : "")"
                        disabled="@(_selLine is null)"
                        @onclick="@(() => _showStationPicker = true)">
                    <div class="lsb-l">@T("Station")</div>
                    <div class="lsb-v">@(_selStation is null ? T("SelectStation") : StationLabel(_selStation)) ▾</div>
                </button>
            </div>
            @if (_loadErr is not null)
            {
                <div class="picker-err">@T("MasterLoadFailed", _loadErr)
                    <button class="injm-lang-btn" @onclick="RetryLoad">@T("Retry")</button>
                </div>
            }

            <div class="badge-zone" @onclick="OpenPicker">
                <div class="badge-icon">[ BADGE ]</div>
                <div class="badge-text">
                    @if (_pickedNo is null)
                    {
                        <div class="badge-h">@T("ScanEmployeeBadge")</div>
                        <div class="badge-s">@T("Code128BarcodeUsbHidScannerOrTapHereToPi")</div>
                    }
                    else
                    {
                        <div class="badge-h" style="color:var(--ok);">@_pickedNo · @_pickedName</div>
                        <div class="badge-s">@T("TapToSwitchUser")</div>
                    }
                </div>
            </div>

            <div class="login-or">───── @T("OrEnterPin") ─────</div>

            <div class="pin-dots">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="pin-dot @(i < _pin.Length ? "on" : "")"></div>
                }
            </div>

            <div class="login-keypad">
                @foreach (var d in new[] { "1","2","3","4","5","6","7","8","9" })
                {
                    var k = d;
                    <button class="login-key" @onclick="@(() => Press(k))">@k</button>
                }
                <button class="login-key del" @onclick="Backspace">←</button>
                <button class="login-key"     @onclick="@(() => Press("0"))">0</button>
                <button class="login-key ok"  @onclick="Submit">✓</button>
            </div>

            <div class="login-status @_statusClass">@_status</div>
        </div>
    </div>

    @if (_showPicker)
    {
        <div class="picker-backdrop" @onclick="@(() => _showPicker = false)">
            <div class="picker-modal" @onclick:stopPropagation="true">
                <div class="picker-h">👤 @T("SelectUser")</div>
                <div class="picker-list">
                    @foreach (var p in _profiles)
                    {
                        <button class="picker-row" @onclick="@(() => Pick(p))">
                            <div class="picker-no">@p.EmployeeNo</div>
                            <div class="picker-name">@p.EmployeeName</div>
                            <div class="picker-lines">@(string.IsNullOrEmpty(p.AssignedLinesJson) ? T("AllLines") : p.AssignedLinesJson)</div>
                        </button>
                    }
                </div>
                <button class="picker-cancel" @onclick="@(() => _showPicker = false)">✕  @T("Cancel")</button>
            </div>
        </div>
    }

    @if (_showLinePicker)
    {
        <div class="picker-backdrop" @onclick="@(() => _showLinePicker = false)">
            <div class="picker-modal" @onclick:stopPropagation="true">
                <div class="picker-h">@T("SelectLine")</div>
                <div class="picker-list">
                    @foreach (var l in _lines)
                    {
                        var line = l;
                        <button class="picker-row" @onclick="@(() => PickLine(line))">
                            <div class="picker-no">@line.LineID</div>
                            <div class="picker-name">@(PopLang.IsKo ? line.LineName : line.LineNameEn ?? line.LineName)</div>
                            <div class="picker-lines">@line.ProcessCode</div>
                        </button>
                    }
                    @if (_lines.Count == 0)
                    {
                        <div class="picker-empty">@(_loadErr is not null ? T("MasterLoadFailed", _loadErr) : T("NoLinesRegistered"))</div>
                    }
                </div>
                <button class="picker-cancel" @onclick="@(() => _showLinePicker = false)">✕  @T("Cancel")</button>
            </div>
        </div>
    }

    @if (_showStationPicker)
    {
        <div class="picker-backdrop" @onclick="@(() => _showStationPicker = false)">
            <div class="picker-modal" @onclick:stopPropagation="true">
                <div class="picker-h">@T("SelectStation")</div>
                <div class="picker-list">
                    @foreach (var s in _stations)
                    {
                        var st = s;
                        <button class="picker-row" @onclick="@(() => PickStation(st))">
                            <div class="picker-no">@st.StationCode</div>
                            <div class="picker-name">@(PopLang.IsKo ? st.StationName : st.StationNameEn ?? st.StationName)</div>
                            <div class="picker-lines">@(st.OrderSeq?.ToString() ?? "")</div>
                        </button>
                    }
                    @if (_stations.Count == 0)
                    {
                        <div class="picker-empty">@(_loadErr is not null ? T("MasterLoadFailed", _loadErr) : T("NoStationsRegistered"))</div>
                    }
                </div>
                <button class="picker-cancel" @onclick="@(() => _showStationPicker = false)">✕  @T("Cancel")</button>
            </div>
        </div>
    }
</div>

@code {
    static string T(string key, params object?[] args) => PopLang.T(key, args);
    void ToggleLang() => PopLang.Lang = PopLang.IsKo ? "en" : "ko";

    System.Text.StringBuilder _pin = new();
    string?  _pickedNo, _pickedName;
    string   _status = " ", _statusClass = "dim";
    bool     _showPicker;
    List<EmployeeProfileDto> _profiles = new();
    DateTime _now = DateTime.Now;
    System.Threading.Timer? _clock;

    List<MasterDataRepository.PopLineOptionRow> _lines    = new();
    List<MasterDataRepository.StationRow>       _stations = new();
    MasterDataRepository.PopLineOptionRow? _selLine;
    MasterDataRepository.StationRow?       _selStation;
    bool _showLinePicker, _showStationPicker;
    string? _loadErr;

    // 프로세스 수명 동안 직전 선택 프리필 (재시작하면 빈 상태 — 스펙 결정사항)
    static string? s_lastLineId, s_lastStationCode;

    protected override void OnInitialized()
    {
        _profiles = PopServices.Auth.ListAllProfiles();
        _clock = new System.Threading.Timer(_ => InvokeAsync(() => { _now = DateTime.Now; StateHasChanged(); }), null, 1000, 1000);
        LoadLines();
    }

    void LoadLines()
    {
        try
        {
            _loadErr = null;
            _lines = PopServices.Master.ListPopLineOptions();
            if (_selLine is null && s_lastLineId is not null
                && _lines.FirstOrDefault(l => l.LineID == s_lastLineId) is { } prev)
            {
                _selLine = prev;
                LoadStations();
                _selStation = _stations.FirstOrDefault(s => s.StationCode == s_lastStationCode) ?? _selStation;
            }
        }
        catch (Exception ex) { _loadErr = ex.Message; _lines = new(); }
    }

    void LoadStations()
    {
        try
        {
            _loadErr = null;
            _stations = _selLine is null ? new() : PopServices.Master.ListActiveStations(_selLine.LineID);
            // 선택지가 하나뿐이면 굳이 고르게 하지 않는다.
            if (_selStation is null && _stations.Count == 1) _selStation = _stations[0];
        }
        catch (Exception ex) { _loadErr = ex.Message; _stations = new(); }
    }

    void RetryLoad()
    {
        LoadLines();
        // 재조회 결과에 맞춰 기존 선택을 재검증 — 사라진 라인/스테이션은 해제.
        if (_selLine is not null)
        {
            _selLine = _lines.FirstOrDefault(l => l.LineID == _selLine.LineID);
            if (_selLine is not null)
            {
                LoadStations();
                if (_selStation is not null)
                    _selStation = _stations.FirstOrDefault(s => s.StationCode == _selStation.StationCode);
            }
            else _selStation = null;
        }
    }

    void PickLine(MasterDataRepository.PopLineOptionRow l)
    {
        _selLine = l; _selStation = null; _showLinePicker = false;
        LoadStations();
        _showStationPicker = _selStation is null;   // 단일 스테이션이 자동 선택되면 픽커 생략
    }

    void PickStation(MasterDataRepository.StationRow s)
    {
        _selStation = s; _showStationPicker = false;
    }

    static string LineLabel(MasterDataRepository.PopLineOptionRow l)
        => $"{l.LineID}" + ((PopLang.IsKo ? l.LineName : l.LineNameEn ?? l.LineName) is { Length: > 0 } n ? $" · {n}" : "");

    static string StationLabel(MasterDataRepository.StationRow s)
        => $"{s.StationCode}" + ((PopLang.IsKo ? s.StationName : s.StationNameEn ?? s.StationName) is { Length: > 0 } n ? $" · {n}" : "");

    void OpenPicker() => _showPicker = true;

    void Pick(EmployeeProfileDto p)
    {
        _pickedNo   = p.EmployeeNo;
        _pickedName = p.EmployeeName;
        _showPicker = false;
        SetStatus(T("SelectedUser", p.EmployeeNo), "ok");
    }

    void Press(string d)
    {
        if (_pin.Length >= 4) return;
        _pin.Append(d);
        if (_pin.Length == 4) Submit();
    }
    void Backspace() { if (_pin.Length > 0) _pin.Length--; }

    void Submit()
    {
        if (_selLine is null || _selStation is null)
        { SetStatus(T("SelectLineAndStationFirst"), "fail"); return; }
        if (_pin.Length < 4) { SetStatus(T("PinMustBe4Digits"), "fail"); return; }

        var attemptedId = _pickedNo ?? "E001";
        var outcome = PopServices.PopAuth.Login(new AMES.Contracts.Auth.LoginRequest
        {
            AttemptedId = attemptedId,
            Pin         = _pin.ToString(),
            Method      = AMES.Contracts.Enums.AuthMethod.Pin,
            TerminalId  = _selStation.StationCode,
            LineId      = _selLine.LineID,
            ShiftCode   = AppConfig.Current.DefaultShift,
        });
        _pin.Clear();

        if (outcome.IsSuccess && outcome.Session is not null)
        {
            SetStatus(T("WelcomeUser", outcome.Session.EmployeeName), "ok");
            s_lastLineId      = _selLine.LineID;
            s_lastStationCode = _selStation.StationCode;
            // 모듈의 권위는 선택 라인의 WC ProcessCode — appsettings 아님.
            State.SignIn(outcome.Session, _selLine.ProcessCode);
            var target = _selLine.ProcessCode switch
            {
                "QC"  => "/qc07",
                "PNT" => "/pnt02",
                "IMG" => "/img02",
                _     => "/injmain"
            };
            Nav.NavigateTo(target);
            return;
        }
        SetStatus($"× {outcome.Result} — {outcome.FailReason}", "fail");
    }

    void SetStatus(string text, string cls) { _status = text; _statusClass = cls; }

    public void Dispose() => _clock?.Dispose();
}
