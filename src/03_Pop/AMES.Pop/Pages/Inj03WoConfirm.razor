@page "/inj03"
@implements IDisposable
@inject NavigationManager Nav

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">INJ-03 · WO CONFIRM · @Session.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span class="stat-on">● @(_wos.Count) WO READY</span>
            <span>@Session.EmployeeName · @Session.ShiftCode</span>
        </div>
    </div>

    <div class="pop-bd">
        <div class="wo-list">
            @if (_wos.Count == 0)
            {
                <div class="pop-card" style="text-align:center; padding:50px;">
                    <div style="font-size:28px; color:rgba(255,255,255,.5);">No Released WOs for this line</div>
                    <div style="font-size:13px; color:rgba(255,255,255,.35); margin-top:10px;">PP planner needs to release a WO first.</div>
                </div>
            }
            @foreach (var w in _wos)
            {
                var isSel = _selected?.WoId == w.WoId;
                var prioClass = w.Priority <= 2 ? "high" : "norm";
                var prioText  = w.Priority <= 2 ? "🔥 HIGH" : "▪ NORMAL";
                var dDay      = w.DaysToDue is null ? "" : $"D-{w.DaysToDue}";
                <div class="wo-card @(isSel ? "on" : "")" @onclick="@(() => Select(w))">
                    <div class="wo-card-top">
                        <div class="wo-card-id">@w.WoNumber</div>
                        <div class="wo-card-prio @prioClass">@prioText · @dDay</div>
                    </div>
                    <div class="wo-card-name">@w.ItemName · @w.ItemNameEn (@w.ItemNo)</div>
                    <div class="wo-card-grid">
                        <div><div class="wo-card-l">Target Qty</div><div class="wo-card-v">@w.OrderQty.ToString("0") EA</div></div>
                        <div><div class="wo-card-l">Mold</div><div class="wo-card-v">@(w.MoldId ?? "—")</div></div>
                        <div><div class="wo-card-l">Recipe</div><div class="wo-card-v">@(w.RecipeId ?? "—")</div></div>
                        <div><div class="wo-card-l">Status</div><div class="wo-card-v">@w.Status</div></div>
                    </div>

                    @if (isSel)
                    {
                        <div class="checklist">
                            <div class="checklist-t">▼ PRE-START CHECKLIST  ·  BR-INJ-W01</div>
                            @for (var i = 0; i < _checks.Length; i++)
                            {
                                var idx = i;
                                <div class="checklist-i" @onclick="@(() => Toggle(idx))">
                                    <span class="c-mark @(_checks[idx] ? "" : "off")">@(_checks[idx] ? "✓" : "")</span>
                                    @CheckLabel(idx)
                                </div>
                            }
                        </div>
                        <div class="confirm-bar">
                            <button class="pop-btn pop-btn-sec" @onclick="@(() => Nav.NavigateTo("/inj02"))">← Back</button>
                            <button class="pop-btn pop-btn-ok" disabled="@(!CanAccept)" @onclick="Accept">
                                ✓ Accept WO → INJ-04
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:3;">
        <button class="nav-btn"        @onclick="@(() => Nav.NavigateTo("/inj02"))">◀ Back to Dashboard</button>
        <button class="nav-btn primary" @onclick="Reload">⟳ Refresh</button>
        <button class="nav-btn muted"  @onclick="Logout">◀ LOGOUT</button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto Session { get; set; } = null!;

    List<WorkOrderDto> _wos = new();
    WorkOrderDto?      _selected;
    bool[]             _checks = new bool[5];

    bool CanAccept => _selected is not null && _checks.All(c => c);

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _wos = PopServices.WorkOrders.ListForLine(Session.LineId);
        _selected = _wos.FirstOrDefault();
        _checks = new bool[5];
    }

    private void Select(WorkOrderDto w)
    {
        _selected = w;
        _checks = new bool[5];
    }

    private void Toggle(int i) => _checks[i] = !_checks[i];

    private string CheckLabel(int i) => i switch
    {
        0 => "1. Mold mounted matches WO routing",
        1 => "2. Material lot available + within expiry",
        2 => "3. Recipe loaded into PLC (pressure / temp / time)",
        3 => "4. Safety guards closed + interlock OK",
        4 => "5. Phase-0 master data complete (BR-MD-04)",
        _ => "",
    };

    private void Accept()
    {
        if (_selected is null) return;
        try
        {
            var checks = System.Text.Json.JsonSerializer.Serialize(new
            {
                mold=_checks[0], material=_checks[1], recipe=_checks[2], safety=_checks[3], phase0=_checks[4],
                at=DateTime.Now, by=Session.EmployeeNo,
            });
            PopServices.WorkOrders.AcceptWo(_selected.WoId, Session.TerminalId,
                Session.OperatorId, Session.EmployeeNo, checks);
            Nav.NavigateTo("/inj04");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Inj03 Accept] {ex.Message}");
        }
    }

    private Task Logout() => BlazorHost.RaiseAction("logout");
    public void Dispose() { }
}
