@page "/inj04"
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject ConfirmService Confirmer

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">INJ-004 · PRODUCTION ENTRY · @Session?.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span class="stat-on">● RUN</span>
            <span>@Session?.EmployeeName · @Session?.ShiftCode</span>
            <span>@_now.ToString("HH:mm:ss")</span>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.Inj04Help))" />
        </div>
    </div>

    <div class="pop-bd">
        <div class="entry-grid">
            @* Left: WO info + stats *@
            <div class="entry-info">
                <div class="entry-h">▼ CURRENT WO</div>
                <div class="entry-wo">@(_wo?.WoNumber ?? "(no WO)")</div>
                <div class="entry-name">@(_wo?.ItemName ?? "—")</div>

                <div class="entry-h" style="margin-top:14px;">▼ PROGRESS</div>
                <div class="entry-prog">
                    <span class="entry-prog-v">@(_wo?.CompletedQty.ToString("0") ?? "—")</span>
                    <span class="entry-prog-t">/ @(_wo?.OrderQty.ToString("0") ?? "—")</span>
                </div>
                <div class="entry-bar"><div class="entry-bar-fill" style="width:@_pct%;"></div></div>

                <div class="entry-h" style="margin-top:14px;">▼ STATS</div>
                <div class="entry-stats">
                    <div class="es"><div class="es-l">Today Good</div><div class="es-v">@_todayGood EA</div></div>
                    <div class="es"><div class="es-l">Today Defect</div><div class="es-v @_defClass">@_todayDef · @_defectPct</div></div>
                    <div class="es"><div class="es-l">Cycle Time</div><div class="es-v">@_cycle sec</div></div>
                    <div class="es"><div class="es-l">Mold Shots</div><div class="es-v @_moldClass">@_moldText</div></div>
                    <div class="es"><div class="es-l">CT (Standard)</div><div class="es-v warn">[CT] = 1 EA</div></div>
                    <div class="es"><div class="es-l">Last Entry</div><div class="es-v">@(_lastEntry?.ToString("HH:mm:ss") ?? "—")</div></div>
                </div>
            </div>

            @* Right: keypad *@
            <div class="entry-input">
                <div class="input-label">Good Qty This Cycle · 사이클당 양품 (EA)</div>
                <div class="input-display">@(_buf.Length == 0 ? "0" : _buf.ToString())</div>
                <div class="keypad">
                    @foreach (var d in new[] { "1","2","3","4","5","6","7","8","9" })
                    {
                        var key = d;
                        <div class="kp" @onclick="@(() => Press(key))">@key</div>
                    }
                    <div class="kp ct"  @onclick="LoadCt">CT</div>
                    <div class="kp"     @onclick="@(() => Press("0"))">0</div>
                    <div class="kp del" @onclick="Backspace">←</div>
                </div>
                <div class="entry-btn-row">
                    <button class="entry-btn entry-btn-warn" @onclick="OpenDefect">❌ Defect → INJ-005</button>
                    <button class="entry-btn entry-btn-ok"   @onclick="Confirm">✓ Confirm + @(_buf.Length == 0 ? "0" : _buf.ToString()) EA</button>
                </div>
            </div>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:8;">
        <button class="nav-btn" @onclick="@(() => Go("inj02"))">INJ-002<small>Dashboard</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj03"))">INJ-003<small>WO Confirm</small></button>
        <button class="nav-btn active" @onclick="@(() => Go("inj04"))">INJ-004<small>Prod Entry</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj05"))">INJ-005<small>Defect</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj06"))">INJ-006<small>Mold Change</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj07"))">INJ-007<small>Prod Status</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj08"))">INJ-008<small>Andon</small></button>
        <button class="nav-btn muted" @onclick="Logout">LOGOUT<small>End shift</small></button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }

    WorkOrderDto? _wo;
    MoldDto?      _mold;
    System.Text.StringBuilder _buf = new();
    DateTime?     _lastEntry;
    int _pct, _todayGood, _todayDef, _cycle = 30, _lastResultId;
    double _defectRatePct;
    string _defectPct = "0.0%", _defClass = "ok";
    string _moldText = "—", _moldClass = "ok";
    DateTime _now = DateTime.Now;
    System.Threading.Timer? _clockTimer;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        Refresh();
        _clockTimer = new System.Threading.Timer(_ => InvokeAsync(() => { _now = DateTime.Now; StateHasChanged(); }),
                                                 null, 1000, 1000);
    }

    void Refresh()
    {
        if (Session is null) return;
        _wo = PopServices.WorkOrders.GetActiveForTerminal(Session.LineId, Session.TerminalId)
           ?? PopServices.WorkOrders.ListForLine(Session.LineId).FirstOrDefault();
        if (_wo is null) return;
        _pct = (int)Math.Clamp(_wo.ProgressPct, 0, 100);
        _todayGood = PopServices.Production.GetTodayGoodForWo(_wo.WoId);
        var (g, d) = PopServices.Defects.GetWoTotals(_wo.WoId);
        _todayDef = d;
        _defectRatePct = (g + d) == 0 ? 0 : d * 100.0 / (g + d);
        _defectPct = $"{_defectRatePct:0.0}%";
        _defClass  = _defectRatePct >= 5 ? "alert" : _defectRatePct >= 4 ? "warn" : "ok";
        if (!string.IsNullOrEmpty(_wo.RecipeId)) _cycle = PopServices.Master.GetRecipeCycleTime(_wo.RecipeId) ?? 30;
        if (!string.IsNullOrEmpty(_wo.MoldId))
        {
            _mold = PopServices.Molds.GetById(_wo.MoldId);
            if (_mold is not null)
            {
                _moldText = $"{_mold.CurrentShots:N0} / {_mold.RatedShots:N0}";
                _moldClass = _mold.Severity is "warn" ? "warn" : _mold.Severity is "alert" or "hard" ? "alert" : "ok";
            }
        }
    }

    void Press(string d)
    {
        if (_buf.Length >= 2) return;
        if (_buf.Length == 0 && d == "0") return;
        _buf.Append(d);
    }
    void Backspace() { if (_buf.Length > 0) _buf.Length--; }
    void LoadCt()    { _buf.Clear(); _buf.Append('1'); }

    void Confirm()
    {
        if (_wo is null) return;
        if (!int.TryParse(_buf.ToString(), out var qty) || qty <= 0) return;
        try
        {
            var (resultId, _, _) = PopServices.Production.RecordCycle(
                _wo.WoId, _wo.ItemNo, _wo.LineId, qty, _cycle, _wo.MoldId,
                Session.OperatorId, Session.SessionId, Session.EmployeeNo, defectFlag: false);
            _lastResultId = resultId;
            _lastEntry = DateTime.Now;
            _buf.Clear();
            Refresh();
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Confirm] {ex.Message}"); }
    }

    void OpenDefect() { if (_lastResultId > 0) Nav.NavigateTo($"/inj05?result={_lastResultId}"); }
    async Task Logout() { if (!await Confirmer.AskAsync("Log out?", "End your shift and return to the login screen?", "Log out", "Stay", destructive: true)) return; Nav.NavigateTo("/login", replace: true); State.SignOut(); }
    public void Dispose() => _clockTimer?.Dispose();
    private void Go(string r) => Nav.NavigateTo("/" + r);
}
