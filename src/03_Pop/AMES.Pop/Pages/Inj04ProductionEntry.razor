@page "/inj04"
@using AMES.Contracts.Enums
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject ConfirmService Confirmer
@inject ToastService Toasts

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">INJ-004 · PRODUCTION CONFIRM · @Session?.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span class="stat-on">● RUN</span>
            <span>@Session?.EmployeeName · @Session?.ShiftCode</span>
            <span>@_now.ToString("HH:mm:ss")</span>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.Inj04Help))" />
        </div>
    </div>

    <div class="pop-bd">
        <div class="entry-grid">
            @* Left: WO info + stats *@
            <div class="entry-info">
                <div class="entry-h">▼ CURRENT WO</div>
                <div class="entry-wo">@(_wo?.WoNumber ?? "(no WO)")</div>
                <div class="entry-name">@(_wo?.ItemName ?? "—")</div>

                <div class="entry-h" style="margin-top:14px;">▼ PROGRESS</div>
                <div class="entry-prog">
                    <span class="entry-prog-v">@(_wo?.CompletedQty.ToString("0") ?? "—")</span>
                    <span class="entry-prog-t">/ @(_wo?.OrderQty.ToString("0") ?? "—")</span>
                </div>
                <div class="entry-bar"><div class="entry-bar-fill" style="width:@_pct%;"></div></div>

                <div class="entry-h" style="margin-top:14px;">▼ STATS</div>
                <div class="entry-stats">
                    <div class="es"><div class="es-l">Today Good</div><div class="es-v">@_todayGood EA</div></div>
                    <div class="es"><div class="es-l">Today Defect</div><div class="es-v @_defClass">@_todayDef · @_defectPct</div></div>
                    <div class="es"><div class="es-l">미확정 (RAW)</div><div class="es-v @(_rawCount > 0 ? "warn" : "ok")">@_rawCount EA</div></div>
                    <div class="es"><div class="es-l">NG 차단</div><div class="es-v @(_ngCount > 0 ? "alert" : "ok")">@_ngCount EA</div></div>
                    <div class="es"><div class="es-l">Mold Shots</div><div class="es-v @_moldClass">@_moldText</div></div>
                    <div class="es"><div class="es-l">Last Confirm</div><div class="es-v">@(_lastEntry?.ToString("HH:mm:ss") ?? "—")</div></div>
                </div>
            </div>

            @* Right: scan / manual tabs *@
            <div class="entry-input">
                <div style="display:flex; gap:8px; margin-bottom:10px;">
                    <button class="entry-btn @(_tab == "scan" ? "entry-btn-ok" : "")"
                            style="flex:1;" @onclick="@(() => { _tab = "scan"; _focusScan = true; })">📷 SCAN 확정</button>
                    <button class="entry-btn @(_tab == "manual" ? "entry-btn-ok" : "")"
                            style="flex:1;" @onclick="@(() => _tab = "manual")">⌨ 수동 입력</button>
                </div>

                @if (_tab == "scan")
                {
                    <div class="input-label">LOT 바코드 스캔 · USB 스캐너 또는 직접 입력 + Enter</div>
                    <input @ref="_scanInput" @bind="_scanBuf" @bind:event="oninput"
                           @onkeydown="OnScanKey"
                           style="width:100%; padding:14px; font-size:20px; font-family:Consolas,monospace;
                                  background:rgba(0,0,0,.35); color:#fff; border:2px solid rgba(255,255,255,.25);
                                  border-radius:8px;"
                           placeholder="L260717…-LINE-INJ-01-LH" autocomplete="off" />

                    <div class="entry-h" style="margin-top:14px;">▼ 미확정 LOT (에이전트 자동 생성 · 최신순)</div>
                    <div style="overflow-y:auto; max-height:320px; margin-top:6px;">
                        <table style="width:100%; border-collapse:collapse; font-size:13px;">
                            <thead>
                                <tr style="color:rgba(255,255,255,.55); text-align:left;">
                                    <th style="padding:4px;">LOT</th>
                                    <th style="padding:4px;">CAV</th>
                                    <th style="padding:4px;">품번</th>
                                    <th style="padding:4px;">생성</th>
                                    <th style="padding:4px;">상태</th>
                                    <th style="padding:4px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var lot in _rawLots)
                            {
                                var isNg = lot.ConfirmStatus == "NG_BLOCKED";
                                <tr style="border-top:1px solid rgba(255,255,255,.08); @(isNg ? "color:var(--warn);" : "")">
                                    <td style="padding:6px 4px; font-family:Consolas,monospace; cursor:pointer;"
                                        @onclick="@(() => { _scanBuf = lot.LotCode; _focusScan = true; })">@lot.LotCode</td>
                                    <td style="padding:6px 4px;">@lot.CavityPos</td>
                                    <td style="padding:6px 4px;">@lot.ItemNo</td>
                                    <td style="padding:6px 4px;">@lot.CreatedTS.ToString("HH:mm:ss")</td>
                                    <td style="padding:6px 4px;">@(isNg ? $"NG차단 ({lot.InspectionSummary})" : "RAW")</td>
                                    <td style="padding:6px 4px;">
                                        <button class="entry-btn" style="padding:4px 8px; font-size:12px;"
                                                @onclick="@(() => Reprint(lot))">🖨 재출력</button>
                                    </td>
                                </tr>
                            }
                            @if (_rawLots.Count == 0)
                            {
                                <tr><td colspan="6" style="padding:12px 4px; color:rgba(255,255,255,.4);">
                                    미확정 LOT 없음 — 에이전트가 샷을 수집하면 여기 표시됩니다.
                                </td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="input-label">Good Qty This Cycle · 사이클당 양품 (EA) — PLC 미연결 라인용</div>
                    <div class="input-display">@(_buf.Length == 0 ? "0" : _buf.ToString())</div>
                    <div class="keypad">
                        @foreach (var d in new[] { "1","2","3","4","5","6","7","8","9" })
                        {
                            var key = d;
                            <div class="kp" @onclick="@(() => Press(key))">@key</div>
                        }
                        <div class="kp ct"  @onclick="LoadCt">CT</div>
                        <div class="kp"     @onclick="@(() => Press("0"))">0</div>
                        <div class="kp del" @onclick="Backspace">←</div>
                    </div>
                    <div class="entry-btn-row">
                        <button class="entry-btn entry-btn-ok" @onclick="ManualConfirm">✓ Confirm + @(_buf.Length == 0 ? "0" : _buf.ToString()) EA</button>
                    </div>
                }

                <div class="entry-btn-row" style="margin-top:10px;">
                    <button class="entry-btn entry-btn-warn" @onclick="OpenDefect">❌ Defect → INJ-005</button>
                </div>
            </div>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:8;">
        <button class="nav-btn" @onclick="@(() => Go("inj02"))">INJ-002<small>Dashboard</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj03"))">INJ-003<small>WO Confirm</small></button>
        <button class="nav-btn active" @onclick="@(() => Go("inj04"))">INJ-004<small>Confirm</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj05"))">INJ-005<small>Defect</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj06"))">INJ-006<small>Mold Change</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj07"))">INJ-007<small>Prod Status</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj08"))">INJ-008<small>Andon</small></button>
        <button class="nav-btn muted" @onclick="Logout">LOGOUT<small>End shift</small></button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }

    WorkOrderDto? _wo;
    MoldDto?      _mold;
    List<InjLotDto> _rawLots = new();
    System.Text.StringBuilder _buf = new();
    DateTime?     _lastEntry;
    int _pct, _todayGood, _todayDef, _cycle = 30, _lastResultId, _rawCount, _ngCount;
    double _defectRatePct;
    string _defectPct = "0.0%", _defClass = "ok";
    string _moldText = "—", _moldClass = "ok";
    string _tab = "scan";
    string _scanBuf = string.Empty;
    bool _focusScan;
    DateTime _now = DateTime.Now;
    ElementReference _scanInput;
    System.Threading.Timer? _clockTimer;
    System.Threading.Timer? _listTimer;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        Refresh();
        _clockTimer = new System.Threading.Timer(_ => InvokeAsync(() => { _now = DateTime.Now; StateHasChanged(); }),
                                                 null, 1000, 1000);
        _listTimer  = new System.Threading.Timer(_ => InvokeAsync(() => { RefreshLots(); StateHasChanged(); }),
                                                 null, 3000, 3000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((firstRender && _tab == "scan") || _focusScan)
        {
            _focusScan = false;
            try { await _scanInput.FocusAsync(); } catch { }
        }
    }

    void Refresh()
    {
        if (Session is null) return;
        _wo = PopServices.WorkOrders.GetActiveForTerminal(Session.LineId, Session.TerminalId)
           ?? PopServices.WorkOrders.ListForLine(Session.LineId).FirstOrDefault();
        RefreshLots();
        if (_wo is null) return;
        _pct = (int)Math.Clamp(_wo.ProgressPct, 0, 100);
        _todayGood = PopServices.Production.GetTodayGoodForWo(_wo.WoId);
        var (g, d) = PopServices.Defects.GetWoTotals(_wo.WoId);
        _todayDef = d;
        _defectRatePct = (g + d) == 0 ? 0 : d * 100.0 / (g + d);
        _defectPct = $"{_defectRatePct:0.0}%";
        _defClass  = _defectRatePct >= 5 ? "alert" : _defectRatePct >= 4 ? "warn" : "ok";
        if (!string.IsNullOrEmpty(_wo.RecipeId)) _cycle = PopServices.Master.GetRecipeCycleTime(_wo.RecipeId) ?? 30;
        if (!string.IsNullOrEmpty(_wo.MoldId))
        {
            _mold = PopServices.Molds.GetById(_wo.MoldId);
            if (_mold is not null)
            {
                _moldText = $"{_mold.CurrentShots:N0} / {_mold.RatedShots:N0}";
                _moldClass = _mold.Severity is "warn" ? "warn" : _mold.Severity is "alert" or "hard" ? "alert" : "ok";
            }
        }
    }

    void RefreshLots()
    {
        if (Session is null) return;
        try
        {
            _rawLots = PopServices.InjLots.GetUnconfirmed(Session.LineId);
            var (_, raw, ng) = PopServices.InjLots.GetTodayStats(Session.LineId);
            _rawCount = raw;
            _ngCount  = ng;
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Inj04 lots] {ex.Message}"); }
    }

    void OnScanKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var code = _scanBuf.Trim();
        _scanBuf = string.Empty;
        if (code.Length == 0) return;
        ConfirmScan(code);
    }

    void ConfirmScan(string lotCode)
    {
        if (Session is null) return;
        if (_wo is null)
        {
            Toasts.Warn("활성 작업지시가 없습니다 — INJ-003에서 WO를 먼저 접수하세요.");
            return;
        }
        try
        {
            var (outcome, resultId, itemNo) = PopServices.InjLots.ConfirmByLotCode(
                lotCode, Session.LineId, _wo.WoId, Session.OperatorId, Session.SessionId, Session.EmployeeNo);
            switch (outcome)
            {
                case InjConfirmOutcome.Confirmed:
                    _lastResultId = resultId;
                    _lastEntry = DateTime.Now;
                    Toasts.Ok($"실적 확정: {lotCode} ({itemNo})");
                    Refresh();
                    break;
                case InjConfirmOutcome.NotFound:
                    Toasts.Bad($"LOT 없음: {lotCode}");
                    break;
                case InjConfirmOutcome.AlreadyConfirmed:
                    Toasts.Warn($"이미 확정된 LOT: {lotCode}");
                    break;
                case InjConfirmOutcome.NgBlocked:
                    Toasts.Bad($"검사 NG로 차단된 LOT — INJ-005에서 불량 처리하세요: {lotCode}");
                    break;
                case InjConfirmOutcome.WrongLine:
                    Toasts.Bad($"다른 라인의 LOT입니다: {lotCode}");
                    break;
            }
        }
        catch (Exception ex)
        {
            Toasts.Bad($"확정 실패: {ex.Message}");
        }
        finally
        {
            _focusScan = true;
        }
    }

    void Reprint(InjLotDto lot)
    {
        try
        {
            var cfg = AppConfig.Current;
            var printer = new AMES.Devices.ZplPrinter(new AMES.Devices.ZplPrinterOptions
            {
                Mode = cfg.PrinterMode, Host = cfg.PrinterHost,
                Port = cfg.PrinterPort, OutputDir = cfg.PrinterOutputDir,
            });
            var zpl = AMES.Devices.ZplLabelBuilder.Build(new AMES.Devices.ZplLabel(
                lot.LotCode, lot.ItemNo, lot.ItemName, lot.ColorCode, lot.CavityPos,
                lot.LineId ?? Session?.LineId ?? "", lot.CreatedTS));
            printer.Print(zpl, lot.LotCode);
            Toasts.Ok($"라벨 재출력: {lot.LotCode}");
        }
        catch (Exception ex)
        {
            Toasts.Bad($"재출력 실패: {ex.Message}");
        }
    }

    void Press(string d)
    {
        if (_buf.Length >= 2) return;
        if (_buf.Length == 0 && d == "0") return;
        _buf.Append(d);
    }
    void Backspace() { if (_buf.Length > 0) _buf.Length--; }
    void LoadCt()    { _buf.Clear(); _buf.Append('1'); }

    void ManualConfirm()
    {
        if (_wo is null || Session is null) return;
        if (!int.TryParse(_buf.ToString(), out var qty) || qty <= 0) return;
        try
        {
            var (resultId, _, _) = PopServices.Production.RecordCycle(
                _wo.WoId, _wo.ItemNo, _wo.LineId, qty, _cycle, _wo.MoldId,
                Session.OperatorId, Session.SessionId, Session.EmployeeNo, defectFlag: false);
            _lastResultId = resultId;
            _lastEntry = DateTime.Now;
            _buf.Clear();
            Toasts.Ok($"수동 실적 {qty} EA 등록");
            Refresh();
        }
        catch (Exception ex) { Toasts.Bad($"등록 실패: {ex.Message}"); }
    }

    void OpenDefect() { Nav.NavigateTo(_lastResultId > 0 ? $"/inj05?result={_lastResultId}" : "/inj05"); }
    async Task Logout() { if (!await Confirmer.AskAsync("Log out?", "End your shift and return to the login screen?", "Log out", "Stay", destructive: true)) return; Nav.NavigateTo("/login", replace: true); State.SignOut(); }
    public void Dispose() { _clockTimer?.Dispose(); _listTimer?.Dispose(); }
    private void Go(string r) => Nav.NavigateTo("/" + r);
}
