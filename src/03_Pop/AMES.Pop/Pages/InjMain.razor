@page "/injmain"
@using AMES.Contracts.Enums
@using AMES.Data.Connection
@using AMES.Data.Repositories
@using AMES.Data.Services
@using AMES.Pop.Pages.InjPopups
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject ConfirmService Confirmer
@inject ToastService Toasts
@inject AMES.Pop.Services.LabelDispatcher Dispatcher
@inject AMES.Pop.Services.ScannerService Scanner

@*  INJ-MAIN — INJ03~08 통합 작업 화면.
    좌측 스테이션 품번 당일 현황(PLAN/INPUT/NG/FINAL) + 우측 스캔/결과 패널을 상시 표시하고,
    수동 라벨 생성은 버튼 1회 = LOT 1개, 불량·안돈은 팝업(Pages/InjPopups/*)으로 띄운다. WO 접수 없음 — 품번 선택이 열린 WO를 자동 해석.
    문구는 PopLang(T)로 ko/en 단일 언어 표시. 구 단독 화면(/inj02~/inj08)은 모두 제거됨. *@

<div class="pop-shell injm-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">INJ-MAIN · @Session?.TerminalId · @Session?.LineId</span>
        </div>
        <div class="pop-tbar-r">
            @if (_openAndon is { } oa)
            {
                <button class="injm-andon-chip" @onclick="@(() => Open(Popup.Andon))">🚨 @T("AndonActive") · #@oa.AndonId · @AndonElapsed(oa)</button>
            }
            @if (OfflineWork.Conflicts.Count > 0)
            {
                <button class="injm-andon-chip" @onclick="ShowConflicts">@T("OfflineConflicts", OfflineWork.Conflicts.Count)</button>
            }
            <span class="@(PopDb.IsOffline ? "stat-bad" : "stat-on")">● @T(PopDb.IsOffline ? "Offline" : "Online")</span>
            <span class="@(PopDb.IsOffline ? "stat-off" : _eqClass)">● @PopLang.EqStatus(PopDb.IsOffline ? "OFFLINE" : _eqStatus)</span>
            @if (Scanner.IsEnabled)
            {
                <span class="@(_scannerOn ? "stat-on" : "stat-off")">🔌 @T("Scanner")</span>
            }
            <span>@Session?.EmployeeName · @PopLang.Shift(Session?.ShiftCode ?? "")</span>
            <span>@_now.ToString("yyyy-MM-dd HH:mm:ss")</span>
            <button class="injm-lang-btn" @onclick="ToggleLang">@(PopLang.IsKo ? "EN" : "한국어")</button>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.InjMainHelp))" />
            <button class="injm-logout-btn" @onclick="Logout">⏻ @T("Logout")</button>
        </div>
    </div>

    <div class="pop-bd">
        <div class="injm-grid">

            @* ── 좌측: 스테이션 품번 당일 현황 ─────────────────────── *@
            <div class="pop-card injm-left">
                <div class="pop-card-h imgm-date-h">
                    <span>▼ @T("PartNo")</span>
                    @* 타이핑 금지 — 누르면 달력만 뜬다. 키 입력을 막아 HID 스캔이 날짜 칸으로 새지도 않는다. *@
                    <input type="date" class="imgm-date-input" value="@ViewDate.ToString("yyyy-MM-dd")"
                           max="@DbClock.Today.ToString("yyyy-MM-dd")" @onchange="OnDateChange"
                           onclick="try { this.showPicker(); } catch (e) { }"
                           onkeydown="return false" onpaste="return false" ondrop="return false" />
                </div>
                @if (_refreshError is not null)
                {
                    <div class="injm-refresh-err">⚠ @T("DataRefreshFailed", _refreshErrorAt.ToString("HH:mm:ss")) — @_refreshError</div>
                }
                <div class="injm-tbl-wrap">
                    <table class="injm-tbl">
                        <thead>
                            <tr>
                                <th style="text-align:left;">@T("PartNo")</th>
                                <th>@T("Plan")</th>
                                <th>@T("Input")</th>
                                <th>@T("Ng")</th>
                                <th>@T("Final")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var it in _items)
                        {
                            var isSel = string.Equals(_selItemNo, it.ItemNo, StringComparison.OrdinalIgnoreCase);
                            <tr class="@(isSel ? "active" : "")" @onclick="@(() => SelectItem(it))" @ondblclick="@(() => OpenWoList(it))">
                                <td class="mono" style="text-align:left;" title="@it.ItemName">
                                    @it.ItemNo
                                    @if (!it.InBop)
                                    {
                                        <span class="injm-dim-badge">@T("NotInBop")</span>
                                    }
                                    @if (!it.HasOpenWo)
                                    {
                                        <span class="injm-dim-badge">@T("NoOpenWo")</span>
                                    }
                                </td>
                                <td>@it.PlanQty.ToString("0")</td>
                                <td>@it.InputQty</td>
                                <td class="@(it.NgQty > 0 ? "bad" : "")">@it.NgQty</td>
                                <td class="ok">@it.FinalQty</td>
                            </tr>
                        }
                        @if (_items.Count == 0 && _refreshError is null)
                        {
                            <tr><td colspan="5" style="padding:28px; color:rgba(255,255,255,.4); text-align:center; font-size:20px;">
                                @T("NoBopItemsForStation")
                            </td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="injm-total">
                    <span>@T("Plan") <b>@_items.Sum(x => x.PlanQty).ToString("0")</b></span>
                    <span>@T("Input") <b class="mod">@_items.Sum(x => x.InputQty)</b></span>
                    <span>@T("Ng") <b class="bad">@_items.Sum(x => x.NgQty)</b></span>
                    <span>@T("Final") <b class="ok">@_items.Sum(x => x.FinalQty)</b></span>
                    <span>@T("Shortage") <b class="bad">@_items.Sum(x => Math.Max(0, x.PlanQty - x.FinalQty)).ToString("0")</b></span>
                </div>
            </div>

            @* ── 우측: 스캔 + 결과 배너 + LOT 이력 ─────────────────── *@
            <div class="injm-right">
                <div class="pop-card injm-scan">
                    <div class="pop-card-h">▼ @T("LotBarcodeScanConfirm") (@T("PartNo"): @(_selItemNo ?? "—") · @(_activeWo?.WoNumber ?? "—"))</div>
                    <input @ref="_scanInput" @bind="_scanBuf" @bind:event="oninput"
                           @onkeydown="OnScanKey" class="injm-scan-input"
                           placeholder="A91I10001" autocomplete="off" />
                    <div class="injm-banner @_bannerClass">
                        <div class="injm-banner-t">@BannerTitle</div>
                        @if (_bannerDetail.Length > 0)
                        {
                            <div class="injm-banner-s">@_bannerDetail</div>
                        }
                    </div>
                    <div class="injm-chips">
                        <span class="injm-chip">@T("Pallet") <b class="@PalletChip.Of(_pallet).Css mono">@PalletChip.Of(_pallet).Text</b></span>
                        <span class="injm-chip">@T("TodayGood") <b class="ok">@_todayGood</b></span>
                        <span class="injm-chip">@T("Defect") <b class="@_defClass">@_todayDef · @_defectPct</b></span>
                        <span class="injm-chip">@T("Unconfirmed") <b class="@(_rawCount > 0 ? "warn" : "ok")">@_rawCount</b></span>
                        <span class="injm-chip">@T("NgBlocked") <b class="@(_ngCount > 0 ? "bad" : "ok")">@_ngCount</b></span>
                        <span class="injm-chip">@T("Mold") <b class="@_moldClass">@_moldText</b></span>
                    </div>
                </div>

                <div class="pop-card injm-lots">
                    <div class="pop-card-h">▼ @T("UnconfirmedLotsNewestFirst")</div>
                    <div class="injm-scroll">
                        <table class="injm-subtbl">
                            <tbody>
                            @foreach (var lot in _rawLots)
                            {
                                var isNg = lot.ConfirmStatus == "NG_BLOCKED";
                                <tr style="@(isNg ? "color:var(--warn);" : "")">
                                    <td class="mono" style="cursor:pointer;"
                                        @onclick="@(() => { _scanBuf = lot.LotCode; _focusScan = true; })">@lot.LotCode</td>
                                    <td>@lot.CavityPos</td>
                                    <td>@lot.CreatedTS.ToString("HH:mm:ss")</td>
                                    <td>@(isNg ? $"{T("Ng2")} ({lot.InspectionSummary})" : T("Raw"))</td>
                                    <td><button class="injm-mini-btn" @onclick="@(() => Reprint(lot))">🖨 @T("Reprint")@(lot.PrintedCount > 1 ? $" ×{lot.PrintedCount}" : "")</button></td>
                                </tr>
                            }
                            @if (_rawLots.Count == 0)
                            {
                                <tr><td style="padding:14px 4px; color:rgba(255,255,255,.4);">
                                    @T("NoUnconfirmedLotsAgentCollectedShotsWill")
                                </td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="pop-card injm-hist">
                    <div class="pop-card-h">▼ @T("ScanHistoryToday")</div>
                    <div class="injm-scroll">
                        <table class="injm-subtbl">
                            <thead><tr><th style="text-align:left;">@T("Lotno")</th><th style="text-align:left;">@T("Time")</th><th>@T("Result")</th></tr></thead>
                            <tbody>
                            @foreach (var h in _scanHistory)
                            {
                                <tr>
                                    <td class="mono">@h.LotCode</td>
                                    <td class="mono">@h.At.ToString("HH:mm:ss")</td>
                                    <td><span class="injm-result @(h.Ok ? "ok" : "bad")">@(h.Ok ? T("Ok") : T("Ng"))</span></td>
                                </tr>
                            }
                            @if (_scanHistory.Count == 0)
                            {
                                <tr><td colspan="3" style="padding:14px 4px; color:rgba(255,255,255,.4);">@T("NoScansYet")</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* ── 기능 버튼 (팝업 런처) — 우측 패널 최하단 ─────────── *@
                <div class="injm-actions">
                    <button class="nav-btn" disabled="@_creatingLabel" @onclick="CreateManualLabel">@T("ManualLabelCreate")</button>
                    <button class="nav-btn warn" @onclick="@(() => Open(Popup.Defect))">@T("Defect2")</button>
                    <button class="nav-btn alert" @onclick="OpenAndon">@T("Andon")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── 팝업 ─────────────────────────────────────────────────────────── *@
@switch (_popup)
{
    case Popup.Defect:
        <DefectPopup Session="Session" SelectedItemNo="@_selItemNo" OnClose="ClosePopup" OnChanged="RefreshNowAsync" />
        break;
    case Popup.WoList when Session is not null && _selItemNo is not null:
        <WorkOrderListPopup LineId="@Session.LineId" ItemNo="@_selItemNo" ItemName="@SelItem?.ItemName"
                            ActiveWoId="@_activeWo?.WoId" OnClose="ClosePopup" />
        break;
    case Popup.Andon:
        <AndonPopup Session="Session" OnClose="ClosePopup" AutoRaise="_andonAutoRaise" />
        break;
}

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }

    private static string T(string key, params object?[] args) => PopLang.T(key, args);

    private enum Popup { None, Defect, Andon, WoList }
    private Popup _popup = Popup.None;

    private sealed record ScanRecord(string LotCode, DateTime At, bool Ok, string Message);

    private List<InjItemDailyDto> _items = new();

    // null = 금일 추종 — 자정을 넘기면 좌측 패널도 다음 날로 넘어간다.
    private DateTime? _viewDate;
    private DateTime ViewDate => _viewDate ?? DbClock.Today;
    private bool IsToday => ViewDate >= DbClock.Today;
    private string? _selItemNo;
    private InjItemDailyDto? SelItem =>
        _items.FirstOrDefault(x => string.Equals(x.ItemNo, _selItemNo, StringComparison.OrdinalIgnoreCase));
    private WorkOrderDto? _activeWo;
    private MoldDto?      _mold;
    private List<InjLotDto>       _rawLots = new();
    private readonly List<ScanRecord> _scanHistory = new();

    private int _todayGood, _todayDef, _rawCount, _ngCount;
    private string _defectPct = "0.0%", _defClass = "ok";
    private string _moldText = "—", _moldClass = "ok";
    private string _eqStatus = "OFFLINE", _eqClass = "stat-off";
    private AndonCallDto? _openAndon;
    private bool _andonAutoRaise;
    private static string AndonElapsed(AndonCallDto a)
    {
        var t = DbClock.Now - a.TriggeredAt;
        return $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";
    }
    private string?  _refreshError;
    private DateTime _refreshErrorAt;

    private string _bannerClass = "idle", _bannerDetail = "";
    private string BannerTitle => _bannerClass switch
    {
        "ok"  => T("Success"),
        "bad" => T("Fail"),
        _     => T("Ready"),
    };
    private string _scanBuf = string.Empty;
    private bool _focusScan;
    private ElementReference _scanInput;
    private bool _scannerOn;

    private DateTime _now = DbClock.Now;
    private System.Threading.Timer? _clockTimer;
    private System.Threading.Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        Refresh();
        _scannerOn = Scanner.IsConnected;
        Scanner.OnScan            += OnSerialScan;
        Scanner.ConnectionChanged += OnScannerConnection;
        _clockTimer   = new System.Threading.Timer(_ =>
                                                   {
                                                       PopDb.ProbeIfOffline();
                                                       InvokeAsync(() => { _now = DbClock.Now; StateHasChanged(); });
                                                   }, null, 1000, 1000);
        _refreshTimer = new System.Threading.Timer(_ => InvokeAsync(RefreshTickAsync),
                                                   null, 5000, 5000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((firstRender || _focusScan) && _popup == Popup.None)
        {
            _focusScan = false;
            try { await _scanInput.FocusAsync(); } catch { }
        }
    }

    private void ToggleLang() => PopLang.Lang = PopLang.IsKo ? "en" : "ko";

    private sealed record RefreshSnapshot(
        List<InjItemDailyDto> Items, string? SelItemNo, WorkOrderDto? ActiveWo,
        int TodayGood, int TodayDef, string DefectPct, string DefClass,
        MoldDto? Mold, string MoldText, string MoldClass,
        List<InjLotDto> RawLots, int RawCount, int NgCount,
        string EqStatus, string EqClass, AndonCallDto? OpenAndon,
        List<InjItemDailyDto>? TodayItems = null);

    private bool _refreshing, _disposed;
    private int _refreshGen;     // Apply 마다 올린다 — 조회 중에 더 새로운 반영이 있었으면 늦게 온 스냅샷을 버린다

    // DB 가 끊겼으면(이미 알려졌거나 이번 호출이 연결 오류) 로컬 사본으로 화면을 채운다 — 사본이 없으면 안내만.
    private void Refresh()
    {
        if (Session is null) return;
        if (PopDb.IsOffline) { ApplyOffline(); return; }
        try
        {
            var snap = Load(Session.LineId, Session.TerminalId, _selItemNo, ViewDate, IsToday);
            Apply(snap);
            Absorb(snap);
        }
        catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { ApplyOffline(); }
        catch (Exception ex) { ReportRefreshError(ex); }
    }

    // 온라인으로 받은 확정 대기 LOT·오늘 현황을 오프라인 사본에 덧붙인다 — 정전 직전에 만들어진 LOT 도 오프라인에서 알아보게 한다.
    private void Absorb(RefreshSnapshot s)
    {
        if (Session is null) return;
        OfflineWork.Absorb(Session.LineId, Session.TerminalId, s.RawLots.Select(OfflineLot.From), s.TodayItems);
    }

    // 연결 오류면 호출자가 로컬 사본 경로로 넘어간다 — 처음 실패한 한 번만 연결 대기를 겪고 이후는 PopDb.IsOffline 으로 바로 간다.
    private static T OnlineOr<T>(Func<T> online, Func<T> offline)
    {
        if (PopDb.IsOffline) return offline();
        try { return online(); }
        catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { return offline(); }
    }

    // 5초 타이머 전용 — 이전 조회가 끝나기 전의 틱은 건너뛴다.
    private async Task RefreshTickAsync()
    {
        if (_refreshing || _disposed) return;
        _refreshing = true;
        try { await RefreshAsync(fromTick: true); }
        finally { _refreshing = false; }
    }

    // 사용자 동작(품번 선택·날짜 변경·팝업 닫기)용 — 화면 스레드를 붙잡지 않는다.
    private Task RefreshNowAsync() => RefreshAsync(fromTick: false);

    // DB 가 응답하지 않으면 접속 대기(최대 30초) 동안 화면 스레드를 붙잡지 않도록 조회만 스레드 풀에서 돌린다.
    // 이미 끊긴 것으로 알려진 동안(DbHealth)은 조회하지 않고 복구 확인(PopDb.ProbeIfOffline)을 기다린다.
    private async Task RefreshAsync(bool fromTick)
    {
        if (Session is null || _disposed) return;
        if (PopDb.IsOffline) { ApplyOffline(); StateHasChanged(); return; }
        var (lineId, terminalId, sel, viewDate, isToday, gen) =
            (Session.LineId, Session.TerminalId, _selItemNo, ViewDate, IsToday, _refreshGen);
        try
        {
            var snap = await Task.Run(() => Load(lineId, terminalId, sel, viewDate, isToday));
            // 틱의 늦은 결과만 버린다 — 사용자 동작의 결과는 그 시점의 최신 의도다.
            if (_disposed || (fromTick && gen != _refreshGen)) return;
            Apply(snap);
            Absorb(snap);
        }
        catch (Exception ex) when (DbHealth.IsConnectionFailure(ex))
        {
            if (_disposed) return;
            ApplyOffline();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            ReportRefreshError(ex);
        }
        StateHasChanged();
    }

    private void MarkOffline(string? message = null)
    {
        var msg = message ?? T("DbOffline");
        if (_refreshError == msg) return;
        _refreshError   = msg;
        _refreshErrorAt = DbClock.Now;
    }

    // 로컬 사본으로 화면 한 번 — 온라인 Load 와 같은 모양의 스냅샷으로 바꿔 같은 Apply 를 쓴다.
    private void ApplyOffline()
    {
        if (Session is null) return;
        var scr = OfflineWork.BuildScreen(Session.LineId, Session.TerminalId, _selItemNo, ViewDate);
        if (scr is null) { MarkOffline(T("OfflineNoData")); return; }

        var pct = (scr.TodayGood + scr.TodayDef) == 0 ? 0 : scr.TodayDef * 100.0 / (scr.TodayGood + scr.TodayDef);
        string moldText = "—", moldClass = "ok";
        if (scr.Mold is { } m)
        {
            moldText  = $"{m.CurrentShots:N0}/{m.RatedShots:N0}";
            moldClass = m.Severity is "warn" ? "warn" : m.Severity is "alert" or "hard" ? "bad" : "ok";
        }
        Apply(new RefreshSnapshot(
            scr.Items, scr.SelItemNo, scr.ActiveWo,
            scr.TodayGood, scr.TodayDef, $"{pct:0.0}%", pct >= 5 ? "bad" : pct >= 4 ? "warn" : "ok",
            scr.Mold, moldText, moldClass, scr.RawLots.Select(l => l.ToInj()).ToList(), scr.RawCount, scr.NgCount,
            "OFFLINE", "stat-off", null));

        var taken = OfflineWork.State?.TakenAtUtc.ToLocalTime().ToString("MM-dd HH:mm") ?? "—";
        _refreshError   = T("DbOfflineLocal", taken, OfflineWork.PendingCount);
        _refreshErrorAt = DbClock.Now;
    }

    // 필드를 건드리지 않는다 — 스레드 풀에서 불려도 안전해야 한다.
    private static RefreshSnapshot Load(string lineId, string terminalId, string? selItemNo, DateTime viewDate, bool isToday)
    {
        var today = PopServices.InjLots.GetDailyItemSummary(lineId, terminalId, DbClock.Today);
        var items = isToday ? today
                  : PopServices.InjLots.GetDailyItemSummary(lineId, terminalId, viewDate);

        // 선택이 없거나 목록에서 사라졌으면 열린 WO 가 있는 첫 품번, 없으면 첫 행.
        if (!items.Any(x => string.Equals(x.ItemNo, selItemNo, StringComparison.OrdinalIgnoreCase)))
            selItemNo = (items.FirstOrDefault(x => x.HasOpenWo) ?? items.FirstOrDefault())?.ItemNo;

        // 접수가 없으므로 활성 WO 는 품번에서 매번 해석한다 — ConfirmByLotCode 와 같은 규칙.
        var activeWo = selItemNo is null ? null
                     : PopServices.WorkOrders.FindOpenForItem(lineId, selItemNo);

        // 칩은 좌측 날짜와 무관하게 금일 수치다 — 금일 양품/불량 라벨을 달고 있다.
        var todayRow = today.FirstOrDefault(x => string.Equals(x.ItemNo, selItemNo, StringComparison.OrdinalIgnoreCase));
        int todayGood = todayRow?.FinalQty ?? 0;
        int todayDef  = todayRow?.NgQty    ?? 0;
        var pct = (todayGood + todayDef) == 0 ? 0 : todayDef * 100.0 / (todayGood + todayDef);

        string moldText = "—", moldClass = "ok";
        MoldDto? mold = null;
        if (activeWo is not null && !string.IsNullOrEmpty(activeWo.MoldId))
        {
            mold = PopServices.Molds.GetById(activeWo.MoldId);
            if (mold is not null)
            {
                moldText  = $"{mold.CurrentShots:N0}/{mold.RatedShots:N0}";
                moldClass = mold.Severity is "warn" ? "warn" : mold.Severity is "alert" or "hard" ? "bad" : "ok";
            }
        }

        var rawLots = PopServices.InjLots.GetUnconfirmed(lineId);
        var (_, raw, ng) = PopServices.InjLots.GetTodayStats(lineId);

        var eq = PopServices.Equipment.GetPrimaryForLine(lineId);
        var eqStatus = (eq?.Status ?? "OFFLINE").ToUpperInvariant();

        return new RefreshSnapshot(
            items, selItemNo, activeWo,
            todayGood, todayDef, $"{pct:0.0}%", pct >= 5 ? "bad" : pct >= 4 ? "warn" : "ok",
            mold, moldText, moldClass,
            rawLots, raw, ng,
            eqStatus, eqStatus is "RUN" or "IDLE" ? "stat-on" : "stat-off",
            PopServices.Andon.GetOpenForLine(lineId),
            today);
    }

    private void Apply(RefreshSnapshot s)
    {
        _refreshGen++;
        _items = s.Items; _selItemNo = s.SelItemNo; _activeWo = s.ActiveWo;
        _todayGood = s.TodayGood; _todayDef = s.TodayDef; _defectPct = s.DefectPct; _defClass = s.DefClass;
        _mold = s.Mold; _moldText = s.MoldText; _moldClass = s.MoldClass;
        _rawLots = s.RawLots; _rawCount = s.RawCount; _ngCount = s.NgCount;
        _eqStatus = s.EqStatus; _eqClass = s.EqClass;
        _openAndon = s.OpenAndon;
        _refreshError = null;
    }

    private void ReportRefreshError(Exception ex)
    {
        // 스캔 결과 배너는 건드리지 않는다 — 5초마다 덮어쓰면 방금 스캔한 결과가 사라진다.
        // 직전 목록은 그대로 두고 좌측 헤더 아래 스트립으로만 알린다.
        _refreshError   = ex.Message;
        _refreshErrorAt = DbClock.Now;
        System.Diagnostics.Debug.WriteLine($"[InjMain refresh] {ex.Message}");
    }

    private void OnDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value as string, out var d)) SetDate(d);
    }
    private void SetDate(DateTime d)
    {
        _viewDate = d.Date >= DbClock.Today ? null : d.Date;
        _ = RefreshNowAsync();
        _focusScan = true;
    }

    private void SelectItem(InjItemDailyDto it)
    {
        _selItemNo = it.ItemNo;
        _ = RefreshNowAsync();
        _focusScan = true;
    }

    // 더블클릭의 첫 클릭이 이미 SelectItem 으로 활성 WO 를 해석해 두었다 — 팝업은 그 WO 에 ★ 를 단다.
    private void OpenWoList(InjItemDailyDto it)
    {
        if (!string.Equals(_selItemNo, it.ItemNo, StringComparison.OrdinalIgnoreCase)) SelectItem(it);
        if (PopDb.IsOffline) { Toasts.Warn(T("OfflineNotAvailable")); return; }   // WO 목록 팝업은 DB 를 직접 읽는다
        _andonAutoRaise = false;
        _popup = Popup.WoList;
    }

    // ── 스캔 확정 (INJ-004 로직) ──────────────────────────────────────
    // 리더 스레드에서 오므로 렌더러 스레드로 넘긴다. 팝업이 열려 있으면 무시 —
    // HID 도 포커스가 빠져 안 들어가는 것과 같은 규칙.
    private void OnSerialScan(string code)
        => InvokeAsync(() =>
        {
            if (_popup != Popup.None) return;
            HandleScan(code);
            StateHasChanged();
        });

    private void OnScannerConnection(bool on)
        => InvokeAsync(() => { _scannerOn = on; StateHasChanged(); });

    private void OnScanKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var code = _scanBuf.Trim();
        _scanBuf = string.Empty;
        if (code.Length == 0) return;
        HandleScan(code);
    }

    // 스캔 한 칸이 두 가지를 받는다 — 팔레트 바코드(EOS-PLT-)면 현재 팔레트로, 아니면 LOT 확정.
    private void HandleScan(string code)
    {
        if (PalletLoadRules.IsPalletBarcode(code)) SetPallet(code);
        else ConfirmScan(code);
    }

    /// <summary>현재 팔레트 — OK 제품이 실릴 곳. 화면 메모리뿐이라 재로그인하면 다시 스캔한다(2026-10-21 사용자 결정).</summary>
    private PalletStockRepository.PalletStatus? _pallet;

    private void SetPallet(string code)
    {
        try
        {
            var st = OnlineOr(() => PopServices.Pallets.Inspect(code, _selItemNo), () => OfflineWork.Inspect(code, _selItemNo));
            var ok = PalletChip.Accepts(st.Outcome);
            if (ok) _pallet = st;
            var key = PalletChip.NoticeKey(st.Outcome);
            // 오프라인에서 사본에 없는 팔레트는 받아들인다 — 맞는지는 복구 뒤 서버가 확정 때 판정한다
            var unverified = ok && PopDb.IsOffline && !OfflineWork.IsKnownPallet(code) ? $" · {T("OfflineUnverified")}" : "";
            SetBanner(key is null, key is null ? $"{T("PalletSet")}: {st.PalletNo} ({st.CapacityText}){unverified}" : $"{T(key)}: {st.PalletNo}");
        }
        catch (Exception ex)
        {
            PopLog.Append("scan", "PALLET", $"{code}: {ex}");
            SetBanner(false, $"{T("ConfirmFailed")}: {PalletLoadRules.NormalizePalletNo(code)}");
        }
        finally { _focusScan = true; }
    }

    private void RefreshPallet(string? itemNo)
    {
        if (_pallet is null) return;
        var no = _pallet.PalletNo;
        try { _pallet = OnlineOr(() => PopServices.Pallets.Inspect(no, itemNo ?? _selItemNo), () => OfflineWork.Inspect(no, itemNo ?? _selItemNo)); } catch { }
    }

    // 온라인이면 서버가, DB 가 끊겼으면(이미 알려졌거나 이번 호출이 연결 오류) 로컬 사본이 판정한다.
    // 로컬 판정은 사본에 없는 LOT·팔레트를 받아들여 큐에 올리고, 복구 뒤 서버가 거부하면 충돌 목록에 남는다.
    private (InjConfirmOutcome Outcome, string ItemNo, int WoId, BackflushResult Backflush, bool Unverified) ConfirmCore(string lotCode)
    {
        var s = Session!;
        var pallet = _pallet!.PalletNo;
        if (!PopDb.IsOffline)
        {
            try
            {
                var (o, _, item, wo) = PopServices.InjLots.ConfirmByLotCode(
                    lotCode, s.LineId, s.OperatorId, s.SessionId, s.EmployeeNo, pallet, out var bf);
                return (o, item, wo, bf, false);
            }
            catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { /* 아래 로컬 경로로 */ }
        }
        var r = OfflineWork.Confirm(lotCode, s.LineId, s.TerminalId, s.OperatorId, s.EmployeeNo, s.SessionId, pallet, _selItemNo);
        return (r.Outcome, r.ItemNo, r.WoId, BackflushResult.None, r.Unverified);
    }

    private void ConfirmScan(string lotCode)
    {
        if (Session is null) return;
        if (_pallet is null)
        {
            SetBanner(false, $"{T("PalletScanFirst")}: {lotCode}");
            _scanHistory.Insert(0, new ScanRecord(lotCode, DbClock.Now, false, T("PalletScanFirst")));
            _focusScan = true;
            return;
        }
        try
        {
            // 대상 WO 는 LOT 품번으로 리포지토리가 정한다 (동일 품번 여러 WO 면 빠른순). 팔레트에 못 실으면 확정도 되지 않는다.
            var (outcome, itemNo, woId, backflush, unverified) = ConfirmCore(lotCode);
            // GetById, not FindOpenForItem — 이 스캔이 마지막 수량이면 단계가 이미 Closed 로 바뀌어
            // FindOpenForItem 은 이 WO 를 못 찾는다. GetById 는 상태 무관하게 PK 로 조회한다.
            var woNumber = woId > 0 ? OnlineOr(() => PopServices.WorkOrders.GetById(woId)?.WoNumber, () => OfflineWork.WoNumber(woId)) : null;
            var (ok, detail) = outcome switch
            {
                InjConfirmOutcome.Confirmed        => (true,  $"{T("Confirmed")}: {lotCode} ({itemNo}){(woNumber is null ? "" : $" → {woNumber}")}{(unverified ? $" · {T("OfflineUnverified")}" : "")}"),
                InjConfirmOutcome.NotFound         => (false, $"{T("LotNotFound")}: {lotCode}"),
                InjConfirmOutcome.AlreadyConfirmed => (false, $"{T("AlreadyConfirmed")}: {lotCode}"),
                InjConfirmOutcome.NgBlocked        => (false, $"{T("BlockedByInspectionNgHandleInDefectPopup")}: {lotCode}"),
                InjConfirmOutcome.InRework         => (false, $"{T("LotInRework")}: {lotCode}"),
                InjConfirmOutcome.Scrapped         => (false, $"{T("LotScrapped")}: {lotCode}"),
                InjConfirmOutcome.WrongLine        => (false, $"{T("LotBelongsToAnotherLine")}: {lotCode}"),
                _ when PalletChip.NoticeKey(outcome) is { } k => (false, $"{T(k)}: {_pallet.PalletNo} ← {lotCode}"),
                _                                  => (false, $"{T("ConfirmFailed")}: {lotCode}"),
            };
            // 확정은 LOT 품번으로 WO 를 정했다 — 화면 선택도 그 품번으로 따라간다.
            // 확정분은 금일 수치에 올라가므로 과거 날짜를 보고 있었다면 금일로 돌린다.
            if (ok) { _selItemNo = itemNo; _viewDate = null; Refresh(); BackflushNotice.Show(Toasts, backflush, lotCode); }
            // 팔레트 칩은 실제 적재 수로 — 다른 터미널이 같은 팔레트에 실은 것도 보인다
            if (ok || PalletChip.NoticeKey(outcome) is not null) RefreshPallet(itemNo);
            SetBanner(ok, detail);
            // 이미 확정된 라벨을 또 찍은 것은 실적 사건이 아니다 — 이력에 NG 로 쌓이면
            // 실제 불량·차단과 섞여 보이므로 경고만 띄우고 이력에는 남기지 않는다.
            if (outcome == InjConfirmOutcome.AlreadyConfirmed) { Toasts.Warn(detail); return; }
            _scanHistory.Insert(0, new ScanRecord(lotCode, DbClock.Now, ok, detail));
            if (_scanHistory.Count > 50) _scanHistory.RemoveAt(_scanHistory.Count - 1);
        }
        catch (Exception ex)
        {
            // 작업자 화면에는 LOT 번호와 NG 만 — 예외 본문(SQL 오류 등)은 파일 로그로(10-21 사용자 요청)
            PopLog.Append("scan", "CONFIRM", $"{lotCode}: {ex}");
            SetBanner(false, $"{T("ConfirmFailed")}: {lotCode}");
            _scanHistory.Insert(0, new ScanRecord(lotCode, DbClock.Now, false, ex.Message));
            if (_scanHistory.Count > 50) _scanHistory.RemoveAt(_scanHistory.Count - 1);
        }
        finally { _focusScan = true; }
    }

    private void SetBanner(bool ok, string detail)
    {
        _bannerClass  = ok ? "ok" : "bad";
        _bannerDetail = detail;
    }

    private void Reprint(InjLotDto lot)
    {
        try
        {
            LabelPrinter.Print(lot, Session?.LineId);

            // 라벨이 나온 순간이 프린터가 살아났다는 증거다 — 뒤따르는 DB 실패로
            // 이 신호를 잃으면 자동 발행이 멈춘 채, 작업자는 누를 때마다 실물
            // 라벨만 태우게 된다. Resume() 은 IsStopped 를 벗어나는 유일한 길이다.
            Dispatcher.Resume();

            // 발행 횟수는 서버가 센다 — DB 가 끊겼거나 오프라인에서 만든 LOT(음수 ID)이면 서버에 아직 없으니 로컬에만 올린다.
            int? printed = null;
            if (!PopDb.IsOffline && lot.LotId > 0)
            {
                try { printed = PopServices.InjLots.IncrementPrintedCount(lot.LotId, Session?.EmployeeNo); }
                catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { }
                // 라벨은 이미 나왔다 — 카운트 실패를 재출력 실패로 안내하면 작업자가 다시 뽑는다. 기록만 남긴다.
                catch (Exception ex) { PopLog.Append("dispatch", "Label", $"printed but count not incremented ({lot.LotCode}): {ex.Message}"); }
            }
            if (printed is null) OfflineWork.MarkPrinted(lot.LotCode);
            Toasts.Ok(printed is int n ? $"{T("LabelReprinted")}: {lot.LotCode} ({T("Total2")} {n})" : $"{T("LabelReprinted")}: {lot.LotCode}");
            Refresh();
        }
        catch (Exception ex) { Toasts.Bad($"{T("ReprintFailed")}: {ex.Message}"); }
    }

    // ── 팝업 제어 ─────────────────────────────────────────────────────
    private void Open(Popup p) { _andonAutoRaise = false; _popup = p; }

    // 진행중 안돈이 있으면 그냥 연다. 없으면 여기서 확인받고 팝업이 열리자마자 발동한다 —
    // 팝업 안에서 한 번 더 버튼을 누르게 하지 않는다.
    private async Task OpenAndon()
    {
        // 안돈은 DB 에 기록·호출하는 흐름이라 오프라인에서는 쓸 수 없다 — 설비 쪽 경광등은 PLC 가 직접 제어한다
        if (PopDb.IsOffline) { Toasts.Warn(T("OfflineNotAvailable")); return; }
        if (_openAndon is null)
        {
            if (!await Confirmer.AskAsync(T("AndonConfirmTitle"), T("AndonConfirmBody"),
                                          T("RaiseAndon"), T("Close"), destructive: true)) return;
            _andonAutoRaise = true;
        }
        else _andonAutoRaise = false;
        _popup = Popup.Andon;
    }
    private void ClosePopup() { _popup = Popup.None; _focusScan = true; _ = RefreshNowAsync(); }

    // 오프라인에서 한 작업을 복구 뒤 서버가 거부한 건(이미 확정된 LOT, 없는 LOT, 팔레트 만재 등) — 관리자가 확인해야 한다.
    private async Task ShowConflicts()
    {
        var list = OfflineWork.Conflicts;
        if (list.Count == 0) return;
        var body = string.Join("\n", list.Select(c => $"{c.At:MM-dd HH:mm}  {c.Kind}  {c.LotCode} — {c.Reason}"));
        if (await Confirmer.AskAsync(T("OfflineConflicts", list.Count), body, T("OfflineConflictsClear"), T("Close")))
            OfflineWork.ClearConflicts();
    }

    // ── 수동 라벨 생성: 누를 때마다 원천 LOT(RAW) 1개. PLC 누락 보정용이며 실적이 아니다 —
    // 미확정 LOT 목록에 쌓이고 스캔해야 확정된다. 라벨은 LabelDispatcher 가 뽑는다 —
    // 여기서 뽑으면 디스패처와 이중 발행된다.
    private bool _creatingLabel;
    private void CreateManualLabel()
    {
        if (Session is null || _creatingLabel) return;
        if (_selItemNo is null) { Toasts.Bad(T("SelectPartFirst")); return; }
        _creatingLabel = true;
        try
        {
            // 품번은 좌측 선택(스테이션 BOP = 코어). 열린 WO 가 있으면 그 단계 품번·금형을 따르고, 없어도 발행은 막지 않는다 — WO 없는 생산 허용.
            var itemNo = _activeWo?.StepItemNo ?? _selItemNo;
            var moldId = _activeWo?.MoldId;
            if (!PopDb.IsOffline)
            {
                try
                {
                    var lot = PopServices.InjLots.CreateManualRawLots(Session.LineId, itemNo, moldId, 1, Session.EmployeeNo)[0];
                    Toasts.Ok(T("ManualLotCreated", lot.LotCode));
                    Refresh();
                    return;
                }
                catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { /* 아래 오프라인 경로로 */ }
            }
            CreateManualLabelOffline(itemNo, moldId);
        }
        catch (Exception ex) { Toasts.Bad($"{T("EntryFailed")}: {ex.Message}"); }
        finally { _creatingLabel = false; _focusScan = true; }
    }

    // 오프라인 수동 라벨 — 미리 확보한 번호로 LOT 을 만들고 라벨은 여기서 직접 뽑는다(라벨 디스패처는 DB 가 필요해 쉰다).
    // 뽑은 횟수를 LOT 과 함께 올려 두므로 복구 뒤 디스패처가 같은 LOT 을 또 뽑지 않는다.
    private void CreateManualLabelOffline(string itemNo, string? moldId)
    {
        var s = Session!;
        InjLotDto lot;
        try { lot = OfflineWork.CreateManualLot(s.LineId, s.TerminalId, s.OperatorId, s.EmployeeNo, s.SessionId, itemNo, moldId, 0).ToInj(); }
        catch (OfflineLotNumbersExhaustedException) { Toasts.Bad(T("OfflineLotNumbersExhausted")); return; }
        catch (InvalidOperationException) { Toasts.Bad(T("OfflineNoData")); return; }

        try
        {
            LabelPrinter.Print(lot, s.LineId);
            OfflineWork.MarkPrinted(lot.LotCode);
            Dispatcher.Resume();
        }
        catch (Exception ex) { Toasts.Bad($"{T("ReprintFailed")}: {ex.Message}"); }
        Toasts.Ok(T("ManualLotCreated", lot.LotCode));
        Refresh();
    }

    private async Task Logout()
    {
        if (!await Confirmer.AskAsync(
                T("LogoutConfirm"),
                T("EndYourShiftAndReturnToTheLoginScreen"),
                T("LogOut2"), T("Stay"), destructive: true)) return;
        Nav.NavigateTo("/login", replace: true);
        State.SignOut();
    }

    public void Dispose()
    {
        _disposed = true;
        Scanner.OnScan            -= OnSerialScan;
        Scanner.ConnectionChanged -= OnScannerConnection;
        _clockTimer?.Dispose();
        _refreshTimer?.Dispose();
    }
}
