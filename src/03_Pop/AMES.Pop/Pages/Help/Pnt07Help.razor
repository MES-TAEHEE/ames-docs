@*  PNT-07 Label Apply user manual. *@

<div class="help-doc">
    <div>
        <div class="help-h1">PNT-07 · LABEL APPLY</div>
        <div class="help-sub">FG 라벨 부착 — 확정 LOT 선택 → 미리보기 → 인쇄</div>

        <svg class="help-svg" viewBox="0 0 720 480" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="708" height="468" rx="10" fill="#000" stroke="rgba(255,255,255,.18)" stroke-width="1.5" />
            <rect class="hs-region tbar" x="14" y="14" width="692" height="42" fill="#1a0800" stroke="rgba(234,88,12,.35)" />

            @for (var i = 0; i < 4; i++)
            {
                var x = 14 + i * 174; var cls = new[]{"","ok","","warn"}[i];
                var titles = new[]{"PENDING","LABELED","SELECTED","TYPE"};
                var vals = new[]{"2","32","#9","FG-A4"};
                <g>
                    <rect class="hs-region @cls" x="@x" y="68" width="162" height="74" />
                    <text class="hs-sub" x="@(x+12)" y="88">@titles[i]</text>
                    <text class="hs-label" x="@(x+12)" y="124" style="font-size:22px;">@vals[i]</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="78" r="14" />
            <text class="hs-num-tx" x="24" y="78">1</text>

            <rect class="hs-region" x="14" y="156" width="338" height="220" />
            <text class="hs-sub" x="28" y="176" fill="#fdba74">▼ CONFIRMED LOTS</text>
            @for (var i = 0; i < 3; i++)
            {
                var y = 192 + i * 60;
                var sel = i == 0;
                <g>
                    <rect class="hs-region @(sel ? "warn" : "")" x="28" y="@y" width="310" height="52" />
                    <text class="hs-sub" x="42" y="@(y+18)">LOT #@(9+i)  ·  CONFIRMED</text>
                    <text class="hs-label" x="42" y="@(y+40)" style="font-size:13px;">DOOR TRIM · 32 EA</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="166" r="14" />
            <text class="hs-num-tx" x="24" y="166">2</text>

            <rect class="hs-region" x="366" y="156" width="340" height="220" />
            <text class="hs-sub" x="380" y="176" fill="#fdba74">▼ LABEL PREVIEW</text>
            <rect x="384" y="186" width="316" height="180" rx="6" fill="#fff" stroke="rgba(255,255,255,.2)" />
            <text x="400" y="210" style="font: 800 12px monospace; fill:#000;">SEOYON E-HWA · A-MES</text>
            <text x="400" y="234" style="font: 600 10px monospace; fill:#000;">ITEM: DR-TRM-LH-A1</text>
            <text x="400" y="250" style="font: 600 10px monospace; fill:#000;">RAL: 9005 · BLACK</text>
            <text x="400" y="266" style="font: 600 10px monospace; fill:#000;">QTY: 32 EA</text>
            <text x="400" y="282" style="font: 600 10px monospace; fill:#000;">LOT: VL-9 · JIG-007</text>
            <text x="400" y="332" style="font: 400 9px monospace; fill:#666;">[barcode]  ▮▮▯▮▯▯▮▯▮▮▯▮▯▯▮</text>
            <circle class="hs-num" cx="378" cy="166" r="14" />
            <text class="hs-num-tx" x="378" y="166">3</text>

            <rect class="hs-region ok" x="278" y="386" width="428" height="40" />
            <text class="hs-label" x="492" y="412" text-anchor="middle" style="font-size:16px;">✓ APPLY LABEL &amp; PRINT</text>
            <circle class="hs-num" cx="288" cy="394" r="13" />
            <text class="hs-num-tx" x="288" y="394">4</text>

            <rect class="hs-region nav" x="14" y="432" width="692" height="32" />
        </svg>
    </div>

    <div>
        <div class="help-section-h">▶ STEPS · 단계</div>
        <div class="help-steps">
            <div class="help-step"><div class="help-step-num">1</div><div class="help-step-body"><div class="help-step-en">4 KPI tiles.</div><div class="help-step-ko">4개 KPI.</div></div></div>
            <div class="help-step warn"><div class="help-step-num">2</div><div class="help-step-body"><div class="help-step-en">Pick a CONFIRMED lot.</div><div class="help-step-ko">확정된 LOT 선택.</div></div></div>
            <div class="help-step"><div class="help-step-num">3</div><div class="help-step-body"><div class="help-step-en">FG label preview.</div><div class="help-step-ko">FG 라벨 미리보기.</div></div></div>
            <div class="help-step ok"><div class="help-step-num">4</div><div class="help-step-body"><div class="help-step-en">APPLY advances LOT → LABELED + queues Zebra print.</div><div class="help-step-ko">적용 시 LOT → LABELED + Zebra 인쇄 큐.</div></div></div>
        </div>
    </div>
</div>
