@*  QC-02 In-Process Inspection user manual. *@

<div class="help-doc">
    <div>
        <div class="help-h1">QC-02 · IN-PROCESS</div>
        <div class="help-sub">공정 패트롤 검사 — WO 진행 중 1/N 빈도 샘플</div>

        <svg class="help-svg" viewBox="0 0 720 480" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="708" height="468" rx="10" fill="#000" stroke="rgba(255,255,255,.18)" stroke-width="1.5" />
            <rect class="hs-region tbar" x="14" y="14" width="692" height="42" fill="#1a0000" stroke="rgba(220,38,38,.35)" />

            @for (var i = 0; i < 4; i++)
            {
                var x = 14 + i * 174; var cls = new[]{"","ok","bad","warn"}[i];
                var titles = new[]{"PATROL","PASS","FAIL","OPEN"};
                var vals = new[]{"2","1","1","0"};
                <g>
                    <rect class="hs-region @cls" x="@x" y="68" width="162" height="78" />
                    <text class="hs-sub" x="@(x+12)" y="88" fill="#fca5a5">@titles[i]</text>
                    <text class="hs-label" x="@(x+12)" y="128" style="font-size:24px;">@vals[i]</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="78" r="14" />
            <text class="hs-num-tx" x="24" y="78">1</text>

            <rect class="hs-region" x="14" y="158" width="338" height="200" />
            <text class="hs-sub" x="28" y="178" fill="#fca5a5">▼ PATROL PER LINE</text>
            @for (var i = 0; i < 3; i++)
            {
                var y = 192 + i * 60;
                var lines = new[] {"LINE-INJ-01","LINE-INJ-01","LINE-IMG-01"};
                var verdicts = new[] {"PASS","FAIL","PASS"};
                var cls = i == 1 ? "bad" : "ok";
                <g>
                    <rect class="hs-region @cls" x="28" y="@y" width="310" height="52" />
                    <text class="hs-sub" x="42" y="@(y+18)">IP-2506010@(i+2)  ·  @lines[i]</text>
                    <text class="hs-label" x="42" y="@(y+40)" style="font-size:14px;">@verdicts[i]</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="168" r="14" />
            <text class="hs-num-tx" x="24" y="168">2</text>

            <rect class="hs-region" x="368" y="158" width="338" height="200" />
            <text class="hs-sub" x="382" y="178" fill="#fca5a5">▼ MEASUREMENT</text>
            @{
                var rows = new[] { ("Length","211.0±1","213.2","FAIL"), ("Width","90.0±0.5","90.0","PASS"), ("Adhesion","≥4 N/mm","2.8","FAIL") };
            }
            @for (var i = 0; i < 3; i++)
            {
                var y = 208 + i * 26;
                var r = rows[i];
                var col = r.Item4 == "PASS" ? "#22c55e" : "#fca5a5";
                <g>
                    <text class="hs-sub" x="386" y="@y">@r.Item1</text>
                    <text class="hs-sub" x="500" y="@y">@r.Item2</text>
                    <text class="hs-sub" x="590" y="@y">@r.Item3</text>
                    <text class="hs-sub" x="660" y="@y" fill="@col">@r.Item4</text>
                </g>
            }
            <circle class="hs-num" cx="378" cy="168" r="14" />
            <text class="hs-num-tx" x="378" y="168">3</text>

            <rect class="hs-region" x="14" y="370" width="220" height="48" />
            <text class="hs-label" x="124" y="402" text-anchor="middle" style="font-size:14px;">+ NEW PATROL</text>
            <rect class="hs-region ok" x="248" y="370" width="220" height="48" />
            <text class="hs-label" x="358" y="402" text-anchor="middle" style="font-size:14px;">✓ PASS</text>
            <rect class="hs-region bad" x="482" y="370" width="224" height="48" />
            <text class="hs-label" x="594" y="402" text-anchor="middle" style="font-size:14px;">✗ FAIL → NCR</text>

            <rect class="hs-region nav" x="14" y="432" width="692" height="32" />
        </svg>
    </div>

    <div>
        <div class="help-section-h">▶ STEPS · 단계</div>
        <div class="help-steps">
            <div class="help-step"><div class="help-step-num">1</div><div class="help-step-body"><div class="help-step-en">4 KPI — patrol totals.</div><div class="help-step-ko">패트롤 총계.</div></div></div>
            <div class="help-step"><div class="help-step-num">2</div><div class="help-step-body"><div class="help-step-en">Per-line patrol cards.</div><div class="help-step-ko">라인별 패트롤 카드.</div></div></div>
            <div class="help-step bad"><div class="help-step-num">3</div><div class="help-step-body"><div class="help-step-en">Measurement detail. FAIL rows highlighted red.</div><div class="help-step-ko">측정값 상세. 불합격 빨강 강조.</div></div></div>
        </div>
        <div class="help-callout warn">
            <div class="help-callout-i">⚠</div>
            <div class="help-callout-tx"><strong>FAIL on in-process patrol</strong> → auto-creates NCR and freezes the line until the supervisor reviews.<br/><span style="color:rgba(255,255,255,.55);">패트롤 불합격 시 NCR 자동 생성 + 반장 검토 전까지 라인 정지.</span></div>
        </div>
    </div>
</div>
