@*  IMG-007 Production Status user manual. *@

<div class="help-doc">
    <div>
        <div class="help-h1">IMG-007 · PROD STATUS</div>
        <div class="help-sub">감싸기 생산 현황 — 라인 KPI 다행 비교</div>

        <svg class="help-svg" viewBox="0 0 720 480" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="708" height="468" rx="10" fill="#000" stroke="rgba(255,255,255,.18)" stroke-width="1.5" />
            <rect class="hs-region tbar" x="14" y="14" width="692" height="42" />
            <text class="hs-sub" x="34" y="40">IMG-007 · STATION · LINE</text>

            <rect class="hs-region ok"   x="14"  y="68" width="170" height="80" />
            <text class="hs-sub" x="28" y="88">GOOD</text>
            <text class="hs-label" x="28" y="128" style="font-size:28px;">98</text>

            <rect class="hs-region bad"  x="194" y="68" width="170" height="80" />
            <text class="hs-sub" x="208" y="88">DEFECT</text>
            <text class="hs-label" x="208" y="128" style="font-size:28px;" fill="#fca5a5">0</text>

            <rect class="hs-region warn" x="374" y="68" width="170" height="80" />
            <text class="hs-sub" x="388" y="88">DEFECT %</text>
            <text class="hs-label" x="388" y="128" style="font-size:28px;" fill="#fbbf24">0.0%</text>

            <rect class="hs-region"      x="554" y="68" width="152" height="80" />
            <text class="hs-sub" x="568" y="88">FABRIC m</text>
            <text class="hs-label" x="568" y="128" style="font-size:28px;">340</text>
            <circle class="hs-num" cx="24" cy="78" r="14" />
            <text class="hs-num-tx" x="24" y="78">1</text>

            <rect class="hs-region" x="14" y="160" width="692" height="230" />
            <text class="hs-sub" x="28" y="180">▼ LINE COMPARISON · 라인별 비교</text>
            @{
                var lines = new[] { "LINE-IMG-001","LINE-IMG-002","LINE-INJ-001","LINE-PNT-001" };
                var vals  = new[] { "98 EA / 0.0%","56 EA / 1.8%","182 EA / 2.1%","32 EA / 0.0%" };
            }
            @for (var i = 0; i < lines.Length; i++)
            {
                var y = 196 + i * 44;
                <g>
                    <rect x="28" y="@y" width="664" height="36" rx="4" fill="rgba(0,0,0,.3)" stroke="rgba(124,58,237,.18)" />
                    <text class="hs-label" x="44" y="@(y+22)" style="font-size:13px;">@lines[i]</text>
                    <text class="hs-sub" x="676" y="@(y+22)" text-anchor="end">@vals[i]</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="170" r="14" />
            <text class="hs-num-tx" x="24" y="170">2</text>

            <rect class="hs-region nav" x="14" y="432" width="692" height="32" />
        </svg>
    </div>

    <div>
        <div class="help-section-h">▶ STEPS · 단계</div>
        <div class="help-steps">
            <div class="help-step ok"><div class="help-step-num">1</div><div class="help-step-body"><div class="help-step-en">4 KPI tiles for current line.</div><div class="help-step-ko">현재 라인 4개 KPI.</div></div></div>
            <div class="help-step"><div class="help-step-num">2</div><div class="help-step-body"><div class="help-step-en">Per-line comparison table.</div><div class="help-step-ko">라인별 비교표.</div></div></div>
        </div>
        <div class="help-callout info">
            <div class="help-callout-i">💡</div>
            <div class="help-callout-tx">Read-only. Entry → IMG-003.<br/><span style="color:rgba(255,255,255,.55);">읽기 전용. 입력은 IMG-003.</span></div>
        </div>
    </div>
</div>
