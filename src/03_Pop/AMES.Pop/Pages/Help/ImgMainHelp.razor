            <text class="hs-label" x="300" y="142" text-anchor="end" style="font-size:12px;">120</text>
            <text class="hs-label" x="345" y="142" text-anchor="end" style="font-size:12px;">3</text>
            <text class="hs-label" x="400" y="142" text-anchor="end" style="font-size:12px;">72</text>

            <text class="hs-label" x="28" y="174" style="font-size:12px;">DR-TRM-RH-W</text>
            <rect x="120" y="162" width="46" height="16" rx="8" fill="rgba(255,255,255,.10)" />
            <text class="hs-sub" x="143" y="174" text-anchor="middle" style="font-size:8px;">NO WO</text>
            <text class="hs-label" x="250" y="174" text-anchor="end" style="font-size:12px;">0</text>
            <text class="hs-label" x="300" y="174" text-anchor="end" style="font-size:12px;">0</text>
            <text class="hs-label" x="345" y="174" text-anchor="end" style="font-size:12px;">0</text>
            <text class="hs-label" x="400" y="174" text-anchor="end" style="font-size:12px;">0</text>

