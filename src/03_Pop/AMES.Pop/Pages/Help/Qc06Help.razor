@*  QC-006 CAPA user manual. *@

<div class="help-doc">
    <div>
        <div class="help-h1">QC-006 · CAPA</div>
        <div class="help-sub">시정·예방 조치 — Open CAPA + 액션 단계별 추적</div>

        <svg class="help-svg" viewBox="0 0 720 480" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="708" height="468" rx="10" fill="#000" stroke="rgba(255,255,255,.18)" stroke-width="1.5" />
            <rect class="hs-region tbar" x="14" y="14" width="692" height="42" fill="#1a0000" stroke="rgba(220,38,38,.35)" />

            @for (var i = 0; i < 4; i++)
            {
                var x = 14 + i * 174; var cls = new[]{"","warn","bad","ok"}[i];
                var titles = new[]{"OPEN","DUE 7D","OVERDUE","DONE"};
                var vals = new[]{"2","1","0","1/3"};
                <g>
                    <rect class="hs-region @cls" x="@x" y="68" width="162" height="74" />
                    <text class="hs-sub" x="@(x+12)" y="88" fill="#fca5a5">@titles[i]</text>
                    <text class="hs-label" x="@(x+12)" y="124" style="font-size:22px;">@vals[i]</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="78" r="14" />
            <text class="hs-num-tx" x="24" y="78">1</text>

            <rect class="hs-region" x="14" y="156" width="338" height="200" />
            <text class="hs-sub" x="28" y="176" fill="#fca5a5">▼ OPEN CAPAs</text>
            @for (var i = 0; i < 2; i++)
            {
                var y = 192 + i * 76; var sel = i == 0;
                <g>
                    <rect class="hs-region @(sel ? "warn" : "")" x="28" y="@y" width="310" height="68" />
                    <text class="hs-label" x="42" y="@(y+22)" style="font-size:14px;">CAPA-2506000@(i+1)</text>
                    <text class="hs-sub" x="42" y="@(y+42)">@(new[]{"Bond pressure drift","Calibration log"}[i])</text>
                    <text class="hs-sub" x="42" y="@(y+58)">Phase @(new[]{"Action","Plan"}[i])  ·  Due D+@(new[]{"4","12"}[i])</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="166" r="14" />
            <text class="hs-num-tx" x="24" y="166">2</text>

            <rect class="hs-region" x="368" y="156" width="338" height="200" />
            <text class="hs-sub" x="382" y="176" fill="#fca5a5">▼ ACTIONS · #1</text>
            @{
                var actions = new[] { ("D+1","Replace regulator","PASS","#22c55e"), ("D+7","Stability check","—","rgba(255,255,255,.4)") };
            }
            @for (var i = 0; i < 2; i++)
            {
                var y = 200 + i * 60;
                var a = actions[i];
                <g>
                    <text class="hs-sub" x="384" y="@y">@a.Item1</text>
                    <text class="hs-sub" x="430" y="@y">@a.Item2</text>
                    <text class="hs-sub" x="660" y="@y" fill="@a.Item4">@a.Item3</text>
                </g>
            }
            <circle class="hs-num" cx="378" cy="166" r="14" />
            <text class="hs-num-tx" x="378" y="166">3</text>

            <rect class="hs-region nav" x="14" y="432" width="692" height="32" />
        </svg>
    </div>

    <div>
        <div class="help-section-h">▶ <span class="h-sec-en">STEPS</span><span class="h-sec-ko">단계</span></div>
        <div class="help-steps">
            <div class="help-step"><div class="help-step-num">1</div><div class="help-step-body"><div class="help-step-en">4 KPI — open / due-soon / overdue / actions completed.</div><div class="help-step-ko">4개 KPI.</div></div></div>
            <div class="help-step warn"><div class="help-step-num">2</div><div class="help-step-body"><div class="help-step-en">Pick a CAPA card.</div><div class="help-step-ko">CAPA 카드 선택.</div></div></div>
            <div class="help-step"><div class="help-step-num">3</div><div class="help-step-body"><div class="help-step-en">Actions table — check-day, description, metric/target/actual, verdict.</div><div class="help-step-ko">액션 표 — D+일, 설명, 목표/실측, 판정.</div></div></div>
        </div>
        <div class="help-callout info">
            <div class="help-callout-i">💡</div>
            <div class="help-callout-tx"><span class="h-call-en">Read-only here. Action entry comes from a separate CAPA owner web screen.</span><span class="h-call-ko">이 화면은 읽기 전용. 액션 등록은 별도 웹 화면.</span></div>
        </div>
    </div>
</div>
