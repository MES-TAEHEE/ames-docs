@*  IMG-005 Defect (Wrapping) user manual. *@

<div class="help-doc">
    <div>
        <div class="help-h1">IMG-005 · DEFECT</div>
        <div class="help-sub">감싸기 불량 등록 — 코드 + 수량</div>

        <svg class="help-svg" viewBox="0 0 720 480" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="708" height="468" rx="10" fill="#000" stroke="rgba(255,255,255,.18)" stroke-width="1.5" />
            <rect class="hs-region tbar" x="14" y="14" width="692" height="42" />
            <text class="hs-sub" x="34" y="40">IMG-005 · STATION · LINE</text>

            <rect class="hs-region bad" x="14" y="68" width="692" height="56" />
            <text class="hs-sub" x="28" y="88">DEFECT RATE</text>
            <text class="hs-label" x="28" y="116" style="font-size:22px;" fill="#fca5a5">0.8%</text>
            <circle class="hs-num" cx="24" cy="78" r="14" />
            <text class="hs-num-tx" x="24" y="78">1</text>

            <rect class="hs-region" x="14" y="138" width="692" height="216" />
            <text class="hs-sub" x="28" y="158">▼ DEFECT CODE</text>
            @{
                var names = new[] {"Wrinkle","Tear","Color Off","Adhesion","Bubble","Misalign"};
            }
            @for (var i = 0; i < 6; i++)
            {
                var col = i % 3; var row = i / 3;
                var x = 36 + col * 224; var y = 174 + row * 84;
                var sel = i == 0;
                <g>
                    <rect class="hs-region @(sel ? "warn" : "")" x="@x" y="@y" width="200" height="68" />
                    <text class="hs-sub" x="@(x+14)" y="@(y+22)">IMG-D0@(i+1)</text>
                    <text class="hs-label" x="@(x+14)" y="@(y+48)" style="font-size:14px;">@names[i]</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="148" r="14" />
            <text class="hs-num-tx" x="24" y="148">2</text>

            <rect class="hs-region" x="14" y="366" width="430" height="50" />
            <text class="hs-sub" x="28" y="392">DEFECT QTY  ·  1</text>
            <circle class="hs-num" cx="24" cy="376" r="13" />
            <text class="hs-num-tx" x="24" y="376">3</text>

            <rect class="hs-region bad" x="458" y="366" width="248" height="50" />
            <text class="hs-label" x="582" y="398" text-anchor="middle" style="font-size:18px;">⚠ REGISTER</text>
            <circle class="hs-num" cx="468" cy="376" r="13" />
            <text class="hs-num-tx" x="468" y="376">4</text>

            <rect class="hs-region nav" x="14" y="432" width="692" height="32" />
        </svg>
    </div>

    <div>
        <div class="help-section-h">▶ <span class="h-sec-en">STEPS</span><span class="h-sec-ko">단계</span></div>
        <div class="help-steps">
            <div class="help-step bad"><div class="help-step-num">1</div><div class="help-step-body"><div class="help-step-en">Today's defect rate vs the 5% target.</div><div class="help-step-ko">금일 불량률 vs 5% 목표.</div></div></div>
            <div class="help-step warn"><div class="help-step-num">2</div><div class="help-step-body"><div class="help-step-en">Pick a defect code card.</div><div class="help-step-ko">불량 코드 카드 선택.</div></div></div>
            <div class="help-step"><div class="help-step-num">3</div><div class="help-step-body"><div class="help-step-en">Enter qty ≥ 1.</div><div class="help-step-ko">불량 수량 입력 (≥1).</div></div></div>
            <div class="help-step bad"><div class="help-step-num">4</div><div class="help-step-body"><div class="help-step-en">REGISTER writes PR_DefectDetail.</div><div class="help-step-ko">등록 시 PR_DefectDetail 기록.</div></div></div>
        </div>
    </div>
</div>
