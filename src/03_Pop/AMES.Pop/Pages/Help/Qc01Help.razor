@*  QC-001 Incoming Inspection user manual. *@

<div class="help-doc">
    <div>
        <div class="help-h1">QC-001 · INCOMING</div>
        <div class="help-sub">수입 검사 — AQL 샘플링 → PASS/FAIL → tbl_Lot.QualityFlag</div>

        <svg class="help-svg" viewBox="0 0 720 480" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="708" height="468" rx="10" fill="#000" stroke="rgba(255,255,255,.18)" stroke-width="1.5" />
            <rect class="hs-region tbar" x="14" y="14" width="692" height="42" fill="#1a0000" stroke="rgba(220,38,38,.35)" />

            @for (var i = 0; i < 4; i++)
            {
                var x = 14 + i * 174; var cls = new[]{"","ok","bad","warn"}[i];
                var titles = new[]{"TODAY","PASS","FAIL","OPEN"};
                var vals = new[]{"4","2","1","1"};
                <g>
                    <rect class="hs-region @cls" x="@x" y="68" width="162" height="78" />
                    <text class="hs-sub" x="@(x+12)" y="88" fill="#fca5a5">@titles[i]</text>
                    <text class="hs-label" x="@(x+12)" y="128" style="font-size:24px;">@vals[i]</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="78" r="14" />
            <text class="hs-num-tx" x="24" y="78">1</text>

            <rect class="hs-region" x="14" y="158" width="338" height="200" />
            <text class="hs-sub" x="28" y="178" fill="#fca5a5">▼ INSPECTIONS</text>
            @for (var i = 0; i < 3; i++)
            {
                var y = 192 + i * 60;
                var verdicts = new[] {"PASS","FAIL","IN_PROGRESS"};
                var v = verdicts[i];
                var cls = i == 0 ? "ok" : i == 1 ? "bad" : "warn";
                var sel = i == 0;
                <g>
                    <rect class="hs-region @cls @(sel ? "warn" : "")" x="28" y="@y" width="310" height="52" />
                    <text class="hs-sub" x="42" y="@(y+18)">INC-25060101</text>
                    <text class="hs-label" x="42" y="@(y+40)" style="font-size:14px;">@v</text>
                </g>
            }
            <circle class="hs-num" cx="24" cy="168" r="14" />
            <text class="hs-num-tx" x="24" y="168">2</text>

            <rect class="hs-region" x="368" y="158" width="338" height="200" />
            <text class="hs-sub" x="382" y="178" fill="#fca5a5">▼ MEASUREMENT · #1</text>
            <line x1="382" y1="190" x2="700" y2="190" stroke="rgba(252,165,165,.3)" />
            @{
                var rows = new[] { ("Length","211.0±1","210.8","PASS"), ("Width","90.0±0.5","90.1","PASS"), ("Colour","Master","OK","PASS") };
            }
            @for (var i = 0; i < 3; i++)
            {
                var y = 208 + i * 26;
                var r = rows[i];
                <g>
                    <text class="hs-sub" x="386" y="@y">@r.Item1</text>
                    <text class="hs-sub" x="500" y="@y">@r.Item2</text>
                    <text class="hs-sub" x="590" y="@y">@r.Item3</text>
                    <text class="hs-sub" x="660" y="@y" fill="#22c55e">@r.Item4</text>
                </g>
            }
            <circle class="hs-num" cx="378" cy="168" r="14" />
            <text class="hs-num-tx" x="378" y="168">3</text>

            <rect class="hs-region" x="14" y="370" width="220" height="48" />
            <text class="hs-label" x="124" y="402" text-anchor="middle" style="font-size:14px;">+ NEW</text>
            <rect class="hs-region ok" x="248" y="370" width="220" height="48" />
            <text class="hs-label" x="358" y="402" text-anchor="middle" style="font-size:14px;">✓ PASS</text>
            <rect class="hs-region bad" x="482" y="370" width="224" height="48" />
            <text class="hs-label" x="594" y="402" text-anchor="middle" style="font-size:14px;">✗ FAIL → NCR</text>
            <circle class="hs-num" cx="24" cy="380" r="14" />
            <text class="hs-num-tx" x="24" y="380">4</text>

            <rect class="hs-region nav" x="14" y="432" width="692" height="32" />
        </svg>
    </div>

    <div>
        <div class="help-section-h">▶ <span class="h-sec-en">STEPS</span><span class="h-sec-ko">단계</span></div>
        <div class="help-steps">
            <div class="help-step"><div class="help-step-num">1</div><div class="help-step-body"><div class="help-step-en">4 KPI tiles for today.</div><div class="help-step-ko">금일 4개 KPI.</div></div></div>
            <div class="help-step warn"><div class="help-step-num">2</div><div class="help-step-body"><div class="help-step-en">Pick an inspection card. Border color: green=PASS, red=FAIL, yellow=in progress.</div><div class="help-step-ko">검사 카드 선택. 테두리: 초록 PASS · 빨강 FAIL · 노랑 진행중.</div></div></div>
            <div class="help-step"><div class="help-step-num">3</div><div class="help-step-body"><div class="help-step-en">Measurement table. Each characteristic vs spec; result column shows PASS/FAIL.</div><div class="help-step-ko">측정값 표 — 특성별 스펙 비교.</div></div></div>
            <div class="help-step ok"><div class="help-step-num">4</div><div class="help-step-body"><div class="help-step-en">+ NEW opens a new inspection. PASS / FAIL finalize. FAIL auto-suggests NCR-04.</div><div class="help-step-ko">+ 신규 검사 / PASS / FAIL 확정. FAIL은 NCR-04 자동 제안.</div></div></div>
        </div>
    </div>
</div>
