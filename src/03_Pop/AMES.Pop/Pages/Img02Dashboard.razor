@page "/img02"
@implements IDisposable
@inject NavigationManager Nav

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">IMG-02 · @Session.TerminalId · @Session.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span class="@_eqClass">● @_eqStatus</span>
            <span>@Session.EmployeeName · @Session.ShiftCode</span>
            <span>@_now.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
    </div>

    <div class="pop-bd">
        <div class="dash-top">
            <div class="pop-card">
                <div class="pop-card-h">▼ WO PROGRESS · @(_wo?.WoNumber ?? "—") · @(_wo?.ItemNameEn ?? _wo?.ItemName ?? "—")</div>
                <div class="wo-progress">
                    <span class="wo-progress-v">@(_wo?.CompletedQty.ToString("0") ?? "—")</span>
                    <span class="wo-progress-t">/ @(_wo?.OrderQty.ToString("0") ?? "—") EA</span>
                    <span class="wo-progress-pct">@_woPct%</span>
                </div>
                <div class="dash-progress-bar">
                    <div class="dash-progress-fill" style="width:@_woPct%;"></div>
                </div>
                <div class="wo-info">
                    <div><div class="wo-info-l">FABRIC</div><div class="wo-info-v @_fabricClass">@_fabricText</div></div>
                    <div><div class="wo-info-l">COLOR</div><div class="wo-info-v">@_fabricColor</div></div>
                    <div><div class="wo-info-l">RECIPE</div><div class="wo-info-v">@(_wo?.RecipeId ?? "—")</div></div>
                    <div><div class="wo-info-l">CYCLE</div><div class="wo-info-v">@_cycleText</div></div>
                </div>
            </div>

            <div class="pop-card">
                <div class="pop-card-h">▼ EQUIPMENT STATUS · @(_eq?.EquipName ?? "—")</div>
                <div class="eq-status">
                    <div class="eq-led @_ledClass"></div>
                    <div class="eq-status-t @_ledClass">@_eqStatus</div>
                    <div class="eq-status-s">Uptime @_uptimeText</div>
                </div>
            </div>
        </div>

        <div class="bond-grid">
            <div class="bond-card @_bondClass">
                <div class="bond-card-h">▼ BOND PRESSURE</div>
                <div><span class="bond-v @_bondClass">@_pressureText</span><span class="bond-u">bar</span></div>
                <div class="bond-spec">setpoint · @(_bond is null ? "no recipe" : $"tol ±0.30 bar")</div>
            </div>
            <div class="bond-card @_bondClass">
                <div class="bond-card-h">▼ BOND TEMPERATURE</div>
                <div><span class="bond-v @_bondClass">@_tempText</span><span class="bond-u">°C</span></div>
                <div class="bond-spec">setpoint · tol ±5 °C</div>
            </div>
            <div class="bond-card @_bondClass">
                <div class="bond-card-h">▼ HOLD TIME</div>
                <div><span class="bond-v @_bondClass">@_holdText</span><span class="bond-u">s</span></div>
                <div class="bond-spec">setpoint · tol ±10 s</div>
            </div>
        </div>

        <div class="dash-mid">
            <div class="pop-card gauge">
                <div class="gauge-v @_defectClass">@_defectText</div>
                <div class="gauge-l">Defect Rate</div>
                <div class="gauge-sub">limit 5%</div>
            </div>
            <div class="pop-card gauge">
                <div class="gauge-v @_fabricClass">@_fabricMText</div>
                <div class="gauge-l">Fabric Remaining</div>
                <div class="gauge-sub">@_fabricRoll</div>
            </div>
            <div class="pop-card gauge">
                <div class="gauge-v dim">—</div>
                <div class="gauge-l">OEE</div>
                <div class="gauge-sub">TODO</div>
            </div>
        </div>

        <div class="pop-card hourly-chart" style="flex:1;">
            <div class="pop-card-h">▼ HOURLY OUTPUT · 시간별 (target 20/h)</div>
            <div class="hc-bars">
                @for (var h = 6; h <= 17; h++)
                {
                    var bucket = _hourly?.FirstOrDefault(x => x.Hour == h);
                    var max = Math.Max(20, _hourlyMax);
                    var pct = bucket is null ? 0 : (int)((bucket.GoodQty + bucket.DefectQty) * 100.0 / max);
                    var cls = h == _now.Hour ? "hc-bar now" : (h > _now.Hour ? "hc-bar target" : "hc-bar");
                    <div class="@cls" style="height:@(h > _now.Hour ? 100 : Math.Clamp(pct, 2, 100))%;"></div>
                }
            </div>
            <div class="hc-labels">
                @for (var h = 6; h <= 17; h++) { <div class="@(h == _now.Hour ? "now" : "")">@h.ToString("00")</div> }
            </div>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:7;">
        <button class="nav-btn primary" @onclick="@(() => Nav.NavigateTo("/img03"))">▶ IMG-03<small>Prod Entry</small></button>
        <button class="nav-btn"         style="background:#5a279e;" @onclick="@(() => Nav.NavigateTo("/img04"))">⚡ IMG-04<small>Fabric Input</small></button>
        <button class="nav-btn warn"    @onclick="@(() => Nav.NavigateTo("/img05"))">▶ IMG-05<small>Defect</small></button>
        <button class="nav-btn gold"    @onclick="@(() => Nav.NavigateTo("/img06"))">▶ IMG-06<small>Bond Setup</small></button>
        <button class="nav-btn"         @onclick="@(() => Nav.NavigateTo("/img07"))">▶ IMG-07<small>Prod Status</small></button>
        <button class="nav-btn alert"   @onclick="@(() => Nav.NavigateTo("/inj08"))">🚨 ANDON<small></small></button>
        <button class="nav-btn muted"   @onclick="Logout">◀ LOGOUT<small></small></button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto Session { get; set; } = null!;

    WorkOrderDto?    _wo;
    EquipmentDto?    _eq;
    BondSetupDto?    _bond;
    FabricRollDto?   _roll;
    IReadOnlyList<HourlyOutputDto>? _hourly;
    int     _woPct, _hourlyMax = 1;
    string  _eqStatus = "OFFLINE", _eqClass = "stat-off", _ledClass = "offline", _uptimeText = "—";
    string  _defectText = "0.0%", _defectClass = "ok";
    string  _bondClass = "ok";
    string  _pressureText = "—", _tempText = "—", _holdText = "—";
    string  _fabricMText = "— m", _fabricText = "—", _fabricColor = "—", _fabricClass = "ok", _fabricRoll = "no roll";
    string  _cycleText = "—";
    DateTime _now = DateTime.Now;
    System.Threading.Timer? _refresh, _clock;

    protected override void OnInitialized()
    {
        Refresh();
        _refresh = new System.Threading.Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }), null, 5000, 5000);
        _clock   = new System.Threading.Timer(_ => InvokeAsync(() => { _now = DateTime.Now; StateHasChanged(); }), null, 1000, 1000);
    }

    void Refresh()
    {
        _wo = PopServices.WorkOrders.GetActiveForTerminal(Session.LineId, Session.TerminalId)
           ?? PopServices.WorkOrders.ListForLine(Session.LineId).FirstOrDefault();
        if (_wo is not null)
        {
            _woPct = (int)Math.Clamp(_wo.ProgressPct, 0, 100);
            if (!string.IsNullOrEmpty(_wo.RecipeId))
                _cycleText = $"{PopServices.Master.GetRecipeCycleTime(_wo.RecipeId)?.ToString() ?? "—"} sec";
            var (g, d) = PopServices.Defects.GetWoTotals(_wo.WoId);
            var pct = (g + d) == 0 ? 0 : d * 100.0 / (g + d);
            _defectText  = $"{pct:0.0}%";
            _defectClass = pct >= 5 ? "alert" : pct >= 4 ? "warn" : "ok";
        }

        _eq = PopServices.Equipment.GetPrimaryForLine(Session.LineId);
        _eqStatus = (_eq?.Status ?? "OFFLINE").ToUpperInvariant();
        (_eqClass, _ledClass) = _eqStatus switch
        {
            "RUN"   => ("stat-on", ""),
            "IDLE"  => ("stat-on", "idle"),
            "STOP"  => ("stat-off", "stop"),
            _       => ("stat-off", "offline"),
        };
        _uptimeText = _eq?.Uptime is null
                    ? "—"
                    : $"{(int)_eq.Uptime.Value.TotalHours:00}:{_eq.Uptime.Value.Minutes:00}:{_eq.Uptime.Value.Seconds:00}";

        _bond = PopServices.Bond.GetActiveForLine(Session.LineId);
        if (_bond is not null)
        {
            _pressureText = _bond.PressureSp.ToString("0.0");
            _tempText     = _bond.TempSp.ToString("0");
            _holdText     = _bond.HoldSecSp.ToString();
            _bondClass    = "ok";
        }
        else
        {
            _pressureText = "—"; _tempText = "—"; _holdText = "—"; _bondClass = "alert";
        }

        _roll = PopServices.Fabric.GetMountedRoll(Session.LineId);
        if (_roll is not null)
        {
            _fabricMText = $"{_roll.RemainingM:0.0} m";
            _fabricText  = $"{_roll.RemainingM:0.0}m";
            _fabricColor = _roll.ColorCode ?? "—";
            _fabricRoll  = _roll.LotCode;
            _fabricClass = _roll.RemainingM <= 5 ? "alert" : _roll.RemainingM <= 10 ? "warn" : "ok";
        }
        else
        {
            _fabricMText = "— m"; _fabricText = "no roll"; _fabricColor = "—";
            _fabricRoll  = "IMG-04 required"; _fabricClass = "alert";
        }

        _hourly = PopServices.Production.GetHourlyToday(Session.LineId);
        _hourlyMax = _hourly?.Max(h => h.GoodQty + h.DefectQty) ?? 1;
    }

    Task Logout() => BlazorHost.RaiseAction("logout");
    public void Dispose() { _refresh?.Dispose(); _clock?.Dispose(); }
}
