@page "/qc03"
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State

@*  QC-03 Final Inspection — gating step before FG ship.
    Same pattern as QC-01/02 but InspectionType='Final'. *@

<div class="pop-shell qc">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">QC-03 · @Session?.TerminalId · @Session?.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span class="stat-on">● LIVE</span>
            <span>@Session?.EmployeeName · @Session?.ShiftCode</span>
            <span>@_now.ToString("yyyy-MM-dd HH:mm:ss")</span>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.Qc03Help))" />
        </div>
    </div>

    <div class="pop-bd">
        <div class="qc-kpis k4">
            <div class="qc-kpi"><div class="lbl">FINAL · TODAY</div><div class="val">@_list.Count</div><div class="sub">batches</div></div>
            <div class="qc-kpi ok"><div class="lbl">READY TO SHIP</div><div class="val">@_list.Count(i => i.Verdict == "PASS")</div><div class="sub">PASS</div></div>
            <div class="qc-kpi bad"><div class="lbl">REJECTED</div><div class="val">@_list.Count(i => i.Verdict == "FAIL")</div><div class="sub">FAIL</div></div>
            <div class="qc-kpi warn"><div class="lbl">PENDING</div><div class="val">@_list.Count(i => i.Verdict == "IN_PROGRESS")</div><div class="sub">open</div></div>
        </div>

        <div style="display:grid; grid-template-columns:1.1fr 1fr; gap:16px; flex:1; min-height:0;">
            <div class="pop-card" style="overflow:auto;">
                <div class="pop-card-h">▼ FINAL INSPECTIONS · 출하 전 검사</div>
                @if (_list.Count == 0)
                {
                    <div class="qc-empty">No final inspections.</div>
                }
                else
                {
                    <div class="qc-inspections">
                        @foreach (var i in _list)
                        {
                            var sel = _sel == i.InspectionId;
                            var st  = i.Verdict.ToLowerInvariant();
                            <div class="qc-insp @st @(sel ? "selected" : "")" @onclick="@(() => Select(i))">
                                <div class="ih"><div class="iid">@i.InspectionNo</div><div class="ist">@i.Verdict</div></div>
                                <div class="item">@(i.ItemName ?? i.ItemNo)</div>
                                <div class="meta"><span class="l">SAMPLE</span><span class="v">@i.SampleSize / @i.BatchQty</span></div>
                                <div class="meta"><span class="l">DEFECTS</span><span class="v" style="color:#fca5a5;">@i.DefectQtyTotal</span></div>
                                <div class="meta"><span class="l">@i.InsStartTs.ToString("HH:mm")</span><span class="v">@(i.InsEndTs?.ToString("HH:mm") ?? "—")</span></div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="pop-card" style="overflow:auto;">
                <div class="pop-card-h">▼ MEASUREMENT · @(_sel == 0 ? "(none)" : "#" + _sel)</div>
                @if (_items.Count == 0)
                {
                    <div class="qc-empty">Select an inspection to view measurements.</div>
                }
                else
                {
                    <table class="qc-meas">
                        <thead><tr><th>#</th><th>Characteristic</th><th>Standard</th><th>Measured</th><th>Result</th></tr></thead>
                        <tbody>
                            @foreach (var m in _items)
                            {
                                var rcls = m.Result == "PASS" ? "r-pass" : m.Result == "FAIL" ? "r-fail" : "";
                                <tr><td>@m.ItemSeq</td><td>@m.ItemName</td><td class="std">@m.Standard</td><td class="meas">@m.Measured</td><td class="@rcls">@m.Result</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="pop-card">
            <div class="qc-actions">
                <button class="qc-btn sec" style="flex:0 0 200px;" @onclick="StartNew">+ NEW FINAL</button>
                <button class="qc-btn ok"  disabled="@(_sel == 0)" @onclick="@(() => Finalize("PASS"))">✓ APPROVE · SHIP</button>
                <button class="qc-btn"     disabled="@(_sel == 0)" @onclick="@(() => Finalize("FAIL"))">✗ REJECT → HOLD</button>
            </div>
            <div class="@_statusCls" style="margin-top:10px; font-size:13px; min-height:20px;">@_status</div>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:10;">
        <button class="nav-btn" @onclick="@(() => Go("qc01"))">QC-01<small>Incoming</small></button>
        <button class="nav-btn" @onclick="@(() => Go("qc02"))">QC-02<small>In-Process</small></button>
        <button class="nav-btn active" @onclick="@(() => Go("qc03"))">QC-03<small>Final</small></button>
        <button class="nav-btn" @onclick="@(() => Go("qc04"))">QC-04<small>NCR</small></button>
        <button class="nav-btn" @onclick="@(() => Go("qc05"))">QC-05<small>Hold</small></button>
        <button class="nav-btn" @onclick="@(() => Go("qc06"))">QC-06<small>CAPA</small></button>
        <button class="nav-btn" @onclick="@(() => Go("qc07"))">QC-07<small>Dashboard</small></button>
        <button class="nav-btn" @onclick="@(() => Go("qc08"))">QC-08<small>Std</small></button>
        <button class="nav-btn" @onclick="@(() => Go("qctrc"))">QC-TRC<small>Trace</small></button>
        <button class="nav-btn muted" @onclick="Logout">LOGOUT<small>End shift</small></button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }

    private List<QcInspectionDto>     _list  = new();
    private List<QcInspectionItemDto> _items = new();
    private int    _sel;
    private string _status = "", _statusCls = "dim";
    private DateTime _now = DateTime.Now;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Refresh();
        _timer = new System.Threading.Timer(_ => InvokeAsync(() => { Refresh(); _now = DateTime.Now; StateHasChanged(); }),
                                            null, 5000, 5000);
    }

    private void Refresh()
    {
        try { _list = PopServices.Qc.ListInspections("Final", 30); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Qc03] {ex.Message}"); }
    }

    private void Select(QcInspectionDto i)
    {
        _sel = i.InspectionId;
        _items = PopServices.Qc.ListInspectionItems(i.InspectionId);
    }

    private void StartNew()
    {
        try
        {
            var id = PopServices.Qc.CreateInspection("Final", "DR-TRM-LH-A1", 32,
                                                      Session?.OperatorId ?? "system",
                                                      Session?.EmployeeNo ?? "Q000");
            SetStatus($"✓ Final #{id} opened", "ok");
            Refresh();
        }
        catch (Exception ex) { SetStatus("× " + ex.Message, "fail"); }
    }

    private void Finalize(string verdict)
    {
        if (_sel == 0) return;
        try
        {
            PopServices.Qc.FinalizeInspection(_sel, verdict,
                                               Session?.OperatorId ?? "system",
                                               Session?.EmployeeNo ?? "Q000");
            SetStatus($"✓ #{_sel} → {verdict}", verdict == "PASS" ? "ok" : "fail");
            Refresh();
        }
        catch (Exception ex) { SetStatus("× " + ex.Message, "fail"); }
    }

    private void SetStatus(string s, string c) { _status = s; _statusCls = c; }
    private void Go(string r) => Nav.NavigateTo("/" + r);
    private void Logout()      { Nav.NavigateTo("/login", replace: true); State.SignOut(); }
    public void Dispose() => _timer?.Dispose();
}
