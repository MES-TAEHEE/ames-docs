@page "/inj05"
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject ConfirmService Confirmer

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">INJ-005 · DEFECT REGISTER · @Session?.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span style="color:var(--warn);">⚠ DEFECT MODE</span>
            <span>@Session?.EmployeeName · @Session?.ShiftCode</span>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.Inj05Help))" />
        </div>
    </div>

    <div class="pop-bd">
        <div class="def-rate">
            <div>
                <div class="def-rate-l">▼ Current Defect Rate · WO cumulative (limit 5%)</div>
                <div class="def-rate-s">Good @_good · Defect @_defect → @_rateText</div>
            </div>
            <div class="def-rate-v @_rateClass">@_rateText</div>
        </div>

        @if (_ngLots.Count > 0)
        {
            <div class="pop-card" style="margin-bottom:10px;">
                <div class="pop-card-h">▼ ROBOT NG · 스캔 차단 LOT — 선택 후 불량코드로 확정</div>
                <div style="overflow-y:auto; max-height:140px;">
                    <table style="width:100%; border-collapse:collapse; font-size:13px;">
                        <tbody>
                        @foreach (var lot in _ngLots)
                        {
                            var isSel = _ngSelected?.LotId == lot.LotId;
                            <tr style="border-top:1px solid rgba(255,255,255,.08); cursor:pointer;
                                       @(isSel ? "background:rgba(255,180,0,.15);" : "")"
                                @onclick="@(() => _ngSelected = isSel ? null : lot)">
                                <td style="padding:6px 4px; font-family:Consolas,monospace;">@lot.LotCode @(isSel ? "✓" : "")</td>
                                <td style="padding:6px 4px;">@lot.CavityPos</td>
                                <td style="padding:6px 4px;">@lot.ItemNo</td>
                                <td style="padding:6px 4px; color:var(--warn);">@(lot.InspectionSummary ?? "NG")</td>
                                <td style="padding:6px 4px;">@lot.CreatedTS.ToString("HH:mm:ss")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="def-grid">
            @foreach (var c in _codes)
            {
                var isSel = _selected?.DefectCode == c.DefectCode;
                <div class="def-btn @(isSel ? "on" : "")" @onclick="@(() => Select(c))">
                    <div class="def-btn-code">@c.DefectCode @(isSel ? "✓" : "")</div>
                    <div class="def-btn-name">@c.DefectNameEn</div>
                    <div class="def-btn-ko">@c.DefectName</div>
                </div>
            }
        </div>

        <div class="def-input">
            <div class="def-info-card">
                <div class="def-info-h">▼ SELECTED</div>
                @if (_selected is not null)
                {
                    <div style="font-size:20px; font-weight:700;">@_selected.DefectCode · @_selected.DefectNameEn</div>
                    <div style="font-size:14px; color:rgba(255,255,255,.6); margin-top:6px;">@_selected.DefectName</div>
                    <div class="def-cause">
                        <div class="def-cause-l">Severity</div>
                        <div class="def-cause-v">@_selected.SeverityLevel</div>
                    </div>
                }
                else
                {
                    <div style="color:rgba(255,255,255,.4);">Pick a defect code from above.</div>
                }
            </div>
            <div class="def-numpad-card">
                <div class="def-info-h">DEFECT QTY · 불량 수량</div>
                <div class="def-disp">@(_buf.Length == 0 ? "0" : _buf.ToString())</div>
                <div class="keypad" style="margin-top:8px;">
                    @foreach (var d in new[] { "1","2","3","4","5","6","7","8","9" })
                    {
                        var k = d;
                        <div class="kp" @onclick="@(() => Press(k))">@k</div>
                    }
                    <div class="kp del" @onclick="Backspace">←</div>
                    <div class="kp"     @onclick="@(() => Press("0"))">0</div>
                    <div class="kp ok"  @onclick="Confirm">✓</div>
                </div>
            </div>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:8;">
        <button class="nav-btn" @onclick="@(() => Go("inj02"))">INJ-002<small>Dashboard</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj03"))">INJ-003<small>WO Confirm</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj04"))">INJ-004<small>Prod Entry</small></button>
        <button class="nav-btn active" @onclick="@(() => Go("inj05"))">INJ-005<small>Defect</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj06"))">INJ-006<small>Mold Change</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj07"))">INJ-007<small>Prod Status</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj08"))">INJ-008<small>Andon</small></button>
        <button class="nav-btn muted" @onclick="Logout">LOGOUT<small>End shift</small></button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }
    [SupplyParameterFromQuery] public int? Result { get; set; }

    List<DefectCodeDto> _codes = new();
    DefectCodeDto?      _selected;
    WorkOrderDto?       _wo;
    System.Text.StringBuilder _buf = new();
    int _good, _defect;
    string _rateText = "0.0%", _rateClass = "ok";
    List<InjLotDto> _ngLots = new();
    InjLotDto?      _ngSelected;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        _codes = PopServices.Defects.ListForProcess("INJ");
        try { _ngLots = PopServices.InjLots.GetNgBlocked(Session.LineId); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Inj05 ngLots] {ex.Message}"); }
        _wo    = PopServices.WorkOrders.GetActiveForTerminal(Session.LineId, Session.TerminalId)
              ?? PopServices.WorkOrders.ListForLine(Session.LineId).FirstOrDefault();
        if (_wo is not null)
        {
            var (g, d) = PopServices.Defects.GetWoTotals(_wo.WoId);
            _good = g; _defect = d;
            var pct = (g + d) == 0 ? 0 : d * 100.0 / (g + d);
            _rateText  = $"{pct:0.0}%";
            _rateClass = pct >= 5 ? "alert" : pct >= 4 ? "warn" : "ok";
        }
    }

    void Select(DefectCodeDto c) => _selected = c;
    void Press(string d)
    {
        if (_buf.Length >= 2) return;
        if (_buf.Length == 0 && d == "0") return;
        _buf.Append(d);
    }
    void Backspace() { if (_buf.Length > 0) _buf.Length--; }

    void Confirm()
    {
        if (_wo is null || _selected is null || Session is null) return;

        // 로봇 NG LOT 불량확정: 수량 1 고정, LOT 연결 + 상태 마감
        // 제약 1: 원천 LOT 는 WO 미배정이므로 불량은 "확정 시점의 활성 WO"에 귀속된다 —
        //   NG 발생과 확정 사이에 WO 가 바뀌면 불량이 다음 WO 실적에 잡힐 수 있다.
        // 제약 2: RecordDefect 와 MarkNgConfirmed 는 별도 커넥션(비원자) — 후자 실패 시
        //   LOT 가 NG_BLOCKED 로 남아 목록에 재노출되며, 재확정하면 불량이 중복 집계될 수 있다.
        //   (RecordDefect 를 먼저 실행하는 순서는 의도 — 반대면 불량 이력 없이 상태만 마감될 수 있음)
        if (_ngSelected is not null)
        {
            try
            {
                PopServices.Defects.RecordDefect(0, _wo.WoId, _ngSelected.LotId,
                    _selected.DefectCode, 1, Session.OperatorId, Session.EmployeeNo,
                    note: $"ROBOT NG: {_ngSelected.InspectionSummary}");
                PopServices.InjLots.MarkNgConfirmed(_ngSelected.LotId, Session.OperatorId);
                _ngLots.RemoveAll(x => x.LotId == _ngSelected.LotId);
                _ngSelected = null;
                _buf.Clear();
            }
            catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Defect NG Confirm] {ex.Message}"); }
            return;
        }

        if (!int.TryParse(_buf.ToString(), out var qty) || qty <= 0) return;
        try
        {
            PopServices.Defects.RecordDefect(Result ?? 0, _wo.WoId, lotId: null,
                _selected.DefectCode, qty, Session.OperatorId, Session.EmployeeNo);
            Nav.NavigateTo("/inj04");
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Defect Confirm] {ex.Message}"); }
    }

    async Task Logout() { if (!await Confirmer.AskAsync("Log out?", "End your shift and return to the login screen?", "Log out", "Stay", destructive: true)) return; Nav.NavigateTo("/login", replace: true); State.SignOut(); }
    public void Dispose() { }
    private void Go(string r) => Nav.NavigateTo("/" + r);
}
