@page "/inj08"
@implements IDisposable
@inject NavigationManager Nav

<div class="andon-shell">
    <div class="andon-bar">
        <span>🚨 ANDON · @(_openId == 0 ? "READY" : "ACTIVE") · @Session?.LineId</span>
        <span>@(_openId == 0 ? "—" : $"AndonID #{_openId} · {_triggered:HH:mm:ss}")</span>
        <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.Inj08Help))" />
    </div>

    <div class="andon-bd">
        @if (_openId == 0)
        {
            <div class="andon-icon-big">🚨</div>
            <div class="andon-title">READY</div>
            <div class="andon-subtitle">No active andon — tap RAISE to halt the line manually.</div>
        }
        else if (_acked)
        {
            <div class="andon-icon-big">✓</div>
            <div class="andon-title" style="color:var(--warn);">ACKED</div>
            <div class="andon-subtitle">Supervisor acknowledged — 30 s safety hold before Resume.</div>
        }
        else
        {
            <div class="andon-icon-big">⛔</div>
            <div class="andon-title">STOPPED</div>
            <div class="andon-subtitle">Production halted — supervisor PIN required to acknowledge.</div>
        }

        <div class="andon-cause">
            <div class="andon-cause-l">▼ CAUSE</div>
            <div class="andon-cause-v">@(_cause ?? "Awaiting trigger")</div>
            <div class="andon-cause-detail">@_causeDetail</div>
        </div>

        <div class="andon-meta">
            <div>
                <div class="andon-meta-l">Operator</div>
                <div class="andon-meta-v">@Session?.EmployeeNo</div>
            </div>
            <div>
                <div class="andon-meta-l">Elapsed</div>
                <div class="andon-meta-v">@_elapsed</div>
            </div>
            <div>
                <div class="andon-meta-l">Severity</div>
                <div class="andon-meta-v">HIGH</div>
            </div>
        </div>

        <div class="andon-actions">
            @if (_openId == 0)
            {
                <button class="andon-btn andon-btn-call" @onclick="@(() => Nav.NavigateTo("/inj02"))">← Back to Dashboard</button>
                <button class="andon-btn andon-btn-ack" style="background:#b91c1c;" @onclick="Raise">🚨 RAISE ANDON</button>
            }
            else if (!_acked)
            {
                <button class="andon-btn andon-btn-call">📞 SUPERVISOR CALLED</button>
                <button class="andon-btn andon-btn-ack" @onclick="Ack">🔓 ACK (supervisor PIN — auto-accept)</button>
            }
            else
            {
                <button class="andon-btn andon-btn-call" @onclick="@(() => Nav.NavigateTo("/inj02"))">◀ Dashboard</button>
                <button class="andon-btn andon-btn-ack" @onclick="Resume">▶ RESUME PRODUCTION</button>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto Session { get; set; } = null!;

    int      _openId;
    DateTime _triggered;
    bool     _acked;
    string?  _cause;
    string   _causeDetail = "";
    string   _elapsed = "00:00";
    System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        _timer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (_openId != 0)
            {
                var t = DateTime.Now - _triggered;
                _elapsed = $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";
                StateHasChanged();
            }
        }), null, 1000, 1000);
    }

    void Raise()
    {
        try
        {
            var equipId = PopServices.Equipment.GetPrimaryForLine(Session.LineId)?.EquipId;
            _openId = PopServices.Andon.Raise(Session.LineId, equipId,
                triggerSource: "MANUAL", ruleId: "INJ-008-MANUAL", severity: "HIGH",
                Session.EmployeeNo);
            _triggered   = DateTime.Now;
            _cause       = $"Manual andon by {Session.EmployeeName}";
            _causeDetail = $"AndonID #{_openId} — production halted, supervisor notified.";
            if (!string.IsNullOrEmpty(equipId))
                PopServices.Equipment.LogStatus(equipId, Session.LineId, "STOP", "ANDON", null, Session.EmployeeNo);
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Raise] {ex.Message}"); }
    }

    void Ack()
    {
        if (_openId == 0) return;
        try
        {
            PopServices.Andon.Acknowledge(_openId, Session.OperatorId,
                reasonCode: "LINE-CHK", correctiveAction: "Acknowledged at line");
            _acked = true;
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Ack] {ex.Message}"); }
    }

    void Resume()
    {
        if (_openId == 0) return;
        try
        {
            PopServices.Andon.Resume(_openId, Session.OperatorId);
            var equipId = PopServices.Equipment.GetPrimaryForLine(Session.LineId)?.EquipId;
            if (!string.IsNullOrEmpty(equipId))
                PopServices.Equipment.LogStatus(equipId, Session.LineId, "RUN", "RESUMED", null, Session.EmployeeNo);
            _openId = 0; _acked = false; _cause = null; _causeDetail = "";
            Nav.NavigateTo("/inj02");
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Resume] {ex.Message}"); }
    }

    public void Dispose() => _timer?.Dispose();
}
