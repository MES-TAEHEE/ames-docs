@namespace AMES.Pop.Pages.InjPopups
@using AMES.Pop.Common

@*  INJ-006 금형 교체 — 팝업판. 현재 금형 수명 게이지 + 교체 금형 선택,
    교체 시작(다운타임 오픈) / 완료(샷 카운트 리셋). *@

<PopupShell Title='@($"🔧 {T("MoldChange2")}")' Width="900px" CssClass="pmod-tall"
            CloseOnBackdrop="@(_openChangeId == 0)" OnClose="OnClose">
    <div style="display:flex; flex-direction:column; gap:12px;">
        @if (_current is not null)
        {
            <div class="mold-status">
                <div class="mold-id">@_current.MoldId · @T("MountedOn") @_equipName
                    <span style="color:@_severityColor; margin-left:12px;">@_severityBanner</span>
                </div>
                <div class="mold-name">@_current.MoldName</div>
                <div class="mold-gauge">
                    <span class="mold-gauge-v" style="color:@_severityColor; font-size:64px;">@_current.CurrentShots.ToString("N0")</span>
                    <span class="mold-gauge-t" style="font-size:32px;">/ @_current.RatedShots.ToString("N0")</span>
                    <span class="mold-gauge-pct" style="color:@_severityColor; margin-left:auto; font-size:36px;">@_current.LifePct.ToString("0.0")%</span>
                </div>
                <div class="mold-bar">
                    <div class="mold-bar-fill" style="width:@Math.Min(100, (int)_current.LifePct)%;"></div>
                </div>
                <div class="mold-info">
                    <div><div class="mi-l">@T("RatedShots")</div><div class="mi-v">@_current.RatedShots.ToString("N0")</div></div>
                    <div><div class="mi-l">@T("CurrentShots")</div><div class="mi-v warn">@_current.CurrentShots.ToString("N0")</div></div>
                    <div><div class="mi-l">@T("CavityCount")</div><div class="mi-v">@_current.CavityCount</div></div>
                    <div><div class="mi-l">@T("LastMaintenance")</div><div class="mi-v">@(_current.LastMaintDate?.ToString("yyyy-MM-dd") ?? "—")</div></div>
                    <div><div class="mi-l">@T("Status2")</div><div class="mi-v">@PopLang.MoldStatus(_current.Status ?? "—")</div></div>
                    <div><div class="mi-l">@T("Severity")</div><div class="mi-v" style="color:@_severityColor;">@SevLabel(_current.Severity)</div></div>
                </div>
            </div>
        }
        else
        {
            <div class="pmod-empty">@T("NoMoldMountedOnThisLine")</div>
        }

        <div class="mnt-wo-card">
            <div class="mnt-wo-h">▼ @T("ReplacementMold")</div>
            <select @bind="_selectedReplacement" style="width:100%; padding:14px; background:#000; color:var(--mod-tint); border:1px solid rgba(37,99,235,.4); border-radius:6px; font-size:18px; font-weight:700;">
                <option value="">— @T("SelectReplacement") —</option>
                @foreach (var m in _available)
                {
                    <option value="@m.MoldId">@m.MoldId · @m.MoldName (@m.LifePct.ToString("0")%, @PopLang.MoldStatus(m.Status ?? "—"))</option>
                }
            </select>
            <div class="mnt-wo-row" style="margin-top:14px;">
                <span class="l">@T("Status2")</span>
                <span class="v">@(_openChangeId == 0 ? T("NoChangeInProgress") : $"{T("ChangeRunning")} #{_openChangeId}")</span>
            </div>
        </div>

        <div class="mc-actions">
            <button class="mc-btn mc-btn-sec" @onclick="OnClose">@T("Close")</button>
            <button class="mc-btn mc-btn-pri" disabled="@(_openChangeId != 0 || string.IsNullOrEmpty(_selectedReplacement))" @onclick="StartChange">🔧 @T("StartChangeOpenDowntime")</button>
            <button class="mc-btn mc-btn-sec" style="background:@(_openChangeId == 0 ? "#3a3a3a" : "var(--ok-dk)")" disabled="@(_openChangeId == 0)" @onclick="Complete">✓ @T("CompleteResetTo0")</button>
        </div>
    </div>
</PopupShell>

@code {
    [Parameter] public PopSessionDto? Session   { get; set; }
    [Parameter] public WorkOrderDto?  Wo        { get; set; }
    [Parameter] public EventCallback  OnClose   { get; set; }
    [Parameter] public EventCallback  OnChanged { get; set; }

    private static string T(string key, params object?[] args) => PopLang.T(key, args);

    private static string SevLabel(string sev) => sev switch
    {
        "warn"  => T("Warn"),
        "alert" => T("Alert"),
        "hard"  => T("Hard"),
        _       => T("Ok"),
    };

    private MoldDto?      _current;
    private List<MoldDto> _available = new();
    private string        _selectedReplacement = "";
    private int           _openChangeId;
    private string        _equipName = "—";
    private string        _severityColor  = "var(--ok)";
    private string        _severityBanner = "● OK";

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        if (Session is null) return;
        _current = string.IsNullOrEmpty(Wo?.MoldId) ? null : PopServices.Molds.GetById(Wo.MoldId);
        _available = PopServices.Molds.ListAvailable()
                      .Where(m => _current is null || m.MoldId != _current.MoldId).ToList();
        var eq = PopServices.Equipment.GetPrimaryForLine(Session.LineId);
        _equipName = eq?.EquipName ?? "—";

        if (_current is not null)
        {
            (_severityColor, _severityBanner) = _current.Severity switch
            {
                "warn"  => ("var(--warn)",  T("ChangeRecommended")),
                "alert" => ("var(--alert)", T("ChangeAsap")),
                "hard"  => ("var(--alert)", T("HardStop")),
                _       => ("var(--ok)",    T("OkWithinRatedLife")),
            };
        }
    }

    private void StartChange()
    {
        if (Wo is null || string.IsNullOrEmpty(_selectedReplacement) || Session is null) return;
        try
        {
            var equipId = PopServices.Equipment.GetPrimaryForLine(Session.LineId)?.EquipId ?? "UNKNOWN";
            _openChangeId = PopServices.Molds.StartChange(equipId, Session.LineId,
                _current?.MoldId, _selectedReplacement, _current?.CurrentShots ?? 0,
                Session.OperatorId, Session.EmployeeNo,
                _current?.Severity is "alert" or "hard" ? "WEAR_LIMIT" : "PLANNED");
            PopServices.Equipment.LogStatus(equipId, Session.LineId, "STOP", "MOLD_CHANGE", Wo.WoId, Session.EmployeeNo);
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[MoldChangePopup Start] {ex.Message}"); }
    }

    private async Task Complete()
    {
        if (_openChangeId == 0 || Session is null) return;
        try
        {
            PopServices.Molds.CompleteChange(_openChangeId, _current?.MoldId, _selectedReplacement, Session.OperatorId);
            var equipId = PopServices.Equipment.GetPrimaryForLine(Session.LineId)?.EquipId ?? "UNKNOWN";
            PopServices.Equipment.LogStatus(equipId, Session.LineId, "RUN", "RESUMED", Wo?.WoId, Session.EmployeeNo);
            _openChangeId = 0;
            Reload();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[MoldChangePopup Complete] {ex.Message}"); }
    }
}
