@namespace AMES.Pop.Pages.InjPopups
@using AMES.Pop.Common
@implements IDisposable

@*  INJ-007 생산 현황 — 팝업판. 전체 INJ 라인 KPI + 시간별 생산 + 라인별 테이블.
    10초 주기 자동 갱신. *@

<PopupShell Title='@($"📊 {T("ProductionStatusSupervisorView")}")' Width="1400px" CssClass="pmod-tall" OnClose="OnClose">
    <div style="display:flex; flex-direction:column; gap:12px;">
        <div class="kpi-row">
            <div class="kpi-card">
                <div class="l">@T("TodayGood")</div>
                <div class="v ok">@_totalGood.ToString("N0")</div>
                <div class="s">@T("Ea") · @T("TodayAcrossAllInjLines")</div>
            </div>
            <div class="kpi-card">
                <div class="l">@T("TodayDefect")</div>
                <div class="v warn">@_totalDef.ToString("N0")</div>
                <div class="s">@T("Ea") · @_ratePct%</div>
            </div>
            <div class="kpi-card">
                <div class="l">@T("Defect3")</div>
                <div class="v @_rateClass">@_ratePct%</div>
                <div class="s">@T("Limit5")</div>
            </div>
            <div class="kpi-card">
                <div class="l">@T("InjLines")</div>
                <div class="v">@_lines.Count</div>
                <div class="s">@_lines.Count(l => l.EquipStatus == "RUN") @T("Running")</div>
            </div>
            <div class="kpi-card">
                <div class="l">@T("DownMachines")</div>
                <div class="v @(_downCount > 0 ? "alert" : "ok")">@_downCount</div>
                <div class="s">@(_downCount > 0 ? T("NeedsAttention") : T("AllClear"))</div>
            </div>
        </div>

        <div class="pop-card hourly-chart">
            <div class="pop-card-h">▼ @T("HourlyOutput") · @Session?.LineId · @T("Today")</div>
            <div class="hc-bars" style="height:120px;">
                @for (var h = 6; h <= 17; h++)
                {
                    var bucket = _hourly?.FirstOrDefault(x => x.Hour == h);
                    var max = Math.Max(20, _hourlyMax);
                    var pct = bucket is null ? 0 : (int)((bucket.GoodQty + bucket.DefectQty) * 100.0 / max);
                    var cls = h == _now.Hour ? "hc-bar now" : (h > _now.Hour ? "hc-bar target" : "hc-bar");
                    <div class="@cls" style="height:@(h > _now.Hour ? 100 : Math.Clamp(pct, 2, 100))%;"></div>
                }
            </div>
            <div class="hc-labels">
                @for (var h = 6; h <= 17; h++) { <div class="@(h == _now.Hour ? "now" : "")">@h.ToString("00")</div> }
            </div>
        </div>

        <div style="overflow-y:auto; max-height:320px;">
            <table class="line-tbl">
                <thead>
                    <tr><th>@T("Line2")</th><th>@T("Name")</th><th>@T("Status2")</th><th>@T("TodayGood")</th><th>@T("TodayDefect")</th><th>@T("Defect3")</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in _lines)
                    {
                        var statusPill = l.EquipStatus switch
                        {
                            "RUN"  => $"<span class=\"pill run\">● {T("Run")}</span>",
                            "STOP" => $"<span class=\"pill mc\">⚙ {T("Stop")}</span>",
                            _      => $"<span class=\"pill mc\">{(l.EquipStatus is null ? "—" : PopLang.EqStatus(l.EquipStatus))}</span>"
                        };
                        <tr>
                            <td class="mono"><strong>@l.LineId</strong></td>
                            <td>@l.LineName</td>
                            <td>@((MarkupString)statusPill)</td>
                            <td>@l.TodayGood.ToString("N0")</td>
                            <td>@l.TodayDefect.ToString("N0")</td>
                            <td>@l.DefectRatePct.ToString("0.0")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</PopupShell>

@code {
    [Parameter] public PopSessionDto? Session { get; set; }
    [Parameter] public EventCallback  OnClose { get; set; }

    private static string T(string key, params object?[] args) => PopLang.T(key, args);

    private List<LineSummaryDto>            _lines = new();
    private IReadOnlyList<HourlyOutputDto>? _hourly;
    private int _totalGood, _totalDef, _downCount, _hourlyMax = 1;
    private string _ratePct = "0.0", _rateClass = "ok";
    private DateTime _now = DateTime.Now;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        Refresh();
        _timer = new System.Threading.Timer(_ => InvokeAsync(() => { _now = DateTime.Now; Refresh(); StateHasChanged(); }),
                                            null, 10_000, 10_000);
    }

    private void Refresh()
    {
        if (Session is null) return;
        try
        {
            _lines = PopServices.Dashboard.GetLinesForProcess("INJ");
            _totalGood = _lines.Sum(l => l.TodayGood);
            _totalDef  = _lines.Sum(l => l.TodayDefect);
            var rate   = (_totalGood + _totalDef) == 0 ? 0 : _totalDef * 100.0 / (_totalGood + _totalDef);
            _ratePct   = rate.ToString("0.0");
            _rateClass = rate >= 5 ? "alert" : rate >= 4 ? "warn" : "ok";
            _downCount = _lines.Count(l => l.EquipStatus is "STOP" or "ALARM" or "OFFLINE");

            _hourly = PopServices.Production.GetHourlyToday(Session.LineId);
            _hourlyMax = _hourly?.Max(h => h.GoodQty + h.DefectQty) ?? 1;
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[ProdStatusPopup] {ex.Message}"); }
    }

    public void Dispose() => _timer?.Dispose();
}
