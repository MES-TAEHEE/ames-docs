@namespace AMES.Pop.Pages.InjPopups
@using AMES.Contracts.Enums
@using AMES.Pop.Common
@using AMES.Pop.Services
@inject ScannerService Scanner
@inject ToastService Toasts
@implements IDisposable

@*  완제품 판정 팝업 — IMG(Core 스캔 발행 · 예외 발행)·PNT(라벨 발행, 2026-10-22) · RAW 완제품 라벨 재스캔 뒤에 뜬다.
    ProcessCode 가 어느 리포지토리(ImgLots/PntLots)와 불량코드 목록을 쓸지 정한다 — 그 밖의 동작은 두 공정이 같다.
    OK = 기존 스캔 확정(ConfirmByLotCode), NG = 불량코드 한 번 터치로 등록(RegisterDefect → REWORK 대기열).
    판정 없이 닫으면 LOT 은 RAW 로 남고, 완제품 라벨을 다시 찍으면 이 팝업이 다시 뜬다.
    HID 스캔이 메인 스캔칸이나 포커스된 버튼(Enter)으로 새지 않게 팝업 자신의 스캔칸이 늘 포커스를 잡는다.
    그 칸은 작업자가 쓰는 칸이 아니라 화면 밖에 숨겨 둔다(display:none 이면 포커스를 못 받는다). *@

<PopupShell Title='@($"⚖ {T("JudgeTitle")}")' Width="1100px" CloseOnBackdrop="false" OnClose="OnClose">
    <input @ref="_scanInput" @bind="_scanBuf" @bind:event="oninput" @onkeydown="OnScanKey"
           class="jdg-scan-sink" autocomplete="off" aria-hidden="true" />
    <div class="dfp-lot">
        <span class="mono dfp-lot-code">@Lot.LotCode</span>
        <span>@Lot.ItemNo @(Lot.ItemName is null ? "" : $"· {Lot.ItemName}")</span>
        @if (Lot.CoreLotCode is not null)
        {
            <span class="jdg-core">@T("Core"): <span class="mono">@Lot.CoreLotCode</span></span>
        }
    </div>

    @if (!_ngOpen)
    {
        <div class="jdg-btns">
            <button class="jdg-btn ok" disabled="@_busy" @onclick="Ok">@T("Ok")</button>
            <button class="jdg-btn ng" disabled="@_busy" @onclick="@(() => { _ngOpen = true; _focusScan = true; })">@T("Ng")</button>
        </div>
    }
    else
    {
        <div class="input-label">@T(_codes.Count == 0 ? "JudgeNoDefectCodes" : "JudgeSelectDefect")</div>
        <div class="def-grid dfp-codes">
            @foreach (var c in _codes)
            {
                <div class="def-btn @(_busy ? "jdg-busy" : "")" @onclick="@(() => Ng(c))">
                    <div class="def-btn-code">@c.DefectCode</div>
                    <div class="def-btn-name">@(PopLang.IsKo ? c.DefectName : c.DefectNameEn ?? c.DefectName)</div>
                </div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="injm-banner bad">
            <div class="injm-banner-t">@T("Fail")</div>
            <div class="injm-banner-s">@_error</div>
        </div>
    }

    <div class="dfp-footer">
        <span style="flex:1;"></span>
        @if (_ngOpen)
        {
            <button class="nav-btn" disabled="@_busy" @onclick="@(() => { _ngOpen = false; _focusScan = true; })">@T("JudgeBack")</button>
        }
        <button class="nav-btn" @onclick="OnClose">@T("Close")</button>
    </div>
</PopupShell>

@code {
    [Parameter, EditorRequired] public ImgLotDto      Lot     { get; set; } = null!;
    [Parameter]                 public PopSessionDto? Session { get; set; }
    /// <summary>판정할 공정 — "IMG"(기본, PopServices.ImgLots) 또는 "PNT"(PopServices.PntLots). 불량코드 목록도 이 공정의 것.</summary>
    [Parameter]                 public string         ProcessCode { get; set; } = "IMG";
    /// <summary>메인이 스캔해 둔 현재 팔레트 — OK 는 이 팔레트에 실린다. 없으면 OK 를 받지 않는다(2026-10-21).</summary>
    [Parameter]                 public string?        PalletNo { get; set; }
    [Parameter]                 public EventCallback  OnClose { get; set; }
    /// <summary>판정 성공 — (양품 여부, 배너 문구, 품번). 메인이 배너·선택 품번을 갱신하고 팝업을 닫는다.</summary>
    [Parameter] public EventCallback<(bool Good, string Detail, string ItemNo)> OnDone { get; set; }

    private static string T(string key, params object?[] args) => PopLang.T(key, args);
    private bool IsPnt => string.Equals(ProcessCode, "PNT", StringComparison.OrdinalIgnoreCase);

    private List<DefectCodeDto> _codes = new();
    private bool    _ngOpen, _busy;
    private string? _error;
    private string  _scanBuf = string.Empty;
    private ElementReference _scanInput;
    private bool    _focusScan = true;

    protected override void OnInitialized()
    {
        try { _codes = PopServices.Defects.ListForProcess(ProcessCode); }
        catch (Exception ex) { _error = ex.Message; }
        Scanner.OnScan += OnSerialScan;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _focusScan)
        {
            _focusScan = false;
            try { await _scanInput.FocusAsync(); } catch { }
        }
    }

    private void OnSerialScan(string code) => InvokeAsync(() => { HandleScan(code); StateHasChanged(); });

    private void OnScanKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var code = _scanBuf.Trim();
        _scanBuf = string.Empty;
        if (code.Length > 0) HandleScan(code);
    }

    private void HandleScan(string raw)
    {
        _focusScan = true;
        if (!JudgeScanGate.IsCurrentLot(Lot.LotCode, raw)) _error = $"{T("JudgeFirst")}: {Lot.LotCode}";
    }

    private async Task Ok()
    {
        if (Session is null || _busy) return;
        // 예외용 라벨 발행 버튼은 팔레트 없이도 이 팝업을 연다 — OK(적재)는 팔레트가 있어야 한다
        if (PalletNo is null) { _error = T("PalletScanFirst"); _focusScan = true; return; }
        _busy = true; _error = null;
        await Task.Yield();   // 버튼 비활성을 먼저 그린다 — DB 호출이 동기라 이게 없으면 연타 방지가 화면에 안 보인다
        try
        {
            var (outcome, _, itemNo, woId) = IsPnt
                ? PopServices.PntLots.ConfirmByLotCode(Lot.LotCode, Session.LineId, Session.OperatorId, Session.SessionId, Session.EmployeeNo, PalletNo, out var backflush)
                : PopServices.ImgLots.ConfirmByLotCode(Lot.LotCode, Session.LineId, Session.OperatorId, Session.SessionId, Session.EmployeeNo, PalletNo, out backflush);
            if (outcome == ImgConfirmOutcome.Confirmed)
            {
                BackflushNotice.Show(Toasts, backflush, Lot.LotCode);
                var woNumber = woId > 0 ? PopServices.WorkOrders.GetById(woId)?.WoNumber : null;
                await OnDone.InvokeAsync((true, $"{T("Confirmed")}: {Lot.LotCode} ({itemNo}){(woNumber is null ? "" : $" → {woNumber}")}", itemNo));
                return;
            }
            _error = outcome switch
            {
                ImgConfirmOutcome.NotFound         => $"{T("LotNotFound")}: {Lot.LotCode}",
                ImgConfirmOutcome.AlreadyConfirmed => $"{T("AlreadyConfirmed")}: {Lot.LotCode}",
                ImgConfirmOutcome.WrongLine        => $"{T("LotBelongsToAnotherLine")}: {Lot.LotCode}",
                ImgConfirmOutcome.InRework         => $"{T("LotInRework")}: {Lot.LotCode}",
                ImgConfirmOutcome.Scrapped         => $"{T("LotScrapped")}: {Lot.LotCode}",
                _ when PalletChip.NoticeKey(outcome) is { } k => $"{T(k)}: {PalletNo}",
                _                                  => $"{T("ConfirmFailed")}: {Lot.LotCode}",
            };
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _focusScan = true; }
    }

    private async Task Ng(DefectCodeDto code)
    {
        if (Session is null || _busy) return;
        _busy = true; _error = null;
        await Task.Yield();
        try
        {
            var (outcome, _, itemNo) = IsPnt
                ? PopServices.PntLots.RegisterDefect(Lot.LotCode, Session.LineId, code.DefectCode, Session.OperatorId, Session.SessionId, Session.EmployeeNo)
                : PopServices.ImgLots.RegisterDefect(Lot.LotCode, Session.LineId, code.DefectCode, Session.OperatorId, Session.SessionId, Session.EmployeeNo);
            if (outcome == DefectRegisterOutcome.Registered)
            {
                await OnDone.InvokeAsync((false, $"{T("DfRegistered")}: {Lot.LotCode} ({itemNo}) · {code.DefectCode}", itemNo));
                return;
            }
            _error = outcome switch
            {
                DefectRegisterOutcome.NotFound        => $"{T("LotNotFound")}: {Lot.LotCode}",
                DefectRegisterOutcome.WrongLine       => $"{T("LotBelongsToAnotherLine")}: {Lot.LotCode}",
                DefectRegisterOutcome.AlreadyInRework => $"{T("DfAlreadyInRework")}: {Lot.LotCode}",
                DefectRegisterOutcome.Scrapped        => $"{T("DfScrapped")}: {Lot.LotCode}",
                _                                     => $"{T("Fail")}: {Lot.LotCode}",
            };
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _focusScan = true; }
    }

    public void Dispose() => Scanner.OnScan -= OnSerialScan;
}
