@namespace AMES.Pop.Pages.InjPopups
@using AMES.Contracts.Enums
@using AMES.Data.Connection
@using AMES.Data.Repositories
@using AMES.Data.Services
@using AMES.Pop.Common
@using AMES.Pop.Services
@inject AMES.Pop.Services.ScannerService Scanner
@implements IDisposable

@*  불량 등록 팝업 — LOT 라벨 스캔 → 불량코드 선택 → 등록. 수량 입력은 없다(1 LOT = 1 EA).
    INJ·IMG·PNT 가 ProcessCode 로 공유한다. 완제품 공정(IMG·PNT)은 DataMatrix 라벨을 파싱하고 각자의 LOT 리포지토리를 쓴다.
    등록된 LOT 은 DEFECT 가 되어 REWORK 스테이션 대기열로 간다.
    시리얼 스캔은 메인 화면이 팝업 중엔 무시하므로 여기서 직접 구독한다(안돈 팝업과 같은 방식). *@

<PopupShell Title='@($"❌ {T("DefectRegister")}")' Width="1200px" OnClose="OnClose">
    <div class="dfp-scan">
        <input @ref="_scanInput" @bind="_scanBuf" @bind:event="oninput" @onkeydown="OnScanKey"
               class="injm-scan-input" placeholder="@T("DfScanPrompt")" autocomplete="off" />
        <div class="injm-banner @_bannerClass">
            <div class="injm-banner-t">@BannerTitle</div>
            @if (_bannerDetail.Length > 0) { <div class="injm-banner-s">@_bannerDetail</div> }
        </div>
    </div>

    @if (_lot is { } lot)
    {
        <div class="dfp-lot">
            <span class="mono dfp-lot-code">@lot.LotCode</span>
            <span>@lot.ItemNo @(lot.ItemName is null ? "" : $"· {lot.ItemName}")</span>
            <span class="dfp-lot-status @(lot.Status == LotDefectRules.Confirmed ? "warn" : "")">@lot.Status · @lot.CreatedTS.ToString("HH:mm:ss")</span>
            @if (lot.Status == LotDefectRules.Confirmed) { <span class="dfp-lot-note">@T("DfPriorConfirmed")</span> }
            @if (lot.Note is not null) { <span class="dfp-lot-note">@lot.Note</span> }
        </div>
    }

    <div class="def-grid dfp-codes">
        @foreach (var c in _codes)
        {
            var isSel = _selected?.DefectCode == c.DefectCode;
            <div class="def-btn @(isSel ? "on" : "")" @onclick="@(() => _selected = c)">
                <div class="def-btn-code">@c.DefectCode @(isSel ? "✓" : "")</div>
                <div class="def-btn-name">@(PopLang.IsKo ? c.DefectName : c.DefectNameEn ?? c.DefectName)</div>
            </div>
        }
    </div>

    <div class="dfp-footer">
        <div class="dfp-today">
            <span class="dfp-today-h">@T("DfTodayRegistered") (@_today.Count)</span>
            @foreach (var t in _today.Take(6))
            {
                <span class="mono">@t.LotCode @t.DefectCode @t.At.ToString("HH:mm")</span>
            }
        </div>
        <button class="nav-btn warn dfp-register" @onclick="Register" disabled="@(_lot is null || _selected is null || _busy)">@T("DfRegisterBtn")</button>
        <button class="nav-btn" @onclick="OnClose">@T("Close")</button>
    </div>
</PopupShell>

@code {
    [Parameter] public PopSessionDto? Session     { get; set; }
    /// <summary>불량코드 목록·등록 공정 INJ / IMG / PNT.</summary>
    [Parameter] public string         ProcessCode { get; set; } = "INJ";
    /// <summary>완제품 공정 — 라벨이 고객 DataMatrix 이고 LOT 이 ImgLotDto 공용 뷰다.</summary>
    private bool FinishedProcess => ProcessCode is "IMG" or "PNT";
    private bool IsPnt => ProcessCode == "PNT";
    [Parameter] public EventCallback  OnClose     { get; set; }
    [Parameter] public EventCallback  OnChanged   { get; set; }
    /// <summary>화면에서 고른 품번 — 오프라인에서 사본에 없는 LOT 을 받아들일 때 잠정 품번으로 쓴다(복구 뒤 서버가 실제 품번으로 판정).</summary>
    [Parameter] public string?        SelectedItemNo { get; set; }

    private static string T(string key, params object?[] args) => PopLang.T(key, args);

    private sealed record LotInfo(string LotCode, string ItemNo, string? ItemName, string? LineId, string Status, DateTime CreatedTS, string? Note);
    private sealed record TodayRow(string LotCode, string DefectCode, DateTime At);

    private List<DefectCodeDto> _codes = new();
    private DefectCodeDto?      _selected;
    private LotInfo?            _lot;
    private readonly List<TodayRow> _today = new();
    private bool   _busy;
    private string _scanBuf = string.Empty;
    private ElementReference _scanInput;
    private bool   _focusScan = true;

    private string _bannerClass = "idle", _bannerDetail = "";
    private string BannerTitle => _bannerClass switch { "ok" => T("Success"), "bad" => T("Fail"), _ => T("Ready") };

    protected override void OnInitialized()
    {
        if (Session is null) return;
        try
        {
            _codes = LoadCodes();
            if (_codes.Count == 0 && PopDb.IsOffline) SetBanner(false, T("OfflineNotAvailable"));
        }
        catch (Exception ex) { SetBanner(false, ex.Message); }
        Scanner.OnScan += OnSerialScan;
    }

    // 불량코드 — DB 가 끊겼으면 로컬 사본의 목록을 쓴다(사본이 이 공정 것일 때만).
    private List<DefectCodeDto> LoadCodes()
    {
        if (!PopDb.IsOffline)
        {
            try { return PopServices.Defects.ListForProcess(ProcessCode); }
            catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { }
        }
        return OfflineWork.State?.Process == ProcessCode ? OfflineWork.DefectCodes() : new();
    }

    private static InjLotDto? LookupInj(string lotCode)
    {
        if (!PopDb.IsOffline)
        {
            try { return PopServices.InjLots.GetByLotCode(lotCode); }
            catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { }
        }
        return OfflineWork.FindLot(lotCode)?.ToInj();
    }

    private ImgLotDto? LookupFinished(string lotCode)
    {
        if (!PopDb.IsOffline)
        {
            try { return IsPnt ? PopServices.PntLots.GetByLotCode(lotCode) : PopServices.ImgLots.GetByLotCode(lotCode); }
            catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { }
        }
        return OfflineWork.FindLot(lotCode)?.ToImg();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _focusScan)
        {
            _focusScan = false;
            try { await _scanInput.FocusAsync(); } catch { }
        }
    }

    private void OnSerialScan(string code) => InvokeAsync(() => { HandleScan(code); StateHasChanged(); });

    private void OnScanKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var code = _scanBuf.Trim();
        _scanBuf = string.Empty;
        if (code.Length > 0) HandleScan(code);
    }

    // 스캔은 조회만 한다 — 등록은 ✓ 버튼. 라인·상태 검사는 미리 보여 주되 리포지토리가 트랜잭션 안에서 다시 확인한다.
    private void HandleScan(string raw)
    {
        if (Session is null) return;
        _focusScan = true;
        try
        {
            var lotCode = FinishedProcess ? AMES.Devices.ImgScanParser.ExtractLotCode(raw) : raw.Trim();
            if (string.IsNullOrEmpty(lotCode)) { SetBanner(false, $"{T("LotNotFound")}: {raw}"); return; }

            LotInfo? info = null;
            if (FinishedProcess)
            {
                var fin = LookupFinished(lotCode);
                if (fin is { } im)
                    info = new LotInfo(im.LotCode, im.ItemNo, im.ItemName, im.LineId, im.ConfirmStatus, im.CreatedTS, null);
            }
            else if (LookupInj(lotCode) is { } ij)
            {
                info = new LotInfo(ij.LotCode, ij.ItemNo, ij.ItemName, ij.LineId, ij.ConfirmStatus, ij.CreatedTS, ij.InspectionSummary);
            }
            if (info is null && PopDb.IsOffline && OfflineWork.LooksLikeLotCode(lotCode) && !string.IsNullOrEmpty(SelectedItemNo))
            {
                // 오프라인 사본에 없는 LOT — 라벨은 실제로 있으니 받아들인다. 맞는지는 복구 뒤 서버가 판정한다.
                info = new LotInfo(lotCode, SelectedItemNo, null, Session.LineId, LotDefectRules.Raw, DbClock.Now, T("OfflineUnverified"));
            }

            if (info is null) { _lot = null; SetBanner(false, $"{T("LotNotFound")}: {lotCode}"); return; }
            if (!string.Equals(info.LineId, Session.LineId, StringComparison.OrdinalIgnoreCase))
            { _lot = null; SetBanner(false, $"{T("LotBelongsToAnotherLine")}: {lotCode}"); return; }

            switch (LotDefectRules.CheckRegister(info.Status))
            {
                case DefectRegisterOutcome.AlreadyInRework: _lot = null; SetBanner(false, $"{T("DfAlreadyInRework")}: {lotCode}"); return;
                case DefectRegisterOutcome.Scrapped:        _lot = null; SetBanner(false, $"{T("DfScrapped")}: {lotCode}");        return;
            }
            _lot = info;
            SetBanner(true, $"{T("DfScanned")}: {lotCode}");
        }
        catch (Exception ex) { _lot = null; SetBanner(false, ex.Message); }
    }

    private async Task Register()
    {
        if (Session is null) return;
        if (_lot is null)      { SetBanner(false, T("DfScanFirst"));  return; }
        if (_selected is null) { SetBanner(false, T("DfSelectCode")); return; }
        _busy = true;
        try
        {
            var unload = PalletStockRepository.PalletUnloadResult.None;
            var unverified = false;
            var (outcome, _, itemNo) = RegisterRouted(out unload, out unverified);
            // 이미 PDA 로 입고된(위치 있는) 재고 행을 뺐으면 창고에 알려야 한다 — 팔레트 위 행을 뺀 것은 정상 경로라 조용하다
            var located = unload.WasLocated ? $" · {T("DfStockRemovedLocated", unload.LocationNo!)}" : "";
            var (ok, detail) = outcome switch
            {
                DefectRegisterOutcome.Registered      => (true,  $"{T("DfRegistered")}: {_lot.LotCode} ({itemNo}) · {_selected.DefectCode}{located}{(unverified ? $" · {T("OfflineUnverified")}" : "")}"),
                DefectRegisterOutcome.NotFound        => (false, $"{T("LotNotFound")}: {_lot.LotCode}"),
                DefectRegisterOutcome.WrongLine       => (false, $"{T("LotBelongsToAnotherLine")}: {_lot.LotCode}"),
                DefectRegisterOutcome.AlreadyInRework => (false, $"{T("DfAlreadyInRework")}: {_lot.LotCode}"),
                DefectRegisterOutcome.Scrapped        => (false, $"{T("DfScrapped")}: {_lot.LotCode}"),
                _                                     => (false, $"{T("Fail")}: {_lot.LotCode}"),
            };
            if (ok)
            {
                _today.Insert(0, new TodayRow(_lot.LotCode, _selected.DefectCode, DbClock.Now));
                _lot = null; _selected = null;
                await OnChanged.InvokeAsync();
            }
            SetBanner(ok, detail);
        }
        catch (Exception ex) { SetBanner(false, ex.Message); }
        finally { _busy = false; _focusScan = true; }
    }

    // 불량 등록 — 공정별 저장소가 판정하되 DB 가 끊겼으면(이미 알려졌거나 이번 호출이 연결 오류) 로컬 사본이 받아 큐에 올린다.
    private (DefectRegisterOutcome Outcome, int DefectId, string ItemNo) RegisterRouted(
        out PalletStockRepository.PalletUnloadResult unload, out bool unverified)
    {
        unload = PalletStockRepository.PalletUnloadResult.None;
        unverified = false;
        var s = Session!;
        if (!PopDb.IsOffline)
        {
            try
            {
                var code = _selected!.DefectCode;
                return ProcessCode switch
                {
                    "PNT" => PopServices.PntLots.RegisterDefect(_lot!.LotCode, s.LineId, code, s.OperatorId, s.SessionId, s.EmployeeNo, out unload),
                    "IMG" => PopServices.ImgLots.RegisterDefect(_lot!.LotCode, s.LineId, code, s.OperatorId, s.SessionId, s.EmployeeNo, out unload),
                    _     => PopServices.InjLots.RegisterDefect(_lot!.LotCode, s.LineId, code, s.OperatorId, s.SessionId, s.EmployeeNo, out unload),
                };
            }
            catch (Exception ex) when (DbHealth.IsConnectionFailure(ex)) { unload = PalletStockRepository.PalletUnloadResult.None; }
        }
        var r = OfflineWork.RegisterDefect(_lot!.LotCode, s.LineId, s.TerminalId, s.OperatorId, s.EmployeeNo, s.SessionId,
                                           _selected!.DefectCode, SelectedItemNo);
        unverified = r.Unverified;
        return (r.Outcome, 0, r.ItemNo);
    }

    private void SetBanner(bool ok, string detail) { _bannerClass = ok ? "ok" : "bad"; _bannerDetail = detail; }

    public void Dispose() => Scanner.OnScan -= OnSerialScan;
}
