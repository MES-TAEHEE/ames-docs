@namespace AMES.Pop.Pages.InjPopups
@using AMES.Pop.Common
@implements IDisposable

@*  INJ-008 안돈 — 팝업판. 라인 정지 특성상 전체 화면을 덮는 오버레이로 표시. *@

<div class="pmod-backdrop pmod-andon-overlay">
    <div class="andon-shell" style="position:relative; width:100%; height:100%;">
        <div class="andon-bar">
            <span>🚨 @T("Andon") · @(_openId == 0 ? T("Ready") : T("Active")) · @Session?.LineId</span>
            <span>@(_openId == 0 ? "—" : $"{T("Andonid")} #{_openId} · {_triggered:HH:mm:ss}")</span>
        </div>

        <div class="andon-bd">
            @if (_openId == 0)
            {
                <div class="andon-icon-big">🚨</div>
                <div class="andon-title">@T("Ready")</div>
                <div class="andon-subtitle">@T("NoActiveAndonTapRaiseToHaltTheLineManual")</div>
            }
            else if (_acked)
            {
                <div class="andon-icon-big">✓</div>
                <div class="andon-title" style="color:var(--warn);">@T("Acked")</div>
                <div class="andon-subtitle">@T("SupervisorAcknowledged30SSafetyHoldBefor")</div>
            }
            else
            {
                <div class="andon-icon-big">⛔</div>
                <div class="andon-title">@T("Stopped")</div>
                <div class="andon-subtitle">@T("ProductionHaltedSupervisorPinRequiredToA")</div>
            }

            <div class="andon-cause">
                <div class="andon-cause-l">▼ @T("Cause")</div>
                <div class="andon-cause-v">@(_cause ?? T("AwaitingTrigger"))</div>
                <div class="andon-cause-detail">@_causeDetail</div>
            </div>

            <div class="andon-meta">
                <div>
                    <div class="andon-meta-l">@T("Operator")</div>
                    <div class="andon-meta-v">@Session?.EmployeeNo</div>
                </div>
                <div>
                    <div class="andon-meta-l">@T("Elapsed")</div>
                    <div class="andon-meta-v">@_elapsed</div>
                </div>
                <div>
                    <div class="andon-meta-l">@T("Severity")</div>
                    <div class="andon-meta-v">@T("High2")</div>
                </div>
            </div>

            <div class="andon-actions">
                @if (_openId == 0)
                {
                    <button class="andon-btn andon-btn-call" @onclick="Close">← @T("Close")</button>
                    <button class="andon-btn andon-btn-ack" style="background:#b91c1c;" @onclick="Raise">🚨 @T("RaiseAndon")</button>
                }
                else if (!_acked)
                {
                    <button class="andon-btn andon-btn-call">📞 @T("SupervisorCalled")</button>
                    <button class="andon-btn andon-btn-ack" @onclick="Ack">🔓 @T("AckSupervisorPinAutoAccept")</button>
                }
                else
                {
                    <button class="andon-btn andon-btn-ack" @onclick="Resume">▶ @T("ResumeProduction")</button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public PopSessionDto? Session       { get; set; }
    [Parameter] public EventCallback  OnClose       { get; set; }

    private static string T(string key, params object?[] args) => PopLang.T(key, args);

    private int      _openId;
    private DateTime _triggered;
    private bool     _acked;
    private string?  _cause;
    private string   _causeDetail = "";
    private string   _elapsed = "00:00";
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        _timer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (_openId != 0)
            {
                var t = DateTime.Now - _triggered;
                _elapsed = $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";
                StateHasChanged();
            }
        }), null, 1000, 1000);
    }

    private void Raise()
    {
        if (Session is null) return;
        try
        {
            var equipId = PopServices.Equipment.GetPrimaryForLine(Session.LineId)?.EquipId;
            _openId = PopServices.Andon.Raise(Session.LineId, equipId,
                triggerSource: "MANUAL", ruleId: "INJ-008-MANUAL", severity: "HIGH",
                Session.EmployeeNo);
            _triggered   = DateTime.Now;
            _cause       = T("ManualAndonBy", Session.EmployeeName);
            _causeDetail = T("AndonHaltDetail", _openId);
            if (!string.IsNullOrEmpty(equipId))
                PopServices.Equipment.LogStatus(equipId, Session.LineId, "STOP", "ANDON", null, Session.EmployeeNo);
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[AndonPopup Raise] {ex.Message}"); }
    }

    private void Ack()
    {
        if (_openId == 0 || Session is null) return;
        try
        {
            PopServices.Andon.Acknowledge(_openId, Session.OperatorId,
                reasonCode: "LINE-CHK", correctiveAction: "Acknowledged at line");
            _acked = true;
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[AndonPopup Ack] {ex.Message}"); }
    }

    private async Task Resume()
    {
        if (_openId == 0 || Session is null) return;
        try
        {
            PopServices.Andon.Resume(_openId, Session.OperatorId);
            var equipId = PopServices.Equipment.GetPrimaryForLine(Session.LineId)?.EquipId;
            if (!string.IsNullOrEmpty(equipId))
                PopServices.Equipment.LogStatus(equipId, Session.LineId, "RUN", "RESUMED", null, Session.EmployeeNo);
            _openId = 0; _acked = false; _cause = null; _causeDetail = "";
            await OnClose.InvokeAsync();
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[AndonPopup Resume] {ex.Message}"); }
    }

    private Task Close() => OnClose.InvokeAsync();
    public void Dispose() => _timer?.Dispose();
}
