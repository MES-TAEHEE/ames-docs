@page "/img05"
@implements IDisposable
@inject NavigationManager Nav

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">IMG-05 · DEFECT REGISTER · @Session.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span style="color:var(--warn);">⚠ DEFECT MODE</span>
            <span>@Session.EmployeeName · @Session.ShiftCode</span>
        </div>
    </div>

    <div class="pop-bd">
        <div class="def-rate">
            <div>
                <div class="def-rate-l">▼ Current Defect Rate · WO cumulative</div>
                <div class="def-rate-s">Good @_good · Defect @_defect</div>
            </div>
            <div class="def-rate-v @_rateClass">@_rateText</div>
        </div>

        <div class="def-grid">
            @foreach (var c in _codes)
            {
                var isSel = _selected?.DefectCode == c.DefectCode;
                <div class="def-btn @(isSel ? "on" : "")" @onclick="@(() => _selected = c)">
                    <div class="def-btn-code">@c.DefectCode @(isSel ? "✓" : "")</div>
                    <div class="def-btn-name">@c.DefectNameEn</div>
                    <div class="def-btn-ko">@c.DefectName</div>
                </div>
            }
        </div>

        <div class="def-input">
            <div class="def-info-card">
                <div class="def-info-h">▼ SELECTED</div>
                @if (_selected is not null)
                {
                    <div style="font-size:20px; font-weight:700;">@_selected.DefectCode · @_selected.DefectNameEn</div>
                    <div style="font-size:14px; color:rgba(255,255,255,.6); margin-top:6px;">@_selected.DefectName</div>
                }
                else
                {
                    <div style="color:rgba(255,255,255,.4);">Pick a defect code from above.</div>
                }
            </div>
            <div class="def-numpad-card">
                <div class="def-info-h">DEFECT QTY</div>
                <div class="def-disp">@(_buf.Length == 0 ? "0" : _buf.ToString())</div>
                <div class="keypad" style="margin-top:8px;">
                    @foreach (var d in new[] { "1","2","3","4","5","6","7","8","9" })
                    { var k = d; <div class="kp" @onclick="@(() => Press(k))">@k</div> }
                    <div class="kp del" @onclick="Backspace">←</div>
                    <div class="kp"     @onclick="@(() => Press("0"))">0</div>
                    <div class="kp ok"  @onclick="Confirm">✓</div>
                </div>
            </div>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:3;">
        <button class="nav-btn"        @onclick="@(() => Nav.NavigateTo("/img03"))">◀ Back to Prod Entry</button>
        <button class="nav-btn primary" @onclick="@(() => Nav.NavigateTo("/img02"))">▶ Dashboard</button>
        <button class="nav-btn muted"   @onclick="Logout">◀ LOGOUT</button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto Session { get; set; } = null!;

    List<DefectCodeDto> _codes = new();
    DefectCodeDto?      _selected;
    WorkOrderDto?       _wo;
    System.Text.StringBuilder _buf = new();
    int _good, _defect;
    string _rateText = "0.0%", _rateClass = "ok";

    protected override void OnInitialized()
    {
        _codes = PopServices.Defects.ListForProcess("IMG");
        _wo    = PopServices.WorkOrders.GetActiveForTerminal(Session.LineId, Session.TerminalId)
              ?? PopServices.WorkOrders.ListForLine(Session.LineId).FirstOrDefault();
        if (_wo is not null)
        {
            var (g, d) = PopServices.Defects.GetWoTotals(_wo.WoId);
            _good = g; _defect = d;
            var pct = (g + d) == 0 ? 0 : d * 100.0 / (g + d);
            _rateText  = $"{pct:0.0}%";
            _rateClass = pct >= 5 ? "alert" : pct >= 4 ? "warn" : "ok";
        }
    }

    void Press(string d) { if (_buf.Length >= 2) return; if (_buf.Length == 0 && d == "0") return; _buf.Append(d); }
    void Backspace()     { if (_buf.Length > 0) _buf.Length--; }

    void Confirm()
    {
        if (_wo is null || _selected is null) return;
        if (!int.TryParse(_buf.ToString(), out var qty) || qty <= 0) return;
        try
        {
            PopServices.Defects.RecordDefect(0, _wo.WoId, lotId: null,
                _selected.DefectCode, qty, Session.OperatorId, Session.EmployeeNo);
            var (g, d) = PopServices.Defects.GetWoTotals(_wo.WoId);
            var pct = (g + d) == 0 ? 0 : d * 100.0 / (g + d);
            if (pct >= 5)
            {
                PopServices.Andon.Raise(Session.LineId, equipId: null,
                    triggerSource: "IMG-05", ruleId: "BR-INJ-03", severity: "HIGH", Session.EmployeeNo);
                Nav.NavigateTo("/inj08");
                return;
            }
            Nav.NavigateTo("/img03");
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[IMG-05] {ex.Message}"); }
    }

    Task Logout() => BlazorHost.RaiseAction("logout");
    public void Dispose() { }
}
