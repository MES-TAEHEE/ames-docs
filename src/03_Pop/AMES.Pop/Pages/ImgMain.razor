@page "/imgmain"
@using AMES.Pop.Pages.InjPopups
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject ConfirmService Confirmer

@*  IMG-MAIN — IMG03/05 통합 작업 화면. INJ-MAIN 과 같은 2단 레이아웃.
    좌측 스테이션 품번 당일 현황(PLAN/FINAL/NG/부족) + 우측 키패드 실적 입력·오늘 이력을 상시 표시하고,
    불량·안돈은 팝업(Pages/InjPopups/*)을 공유한다. WO 접수 없음 — 품번 선택이 열린 WO 를 자동 해석.
    IMG 는 원천 LOT·라벨이 없어 스캔 확정 대신 키패드가 들어간다. 원단 롤은 있으면 차감, 없으면 실적만 기록. *@

<div class="pop-shell injm-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">IMG-MAIN · @Session?.TerminalId · @Session?.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span class="@_eqClass">● @PopLang.EqStatus(_eqStatus)</span>
            <span>@Session?.EmployeeName · @PopLang.Shift(Session?.ShiftCode ?? "")</span>
            <span>@_now.ToString("yyyy-MM-dd HH:mm:ss")</span>
            <button class="injm-lang-btn" @onclick="ToggleLang">@(PopLang.IsKo ? "EN" : "한국어")</button>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.ImgMainHelp))" />
            <button class="injm-logout-btn" @onclick="Logout">⏻ @T("Logout")</button>
        </div>
    </div>

    <div class="pop-bd">
        <div class="injm-grid">

            @* ── 좌측: 스테이션 품번 당일 현황 ─────────────────────── *@
            <div class="pop-card injm-left">
                <div class="pop-card-h">▼ @T("PartNo") · @_now.ToString("yyyy-MM-dd") · @Session?.TerminalId</div>
                @if (_refreshError is not null)
                {
                    <div class="injm-refresh-err">⚠ @T("DataRefreshFailed", _refreshErrorAt.ToString("HH:mm:ss")) — @_refreshError</div>
                }
                <div class="injm-tbl-wrap">
                    <table class="injm-tbl">
                        <thead>
                            <tr>
                                <th style="text-align:left;">@T("PartNo")</th>
                                <th>@T("Plan")</th>
                                <th>@T("Final")</th>
                                <th>@T("Ng")</th>
                                <th>@T("Shortage")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var it in _items)
                        {
                            var isSel = string.Equals(_selItemNo, it.ItemNo, StringComparison.OrdinalIgnoreCase);
                            var shortage = Math.Max(0, it.PlanQty - it.GoodQty);
                            <tr class="@(isSel ? "active" : "")" @onclick="@(() => SelectItem(it))">
                                <td class="mono" style="text-align:left;" title="@it.ItemName">
                                    @it.ItemNo
                                    @if (!it.InBop)
                                    {
                                        <span class="injm-dim-badge">@T("NotInBop")</span>
                                    }
                                    @if (!it.HasOpenWo)
                                    {
                                        <span class="injm-dim-badge">@T("NoOpenWo")</span>
                                    }
                                </td>
                                <td>@it.PlanQty.ToString("0")</td>
                                <td class="ok">@it.GoodQty</td>
                                <td class="@(it.NgQty > 0 ? "bad" : "")">@it.NgQty</td>
                                <td class="@(shortage > 0 ? "bad" : "")">@shortage.ToString("0")</td>
                            </tr>
                        }
                        @if (_items.Count == 0 && _refreshError is null)
                        {
                            <tr><td colspan="5" style="padding:28px; color:rgba(255,255,255,.4); text-align:center; font-size:20px;">
                                @T("NoBopItemsForStation")
                            </td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="injm-total">
                    <span>@T("Plan") <b>@_items.Sum(x => x.PlanQty).ToString("0")</b></span>
                    <span>@T("Final") <b class="ok">@_items.Sum(x => x.GoodQty)</b></span>
                    <span>@T("Ng") <b class="bad">@_items.Sum(x => x.NgQty)</b></span>
                    <span>@T("Shortage") <b class="bad">@_items.Sum(x => Math.Max(0, x.PlanQty - x.GoodQty)).ToString("0")</b></span>
                </div>
            </div>

            @* ── 우측: 실적 입력 + 오늘 이력 ────────────────────────── *@
            <div class="injm-right">
                <div class="pop-card imgm-entry">
                    <div class="pop-card-h">▼ @T("CurrentWo") (@T("PartNo"): @(_selItemNo ?? "—"))</div>
                    <div class="imgm-wo-row">
                        <span class="imgm-wo-no">@(_activeWo?.WoNumber ?? "—")</span>
                        <span class="imgm-wo-name">@(_activeWo?.ItemName ?? T("SelectPartWithOpenWo"))</span>
                    </div>
                    <div class="imgm-prog">
                        <span class="imgm-prog-v">@(_activeWo?.CompletedQty.ToString("0") ?? "—")<small>/ @(_activeWo?.OrderQty.ToString("0") ?? "—")</small></span>
                        <div class="entry-bar"><div class="entry-bar-fill" style="width:@_pct%;"></div></div>
                    </div>

                    <div class="input-label">@T("GoodQtyPerCycleEa")</div>
                    <div class="input-display">@(_buf.Length == 0 ? "0" : _buf.ToString())</div>
                    <div class="keypad">
                        @foreach (var d in new[] { "1","2","3","4","5","6","7","8","9" })
                        { var k = d; <div class="kp" @onclick="@(() => Press(k))">@k</div> }
                        <div class="kp ct"  @onclick="LoadCt">@T("Ct")</div>
                        <div class="kp"     @onclick="@(() => Press("0"))">0</div>
                        <div class="kp del" @onclick="Backspace">←</div>
                    </div>
                    <button class="imgm-confirm" disabled="@(!CanConfirm)" @onclick="Confirm">
                        ✓ @T("Confirm") · @Qty @T("Ea")@(_roll is null ? "" : $" · {T("DeductM", RequiredM.ToString("0.00"))}")
                    </button>

                    <div class="injm-banner @_bannerClass">
                        <div class="injm-banner-t">@BannerTitle</div>
                        @if (_bannerDetail.Length > 0)
                        {
                            <div class="injm-banner-s">@_bannerDetail</div>
                        }
                    </div>
                    <div class="injm-chips">
                        <span class="injm-chip">@T("TodayGood") <b class="ok">@_todayGood</b></span>
                        <span class="injm-chip">@T("Defect") <b class="@_defClass">@_todayDef · @_defectPct</b></span>
                        <span class="injm-chip">@T("FabricRoll") <b class="@_fabricClass">@_fabricText</b></span>
                        <span class="injm-chip">@T("BondRecipe") <b>@_bondText</b></span>
                    </div>
                </div>

                <div class="pop-card injm-hist imgm-hist">
                    <div class="pop-card-h">▼ @T("EntryHistoryToday")</div>
                    <div class="injm-scroll">
                        <table class="injm-subtbl">
                            <thead><tr>
                                <th style="text-align:left;">@T("Time")</th>
                                <th style="text-align:left;">@T("PartNo")</th>
                                <th style="text-align:left;">@T("Lotno")</th>
                                <th>@T("Qty")</th>
                            </tr></thead>
                            <tbody>
                            @foreach (var e in _entries)
                            {
                                <tr>
                                    <td class="mono">@e.EntryAt.ToString("HH:mm:ss")</td>
                                    <td class="mono" title="@e.WoNumber">@e.ItemNo</td>
                                    <td class="mono">@(e.LotCode ?? "—")</td>
                                    <td style="text-align:right;"><span class="injm-result ok">@e.GoodQty</span></td>
                                </tr>
                            }
                            @if (_entries.Count == 0)
                            {
                                <tr><td colspan="4" style="padding:14px 4px; color:rgba(255,255,255,.4);">@T("NoEntriesYet")</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* ── 기능 버튼 (팝업 런처) — 우측 패널 최하단 ─────────── *@
                <div class="injm-actions two">
                    <button class="nav-btn warn" @onclick="@(() => Open(Popup.Defect))">@T("Defect2")</button>
                    <button class="nav-btn alert" @onclick="@(() => Open(Popup.Andon))">@T("Andon")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── 팝업 ─────────────────────────────────────────────────────────── *@
@switch (_popup)
{
    case Popup.Defect:
        <DefectPopup Session="Session" Wo="_activeWo" LastResultId="_lastResultId" ProcessCode="IMG"
                     OnClose="ClosePopup" OnChanged="Refresh" />
        break;
    case Popup.Andon:
        <AndonPopup Session="Session" OnClose="ClosePopup" />
        break;
}

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }

    private static string T(string key, params object?[] args) => PopLang.T(key, args);

    private const string  ProcessCode   = "IMG";
    private const decimal MetresPerUnit = 0.25m;

    private enum Popup { None, Defect, Andon }
    private Popup _popup = Popup.None;

    private List<ItemDailyDto> _items = new();
    private string? _selItemNo;
    private ItemDailyDto? SelItem =>
        _items.FirstOrDefault(x => string.Equals(x.ItemNo, _selItemNo, StringComparison.OrdinalIgnoreCase));
    private WorkOrderDto?  _activeWo;
    private FabricRollDto? _roll;
    private BondSetupDto?  _bond;
    private List<ProductionEntryDto> _entries = new();

    private int _pct, _todayGood, _todayDef, _lastResultId, _cycle = 38;
    private string _defectPct = "0.0%", _defClass = "ok";
    private string _fabricText = "—", _fabricClass = "warn", _bondText = "—";
    private string _eqStatus = "OFFLINE", _eqClass = "stat-off";
    private string?  _refreshError;
    private DateTime _refreshErrorAt;

    private string _bannerClass = "idle", _bannerDetail = "";
    private string BannerTitle => _bannerClass switch
    {
        "ok"  => T("Success"),
        "bad" => T("Fail"),
        _     => T("Ready"),
    };

    private readonly System.Text.StringBuilder _buf = new();
    private int     Qty       => int.TryParse(_buf.ToString(), out var q) ? q : 0;
    private decimal RequiredM => Qty * MetresPerUnit;
    private bool CanConfirm => _activeWo is not null && Qty > 0
                            && (_roll is null || _roll.RemainingM >= RequiredM);

    private DateTime _now = DateTime.Now;
    private System.Threading.Timer? _clockTimer;
    private System.Threading.Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        if (Session is null) return;
        Refresh();
        _clockTimer   = new System.Threading.Timer(_ => InvokeAsync(() => { _now = DateTime.Now; StateHasChanged(); }),
                                                   null, 1000, 1000);
        _refreshTimer = new System.Threading.Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }),
                                                   null, 5000, 5000);
    }

    private void ToggleLang() => PopLang.Lang = PopLang.IsKo ? "en" : "ko";

    private void Refresh()
    {
        if (Session is null) return;
        try
        {
            _items = PopServices.Production.GetDailyItemSummary(Session.LineId, Session.TerminalId, ProcessCode);

            if (SelItem is null)
                _selItemNo = (_items.FirstOrDefault(x => x.HasOpenWo) ?? _items.FirstOrDefault())?.ItemNo;

            // 접수가 없으므로 활성 WO 는 품번에서 매번 해석한다 — INJ-MAIN 과 같은 규칙.
            _activeWo = _selItemNo is null ? null
                      : PopServices.WorkOrders.FindOpenForItem(Session.LineId, _selItemNo);
            _pct = _activeWo is null ? 0 : (int)Math.Clamp(_activeWo.ProgressPct, 0, 100);
            if (!string.IsNullOrEmpty(_activeWo?.RecipeId))
                _cycle = PopServices.Master.GetRecipeCycleTime(_activeWo.RecipeId) ?? 38;

            // 칩은 좌측 행과 같은 당일 수치 — 두 숫자가 어긋나 보이면 작업자가 헷갈린다.
            _todayGood = SelItem?.GoodQty ?? 0;
            _todayDef  = SelItem?.NgQty   ?? 0;
            var pct = (_todayGood + _todayDef) == 0 ? 0 : _todayDef * 100.0 / (_todayGood + _todayDef);
            _defectPct = $"{pct:0.0}%";
            _defClass  = pct >= 5 ? "bad" : pct >= 4 ? "warn" : "ok";

            _roll = PopServices.Fabric.GetMountedRoll(Session.LineId);
            if (_roll is null) { _fabricText = T("NoRoll"); _fabricClass = "warn"; }
            else
            {
                _fabricText  = $"{_roll.LotCode} · {_roll.RemainingM:0.0} m";
                _fabricClass = _roll.RemainingM <= 5 ? "bad" : _roll.RemainingM <= 10 ? "warn" : "ok";
            }

            _bond = PopServices.Bond.GetActiveForLine(Session.LineId);
            _bondText = _bond is null ? T("NoRecipe")
                      : $"{_bond.RecipeId} · {_bond.TempSp:0}°C / {_bond.PressureSp:0.0}bar / {_bond.HoldSecSp}s";

            _entries = PopServices.Production.GetTodayEntries(Session.LineId);

            var eq = PopServices.Equipment.GetPrimaryForLine(Session.LineId);
            _eqStatus = (eq?.Status ?? "OFFLINE").ToUpperInvariant();
            _eqClass  = _eqStatus is "RUN" or "IDLE" ? "stat-on" : "stat-off";
            _refreshError = null;
        }
        catch (Exception ex)
        {
            // 배너는 건드리지 않는다 — 5초마다 덮어쓰면 방금 저장한 결과가 사라진다.
            _refreshError   = ex.Message;
            _refreshErrorAt = DateTime.Now;
            System.Diagnostics.Debug.WriteLine($"[ImgMain refresh] {ex.Message}");
        }
    }

    private void SelectItem(ItemDailyDto it)
    {
        _selItemNo = it.ItemNo;
        Refresh();
    }

    // ── 키패드 ────────────────────────────────────────────────────────
    private void Press(string d) { if (_buf.Length >= 3) return; if (_buf.Length == 0 && d == "0") return; _buf.Append(d); }
    private void Backspace()     { if (_buf.Length > 0) _buf.Length--; }
    private void LoadCt()        { _buf.Clear(); _buf.Append('1'); }

    // ── 실적 확정 (IMG-003 로직) ─────────────────────────────────────
    private void Confirm()
    {
        if (Session is null || _activeWo is null) return;
        var qty = Qty;
        if (qty <= 0) return;
        var required = qty * MetresPerUnit;
        if (_roll is not null && _roll.RemainingM < required)
        {
            SetBanner(false, $"{T("RollShort")}: {_roll.RemainingM:0.0} m < {required:0.00} m");
            return;
        }
        try
        {
            var (resultId, _, _) = PopServices.Production.RecordCycle(
                _activeWo.WoId, _activeWo.ItemNo, _activeWo.LineId, ProcessCode, qty, _cycle, moldId: null,
                Session.OperatorId, Session.SessionId, Session.EmployeeNo, defectFlag: false);
            if (_roll is not null)
                PopServices.Fabric.DeductFromRoll(_roll.LotId, required, resultId, Session.EmployeeNo, Session.OperatorId);
            if (_bond is not null)
                PopServices.Bond.LogCycle(resultId, _bond.BondSetupId,
                    _bond.PressureSp, _bond.TempSp, _bond.HoldSecSp,
                    _bond.TensionSp, withinSpec: true, Session.EmployeeNo);
            _lastResultId = resultId;
            _buf.Clear();
            SetBanner(true, $"{T("EntrySaved")}: {qty} {T("Ea")} ({_activeWo.ItemNo}) → {_activeWo.WoNumber}");
            Refresh();
        }
        catch (Exception ex)
        {
            SetBanner(false, $"{T("EntryFailed")}: {ex.Message}");
        }
    }

    private void SetBanner(bool ok, string detail)
    {
        _bannerClass  = ok ? "ok" : "bad";
        _bannerDetail = detail;
    }

    // ── 팝업 제어 ─────────────────────────────────────────────────────
    private void Open(Popup p) => _popup = p;
    private void ClosePopup() { _popup = Popup.None; Refresh(); }

    private async Task Logout()
    {
        if (!await Confirmer.AskAsync(
                T("LogoutConfirm"),
                T("EndYourShiftAndReturnToTheLoginScreen"),
                T("LogOut2"), T("Stay"), destructive: true)) return;
        Nav.NavigateTo("/login", replace: true);
        State.SignOut();
    }

    public void Dispose()
    {
        _clockTimer?.Dispose();
        _refreshTimer?.Dispose();
    }
}
