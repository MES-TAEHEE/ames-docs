@page "/img04"
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">IMG-04 · FABRIC INPUT · @Session.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span style="color:#a78bfa;">⚡ SIGNATURE</span>
            <span>@Session.EmployeeName · @Session.ShiftCode</span>
        </div>
    </div>

    <div class="pop-bd">
        <div class="fab-grid">
            <div class="fab-panel">
                <div class="fab-h">▼ SCAN ROLL QR · type and press Enter</div>
                <div style="text-align:center; font-size:140px; color:var(--mod-tint); padding:30px;">📷</div>
                <input class="fab-scan-input" @bind="_scan" @bind:event="oninput"
                       @onkeypress="OnKey" placeholder="FAB-..." />
                <div class="fab-help">Required colour: <strong style="color:var(--mod-tint);">@_expectedColor</strong></div>
                <div class="fab-help">Available rolls: @string.Join(" · ", _available.Take(5).Select(r => $"{r.LotCode} ({r.ColorCode})"))</div>
            </div>

            <div class="fab-panel @(_state == "match" ? "match" : _state == "mismatch" ? "mismatch" : "")">
                <div class="fab-h">▼ RESULT</div>
                @if (_state == "")
                {
                    <div class="fab-banner" style="color:rgba(255,255,255,.4);">Awaiting…</div>
                }
                else if (_state == "match")
                {
                    <div class="fab-banner ok">✅ VERIFIED</div>
                    <div class="fab-row"><div class="l">Roll ID</div><div class="v ok">@_scanned?.LotCode</div></div>
                    <div class="fab-row"><div class="l">Colour</div><div class="v ok">@_scanned?.ColorCode  =  @_expectedColor  ✓</div></div>
                    <div class="fab-row"><div class="l">Remaining</div><div class="v ok">@_scanned?.RemainingM.ToString("0.0") m</div></div>
                    <div class="fab-row"><div class="l">Expected Yield</div><div class="v ok">~ @((int)((_scanned?.RemainingM ?? 0) / 0.25m)) EA</div></div>
                    <button class="entry-btn entry-btn-ok" style="margin-top:14px;" @onclick="Confirm">✅ Confirm Input — mount this roll</button>
                }
                else
                {
                    <div class="fab-banner alert">⛔ @_failBanner</div>
                    <div class="fab-row"><div class="l">Scanned</div><div class="v alert">@(_scanned?.ColorCode ?? "—")</div></div>
                    <div class="fab-row"><div class="l">Expected</div><div class="v">@_expectedColor</div></div>
                    <div class="fab-row"><div class="l">Reason</div><div class="v alert">@_failReason</div></div>
                    <button class="entry-btn entry-btn-warn" style="margin-top:14px;" @onclick="Reset">🔄 Re-scan</button>
                }
            </div>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:3;">
        <button class="nav-btn"        @onclick="GoDashboard">◀ Dashboard</button>
        <button class="nav-btn primary" @onclick="GoProdEntry">▶ Prod Entry</button>
        <button class="nav-btn muted"   @onclick="Logout">◀ LOGOUT</button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }

    string _scan = "";
    string _state = "";              // "" / "match" / "mismatch"
    string _failBanner = "", _failReason = "";
    string _expectedColor = "GY-C03";
    FabricRollDto? _scanned;
    WorkOrderDto?  _wo;
    List<FabricRollDto> _available = new();

    protected override void OnInitialized()
    {
        _wo = PopServices.WorkOrders.GetActiveForTerminal(Session.LineId, Session.TerminalId)
           ?? PopServices.WorkOrders.ListForLine(Session.LineId).FirstOrDefault();
        _available = PopServices.Fabric.ListAvailableRolls();
        if (_wo is not null) _expectedColor = GuessColor(_wo.ItemName);
    }

    string GuessColor(string item)
    {
        var n = item.ToUpperInvariant();
        if (n.Contains("LH")) return "GY-C03";
        if (n.Contains("RH")) return "BK-C01";
        return "GY-C03";
    }

    void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") PerformScan();
    }

    void PerformScan()
    {
        var code = _scan.Trim();
        if (string.IsNullOrEmpty(code)) return;
        _scanned = PopServices.Fabric.GetRollByCode(code);
        if (_scanned is null)
        {
            _state = "mismatch"; _failBanner = "Unknown roll"; _failReason = "UNKNOWN_ROLL"; return;
        }
        if (!string.Equals(_scanned.ColorCode, _expectedColor, StringComparison.OrdinalIgnoreCase))
        {
            _state = "mismatch"; _failBanner = "COLOUR MISMATCH"; _failReason = "COLOR_MISMATCH";
            PopServices.Fabric.LogScanAttempt(_wo?.WoId, _scanned.LotId, _scanned.ColorCode ?? "",
                _expectedColor, "FAIL", Session.OperatorId, Session.EmployeeNo);
            return;
        }
        _state = "match";
        PopServices.Fabric.LogScanAttempt(_wo?.WoId, _scanned.LotId, _scanned.ColorCode ?? "",
            _expectedColor, "OK", Session.OperatorId, Session.EmployeeNo);
    }

    void Confirm()
    {
        if (_scanned is null || _wo is null) return;
        try
        {
            PopServices.Fabric.MountRoll(_wo.WoId, _scanned.LotId, _scanned.ColorCode ?? "",
                _scanned.RemainingM, Session.LineId, Session.OperatorId, Session.SessionId, Session.EmployeeNo);
            Nav.NavigateTo("/img03");
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[IMG-04 Confirm] {ex.Message}"); }
    }

    void Reset() { _scan = ""; _state = ""; _scanned = null; _failBanner = ""; _failReason = ""; }
    void GoDashboard() => Nav.NavigateTo("/img02");
    void GoProdEntry() => Nav.NavigateTo("/img03");
    void Logout() { State.SignOut(); Nav.NavigateTo("/login"); }
    public void Dispose() { }
}
