@page "/inj06"
@implements IDisposable
@inject NavigationManager Nav
@inject AppState State
@inject ConfirmService Confirmer

<div class="pop-shell">
    <div class="pop-tbar">
        <div style="display:flex; align-items:center;">
            <span class="pop-tbar-logo">A-MES</span>
            <span class="pop-tbar-id">INJ-06 · MOLD CHANGE · @Session?.LineId</span>
        </div>
        <div class="pop-tbar-r">
            <span style="color:@_severityColor;">@_severityBanner</span>
            <span>@Session?.EmployeeName · @Session?.ShiftCode</span>
            <HelpButton ContentType="@(typeof(AMES.Pop.Pages.Help.Inj06Help))" />
        </div>
    </div>

    <div class="pop-bd">
        @if (_current is not null)
        {
            <div class="mold-status">
                <div class="mold-id">@_current.MoldId · mounted on @_equipName</div>
                <div class="mold-name">@_current.MoldName</div>
                <div class="mold-gauge">
                    <span class="mold-gauge-v" style="color:@_severityColor;">@_current.CurrentShots.ToString("N0")</span>
                    <span class="mold-gauge-t">/ @_current.RatedShots.ToString("N0")</span>
                    <span class="mold-gauge-pct" style="color:@_severityColor; margin-left:auto;">@_current.LifePct.ToString("0.0")%</span>
                </div>
                <div class="mold-bar">
                    <div class="mold-bar-fill" style="width:@Math.Min(100, (int)_current.LifePct)%;"></div>
                </div>
                <div class="mold-info">
                    <div><div class="mi-l">Rated Shots</div><div class="mi-v">@_current.RatedShots.ToString("N0")</div></div>
                    <div><div class="mi-l">Current Shots</div><div class="mi-v warn">@_current.CurrentShots.ToString("N0")</div></div>
                    <div><div class="mi-l">Cavity Count</div><div class="mi-v">@_current.CavityCount</div></div>
                    <div><div class="mi-l">Last Maintenance</div><div class="mi-v">@(_current.LastMaintDate?.ToString("yyyy-MM-dd") ?? "—")</div></div>
                    <div><div class="mi-l">Status</div><div class="mi-v">@_current.Status</div></div>
                    <div><div class="mi-l">Severity</div><div class="mi-v" style="color:@_severityColor;">@_current.Severity.ToUpperInvariant()</div></div>
                </div>
            </div>
        }
        else
        {
            <div class="pop-card" style="text-align:center; padding:40px;">No mold mounted on this line.</div>
        }

        <div class="mnt-wo-card">
            <div class="mnt-wo-h">▼ REPLACEMENT MOLD</div>
            <select @bind="_selectedReplacement" style="width:100%; padding:14px; background:#000; color:var(--mod-tint); border:1px solid rgba(37,99,235,.4); border-radius:6px; font-size:18px; font-weight:700;">
                <option value="">— select replacement —</option>
                @foreach (var m in _available)
                {
                    <option value="@m.MoldId">@m.MoldId · @m.MoldName (@m.LifePct.ToString("0")%, @m.Status)</option>
                }
            </select>
            <div class="mnt-wo-row" style="margin-top:14px;">
                <span class="l">Status</span>
                <span class="v">@(_openChangeId == 0 ? "No change in progress" : $"Change #{_openChangeId} running")</span>
            </div>
        </div>

        <div class="mc-actions">
            <button class="mc-btn mc-btn-sec" @onclick="@(() => Nav.NavigateTo("/inj02"))">◀ Back</button>
            <button class="mc-btn mc-btn-pri" disabled="@(_openChangeId != 0 || string.IsNullOrEmpty(_selectedReplacement))" @onclick="StartChange">🔧 Start Change · Open Downtime</button>
            <button class="mc-btn mc-btn-sec" style="background:@(_openChangeId == 0 ? "#3a3a3a" : "var(--ok-dk)")" disabled="@(_openChangeId == 0)" @onclick="Complete">✓ Complete · Reset to 0</button>
        </div>
    </div>

    <div class="pop-nav" style="--nav-cols:8;">
        <button class="nav-btn" @onclick="@(() => Go("inj02"))">INJ-02<small>Dashboard</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj03"))">INJ-03<small>WO Confirm</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj04"))">INJ-04<small>Prod Entry</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj05"))">INJ-05<small>Defect</small></button>
        <button class="nav-btn active" @onclick="@(() => Go("inj06"))">INJ-06<small>Mold Change</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj07"))">INJ-07<small>Prod Status</small></button>
        <button class="nav-btn" @onclick="@(() => Go("inj08"))">INJ-08<small>Andon</small></button>
        <button class="nav-btn muted" @onclick="Logout">LOGOUT<small>End shift</small></button>
    </div>
</div>

@code {
    [CascadingParameter] public PopSessionDto? Session { get; set; }

    WorkOrderDto?  _wo;
    MoldDto?       _current;
    List<MoldDto>  _available = new();
    string         _selectedReplacement = "";
    int            _openChangeId;
    string         _equipName = "—";
    string         _severityColor  = "var(--ok)";
    string         _severityBanner = "● OK";

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        if (Session is null) return;
        _wo = PopServices.WorkOrders.GetActiveForTerminal(Session.LineId, Session.TerminalId)
           ?? PopServices.WorkOrders.ListForLine(Session.LineId).FirstOrDefault();
        _current = string.IsNullOrEmpty(_wo?.MoldId) ? null : PopServices.Molds.GetById(_wo.MoldId);
        _available = PopServices.Molds.ListAvailable()
                      .Where(m => _current is null || m.MoldId != _current.MoldId).ToList();
        var eq = PopServices.Equipment.GetPrimaryForLine(Session.LineId);
        _equipName = eq?.EquipName ?? "—";

        if (_current is not null)
        {
            (_severityColor, _severityBanner) = _current.Severity switch
            {
                "warn"  => ("var(--warn)",  "⚠ 90% — change recommended"),
                "alert" => ("var(--alert)", "🚨 100% — change ASAP"),
                "hard"  => ("var(--alert)", "⛔ 110% — HARD STOP"),
                _       => ("var(--ok)",    "● OK · within rated life"),
            };
        }
    }

    void StartChange()
    {
        if (_wo is null || string.IsNullOrEmpty(_selectedReplacement)) return;
        try
        {
            var equipId = PopServices.Equipment.GetPrimaryForLine(Session.LineId)?.EquipId ?? "UNKNOWN";
            _openChangeId = PopServices.Molds.StartChange(equipId, Session.LineId,
                _current?.MoldId, _selectedReplacement, _current?.CurrentShots ?? 0,
                Session.OperatorId, Session.EmployeeNo,
                _current?.Severity is "alert" or "hard" ? "WEAR_LIMIT" : "PLANNED");
            PopServices.Equipment.LogStatus(equipId, Session.LineId, "STOP", "MOLD_CHANGE", _wo.WoId, Session.EmployeeNo);
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Start] {ex.Message}"); }
    }

    void Complete()
    {
        if (_openChangeId == 0) return;
        try
        {
            PopServices.Molds.CompleteChange(_openChangeId, _current?.MoldId, _selectedReplacement, Session?.OperatorId);
            var equipId = PopServices.Equipment.GetPrimaryForLine(Session.LineId)?.EquipId ?? "UNKNOWN";
            PopServices.Equipment.LogStatus(equipId, Session.LineId, "RUN", "RESUMED", _wo?.WoId, Session.EmployeeNo);
            _openChangeId = 0;
            Reload();
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Complete] {ex.Message}"); }
    }

    async Task Logout() { if (!await Confirmer.AskAsync("Log out?", "End your shift and return to the login screen?", "Log out", "Stay", destructive: true)) return; Nav.NavigateTo("/login", replace: true); State.SignOut(); }
    public void Dispose() { }
    private void Go(string r) => Nav.NavigateTo("/" + r);
}
