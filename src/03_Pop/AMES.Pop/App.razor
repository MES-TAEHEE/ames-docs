@*  Top-level Blazor router. NotFound renders nothing so the brief
    "/" landing before BlazorWebView applies StartPath doesn't flash
    a 404 message. *@
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
    </Found>
    <NotFound>
        <div></div>
    </NotFound>
</Router>
