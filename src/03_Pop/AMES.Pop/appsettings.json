{
  "ConnectionStrings": {
    "AMES": "Server=172.29.3.21\\MES;Database=AMES;User Id=ames_app;Password=!Dev2026;TrustServerCertificate=True;Encrypt=True;Connect Timeout=30;"
  },
  "PopTerminal": {
    "DefaultShift": "A",
    "Language": "en",
    "Printer": {
      "Mode": "File",
      "Host": "127.0.0.1",
      "Port": 9100,
      "Name": "",
      // 라벨(.zpl)과 POP 로그(*.log)를 쓰는 폴더. 비우면(기본) 실행 파일 옆 labels 폴더 — 바로가기의 작업 폴더와 무관하게 고정된다.
      // 상대 경로는 실행 파일 폴더 기준(예: "D:\\Ames\\labels" 처럼 절대 경로도 가능, %VAR% 사용 가능). 폴더가 없으면 자동으로 만든다.
      "OutputDir": "",
      "PollMs": 1000,
      "MaxFailures": 3
    },
    // [미정 — 운영 담당자 확인] 프린터 주소(Host·Port)·스캐너 COM 포트는 현장 PC 마다 다르고 아직 정해지지 않았습니다(10-26).
    // 개발 PC 예: 프린터 Mode Tcp 192.168.10.20:9100, 스캐너 COM5. 이 파일은 File 모드·빈 포트라 장치 없이 돈다.
    "Scanner": {
      "PortName": "",
      "ReconnectMs": 3000
    },
    "IdleLogoutMinutes": 30,
    "IdleWarnSeconds": 60,
    // DB 연결 대기(초) — DB 가 응답하지 않을 때 오프라인으로 판정되기까지의 시간. 비우거나 0 이면 접속문자열의 Connect Timeout 을 따른다.
    // 같은 PC·사내망 DB 는 3~5 로 낮춰도 된다. 원격 서버 + Encrypt=True 는 TLS 핸드셰이크가 5초를 넘길 수 있어 10 이상으로 둘 것.
    // ProbeIntervalSeconds: 연결 상태 검사 주기(초) — 화면과 무관하게 이 주기로 DB 에 짧게 붙어 보고 정상·비정상을 기록(파일에도 남겨 다음 실행이 이어받음).
    // ProbeTimeoutSeconds: 검사 한 번의 대기(초) — 이 안에 응답이 없으면 끊긴 것으로 보고 저장된 정보를 쓴다. 원격 DB 는 3 이상 권장.
    "Db": { "ConnectTimeoutSeconds": 10, "ProbeIntervalSeconds": 3, "ProbeTimeoutSeconds": 3 },
    // 오프라인 대비 데이터 — 로그아웃 때 이 범위를 받아 둔다. CacheMaxAgeDays 가 지나면 오프라인 로그인을 받지 않는다.
    // RefreshMinutes: 저장 정보 동기화 주기(분) — 직원·라인·스테이션 사본은 항상, 작업 사본은 로그인 중 이 주기로 새로 받는다(로그아웃 때는 주기와 무관).
    //   확정 대기 LOT·오늘 현황은 5초마다 따로 덧붙인다.
    // LotBlockSize: 오프라인 새 라벨용으로 라인·날짜마다 미리 확보하는 LOT 순번 수(안 쓴 번호는 결번이라 작게 둔다).
    // TomorrowBlockFromHour: 내일 날짜 번호는 이 시(0~24) 이후에만 확보 — 자정을 넘기는 정전 대비. 24 면 내일 번호는 확보하지 않는다.
    // NotFoundRetryMinutes: 복구 뒤 서버가 "없는 LOT"이라 한 건을 충돌로 보기 전에 다시 시도하는 시간(분).
    // Dir: 오프라인 사본·작업 큐 파일 폴더(비우면 %LocalAppData%\AMES\Pop). %VAR% 가능, 상대 경로는 실행 폴더 기준. 암호화는 이 PC·Windows 계정에 묶인다.
    "Offline": { "Dir": "", "PastDays": 7, "FutureDays": 7, "CacheMaxAgeDays": 7, "RefreshMinutes": 30, "LotBlockSize": 20, "TomorrowBlockFromHour": 22, "NotFoundRetryMinutes": 30 }
  }
}
