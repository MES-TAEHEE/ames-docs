        new(2, "WH003-TC-002", "LOT 단일 출고 분기",
            "Pick Slip 없이 LOT을 스캔해 단일 출고 정보가 조회되는지 확인합니다.", true,
            new ReleaseTestValue("STANDALONE LOT", "5011LL260820000010")),
        new(3, "WH003-TC-003", "지원하지 않는 바코드",
            "등록되지 않은 바코드를 스캔해 오류 알림을 확인합니다.", true,
            new ReleaseTestValue("UNKNOWN", "WH-RELEASE-UNKNOWN-999999")),
        new(4, "WH003-TC-004", "요청 품목·수량 조회",
            "Pick Slip의 Part No, 요청 Box 수량과 LOT 목록을 확인합니다.", true,
            new ReleaseTestValue("PICK SLIP", "2026082801")),
        new(5, "WH003-TC-005", "FIFO 순서 조회",
            "표시된 LOT이 ProducedAt, LastReceivedAt, LotID 순서인지 확인합니다.", true,
            new("PICK SLIP", "2026082801"),
            new("FIFO 1", "5011LL260701000001"), new("FIFO 2", "5011LL260715000002"),
            new("FIFO 3", "5011LL260801000003"), new("OTHER PART", "5011LL260601000004")),
        new(6, "WH003-TC-006", "요청 LOT 하이라이트",
            "첫 FIFO LOT을 스캔해 해당 행만 초록색으로 바뀌는지 확인합니다.", true,
            new("PICK SLIP", "2026082801"), new("FIFO LOT", "5011LL260701000001")),
        new(7, "WH003-TC-007", "비요청 LOT 차단",
            "Pick Slip에 없는 LOT을 스캔해 Pick Blocked 알림을 확인합니다.", true,
            new("PICK SLIP", "2026082801"), new("NOT REQUESTED", "5011LL260101000018")),
        new(8, "WH003-TC-008", "동일 LOT 중복 차단",
            "FIFO LOT을 두 번 눌러 Already Scanned 알림과 수량 유지 여부를 확인합니다.", true,
            new("PICK SLIP", "2026082801"), new("SCAN TWICE", "5011LL260701000001")),
        new(9, "WH003-TC-009", "부분 스캔 Release 차단",
            "요청 LOT 일부만 스캔했을 때 RELEASE가 비활성인지 확인합니다.", true,
            new("PICK SLIP", "2026082801"), new("ONE LOT", "5011LL260701000001")),
        new(10, "WH003-TC-010", "FIFO 위반 차단",
            "두 번째 LOT을 먼저 스캔해 먼저 스캔할 LOT과 위치 안내를 확인합니다.", true,
            new("PICK SLIP", "2026082801"), new("SKIP FIFO", "5011LL260715000002")),
        new(11, "WH003-TC-011", "FIFO 정상 스캔",
            "첫 FIFO LOT을 스캔해 정상 반영되는지 확인합니다.", true,
            new("PICK SLIP", "2026082801"), new("FIFO LOT", "5011LL260701000001")),
        new(12, "WH003-TC-012", "전체 LOT 스캔",
            "모든 LOT을 순서대로 스캔해 OUTGOING TYPE이 나타나는지 확인합니다.", true,
            new("PICK SLIP", "2026082801"),
            new("LOT 1", "5011LL260701000001"), new("LOT 2", "5011LL260715000002"),
            new("LOT 3", "5011LL260801000003"), new("LOT 4", "5011LL260601000004")),
        new(13, "WH003-TC-013", "Production Line 유형 선택",
            "전체 스캔 후 Production Line을 선택해 RELEASE 활성화를 확인합니다.", true,
            new("PICK SLIP", "2026082801"),
            new("LOT 1", "5011LL260701000001"), new("LOT 2", "5011LL260715000002"),
            new("LOT 3", "5011LL260801000003"), new("LOT 4", "5011LL260601000004"),
            new("OUTGOING TYPE", "PRODUCTION", true)),
