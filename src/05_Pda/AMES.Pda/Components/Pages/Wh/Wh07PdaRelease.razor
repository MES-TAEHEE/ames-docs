@page "/wh/07"
@inject PdaApi Api
@inject NavigationManager Nav

<div class="pda-shell wh wh07-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/wh"))' Text="&lt;" />
        <div class="wh07-tbar-title">
            <span class="pda-tbar-brand">WH-007 RELEASE</span>
            <span class="wh07-subtitle">@(_loadedSlipNo ?? "Select Pick Slip")</span>
        </div>
    </div>

    <div class="pda-bd wh07-body">
        <RadzenCard class="wh07-panel wh07-slip-panel">
            <div class="pda-fld">
                <label>PICK SLIP NO</label>
                <RadzenTextBox class="pda-input wh07-input"
                               Value="@_pickSlipNo"
                               @oninput="OnPickSlipInput"
                               @onkeydown="OnPickSlipKey"
                               Placeholder="Scan or enter Pick Slip No" />
            </div>
            <RadzenButton class="wh07-load-btn" Click="@LoadSlip" Disabled="@DisableLoad" Text="LOAD" />
        </RadzenCard>

        @if (_lines.Count > 0)
        {
            <RadzenCard class="wh07-summary-card">
                <div class="wh07-summary-top">
                    <div>
                        <span>PICK SLIP</span>
                        <strong>@_loadedSlipNo</strong>
                    </div>
                    <RadzenBadge class="@($"wh07-status {SlipStatusClass}")" Text="@SlipStatusText" />
                </div>
                <div class="wh07-summary-grid">
                    <div>
                        <span>Lines</span>
                        <strong>@_lines.Count</strong>
                    </div>
                    <div>
                        <span>Request Boxes</span>
                        <strong>@TotalRequestBoxes.ToString("N0")</strong>
                    </div>
                    <div>
                        <span>Picked Boxes</span>
                        <strong>@TotalPickedBoxes.ToString("N0")</strong>
                    </div>
                </div>
            </RadzenCard>

            <div class="wh07-line-list">
                @foreach (var line in _lines)
                {
                    <RadzenCard class="@($"wh07-line-card {LineStatusClass(line)}")">
                        <div class="wh07-line-top">
                            <div class="wh07-line-main">
                                <span>ITEM</span>
                                <strong>@line.ItemNo</strong>
                                <em>@(line.ItemName ?? "-")</em>
                            </div>
                            <RadzenBadge class="@($"wh07-status {LineStatusClass(line)}")" Text="@LineStatusText(line)" />
                        </div>
                        <div class="wh07-line-grid">
                            <div>
                                <span>Request</span>
                                <strong>@line.RequestBoxQty.ToString("N0")</strong>
                            </div>
                            <div>
                                <span>Picked</span>
                                <strong>@line.PickedBoxQty.ToString("N0")</strong>
                            </div>
                        </div>
                        <div class="wh07-fifo">
                            <span>FIFO LOCATIONS</span>
                            <strong>@SuggestedLocations(line)</strong>
                        </div>
                    </RadzenCard>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_loadedSlipNo))
        {
            <div class="pda-empty">No lines found for this Pick Slip.</div>
        }

        <RadzenCard class="@($"wh07-panel wh07-scan-panel {(ScanDisabled ? "disabled" : "")}")">
            <div class="pda-fld">
                <label>LOT NO SCAN</label>
                <RadzenTextBox class="pda-input wh07-input"
                               Value="@_lotNo"
                               @oninput="OnLotInput"
                               @onkeydown="OnLotKey"
                               Placeholder="Scan LOT No"
                               Disabled="@ScanDisabled" />
            </div>
            <RadzenButton class="wh07-scan-btn" Click="@ScanLot" Disabled="@DisableScan" Text="SCAN" />
        </RadzenCard>

        @if (_scan is not null)
        {
            <RadzenCard class="@($"wh07-lot-card {(_scan.IsValid ? "ready" : "blocked")}")">
                <div class="wh07-lot-top">
                    <div class="wh07-lot-main">
                        <span>LOT NO</span>
                        <strong>@_scan.LotNo</strong>
                    </div>
                    <div class="wh07-lot-tags">
                        <RadzenBadge class="@($"wh07-status {(_scan.IsValid ? "ready" : "blocked")}")" Text="@(_scan.IsValid ? "Ready" : "Blocked")" />
                        <RadzenBadge class="@($"wh07-fifo-chip {(_scan.IsFifoSuggested ? "ok" : "warn")}")" Text="@(_scan.IsFifoSuggested ? "FIFO OK" : "FIFO Check")" />
                    </div>
                </div>

                <div class="wh07-part">
                    <div class="wh07-part-no">@Text(_scan.ItemNo)</div>
                    <div class="wh07-part-name">@Text(_scan.ItemName)</div>
                </div>

                <div class="wh07-info-grid">
                    @foreach (var field in LotFields())
                    {
                        <div class="wh07-info">
                            <span>@field.Label</span>
                            <strong>@field.Value</strong>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_scan.Message))
                {
                    <div class="@($"wh07-scan-message {(_scan.IsValid ? "ok" : "fail")}")">@_scan.Message</div>
                }
            </RadzenCard>
        }

        <div class="wh07-action-bar">
            <RadzenButton class="wh07-clear-btn" Click="@ClearScan" Disabled="@_isBusy" Text="CLEAR" />
            <RadzenButton class="@($"wh07-pick-btn {PickButtonClass}")" Click="@SubmitPick" Disabled="@DisablePick" Text="PICK" />
        </div>
    </div>

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="DismissModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@_modalMark</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions">
                    <RadzenButton class="wh-modal-btn primary" Click="@ModalPrimary" Text="OK" />
                </div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? PickSlipNo { get; set; }

    private string _pickSlipNo = "";
    private string? _loadedSlipNo;
    private string _lotNo = "";
    private List<PdaApi.ReleasePickLineRow> _lines = new();
    private PdaApi.ReleaseLotRow? _scan;
    private bool _isBusy;
    private bool _initialized;
    private bool _modalOpen;
    private string _modalKind = "info";
    private string _modalMark = "!";
    private string _modalTitle = "";
    private string _modalMessage = "";
    private Func<Task>? _modalAfterOk;

    private decimal TotalRequestBoxes => _lines.Sum(x => x.RequestBoxQty);
    private decimal TotalPickedBoxes => _lines.Sum(x => x.PickedBoxQty);
    private bool DisableLoad => _isBusy || string.IsNullOrWhiteSpace(_pickSlipNo);
    private bool ScanDisabled => string.IsNullOrWhiteSpace(_loadedSlipNo) || _lines.Count == 0;
    private bool DisableScan => _isBusy || ScanDisabled || string.IsNullOrWhiteSpace(_lotNo);
    private bool DisablePick => _isBusy || _scan is null || !_scan.IsValid;
    private string PickButtonClass => DisablePick ? "blocked" : "ready";
    private string SlipStatusClass => TotalRequestBoxes <= 0 ? "open" :
        TotalPickedBoxes >= TotalRequestBoxes ? "picked" :
        TotalPickedBoxes > 0 ? "partial" : "open";
    private string SlipStatusText => SlipStatusClass switch
    {
        "picked" => "Picked",
        "partial" => "Partial",
        _ => "Open"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized) return;
        _initialized = true;

        if (!string.IsNullOrWhiteSpace(PickSlipNo))
        {
            _pickSlipNo = PickSlipNo.Trim();
            await LoadSlip();
        }
    }

    private void OnPickSlipInput(ChangeEventArgs e)
    {
        _pickSlipNo = e.Value?.ToString() ?? "";
    }

    private void OnLotInput(ChangeEventArgs e)
    {
        _lotNo = e.Value?.ToString() ?? "";
    }

    private void OnPickSlipKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = LoadSlip();
    }

    private void OnLotKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = ScanLot();
    }

    private async Task LoadSlip()
    {
        if (string.IsNullOrWhiteSpace(_pickSlipNo))
        {
            ShowModal("Missing Pick Slip", "Scan or enter Pick Slip No first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            _loadedSlipNo = _pickSlipNo.Trim();
            _lines = await Api.WhReleaseLinesAsync(_loadedSlipNo);
            _scan = null;
            _lotNo = "";

            if (_lines.Count == 0)
                ShowModal("No Lines Found", "No release lines were found for this Pick Slip.", "warn");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ScanLot()
    {
        if (string.IsNullOrWhiteSpace(_loadedSlipNo))
        {
            ShowModal("Missing Pick Slip", "Load a Pick Slip before scanning LOT.", "warn");
            return;
        }

        if (string.IsNullOrWhiteSpace(_lotNo))
        {
            ShowModal("Missing LOT No", "Scan LOT No first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            _scan = await Api.WhReleaseLotAsync(_loadedSlipNo, _lotNo.Trim());
            if (_scan is null)
            {
                ShowModal("Scan Failed", "LOT lookup failed. Check API connection.", "fail");
                return;
            }

            if (!_scan.IsValid)
                ShowModal("Pick Blocked", _scan.Message ?? "This LOT cannot be picked.", "fail");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SubmitPick()
    {
        if (string.IsNullOrWhiteSpace(_loadedSlipNo))
        {
            ShowModal("Missing Pick Slip", "Load a Pick Slip before picking.", "warn");
            return;
        }

        if (_scan is null)
        {
            ShowModal("Missing LOT No", "Scan LOT No before picking.", "warn");
            return;
        }

        if (!_scan.IsValid)
        {
            ShowModal("Pick Blocked", _scan.Message ?? "This LOT cannot be picked.", "fail");
            return;
        }

        _isBusy = true;
        try
        {
            var resp = await Api.WhPickAsync(new PdaApi.PickReq(_loadedSlipNo, _scan.LotNo, _scan.Qty));
            var result = await resp.Content.ReadFromJsonAsync<PdaApi.PickResult>();
            if (resp.IsSuccessStatusCode && result?.Success == true)
            {
                ShowModal("Pick Complete", result.Message, "ok", async () =>
                {
                    ClearScan();
                    await LoadSlip();
                });
            }
            else
            {
                ShowModal("Pick Failed", result?.Message ?? $"HTTP {(int)resp.StatusCode}", "fail");
            }
        }
        catch (Exception ex)
        {
            ShowModal("Pick Failed", ex.Message, "fail");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ClearScan()
    {
        _lotNo = "";
        _scan = null;
    }

    private IEnumerable<Field> LotFields()
    {
        if (_scan is null) yield break;

        yield return new Field("Qty", QuantityText(_scan.Qty, _scan.Unit));
        yield return new Field("Location", Text(_scan.LocationNo));
        yield return new Field("Zone", Text(_scan.ZoneCode));
        yield return new Field("Status", Text(_scan.InvStatus));
        yield return new Field("Received", Text(_scan.RcvDate));
        yield return new Field("Produced", Text(_scan.ProdDate));
    }

    private static string LineStatusClass(PdaApi.ReleasePickLineRow line)
        => (line.Status ?? "Open").Trim().ToLowerInvariant() switch
        {
            "picked" => "picked",
            "partial" => "partial",
            _ => "open"
        };

    private static string LineStatusText(PdaApi.ReleasePickLineRow line)
        => LineStatusClass(line) switch
        {
            "picked" => "Picked",
            "partial" => "Partial",
            _ => "Open"
        };

    private static string SuggestedLocations(PdaApi.ReleasePickLineRow line)
    {
        var locations = new[] { line.SuggestedLocation1, line.SuggestedLocation2, line.SuggestedLocation3 }
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
        return locations.Count == 0 ? "-" : string.Join(" / ", locations);
    }

    private static string QuantityText(decimal qty, string? unit)
        => string.IsNullOrWhiteSpace(unit) ? qty.ToString("N0") : $"{qty:N0} {unit}";

    private static string Text(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private void ShowModal(string title, string message, string kind, Func<Task>? afterOk = null)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalMark = kind switch
        {
            "ok" => "OK",
            "fail" => "!",
            "warn" => "!",
            _ => "i"
        };
        _modalAfterOk = afterOk;
        _modalOpen = true;
    }

    private async Task ModalPrimary()
    {
        var after = _modalAfterOk;
        DismissModal();
        if (after is not null) await after();
    }

    private void DismissModal()
    {
        _modalOpen = false;
        _modalAfterOk = null;
    }

    private sealed record Field(string Label, string Value);
}
