@page "/wh/07"
@inject PdaApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh07-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/wh"))' Text="&lt;" />
        <div class="wh07-tbar-title">
            <span class="pda-tbar-brand">WH-003 RELEASE</span>
            <span class="wh07-subtitle">@(_loadedSlipNo ?? "Select Pick Slip")</span>
        </div>
    </div>

    <div class="pda-bd wh07-body">
        <RadzenCard class="wh07-panel wh07-slip-panel">
            <div class="pda-fld">
                <label>PICK SLIP NO</label>
                <RadzenTextBox class="pda-input wh07-input pda-scan-input"
                               Value="@_pickSlipNo"
                               @oninput="OnPickSlipInput"
                               @onkeydown="OnPickSlipKey"
                               Placeholder="Scan Pick Slip No" />
            </div>
        </RadzenCard>

        @if (ShowDeveloperScanButtons && !ScanDisabled)
        {
            <RadzenCard class="wh07-panel wh07-slip-panel dev-scan-panel">
                <div class="pda-fld">
                    <label>LOT NO</label>
                    <RadzenTextBox class="pda-input wh07-input wh07-lot-input"
                                   Value="@_lotNo"
                                   @oninput="OnLotInput"
                                   @onkeydown="OnLotKey"
                                   Placeholder="Type LOT No and press Enter" />
                </div>
                <RadzenButton Text="PICK LOT" Icon="barcode_reader" ButtonStyle="ButtonStyle.Primary"
                              Click="@PickTypedLotAsync" Disabled="@_isBusy" />
            </RadzenCard>
        }

        @if (_lines.Count > 0)
        {
            <div class="wh07-line-list">
                @foreach (var line in _lines)
                {
                    <RadzenCard class="@LineCardClass(line)">
                        <div class="wh07-line-top">
                            <div class="wh07-line-main">
                                <strong>@line.ItemNo</strong>
                                <div class="wh07-line-qty">
                                    <span>REQ BOX <strong>@line.RequestBoxQty.ToString("N0")</strong></span>
                                    <span>PICKED BOX <strong>@DisplayPickedBox(line).ToString("N0")</strong></span>
                                    @if (IsScannedLine(line))
                                    {
                                        <span class="wh07-check">✓ CHECKED</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </RadzenCard>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_loadedSlipNo))
        {
            <div class="pda-empty">No lines found for this Pick Slip.</div>
        }

        @if (!string.IsNullOrWhiteSpace(_loadedSlipNo) && _lines.Count > 0)
        {
            <div class="wh02-action-bar has-secondary wh07-action-bar">
                <RadzenButton class="wh02-clear-btn" Text="CLEAR"
                          Click="@ClearRelease" Disabled="@_isBusy" />
                <RadzenButton class="@($"pda-btn-pri wh02-receive-btn wh02-receive-action-btn {ReleaseButtonClass}")" Text="RELEASE"
                          Click="@CompleteReleaseAsync" Disabled="@(_isBusy || !CanCompleteRelease)" />
            </div>
        }

    </div>

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="DismissModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@_modalMark</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions">
                    <RadzenButton class="wh-modal-btn primary" Click="@ModalPrimary" Text="OK" />
                </div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? PickSlipNo { get; set; }

    private string _pickSlipNo = "";
    private string _lotNo = "";
    private string? _loadedSlipNo;
    private List<PdaApi.ReleasePickLineRow> _lines = new();
    private List<PdaApi.ReleaseFifoLotRow> _fifoLots = new();
    private List<PdaApi.ReleaseLotRow> _pendingPicks = new();
    private PdaApi.ReleaseLotRow? _scan;
    private string? _scannedItemNo;
    private bool _isBusy;
    private bool _initialized;
    private bool _modalOpen;
    private string _modalKind = "info";
    private string _modalMark = "!";
    private string _modalTitle = "";
    private string _modalMessage = "";
    private Func<Task>? _modalAfterOk;
    private DotNetObjectReference<Wh07PdaRelease>? _scannerRef;

    private static bool ShowDeveloperScanButtons => MauiProgram.IsDeveloperMode;
    private bool ScanDisabled => string.IsNullOrWhiteSpace(_loadedSlipNo) || _lines.Count == 0;

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized) return;
        _initialized = true;

        if (!string.IsNullOrWhiteSpace(PickSlipNo))
        {
            _pickSlipNo = PickSlipNo.Trim();
            await LoadSlip();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
            _scannerRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = ShowDeveloperScanButtons });
        }

        await FocusScannerAsync();
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        var value = NormalizeHardwareScan(scanText);
        if (string.IsNullOrWhiteSpace(value))
            return;

        await InvokeAsync(async () =>
        {
            if (ScanDisabled)
            {
                _pickSlipNo = value;
                await LoadSlip();
            }
            else
            {
                await ScanAndPickAsync(value);
            }

            StateHasChanged();
        });
    }

    private void OnNativeBarcodeScanned(string barcode)
    {
        _ = InvokeAsync(async () => await OnHardwareScanAsync(barcode));
    }

    private async Task FocusScannerAsync()
    {
        if (_modalOpen)
            return;

        try
        {
            var selector = !ScanDisabled
                ? ".wh07-lot-input"
                : ".wh07-slip-panel .wh07-input";
            await JS.InvokeVoidAsync("pdaScan.focus", selector);
        }
        catch
        {
            // Ignore focus failures while the WebView is navigating.
        }
    }

    private static string NormalizeHardwareScan(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Replace("\u0002", "").Replace("\u0003", "").Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;

        try
        {
            await JS.InvokeVoidAsync("pdaScan.unregister");
        }
        catch
        {
            // Ignore dispose-time JS disconnects.
        }

        _scannerRef?.Dispose();
    }

    private void OnPickSlipInput(ChangeEventArgs e)
    {
        _pickSlipNo = e.Value?.ToString() ?? "";
    }

    private void OnPickSlipKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = LoadSlip();
    }

    private void OnLotInput(ChangeEventArgs e)
    {
        _lotNo = e.Value?.ToString() ?? "";
    }

    private void OnLotKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = PickTypedLotAsync();
    }

    private async Task PickTypedLotAsync()
    {
        var lotNo = _lotNo.Trim();
        if (string.IsNullOrWhiteSpace(lotNo))
        {
            ShowModal("Missing LOT No", "Type a LOT No before picking.", "warn");
            return;
        }

        _lotNo = "";
        await ScanAndPickAsync(lotNo);
    }

    private async Task LoadSlip()
    {
        if (string.IsNullOrWhiteSpace(_pickSlipNo))
        {
            ShowModal("Missing Pick Slip", "Scan or enter Pick Slip No first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            _loadedSlipNo = _pickSlipNo.Trim();
            _scan = null;
            _scannedItemNo = null;
            _lines.Clear();
            _fifoLots.Clear();
            _pendingPicks.Clear();

            var status = await Api.WhReleaseSlipStatusAsync(_loadedSlipNo);
            if (status is null)
            {
                ShowModal("Load Failed", "Pick Slip lookup failed. Check API connection.", "fail");
                _loadedSlipNo = null;
                return;
            }

            if (!status.Exists)
            {
                ShowModal("Pick Slip Not Found", status.Message, "fail");
                _loadedSlipNo = null;
                return;
            }

            if (status.IsClosed)
            {
                ShowModal("Already Processed", "This Pick Slip has already been processed.", "warn");
                _loadedSlipNo = null;
                return;
            }

            _lines = await Api.WhReleaseLinesAsync(_loadedSlipNo);
            _fifoLots = await Api.WhReleaseFifoLotsAsync(_loadedSlipNo);

            if (_lines.Count == 0)
            {
                ShowModal("No Lines Found", "No release lines were found for this Pick Slip.", "warn");
                _loadedSlipNo = null;
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ScanAndPickAsync(string scanText)
    {
        if (string.IsNullOrWhiteSpace(_loadedSlipNo))
        {
            ShowModal("Missing Pick Slip", "Scan a Pick Slip before scanning a LOT.", "warn");
            return;
        }

        if (string.IsNullOrWhiteSpace(scanText))
        {
            ShowModal("Missing LOT No", "Scan a LOT barcode.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            _scan = await Api.WhReleaseLotAsync(_loadedSlipNo, scanText.Trim());
            if (_scan is null)
            {
                ShowModal("Scan Failed", "LOT lookup failed. Check API connection.", "fail");
                return;
            }

            var locallyValidFifoFollowUp = CanAcceptPendingFifoFollowUp(_scan);
            if (!_scan.IsValid && !locallyValidFifoFollowUp)
            {
                var alreadySufficient = _scan.Message?.Contains("fully picked", StringComparison.OrdinalIgnoreCase) == true
                                       || IsPartAlreadySufficient(_scan.ItemNo);
                var fifoBlocked = _scan.Message?.Contains("FIFO", StringComparison.OrdinalIgnoreCase) == true;
                ShowModal(alreadySufficient ? "Already Sufficient" : fifoBlocked ? "FIFO Order" : "Pick Blocked",
                    alreadySufficient
                        ? "This part already has all requested boxes picked."
                        : fifoBlocked
                            ? FifoBlockedMessage(_scan)
                            : _scan.Message ?? "This LOT cannot be picked.",
                    alreadySufficient || fifoBlocked ? "warn" : "fail");
                return;
            }

            if (IsPartAlreadySufficient(_scan.ItemNo))
            {
                ShowModal("Already Sufficient", "This part already has all requested boxes picked.", "warn");
                return;
            }

            if (_pendingPicks.Any(pick => string.Equals(pick.LotNo, _scan.LotNo, StringComparison.OrdinalIgnoreCase)))
            {
                ShowModal("Already Scanned", "This LOT is already in the current release list.", "warn");
                return;
            }

            _scan = _scan with { IsValid = true, Message = "LOT added. It will be saved when RELEASE is pressed." };
            _pendingPicks.Add(_scan);
            _scannedItemNo = _scan.ItemNo;
        }
        catch (Exception ex)
        {
            ShowModal("Pick Failed", ex.Message, "fail");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string LineCardClass(PdaApi.ReleasePickLineRow line)
    {
        var pickedBoxes = DisplayPickedBox(line);
        var progress = pickedBoxes >= line.RequestBoxQty && line.RequestBoxQty > 0
            ? "picked"
            : pickedBoxes > 0
                ? "partial"
                : "open";
        return $"wh07-line-card {progress}";
    }

    private List<PdaApi.ReleaseFifoLotRow> FifoLotsFor(string itemNo)
        => _fifoLots.Where(lot => string.Equals(lot.ItemNo, itemNo, StringComparison.OrdinalIgnoreCase)
                                  && !_pendingPicks.Any(pick => string.Equals(pick.LotNo, lot.LotNo, StringComparison.OrdinalIgnoreCase)))
                    .ToList();

    private decimal DisplayPickedBox(PdaApi.ReleasePickLineRow line)
        => line.PickedBoxQty + _pendingPicks.Count(pick => string.Equals(pick.ItemNo, line.ItemNo, StringComparison.OrdinalIgnoreCase));

    private bool IsPartAlreadySufficient(string? itemNo)
        => _lines.FirstOrDefault(line => string.Equals(line.ItemNo, itemNo, StringComparison.OrdinalIgnoreCase)) is { } line
           && DisplayPickedBox(line) >= line.RequestBoxQty;

    private bool CanAcceptPendingFifoFollowUp(PdaApi.ReleaseLotRow row)
    {
        if (row.IsValid || string.IsNullOrWhiteSpace(row.ItemNo)
            || row.Message?.Contains("FIFO", StringComparison.OrdinalIgnoreCase) != true)
            return false;

        var expectedLot = FifoLotsFor(row.ItemNo).FirstOrDefault()?.LotNo;
        return !string.IsNullOrWhiteSpace(expectedLot)
               && string.Equals(expectedLot, row.LotNo, StringComparison.OrdinalIgnoreCase);
    }

    private string FifoBlockedMessage(PdaApi.ReleaseLotRow row)
    {
        var expected = string.IsNullOrWhiteSpace(row.ItemNo)
            ? null
            : FifoLotsFor(row.ItemNo).FirstOrDefault();
        return expected is null
            ? "This LOT is not the next FIFO LOT for the selected Pick Slip."
            : $"Scan {expected.LotNo} first. Location: {expected.LocationNo ?? "-"}.";
    }

    private bool CanCompleteRelease => _lines.Count > 0 && _lines.All(line => line.RequestBoxQty > 0 && DisplayPickedBox(line) >= line.RequestBoxQty);

    private string ReleaseButtonClass => CanCompleteRelease ? "ready" : "blocked";

    private void ClearRelease()
    {
        _pickSlipNo = "";
        _lotNo = "";
        _loadedSlipNo = null;
        _lines.Clear();
        _fifoLots.Clear();
        _pendingPicks.Clear();
        _scan = null;
        _scannedItemNo = null;
    }

    private async Task CompleteReleaseAsync()
    {
        if (string.IsNullOrWhiteSpace(_loadedSlipNo) || !CanCompleteRelease || _isBusy) return;

        _isBusy = true;
        try
        {
            var releaseLots = _pendingPicks
                .Select(pick => new PdaApi.ReleasePickInput(pick.LotNo, pick.Qty))
                .ToList();
            var response = await Api.WhReleaseCompleteAsync(new PdaApi.ReleaseCompleteReq(_loadedSlipNo, releaseLots));
            var result = await response.Content.ReadFromJsonAsync<PdaApi.ReleaseCompleteResult>();
            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                var completedSlip = _loadedSlipNo;
                _loadedSlipNo = null;
                _pickSlipNo = "";
                _lines.Clear();
                _fifoLots.Clear();
                _pendingPicks.Clear();
                ShowModal("Release Complete", $"{completedSlip} has been completed.", "ok");
            }
            else
            {
                ShowModal("Release Not Complete", result?.Message ?? "Release could not be completed.", "warn");
            }
        }
        catch (Exception ex)
        {
            ShowModal("Release Failed", ex.Message, "fail");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private bool IsScannedLine(PdaApi.ReleasePickLineRow line)
        => _scan?.IsValid == true
           && !string.IsNullOrWhiteSpace(_scannedItemNo)
           && string.Equals(line.ItemNo, _scannedItemNo, StringComparison.OrdinalIgnoreCase);

    private void ShowModal(string title, string message, string kind, Func<Task>? afterOk = null)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalMark = kind switch
        {
            "ok" => "OK",
            "fail" => "!",
            "warn" => "!",
            _ => "i"
        };
        _modalAfterOk = afterOk;
        _modalOpen = true;
    }

    private async Task ModalPrimary()
    {
        var after = _modalAfterOk;
        DismissModal();
        if (after is not null) await after();
    }

    private void DismissModal()
    {
        _modalOpen = false;
        _modalAfterOk = null;
    }

}
