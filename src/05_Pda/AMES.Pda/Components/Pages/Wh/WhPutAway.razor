@page "/wh/putaway"
@page "/fg/02"
@inject PdaUomFormat Uom
@inject WarehouseApi Api
@inject FinishedGoodsApi FgApi
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh02-shell wh-putaway-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/wh"))' Text="&lt;" />
        <span class="pda-tbar-brand">SET LOCATION</span>
        @if (IsPptTestMode)
        {
            <PptScenarioPanel Title="SET LOCATION" Steps="PptSteps" Busy="IsBusy"
                              OnStart="StartPptStep" OnValue="RunPptValue" OnReset="ResetPptData"
                              OpenChanged="@((bool open) => _pptOpen = open)" />
        }
    </div>

    <div class="pda-bd wh02-body wh-putaway-body">
        <RadzenCard class="wh02-panel wh02-scan-panel hardware-scan-panel">
            <div class="pda-fld">
                <label>SCAN BARCODE</label>
                <RadzenTextBox class="pda-input wh02-barcode-input wh-putaway-item-input pda-scan-input"
                               Value="@_barcode" @oninput="OnBarcodeInput" @onkeydown="OnBarcodeKey"
                               Placeholder="Scan Shipping Unit, Unit Item, LOT or Delivery Note" Disabled="@IsBusy" />
            </div>
        </RadzenCard>

        @if (_boxes.Count > 0)
        {
            <section class="wh-putaway-selection">
                <div class="wh-putaway-document-head">
                    <div>
                        <span>@(_selectionType == "DELIVERY_NOTE" ? "DELIVERY NOTE" : _fgScan?.Items is not null ? "ASSY PALLET" : _fgScan is not null ? "ASSY LOT" : _selectionType == "CASE" ? "SHIPPING UNIT" : "UNIT ITEM")</span>
                        <strong>@Text(_barcode)</strong>
                    </div>
                    <div class="wh-putaway-document-summary">
                        <strong>@PendingBoxes.Count pending · @StoredBoxes.Count stored</strong>
                        <span>@(_fgScan is null ? "UNIT ITEMS" : "FG · ASSY")</span>
                    </div>
                </div>

                <div class="wh-putaway-select-actions"><span>@(_selectionType == "DELIVERY_NOTE" ? "VIEW ONLY" : "PENDING ITEMS")</span></div>
                <div class="wh-putaway-boxes">
                    @foreach (var box in PendingBoxes)
                    {
                        <div class="@($"wh-putaway-box-row {(IsSelected(box.Barcode) ? "selected" : "")}")">
                            <span class="wh-putaway-check">@(IsSelected(box.Barcode) ? "✓" : "")</span>
                            <div class="wh-putaway-box-main">
                                <strong>@box.Barcode</strong>
                                <span>@Text(box.PartNo) · @Text(box.PartName)</span>
                            </div>
                            <div class="wh-putaway-box-meta">
                                <strong>@QtyText(box.Qty, box.Unit)</strong>
                                @if (_fgScan is not null)
                                {
                                    <span>READY DATE</span>
                                }
                                <span>@DateText(box.ReceivedAt, _fgScan is not null)</span>
                            </div>
                        </div>
                    }
                </div>
                @if (StoredBoxes.Count > 0)
                {
                    <div class="wh-putaway-select-actions"><span>ALREADY PUT AWAY</span></div>
                    <div class="wh-putaway-boxes">
                        @foreach (var box in StoredBoxes)
                        {
                            <div class="wh-putaway-box-row stored">
                                <span class="wh-putaway-check">✓</span>
                                <div class="wh-putaway-box-main">
                                    <strong>@box.Barcode</strong>
                                    <span>@Text(box.PartNo) · @Text(box.PartName)</span>
                                </div>
                                <div class="wh-putaway-box-meta">
                                    <strong>@QtyText(box.Qty, box.Unit)</strong>
                                    <span>AT @Text(box.LocationNo)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            @if (CanScanLocation)
            {
            <RadzenCard class="wh02-panel wh02-location-panel hardware-scan-panel location-attention">
                <div class="pda-fld">
                    <label>LOCATION BARCODE SCAN</label>
                    <RadzenTextBox class="pda-input wh02-location-input wh-putaway-location-input pda-scan-input"
                                   Value="@_locationNo" @oninput="OnLocationInput" @onkeydown="OnLocationKey"
                                   Placeholder="Scan location barcode" Disabled="@IsBusy" />
                </div>
            </RadzenCard>
            }
        }

        @if (_location is not null)
        {
            <RadzenCard class="wh02-location-card wh-putaway-location-card">
                <div class="wh02-location-card-top">
                    <span>LOCATION NO</span>
                    <strong>@_location.LocationId</strong>
                    <em>@Text(_location.LocationName ?? _location.ZoneName ?? _location.Zone)</em>
                </div>
                <div class="wh02-location-list">
                    @if (!string.IsNullOrWhiteSpace(_location.WarehouseCode))
                    {
                        <div class="wh02-location-row"><span>WAREHOUSE</span><strong>@_location.WarehouseCode</strong></div>
                    }
                    <div class="wh02-location-row"><span>AREA</span><strong>@Text(_location.AreaCode)</strong></div>
                    <div class="wh02-location-row"><span>AISLE</span><strong>@Text(_location.X)</strong></div>
                    <div class="wh02-location-row"><span>BAY</span><strong>@Text(_location.Y)</strong></div>
                    <div class="wh02-location-row"><span>FLOOR</span><strong>@Text(_location.Z)</strong></div>
                    <div class="wh02-location-row"><span>STOCK QTY</span><strong>@_location.TotalQty.ToString("N0")</strong></div>
                    <div class="wh02-location-row"><span>LOAD CAPACITY</span><strong>@(_location.Capacity is > 0 ? _location.Capacity.Value.ToString("N0") : "-")</strong></div>
                </div>
            </RadzenCard>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="pda-status @_messageClass">@_message</div>
        }

        <div class="wh02-action-bar has-reset wh-putaway-actions">
            <RadzenButton class="wh02-clear-btn" Click="@Reset" Disabled="@IsBusy" Text="CLEAR" />
            <RadzenButton class="@($"pda-btn-pri wh02-receive-btn wh02-confirm-btn {(CanConfirm ? "ready" : "blocked")}")"
                          Click="@Confirm" Disabled="@IsBusy" Text="CONFIRM" />
        </div>
    </div>

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@(_modalKind == "success" ? "OK" : "!")</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions">
                    @if (_pendingRelocation is not null)
                    {
                        <RadzenButton class="wh-modal-btn secondary" Click="@CancelRelocation" Text="NO" />
                        <RadzenButton class="wh-modal-btn primary" Click="@AcceptRelocation" Text="RELOCATE" />
                    }
                    else
                    {
                        <RadzenButton class="wh-modal-btn primary" Click="@CloseModal" Text="OK" />
                    }
                </div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "lot")]
    public string? InitialLot { get; set; }

    private string _lastInitialLot = "";
    private PdaApi.FgPutAwayScanRow? _fgScan;
    private const string PptDeliveryNote = "PPT-WH-NOTE-PUTAWAY";
    private const string PptBox = "5011LL260908850001";
    private const string PptRelocationBox = "5011LL260908850004";
    private const string PptLocation = "MA06A1F1";
    private static readonly PptScenarioPanel.Step[] PptSteps =
    [
        new("Initial Screen", "Delivery Note, Case 또는 Box 바코드를 스캔하는 초기 화면을 확인합니다.",
            new PptScenarioPanel.Value("DELIVERY NOTE", PptDeliveryNote, "DOCUMENT"),
            new PptScenarioPanel.Value("LOT", PptBox, "BOX")),
        new("Delivery Note Boxes", "Delivery Note를 스캔해 박스 목록만 조회되고 선택되지 않는지 확인합니다.",
            new PptScenarioPanel.Value("DELIVERY NOTE", PptDeliveryNote, "DOCUMENT")),
        new("Box Scan", "BOX 바코드를 스캔해야 적재 대상으로 선택되는지 확인합니다.",
            new PptScenarioPanel.Value("BOX 1", PptBox, "BOX")),
        new("Location & Confirm", "Location 스캔 후 CONFIRM 활성화를 확인하고 Put-away를 완료합니다.",
            new PptScenarioPanel.Value("LOCATION", PptLocation, "LOCATION")),
        new("Relocation Check", "이미 적재된 LOT을 스캔해 Already Put Away와 RELOCATE 확인창을 검수합니다.",
            new PptScenarioPanel.Value("STORED LOT", PptRelocationBox, "RELOCATE"))
    ];

    private string _barcode = "";
    private string _locationNo = "";
    private string _selectionType = "";
    private string _message = "";
    private string _messageClass = "dim";
    private bool _isScanning;
    private bool _isLocationScanning;
    private bool _isConfirming;
    private bool _modalOpen;
    private bool _pptOpen;
    private bool _pptReady;
    private string _modalTitle = "";
    private string _modalMessage = "";
    private string _modalKind = "warn";
    private bool _isRelocating;
    private PdaApi.PutAwaySelectionResult? _pendingRelocation;
    private DotNetObjectReference<WhPutAway>? _scannerRef;
    private PdaApi.LocationRow? _location;
    private List<PdaApi.PutAwayRow> _boxes = [];
    private HashSet<string> _selectedBarcodes = new(StringComparer.OrdinalIgnoreCase);
    private List<PdaApi.PutAwayRow> PendingBoxes => _boxes.Where(box => string.IsNullOrWhiteSpace(box.LocationNo)).ToList();
    private List<PdaApi.PutAwayRow> StoredBoxes => _boxes.Where(box => !string.IsNullOrWhiteSpace(box.LocationNo)).ToList();

    private bool IsBusy => _isScanning || _isLocationScanning || _isConfirming;
    private bool IsPptTestMode => PdaScenarioUsers.IsSimple(Auth.Session?.EmployeeNo);
    private decimal SelectedQty => _boxes.Where(box => IsSelected(box.Barcode)).Sum(box => box.Qty);
    private bool CanScanLocation => _selectionType != "DELIVERY_NOTE" && _selectedBarcodes.Count > 0
        && (_fgScan is null || (_fgScan.IsProductionCompleted && !_fgScan.AlreadyStocked && _fgScan.Qty > 0));
    private bool CanConfirm => !IsBusy && CanScanLocation && _location is not null
        && string.Equals(_location.LocationId, _locationNo.Trim(), StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        var lot = Normalize(InitialLot);
        if (lot.Length > 0 && !string.Equals(lot, _lastInitialLot, StringComparison.OrdinalIgnoreCase))
        {
            _lastInitialLot = lot;
            _barcode = lot;
            await ScanItem();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
            _scannerRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = MauiProgram.IsDeveloperMode });
        }

        if (!_modalOpen && !_pptOpen && !IsBusy)
            await JS.InvokeVoidAsync("pdaScan.focus", CanScanLocation
                ? ".wh-putaway-location-input" : ".wh-putaway-item-input");
    }

    private async Task EnsurePptData()
    {
        if (_pptReady) return;
        await Api.WhResetPptTestAsync("putaway");
        _pptReady = true;
    }

    private async Task ResetPptData()
    {
        if (!IsPptTestMode || IsBusy) return;
        await Api.WhResetPptTestAsync("putaway");
        _pptReady = true;
        Reset();
        ShowAlert("Test Data Ready", "미적재 LOT 3개와 재적재 확인 LOT 1개를 초기화했습니다.", "success");
    }

    private async Task LoadPptDocument()
    {
        Reset();
        _barcode = PptDeliveryNote;
        await ScanItem();
    }

    private async Task StartPptStep(int step)
    {
        if (!IsPptTestMode || IsBusy) return;
        await EnsurePptData();
        if (step == 1) { Reset(); return; }
        if (step == 5)
        {
            Reset();
            _barcode = PptRelocationBox;
            await ScanItem();
            return;
        }
        if (step >= 3)
        {
            Reset();
            _barcode = PptBox;
            await ScanItem();
        }
        else await LoadPptDocument();
        if (step >= 4 && !_modalOpen)
        {
            _locationNo = PptLocation;
            await ScanLocation();
        }
    }

    private async Task RunPptValue(string command)
    {
        if (!IsPptTestMode || IsBusy) return;
        await EnsurePptData();
        if (command == "DOCUMENT") { await LoadPptDocument(); return; }
        if (command == "BOX")
        {
            Reset();
            _barcode = PptBox;
            await ScanItem();
            return;
        }
        if (command == "RELOCATE")
        {
            Reset();
            _barcode = PptRelocationBox;
            await ScanItem();
            return;
        }
        Reset();
        _barcode = PptBox;
        await ScanItem();
        if (!_modalOpen)
        {
            _locationNo = PptLocation;
            await ScanLocation();
        }
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        var value = Normalize(scanText);
        if (string.IsNullOrWhiteSpace(value) || IsBusy || _modalOpen) return;
        await InvokeAsync(async () =>
        {
            if (_selectionType == "CASE" && _boxes.Any(box =>
                    string.Equals(box.Barcode, value, StringComparison.OrdinalIgnoreCase)))
            {
                await ScanCaseBox(value);
            }
            else if (_selectionType == "DELIVERY_NOTE" || _boxes.Count == 0 || (_fgScan is not null && !CanScanLocation))
            {
                _barcode = value;
                await ScanItem();
            }
            else if (CanScanLocation)
            {
                _locationNo = value;
                await ScanLocation();
            }
            else ShowAlert("Box Scan Required", "Scan a pending box barcode in this case.");
            StateHasChanged();
        });
    }

    private void OnNativeBarcodeScanned(string barcode) => _ = InvokeAsync(() => OnHardwareScanAsync(barcode));

    private async Task OnBarcodeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ScanItem();
    }

    private void OnBarcodeInput(ChangeEventArgs e) => _barcode = e.Value?.ToString() ?? "";

    private async Task OnLocationKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ScanLocation();
    }

    private void OnLocationInput(ChangeEventArgs e)
    {
        _locationNo = e.Value?.ToString() ?? "";
        if (!string.Equals(_location?.LocationId, _locationNo.Trim(), StringComparison.OrdinalIgnoreCase))
            _location = null;
    }

    private async Task ScanItem()
    {
        if (IsBusy || string.IsNullOrWhiteSpace(_barcode)) return;
        _isScanning = true;
        ClearLoadedSelection();
        _message = "Loading received inventory...";
        _messageClass = "dim";
        try
        {
            var selection = await Api.WhPutAwayScanAsync(_barcode);
            if (selection.FinishedGoods is { } fg)
            {
                LoadFinishedGoods(fg);
                return;
            }
            if (selection.RequiresRelocation)
            {
                _pendingRelocation = selection;
                var target = selection.SelectionType == "CASE" ? "Case" : selection.SelectionType == "DELIVERY_NOTE" ? "Delivery Note" : "Box";
                var locations = string.Join(", ", selection.Boxes
                    .Select(box => box.LocationNo)
                    .Where(location => !string.IsNullOrWhiteSpace(location))
                    .Distinct(StringComparer.OrdinalIgnoreCase));
                ShowAlert("Already Put Away",
                    $"This {target} is already put away{(locations.Length == 0 ? "" : $" at {locations}")}. Do you want to relocate it?");
                return;
            }
            LoadSelection(selection, false);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageClass = "fail";
            ShowAlert("Barcode Scan Failed", ex.Message);
        }
        finally { _isScanning = false; }
    }

    private async Task ScanCaseBox(string? barcode)
    {
        var value = Normalize(barcode);
        if (IsBusy || _selectionType != "CASE" || value.Length == 0) return;
        if (!_boxes.Any(box => string.Equals(box.Barcode, value, StringComparison.OrdinalIgnoreCase)))
        {
            ShowAlert("Box Not In Case", "This box does not belong to the scanned case.");
            return;
        }

        _isScanning = true;
        try
        {
            var result = await Api.WhPutAwayScanAsync(value);
            var box = result.Boxes.SingleOrDefault();
            if (result.SelectionType != "BOX" || box is null ||
                !_boxes.Any(item => string.Equals(item.Barcode, box.Barcode, StringComparison.OrdinalIgnoreCase)))
                throw new InvalidOperationException("This box does not belong to the scanned case.");
            if (!string.IsNullOrWhiteSpace(box.LocationNo))
            {
                _boxes = _boxes.Select(item => string.Equals(item.Barcode, box.Barcode, StringComparison.OrdinalIgnoreCase)
                    ? box : item).ToList();
                ShowAlert("Already Put Away", $"Box {box.Barcode} is already at {box.LocationNo}.");
                return;
            }
            _selectedBarcodes.Add(box.Barcode);
            ClearLocationIfCapacityExceeded();
            SetSelectionMessage();
        }
        catch (Exception ex) { ShowAlert("Box Scan Failed", ex.Message); }
        finally { _isScanning = false; }
    }

    private bool IsSelected(string barcode) => _selectedBarcodes.Contains(barcode);

    private void SetSelectionMessage()
    {
        _message = _selectedBarcodes.Count == 0
            ? "No pending boxes."
            : _location is not null
                ? $"{_selectedBarcodes.Count} box(es) ready. Tap Confirm."
                : $"{_selectedBarcodes.Count} of {PendingBoxes.Count} pending box(es) scanned. Scan a location.";
        _messageClass = _selectedBarcodes.Count == 0 ? "fail" : "ok";
    }

    private void ClearLocationIfCapacityExceeded()
    {
        if (_location?.Capacity is > 0 && _location.TotalQty + SelectedQty > _location.Capacity.Value)
        {
            _location = null;
            _locationNo = "";
        }
    }

    private async Task ScanLocation()
    {
        if (_boxes.Count == 0 || IsBusy || string.IsNullOrWhiteSpace(_locationNo)) return;
        if (_selectedBarcodes.Count == 0)
        {
            ShowAlert("Set Location Check", "Scan at least one box barcode.");
            return;
        }

        _isLocationScanning = true;
        _location = null;
        _message = "Loading location...";
        _messageClass = "dim";
        try
        {
            if (_fgScan is { } fg)
            {
                if (!CanScanLocation)
                    throw new InvalidOperationException(fg.Message);
                var fgLocation = await FgApi.FgValidatePutAwayLocationAsync(_locationNo.Trim(), fg.ItemNo, fg.CustomerCode, fg.Qty, "LOCATION");
                if (fgLocation is not { IsValid: true })
                    throw new InvalidOperationException(fgLocation?.Message ?? "FG location was not found.");
                _location = new PdaApi.LocationRow(fgLocation.LocationId, fgLocation.LocationName, null, 0, fgLocation.CurrentQty,
                    AreaCode: fgLocation.AreaCode, X: fgLocation.Aisle, Y: fgLocation.Bay, Z: fgLocation.Slot,
                    LocationType: "FG", Capacity: fgLocation.Capacity);
                _locationNo = fgLocation.LocationId;
                _message = $"{_boxes.Count} ASSY LOT(s) ready. Tap Confirm.";
                _messageClass = "ok";
                return;
            }
            var location = await Api.WhScanLocationAsync(_locationNo);
            if (location is null)
                throw new InvalidOperationException("Location was not found.");
            if (string.Equals(location.LocationType, "FG", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("Only ASSY finished goods can be assigned an FG location.");
            if (location.LocationType is { } type
                && (type.Equals("BLOCKED", StringComparison.OrdinalIgnoreCase)
                    || type.Equals("HOLD", StringComparison.OrdinalIgnoreCase)
                    || type.Equals("QUARANTINE", StringComparison.OrdinalIgnoreCase)
                    || type.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase)))
                throw new InvalidOperationException($"Location {location.LocationId} is blocked.");
            if (location.Capacity is > 0 && location.TotalQty + SelectedQty > location.Capacity.Value)
                throw new InvalidOperationException($"Location {location.LocationId} capacity would be exceeded.");
            _location = location;
            _locationNo = location.LocationId;
            _message = $"{_selectedBarcodes.Count} box(es) ready. Tap Confirm.";
            _messageClass = "ok";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageClass = "fail";
            ShowAlert("Location Scan Failed", ex.Message);
        }
        finally { _isLocationScanning = false; }
    }

    private async Task Confirm()
    {
        if (!CanConfirm || _location is null)
        {
            var message = _fgScan is { } fg && !CanScanLocation
                ? fg.Message
                : _boxes.Count == 0
                ? "Scan a Shipping Unit, Unit Item or LOT first."
                : _selectedBarcodes.Count == 0
                    ? "Scan at least one box barcode."
                    : "Scan a valid location first.";
            ShowAlert("Set Location Check", message);
            return;
        }

        _isConfirming = true;
        try
        {
            if (_fgScan is { } fg)
            {
                var fgResult = await FgApi.FgConfirmPutAwayAsync(new PdaApi.FgPutAwayConfirmReq(
                    fg.LotNo, _location.LocationId, fg.Items?.ToDictionary(item => item.LotNo, item => item.Qty)));
                if (!fgResult.Success)
                {
                    ShowAlert("Set Location Failed", fgResult.Message);
                    return;
                }
                Reset();
                ShowAlert("Location Saved", "ASSY stock was assigned successfully.", "success");
                return;
            }
            var selected = _boxes
                .Where(box => IsSelected(box.Barcode))
                .Select(box => box.Barcode)
                .ToList();
            var result = await Api.WhConfirmPutAwayAsync(new PdaApi.PutAwayConfirmReq(selected, _location.LocationId, _isRelocating));
            if (!result.Success)
            {
                ShowAlert("Set Location Failed", result.Message);
                return;
            }

            var completedCount = selected.Count;
            var wasRelocating = _isRelocating;
            Reset();
            ShowAlert(wasRelocating ? "Relocation Complete" : "Location Saved",
                $"{completedCount} box(es) were {(wasRelocating ? "relocated" : "assigned")} successfully.", "success");
        }
        finally { _isConfirming = false; }
    }

    private void ClearLoadedSelection()
    {
        _fgScan = null;
        _selectionType = "";
        _boxes = [];
        _selectedBarcodes.Clear();
        _location = null;
        _locationNo = "";
        _isRelocating = false;
    }

    private void Reset()
    {
        _barcode = "";
        ClearLoadedSelection();
        _message = "";
        _messageClass = "dim";
    }

    private void ShowAlert(string title, string message, string kind = "warn")
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalOpen = true;
    }

    private void LoadSelection(PdaApi.PutAwaySelectionResult selection, bool relocating)
    {
        _selectionType = selection.SelectionType;
        _boxes = selection.Boxes;
        _selectedBarcodes = selection.SelectedBarcodes.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _isRelocating = relocating;
        _message = selection.SelectionType == "DELIVERY_NOTE"
            ? "Delivery Note is view only. Scan a Case or Box barcode to put away."
            : selection.SelectionType == "CASE"
                ? $"{PendingBoxes.Count} pending box(es) selected. Scan a location to put away."
                : "Box scanned. Scan a location.";
        _messageClass = selection.SelectionType == "DELIVERY_NOTE" ? "dim" : "ok";
    }

    private void LoadFinishedGoods(PdaApi.FgPutAwayScanRow fg)
    {
        _fgScan = fg;
        _barcode = fg.LotNo;
        _selectionType = "FG";
        _boxes = (fg.Items ?? [fg]).Select(item => new PdaApi.PutAwayRow(
            "FG", item.LotNo, item.LotNo, item.ItemNo, item.ItemName, item.Qty, item.Unit,
            null, item.ReadyAt, item.ExistingLocation)).ToList();
        _selectedBarcodes = _boxes.Select(item => item.Barcode).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _message = fg.Message;
        _messageClass = CanScanLocation ? "ok" : "fail";
        if (!CanScanLocation)
            ShowAlert("Set Location Blocked", fg.Message);
    }

    private void AcceptRelocation()
    {
        if (_pendingRelocation is not { } selection) return;
        _pendingRelocation = null;
        _modalOpen = false;
        LoadSelection(selection, true);
    }

    private void CancelRelocation()
    {
        _pendingRelocation = null;
        _modalOpen = false;
        Reset();
    }

    private void CloseModal()
    {
        if (_pendingRelocation is not null) CancelRelocation();
        else _modalOpen = false;
    }
    private static string Normalize(string? value) => string.IsNullOrWhiteSpace(value)
        ? "" : value.Replace("\u0002", "").Replace("\u0003", "").Trim();
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string QtyText(decimal qty, string? unit) => $"{qty:N0} {Uom.Symbol(unit)}";

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
