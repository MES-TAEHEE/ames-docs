@page "/wh/picking-request"
@inject WarehouseApi Api
@inject PdaUomFormat Uom
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh07-shell picking-request-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Text="&lt;" Click='@(() => Nav.NavigateTo("/wh"))' Disabled="@_saving" />
        <span class="pda-tbar-brand">PICKING REQUEST</span>
    </div>
    <div class="pda-bd picking-request-body">
        @if (_loading)
        {
            <div class="pda-status" role="status">Loading request options...</div>
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
        }
        else if (_options is {} options)
        {
            <RadzenCard class="picking-request-form">
                <div class="pda-fld"><label>LINE LOCATION</label>
                    <RadzenTextBox Value="@_locationBarcode" @oninput="@(e=>_locationBarcode=e.Value?.ToString()??"")" @onkeydown="OnLocationKey"
                        Placeholder="Scan Barcode" class="pda-input wh07-input pda-scan-input pda-barcode-input request-location-scan" Disabled="@_saving" />
                </div>
                @if (!string.IsNullOrEmpty(_destination))
                {
                    <div class="pda-status dim">@_options.Destinations.First(p=>p.Code==_destination).Display</div>
                    <div class="pda-fld"><label>PART</label>
                        <RadzenTextBox Value="@_partBarcode" @oninput="@(e=>_partBarcode=e.Value?.ToString()??"")" @onkeydown="OnPartKey"
                            Placeholder="Scan Barcode" class="pda-input wh07-input pda-scan-input pda-barcode-input request-part-scan" Disabled="@_saving" />
                    </div>
                }
                @if (!string.IsNullOrEmpty(_part))
                {
                <div class="pda-status dim">@_options.Parts.First(p=>p.Code==_part).Display</div>
                <div class="pda-fld"><label>REQUEST QTY (@Uom.Symbol(Unit))</label>
                    <RadzenNumeric TValue="decimal" @bind-Value="_qty" Min="0.001m" Max="99999999999m" Step="0.001" Format="0.###" class="request-qty" Disabled="@_saving" />
                </div>
                }
            </RadzenCard>
        }
    </div>
    @if (_options is {} loaded)
    {
        <div class="wh02-action-bar picking-request-actions">
            <RadzenButton Text="@(_saving ? "CREATING..." : "CREATE REQUEST")" Click="Save"
                Disabled="@(_saving || _loading || _scanning || _error.Length>0 || _existingOrders.Count>0 || !loaded.CanCreate || string.IsNullOrWhiteSpace(_destination) || string.IsNullOrWhiteSpace(_part) || _qty<=0)" class="pda-btn-pri wh02-receive-btn wh02-confirm-btn" />
        </div>
    }
    @if (_error.Length>0)
    {
        <div class="wh-modal-backdrop" @onclick="DismissAlert">
            <RadzenCard class="wh-modal-card warn" role="alertdialog" aria-modal="true" aria-labelledby="request-alert-title" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">!</div>
                <div class="wh-modal-title" id="request-alert-title">@_alertTitle</div>
                <div class="wh-modal-message">@_error</div>
                <div class="wh-modal-actions"><RadzenButton class="wh-modal-btn primary" Click="DismissAlert" Text="OK" /></div>
            </RadzenCard>
        </div>
    }
    @if (_existingOrders.Count>0 && _pendingRequest is {} pending)
    {
        <div class="wh-modal-backdrop" @onclick="CancelAdditionalRequest">
            <RadzenCard class="wh-modal-card request-existing-dialog" role="dialog" aria-modal="true" aria-labelledby="request-existing-title" @onclick:stopPropagation="true">
                <div class="wh-modal-title" id="request-existing-title">Existing Picking Orders</div>
                <div class="wh-modal-message">Location: @pending.Destination<br />Part: @pending.PartNo</div>
                <div class="request-existing-orders">
                    @foreach(var order in _existingOrders)
                    {
                        <div class="request-existing-order">
                            <strong>@order.PickSlipNo · @order.Status</strong>
                            <span>Requested: @QtyUnit(order.RequestedQty,order.Unit)</span>
                            <span>Picked: @QtyUnit(order.PickedQty,order.Unit)</span>
                            <span>Remaining: @QtyUnit(order.RemainingQty,order.Unit)</span>
                        </div>
                    }
                </div>
                <div class="wh-modal-message">Create an additional request for @QtyUnit(pending.Qty,Unit)?</div>
                <div class="wh-modal-actions">
                    <RadzenButton class="wh-modal-btn secondary" Text="NO" Click="CancelAdditionalRequest" Disabled="@_saving" />
                    <RadzenButton class="wh-modal-btn primary" Text="YES" Click="ConfirmAdditionalRequest" Disabled="@_saving" />
                </div>
            </RadzenCard>
        </div>
    }
    @if (_created.Length>0)
    {
        <div class="wh-modal-backdrop">
            <RadzenCard class="wh-modal-card success" role="dialog" aria-modal="true" aria-labelledby="request-created-title">
                <div class="wh-modal-mark">✓</div>
                <div class="wh-modal-title" id="request-created-title">Request Created</div>
                <div class="wh-modal-message">@_created</div>
                <div class="wh-modal-actions"><RadzenButton class="wh-modal-btn primary" Text="OK" Click="DismissCreated" /></div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    PickingRequestOptionsDto? _options;
    bool _loading=true,_saving,_scanning;
    string _alertTitle="Picking Request Failed";
    string _destination="",_part="",_error="",_created="";
    decimal _qty=1;
    List<ExistingPickingRequestDto> _existingOrders=[];
    CreatePickingRequestDto? _pendingRequest;
    bool _focusScan=true,_disposed;
    string _locationBarcode="",_partBarcode="";
    DotNetObjectReference<WhPickingRequest>? _scannerRef;
    string Unit=>_options?.Parts.FirstOrDefault(p=>p.Code==_part)?.Unit??"EA";
    protected override Task OnInitializedAsync()=>Load();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            PdaBarcodeHub.Scanned+=OnNativeBarcodeScanned;
            _scannerRef=DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register",_scannerRef,new{minLength=3,developerMode=MauiProgram.IsDeveloperMode});
        }
        if(_focusScan && !_loading && _created.Length==0 && _error.Length==0)
        {
            _focusScan=false;
            try{await JS.InvokeVoidAsync("pdaScan.focus",string.IsNullOrEmpty(_destination)?".request-location-scan":".request-part-scan");}catch(JSException){}
        }
    }
    async Task OnLocationKey(KeyboardEventArgs e){if(e.Key=="Enter")await OnHardwareScanAsync(_locationBarcode);}
    async Task OnPartKey(KeyboardEventArgs e){if(e.Key=="Enter")await OnHardwareScanAsync(_partBarcode);}
    void OnNativeBarcodeScanned(string value)=>_ = InvokeAsync(()=>OnHardwareScanAsync(value));
    [JSInvokable]
    public Task OnHardwareScanAsync(string value)=>InvokeAsync(async ()=>
    {
        if(_disposed || _saving || _loading || _options is null || _created.Length>0 || _existingOrders.Count>0)return;
        if(_scanning || _error.Length>0)return;
        _scanning=true;
        try
        {
        var result=PickingRequestScan.Resolve(value,_options,_destination);
        if(result.Option is {} option)
        {
            if(result.Kind=="LOCATION")
            {
                _destination=option.Code;_locationBarcode=option.Code;
                _part="";_partBarcode="";_qty=1;_focusScan=true;
            }
            else{_part=option.Code;_partBarcode=option.Code;}
            _error="";
        }
        else
        {
            if(result.Kind=="LOCATION_REQUIRED")ShowAlert("Line Location Required","Scan a line location first.");
            else if(result.Kind=="AMBIGUOUS")ShowAlert("Barcode Configuration Error","This barcode is assigned to both a location and a part. Check the master data.");
            else
            {
                var lookup=await Api.WhInventoryScanAsync(value);
                if(lookup?.SearchKind=="LOCATION")ShowAlert("Invalid Line Location","This is not an active production-line detail location. Warehouse and FG locations cannot be used for Picking Request.");
                else ShowAlert("Scan Failed","Scan an active line detail location or part number barcode. LOT, Shipping Unit and unknown barcodes cannot be used here.");
            }
        }
        }
        catch(Exception ex){ShowAlert("Scan Failed",ex.Message);}
        finally{_scanning=false;StateHasChanged();}
    });
    async Task Load()
    {
        if(_saving)return;
        _loading=true;_error="";_options=null;
        try
        {
            _options=await Api.PickingRequestOptionsAsync();
            if(!_options.CanCreate)ShowAlert("Permission Required","You do not have permission to create Picking Requests.");
        }
        catch(Exception ex){ShowAlert("Unable to Load",ex.Message);}
        finally{_loading=false;}
    }
    async Task Save()
    {
        if(_saving || _loading || _options?.CanCreate!=true || _created.Length>0)return;
        if(_scanning || _error.Length>0)return;
        if(_existingOrders.Count>0 || string.IsNullOrWhiteSpace(_destination) || string.IsNullOrWhiteSpace(_part) || _qty<=0)return;
        _saving=true;_error="";
        try
        {
            _pendingRequest=new(_destination,_part,_qty);
            _existingOrders=await Api.ExistingPickingRequestsAsync(_pendingRequest.Destination,_pendingRequest.PartNo);
            if(_existingOrders.Count==0)await CreatePendingRequest(false);
        }
        catch(Exception ex){ShowAlert("Request Failed",ex.Message);_pendingRequest=null;}
        finally{_saving=false;}
    }
    async Task CreatePendingRequest(bool confirmed)
    {
        if(_pendingRequest is null)return;
        try
        {
            var result=await Api.CreatePickingRequestAsync(_pendingRequest with{ConfirmAdditional=confirmed});
            _created=result.PickSlipNo;_pendingRequest=null;_existingOrders.Clear();
            _part="";_partBarcode="";_qty=1;
        }
        catch(AMES.Contracts.Exceptions.PickingRequestExistsException ex){_existingOrders=ex.ExistingOrders.ToList();}
    }
    async Task ConfirmAdditionalRequest()
    {
        if(_saving || _pendingRequest is null || _existingOrders.Count==0)return;
        _saving=true;_error="";
        try{await CreatePendingRequest(true);}
        catch(Exception ex){ShowAlert("Request Failed",ex.Message);_pendingRequest=null;_existingOrders.Clear();}
        finally{_saving=false;}
    }
    void CancelAdditionalRequest(){if(_saving)return;_existingOrders.Clear();_pendingRequest=null;}
    void ShowAlert(string title,string message){_alertTitle=title;_error=message;}
    void DismissAlert(){_error="";_locationBarcode=_destination;_partBarcode=_part;_focusScan=true;}
    string QtyUnit(decimal qty,string unit)=>$"{qty:#,##0.###} {Uom.Symbol(unit)}";
    void DismissCreated(){_created="";_focusScan=true;}
    public async ValueTask DisposeAsync()
    {
        _disposed=true;PdaBarcodeHub.Scanned-=OnNativeBarcodeScanned;
        try{await JS.InvokeVoidAsync("pdaScan.unregister");}catch(JSException){}
        _scannerRef?.Dispose();
    }
}
