@page "/wh"
@inject AuthState Auth
@inject NavigationManager Nav

<div class="pda-shell wh">
    <div class="pda-tbar">
        <button class="pda-tbar-back" @onclick='@(() => Nav.NavigateTo("/home"))'>←</button>
        <span class="pda-tbar-brand">WAREHOUSE</span>
        <span class="pda-tbar-emp">@Auth.Session?.EmployeeNo</span>
    </div>
    <div class="pda-bd">
        <div class="pda-tile-grid">
            <button class="pda-tile sm" @onclick='@(() => Nav.NavigateTo("/wh/01"))'><div class="pda-tile-ic">📋</div><div class="pda-tile-cap">WH-01</div><div class="pda-tile-sub">Inbound Schedule</div></button>
            <button class="pda-tile sm" @onclick='@(() => Nav.NavigateTo("/wh/02"))'><div class="pda-tile-ic">📥</div><div class="pda-tile-cap">WH-02</div><div class="pda-tile-sub">PDA Inbound</div></button>
            <button class="pda-tile sm" @onclick='@(() => Nav.NavigateTo("/wh/03"))'><div class="pda-tile-ic">📊</div><div class="pda-tile-cap">WH-03</div><div class="pda-tile-sub">Inventory Status</div></button>
            <button class="pda-tile sm" @onclick='@(() => Nav.NavigateTo("/wh/04"))'><div class="pda-tile-ic">🗺️</div><div class="pda-tile-cap">WH-04</div><div class="pda-tile-sub">Location Map</div></button>
            <button class="pda-tile sm" @onclick='@(() => Nav.NavigateTo("/wh/05"))'><div class="pda-tile-ic">✏️</div><div class="pda-tile-cap">WH-05</div><div class="pda-tile-sub">Inventory Adjust</div></button>
            <button class="pda-tile sm" @onclick='@(() => Nav.NavigateTo("/wh/06"))'><div class="pda-tile-ic">📅</div><div class="pda-tile-cap">WH-06</div><div class="pda-tile-sub">Release Schedule</div></button>
            <button class="pda-tile sm" @onclick='@(() => Nav.NavigateTo("/wh/07"))'><div class="pda-tile-ic">📤</div><div class="pda-tile-cap">WH-07</div><div class="pda-tile-sub">PDA Release</div></button>
            <button class="pda-tile sm" @onclick='@(() => Nav.NavigateTo("/wh/08"))'><div class="pda-tile-ic">📜</div><div class="pda-tile-cap">WH-08</div><div class="pda-tile-sub">Transactions</div></button>
        </div>
    </div>
</div>
