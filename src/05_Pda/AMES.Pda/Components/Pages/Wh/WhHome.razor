@page "/wh"
@inject AuthState Auth
@inject NavigationManager Nav

<div class="pda-shell wh wh-home-shell">
    <div class="pda-tbar">
        <button class="pda-tbar-back" @onclick='@(() => Nav.NavigateTo("/home"))'>&lt;</button>
        <div class="wh-home-title">
            <span class="pda-tbar-brand">WAREHOUSE</span>
            <span>@Auth.Session?.EmployeeNo</span>
        </div>
    </div>
    <div class="pda-bd">
        <div class="wh-home-hero">
            <div>
                <span>WAREHOUSE MENU</span>
                <strong>Stock Movement</strong>
            </div>
            <em>@DateTime.Now.ToString("HH:mm")</em>
        </div>

        <div class="pda-tile-grid wh-home-grid">
            <button class="pda-tile sm wh-home-tile schedule" @onclick='@(() => Nav.NavigateTo("/wh/01"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="event_note" /></span>
                <div class="wh-home-tile-copy">
                    <div class="pda-tile-cap">Schedule</div>
                    <div class="pda-tile-sub">Inbound and release schedules</div>
                </div>
                <span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile inbound" @onclick='@(() => Nav.NavigateTo("/wh/02"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="qr_code_scanner" /></span>
                <div class="wh-home-tile-copy">
                    <div class="pda-tile-cap">Inbound</div>
                    <div class="pda-tile-sub">Receive inbound LOTs</div>
                </div>
                <span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile release" @onclick='@(() => Nav.NavigateTo("/wh/07"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="outbox" /></span>
                <div class="wh-home-tile-copy">
                    <div class="pda-tile-cap">Release</div>
                    <div class="pda-tile-sub">Pick release LOTs</div>
                </div>
                <span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile inventory" @onclick='@(() => Nav.NavigateTo("/wh/03"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="inventory_2" /></span>
                <div class="wh-home-tile-copy">
                    <div class="pda-tile-cap">Inventory</div>
                    <div class="pda-tile-sub">Search material stock</div>
                </div>
                <span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile adjust" @onclick='@(() => Nav.NavigateTo("/wh/03?tab=adjust"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="tune" /></span>
                <div class="wh-home-tile-copy">
                    <div class="pda-tile-cap">Adjust</div>
                    <div class="pda-tile-sub">Adjust quantity by LOT scan</div>
                </div>
                <span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile transactions" @onclick='@(() => Nav.NavigateTo("/wh/08"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="history" /></span>
                <div class="wh-home-tile-copy">
                    <div class="pda-tile-cap">Transactions</div>
                    <div class="pda-tile-sub">Inbound and stock history</div>
                </div>
                <span class="wh-home-tile-go">&gt;</span>
            </button>
        </div>
    </div>
</div>
