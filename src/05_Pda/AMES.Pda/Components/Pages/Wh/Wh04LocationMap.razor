@page "/wh/04"
@inject PdaApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh04-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/wh"))' Text="&lt;" />
        <div class="wh04-tbar-title">
            <span class="pda-tbar-brand">LOCATION SEARCH</span>
            <span class="wh04-last-updated">Last Updated @LastUpdatedText</span>
        </div>
        <RadzenButton class="wh04-tbar-refresh" Click="@LoadAsync" Disabled="@_loading" Text="REFRESH" />
    </div>

    <div class="pda-bd wh04-body">
        @if (_loading)
        {
            <div class="wh04-loading">
                <div class="wh04-spinner"></div>
                <strong>Loading location map</strong>
            </div>
        }
        else if (_locations.Count == 0)
        {
            <div class="pda-empty">
                <strong>No locations found.</strong>
                @if (!string.IsNullOrWhiteSpace(_loadMessage))
                {
                    <span>@_loadMessage</span>
                }
            </div>
        }
        else
        {
            <RadzenCard class="wh04-filter-card">
                <div class="@($"wh04-scan-panel {ScanPanelClass}")">
                    <div class="wh04-scan-field">
                        <label>LOCATION NO SCAN</label>
                        <RadzenTextBox class="wh04-scan-input pda-scan-input"
                                       Value="@_locationScan"
                                       @oninput="OnLocationScanInput"
                                       @onkeydown="OnLocationScanKey"
                                       Placeholder="Scan or enter location no" />
                    </div>
                    @if (ShowDeveloperScanButtons)
                    {
                        <RadzenButton class="wh04-scan-btn" Click="@ScanLocationAsync" Disabled="@DisableLocationScan" Text="SCAN" />
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_scanMessage))
                {
                    <div class="@($"wh04-scan-status {_scanMessageClass}")">@_scanMessage</div>
                }

                <div class="wh04-filter-row">
                    <div class="wh04-dd-field">
                        <label>AREA</label>
                        <RadzenDropDown TValue="string" class="wh04-select"
                                        Data="@AreaOptions"
                                        TextProperty="Text"
                                        ValueProperty="Key"
                                        Value="@_selectedAreaKey"
                                        Change="@OnAreaChanged" />
                    </div>
                    <div class="wh04-dd-field">
                        <label>LEVEL</label>
                        <RadzenDropDown TValue="string" class="wh04-select"
                                        Data="@LevelOptions"
                                        TextProperty="Text"
                                        ValueProperty="Key"
                                        Value="@_selectedLevelKey"
                                        Change="@OnLevelChanged" />
                    </div>
                </div>
                <div class="wh04-filter-row">
                    <div class="wh04-dd-field">
                        <label>COLUMN</label>
                        <RadzenDropDown TValue="string" class="wh04-select"
                                        Data="@ColumnOptions"
                                        TextProperty="Text"
                                        ValueProperty="Key"
                                        Value="@_selectedColumnKey"
                                        Change="@OnColumnChanged" />
                    </div>
                    <div class="wh04-dd-field">
                        <label>ROW</label>
                        <RadzenDropDown TValue="string" class="wh04-select"
                                        Data="@RowOptions"
                                        TextProperty="Text"
                                        ValueProperty="Key"
                                        Value="@_selectedRowKey"
                                        Change="@OnRowChanged" />
                    </div>
                </div>
            </RadzenCard>

            <RadzenCard class="wh04-match-card">
                <div class="wh04-items-head">
                    <span>Locations</span>
                    <strong>@MatchingLocations.Count.ToString("N0")</strong>
                </div>

                @if (MatchingLocations.Count == 0)
                {
                    <div class="wh04-item-empty">No locations match this position.</div>
                }
                else
                {
                    <div class="wh04-location-list">
                        @foreach (var location in MatchingLocations)
                        {
                            <button type="button" class="@LocationCardClass(location)" @onclick="@(() => SelectLocationAsync(location))">
                                <div class="wh04-location-main">
                                    <span>AREA</span>
                                    <strong>@AreaLocationText(location)</strong>
                                    <em>@ZoneText(location)</em>
                                </div>
                                <div class="wh04-location-qty">
                                    <span>QTY</span>
                                    <strong>@location.TotalQty.ToString("N0")</strong>
                                </div>
                            </button>
                        }
                    </div>

                    @if (_selectedLocation is not null)
                    {
                        <div class="wh04-location-items">
                            <div class="wh04-items-head">
                                <span>@_selectedLocation.LocationId Items</span>
                                <strong>@_items.Count.ToString("N0")</strong>
                            </div>

                            @if (_loadingItems)
                            {
                                <div class="wh04-item-empty">Loading items...</div>
                            }
                            else if (_items.Count == 0)
                            {
                                <div class="wh04-item-empty">No current stock in this location.</div>
                            }
                            else
                            {
                                <div class="wh04-item-list">
                                    @foreach (var item in _items)
                                    {
                                        <div class="wh04-item-row">
                                            <div>
                                                <span>ITEM</span>
                                                <strong>@Text(item.PartNo)</strong>
                                                <em>@Text(item.PartName)</em>
                                            </div>
                                            <div>
                                                <span>LOT</span>
                                                <strong>@Text(item.LotNo)</strong>
                                                <em>@WorkText(item.WorkDate, item.WorkTime)</em>
                                            </div>
                                            <div>
                                                <span>QTY</span>
                                                <strong>@QtyUnit(item.Qty, item.Unit)</strong>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </RadzenCard>
        }
    </div>
</div>

@code {
    private const string EmptyKey = "__EMPTY__";

    private List<PdaApi.LocationRow> _locations = new();
    private List<PdaApi.LocationMapItemRow> _items = new();
    private PdaApi.LocationRow? _selectedLocation;
    private string? _selectedAreaKey;
    private string? _selectedColumnKey;
    private string? _selectedRowKey;
    private string? _selectedLevelKey;
    private string _locationScan = "";
    private string? _loadMessage;
    private string? _scanMessage;
    private string _scanMessageClass = "dim";
    private bool _loading = true;
    private bool _loadingItems;
    private bool _scanningLocation;
    private DateTime? _lastUpdated;
    private DotNetObjectReference<Wh04LocationMap>? _scannerRef;

    private static bool ShowDeveloperScanButtons => MauiProgram.IsDeveloperMode;
    private static string ScanPanelClass => ShowDeveloperScanButtons ? "dev-scan-panel" : "hardware-scan-panel";
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
            _scannerRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = ShowDeveloperScanButtons });
        }

        await FocusScannerAsync();
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        var value = NormalizeHardwareScan(scanText);
        if (string.IsNullOrWhiteSpace(value))
            return;

        await InvokeAsync(async () =>
        {
            _locationScan = value;
            await ScanLocationAsync();
            StateHasChanged();
        });
    }

    private void OnNativeBarcodeScanned(string barcode)
    {
        _ = InvokeAsync(async () => await OnHardwareScanAsync(barcode));
    }

    private async Task FocusScannerAsync()
    {
        if (_loading)
            return;

        try
        {
            await JS.InvokeVoidAsync("pdaScan.focus", ".wh04-scan-input");
        }
        catch
        {
            // Ignore focus failures while the WebView is navigating.
        }
    }

    private static string NormalizeHardwareScan(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Replace("\u0002", "").Replace("\u0003", "").Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;

        try
        {
            await JS.InvokeVoidAsync("pdaScan.unregister");
        }
        catch
        {
            // Ignore dispose-time JS disconnects.
        }

        _scannerRef?.Dispose();
    }

    private IReadOnlyList<PdaApi.LocationRow> MapRows => _locations
        .Where(r => !string.IsNullOrWhiteSpace(r.AreaCode)
            && (!string.IsNullOrWhiteSpace(r.X) || !string.IsNullOrWhiteSpace(r.Y) || !string.IsNullOrWhiteSpace(r.Z)))
        .ToList();

    private IReadOnlyList<PdaApi.LocationRow> AreaRows => MapRows
        .Where(r => AreaKey(r) == _selectedAreaKey)
        .ToList();

    private IReadOnlyList<PdaApi.LocationRow> ColumnRows => AreaRows
        .Where(r => ColumnKey(r) == _selectedColumnKey)
        .ToList();

    private IReadOnlyList<PdaApi.LocationRow> RowRows => ColumnRows
        .Where(r => RowKey(r) == _selectedRowKey)
        .ToList();

    private IReadOnlyList<PdaApi.LocationRow> MatchingLocations => RowRows
        .Where(r => LevelKey(r) == _selectedLevelKey)
        .OrderBy(r => SortGroup(LevelKey(r)))
        .ThenBy(r => SortNumber(LevelKey(r)))
        .ThenBy(r => SortText(LevelKey(r)))
        .ThenBy(r => r.LocationId)
        .ToList();

    private IReadOnlyList<Option> AreaOptions => BuildOptions(MapRows, AreaKey, AreaLabel);
    private IReadOnlyList<Option> ColumnOptions => BuildOptions(AreaRows, ColumnKey, r => Text(r.X));
    private IReadOnlyList<Option> RowOptions => BuildOptions(ColumnRows, RowKey, r => Text(r.Y));
    private IReadOnlyList<Option> LevelOptions => BuildOptions(RowRows, LevelKey, r => Text(r.Z));

    private string LastUpdatedText => _lastUpdated?.ToString("HH:mm:ss") ?? "-";
    private bool DisableLocationScan => _scanningLocation || string.IsNullOrWhiteSpace(_locationScan);

    private async Task LoadAsync()
    {
        _loading = true;
        _loadMessage = null;
        _scanMessage = null;
        ClearSelectedLocation();

        try
        {
            _locations = await Api.WhLocationMapAsync();
            _lastUpdated = DateTime.Now;
            await SelectInitialAsync();
        }
        catch (Exception ex)
        {
            _locations = new();
            _loadMessage = $"Location data could not be loaded. {ShortError(ex.Message)}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectInitialAsync()
    {
        _selectedAreaKey = AreaOptions.FirstOrDefault()?.Key;
        _selectedColumnKey = ColumnOptions.FirstOrDefault()?.Key;
        _selectedRowKey = RowOptions.FirstOrDefault()?.Key;
        _selectedLevelKey = LevelOptions.FirstOrDefault()?.Key;
        _scanMessage = null;
        ClearSelectedLocation();
        await Task.CompletedTask;
    }

    private async Task OnLocationScanInput(ChangeEventArgs e)
    {
        _locationScan = e.Value?.ToString() ?? "";

        var locationNo = _locationScan.Trim();
        if (string.Equals(_selectedLocation?.LocationId, locationNo, StringComparison.OrdinalIgnoreCase))
            return;

        _scanMessage = null;
        ClearSelectedLocation();

        if (string.IsNullOrWhiteSpace(locationNo))
            return;

        var location = FindLocation(locationNo);
        if (location is not null)
        {
            await SelectScannedLocationAsync(location);
            _locationScan = location.LocationId;
            _scanMessage = $"Location {location.LocationId} loaded.";
            _scanMessageClass = "ok";
        }
    }

    private async Task OnLocationScanKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ScanLocationAsync();
    }

    private async Task ScanLocationAsync()
    {
        var locationNo = _locationScan.Trim();
        if (string.IsNullOrWhiteSpace(locationNo) || _scanningLocation)
            return;

        _scanningLocation = true;
        _scanMessage = "Scanning location...";
        _scanMessageClass = "dim";

        try
        {
            var location = FindLocation(locationNo) ?? await Api.WhScanLocationAsync(locationNo);
            if (location is null)
            {
                _scanMessage = "Location not found.";
                _scanMessageClass = "fail";
                ClearSelectedLocation();
                return;
            }

            EnsureLocationInMap(location);
            await SelectScannedLocationAsync(location);

            _locationScan = location.LocationId;
            _scanMessage = $"Location {location.LocationId} loaded.";
            _scanMessageClass = "ok";
        }
        catch (Exception ex)
        {
            _scanMessage = ex.Message;
            _scanMessageClass = "fail";
            ClearSelectedLocation();
        }
        finally
        {
            _scanningLocation = false;
        }
    }

    private async Task OnAreaChanged(object? value)
    {
        await SelectAreaAsync(Convert.ToString(value) ?? "");
    }

    private async Task OnColumnChanged(object? value)
    {
        await SelectColumnAsync(Convert.ToString(value) ?? "");
    }

    private async Task OnRowChanged(object? value)
    {
        await SelectRowAsync(Convert.ToString(value) ?? "");
    }

    private async Task OnLevelChanged(object? value)
    {
        await SelectLevelAsync(Convert.ToString(value) ?? "");
    }

    private async Task SelectAreaAsync(string key)
    {
        _selectedAreaKey = key;
        _selectedColumnKey = ColumnOptions.FirstOrDefault()?.Key;
        _selectedRowKey = RowOptions.FirstOrDefault()?.Key;
        _selectedLevelKey = LevelOptions.FirstOrDefault()?.Key;
        ClearSelectedLocation();
        await Task.CompletedTask;
    }

    private async Task SelectColumnAsync(string key)
    {
        _selectedColumnKey = key;
        _selectedRowKey = RowOptions.FirstOrDefault()?.Key;
        _selectedLevelKey = LevelOptions.FirstOrDefault()?.Key;
        ClearSelectedLocation();
        await Task.CompletedTask;
    }

    private async Task SelectRowAsync(string key)
    {
        _selectedRowKey = key;
        _selectedLevelKey = LevelOptions.FirstOrDefault()?.Key;
        ClearSelectedLocation();
        await Task.CompletedTask;
    }

    private async Task SelectLevelAsync(string key)
    {
        _selectedLevelKey = key;
        ClearSelectedLocation();
        await Task.CompletedTask;
    }

    private async Task SelectLocationAsync(PdaApi.LocationRow location)
    {
        _selectedLocation = location;
        _items.Clear();
        _loadingItems = true;

        try
        {
            _items = await Api.WhLocationMapItemsAsync(location.LocationId);
        }
        finally
        {
            _loadingItems = false;
        }
    }

    private void ClearSelectedLocation()
    {
        _selectedLocation = null;
        _items.Clear();
        _loadingItems = false;
    }

    private async Task SelectScannedLocationAsync(PdaApi.LocationRow location)
    {
        _selectedAreaKey = AreaKey(location);
        _selectedColumnKey = ColumnKey(location);
        _selectedRowKey = RowKey(location);
        _selectedLevelKey = LevelKey(location);

        var matchingLocation = MatchingLocations.FirstOrDefault(r =>
            string.Equals(r.LocationId, location.LocationId, StringComparison.OrdinalIgnoreCase)) ?? location;

        await SelectLocationAsync(matchingLocation);
    }

    private PdaApi.LocationRow? FindLocation(string locationNo)
    {
        return _locations.FirstOrDefault(r =>
            string.Equals(r.LocationId, locationNo, StringComparison.OrdinalIgnoreCase));
    }

    private void EnsureLocationInMap(PdaApi.LocationRow location)
    {
        if (FindLocation(location.LocationId) is not null)
            return;

        _locations.Add(location);
    }

    private static IReadOnlyList<Option> BuildOptions(
        IEnumerable<PdaApi.LocationRow> source,
        Func<PdaApi.LocationRow, string> keySelector,
        Func<PdaApi.LocationRow, string> labelSelector)
    {
        return source
            .GroupBy(keySelector)
            .Select(g => new Option(g.Key, labelSelector(g.First()), g.Count()))
            .OrderBy(o => SortGroup(o.Key))
            .ThenBy(o => SortNumber(o.Key))
            .ThenBy(o => SortText(o.Key))
            .ThenBy(o => o.Label)
            .ToList();
    }

    private static string AreaLocationText(PdaApi.LocationRow location)
    {
        return $"{Text(location.AreaCode)} / {location.LocationId}";
    }

    private static string ZoneText(PdaApi.LocationRow location)
    {
        return CompactCodeName(location.Zone, location.ZoneName);
    }

    private string LocationCardClass(PdaApi.LocationRow location)
    {
        var active = string.Equals(_selectedLocation?.LocationId, location.LocationId, StringComparison.OrdinalIgnoreCase);
        return active ? "wh04-location-row active" : "wh04-location-row";
    }

    private static string AreaKey(PdaApi.LocationRow row) => CleanKey(row.AreaCode);
    private static string ColumnKey(PdaApi.LocationRow row) => CleanKey(row.X);
    private static string RowKey(PdaApi.LocationRow row) => CleanKey(row.Y);
    private static string LevelKey(PdaApi.LocationRow row) => CleanKey(row.Z);

    private static string CleanKey(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? EmptyKey : value.Trim();
    }

    private static string AreaLabel(PdaApi.LocationRow row) => CodeName(row.AreaCode, row.AreaName, "No Area");

    private static string CodeName(string? code, string? name, string empty = "-")
    {
        if (string.IsNullOrWhiteSpace(code) && string.IsNullOrWhiteSpace(name))
            return empty;
        if (string.IsNullOrWhiteSpace(name))
            return code?.Trim() ?? empty;
        if (string.IsNullOrWhiteSpace(code))
            return name.Trim();
        return $"{code.Trim()} / {name.Trim()}";
    }

    private static string CompactCodeName(string? code, string? name, string empty = "-")
    {
        if (string.IsNullOrWhiteSpace(code) && string.IsNullOrWhiteSpace(name))
            return empty;
        if (string.IsNullOrWhiteSpace(name))
            return code?.Trim() ?? empty;
        if (string.IsNullOrWhiteSpace(code))
            return name.Trim();
        return $"{code.Trim()}/{name.Trim()}";
    }

    private static string Text(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value == EmptyKey)
            return "-";
        return value.Trim();
    }

    private static string ShortError(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        var text = value.Trim();
        return text.Length <= 120 ? text : text[..120] + "...";
    }

    private static string QtyUnit(decimal qty, string? unit)
    {
        var value = qty % 1 == 0 ? qty.ToString("N0") : qty.ToString("N3");
        return string.IsNullOrWhiteSpace(unit) ? value : $"{value} {unit.Trim()}";
    }

    private static string WorkText(string? workDate, string? workTime)
    {
        var date = Text(workDate);
        var time = Text(workTime);
        if (date == "-" && time == "-")
            return "-";
        if (date == "-")
            return time;
        if (time == "-")
            return date;
        return $"{date} {time}";
    }

    private static int SortGroup(string? value)
    {
        var v = value == EmptyKey ? "" : value?.Trim();
        if (string.IsNullOrWhiteSpace(v))
            return 3;
        if (int.TryParse(v, out _))
            return 0;
        if (v.Length == 1 && char.IsLetter(v[0]))
            return 1;
        return 2;
    }

    private static int SortNumber(string? value)
    {
        var v = value == EmptyKey ? "" : value?.Trim();
        return int.TryParse(v, out var number) ? number : int.MaxValue;
    }

    private static string SortText(string? value)
    {
        return value == EmptyKey ? "" : value?.Trim() ?? "";
    }

    private sealed record Option(string Key, string Label, int Count)
    {
        public string Text => Label;
    }
}
