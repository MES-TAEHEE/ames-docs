    private string _inventoryView = "Location";
    private string _locationQuery = "";
    private string _locationMsg = "No locations found.";
    private string _invMode = "LOCAL";
    private string _invBarcode = "";
    private string _invLocationNo = "";
    private string _invMsg = "";
    private string _invCls = "dim";
    private string _invAdjustReason = "";
    private bool _quantityPadOpen;
    private string _quantityPadDraft = "";
    private string _invAdjustNote = "";
    private decimal _invAdjustDelta;
    private PdaApi.AdjustmentLocation? _adjustLocation;
    private string? _adjustQuantityInput;
    private bool _adjustQuantityInvalid;
    private bool _isLoading;
    private bool _locationsLoading;
    private bool _locationModalOpen;
    private bool _isInventoryScanning;
    private bool _isInventoryLocationScanning;
    private bool _isInventoryAdjusting;
    private bool _isInventoryMoving;
    private bool _modalOpen;
    private bool _dateFilterOpen;
    private bool _testPanelOpen;
    private bool _simulateInventoryApiFailure;
    private int _testScenarioIndex;
    private bool _simulateAdjustApiFailure;
    private int _adjustTestScenarioIndex;
    private DateTime? _lastSyncAt;
    private string _modalTitle = "";
    private string _modalMessage = "";
    private string _modalKind = "info";
    private string _modalNavigateTo = "";
    private string _modalActionText = "";
    private List<PdaApi.InventoryRow> _rows = new();
    private List<PdaApi.InventoryLocationRow> _locationRows = new();
    private List<PdaApi.LocationRow> _inventoryLocations = new();
    private List<PdaApi.LocationMapItemRow> _locationItems = new();
    private HashSet<string>? _matchedLocationIds;
    private List<PdaApi.LotStatusRow> _lotStatuses = new();
    private PdaApi.InventoryRow? _locationItem;
    private PdaApi.LocationRow? _selectedInventoryLocation;
    private WarehouseBrowsePart? _selectedBrowsePart;
    private List<PdaApi.LotStatusRow> _browsePartLots = [];
    private WarehousePartSummary? _selectedLocationPart;
    private List<PdaApi.LocationMapItemRow> _selectedLocationLots = [];
