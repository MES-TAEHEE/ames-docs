    private static readonly bool ShowLocatingTab = false;
    private static bool ShowDeveloperScanButtons => MauiProgram.IsDeveloperMode;
    private static string ScanPanelClass => ShowDeveloperScanButtons ? "dev-scan-panel" : "hardware-scan-panel";

    private List<PdaApi.CodeOption> AdjustReasons = [];

    private string PageTitle => IsAdjustTab ? "Adjust" : "Inventory";
    private bool IsTestMode => !IsFinishedGoodsAdjust
        && PdaScenarioUsers.IsDetailed(Auth.Session?.EmployeeNo);
    private InventoryTestScenario CurrentTestScenario => InventoryTestScenarios[_testScenarioIndex];
    private AdjustTestScenario CurrentAdjustTestScenario => AdjustTestScenarios[_adjustTestScenarioIndex];
    private bool ShouldSimulateInventoryApiFailure => IsTestMode
        && CurrentTestScenario.No == 11
        && _simulateInventoryApiFailure;
    private bool ShouldSimulateAdjustApiFailure => IsTestMode
        && CurrentAdjustTestScenario.No == 20
        && _simulateAdjustApiFailure;
    private bool IsFinishedGoodsAdjust => string.Equals(
        Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/'),
        "/fg/adjust",
        StringComparison.OrdinalIgnoreCase);
    private string EmptyMessage => _rows.Count == 0 ? _msg : "No items in this status.";
    private DateTime? DateFrom => _dateFrom?.Date;
    private DateTime? DateTo => _dateTo?.Date;
    private bool HasDateFilter => DateFrom.HasValue || DateTo.HasValue;
    private bool IsSearchTab => string.Equals(_workTab, "Search", StringComparison.OrdinalIgnoreCase);
    private bool IsAdjustTab => string.Equals(_workTab, "Adjust", StringComparison.OrdinalIgnoreCase);
    private bool IsLocatingTab => string.Equals(_workTab, "Locating", StringComparison.OrdinalIgnoreCase);
    private bool IsInventoryStatusView => string.Equals(_inventoryView, "Status", StringComparison.OrdinalIgnoreCase);
    private bool IsInventoryLocationView => string.Equals(_inventoryView, "Location", StringComparison.OrdinalIgnoreCase);
    private bool IsInventoryPartView => string.Equals(_inventoryView, "Part", StringComparison.OrdinalIgnoreCase);
    private bool IsLotStatusView => string.Equals(_inventoryView, "Lot", StringComparison.OrdinalIgnoreCase);
    private bool InventoryBusy => _isInventoryScanning || _isInventoryLocationScanning || _isInventoryAdjusting || _isInventoryMoving;
    private bool InventoryAlreadyReceived => string.Equals(_invScan?.Yn, "N", StringComparison.OrdinalIgnoreCase);
    private bool DisableInventoryScan => InventoryBusy || string.IsNullOrWhiteSpace(_invBarcode);
    private bool DisableLocationInventoryScan => _isLoading || string.IsNullOrWhiteSpace(_locationQuery);
    private bool DisableInventoryLocationScan => !InventoryAlreadyReceived || InventoryBusy || string.IsNullOrWhiteSpace(_invLocationNo);
    private string? InventoryAdjustBlockedReason =>
        Auth.Session?.IsAdmin != true ? "Administrator access is required for quantity adjustment." :
        InventoryBusy ? "An operation is in progress. Please wait." :
        _invScan is null ? "Scan a location and select stock, or scan a LOT barcode first." :
        !InventoryAlreadyReceived ? "This LOT is not available for adjustment." :
        AdjustReasons.Count == 0 ? "Reason codes are unavailable. Reopen this screen to load them." :
        !AdjustReasons.Any(x => string.Equals(x.CodeValue, _invAdjustReason, StringComparison.OrdinalIgnoreCase)) ? "Select a reason code before saving." :
        _adjustQuantityInvalid || IsAdjustQtyBelowStock || InventoryAfterQty != decimal.Truncate(InventoryAfterQty) || InventoryAfterQty > 999999999 ? "Enter a whole number from 0 to 999999999." :
        _invAdjustDelta == 0 ? "Change the quantity before saving." : null;
    private bool DisableInventoryAdjust => InventoryAdjustBlockedReason is not null;
    private bool DisableInventoryMove => !InventoryAlreadyReceived || InventoryBusy || _invTargetLocation is null || InventoryTargetSameAsCurrent;
    private bool DisableAdjustQtyControls => !InventoryAlreadyReceived || InventoryBusy;
    private bool DisableAdjustQtyMinus => DisableAdjustQtyControls || _invAdjustDelta <= -InventoryBeforeQty;
    private bool DisableAdjustQtyPlus => DisableAdjustQtyControls || InventoryAfterQty >= 999999999m;
    private decimal InventoryBeforeQty => _invScan?.Qty ?? 0;
    private decimal InventoryAfterQty => InventoryBeforeQty + _invAdjustDelta;
    private string AdjustQuantityLabel => $"{InventoryAfterQty:#,##0.###} {Unit(_invScan?.Unit)} ({_invAdjustDelta:+#,##0.###;-#,##0.###;0})";
    private bool IsAdjustQtyBelowStock => _invAdjustDelta < -InventoryBeforeQty;
    private string InventoryBarcodePlaceholder => IsAdjustTab
        ? "Scan location or lot barcode"
        : _invMode == "CKD" ? "Scan CKD lot no" : "Scan local lot no";
    private string InventoryLotCardClass => InventoryAlreadyReceived ? "ready" : "blocked";
    private string InventoryStatusClass => InventoryAlreadyReceived ? "normal" : "below";
    private string InventoryStatusLabel => _invScan is null
        ? "-"
        : InventoryAlreadyReceived
            ? IsAdjustTab
                ? $"In Stock {Text(_invScan.ReceivedStatus)}"
                : $"Incoming {Text(_invScan.ReceivedStatus)}"
            : "Not Incoming";
    private string AdjustDeltaClass => _invAdjustDelta < 0 ? "minus" : _invAdjustDelta > 0 ? "plus" : "";
    private bool InventoryTargetSameAsCurrent
        => _invTargetLocation is not null && IsCurrentInventoryLocation(_invTargetLocation.LocationId);
    private string ModalMark => _modalKind switch
    {
        "danger" => "!",
        "warn" => "!",
        "success" => "OK",
        _ => "i"
    };

    private List<PdaApi.InventoryRow> VisibleRows
        => _statusFilter == "ALL"
            ? _rows
            : _rows.Where(row => string.Equals(StockStatus(row), _statusFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<WarehouseBrowsePart> BrowsePartRows => _rows
        .Where(row => row.OnHandQty > 0 && !string.IsNullOrWhiteSpace(row.LocationId))
        .GroupBy(row => new { PartNo = row.ItemNo, PartName = row.ItemName, Location = row.LocationId.Trim(), Unit = Unit(row.Unit) })
        .Select(group => new WarehouseBrowsePart(group.Key.PartNo, group.Key.PartName, group.Sum(row => row.OnHandQty), group.Key.Unit, group.Key.Location))
        .OrderBy(row => row.PartNo, StringComparer.OrdinalIgnoreCase)
        .ThenBy(row => row.Location, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<WarehousePartSummary> SelectedLocationParts => _locationItems
        .Where(row => row.Qty > 0 && !string.IsNullOrWhiteSpace(row.PartNo))
        .GroupBy(row => new { PartNo = row.PartNo!, row.PartName, Unit = Unit(row.Unit) })
        .Select(group => new WarehousePartSummary(group.Key.PartNo, group.Key.PartName, group.Sum(row => row.Qty), group.Key.Unit))
        .OrderBy(row => row.PartNo, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<PdaApi.LocationRow> VisibleInventoryLocations
    {
        get
        {
            var stockedLocations = _inventoryLocations
                .Where(location => location.TotalQty > 0 || location.LineCount > 0);
            if (_matchedLocationIds is null)
                return stockedLocations.ToList();

            return stockedLocations
                .Where(location => _matchedLocationIds.Contains(location.LocationId))
                .ToList();
        }
    }

