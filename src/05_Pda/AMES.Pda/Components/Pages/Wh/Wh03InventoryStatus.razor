            _invTargetLocation = null;
    }

    private async Task OnInventoryLotKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ScanInventoryLot();
    }

    private void StepInventoryAdjust(decimal delta)
    {
        if (DisableAdjustQtyControls)
            return;

        var next = _invAdjustDelta + delta;
        if (next < -InventoryBeforeQty)
            next = -InventoryBeforeQty;

        _invAdjustDelta = next;
    }

    private async Task OnInventoryLocationKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ScanInventoryLocation();
    }

    private async Task Load()
    {
        if (_isLoading) return;

        if (IsAdjustTab)
        {
            _isLoading = true;
            try
            {
                _invSupervisors = await Api.WhAdjustSupervisorsAsync();
            }
            catch
            {
                _invSupervisors = [];
                _invMsg = "Supervisor list is unavailable.";
                _invCls = "fail";
            }
            finally
            {
                _isLoading = false;
            }
            return;
        }

        if (IsSearchTab && IsInventoryLocationView)
        {
            if (string.IsNullOrWhiteSpace(_locationQuery))
                await LoadInventoryLocations();
            else
                await LoadLocationInventory();
            return;
        }

        if (IsSearchTab && IsLotStatusView)
        {
            await LoadLotStatuses();
            return;
        }

        _isLoading = true;
        try
        {
            _msg = "Loading...";

            if (HasInvalidDate)
            {
                _rows = new();
                _msg = "Date format must be YYYY-MM-DD.";
                return;
            }

            if (DateFrom.HasValue && DateTo.HasValue && DateFrom.Value > DateTo.Value)
            {
                _rows = new();
                _msg = "Date range is invalid.";
                return;
            }

            _rows = await Api.WhInventoryAsync(_q, DateFrom, DateTo);
            _lastSyncAt = DateTime.Now;
            if (!StockStatuses.Contains(_statusFilter, StringComparer.OrdinalIgnoreCase))
                _statusFilter = "ALL";

            if (_rows.Count == 0)
            {
                _msg = "No inventory matches.";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ScanInventoryFilter()
    {
        if (_isLoading) return;

        if (IsLotStatusView)
        {
            await LoadLotStatuses();
            return;
        }

        var scanText = _q.Trim();
        if (!string.IsNullOrWhiteSpace(scanText))
        {
            var lookup = await Api.WhInventoryScanAsync(scanText);
            if (lookup is not null && !string.IsNullOrWhiteSpace(lookup.SearchText))
                _q = lookup.SearchText.Trim();
        }

        await Load();
    }

    private async Task LoadLotStatuses()
    {
        if (_isLoading) return;

        _isLoading = true;
        try
        {
            _lotStatuses = await Api.WhLotStatusesAsync(_q);
            _lastSyncAt = DateTime.Now;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyDateFilter()
    {
        await Load();
        if (!HasInvalidDate && !(DateFrom.HasValue && DateTo.HasValue && DateFrom.Value > DateTo.Value))
            _dateFilterOpen = false;
    }

    private async Task ClearDateFilter()
    {
        _dateFrom = null;
        _dateTo = null;
        _dateFilterOpen = false;
        await Load();
    }

    private async Task LoadLocationInventory()
    {
        if (_isLoading) return;

        var scanText = _locationQuery.Trim();
        if (string.IsNullOrWhiteSpace(scanText))
        {
            _matchedLocationIds = null;
            await LoadInventoryLocations();
            return;
        }

        _isLoading = true;
        _locationMsg = "Searching inventory...";
        CloseLocationInventory();

        try
        {
            if (_inventoryLocations.Count == 0)
                _inventoryLocations = await Api.WhLocationsAsync();

            var lookup = await Api.WhInventoryScanAsync(scanText);
            var location = _inventoryLocations.FirstOrDefault(row =>
                string.Equals(row.LocationId, scanText, StringComparison.OrdinalIgnoreCase));
            if (location is null
                && string.Equals(lookup?.SearchKind, "LOCATION", StringComparison.OrdinalIgnoreCase))
            {
                var locationNo = string.IsNullOrWhiteSpace(lookup.SearchText) ? scanText : lookup.SearchText.Trim();
                location = _inventoryLocations.FirstOrDefault(row =>
                    string.Equals(row.LocationId, locationNo, StringComparison.OrdinalIgnoreCase));
                location ??= await Api.WhScanLocationAsync(locationNo);
            }

            if (location is not null)
            {
                if (_inventoryLocations.All(row => !string.Equals(row.LocationId, location.LocationId, StringComparison.OrdinalIgnoreCase)))
                    _inventoryLocations.Add(location);

                _matchedLocationIds = new(StringComparer.OrdinalIgnoreCase) { location.LocationId };
                _locationMsg = location.TotalQty > 0 || location.LineCount > 0
                    ? ""
                    : "No inventory exists in this location.";
                return;
            }

            var searchText = string.IsNullOrWhiteSpace(lookup?.SearchText) ? scanText : lookup.SearchText.Trim();
            var inventoryRows = await Api.WhInventoryAsync(searchText);
            var locationIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var row in inventoryRows)
            {
                var itemLocations = await Api.WhInventoryLocationsAsync(row.ItemNo);
                foreach (var itemLocation in itemLocations.Where(itemLocation => itemLocation.Qty > 0))
                    locationIds.Add(itemLocation.LocationId);

                if (itemLocations.Count == 0 && row.OnHandQty > 0 && !string.IsNullOrWhiteSpace(row.LocationId))
                    locationIds.Add(row.LocationId);
            }

            _matchedLocationIds = locationIds;
            _locationMsg = locationIds.Count == 0 ? "No inventory matches this barcode." : "";
        }
        catch (Exception ex)
        {
            _matchedLocationIds = new(StringComparer.OrdinalIgnoreCase);
            _locationMsg = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadInventoryLocations()
    {
        if (_isLoading) return;

        _isLoading = true;
        _locationMsg = "Loading locations...";

        try
        {
            _inventoryLocations = await Api.WhLocationsAsync();
            _locationMsg = _inventoryLocations.Count == 0 ? "No locations found." : "";
        }
        catch (Exception ex)
        {
            _inventoryLocations = new();
            _locationMsg = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenInventoryLocation(string locationNo)
    {
        if (_isLoading || string.IsNullOrWhiteSpace(locationNo)) return;

        _isLoading = true;
        _locationMsg = "Loading location inventory...";

        try
        {
            var location = await Api.WhScanLocationAsync(locationNo.Trim())
                ?? _inventoryLocations.FirstOrDefault(row =>
                    string.Equals(row.LocationId, locationNo.Trim(), StringComparison.OrdinalIgnoreCase));
            if (location is null)
            {
                _selectedInventoryLocation = null;
                _locationItems = new();
                _locationMsg = "Location No was not found.";
                return;
            }

            _selectedInventoryLocation = location;
            _locationItems = await Api.WhLocationMapItemsAsync(location.LocationId);
            _locationMsg = _locationItems.Count == 0
                ? "No inventory exists in this location."
                : "";
        }
        catch (Exception ex)
        {
            _selectedInventoryLocation = null;
            _locationItems = new();
            _locationMsg = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CloseLocationInventory()
    {
        _selectedInventoryLocation = null;
        _locationItems = new();
    }

    private void ClearInventoryWork()
    {
        _invBarcode = "";
        _invLocationNo = "";
        _invMsg = "";
        _invCls = "dim";
        _invScan = null;
        _inventoryCurrentLocation = null;
        _invTargetLocation = null;
        ResetInventoryAdjust();
    }

    private void ResetInventoryAdjust()
    {
        _invAdjustReason = "COUNT_DIFF";
        ClearSupervisorPin();
        _invAdjustSupervisorEmployeeNo = "";
        _invAdjustNote = "";
        _invAdjustDelta = 0;
    }

    private void ClearSupervisorPin()
    {
        _invAdjustSupervisorPin = "";
        CloseSupervisorPinPad();
    }

    private void OpenSupervisorPinPad()
    {
        if (!InventoryAlreadyReceived || InventoryBusy || string.IsNullOrWhiteSpace(_invAdjustSupervisorEmployeeNo))
            return;

        _pinPadDraft = _invAdjustSupervisorPin;
        _pinPadOpen = true;
    }

    private void OnSupervisorPinKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            OpenSupervisorPinPad();
    }

    private void PressSupervisorPin(string digit)
    {
        if (_pinPadOpen && _pinPadDraft.Length < 12 && digit.Length == 1 && digit[0] is >= '0' and <= '9')
            _pinPadDraft += digit;
    }

    private void DeleteSupervisorPin()
    {
        if (_pinPadDraft.Length > 0)
            _pinPadDraft = _pinPadDraft[..^1];
    }

    private void ConfirmSupervisorPin()
    {
        if (!_pinPadOpen || _pinPadDraft.Length < 4)
            return;

        _invAdjustSupervisorPin = _pinPadDraft;
        CloseSupervisorPinPad();
    }

    private void CloseSupervisorPinPad()
    {
        _pinPadOpen = false;
        _pinPadDraft = "";
    }

    private async Task ScanInventoryLot()
    {
        if (DisableInventoryScan) return;

        _isInventoryScanning = true;
        _invMsg = "Scanning Lot No...";
        _invCls = "dim";
        _invScan = null;
        _inventoryCurrentLocation = null;
        _invTargetLocation = null;
        _invLocationNo = "";
        ResetInventoryAdjust();

        try
        {
            var row = await ScanInventoryLotByModeAsync(_invBarcode.Trim());
            if (row is null)
            {
                _invMsg = IsAdjustTab
                    ? "The specified Lot No could not be found."
                    : "LOT No was not found in the PO list.";
                _invCls = "fail";
                return;
            }

            _invScan = row;
            _invBarcode = row.Barcode;

            if (IsAdjustTab && _invSupervisors.Count == 0)
                await Load();

            if (!IsAdjustTab && InventoryAlreadyReceived && !string.IsNullOrWhiteSpace(row.ReceivedLocation))
                _inventoryCurrentLocation = await Api.WhScanLocationAsync(row.ReceivedLocation);

            _invMsg = InventoryAlreadyReceived
                ? "Inventory LOT loaded."
                : "This LOT has not been received yet. Receive it before adjustment or locating.";
            _invCls = InventoryAlreadyReceived ? "ok" : "warn";
        }
        catch (Exception ex)
        {
            _invMsg = ex.Message;
            _invCls = "fail";
        }
        finally
        {
            _isInventoryScanning = false;
        }
    }

    private async Task<PdaApi.InboundScanRow?> ScanInventoryLotByModeAsync(string barcode)
    {
        if (!IsAdjustTab)
        {
            var row = await Api.WhScanInboundAsync(_invMode, barcode);
            ApplyDetectedMode(row);
            return row;
        }

        var adjustRow = await Api.WhScanAdjustAsync(barcode);
        ApplyDetectedMode(adjustRow);
        return adjustRow;
    }

    private void ApplyDetectedMode(PdaApi.InboundScanRow? row)
    {
        if (row is null || string.IsNullOrWhiteSpace(row.ReceiveType))
            return;

        _invMode = string.Equals(row.ReceiveType, "CKD", StringComparison.OrdinalIgnoreCase)
            ? "CKD"
            : "LOCAL";
    }

    private async Task ScanInventoryLocation()
    {
        if (DisableInventoryLocationScan) return;

        var locationNo = _invLocationNo.Trim();
        if (IsCurrentInventoryLocation(locationNo))
        {
            _invTargetLocation = null;
            _invMsg = "This LOT is already in the selected location.";
            _invCls = "fail";
            return;
        }

        _isInventoryLocationScanning = true;
        _invMsg = "Scanning location...";
        _invCls = "dim";

        try
        {
            var location = await Api.WhScanLocationAsync(locationNo);
            if (location is null)
            {
                _invTargetLocation = null;
                _invMsg = "Location No was not found.";
                _invCls = "fail";
                return;
            }

            if (IsCurrentInventoryLocation(location.LocationId))
            {
                _invTargetLocation = null;
                _invLocationNo = location.LocationId;
                _invMsg = "This LOT is already in the selected location.";
                _invCls = "fail";
                return;
            }

            _invTargetLocation = location;
            _invLocationNo = location.LocationId;
            _invMsg = "New location loaded. Confirm the move.";
            _invCls = "ok";
        }
        catch (Exception ex)
        {
            _invTargetLocation = null;
            _invMsg = ex.Message;
            _invCls = "fail";
        }
        finally
        {
            _isInventoryLocationScanning = false;
        }
    }

    private async Task PostInventoryAdjust()
    {
        if (InventoryBusy) return;

        if (_invScan is null)
        {
            ShowAlert("Scan Required", "Scan a Lot No first.", "warn");
            return;
        }

        if (!InventoryAlreadyReceived)
        {
            ShowAlert("Incoming Required", "This LOT has not been received yet.", "warn");
            return;
        }

        if (_invAdjustDelta == 0)
        {
            ShowAlert("No Changes", "Enter an adjustment quantity before saving.", "warn");
            return;
        }

        if (IsAdjustQtyBelowStock)
        {
            ShowAlert("Invalid Quantity", "Adjustment Qty cannot be less than the current stock quantity.", "warn");
            return;
        }

        if (string.IsNullOrWhiteSpace(_invAdjustReason))
        {
            ShowAlert("Reason Required", "Select a reason code.", "warn");
            return;
        }

        if (string.IsNullOrWhiteSpace(_invAdjustSupervisorEmployeeNo))
        {
            ShowAlert("Supervisor Required", "Select a supervisor.", "warn");
            return;
        }

        if (_invAdjustSupervisorPin.Trim().Length < 4)
        {
            ShowAlert("Supervisor Required", "Supervisor PIN must be at least 4 digits.", "warn");
            return;
        }

        var deltaQty = _invAdjustDelta;

        _isInventoryAdjusting = true;
        _invMsg = "Posting adjustment...";
        _invCls = "dim";

        try
        {
            var result = await Api.WhSaveAdjustQtyAsync(new PdaApi.AdjustSaveReq(
                _invMode,
                _invScan.Barcode,
                deltaQty,
                _invAdjustReason,
                _invAdjustNote,
                _invAdjustSupervisorPin,
                _invAdjustSupervisorEmployeeNo));

            if (!result.Success)
            {
                _invMsg = result.Message;
                _invCls = "fail";
                return;
            }

            ClearInventoryWork();
            ShowAlert("Saved", "Inventory adjustment was saved.", "success");
        }
        catch (Exception ex)
        {
            _invMsg = ex.Message;
            _invCls = "fail";
        }
        finally
        {
            _isInventoryAdjusting = false;
        }
    }

    private void ShowAlert(string title, string message, string kind = "info")
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalOpen = true;
    }

    private void DismissModal()
    {
        _modalOpen = false;
    }

    private async Task ConfirmInventoryMove()
    {
        if (DisableInventoryMove || _invScan is null || _invTargetLocation is null) return;

        var fromLocation = Text(_invScan.ReceivedLocation);
        var toLocation = _invTargetLocation.LocationId;

        _isInventoryMoving = true;
        _invMsg = "Changing location...";
        _invCls = "dim";

        try
        {
            var result = await Api.WhMoveInboundLocationAsync(new PdaApi.InboundReceiveReq(_invMode, _invScan.Barcode, toLocation));
            if (!result.Success)
            {
                _invMsg = result.Message;
                _invCls = "fail";
                return;
            }

            _invScan = result.Row ?? await Api.WhScanInboundAsync(_invMode, _invScan.Barcode);
            _inventoryCurrentLocation = await Api.WhScanLocationAsync(toLocation);
            _invTargetLocation = null;
            _invLocationNo = "";
            _invMsg = $"Location changed. {fromLocation} -> {toLocation}";
            _invCls = "ok";
            await Load();
        }
        catch (Exception ex)
        {
            _invMsg = ex.Message;
            _invCls = "fail";
        }
        finally
        {
            _isInventoryMoving = false;
        }
    }

    private void SetFilter(string status)
    {
        _statusFilter = status;
    }

    private async Task OpenLocations(PdaApi.InventoryRow row)
    {
        _locationItem = row;
        _locationRows = new();
        _locationModalOpen = true;
        _locationsLoading = true;

        try
        {
            _locationRows = await Api.WhInventoryLocationsAsync(row.ItemNo, DateFrom, DateTo);
        }
        finally
        {
            _locationsLoading = false;
        }
    }

    private void CloseLocations()
    {
        _locationModalOpen = false;
        _locationsLoading = false;
        _locationRows = new();
        _locationItem = null;
    }

    private int CountStatus(string status)
        => _rows.Count(row => string.Equals(StockStatus(row), status, StringComparison.OrdinalIgnoreCase));

    private string SummaryClass(string status)
        => $"wh03-stat {StatusClass(status)} {(string.Equals(_statusFilter, status, StringComparison.OrdinalIgnoreCase) ? "on" : "")}";

    private bool IsCurrentInventoryLocation(string? locationId)
    {
        if (string.IsNullOrWhiteSpace(locationId)) return false;

        var current = _invScan?.ReceivedLocation;
        return !string.IsNullOrWhiteSpace(current)
            && string.Equals(locationId.Trim(), current.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<(string Label, string Value)> InventoryLotFields()
    {
        if (_invScan is null) yield break;

        yield return ("Qty", Qty(_invScan.Qty, _invScan.Unit));
        yield return ("PO No", Text(_invScan.PoNo));
        yield return ("PO Seq", _invScan.PoSeq?.ToString() ?? "-");
        yield return ("Vendor", Text(_invScan.VendorName ?? _invScan.VendorId));
        yield return ("Current Loc", Text(_invScan.ReceivedLocation));
    }

    private IEnumerable<(string Label, string Value)> InventoryDetailFields(PdaApi.InventoryRow row)
    {
        yield return ("Part No", Text(row.ItemNo));
        yield return ("Status", StatusText(row));
        yield return ("Stock Qty", Qty(row.OnHandQty, row.Unit));
        yield return ("Locations", Text(row.LocationId));
        yield return ("Car Type", Text(row.CarCode));
        yield return ("Min Qty", Qty(row.MinQty, row.Unit));
        yield return ("Max Qty", Qty(row.MaxQty, row.Unit));
    }

    private static IEnumerable<(string Label, string Value)> LocationFieldsFor(PdaApi.LocationRow location)
    {
        yield return ("WH", CodeName(location.WarehouseCode, location.WarehouseName));
        yield return ("Area", CodeName(location.AreaCode, location.AreaName));
        yield return ("Zone", CodeName(location.Zone, location.ZoneName));
        yield return ("Rack", Rack(location.X, location.Y, location.Z));
    }

    private static string LocationPath(PdaApi.LocationRow location)
        => string.Join(" / ", new[] { location.WarehouseCode, location.AreaCode, location.Zone }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    private static readonly string[] StockStatuses = ["ALL", "OUT", "BELOW_MIN", "OVER_MAX", "NORMAL"];

    private static string StockStatus(PdaApi.InventoryRow row)
    {
        if (row.OnHandQty <= 0)
            return "OUT";

        if (row.MinQty.HasValue && row.MinQty.Value > 0 && row.OnHandQty < row.MinQty.Value)
            return "BELOW_MIN";

        if (row.MaxQty.HasValue && row.MaxQty.Value > 0 && row.OnHandQty > row.MaxQty.Value)
            return "OVER_MAX";

        return "NORMAL";
    }

    private static string StatusText(PdaApi.InventoryRow row)
        => StatusText(StockStatus(row));

    private static string StatusText(string? status)
        => (status ?? "").ToUpperInvariant() switch
        {
            "OUT" => "Out",
            "BELOW_MIN" => "Below Min",
            "OVER_MAX" => "Over Max",
            "NORMAL" => "Normal",
            _ => "Normal"
        };

    private static string StatusClass(PdaApi.InventoryRow row) => StatusClass(StockStatus(row));

    private static string StatusClass(string? status)
        => (status ?? "").ToUpperInvariant() switch
        {
            "ALL" => "all",
            "OUT" => "out",
            "BELOW_MIN" => "below",
            "OVER_MAX" => "over",
            "NORMAL" => "normal",
            _ => "normal"
        };

    private static string LotStatusLabel(string? status)
        => (status ?? "CREATED").Replace('_', ' ');

    private static string LotStatusClass(string? status)
        => (status ?? "").ToUpperInvariant() switch
        {
            "RECEIVED" or "STORED" or "RETURN_RECEIVED" or "RELEASE_CANCELLED" => "normal",
            "CREATED" => "below",
            "RELEASED" or "RECEIPT_CANCELLED" => "all",
            "DEFECTIVE" or "DISPOSED" => "out",
            _ => "all"
        };

    private static bool Contains(string? value, string query)
        => !string.IsNullOrWhiteSpace(value)
           && value.Contains(query, StringComparison.OrdinalIgnoreCase);

    private static string Text(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "-";

        return value.Trim();
    }

    private static string LotText(PdaApi.InventoryRow row)
    {
        var lot = Text(row.LotNo);
        if (lot != "-" && row.LotCount > 1)
            return $"{lot} +{row.LotCount - 1}";

        return lot;
    }

    private bool HasInvalidDate => false;

    private static string Unit(string? value) => string.IsNullOrWhiteSpace(value) ? "EA" : value;

    private static string Qty(decimal value, string? unit) => $"{value:N0} {Unit(unit)}";

    private static string Qty(decimal? value, string? unit)
        => value.HasValue ? $"{value.Value:N0} {Unit(unit)}" : "-";

    private static string SignedQty(decimal value, string? unit)
    {
        var prefix = value > 0 ? "+" : "";
        return $"{prefix}{value:N0} {Unit(unit)}";
    }

    private static string DateText(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string Days(decimal? value)
        => value.HasValue ? $"{value.Value:N0} days" : "-";

    private static string CodeName(string? code, string? name)
    {
        if (string.IsNullOrWhiteSpace(code)) return Text(name);
        if (string.IsNullOrWhiteSpace(name)) return code.Trim();
        return $"{code.Trim()} / {name.Trim()}";
    }

    private static string Rack(PdaApi.InventoryLocationRow row)
    {
        return Rack(row.RackX, row.RackY, row.RackZ);
    }

    private static string Rack(string? x, string? y, string? z)
    {
        var rack = new[] { x, y, z }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToArray();

        return rack.Length == 0 ? "-" : string.Join("-", rack);
    }
}
