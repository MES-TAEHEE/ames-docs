    private async Task ExecuteAdjustTestValue(AdjustTestValue value, bool resetStock = false)
    {
        _workTab = "Adjust";
        if (resetStock)
        {
            try
            {
                await Api.WhResetAdjustTestAsync();
            }
            catch (Exception ex)
            {
                ShowAlert("Test Reset Failed", ex.Message, "fail");
                return;
            }
        }

        switch (value.Action)
        {
            case "DELTA":
                var requested = Convert.ToDecimal(value.Value, System.Globalization.CultureInfo.InvariantCulture);
                _invAdjustDelta = Math.Max(-InventoryBeforeQty, requested);
                if (requested < -InventoryBeforeQty)
                    ShowAlert("Invalid Quantity", "After Qty cannot be below zero.", "warn");
                break;
            case "REASON":
                _invAdjustReason = value.Value;
                break;
            case "NOTE":
                _invAdjustNote = value.Value;
                break;
            case "OPEN_QTY": OpenQuantityPad(); break;
            case "QTY_VALID": OnAdjustmentQuantityInput(new ChangeEventArgs { Value = "15" }); break;
            case "QTY_DECIMAL": OnAdjustmentQuantityInput(new ChangeEventArgs { Value = "1.5" }); break;
            case "QTY_EMPTY": OnAdjustmentQuantityInput(new ChangeEventArgs { Value = "" }); break;
            case "PREPARE":
                _invAdjustDelta = 3;
                _invAdjustReason = "DAMAGED";
                break;
            case "PREPARE_SAVE":
                _invAdjustDelta = 3;
                _invAdjustReason = "DAMAGED";
                _invAdjustNote = "WH005 scenario adjustment";
                break;
            default:
                _invBarcode = value.Value;
                await ScanInventoryLot();
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
            _scannerRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = ShowDeveloperScanButtons });
        }

        await FocusScannerAsync();
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        var value = NormalizeHardwareScan(scanText);
        if (string.IsNullOrWhiteSpace(value))
            return;

        await InvokeAsync(async () =>
        {
            if (_quantityPadOpen || _modalOpen || _testPanelOpen || _pptOpen || InventoryBusy)
                return;

            if (IsSearchTab)
            {
                if (IsInventoryLocationView)
                {
                    _locationQuery = value;
                    await LoadLocationInventory();
                }
                else
                {
                    _q = value;
                    await ScanInventoryFilter();
                }
            }
            else if (ShouldRouteHardwareScanToLocation)
            {
                _invLocationNo = value;
                await ScanInventoryLocation();
            }
            else
            {
                _invBarcode = value;
                await ScanInventoryLot();
            }

            StateHasChanged();
        });
    }

    private void OnNativeBarcodeScanned(string barcode)
    {
        _ = InvokeAsync(async () => await OnHardwareScanAsync(barcode));
    }

    private bool ShouldRouteHardwareScanToLocation
        => IsLocatingTab && InventoryAlreadyReceived && _invScan is not null;

    private async Task FocusScannerAsync()
    {
        if (_quantityPadOpen || _modalOpen || _testPanelOpen || _pptOpen || _dateFilterOpen || _locationModalOpen || _selectedInventoryLocation is not null)
            return;

        try
        {
            var selector = IsSearchTab
                ? IsInventoryLocationView
                    ? ".wh03-location-query"
                    : ".wh03-search-input"
                : ShouldRouteHardwareScanToLocation
                    ? ".wh03-location-scan .wh03-work-input"
                    : ".wh03-work-scan:not(.wh03-location-scan) .wh03-work-input";
            await JS.InvokeVoidAsync("pdaScan.focus", selector);
        }
        catch
        {
            // Ignore focus failures while the WebView is navigating.
        }
    }

    private static string NormalizeHardwareScan(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Replace("\u0002", "").Replace("\u0003", "").Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;

        try
        {
            await JS.InvokeVoidAsync("pdaScan.unregister");
        }
        catch
        {
            // Ignore dispose-time JS disconnects.
        }

        _scannerRef?.Dispose();
    }

