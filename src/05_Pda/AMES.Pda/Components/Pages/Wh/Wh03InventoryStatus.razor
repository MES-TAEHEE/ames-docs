    private void StepInventoryAdjust(decimal delta)
    {
        if (DisableAdjustQtyControls)
            return;

        var next = decimal.Truncate(InventoryAfterQty) + delta - InventoryBeforeQty;
        if (next < -InventoryBeforeQty)
            next = -InventoryBeforeQty;
        next = Math.Min(next, 999999999m - InventoryBeforeQty);

        _invAdjustDelta = next;
        _adjustQuantityInput = null;
        _adjustQuantityInvalid = false;
    }

    private void OnAdjustmentQuantityInput(ChangeEventArgs e)
    {
        if (DisableAdjustQtyControls) return;
        _adjustQuantityInput = Convert.ToString(e.Value) ?? "";
        _adjustQuantityInvalid = !decimal.TryParse(_adjustQuantityInput,
            System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var quantity)
            || quantity < 0 || quantity > 999999999m;
        if (!_adjustQuantityInvalid) _invAdjustDelta = quantity - InventoryBeforeQty;
    }

    private void OpenQuantityPad()
    {
        if (DisableAdjustQtyControls) return;
        _quantityPadDraft = decimal.Truncate(InventoryAfterQty).ToString(System.Globalization.CultureInfo.InvariantCulture);
        _quantityPadOpen = true;
    }

    private void OnQuantityPadKey(KeyboardEventArgs e)
    {
