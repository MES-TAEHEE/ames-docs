    private async Task LoadTestValue(InventoryTestValue value)
    {
        CloseTestPanel();
        await ExecuteTestValue(value);
    }

    private async Task ExecuteTestValue(InventoryTestValue value)
    {
        _workTab = "Search";
        switch (value.Action)
        {
            case "LIST":
                _inventoryView = "Location";
                _locationQuery = "";
                _matchedLocationIds = null;
                CloseLocationInventory();
                await LoadInventoryLocations();
                break;
            case "OPEN_LOCATION":
                _inventoryView = "Location";
                _locationQuery = value.Value.Split('/')[0].Trim();
                _matchedLocationIds = new(StringComparer.OrdinalIgnoreCase) { _locationQuery };
                if (_inventoryLocations.Count == 0)
                    await LoadInventoryLocations();
                await OpenInventoryLocation(_locationQuery);
                break;
            case "CHANGE_QTY":
                try
                {
                    var result = await Api.WhToggleInventoryTestQtyAsync();
                    ShowAlert("Test Stock Changed", result.Message, result.Success ? "success" : "warn");
                }
                catch (Exception ex)
                {
                    ShowAlert("Test Stock Change Failed", ex.Message, "fail");
                }
                break;
            case "API_QUERY":
                _inventoryView = "Part";
                _q = value.Value;
                await Load();
                break;
            default:
                _inventoryView = "Location";
                _locationQuery = value.Value;
                await LoadLocationInventory();
                break;
        }
    }

