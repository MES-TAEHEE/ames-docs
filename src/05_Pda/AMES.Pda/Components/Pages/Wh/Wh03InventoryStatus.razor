        _isLoading = true;
        _selectedBrowsePart = part;
        try
        {
            _browsePartLots = (await Api.WhLotStatusesAsync(part.PartNo))
                .Where(row => row.RemainingQty > 0
                    && string.Equals(row.ItemNo, part.PartNo, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(row.LocationId, part.Location, StringComparison.OrdinalIgnoreCase))
                .OrderBy(row => row.LocationId, StringComparer.OrdinalIgnoreCase)
                .ThenBy(row => row.LotNo, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        finally { _isLoading = false; }
    }

