@page "/wh/03"
@page "/fg/adjust"
@inject PdaApi Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@($"pda-shell wh wh03-shell inventory-browser-shell {(IsFinishedGoodsAdjust ? "fg fg-adjust-shell" : "")} {(IsSearchTab ? "wh03-map-only" : IsAdjustTab ? "wh03-adjust-only" : "")}")">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo(IsFinishedGoodsAdjust ? "/fg" : "/wh"))' Text="&lt;" />
        <div class="wh03-tbar-title">
            <span class="pda-tbar-brand">@PageTitle</span>
        </div>
        @if (IsTestMode || IsPptTestMode || !IsAdjustTab)
        {
            <div class="wh03-tbar-actions">
                @if (IsPptTestMode)
                {
                    <PptScenarioPanel @key='@(IsFinishedGoodsAdjust ? "fg-adjust" : IsAdjustTab ? "wh-adjust" : "wh-inventory")' Title="@(IsAdjustTab ? "ADJUST" : "INVENTORY")" Steps="ActivePptSteps" ModeLabel="@ScenarioModeLabel" Busy="@(InventoryBusy || _isLoading)" OnStart="StartPptStep" OnValue="RunPptValue" OnReset="ResetPptData" OpenChanged="@((bool open) => _pptOpen = open)" />
                }
                @if (IsTestMode)
                {
                    <button class="wh02-test-nav" @onclick="OpenTestPanel">SCENARIO</button>
                }
                @if (!IsAdjustTab)
                {
                    <RadzenButton class="wh03-refresh" Click="@Load" Disabled="@_isLoading" Text="REFRESH" />
                }
            </div>
        }
    </div>

    <div class="pda-bd wh03-body">
        @if (IsSearchTab)
        {
            <div class="wh03-filter-strip">
                <RadzenButton class="@($"wh03-filter-toggle {(HasDateFilter ? "on" : "")}")"
                              Click="@OpenDateFilters"
                              Disabled="@_isLoading"
                              Icon="filter_alt"
                              Text="" />
            </div>

            <div class="inventory-browse-tabs">
                <button type="button" class="@InventoryViewClass("Location")" disabled="@_isLoading" @onclick='@(() => SetInventoryView("Location"))'>BY LOCATION</button>
                <button type="button" class="@InventoryViewClass("Part")" disabled="@_isLoading" @onclick='@(() => SetInventoryView("Part"))'>BY PART</button>
            </div>

            @if (IsInventoryPartView)
            {
                @if (_selectedBrowsePart is not null)
                {
                    <div class="inventory-detail-page">
                        <div class="inventory-detail-head">
                            <RadzenButton class="inventory-back" Click="CloseBrowsePart" Text="&lt; BACK" />
                            <div><span>PART</span><strong>@Text(_selectedBrowsePart.PartNo)</strong><em>@Text(_selectedBrowsePart.PartName)</em></div>
                            <strong>@Qty(_selectedBrowsePart.Qty, _selectedBrowsePart.Unit)</strong>
                        </div>
                        <div class="inventory-table-head inventory-lot-grid"><span>LOT</span><span>QTY</span><span>LOCATION</span></div>
                        <div class="inventory-table-list">
                            @foreach (var lot in _browsePartLots)
                            {
                                <div class="inventory-table-row inventory-lot-grid">
                                    <strong>@Text(lot.LotNo)</strong><strong>@Qty(lot.RemainingQty, _selectedBrowsePart.Unit)</strong><strong>@Text(lot.LocationId)</strong>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <RadzenCard class="@($"wh03-search-card wh03-scan-card {ScanPanelClass}")">
                        <div class="pda-fld">
                            <label>INVENTORY SCAN</label>
                            <RadzenTextBox class="pda-input wh03-search-input pda-scan-input" Value="@_q" @oninput="OnScanInput" @onkeydown="OnKey" Placeholder="Scan Lot, Part, or Location No" />
                        </div>
                        @if (ShowDeveloperScanButtons)
                        {
                            <RadzenButton class="wh03-search-btn" Click="@ScanInventoryFilter" Disabled="@_isLoading" Text="SCAN" />
                        }
                    </RadzenCard>

                    @if (_isLoading) { <div class="pda-empty">Loading inventory...</div> }
                    else if (BrowsePartRows.Count == 0) { <div class="pda-empty">@EmptyMessage</div> }
                    else
                    {
                        <div class="inventory-table-head inventory-part-grid"><span>PART</span><span>QTY</span><span>LOCATION</span></div>
                        <div class="inventory-table-list inventory-main-list">
                            @foreach (var row in BrowsePartRows)
                            {
                                <button type="button" class="inventory-table-row inventory-part-grid" @onclick="@(() => OpenBrowsePart(row))">
                                    <span class="inventory-part-cell"><strong>@Text(row.PartNo)</strong><small>@Text(row.PartName)</small></span>
                                    <strong>@Qty(row.Qty, row.Unit)</strong><strong>@Text(row.Location)</strong>
                                </button>
                            }
                        </div>
                    }
                    <div class="wh03-location-clear-bar"><RadzenButton class="wh03-location-clear" Click="ClearPartSearch" Disabled="@string.IsNullOrWhiteSpace(_q)" Text="CLEAR" /></div>
                }
            }
            else if (IsInventoryLocationView)
            {
                @if (_selectedInventoryLocation is not null && _selectedLocationPart is not null)
                {
                    <div class="inventory-detail-page">
                        <div class="inventory-detail-head">
                            <RadzenButton class="inventory-back" Click="CloseLocationPart" Text="&lt; BACK" />
                            <div><span>PART</span><strong>@Text(_selectedLocationPart.PartNo)</strong><em>@Text(_selectedLocationPart.PartName)</em></div>
                            <strong>@Qty(_selectedLocationPart.Qty, _selectedLocationPart.Unit)</strong>
                        </div>
                        <div class="inventory-table-head inventory-lot-grid"><span>LOT</span><span>QTY</span><span>LOCATION</span></div>
                        <div class="inventory-table-list">
                            @foreach (var lot in _selectedLocationLots)
                            {
                                <div class="inventory-table-row inventory-lot-grid">
                                    <span class="inventory-part-cell"><strong>@Text(lot.LotNo)</strong><small>@Text(lot.InventoryStatus)</small></span>
                                    <strong>@Qty(lot.Qty, lot.Unit)</strong><strong>@Text(_selectedInventoryLocation.LocationId)</strong>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_selectedInventoryLocation is not null)
                {
                    <div class="inventory-detail-page">
                        <div class="inventory-detail-head">
                            <RadzenButton class="inventory-back" Click="@CloseLocationInventory" Text="&lt; BACK" />
                            <div><span>LOCATION</span><strong>@Text(_selectedInventoryLocation.LocationId)</strong><em>@Text(_selectedInventoryLocation.LocationName)</em></div>
                            <strong>@Qty(_selectedInventoryLocation.TotalQty, _selectedInventoryLocation.Unit)</strong>
                        </div>
                        <div class="inventory-table-head inventory-part-detail-grid"><span>PART</span><span>QTY</span></div>
                        <div class="inventory-table-list">
                            @foreach (var part in SelectedLocationParts)
                            {
                                <button type="button" class="inventory-table-row inventory-part-detail-grid" @onclick="@(() => OpenLocationPart(part))">
                                    <span class="inventory-part-cell"><strong>@Text(part.PartNo)</strong><small>@Text(part.PartName)</small></span>
                                    <strong>@Qty(part.Qty, part.Unit)</strong>
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <RadzenCard class="@($"wh03-search-card wh03-scan-card wh03-location-search {ScanPanelClass}")">
                    <div class="pda-fld">
                        <label>INVENTORY SCAN</label>
                        <RadzenTextBox class="pda-input wh03-search-input wh03-location-query pda-scan-input"
                                       Value="@_locationQuery"
                                       @oninput="OnLocationQueryInput"
                                       @onkeydown="OnLocationQueryKey"
                                       Placeholder="Scan Lot, Part, or Location No" />
                    </div>
                    @if (ShowDeveloperScanButtons)
                    {
                        <RadzenButton class="wh03-search-btn" Click="@LoadLocationInventory" Disabled="@DisableLocationInventoryScan" Text="SCAN" />
                    }
                    </RadzenCard>

                    @if (_isLoading)
                    {
                        <div class="pda-empty">Loading locations...</div>
                    }
                    else if (VisibleInventoryLocations.Count == 0)
                    {
                        <div class="pda-empty">@_locationMsg</div>
                    }
                    else
                    {
                        <div class="inventory-table-head inventory-location-grid"><span>LOCATION</span><span>QTY</span></div>
                        <div class="inventory-table-list inventory-main-list">
                            @foreach (var location in VisibleInventoryLocations)
                            {
                                <button type="button" class="inventory-table-row inventory-location-grid" @onclick="@(() => OpenInventoryLocation(location.LocationId))">
                                    <span class="inventory-part-cell"><strong>@Text(location.LocationId)</strong><small>@Text(location.LocationName)</small></span>
                                    <strong>@Qty(location.TotalQty, location.Unit)</strong>
                                </button>
                            }
                        </div>
                    }

                    <div class="wh03-location-clear-bar">
                        <RadzenButton class="wh03-location-clear" Click="@ClearLocationSearch" Disabled="@string.IsNullOrWhiteSpace(_locationQuery)" Text="CLEAR" />
                    </div>
                }
            }
            else
            {
                <RadzenCard class="@($"wh03-search-card wh03-scan-card {ScanPanelClass}")">
                    <div class="pda-fld">
                        <label>LOT / PART SCAN</label>
                        <RadzenTextBox class="pda-input wh03-search-input pda-scan-input"
                                       Value="@_q"
                                       @oninput="OnScanInput"
                                       @onkeydown="OnKey"
                                       Placeholder="Scan LOT or Part No" />
                    </div>
                    @if (ShowDeveloperScanButtons)
                    {
                        <RadzenButton class="wh03-search-btn" Click="@LoadLotStatuses" Disabled="@_isLoading" Text="SCAN" />
                    }
                </RadzenCard>

                @if (_isLoading)
                {
                    <div class="pda-empty">Loading LOT status...</div>
                }
                else if (_lotStatuses.Count == 0)
                {
                    <div class="pda-empty">No LOT matches.</div>
                }
                else
                {
                    <div class="wh03-list">
                        @foreach (var lot in _lotStatuses)
                        {
                            <RadzenCard class="@($"wh03-stock-card wh03-stock-compact {LotStatusClass(lot.InventoryStatus)}")">
                                <div class="wh03-compact-row main">
                                    <strong>@Text(lot.LotNo)</strong>
                                    <RadzenBadge class="@($"wh03-status-badge {LotStatusClass(lot.InventoryStatus)}")"
                                                 Text="@LotStatusLabel(lot.InventoryStatus)" />
                                </div>
                                <div class="wh03-compact-row sub">
                                    <span>@Text(lot.ItemNo) · @Text(lot.ItemName)</span>
                                    <strong>@Qty(lot.RemainingQty, null)</strong>
                                </div>
                                <div class="wh03-compact-location">
                                    <span>Location @Text(lot.LocationId)</span>
                                    <strong>Produced @DateText(lot.ProductionDate)</strong>
                                </div>
                            </RadzenCard>
                        }
                    </div>
                }
            }
        }
        else
        {
            <RadzenCard class="wh03-work-card">
                <div class="wh03-work-head">
                    <div>
                        <span>@_workTab.ToUpperInvariant()</span>
                        <strong>@(IsAdjustTab ? IsFinishedGoodsAdjust ? "Finished Goods Quantity Adjustment" : "Warehouse Quantity Adjustment" : "Inventory Location Change")</strong>
                    </div>
                    @if (!IsAdjustTab)
                    {
                        <em>Scan LOT No first</em>
                    }
                </div>

                @if (!IsAdjustTab)
                {
                    <div class="wh03-mode-row">
                        <RadzenButton class="@InvModeClass("LOCAL")" Click='@(() => SetInventoryMode("LOCAL"))' Text="LOCAL" />
                        <RadzenButton class="@InvModeClass("CKD")" Click='@(() => SetInventoryMode("CKD"))' Text="CKD" />
                    </div>
                }

                <div class="@($"wh03-work-scan {ScanPanelClass}")">
                    <div class="pda-fld">
                        <label>@(IsAdjustTab ? "LOCATION / LOT SCAN" : "LOT NO SCAN")</label>
                        <RadzenTextBox class="pda-input wh03-work-input pda-scan-input"
                                       Value="@_invBarcode"
                                       @oninput="OnInventoryBarcodeInput"
                                       @onkeydown="OnInventoryLotKey"
                                       Placeholder="@InventoryBarcodePlaceholder" />
                    </div>
                    @if (ShowDeveloperScanButtons)
                    {
                        <RadzenButton class="wh03-work-scan-btn" Click="@ScanInventoryLot" Disabled="@DisableInventoryScan" Text="SCAN" />
                    }
                </div>
            </RadzenCard>

            @if (IsAdjustTab && _adjustLocation is not null)
            {
                <section class="wh03-adjust-location-list">
                    <div class="wh03-section-title">@_adjustLocation.LocationId · SELECT STOCK</div>
                    @foreach (var stock in _adjustLocation.Items)
                    {
                        <button type="button" class="wh03-adjust-location-item @(_invScan?.LotNo == stock.LotNo ? "selected" : "")"
                                disabled="@InventoryBusy" @onclick="@(() => SelectAdjustmentStock(stock))">
                            <span><strong>@stock.PartNo</strong><b>@Qty(stock.Qty, stock.Unit)</b></span>
                            <span>@stock.PartName</span>
                            <small>@stock.LotNo</small>
                        </button>
                    }
                    @if (_adjustLocation.Items.Count == 0)
                    {
                        <div class="pda-status dim">No adjustable stock at this location.</div>
                    }
                </section>
            }

            @if (IsAdjustTab && _invScan is not null)
            {
                <RadzenCard class="wh03-work-card wh03-adjust-stock">
                    <dl class="wh03-adjust-stock-list">
                        <div><dt>Part No</dt><dd>@Text(_invScan.PartNo)</dd></div>
                        <div><dt>Part Name</dt><dd>@Text(_invScan.PartName)</dd></div>
                        <div><dt>Qty</dt><dd>@Qty(_invScan.Qty, _invScan.Unit)</dd></div>
                        <div><dt>Location</dt><dd>@Text(_invScan.ReceivedLocation)</dd></div>
                    </dl>
                </RadzenCard>
            }
            else if (_invScan is not null)
            {
                <RadzenCard class="@($"wh03-work-card wh03-lot-card {InventoryLotCardClass}")">
                    <div class="wh03-lot-top">
                        <div>
                            <span>LOT NO</span>
                            <strong>@Text(_invScan.LotNo)</strong>
                        </div>
                        <RadzenBadge class="@($"wh03-status-badge {InventoryStatusClass}")" Text="@InventoryStatusLabel" />
                    </div>
                    <div class="wh03-lot-part">
                        <strong>@Text(_invScan.PartNo)</strong>
                        <span>@Text(_invScan.PartName)</span>
                    </div>
                    <div class="wh03-info-grid">
                        @foreach (var field in InventoryLotFields())
                        {
                            <div class="wh03-info-box">
                                <span>@field.Label</span>
                                <strong>@field.Value</strong>
                            </div>
                        }
                    </div>
                </RadzenCard>
            }

            @if (IsAdjustTab)
            {
                <RadzenCard class="@($"wh03-work-card wh03-action-card {(!InventoryAlreadyReceived ? "disabled" : "")}")">
                    <div class="wh03-section-title">ADJUSTMENT</div>
                    <div class="wh03-form-grid">
                        <div class="pda-fld">
                            <label>REASON CODE</label>
                            <div class="wh03-reason-select">
                                <select class="pda-input wh03-work-input" aria-label="Reason code" @bind="_invAdjustReason" disabled="@(!InventoryAlreadyReceived || InventoryBusy)">
                                    <option value="">Select a reason code</option>
                                    @foreach (var reason in AdjustReasons)
                                    {
                                        <option value="@reason.CodeValue">@reason.Name</option>
                                    }
                                </select>
                                <RadzenIcon Icon="expand_more" class="wh03-reason-arrow" aria-hidden="true" />
                            </div>
                        </div>
                        <div class="pda-fld">
                            <label>NEW QUANTITY</label>
                            <div class="wh03-qty-stepper">
                                <button type="button"
                                        class="wh03-qty-step"
                                        @onclick="@(() => StepInventoryAdjust(-1))"
                                        disabled="@DisableAdjustQtyMinus">-</button>
                                    <input type="text" class="wh03-qty-input" aria-label="New quantity" inputmode="none"
                                           readonly aria-haspopup="dialog" disabled="@DisableAdjustQtyControls"
                                           value="@(_adjustQuantityInput ?? InventoryAfterQty.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))"
                                           @onclick="OpenQuantityPad" @onkeydown="OnQuantityPadKey" />
                                <button type="button"
                                        class="wh03-qty-step"
                                        @onclick="@(() => StepInventoryAdjust(1))"
                                        disabled="@DisableAdjustQtyPlus">+</button>
                            </div>
                            @if (_adjustQuantityInvalid)
                            {
                                <span class="pda-status fail">Enter a whole number from 0 to 999999999.</span>
                            }
                        </div>
                        <div class="pda-fld wh03-form-wide">
                            <label>NOTE</label>
                            <textarea class="pda-input wh03-work-note" rows="2" @bind="_invAdjustNote" disabled="@(!InventoryAlreadyReceived || InventoryBusy)"></textarea>
                        </div>
                    </div>

                    <div class="wh03-action-row">
                        <RadzenButton class="wh03-date-clear" Click="@ClearInventoryWork" Disabled="@InventoryBusy" Text="CLEAR" />
                        <RadzenButton class="@($"wh03-date-apply wh03-post-btn save {(DisableInventoryAdjust ? "blocked" : "ready")}")"
                                      Click="@PostInventoryAdjust" aria-disabled="@(DisableInventoryAdjust ? "true" : "false")" Text="SAVE" />
                    </div>
                </RadzenCard>
            }

            @if (IsLocatingTab)
            {
                <RadzenCard class="@($"wh03-work-card wh03-action-card {(!InventoryAlreadyReceived ? "disabled" : "")}")">
                    <div class="wh03-section-title">CURRENT LOCATION</div>
                    @if (_inventoryCurrentLocation is not null)
                    {
                        <div class="wh03-location-mini-card">
                            <strong>@Text(_inventoryCurrentLocation.LocationId)</strong>
                            <span>@Text(_inventoryCurrentLocation.LocationName ?? _inventoryCurrentLocation.ZoneName ?? _inventoryCurrentLocation.Zone)</span>
                            <div class="wh03-info-grid">
                                @foreach (var field in LocationFieldsFor(_inventoryCurrentLocation))
                                {
                                    <div class="wh03-info-box">
                                        <span>@field.Label</span>
                                        <strong>@field.Value</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="pda-empty compact">No current location loaded.</div>
                    }

                    <div class="@($"wh03-work-scan wh03-location-scan {ScanPanelClass}")">
                        <div class="pda-fld">
                            <label>NEW LOCATION NO SCAN</label>
                            <RadzenTextBox class="pda-input wh03-work-input pda-scan-input"
                                           Value="@_invLocationNo"
                                           @oninput="OnInventoryLocationInput"
                                           @onkeydown="OnInventoryLocationKey"
                                           Placeholder="Scan new location no"
                                           Disabled="@(!InventoryAlreadyReceived || InventoryBusy)" />
                        </div>
                        @if (ShowDeveloperScanButtons)
                        {
                            <RadzenButton class="wh03-work-scan-btn" Click="@ScanInventoryLocation" Disabled="@DisableInventoryLocationScan" Text="SCAN" />
                        }
                    </div>

                    @if (_invTargetLocation is not null)
                    {
                        <div class="wh03-location-mini-card target">
                            <strong>@Text(_invTargetLocation.LocationId)</strong>
                            <span>@Text(_invTargetLocation.LocationName ?? _invTargetLocation.ZoneName ?? _invTargetLocation.Zone)</span>
                            <div class="wh03-info-grid">
                                @foreach (var field in LocationFieldsFor(_invTargetLocation))
                                {
                                    <div class="wh03-info-box">
                                        <span>@field.Label</span>
                                        <strong>@field.Value</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="wh03-action-row">
                        <RadzenButton class="wh03-date-clear" Click="@ClearInventoryWork" Disabled="@InventoryBusy" Text="CLEAR" />
                        <RadzenButton class="@($"wh03-date-apply wh03-post-btn {(DisableInventoryMove ? "blocked" : "ready")}")" Click="@ConfirmInventoryMove" Disabled="@DisableInventoryMove" Text="CONFIRM MOVE" />
                    </div>
                </RadzenCard>
            }

            @if (!string.IsNullOrWhiteSpace(_invMsg))
            {
                <div class="pda-status @_invCls">@_invMsg</div>
            }
        }
    </div>

    @if (IsTestMode && _testPanelOpen)
    {
        <div class="wh02-test-backdrop" @onclick="CloseTestPanel">
            <section class="wh02-test-panel" @onclick:stopPropagation="true">
                <div class="wh02-test-head">
                    <div><span>TEST MODE</span><strong>@(IsAdjustTab ? "ADJUST TEST SCENARIOS" : "INVENTORY TEST SCENARIOS")</strong></div>
                    <b>@(IsAdjustTab ? $"{CurrentAdjustTestScenario.No:00} / {AdjustTestScenarios.Length}" : $"{CurrentTestScenario.No:00} / {InventoryTestScenarios.Length}")</b>
                    <button class="wh02-test-close" @onclick="CloseTestPanel" aria-label="Close scenarios">×</button>
                </div>
                <div class="wh02-test-tabs">
                    @if (IsAdjustTab)
                    {
                        @foreach (var scenario in AdjustTestScenarios)
                        {
                            var index = scenario.No - 1;
                            <button class="@(index == _adjustTestScenarioIndex ? "on" : "")"
                                    @onclick="@(() => SelectAdjustTestScenario(index))">@scenario.No.ToString("00")</button>
                        }
                    }
                    else
                    {
                        @foreach (var scenario in InventoryTestScenarios)
                        {
                            var index = scenario.No - 1;
                            <button class="@(index == _testScenarioIndex ? "on" : "")"
                                    @onclick="@(() => SelectTestScenario(index))">@scenario.No.ToString("00")</button>
                        }
                    }
                </div>
                <div class="wh02-test-case">
                    @if (IsAdjustTab)
                    {
                        <div class="wh02-test-summary">
                            <span>@CurrentAdjustTestScenario.TestCaseId</span>
                            <strong>@CurrentAdjustTestScenario.Title</strong>
                        </div>
                        @if (CurrentAdjustTestScenario.Values.Length > 0)
                        {
                            <div class="wh02-test-values">
                                @foreach (var value in CurrentAdjustTestScenario.Values)
                                {
                                    <button @onclick="@(() => LoadAdjustTestValue(value))">
                                        <span>@value.Label</span><b>@value.Value</b>
                                    </button>
                                }
                            </div>
                        }
                        @if (CurrentAdjustTestScenario.No == 18)
                        {
                            <div class="wh02-test-actions">
                                <button @onclick='@(() => OpenAdjustScenarioPage("/wh/08"))'>OPEN TRANSACTIONS</button>
                            </div>
                        }
                        else if (CurrentAdjustTestScenario.No == 20)
                        {
                            <button class="@($"wh02-test-error {(_simulateAdjustApiFailure ? "on" : "")}")"
                                    @onclick="ToggleAdjustApiFailure">
                                API ERROR: @(_simulateAdjustApiFailure ? "ON" : "OFF")
                            </button>
                        }
                        <button class="wh02-test-start" @onclick="StartAdjustTestScenario">START SCENARIO</button>
                    }
                    else
                    {
                        <div class="wh02-test-summary">
                            <span>@CurrentTestScenario.TestCaseId</span>
                            <strong>@CurrentTestScenario.Title</strong>
                        </div>
                        @if (CurrentTestScenario.Values.Length > 0)
                        {
                            <div class="wh02-test-values">
                                @foreach (var value in CurrentTestScenario.Values)
                                {
                                    <button @onclick="@(() => LoadTestValue(value))">
                                        <span>@value.Label</span><b>@value.Value</b>
                                    </button>
                                }
                            </div>
                        }
                        @if (CurrentTestScenario.No == 11)
                        {
                            <button class="@($"wh02-test-error {(_simulateInventoryApiFailure ? "on" : "")}")"
                                    @onclick="ToggleInventoryApiFailure">
                                API ERROR: @(_simulateInventoryApiFailure ? "ON" : "OFF")
                            </button>
                        }
                        <button class="wh02-test-start" @onclick="StartTestScenario">START SCENARIO</button>
                    }
                </div>
            </section>
        </div>
    }

    @if (_dateFilterOpen)
    {
        <div class="wh03-filter-backdrop" @onclick="CloseDateFilters">
            <RadzenCard class="wh03-filter-sheet" @onclick:stopPropagation="true">
                <div class="wh03-filter-sheet-head">
                    <div>
                        <span>DATE FILTER</span>
                        <strong>Stock Date</strong>
                    </div>
                    <RadzenButton class="wh03-sheet-close" Click="@CloseDateFilters" Icon="close" Text="" />
                </div>
                <div class="wh03-date-panel">
                    <div class="pda-fld">
                        <label>FROM</label>
                        <RadzenDatePicker TValue="DateTime?"
                                          @bind-Value="_dateFrom"
                                          DateFormat="yyyy-MM-dd"
                                          AllowClear="false"
                                          Max="@DateTo"
                                          Placeholder="YYYY-MM-DD"
                                          class="wh03-date-picker" />
                    </div>
                    <div class="pda-fld">
                        <label>TO</label>
                        <RadzenDatePicker TValue="DateTime?"
                                          @bind-Value="_dateTo"
                                          DateFormat="yyyy-MM-dd"
                                          AllowClear="false"
                                          Min="@DateFrom"
                                          Placeholder="YYYY-MM-DD"
                                          class="wh03-date-picker" />
                    </div>
                    <div class="wh03-date-actions">
                        <RadzenButton class="wh03-date-clear" Click="@ClearDateFilter" Disabled="@_isLoading" Text="CLEAR" />
                        <RadzenButton class="wh03-date-apply" Click="@ApplyDateFilter" Disabled="@_isLoading" Text="APPLY" />
                    </div>
                </div>
            </RadzenCard>
        </div>
    }

    @if (_quantityPadOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseQuantityPad">
            <RadzenCard class="wh-modal-card wh03-pin-dialog wh03-quantity-dialog" role="dialog" aria-modal="true" aria-labelledby="wh03-quantity-title" @onclick:stopPropagation="true">
                <div id="wh03-quantity-title" class="wh-modal-title">NEW QUANTITY</div>
                <output class="wh03-quantity-pad-value" aria-live="polite">@(_quantityPadDraft.Length == 0 ? "0" : _quantityPadDraft)</output>
                <div class="pda-keypad">
                    @foreach (var digit in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
                    {
                        <button type="button" class="pda-key" @onclick="@(() => PressQuantityDigit(digit))">@digit</button>
                    }
                    <button type="button" class="pda-key del" aria-label="Delete last digit" @onclick="DeleteQuantityDigit">
                        <RadzenIcon Icon="backspace" />
                    </button>
                    <button type="button" class="pda-key" @onclick='@(() => PressQuantityDigit("0"))'>0</button>
                    <button type="button" class="pda-key ok" disabled="@(_quantityPadDraft.Length == 0)" @onclick="ConfirmQuantityPad">OK</button>
                </div>
                <div class="wh-modal-actions">
                    <RadzenButton class="wh-modal-btn secondary" Click="@CloseQuantityPad" Text="CANCEL" />
                </div>
            </RadzenCard>
        </div>
    }

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="DismissModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@ModalMark</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions">
                    @if (string.IsNullOrWhiteSpace(_modalNavigateTo))
                    {
                        <RadzenButton class="wh-modal-btn primary" Click="@DismissModal" Text="OK" />
                    }
                    else
                    {
                        <RadzenButton class="wh-modal-btn secondary" Click="@DismissModal" Text="CANCEL" />
                        <RadzenButton class="wh-modal-btn primary" Click="@NavigateFromModal" Text="@_modalActionText" />
                    }
                </div>
            </RadzenCard>
        </div>
    }

    @if (_locationModalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseLocations">
            <RadzenCard class="wh-modal-card wh03-location-modal" @onclick:stopPropagation="true">
                <div class="wh03-location-modal-head">
                    <div>
                        <span>INVENTORY DETAIL</span>
                        <strong>@Text(_locationItem?.ItemNo)</strong>
                        <em>@Text(_locationItem?.ItemName)</em>
                    </div>
                    <RadzenButton class="wh03-location-close" Click="@CloseLocations" Text="CLOSE" />
                </div>

                @if (_locationItem is not null)
                {
                    <div class="wh03-inventory-detail-grid">
                        @foreach (var field in InventoryDetailFields(_locationItem))
                        {
                            <div>
                                <span>@field.Label</span>
                                <strong>@field.Value</strong>
                            </div>
                        }
                    </div>
                }

                @if (_locationsLoading)
                {
                    <div class="wh03-location-empty">Loading...</div>
                }
                else if (_locationRows.Count == 0)
                {
                    <div class="wh03-location-empty">No location stock found.</div>
                }
                else
                {
                    <div class="wh03-location-detail-list">
                        @foreach (var loc in _locationRows)
                        {
                            <div class="wh03-location-detail-card">
                                <div class="wh03-location-detail-top">
                                    <strong>@Text(loc.LocationId)</strong>
                                    <span>@Qty(loc.Qty, _locationItem?.Unit)</span>
                                </div>
                                <div class="wh03-location-detail-name">@Text(loc.LocationName ?? loc.ZoneName ?? loc.ZoneCode)</div>
                                <div class="wh03-location-detail-grid">
                                    <div>
                                        <span>Warehouse</span>
                                        <strong>@CodeName(loc.WarehouseCode, loc.WarehouseName)</strong>
                                    </div>
                                    <div>
                                        <span>Zone</span>
                                        <strong>@CodeName(loc.ZoneCode, loc.ZoneName)</strong>
                                    </div>
                                    <div>
                                        <span>Area</span>
                                        <strong>@CodeName(loc.AreaCode, loc.AreaName)</strong>
                                    </div>
                                    <div>
                                        <span>Rack</span>
                                        <strong>@Rack(loc)</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </RadzenCard>
        </div>
    }

</div>

