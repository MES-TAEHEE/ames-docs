        _inventoryView = view;
        if (IsInventoryLocationView)
            await LoadInventoryLocations();
        else if (IsLotStatusView)
            await LoadLotStatuses();
    }

    private string InventoryViewClass(string view)
        => $"wh03-view-tab {(string.Equals(_inventoryView, view, StringComparison.OrdinalIgnoreCase) ? "on" : "")}";

    private void SetWorkTab(string tab)
