    {
        _selectedBrowsePart = null;
        _browsePartLots = [];
    }

    private void ClearInventoryWork()
    {
        _adjustLocation = null;
        _invBarcode = "";
        _invLocationNo = "";
        _invMsg = "";
        _invCls = "dim";
        _invScan = null;
        _inventoryCurrentLocation = null;
        _invTargetLocation = null;
        ResetInventoryAdjust();
    }

    private void ResetInventoryAdjust()
    {
        _adjustQuantityInput = null;
        _adjustQuantityInvalid = false;
        _invAdjustReason = "";
        CloseQuantityPad();
        _invAdjustNote = "";
        _invAdjustDelta = 0;
    }

    private async Task ScanInventoryLot()
    {
        if (DisableInventoryScan) return;
        if (IsAdjustTab && Auth.Session?.IsAdmin != true) return;

        _isInventoryScanning = true;
        _adjustLocation = null;
        _invMsg = "Scanning Lot No...";
        _invCls = "dim";
        _invScan = null;
        _inventoryCurrentLocation = null;
        _invTargetLocation = null;
        _invLocationNo = "";
        ResetInventoryAdjust();

        try
        {
            if (IsAdjustTab)
            {
                _adjustLocation = await Api.ScanAdjustmentLocationAsync(_invBarcode, IsFinishedGoodsAdjust);
                if (_adjustLocation is not null)
                {
                    _invMsg = _adjustLocation.Items.Count == 0 ? "No adjustable stock at this location." : "Select stock from the location list.";
                    _invCls = _adjustLocation.Items.Count == 0 ? "dim" : "ok";
                    return;
                }
            }
            var row = await ScanInventoryLotByModeAsync(_invBarcode.Trim());
            if (row is null)
            {
                _invMsg = IsAdjustTab
                    ? "The specified Lot No could not be found."
                    : "LOT No was not found in the PO list.";
                _invCls = "fail";
                return;
            }

            _invScan = row;
            _invBarcode = row.Barcode;

            if (!IsAdjustTab && InventoryAlreadyReceived && !string.IsNullOrWhiteSpace(row.ReceivedLocation))
                _inventoryCurrentLocation = await Api.WhScanLocationAsync(row.ReceivedLocation);

            if (IsAdjustTab && InventoryAlreadyReceived && InventoryBeforeQty <= 0)
            {
                _invMsg = "This LOT has zero stock. Only positive adjustments are allowed.";
                _invCls = "warn";
            }
            else
            {
                _invMsg = InventoryAlreadyReceived
                    ? "Inventory LOT loaded."
                    : "This LOT has not been received yet. Receive it before adjustment or locating.";
                _invCls = InventoryAlreadyReceived ? "ok" : "warn";
            }
        }
        catch (Exception ex)
        {
            _invMsg = ex.Message;
            _invCls = "fail";
            ShowInventoryTypeAlert(ex.Message);
        }
        finally
        {
            _isInventoryScanning = false;
        }
    }

    private async Task<PdaApi.InboundScanRow?> ScanInventoryLotByModeAsync(string barcode)
    {
        if (!IsAdjustTab)
        {
            var row = await Api.WhScanInboundAsync(_invMode, barcode);
            ApplyDetectedMode(row);
            return row;
        }

        var adjustRow = IsFinishedGoodsAdjust
            ? await Api.FgScanAdjustAsync(barcode)
            : await Api.WhScanAdjustAsync(barcode);
        ApplyDetectedMode(adjustRow);
        return adjustRow;
    }

    private void ApplyDetectedMode(PdaApi.InboundScanRow? row)
    {
        if (row is null || string.IsNullOrWhiteSpace(row.ReceiveType))
            return;

        _invMode = IsFinishedGoodsAdjust
            ? "FG"
            : string.Equals(row.ReceiveType, "CKD", StringComparison.OrdinalIgnoreCase) ? "CKD" : "LOCAL";
    }

    private async Task ScanInventoryLocation()
    {
        if (DisableInventoryLocationScan) return;

        var locationNo = _invLocationNo.Trim();
        if (IsCurrentInventoryLocation(locationNo))
        {
            _invTargetLocation = null;
            _invMsg = "This LOT is already in the selected location.";
            _invCls = "fail";
            return;
        }

        _isInventoryLocationScanning = true;
        _invMsg = "Scanning location...";
        _invCls = "dim";

        try
        {
            var location = await Api.WhScanLocationAsync(locationNo);
            if (location is null)
            {
                _invTargetLocation = null;
                _invMsg = "Location No was not found.";
                _invCls = "fail";
                return;
            }

            if (IsCurrentInventoryLocation(location.LocationId))
            {
                _invTargetLocation = null;
                _invLocationNo = location.LocationId;
                _invMsg = "This LOT is already in the selected location.";
                _invCls = "fail";
                return;
            }

            _invTargetLocation = location;
            _invLocationNo = location.LocationId;
            _invMsg = "New location loaded. Confirm the move.";
            _invCls = "ok";
        }
        catch (Exception ex)
        {
            _invTargetLocation = null;
            _invMsg = ex.Message;
            _invCls = "fail";
        }
        finally
        {
            _isInventoryLocationScanning = false;
        }
    }

    private async Task PostInventoryAdjust()
    {
        if (InventoryAdjustBlockedReason is { } blockedReason)
        {
            ShowAlert("Cannot Save", blockedReason, "warn");
            return;
        }

        var deltaQty = _invAdjustDelta;

        _isInventoryAdjusting = true;
        _invMsg = "Posting adjustment...";
        _invCls = "dim";

        try
        {
            var request = new PdaApi.AdjustSaveReq(
                _invMode,
                _invScan!.Barcode,
                deltaQty,
                _invAdjustReason,
                _invAdjustNote,
                SimulateFailure: ShouldSimulateAdjustApiFailure);
            var result = IsFinishedGoodsAdjust
                ? await Api.FgSaveAdjustQtyAsync(request)
                : await Api.WhSaveAdjustQtyAsync(request);

            if (!result.Success)
            {
                _invMsg = result.Message;
                _invCls = "fail";
                ShowAlert("Adjustment Failed", result.Message, "fail");
                return;
            }

            ClearInventoryWork();
            ShowAlert("Saved", IsFinishedGoodsAdjust
                ? "Finished goods adjustment was saved."
                : "Warehouse adjustment was saved.", "success");
        }
        catch (Exception ex)
        {
            _invMsg = ex.Message;
            _invCls = "fail";
            ShowAlert("Adjustment Failed", ex.Message, "fail");
        }
        finally
        {
            _isInventoryAdjusting = false;
        }
    }

    private void ShowAlert(string title, string message, string kind = "info")
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalNavigateTo = "";
        _modalActionText = "";
        _modalOpen = true;
    }

    private void ShowInventoryTypeAlert(string message)
    {
        if (message.Contains("Finished goods cannot be adjusted", StringComparison.OrdinalIgnoreCase))
        {
            ShowNavigationAlert("Finished Goods Detected", message, "/fg/adjust", "GO TO FG ADJUST");
        }
        else if (message.Contains("Warehouse material cannot be adjusted", StringComparison.OrdinalIgnoreCase))
        {
            ShowNavigationAlert("Warehouse Material Detected", message, "/wh/03?tab=adjust", "GO TO WAREHOUSE ADJUST");
        }
    }

    private void ShowNavigationAlert(string title, string message, string target, string actionText)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = "warn";
        _modalNavigateTo = target;
        _modalActionText = actionText;
        _modalOpen = true;
    }

    private void DismissModal()
    {
        _modalOpen = false;
        _modalNavigateTo = "";
        _modalActionText = "";
    }

    private void NavigateFromModal()
    {
        var target = _modalNavigateTo;
        DismissModal();
        if (!string.IsNullOrWhiteSpace(target))
            Nav.NavigateTo(target);
    }

    private async Task ConfirmInventoryMove()
    {
        if (DisableInventoryMove || _invScan is null || _invTargetLocation is null) return;

        var fromLocation = Text(_invScan.ReceivedLocation);
        var toLocation = _invTargetLocation.LocationId;

        _isInventoryMoving = true;
        _invMsg = "Changing location...";
        _invCls = "dim";

        try
        {
            var result = await Api.WhMoveInboundLocationAsync(new PdaApi.InboundReceiveReq(_invMode, _invScan.Barcode, toLocation));
            if (!result.Success)
            {
                _invMsg = result.Message;
                _invCls = "fail";
                return;
            }

            _invScan = result.Row ?? await Api.WhScanInboundAsync(_invMode, _invScan.Barcode);
            _inventoryCurrentLocation = await Api.WhScanLocationAsync(toLocation);
            _invTargetLocation = null;
            _invLocationNo = "";
            _invMsg = $"Location changed. {fromLocation} -> {toLocation}";
            _invCls = "ok";
            await Load();
        }
        catch (Exception ex)
        {
            _invMsg = ex.Message;
            _invCls = "fail";
        }
        finally
        {
            _isInventoryMoving = false;
        }
    }

    private void SetFilter(string status)
    {
        _statusFilter = status;
    }

    private async Task OpenLocations(PdaApi.InventoryRow row)
    {
        _locationItem = row;
        _locationRows = new();
        _locationModalOpen = true;
        _locationsLoading = true;

        try
        {
            _locationRows = await Api.WhInventoryLocationsAsync(row.ItemNo, DateFrom, DateTo);
        }
        finally
        {
            _locationsLoading = false;
        }
    }

    private void CloseLocations()
    {
        _locationModalOpen = false;
        _locationsLoading = false;
        _locationRows = new();
        _locationItem = null;
    }

    private int CountStatus(string status)
        => _rows.Count(row => string.Equals(StockStatus(row), status, StringComparison.OrdinalIgnoreCase));

    private string SummaryClass(string status)
        => $"wh03-stat {StatusClass(status)} {(string.Equals(_statusFilter, status, StringComparison.OrdinalIgnoreCase) ? "on" : "")}";

    private bool IsCurrentInventoryLocation(string? locationId)
    {
        if (string.IsNullOrWhiteSpace(locationId)) return false;

        var current = _invScan?.ReceivedLocation;
        return !string.IsNullOrWhiteSpace(current)
            && string.Equals(locationId.Trim(), current.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<(string Label, string Value)> InventoryLotFields()
    {
        if (_invScan is null) yield break;

        yield return ("Qty", Qty(_invScan.Qty, _invScan.Unit));
        yield return ("PO No", Text(_invScan.PoNo));
        yield return ("PO Seq", _invScan.PoSeq?.ToString() ?? "-");
        yield return ("Vendor", Text(_invScan.VendorName ?? _invScan.VendorId));
        yield return ("Current Loc", Text(_invScan.ReceivedLocation));
    }

    private IEnumerable<(string Label, string Value)> InventoryDetailFields(PdaApi.InventoryRow row)
    {
        yield return ("Part No", Text(row.ItemNo));
        yield return ("Status", StatusText(row));
        yield return ("Stock Qty", Qty(row.OnHandQty, row.Unit));
        yield return ("Locations", Text(row.LocationId));
        yield return ("Car Type", Text(row.CarCode));
        yield return ("Min Qty", Qty(row.MinQty, row.Unit));
        yield return ("Max Qty", Qty(row.MaxQty, row.Unit));
    }

    private static IEnumerable<(string Label, string Value)> LocationFieldsFor(PdaApi.LocationRow location)
    {
        yield return ("WH", CodeName(location.WarehouseCode, location.WarehouseName));
        yield return ("Area", CodeName(location.AreaCode, location.AreaName));
        yield return ("Zone", CodeName(location.Zone, location.ZoneName));
        yield return ("Rack", Rack(location.X, location.Y, location.Z));
    }

    private static string LocationPath(PdaApi.LocationRow location)
        => string.Join(" / ", new[] { location.WarehouseCode, location.AreaCode, location.Zone }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    private static readonly string[] StockStatuses = ["ALL", "OUT", "BELOW_MIN", "OVER_MAX", "NORMAL"];

    private static string StockStatus(PdaApi.InventoryRow row)
    {
        if (row.OnHandQty <= 0)
            return "OUT";

        if (row.MinQty.HasValue && row.MinQty.Value > 0 && row.OnHandQty < row.MinQty.Value)
            return "BELOW_MIN";

        if (row.MaxQty.HasValue && row.MaxQty.Value > 0 && row.OnHandQty > row.MaxQty.Value)
            return "OVER_MAX";

        return "NORMAL";
    }

    private static string StatusText(PdaApi.InventoryRow row)
        => StatusText(StockStatus(row));

    private static string StatusText(string? status)
        => (status ?? "").ToUpperInvariant() switch
        {
            "OUT" => "Out",
            "BELOW_MIN" => "Below Min",
            "OVER_MAX" => "Over Max",
            "NORMAL" => "Normal",
            _ => "Normal"
        };

    private static string StatusClass(PdaApi.InventoryRow row) => StatusClass(StockStatus(row));

    private static string StatusClass(string? status)
        => (status ?? "").ToUpperInvariant() switch
        {
            "ALL" => "all",
            "OUT" => "out",
            "BELOW_MIN" => "below",
            "OVER_MAX" => "over",
            "NORMAL" => "normal",
            _ => "normal"
        };

    private static string LotStatusLabel(string? status)
        => (status ?? "CREATED").Replace('_', ' ');

    private static string LotStatusClass(string? status)
        => (status ?? "").ToUpperInvariant() switch
        {
            "RECEIVED" or "STORED" or "RETURN_RECEIVED" or "RELEASE_CANCELLED" => "normal",
            "CREATED" => "below",
            "RELEASED" or "RECEIPT_CANCELLED" => "all",
            "DEFECTIVE" or "DISPOSED" => "out",
            _ => "all"
        };

    private static bool Contains(string? value, string query)
        => !string.IsNullOrWhiteSpace(value)
           && value.Contains(query, StringComparison.OrdinalIgnoreCase);

    private static string Text(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "-";

        return value.Trim();
    }

    private static string LotText(PdaApi.InventoryRow row)
    {
        var lot = Text(row.LotNo);
        if (lot != "-" && row.LotCount > 1)
            return $"{lot} +{row.LotCount - 1}";

        return lot;
    }

    private bool HasInvalidDate => false;

    private static string Unit(string? value) => string.IsNullOrWhiteSpace(value) ? "EA" : value;

    private static string Qty(decimal value, string? unit) => $"{value:N0} {Unit(unit)}";

    private static string Qty(decimal? value, string? unit)
        => value.HasValue ? $"{value.Value:N0} {Unit(unit)}" : "-";

    private static string SignedQty(decimal value, string? unit)
    {
        var prefix = value > 0 ? "+" : "";
        return $"{prefix}{value:N0} {Unit(unit)}";
    }

    private static string DateText(DateTime? value)
        => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string Days(decimal? value)
        => value.HasValue ? $"{value.Value:N0} days" : "-";

    private static string CodeName(string? code, string? name)
    {
        if (string.IsNullOrWhiteSpace(code)) return Text(name);
        if (string.IsNullOrWhiteSpace(name)) return code.Trim();
        return $"{code.Trim()} / {name.Trim()}";
    }

    private static string Rack(PdaApi.InventoryLocationRow row)
    {
        return Rack(row.RackX, row.RackY, row.RackZ);
    }

    private static string Rack(string? x, string? y, string? z)
    {
        var rack = new[] { x, y, z }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToArray();

        return rack.Length == 0 ? "-" : string.Join("-", rack);
    }

    private sealed record WarehousePartSummary(string PartNo, string? PartName, decimal Qty, string Unit);
    private sealed record WarehouseBrowsePart(string PartNo, string? PartName, decimal Qty, string Unit, string Location);
}
