    }

    private void PressQuantityDigit(string digit)
    {
        if (!_quantityPadOpen || digit.Length != 1 || digit[0] is < '0' or > '9') return;
        if (_quantityPadDraft == "0") _quantityPadDraft = "";
        if (_quantityPadDraft.Length < 9) _quantityPadDraft += digit;
    }

    private void DeleteQuantityDigit()
    {
        if (_quantityPadDraft.Length > 0) _quantityPadDraft = _quantityPadDraft[..^1];
    }

    private void ConfirmQuantityPad()
    {
        if (_quantityPadDraft.Length == 0) return;
        OnAdjustmentQuantityInput(new ChangeEventArgs { Value = _quantityPadDraft });
        CloseQuantityPad();
    }

