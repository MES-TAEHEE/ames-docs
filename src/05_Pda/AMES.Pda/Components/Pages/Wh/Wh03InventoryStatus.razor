@page "/wh/03"
@inject PdaApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@($"pda-shell wh wh03-shell {(IsSearchTab ? "wh03-map-only" : IsAdjustTab ? "wh03-adjust-only" : "")}")">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/wh"))' Text="&lt;" />
        <div class="wh03-tbar-title">
            <span class="pda-tbar-brand">@PageTitle</span>
        </div>
        @if (!IsAdjustTab)
        {
            <div class="wh03-tbar-actions">
                <RadzenButton class="wh03-refresh" Click="@Load" Disabled="@_isLoading" Text="REFRESH" />
            </div>
        }
    </div>

    <div class="pda-bd wh03-body">
        @if (IsSearchTab)
        {
            <div class="wh03-filter-strip">
                <RadzenButton class="@($"wh03-filter-toggle {(HasDateFilter ? "on" : "")}")"
                              Click="@OpenDateFilters"
                              Disabled="@_isLoading"
                              Icon="filter_alt"
                              Text="" />
            </div>

            <div class="wh03-view-tabs">
                <button type="button" class="@InventoryViewClass("Status")" @onclick='@(() => SetInventoryView("Status"))'>
                    Status
                </button>
                <button type="button" class="@InventoryViewClass("Location")" @onclick='@(() => SetInventoryView("Location"))'>
                    Location
                </button>
            </div>

            @if (IsInventoryStatusView)
            {
                <RadzenCard class="@($"wh03-search-card wh03-scan-card {ScanPanelClass}")">
                    <div class="pda-fld">
                        <label>INVENTORY SCAN</label>
                        <RadzenTextBox class="pda-input wh03-search-input pda-scan-input"
                                       Value="@_q"
                                       @oninput="OnScanInput"
                                       @onkeydown="OnKey"
                                       Placeholder="Scan Lot, Part, Location No" />
                    </div>
                    @if (ShowDeveloperScanButtons)
                    {
                        <RadzenButton class="wh03-search-btn" Click="@ScanInventoryFilter" Disabled="@_isLoading" Text="SCAN" />
                    }
                </RadzenCard>

                <RadzenCard class="wh03-head">
                    <div class="pda-card-h">MATERIAL STOCK STATUS</div>
                    <div class="wh03-summary">
                        <button type="button" class='@SummaryClass("ALL")' @onclick='@(() => SetFilter("ALL"))'>
                            <span>Total</span>
                            <strong>@_rows.Count</strong>
                        </button>
                        <button type="button" class='@SummaryClass("OUT")' @onclick='@(() => SetFilter("OUT"))'>
                            <span>Out</span>
                            <strong>@CountStatus("OUT")</strong>
                        </button>
                        <button type="button" class='@SummaryClass("BELOW_MIN")' @onclick='@(() => SetFilter("BELOW_MIN"))'>
                            <span>Below Min</span>
                            <strong>@CountStatus("BELOW_MIN")</strong>
                        </button>
                        <button type="button" class='@SummaryClass("OVER_MAX")' @onclick='@(() => SetFilter("OVER_MAX"))'>
                            <span>Over Max</span>
                            <strong>@CountStatus("OVER_MAX")</strong>
                        </button>
                        <button type="button" class='@SummaryClass("NORMAL")' @onclick='@(() => SetFilter("NORMAL"))'>
                            <span>Normal</span>
                            <strong>@CountStatus("NORMAL")</strong>
                        </button>
                    </div>
                </RadzenCard>

                @if (VisibleRows.Count == 0)
                {
                    <div class="pda-empty">@EmptyMessage</div>
                }
                else
                {
                    <div class="wh03-list">
                        @foreach (var row in VisibleRows)
                        {
                            <RadzenCard class="@($"wh03-stock-card wh03-stock-compact {StatusClass(row)}")">
                                <div class="wh03-compact-row main">
                                    <strong>@Text(row.ItemNo)</strong>
                                    <span>@Qty(row.OnHandQty, row.Unit)</span>
                                </div>
                                <div class="wh03-compact-row sub">
                                    <span>@Text(row.ItemName)</span>
                                    <RadzenBadge class="@($"wh03-status-badge {StatusClass(row)}")" Text="@StatusText(row)" />
                                </div>
                                <button type="button" class="wh03-compact-location" @onclick="@(() => OpenLocations(row))">
                                    <span>Locations</span>
                                    <strong>@Text(row.LocationId)</strong>
                                </button>
                            </RadzenCard>
                        }
                    </div>
                }
            }
            else if (IsInventoryLocationView)
            {
                @if (_selectedInventoryLocation is not null)
                {
                    <div class="wh03-location-detail-page">
                        <div class="wh03-location-detail-page-head">
                            <RadzenButton class="wh03-location-detail-back" Click="@CloseLocationInventory" Text="&lt; BACK" />
                            <div>
                                <span>LOCATION</span>
                                <strong>@Text(_selectedInventoryLocation.LocationId)</strong>
                                <em>@Text(_selectedInventoryLocation.LocationName)</em>
                            </div>
                            <strong>@Qty(_selectedInventoryLocation.TotalQty, null)</strong>
                        </div>

                        @if (_isLoading)
                        {
                            <div class="pda-empty">Loading inventory...</div>
                        }
                        else if (_locationItems.Count == 0)
                        {
                            <div class="pda-empty">@_locationMsg</div>
                        }
                        else
                        {
                            <div class="wh03-location-inventory-list wh03-location-detail-items">
                                @foreach (var item in _locationItems)
                                {
                                    <RadzenCard class="wh03-location-inventory-card">
                                        <div class="wh03-location-inventory-top">
                                            <strong>@Text(item.PartNo)</strong>
                                            <span>@Qty(item.Qty, item.Unit)</span>
                                        </div>
                                        <div class="wh03-location-inventory-name">@Text(item.PartName)</div>
                                        <div class="wh03-location-inventory-meta">
                                            <span>LOT @Text(item.LotNo)</span>
                                            <em>@Text(item.InventoryStatus)</em>
                                        </div>
                                    </RadzenCard>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <RadzenCard class="@($"wh03-search-card wh03-scan-card wh03-location-search {ScanPanelClass}")">
                    <div class="pda-fld">
                        <label>INVENTORY SCAN</label>
                        <RadzenTextBox class="pda-input wh03-search-input wh03-location-query pda-scan-input"
                                       Value="@_locationQuery"
                                       @oninput="OnLocationQueryInput"
                                       @onkeydown="OnLocationQueryKey"
                                       Placeholder="Scan Lot, Part, or Location No" />
                    </div>
                    @if (ShowDeveloperScanButtons)
                    {
                        <RadzenButton class="wh03-search-btn" Click="@LoadLocationInventory" Disabled="@DisableLocationInventoryScan" Text="SCAN" />
                    }
                    </RadzenCard>

                    @if (_isLoading)
                    {
                        <div class="pda-empty">Loading locations...</div>
                    }
                    else if (VisibleInventoryLocations.Count == 0)
                    {
                        <div class="pda-empty">@_locationMsg</div>
                    }
                    else
                    {
                        <div class="wh03-location-browser-list">
                            @foreach (var location in VisibleInventoryLocations)
                            {
                                <RadzenCard class="wh03-location-browser-card"
                                            @onclick="@(() => OpenInventoryLocation(location.LocationId))">
                                    <div class="wh03-location-browser-main">
                                        <div class="wh03-location-browser-top">
                                            <strong>@Text(location.LocationId)</strong>
                                            <span>@Qty(location.TotalQty, null)</span>
                                        </div>
                                        <div class="wh03-location-browser-name">
                                            @Text(location.LocationName ?? location.ZoneName ?? location.Zone)
                                        </div>
                                    </div>
                                    <div class="wh03-location-browser-meta">
                                        <span>@LocationPath(location)</span>
                                        <strong>@Rack(location.X, location.Y, location.Z)</strong>
                                    </div>
                                </RadzenCard>
                            }
                        </div>
                    }

                    <div class="wh03-location-clear-bar">
                        <RadzenButton class="wh03-location-clear" Click="@ClearLocationSearch" Disabled="@string.IsNullOrWhiteSpace(_locationQuery)" Text="CLEAR" />
                    </div>
                }
            }
            else
            {
                <RadzenCard class="@($"wh03-search-card wh03-scan-card {ScanPanelClass}")">
                    <div class="pda-fld">
                        <label>LOT / PART SCAN</label>
                        <RadzenTextBox class="pda-input wh03-search-input pda-scan-input"
                                       Value="@_q"
                                       @oninput="OnScanInput"
                                       @onkeydown="OnKey"
                                       Placeholder="Scan LOT or Part No" />
                    </div>
                    @if (ShowDeveloperScanButtons)
                    {
                        <RadzenButton class="wh03-search-btn" Click="@LoadLotStatuses" Disabled="@_isLoading" Text="SCAN" />
                    }
                </RadzenCard>

                @if (_isLoading)
                {
                    <div class="pda-empty">Loading LOT status...</div>
                }
                else if (_lotStatuses.Count == 0)
                {
                    <div class="pda-empty">No LOT matches.</div>
                }
                else
                {
                    <div class="wh03-list">
                        @foreach (var lot in _lotStatuses)
                        {
                            <RadzenCard class="@($"wh03-stock-card wh03-stock-compact {LotStatusClass(lot.InventoryStatus)}")">
                                <div class="wh03-compact-row main">
                                    <strong>@Text(lot.LotNo)</strong>
                                    <RadzenBadge class="@($"wh03-status-badge {LotStatusClass(lot.InventoryStatus)}")"
                                                 Text="@LotStatusLabel(lot.InventoryStatus)" />
                                </div>
                                <div class="wh03-compact-row sub">
                                    <span>@Text(lot.ItemNo) · @Text(lot.ItemName)</span>
                                    <strong>@Qty(lot.RemainingQty, null)</strong>
                                </div>
                                <div class="wh03-compact-location">
                                    <span>Location @Text(lot.LocationId)</span>
                                    <strong>Produced @DateText(lot.ProductionDate)</strong>
                                </div>
                            </RadzenCard>
                        }
                    </div>
                }
            }
        }
        else
        {
            <RadzenCard class="wh03-work-card">
                <div class="wh03-work-head">
                    <div>
                        <span>@_workTab.ToUpperInvariant()</span>
                        <strong>@(IsAdjustTab ? "Inventory Quantity Adjustment" : "Inventory Location Change")</strong>
                    </div>
                    @if (!IsAdjustTab)
                    {
                        <em>Scan LOT No first</em>
                    }
                </div>

                @if (!IsAdjustTab)
                {
                    <div class="wh03-mode-row">
                        <RadzenButton class="@InvModeClass("LOCAL")" Click='@(() => SetInventoryMode("LOCAL"))' Text="LOCAL" />
                        <RadzenButton class="@InvModeClass("CKD")" Click='@(() => SetInventoryMode("CKD"))' Text="CKD" />
                    </div>
                }

                <div class="@($"wh03-work-scan {ScanPanelClass}")">
                    <div class="pda-fld">
                        <label>LOT NO SCAN</label>
                        <RadzenTextBox class="pda-input wh03-work-input pda-scan-input"
                                       Value="@_invBarcode"
                                       @oninput="OnInventoryBarcodeInput"
                                       @onkeydown="OnInventoryLotKey"
                                       Placeholder="@InventoryBarcodePlaceholder" />
                    </div>
                    @if (ShowDeveloperScanButtons)
                    {
                        <RadzenButton class="wh03-work-scan-btn" Click="@ScanInventoryLot" Disabled="@DisableInventoryScan" Text="SCAN" />
                    }
                </div>
            </RadzenCard>

            @if (IsAdjustTab && _invScan is not null)
            {
                <RadzenCard class="wh03-work-card wh03-adjust-stock">
                    <dl class="wh03-adjust-stock-list">
                        <div><dt>Part No</dt><dd>@Text(_invScan.PartNo)</dd></div>
                        <div><dt>Part Name</dt><dd>@Text(_invScan.PartName)</dd></div>
                        <div><dt>Qty</dt><dd>@Qty(_invScan.Qty, _invScan.Unit)</dd></div>
                        <div><dt>Location</dt><dd>@Text(_invScan.ReceivedLocation)</dd></div>
                    </dl>
                </RadzenCard>
            }
            else if (_invScan is not null)
            {
                <RadzenCard class="@($"wh03-work-card wh03-lot-card {InventoryLotCardClass}")">
                    <div class="wh03-lot-top">
                        <div>
                            <span>LOT NO</span>
                            <strong>@Text(_invScan.LotNo)</strong>
                        </div>
                        <RadzenBadge class="@($"wh03-status-badge {InventoryStatusClass}")" Text="@InventoryStatusLabel" />
                    </div>
                    <div class="wh03-lot-part">
                        <strong>@Text(_invScan.PartNo)</strong>
                        <span>@Text(_invScan.PartName)</span>
                    </div>
                    <div class="wh03-info-grid">
                        @foreach (var field in InventoryLotFields())
                        {
                            <div class="wh03-info-box">
                                <span>@field.Label</span>
                                <strong>@field.Value</strong>
                            </div>
                        }
                    </div>
                </RadzenCard>
            }

            @if (IsAdjustTab && _invScan is not null)
            {
                <RadzenCard class="@($"wh03-work-card wh03-action-card {(!InventoryAlreadyReceived ? "disabled" : "")}")">
                    <div class="wh03-section-title">ADJUSTMENT</div>
                    <div class="wh03-form-grid">
                        <div class="pda-fld">
                            <label>REASON CODE</label>
                            <div class="wh03-reason-select">
                                <select class="pda-input wh03-work-input" aria-label="Reason code" @bind="_invAdjustReason" disabled="@(!InventoryAlreadyReceived || InventoryBusy)">
                                    @foreach (var reason in AdjustReasons)
                                    {
                                        <option value="@reason.Code">@reason.Label</option>
                                    }
                                </select>
                                <RadzenIcon Icon="expand_more" class="wh03-reason-arrow" aria-hidden="true" />
                            </div>
                        </div>
                        <div class="pda-fld">
                            <label>ADJUST QTY</label>
                            <div class="wh03-qty-stepper">
                                <button type="button"
                                        class="wh03-qty-step"
                                        @onclick="@(() => StepInventoryAdjust(-1))"
                                        disabled="@DisableAdjustQtyMinus">-</button>
                                <div class="@($"wh03-qty-readout {AdjustDeltaClass}")" aria-live="polite">
                                    <strong>@AdjustQuantityLabel</strong>
                                </div>
                                <button type="button"
                                        class="wh03-qty-step"
                                        @onclick="@(() => StepInventoryAdjust(1))"
                                        disabled="@DisableAdjustQtyPlus">+</button>
                            </div>
                        </div>
                        <div class="pda-fld">
                            <label>SUPERVISOR</label>
                            <div class="wh03-reason-select">
                                <select class="pda-input wh03-work-input" aria-label="Supervisor" @bind="_invAdjustSupervisorEmployeeNo" @bind:after="ClearSupervisorPin" disabled="@(!InventoryAlreadyReceived || InventoryBusy || _invSupervisors.Count == 0)">
                                    <option value="">@(_invSupervisors.Count == 0 ? "No supervisors available" : "Select supervisor")</option>
                                    @foreach (var supervisor in _invSupervisors)
                                    {
                                        <option value="@supervisor.EmployeeNo">@supervisor.EmployeeName (@supervisor.EmployeeNo)</option>
                                    }
                                </select>
                                <RadzenIcon Icon="expand_more" class="wh03-reason-arrow" aria-hidden="true" />
                            </div>
                        </div>
                        <div class="pda-fld">
                            <label>PIN</label>
                            <input class="pda-input wh03-work-input" type="password" inputmode="none" autocomplete="off"
                                   value="@_invAdjustSupervisorPin" readonly aria-label="Supervisor PIN" aria-haspopup="dialog"
                                   @onclick="OpenSupervisorPinPad" @onkeydown="OnSupervisorPinKey"
                                   disabled="@(!InventoryAlreadyReceived || InventoryBusy || string.IsNullOrWhiteSpace(_invAdjustSupervisorEmployeeNo))" />
                        </div>
                        <div class="pda-fld wh03-form-wide">
                            <label>NOTE</label>
                            <textarea class="pda-input wh03-work-note" rows="2" @bind="_invAdjustNote" disabled="@(!InventoryAlreadyReceived || InventoryBusy)"></textarea>
                        </div>
                    </div>

                    <div class="wh03-action-row">
                        <RadzenButton class="wh03-date-clear" Click="@ClearInventoryWork" Disabled="@InventoryBusy" Text="CLEAR" />
                        <RadzenButton class="wh03-date-apply wh03-post-btn ready save" Click="@PostInventoryAdjust" Disabled="@InventoryBusy" Text="SAVE" />
                    </div>
                </RadzenCard>
            }

            @if (IsLocatingTab)
            {
                <RadzenCard class="@($"wh03-work-card wh03-action-card {(!InventoryAlreadyReceived ? "disabled" : "")}")">
                    <div class="wh03-section-title">CURRENT LOCATION</div>
                    @if (_inventoryCurrentLocation is not null)
                    {
                        <div class="wh03-location-mini-card">
                            <strong>@Text(_inventoryCurrentLocation.LocationId)</strong>
                            <span>@Text(_inventoryCurrentLocation.LocationName ?? _inventoryCurrentLocation.ZoneName ?? _inventoryCurrentLocation.Zone)</span>
                            <div class="wh03-info-grid">
                                @foreach (var field in LocationFieldsFor(_inventoryCurrentLocation))
                                {
                                    <div class="wh03-info-box">
                                        <span>@field.Label</span>
                                        <strong>@field.Value</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="pda-empty compact">No current location loaded.</div>
                    }

                    <div class="@($"wh03-work-scan wh03-location-scan {ScanPanelClass}")">
                        <div class="pda-fld">
                            <label>NEW LOCATION NO SCAN</label>
                            <RadzenTextBox class="pda-input wh03-work-input pda-scan-input"
                                           Value="@_invLocationNo"
                                           @oninput="OnInventoryLocationInput"
                                           @onkeydown="OnInventoryLocationKey"
                                           Placeholder="Scan new location no"
                                           Disabled="@(!InventoryAlreadyReceived || InventoryBusy)" />
                        </div>
                        @if (ShowDeveloperScanButtons)
                        {
                            <RadzenButton class="wh03-work-scan-btn" Click="@ScanInventoryLocation" Disabled="@DisableInventoryLocationScan" Text="SCAN" />
                        }
                    </div>

                    @if (_invTargetLocation is not null)
                    {
                        <div class="wh03-location-mini-card target">
                            <strong>@Text(_invTargetLocation.LocationId)</strong>
                            <span>@Text(_invTargetLocation.LocationName ?? _invTargetLocation.ZoneName ?? _invTargetLocation.Zone)</span>
                            <div class="wh03-info-grid">
                                @foreach (var field in LocationFieldsFor(_invTargetLocation))
                                {
                                    <div class="wh03-info-box">
                                        <span>@field.Label</span>
                                        <strong>@field.Value</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="wh03-action-row">
                        <RadzenButton class="wh03-date-clear" Click="@ClearInventoryWork" Disabled="@InventoryBusy" Text="CLEAR" />
                        <RadzenButton class="@($"wh03-date-apply wh03-post-btn {(DisableInventoryMove ? "blocked" : "ready")}")" Click="@ConfirmInventoryMove" Disabled="@DisableInventoryMove" Text="CONFIRM MOVE" />
                    </div>
                </RadzenCard>
            }

            @if (!string.IsNullOrWhiteSpace(_invMsg))
            {
                <div class="pda-status @_invCls">@_invMsg</div>
            }
        }
    </div>

    @if (_dateFilterOpen)
    {
        <div class="wh03-filter-backdrop" @onclick="CloseDateFilters">
            <RadzenCard class="wh03-filter-sheet" @onclick:stopPropagation="true">
                <div class="wh03-filter-sheet-head">
                    <div>
                        <span>DATE FILTER</span>
                        <strong>Stock Date</strong>
                    </div>
                    <RadzenButton class="wh03-sheet-close" Click="@CloseDateFilters" Icon="close" Text="" />
                </div>
                <div class="wh03-date-panel">
                    <div class="pda-fld">
                        <label>FROM</label>
                        <RadzenDatePicker TValue="DateTime?"
                                          @bind-Value="_dateFrom"
                                          DateFormat="yyyy-MM-dd"
                                          AllowClear="false"
                                          Max="@DateTo"
                                          Placeholder="YYYY-MM-DD"
                                          class="wh03-date-picker" />
                    </div>
                    <div class="pda-fld">
                        <label>TO</label>
                        <RadzenDatePicker TValue="DateTime?"
                                          @bind-Value="_dateTo"
                                          DateFormat="yyyy-MM-dd"
                                          AllowClear="false"
                                          Min="@DateFrom"
                                          Placeholder="YYYY-MM-DD"
                                          class="wh03-date-picker" />
                    </div>
                    <div class="wh03-date-actions">
                        <RadzenButton class="wh03-date-clear" Click="@ClearDateFilter" Disabled="@_isLoading" Text="CLEAR" />
                        <RadzenButton class="wh03-date-apply" Click="@ApplyDateFilter" Disabled="@_isLoading" Text="APPLY" />
                    </div>
                </div>
            </RadzenCard>
        </div>
    }

    @if (_pinPadOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseSupervisorPinPad">
            <RadzenCard class="wh-modal-card wh03-pin-dialog" role="dialog" aria-modal="true" aria-labelledby="wh03-pin-title" @onclick:stopPropagation="true">
                <div id="wh03-pin-title" class="wh-modal-title">Supervisor PIN</div>
                <div class="pda-pin-dots" aria-label="@($"{_pinPadDraft.Length} digits entered")" aria-live="polite">
                    @for (var i = 0; i < Math.Max(4, _pinPadDraft.Length); i++)
                    {
                        <span class="pda-pin-dot @(i < _pinPadDraft.Length ? "on" : "")" aria-hidden="true"></span>
                    }
                </div>
                <div class="pda-keypad">
                    @foreach (var digit in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
                    {
                        <button type="button" class="pda-key" @onclick="@(() => PressSupervisorPin(digit))">@digit</button>
                    }
                    <button type="button" class="pda-key del" aria-label="Delete last digit" @onclick="DeleteSupervisorPin">
                        <RadzenIcon Icon="backspace" />
                    </button>
                    <button type="button" class="pda-key" @onclick='@(() => PressSupervisorPin("0"))'>0</button>
                    <button type="button" class="pda-key ok" disabled="@(_pinPadDraft.Length < 4)" @onclick="ConfirmSupervisorPin">OK</button>
                </div>
                <div class="wh-modal-actions">
                    <RadzenButton class="wh-modal-btn secondary" Click="@CloseSupervisorPinPad" Text="CANCEL" />
                </div>
            </RadzenCard>
        </div>
    }

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="DismissModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@ModalMark</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions">
                    <RadzenButton class="wh-modal-btn primary" Click="@DismissModal" Text="OK" />
                </div>
            </RadzenCard>
        </div>
    }

    @if (_locationModalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseLocations">
            <RadzenCard class="wh-modal-card wh03-location-modal" @onclick:stopPropagation="true">
                <div class="wh03-location-modal-head">
                    <div>
                        <span>INVENTORY DETAIL</span>
                        <strong>@Text(_locationItem?.ItemNo)</strong>
                        <em>@Text(_locationItem?.ItemName)</em>
                    </div>
                    <RadzenButton class="wh03-location-close" Click="@CloseLocations" Text="CLOSE" />
                </div>

                @if (_locationItem is not null)
                {
                    <div class="wh03-inventory-detail-grid">
                        @foreach (var field in InventoryDetailFields(_locationItem))
                        {
                            <div>
                                <span>@field.Label</span>
                                <strong>@field.Value</strong>
                            </div>
                        }
                    </div>
                }

                @if (_locationsLoading)
                {
                    <div class="wh03-location-empty">Loading...</div>
                }
                else if (_locationRows.Count == 0)
                {
                    <div class="wh03-location-empty">No location stock found.</div>
                }
                else
                {
                    <div class="wh03-location-detail-list">
                        @foreach (var loc in _locationRows)
                        {
                            <div class="wh03-location-detail-card">
                                <div class="wh03-location-detail-top">
                                    <strong>@Text(loc.LocationId)</strong>
                                    <span>@Qty(loc.Qty, _locationItem?.Unit)</span>
                                </div>
                                <div class="wh03-location-detail-name">@Text(loc.LocationName ?? loc.ZoneName ?? loc.ZoneCode)</div>
                                <div class="wh03-location-detail-grid">
                                    <div>
                                        <span>Warehouse</span>
                                        <strong>@CodeName(loc.WarehouseCode, loc.WarehouseName)</strong>
                                    </div>
                                    <div>
                                        <span>Zone</span>
                                        <strong>@CodeName(loc.ZoneCode, loc.ZoneName)</strong>
                                    </div>
                                    <div>
                                        <span>Area</span>
