    private async Task Load()
    {
        if (_isLoading) return;

        if (IsAdjustTab)
        {
            return;
        }

        if (IsSearchTab && IsInventoryLocationView)
        {
            if (string.IsNullOrWhiteSpace(_locationQuery))
                await LoadInventoryLocations();
            else
                await LoadLocationInventory();
            return;
        }

        if (IsSearchTab && IsLotStatusView)
        {
            await LoadLotStatuses();
            return;
        }

        _isLoading = true;
        try
        {
            _msg = "Loading...";

            if (HasInvalidDate)
            {
                _rows = new();
                _msg = "Date format must be YYYY-MM-DD.";
                return;
            }

            if (DateFrom.HasValue && DateTo.HasValue && DateFrom.Value > DateTo.Value)
            {
                _rows = new();
                _msg = "Date range is invalid.";
                return;
            }

            _rows = await Api.WhInventoryAsync(_q, DateFrom, DateTo, ShouldSimulateInventoryApiFailure);
            _lastSyncAt = DateTime.Now;
            if (!StockStatuses.Contains(_statusFilter, StringComparer.OrdinalIgnoreCase))
                _statusFilter = "ALL";

            if (_rows.Count == 0)
            {
                _msg = "No inventory matches.";
            }
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
            ShowAlert("Inventory Load Failed", ex.Message, "fail");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ScanInventoryFilter()
    {
        if (_isLoading) return;

        if (IsLotStatusView)
        {
            await LoadLotStatuses();
            return;
        }

        var scanText = _q.Trim();
        if (!string.IsNullOrWhiteSpace(scanText))
        {
            var lookup = await Api.WhInventoryScanAsync(scanText);
            if (lookup is not null && !string.IsNullOrWhiteSpace(lookup.SearchText))
                _q = lookup.SearchText.Trim();
        }

        await Load();
    }

    private async Task LoadLotStatuses()
    {
        if (_isLoading) return;

        _isLoading = true;
        try
        {
            _lotStatuses = await Api.WhLotStatusesAsync(_q);
            _lastSyncAt = DateTime.Now;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyDateFilter()
    {
        await Load();
        if (!HasInvalidDate && !(DateFrom.HasValue && DateTo.HasValue && DateFrom.Value > DateTo.Value))
            _dateFilterOpen = false;
    }

    private async Task ClearDateFilter()
    {
        _dateFrom = null;
        _dateTo = null;
        _dateFilterOpen = false;
        await Load();
    }

    private async Task LoadLocationInventory()
    {
        if (_isLoading) return;

        var scanText = _locationQuery.Trim();
        if (string.IsNullOrWhiteSpace(scanText))
        {
            _matchedLocationIds = null;
            await LoadInventoryLocations();
            return;
        }

        _isLoading = true;
        _locationMsg = "Searching inventory...";
        CloseLocationInventory();

        try
        {
            if (_inventoryLocations.Count == 0)
                _inventoryLocations = await Api.WhLocationsAsync();

            var lookup = await Api.WhInventoryScanAsync(scanText);
            var location = _inventoryLocations.FirstOrDefault(row =>
                string.Equals(row.LocationId, scanText, StringComparison.OrdinalIgnoreCase));
            if (location is null
                && string.Equals(lookup?.SearchKind, "LOCATION", StringComparison.OrdinalIgnoreCase))
            {
                var locationNo = string.IsNullOrWhiteSpace(lookup?.SearchText) ? scanText : lookup.SearchText.Trim();
                location = _inventoryLocations.FirstOrDefault(row =>
                    string.Equals(row.LocationId, locationNo, StringComparison.OrdinalIgnoreCase));
                location ??= await Api.WhScanLocationAsync(locationNo);
            }

            if (location is not null)
            {
                if (_inventoryLocations.All(row => !string.Equals(row.LocationId, location.LocationId, StringComparison.OrdinalIgnoreCase)))
                    _inventoryLocations.Add(location);

                _matchedLocationIds = new(StringComparer.OrdinalIgnoreCase) { location.LocationId };
                _locationMsg = location.TotalQty > 0 || location.LineCount > 0
                    ? ""
                    : "No inventory exists in this location.";
                return;
            }

            var searchText = string.IsNullOrWhiteSpace(lookup?.SearchText) ? scanText : lookup.SearchText.Trim();
            var inventoryRows = await Api.WhInventoryAsync(searchText);
            var locationIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var row in inventoryRows)
            {
                var itemLocations = await Api.WhInventoryLocationsAsync(row.ItemNo);
                foreach (var itemLocation in itemLocations.Where(itemLocation => itemLocation.Qty > 0))
                    locationIds.Add(itemLocation.LocationId);

                if (itemLocations.Count == 0 && row.OnHandQty > 0 && !string.IsNullOrWhiteSpace(row.LocationId))
                    locationIds.Add(row.LocationId);
            }

            _matchedLocationIds = locationIds;
            _locationMsg = locationIds.Count == 0 ? "No inventory matches this barcode." : "";
        }
        catch (Exception ex)
        {
            _matchedLocationIds = new(StringComparer.OrdinalIgnoreCase);
            _locationMsg = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadInventoryLocations()
    {
        if (_isLoading) return;

        _isLoading = true;
        _locationMsg = "Loading locations...";

        try
        {
            _inventoryLocations = await Api.WhLocationsAsync();
            _locationMsg = _inventoryLocations.Count == 0 ? "No locations found." : "";
        }
        catch (Exception ex)
        {
            _inventoryLocations = new();
            _locationMsg = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenInventoryLocation(string locationNo)
    {
        if (_isLoading || string.IsNullOrWhiteSpace(locationNo)) return;

        _isLoading = true;
        _locationMsg = "Loading location inventory...";

        try
        {
            var location = await Api.WhScanLocationAsync(locationNo.Trim())
                ?? _inventoryLocations.FirstOrDefault(row =>
                    string.Equals(row.LocationId, locationNo.Trim(), StringComparison.OrdinalIgnoreCase));
            if (location is null)
            {
                _selectedInventoryLocation = null;
                _locationItems = new();
                _locationMsg = "Location No was not found.";
                return;
            }

            _selectedInventoryLocation = location;
            _locationItems = await Api.WhLocationMapItemsAsync(location.LocationId);
            _locationMsg = _locationItems.Count == 0
                ? "No inventory exists in this location."
                : "";
        }
        catch (Exception ex)
        {
            _selectedInventoryLocation = null;
            _locationItems = new();
            _locationMsg = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

