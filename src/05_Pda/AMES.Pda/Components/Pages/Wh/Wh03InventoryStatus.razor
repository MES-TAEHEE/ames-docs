    private void PrepareTestScenario(InventoryTestScenario scenario)
    {
        _workTab = "Search";
        _inventoryView = scenario.Values.FirstOrDefault()?.Action == "API_QUERY" ? "Part" : "Location";
        _q = "";
        _locationQuery = "";
        _matchedLocationIds = null;
        _msg = "";
        _locationMsg = "";
        CloseBrowsePart();
        CloseLocationInventory();

        if (scenario.Values.FirstOrDefault() is { } value)
        {
            if (value.Action == "API_QUERY")
                _q = value.Value;
            else if (value.Action is "SEARCH" or "OPEN_LOCATION")
                _locationQuery = value.Value;
        }
