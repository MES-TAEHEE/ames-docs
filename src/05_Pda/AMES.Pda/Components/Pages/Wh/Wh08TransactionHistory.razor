@page "/wh/08"
@inject PdaApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh08-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/wh"))' Text="&lt;" />
        <div class="wh08-tbar-title">
            <span class="pda-tbar-brand">TRANSACTIONS</span>
        </div>
        <div class="wh08-tbar-actions">
            <RadzenButton class="wh08-refresh" Click="@Load" Disabled="@_loading" Text="REFRESH" />
        </div>
    </div>

    <div class="pda-bd wh08-body">
        <RadzenCard class="wh08-date-filter" @onfocusin="BeginFilterEdit" @onpointerdown="BeginFilterEdit">
            <div class="pda-card-h">TRANSACTION DATE</div>
            <div class="wh08-filter-date">
                <div class="pda-fld">
                    <label>FROM</label>
                    <RadzenDatePicker TValue="DateTime?"
                                      @bind-Value="_dateFrom"
                                      DateFormat="yyyy-MM-dd"
                                      AllowClear="false"
                                      Max="@DateTo"
                                      class="wh08-date-picker" />
                </div>
                <div class="pda-fld">
                    <label>TO</label>
                    <RadzenDatePicker TValue="DateTime?"
                                      @bind-Value="_dateTo"
                                      DateFormat="yyyy-MM-dd"
                                      AllowClear="false"
                                      Min="@DateFrom"
                                      class="wh08-date-picker" />
                </div>
            </div>
            <RadzenButton class="wh08-date-apply" Click="@Load" Disabled="@_loading" Text="APPLY" />
            <details class="wh08-additional-filters">
                <summary>More Filters</summary>
                <div class="pda-fld">
                    <label>WORKER ID</label>
                    <RadzenTextBox class="pda-input wh08-search-input"
                                   Value="@_worker"
                                   @oninput="OnWorkerInput"
                                   Placeholder="Worker ID" />
                </div>
                <div class="pda-fld">
                    <label>ADJ REASON</label>
                    <select class="pda-input wh08-search-input wh08-select" @bind="_reason">
                        <option value="">All reasons</option>
                        @foreach (var reason in ReasonOptions)
                        {
                            <option value="@reason">@reason</option>
                        }
                    </select>
                </div>
                <RadzenButton class="wh08-date-reset" Click="@ClearFilters" Disabled="@_loading" Text="CLEAR FILTERS" />
            </details>
        </RadzenCard>

        <div class="wh08-kpi-strip">
            <button type="button" class="@($"wh08-kpi all {TypeClass("")}")" @onclick='@(() => SetType(""))'>
                <span>ALL</span>
                <strong>@ConditionRows.Count().ToString("N0")</strong>
                <small>records</small>
            </button>
            <button type="button" class="@($"wh08-kpi in {TypeClass("IN")}")" @onclick='@(() => SetType("IN"))'>
                <span>IN</span>
                <strong>@InCount.ToString("N0")</strong>
                <small>records</small>
            </button>
            <button type="button" class="@($"wh08-kpi out {TypeClass("OUT")}")" @onclick='@(() => SetType("OUT"))'>
                <span>OUT</span>
                <strong>@OutCount.ToString("N0")</strong>
                <small>records</small>
            </button>
            <button type="button" class="@($"wh08-kpi adj {TypeClass("ADJ")}")" @onclick='@(() => SetType("ADJ"))'>
                <span>ADJ</span>
                <strong>@AdjCount.ToString("N0")</strong>
                <small>records</small>
            </button>
        </div>

        <RadzenCard class="wh08-search-card">
            <div class="pda-fld">
                <label>Search</label>
                @* Manual entry stays outside the scan-only selector; native scans use OnHardwareScanAsync. *@
                <RadzenTextBox class="pda-input wh08-search-input wh08-barcode-input"
                               Value="@_search"
                               @oninput="OnSearchInput"
                               @onkeydown="OnKey"
                               @onfocus="@(() => _editingBarcode = true)"
                               @onblur="@(() => _editingBarcode = false)"
                               Placeholder="Type or scan barcode" />
            </div>
            <div class="wh08-search-actions">
                <RadzenButton class="wh08-clear" Click="@ClearSearch" Disabled="@_loading" Text="CLEAR" />
                <RadzenButton class="wh08-search" Click="@Load" Disabled="@_loading" Icon="search" title="Search" aria-label="Search" />
            </div>
        </RadzenCard>

        @if (_loading)
        {
            <RadzenCard class="wh08-empty">Loading transactions...</RadzenCard>
        }
        else if (!FilteredRows.Any())
        {
            <RadzenCard class="wh08-empty">@_msg</RadzenCard>
        }
        else
        {
            <div class="wh08-list">
                @foreach (var row in FilteredRows)
                {
                    <RadzenCard class="@($"wh08-row-card {RowCardClass(row)}")">
                        <div class="wh08-row-top">
                            <div class="wh08-row-main">
                                <span>@LogDateText(row)</span>
                                <strong>@Text(row.LotNo)</strong>
                            </div>
                            <RadzenBadge class="@($"wh08-status {StatusClass(row.Status)}")" Text="@Text(row.Status)" />
                        </div>

                        <div class="wh08-row-part">
                            <strong>@Text(row.PartNo)</strong>
                            <span>@Text(row.LocationId)</span>
                        </div>

                        <dl class="wh08-value-rows">
                            <div><dt>@(IsAdjust(row) ? "Change" : $"{row.Direction} Qty")</dt><dd>@(IsAdjust(row) ? SignedQtyText(row.DeltaQty) : QtyText(MovementQty(row))) @Text(row.Unit)</dd></div>
                            <div><dt>Worker</dt><dd>@Text(row.WorkerId)</dd></div>
                        </dl>

                        @if (IsAdjust(row))
                        {
                            <button type="button" class="wh08-detail-btn" @onclick="@(() => OpenDetail(row))">
                                DETAIL
                            </button>
                        }
                    </RadzenCard>
                }
            </div>
        }
    </div>

    @if (_detailRow is { } detail)
    {
        <div class="wh-modal-backdrop" @onclick="CloseDetail" @onkeydown="OnDetailKey" tabindex="-1" @ref="_detailDialog">
            <RadzenCard class="wh-modal-card wh08-detail-dialog" role="dialog" aria-modal="true" aria-labelledby="wh08-detail-title" @onclick:stopPropagation="true">
                <h2 id="wh08-detail-title" class="wh-modal-title">Adjustment Detail</h2>
                <dl class="wh08-value-rows wh08-detail-rows">
                    <div><dt>Lot No</dt><dd>@Text(detail.LotNo)</dd></div>
                    <div><dt>Part No</dt><dd>@Text(detail.PartNo)</dd></div>
                    <div><dt>Location</dt><dd>@Text(detail.LocationId)</dd></div>
                    <div><dt>Date</dt><dd>@LogDateText(detail)</dd></div>
                    <div><dt>Before</dt><dd>@QtyText(detail.BeforeQty) @Text(detail.Unit)</dd></div>
                    <div><dt>Change</dt><dd class="@DeltaClass(detail.DeltaQty)">@SignedQtyText(detail.DeltaQty) @Text(detail.Unit)</dd></div>
                    <div><dt>After</dt><dd>@QtyText(detail.AfterQty) @Text(detail.Unit)</dd></div>
                    <div><dt>Reason</dt><dd>@Text(detail.ReasonCode)</dd></div>
                    <div><dt>Note</dt><dd>@Text(detail.ReasonNote)</dd></div>
                    <div><dt>Worker</dt><dd>@Text(detail.WorkerId)</dd></div>
                    <div><dt>Supervisor</dt><dd>@Text(detail.Supervisor)</dd></div>
                </dl>
                <div class="wh-modal-actions">
                    <RadzenButton class="wh-modal-btn primary wh08-detail-close" Click="CloseDetail" Text="CLOSE" />
                </div>
            </RadzenCard>
        </div>
    }

</div>

@code {
    private static DateTime DefaultDateFrom => DateTime.Today.AddDays(-30);
    private static DateTime DefaultDateTo => DateTime.Today;

    private DateTime? _dateFrom = DefaultDateFrom;
    private DateTime? _dateTo = DefaultDateTo;
    private string _search = "";
    private string _worker = "";
    private string _reason = "";
    private string _type = "";
    private string _msg = "Loading transactions...";
    private bool _loading;
    private bool _editingFilters;
    private bool _editingBarcode;
    private List<PdaApi.WarehouseTransactionRow> _rows = new();
    private PdaApi.WarehouseTransactionRow? _detailRow;
    private ElementReference _detailDialog;
    private bool _focusDetail;
    private DotNetObjectReference<Wh08TransactionHistory>? _scannerRef;

    private DateTime? DateFrom => _dateFrom?.Date;
    private DateTime? DateTo => _dateTo?.Date;
    private IEnumerable<PdaApi.WarehouseTransactionRow> ConditionRows => _rows.Where(MatchesConditions).ToList();
    private IEnumerable<PdaApi.WarehouseTransactionRow> FilteredRows => ConditionRows.Where(MatchesType).ToList();
    private int InCount => ConditionRows.Count(r => IsDirection(r, "IN"));
    private int OutCount => ConditionRows.Count(r => IsDirection(r, "OUT"));
    private int AdjCount => ConditionRows.Count(r => IsDirection(r, "ADJ"));
    private IEnumerable<string> ReasonOptions => _rows
        .Where(IsAdjust)
        .Select(r => r.ReasonCode)
        .Where(r => !string.IsNullOrWhiteSpace(r))
        .Select(r => r!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(r => r);

    protected override async Task OnInitializedAsync() => await Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
            _scannerRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = MauiProgram.IsDeveloperMode });
        }

        if (_focusDetail)
        {
            _focusDetail = false;
            await _detailDialog.FocusAsync();
        }
        else
            await FocusScannerAsync();
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        var value = NormalizeHardwareScan(scanText);
        if (string.IsNullOrWhiteSpace(value))
            return;

        await InvokeAsync(async () =>
        {
            if (_detailRow is not null || _loading)
                return;
            _search = value;
            await Load();
            StateHasChanged();
        });
    }

    private void OnNativeBarcodeScanned(string barcode)
    {
        _ = InvokeAsync(async () => await OnHardwareScanAsync(barcode));
    }

    private async Task FocusScannerAsync()
    {
        if (_editingFilters || _editingBarcode || _detailRow is not null)
            return;

        try
        {
            await JS.InvokeVoidAsync("pdaScan.focus", ".wh08-barcode-input");
        }
        catch
        {
            // Ignore focus failures while the WebView is navigating.
        }
    }

    private static string NormalizeHardwareScan(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Replace("\u0002", "").Replace("\u0003", "").Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;

        try
        {
            await JS.InvokeVoidAsync("pdaScan.unregister");
        }
        catch
        {
            // Ignore dispose-time JS disconnects.
        }

        _scannerRef?.Dispose();
    }

    private async Task Load()
    {
        if (_loading) return;
        _editingFilters = false;
        _loading = true;
        _search = NormalizeHardwareScan(_search);
        _msg = "Loading transactions...";

        try
        {
            if (DateFrom.HasValue && DateTo.HasValue && DateFrom.Value > DateTo.Value)
            {
                _rows = new();
                _msg = "From date cannot be after To date.";
                return;
            }

            _rows = await Api.WhWarehouseTransactionsAsync(_search, DateFrom, DateTo);
            _detailRow = null;
            _msg = string.IsNullOrWhiteSpace(_search)
                ? "No transactions found for the selected conditions."
                : "No transactions found for this barcode in the selected date range.";
        }
        catch
        {
            _rows = new();
            _msg = "Warehouse transaction service is unavailable. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearSearch()
    {
        _search = "";
        await Load();
    }

    private async Task ClearFilters()
    {
        _worker = "";
        _reason = "";
        _dateFrom = DefaultDateFrom;
        _dateTo = DefaultDateTo;
        await Load();
    }

    private void BeginFilterEdit() => _editingFilters = true;

    private void OnSearchInput(ChangeEventArgs e)
    {
        _editingFilters = false;
        _search = e.Value?.ToString() ?? "";
    }

    private void OnWorkerInput(ChangeEventArgs e)
    {
        _worker = e.Value?.ToString() ?? "";
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Load();
    }

    private string TypeClass(string type) => string.Equals(_type, type, StringComparison.OrdinalIgnoreCase) ? "on" : "";

    private void SetType(string type)
    {
        _type = type;
    }

    private void OpenDetail(PdaApi.WarehouseTransactionRow row)
    {
        _detailRow = row;
        _focusDetail = true;
    }

    private void CloseDetail() => _detailRow = null;

    private void OnDetailKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseDetail();
    }

    private bool MatchesConditions(PdaApi.WarehouseTransactionRow row)
    {
        // Barcode matching belongs to SQL, including package-to-LOT relationships.
        return Contains(row.WorkerId, _worker)
            && (string.IsNullOrWhiteSpace(_reason) || string.Equals(row.ReasonCode, _reason, StringComparison.OrdinalIgnoreCase));
    }

    private static decimal MovementQty(PdaApi.WarehouseTransactionRow row) => Math.Abs(row.DeltaQty ?? row.Qty);

    private bool MatchesType(PdaApi.WarehouseTransactionRow row)
    {
        return string.IsNullOrWhiteSpace(_type) || IsDirection(row, _type);
    }

    private static bool Contains(string? value, string filter)
    {
        return string.IsNullOrWhiteSpace(filter)
            || (!string.IsNullOrWhiteSpace(value) && value.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string QtyText(decimal? value) => value?.ToString("#,##0.###") ?? "-";
    private static string SignedQtyText(decimal? value)
    {
        if (!value.HasValue) return "-";
        var prefix = value.Value > 0 ? "+" : "";
        return $"{prefix}{QtyText(value)}";
    }

    private static string DeltaClass(decimal? value)
    {
        if (!value.HasValue || value.Value == 0) return "";
        return value.Value > 0 ? "plus" : "minus";
    }

    private static string LogDateText(PdaApi.WarehouseTransactionRow row)
    {
        var date = Text(row.WorkDate);
        return string.IsNullOrWhiteSpace(row.WorkTime) ? date : $"{date} {row.WorkTime}";
    }

    private static bool IsAdjust(PdaApi.WarehouseTransactionRow row) => IsDirection(row, "ADJ");
    private static bool IsDirection(PdaApi.WarehouseTransactionRow row, string direction)
        => string.Equals(row.Direction, direction, StringComparison.OrdinalIgnoreCase);

    private static string RowCardClass(PdaApi.WarehouseTransactionRow row)
        => row.Direction?.ToUpperInvariant() switch
        {
            "IN" => "inbound",
            "OUT" => "outbound",
            "ADJ" => "adjust",
            _ => "other"
        };

    private static string StatusClass(string? status)
    {
        var value = status?.Trim().ToLowerInvariant() ?? "";
        if (value == "in") return "in";
        if (value.Contains("adjust")) return "adjust";
        if (value.Contains("cancel")) return "cancel";
        if (value.Contains("out")) return "out";
        if (value.Contains("loss")) return "loss";
        return "stock";
    }
}
