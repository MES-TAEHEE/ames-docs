@page "/wh/01"
@implements IDisposable
@inject PdaApi Api
@inject NavigationManager Nav
@inject AuthState Auth

<div class="pda-shell wh wh01-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/wh"))' Text="&lt;" />
        <div class="wh01-tbar-title">
            <span class="pda-tbar-brand">SCHEDULE</span>
        </div>
        <RadzenButton class="wh01-tbar-refresh" Click="@Load" Disabled="@_isLoading" Text="REFRESH" />
    </div>

    <div class="pda-bd wh01-body">
        <RadzenCard class="wh01-date-filter">
            <div class="pda-card-h">DUE DATE</div>
            <div class="wh01-filter-dates">
                <div class="pda-fld">
                    <label>FROM</label>
                    <RadzenDatePicker TValue="DateTime?"
                                      @bind-Value="_dateFrom"
                                      DateFormat="yyyy-MM-dd"
                                      AllowClear="false"
                                      Max="@_dateTo"
                                      class="wh01-date-picker" />
                </div>
                <div class="pda-fld">
                    <label>TO</label>
                    <RadzenDatePicker TValue="DateTime?"
                                      @bind-Value="_dateTo"
                                      DateFormat="yyyy-MM-dd"
                                      AllowClear="false"
                                      Min="@_dateFrom"
                                      class="wh01-date-picker" />
                </div>
            </div>
            <RadzenButton class="wh01-date-apply" Click="@ApplyDateRange" Disabled="@_isLoading" Text="APPLY" />
        </RadzenCard>

        <RadzenCard class="wh01-head">
            <div class="pda-card-h">WORK ORDER RELEASE</div>
            <div class="wh01-summary">
                <RadzenCard class="wh01-stat">
                    <span>Total</span>
                    <strong>@ReleaseTotalCount</strong>
                </RadzenCard>
                <RadzenCard class="wh01-stat open">
                    <span>Released</span>
                    <strong>@ReleasedCount</strong>
                </RadzenCard>
                <RadzenCard class="wh01-stat partial">
                    <span>In Progress</span>
                    <strong>@ReleaseInProgressCount</strong>
                </RadzenCard>
                <RadzenCard class="wh01-stat late">
                    <span>Late</span>
                    <strong>@ReleaseLateCount</strong>
                </RadzenCard>
            </div>
        </RadzenCard>

        @if (_releaseSchedule.Count == 0)
        {
            <div class="pda-empty">@_releaseMsg</div>
        }
        else
        {
            <div class="wh01-list">
                @foreach (var row in _releaseSchedule)
                {
                    <RadzenCard class="@($"wh01-release-card {ReleaseStatusClass(row)}")">
                        <div class="wh01-card-top wh01-card-top-compact">
                            <div class="wh01-po-no">@row.PartNo</div>
                            <RadzenBadge class="@($"wh01-status {ReleaseStatusClass(row)}")" Text="@ReleaseStatusText(row)" />
                        </div>

                        <div class="wh01-release-facts">
                            <div>
                                <span>Qty</span>
                                <strong>@row.OrderQty.ToString("N0") @(row.Unit ?? "EA")</strong>
                            </div>
                            <div>
                                <span>Due Date</span>
                                <strong>@(row.DueDate?.ToString("MM/dd/yyyy") ?? "-")</strong>
                            </div>
                        </div>
                    </RadzenCard>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<PdaApi.Wh001ScheduleReleaseItem> _releaseSchedule = new();
    private string _releaseMsg = "Loading...";
    private DateTime? _dateFrom = DateTime.Today.AddDays(-30);
    private DateTime? _dateTo = DateTime.Today.AddDays(30);
    private System.Threading.Timer? _autoSyncTimer;
    private bool _isLoading;
    private static readonly TimeSpan AutoSyncInterval = TimeSpan.FromHours(1);

    private int ReleaseTotalCount => _releaseSchedule.Count;
    private int ReleasedCount => _releaseSchedule.Count(r => ReleaseStatusKey(r) == "released");
    private int ReleaseInProgressCount => _releaseSchedule.Count(r => ReleaseStatusKey(r) == "in progress");
    private int ReleaseLateCount => _releaseSchedule.Count(IsReleaseLate);

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _autoSyncTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                await Load();
                StateHasChanged();
            });
        }, null, AutoSyncInterval, AutoSyncInterval);
    }

    private async Task Load()
    {
        if (_isLoading) return;

        _isLoading = true;
        try
        {
            _releaseMsg = "Loading...";

            _releaseSchedule = await Api.Wh001ScheduleReleaseAsync(_dateFrom, _dateTo);

            if (_releaseSchedule.Count == 0) _releaseMsg = "No work orders found for this date range.";

        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyDateRange()
    {
        if (_dateFrom.HasValue && _dateTo.HasValue && _dateFrom.Value.Date > _dateTo.Value.Date)
        {
            _releaseSchedule = [];
            _releaseMsg = "From date cannot be after To date.";
            return;
        }

        await Load();
    }

    private static string ReleaseStatusKey(PdaApi.Wh001ScheduleReleaseItem row)
        => (row.WorkOrderStatus ?? "Released").Trim().ToLowerInvariant();

    private static bool IsReleaseLate(PdaApi.Wh001ScheduleReleaseItem row)
        => row.DueDate.HasValue && row.DueDate.Value.Date < DateTime.Today;

    private static string ReleaseStatusClass(PdaApi.Wh001ScheduleReleaseItem row)
        => IsReleaseLate(row) ? "late" : ReleaseStatusKey(row) == "in progress" ? "partial" : "open";

    private static string ReleaseStatusText(PdaApi.Wh001ScheduleReleaseItem row)
        => IsReleaseLate(row) ? "Late" : row.WorkOrderStatus;

    public void Dispose()
    {
        _autoSyncTimer?.Dispose();
    }
}
