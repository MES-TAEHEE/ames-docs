@page "/wh/02"
@inject PdaApi Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh02-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/wh"))' Text="&lt;" />
        <span class="pda-tbar-brand">INBOUND</span>
        @if (IsTestMode)
        {
            <button class="wh02-test-nav" @onclick="OpenTestPanel">SCENARIO</button>
        }
    </div>

    <div class="pda-bd wh02-body">
        <div class="wh02-mode">
            <RadzenButton class="@($"wh02-mode-btn {ModeClass("LOCAL")}")" Click='@(() => SetMode("LOCAL"))' Text="LOCAL" />
            <RadzenButton class="@($"wh02-mode-btn {ModeClass("CKD")}")" Click='@(() => SetMode("CKD"))' Text="CKD" />
        </div>

        <RadzenCard class="@($"wh02-panel wh02-scan-panel {ScanPanelClass}")">
            <div class="pda-fld">
                <label>BARCODE SCAN</label>
                <RadzenTextBox class="pda-input wh02-barcode-input pda-scan-input"
                               Value="@_barcode"
                               @oninput="OnBarcodeInput"
                               @onkeydown="OnKey"
                               Placeholder="@BarcodePlaceholder" />
            </div>
        </RadzenCard>

        @if (_document is not null && !_isLocationChangeMode)
        {
            <RadzenCard class="wh02-document-card">
                <div class="wh02-document-head">
                    <div>
                        <span>@DocumentTitle</span>
                        <strong>@Text(_document.DocumentNo ?? _document.DocumentBarcode)</strong>
                    </div>
                    <RadzenBadge class="wh02-document-progress"
                                 Text="@($"{DisplayScannedBoxes} / {_document.TotalBoxes}")" />
                </div>

                <div class="wh02-document-meta">
                    @foreach (var field in DocumentFields())
                    {
                        <div><span>@field.Label</span><strong>@field.Value</strong></div>
                    }
                </div>

                <div class="wh02-document-lines">
                    @foreach (var line in _documentLines)
                    {
                        <div class="wh02-document-part @(DisplayScanCount(line) >= line.BoxCount ? "complete" : "")">
                            <div class="wh02-document-line">
                                <div>
                                    <strong>@line.PartNo</strong>
                                    <span>@Text(line.PartName)</span>
                                </div>
                                <b>@DisplayScanCount(line) / @line.BoxCount BOX</b>
                            </div>
                            <div class="wh02-box-list">
                                @foreach (var box in DocumentBoxes(line.PartNo))
                                {
                                    <div class="wh02-box-row @(string.Equals(box.Yn, "Y", StringComparison.OrdinalIgnoreCase) ? "received" : IsBoxScanned(box) ? "scanned" : "")">
                                        <span>@box.BoxBarcode</span>
                                        <strong>@QuantityText(box.Qty, box.Unit)</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </RadzenCard>
        }

        @if (_scan is not null && !_isLocationChangeMode)
        {
            <RadzenCard class="@($"wh02-lot-card {(AlreadyReceived ? "received" : "ready")}")">
                <div class="wh02-lot-top">
                    <div class="wh02-lot-main">
                        <span>BOX BARCODE</span>
                        <strong>@Text(_scan.Barcode)</strong>
                    </div>
                    <div class="wh02-lot-tags">
                        <RadzenBadge class="wh02-type-chip" Text="@_scan.ReceiveType" />
                        <RadzenBadge class="@($"wh02-status-chip {StatusChipClass}")" Text="@ItemStatusLabel" />
                    </div>
                </div>

                <div class="wh02-part">
                    <div class="wh02-part-no">@Text(_scan.PartNo)</div>
                    <div class="wh02-part-name">@Text(_scan.PartName)</div>
                </div>

                <div class="wh02-info-grid">
                    @foreach (var field in CommonFields())
                    {
                        <div class="wh02-info">
                            <span>@field.Label</span>
                            <strong>@field.Value</strong>
                        </div>
                    }
                </div>

                <div class="wh02-section-title">@_scan.ReceiveType DETAIL</div>
                <div class="wh02-info-grid">
                    @foreach (var field in ModeFields())
                    {
                        <div class="wh02-info">
                            <span>@field.Label</span>
                            <strong>@field.Value</strong>
                        </div>
                    }
                </div>
            </RadzenCard>
        }

        @if (_isLocationChangeMode)
        {
            <RadzenCard class="wh02-location-card current">
                <div class="wh02-location-card-top">
                    <span>CURRENT LOCATION</span>
                    <strong>@Text(_changeFromLocation)</strong>
                    <em>@Text(_currentLocation?.LocationName ?? _currentLocation?.ZoneName ?? _currentLocation?.Zone)</em>
                </div>
                @if (_currentLocation is not null)
                {
                    <div class="wh02-location-list">
                        @foreach (var field in CurrentLocationFields())
                        {
                            <div class="wh02-location-row">
                                <span>@field.Label</span>
                                <strong>@field.Value</strong>
                            </div>
                        }
                    </div>
                }
            </RadzenCard>
        }

        <RadzenCard class="@($"wh02-panel wh02-location-panel {ScanPanelClass} {(LocationEntryDisabled ? "disabled" : "")} {(_highlightLocationScan ? "location-attention" : "")}")">
            <div class="pda-fld">
                <label>@LocationScanLabel</label>
                <RadzenTextBox class="pda-input wh02-location-input pda-scan-input"
                               Value="@_loc"
                               @oninput="OnLocationInput"
                               @onkeydown="OnLocationKey"
                               Placeholder="A0000"
                               Disabled="@LocationEntryDisabled" />
            </div>
        </RadzenCard>

        @if (_selectedLocation is not null && (!_isLocationChangeMode || !IsSameAsCurrentLocation(_selectedLocation.LocationId)))
        {
            <RadzenCard class="wh02-location-card">
                <div class="wh02-location-card-top">
                    <span>@(_isLocationChangeMode ? "NEW LOCATION NO" : "LOCATION NO")</span>
                    <strong>@_selectedLocation.LocationId</strong>
                    <em>@Text(_selectedLocation.LocationName ?? _selectedLocation.ZoneName ?? _selectedLocation.Zone)</em>
                </div>
                <div class="wh02-location-list">
                    @foreach (var field in LocationFields())
                    {
                        <div class="wh02-location-row">
                            <span>@field.Label</span>
                            <strong>@field.Value</strong>
                        </div>
                    }
                </div>
            </RadzenCard>
        }

        @if (!string.IsNullOrWhiteSpace(_msg))
        {
            <div class="pda-status @_cls">@_msg</div>
        }

        <div class='wh02-action-bar @ActionBarClass'>
            @if (_isLocationChangeMode)
            {
                <RadzenButton class="wh02-clear-btn" Click="@ResetForm" Disabled="@IsBusy" Text="CLEAR" />
                <RadzenButton class="@($"pda-btn-pri wh02-receive-btn wh02-confirm-btn {ConfirmMoveButtonClass}")" Click="@ConfirmLocationChange" Disabled="@IsBusy" Text="CONFIRM" />
            }
            else if (AlreadyReceived && _document is null)
            {
                <RadzenButton class="wh02-cancel-btn" Click="@CancelIncoming" Disabled="@DisableCancel" Text="CANCEL INCOMING" />
            }
            else
            {
                <RadzenButton class="wh02-clear-btn" Click="@ResetForm" Disabled="@IsBusy" Text="CLEAR" />
                <RadzenButton class="@($"pda-btn-pri wh02-receive-btn wh02-receive-action-btn {ReceiveButtonClass}")" Click="@Receive" Disabled="@IsBusy" Text="RECEIVE" />
            }
        </div>
    </div>

    @if (IsTestMode && _testPanelOpen)
    {
        <div class="wh02-test-backdrop" @onclick="CloseTestPanel">
            <section class="wh02-test-panel @(IsSimpleTestMode ? "wh02-simple-panel" : "")" @onclick:stopPropagation="true">
                <div class="wh02-test-head">
                    <div><span>@(IsSimpleTestMode ? "PPT CHECK" : "TEST MODE")</span><strong>@(IsSimpleTestMode ? "INBOUND 간편 검수" : "INBOUND TEST SCENARIOS")</strong></div>
                    <b>@CurrentTestScenario.No.ToString("00") / @ActiveTestScenarios.Length</b>
                    <button class="wh02-test-close" @onclick="CloseTestPanel" aria-label="Close scenarios">×</button>
                </div>
                <div class="wh02-test-tabs">
                    @foreach (var scenario in ActiveTestScenarios)
                    {
                        var index = scenario.No - 1;
                        <button class="@(index == _testScenarioIndex ? "on" : "")"
                                @onclick="@(() => SelectTestScenario(index))">@scenario.No.ToString("00")</button>
                    }
                </div>
                <div class="wh02-test-case">
                    <div class="wh02-test-summary">
                        <span>@CurrentTestScenario.TestCaseId</span>
                        <strong>@CurrentTestScenario.Title</strong>
                    </div>
                    @if (IsSimpleTestMode)
                    {
                        <p class="wh02-simple-guide">@CurrentTestScenario.Steps</p>
                        <div class="wh02-test-tabs wh02-simple-modes">
                            <button class="@(_simpleMode == "LOCAL" ? "on" : "")" @onclick='@(() => SelectSimpleMode("LOCAL"))'>LOCAL</button>
                            <button class="@(_simpleMode == "CKD" ? "on" : "")" @onclick='@(() => SelectSimpleMode("CKD"))'>CKD</button>
                        </div>
                    }
                    @if (CurrentTestValues.Length > 0)
                    {
                        <div class="wh02-test-values">
                            @foreach (var value in CurrentTestValues)
                            {
                                <button @onclick="@(() => LoadTestValue(value))">
                                    <span>@value.Label</span><b>@value.Value</b>
                                </button>
                            }
                        </div>
                    }
                    @if (!IsSimpleTestMode && CurrentTestScenario.No == 16)
                    {
                        <div class="wh02-test-actions">
                            <button @onclick='@(() => OpenScenarioPage("/wh/03"))'>OPEN INVENTORY</button>
                            <button @onclick='@(() => OpenScenarioPage("/wh/08"))'>OPEN TRANSACTIONS</button>
                        </div>
                    }
                    else if (CurrentTestScenario.No == (IsSimpleTestMode ? 5 : 18))
                    {
                        <button class="@($"wh02-test-error {(_simulateReceiveApiFailure ? "on" : "")}")"
                                @onclick="ToggleReceiveApiFailure">
                            API ERROR: @(_simulateReceiveApiFailure ? "ON" : "OFF")
                        </button>
                    }
                    <button class="wh02-test-start" disabled="@_simpleBusy" @onclick="StartTestScenario">@(IsSimpleTestMode ? "이 단계 시작" : "START SCENARIO")</button>
                    @if (IsSimpleTestMode)
                    {
                        <div class="wh02-test-actions">
                            <button disabled="@_simpleBusy" @onclick="ResetSimpleTestData">테스트 데이터 초기화</button>
                        </div>
                    }
                </div>
            </section>
        </div>
    }

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="DismissModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@ModalMark</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions">
                    @if (_modalConfirm)
                    {
                        <RadzenButton class="wh-modal-btn secondary" Click="@DismissModal" Text="CANCEL" />
                    }
                    <RadzenButton class="wh-modal-btn primary" Click="@ModalPrimary" Text="OK" />
                </div>
            </RadzenCard>
        </div>
    }

</div>

@code {
    private sealed record InboundTestValue(string Label, string Value, bool IsLocation = false);
    private sealed record InboundTestScenario(int No, string TestCaseId, string Title, string? Mode,
        string Steps, string Expected, bool AutoScan, params InboundTestValue[] Values);

    private static readonly InboundTestScenario[] InboundTestScenarios =
    [
        new(1, "WH002-TC-001", "LOCAL 작업 유형 선택", "LOCAL",
            "Start and confirm that LOCAL is selected.", "LOCAL is selected and barcode scanning is enabled.", false),
        new(2, "WH002-TC-002", "CKD 작업 유형 선택", "CKD",
            "Start and confirm that CKD is selected.", "CKD is selected and CKD rules are applied.", false),
        new(3, "WH002-TC-003", "LOT 단일 바코드 조회", "LOCAL",
            "Start to load one unreceived LOT.", "Part, name, quantity, LOT and box information are displayed.", true,
            new InboundTestValue("LOT", "5011LL260903900001")),
        new(4, "WH002-TC-004", "Box 단일 바코드 조회", "LOCAL",
            "Start to load one box from the LOCAL inbound list.", "Only the selected box information is displayed.", true,
            new InboundTestValue("BOX", "5011LL260828000001")),
        new(5, "WH002-TC-005", "Delivery Note 내부 품목 조회", "LOCAL",
            "Start to load the Delivery Note containing three boxes.", "All contained LOT/Box rows and total count are displayed.", true,
            new("DELIVERY NOTE", "5011202608280001"), new("BOX 1", "5011LL260828000001"),
            new("BOX 2", "5011LL260828000002"), new("BOX 3", "5011LL260828000003")),
        new(6, "WH002-TC-006", "Case 내부 품목 조회", "CKD",
            "Start to load the CKD Case containing three boxes.", "Every box in the Case is displayed.", true,
            new("CASE", "CKD202608280001CASE00001"), new("BOX 1", "CKD260828000000001"),
            new("BOX 2", "CKD260828000000002"), new("BOX 3", "CKD260828000000003")),
        new(7, "WH002-TC-007", "알 수 없는 바코드", "LOCAL",
            "Start to scan an unregistered barcode.", "Barcode Not Found is shown and the work state remains safe.", true,
            new InboundTestValue("UNKNOWN", "WH-UNKNOWN-999999")),
        new(8, "WH002-TC-008", "내부 품목 연속 스캔 및 하이라이트", "LOCAL",
            "Start, then tap BOX 1 and BOX 2 below and press Enter after each.", "Only scanned rows highlight and the completed count increases.", true,
            new("DELIVERY NOTE", "5011202608280001"), new("BOX 1", "5011LL260828000001"),
            new("BOX 2", "5011LL260828000002")),
        new(9, "WH002-TC-009", "목록에 없는 Box 스캔", "LOCAL",
            "Start, load OTHER DOCUMENT BOX, then press Enter.", "Wrong Document Box is shown and the box is not counted.", true,
            new("DELIVERY NOTE", "5011202608280001"), new("OTHER DOCUMENT BOX", "5011LL260903900001")),
        new(10, "WH002-TC-010", "동일 Box 중복 스캔", "LOCAL",
            "Start, scan BOX 1 twice by loading it and pressing Enter twice.", "Duplicate scan is shown and the count does not increase twice.", true,
            new("DELIVERY NOTE", "5011202608280001"), new("BOX 1 - SCAN TWICE", "5011LL260828000001")),
        new(11, "WH002-TC-011", "전체 품목 스캔 후 Location 단계 이동", "LOCAL",
            "Start, then scan BOX 1, BOX 2 and BOX 3 in order.", "The Location input becomes enabled after the final box.", true,
            new("DELIVERY NOTE", "5011202608280001"), new("BOX 1", "5011LL260828000001"),
            new("BOX 2", "5011LL260828000002"), new("BOX 3", "5011LL260828000003")),
        new(12, "WH002-TC-012", "유효 Location 스캔", "LOCAL",
            "Start, then load VALID LOCATION and press Enter.", "Warehouse, Area, Zone and Rack are shown and RECEIVE is enabled.", true,
            new("BOX", "5011LL260903900001"), new("VALID LOCATION", "WH010201", true)),
        new(13, "WH002-TC-013", "존재하지 않는 Location", "LOCAL",
            "Start, then load UNKNOWN LOCATION and press Enter.", "Location Not Found is shown and RECEIVE remains disabled.", true,
            new("BOX", "5011LL260903900001"), new("UNKNOWN LOCATION", "WH999999", true)),
        new(14, "WH002-TC-014", "입고 불가/용량 초과 Location", "LOCAL",
            "Start, then test each Location separately.", "The applicable reason is shown and inbound is blocked.", true,
            new("BOX", "5011LL260903900001"), new("BLOCKED", "WH019901", true),
            new("CAPACITY 50", "WH019902", true)),
        new(15, "WH002-TC-015", "입고 처리 완료", "LOCAL",
            "Start, load VALID LOCATION, press Enter, then RECEIVE.", "Inventory/location update, completion alert and form reset occur.", true,
            new("RESETTABLE BOX", "5011LL260903900001"), new("VALID LOCATION", "WH010201", true)),
        new(16, "WH002-TC-016", "입고 후 재고·거래이력 검증", "LOCAL",
            "Complete scenario 15, then check Inventory and Transactions.", "Stock increases by 120 and one IN transaction is recorded.", false,
            new("LOT", "5011LL260903900001"), new("LOCATION", "WH010201", true)),
        new(17, "WH002-TC-017", "이미 입고된 Box 재처리", "LOCAL",
            "Start to scan a pre-received LOT.", "Duplicate receiving is blocked without increasing inventory.", true,
            new InboundTestValue("RECEIVED LOT", "260827014")),
        new(18, "WH002-TC-018", "Receive API 실패 및 롤백", "LOCAL",
            "Start, load the Location, stop the API, press RECEIVE, then restart and retry.", "No partial inventory/history is saved and the entered state remains for retry.", true,
            new("RESETTABLE BOX", "5011LL260903900002"), new("VALID LOCATION", "WH010201", true))
    ];

    private sealed class ModeState
    {
        public string Barcode { get; set; } = "";
        public string Location { get; set; } = "";
        public string Message { get; set; } = "";
        public string MessageClass { get; set; } = "dim";
        public bool IsLocationChangeMode { get; set; }
        public string? ChangeFromLocation { get; set; }
        public PdaApi.LocationRow? CurrentLocation { get; set; }
        public PdaApi.LocationRow? SelectedLocation { get; set; }
        public PdaApi.InboundScanRow? Scan { get; set; }
        public PdaApi.InboundDocumentRow? Document { get; set; }
        public List<PdaApi.InboundDocumentLineRow> DocumentLines { get; set; } = [];
        public List<PdaApi.InboundDocumentBoxRow> DocumentBoxes { get; set; } = [];
        public HashSet<string> PendingDocumentBoxes { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public bool HighlightLocationScan { get; set; }
    }

    private readonly Dictionary<string, ModeState> _modeStates = new(StringComparer.OrdinalIgnoreCase)
    {
        ["LOCAL"] = new(),
        ["CKD"] = new()
    };

    private string _mode = "";
    private string _barcode = "";
    private string _loc = "";
    private string _msg = "";
    private string _cls = "dim";
    private bool _isScanning;
    private bool _isLocationScanning;
    private bool _isReceiving;
    private bool _isMoving;
    private bool _isCanceling;
    private bool _scrollLocationAfterRender;
    private bool _highlightLocationScan;
    private bool _isLocationChangeMode;
    private bool _modalOpen;
    private bool _modalConfirm;
    private string _modalTitle = "";
    private string _modalMessage = "";
    private string _modalKind = "info";
    private Func<Task>? _modalPrimaryAction;
    private Func<Task>? _modalAfterCloseAction;
    private DotNetObjectReference<Wh02PdaInbound>? _scannerRef;
    private int _testScenarioIndex;
    private bool _testPanelOpen;
    private bool _simulateReceiveApiFailure;

    private bool IsSimpleTestMode => PdaScenarioUsers.IsSimple(Auth?.Session?.EmployeeNo);
    private bool IsTestMode => IsSimpleTestMode || PdaScenarioUsers.IsDetailed(Auth.Session?.EmployeeNo);
    private InboundTestScenario[] ActiveTestScenarios => IsSimpleTestMode ? SimpleTestScenarios : InboundTestScenarios;
    private InboundTestScenario CurrentTestScenario => ActiveTestScenarios[_testScenarioIndex];
    private InboundTestValue[] CurrentTestValues => IsSimpleTestMode ? SimpleTestValues() : CurrentTestScenario.Values;
    private bool SimulateReceiveFailure => IsTestMode && CurrentTestScenario.No == (IsSimpleTestMode ? 5 : 18) && _simulateReceiveApiFailure;

    private void OpenTestPanel() => _testPanelOpen = true;
    private void CloseTestPanel() => _testPanelOpen = false;
    private void OpenScenarioPage(string route)
    {
        CloseTestPanel();
        Nav.NavigateTo(route);
    }
    private void ToggleReceiveApiFailure() => _simulateReceiveApiFailure = !_simulateReceiveApiFailure;

    private void SelectTestScenario(int index)
    {
        if (index < 0 || index >= ActiveTestScenarios.Length)
            return;

        _testScenarioIndex = index;
        if (CurrentTestScenario.No != (IsSimpleTestMode ? 5 : 18))
            _simulateReceiveApiFailure = false;
        if (!IsSimpleTestMode)
            PrepareTestScenario(CurrentTestScenario);
    }

    private async Task StartTestScenario()
    {
        if (IsSimpleTestMode)
        {
            await StartSimpleTestScenario();
            return;
        }
        var scenario = CurrentTestScenario;
        CloseTestPanel();
        PrepareTestScenario(scenario);

        if (scenario.AutoScan && !string.IsNullOrWhiteSpace(_barcode))
            await Scan();
        else
            ShowAlert($"Scenario {scenario.No:00} Ready", scenario.Steps, "info");
    }

    private void PrepareTestScenario(InboundTestScenario scenario)
    {
        ResetAllForms();
        _mode = scenario.Mode ?? "";

        var first = scenario.Values.FirstOrDefault(value => !value.IsLocation);
        if (first is not null)
            _barcode = first.Value;
    }

    private async Task LoadTestValue(InboundTestValue value)
    {
        if (IsSimpleTestMode)
        {
            await LoadSimpleTestValue(value);
            return;
        }
        CloseTestPanel();
        if (CurrentTestScenario.Mode is null)
            _mode = "";

        if (value.IsLocation)
        {
            _loc = value.Value;
            _selectedLocation = null;
            await ScanLocation();
        }
        else
        {
            _barcode = value.Value;
            await Scan();
        }
    }
    private string? _changeFromLocation;
    private PdaApi.LocationRow? _currentLocation;
    private PdaApi.LocationRow? _selectedLocation;
    private PdaApi.InboundScanRow? _scan;
    private PdaApi.InboundDocumentRow? _document;
    private List<PdaApi.InboundDocumentLineRow> _documentLines = [];
    private List<PdaApi.InboundDocumentBoxRow> _documentBoxes = [];
    private HashSet<string> _pendingDocumentBoxes = new(StringComparer.OrdinalIgnoreCase);

    private static bool ShowDeveloperScanButtons => MauiProgram.IsDeveloperMode;
    private const string ScanPanelClass = "hardware-scan-panel";
    private bool IsBusy => _isScanning || _isLocationScanning || _isReceiving || _isMoving || _isCanceling;
    private const string BarcodePlaceholder = "Scan Receiving Barcode";
    private string DocumentTitle => _mode == "CKD" ? "CKD CASE" : "DELIVERY NOTE";
    private string LocationScanLabel => _isLocationChangeMode
        ? "NEW LOCATION NO SCAN"
        : AlreadyReceived && _document is null ? "CURRENT LOCATION" : "LOCATION NO SCAN";
    private bool LocationEntryDisabled => IsBusy || (_document is not null
        ? !DocumentReadyForLocation
        : _scan is null || (AlreadyReceived && !_isLocationChangeMode));
    private bool DisableScan => IsBusy || string.IsNullOrWhiteSpace(_barcode);
    private bool DisableLocationScan => LocationEntryDisabled || string.IsNullOrWhiteSpace(_loc);
    private bool AlreadyReceived => string.Equals(_scan?.Yn, "N", StringComparison.OrdinalIgnoreCase);
    private bool TargetMatchesCurrent => AlreadyReceived
        && !string.IsNullOrWhiteSpace(_scan?.ReceivedLocation)
        && _selectedLocation is not null
        && string.Equals(_selectedLocation.LocationId, _scan.ReceivedLocation, StringComparison.OrdinalIgnoreCase);
    private bool DisableReceive => IsBusy
        || (_document is not null ? !DocumentReadyForLocation : _scan is null || AlreadyReceived)
        || _selectedLocation is null
        || LocationValidationMessage(_selectedLocation) is not null
        || !string.Equals(_selectedLocation.LocationId, _loc.Trim(), StringComparison.OrdinalIgnoreCase);
    private bool DisableCancel => IsBusy || _document is not null || _scan is null || !AlreadyReceived;
    private int DisplayScannedBoxes => _document is null
        ? 0
        : Math.Min(_document.TotalBoxes, _document.ScannedBoxes + _pendingDocumentBoxes.Count);
    private bool DocumentReadyForLocation => _document is not null
        && _pendingDocumentBoxes.Count > 0
        && DisplayScannedBoxes >= _document.TotalBoxes;
    private string ActionBarClass => _isLocationChangeMode || !AlreadyReceived ? "has-reset" : AlreadyReceived ? "has-cancel" : "has-secondary";
    private string ReceiveButtonClass => DisableReceive ? "blocked" : "ready";
    private string ConfirmMoveButtonClass => _isLocationChangeMode && !string.IsNullOrWhiteSpace(_loc) ? "ready" : "blocked";
    private string ChangeButtonClass => IsBusy ? "blocked" : "ready";
    private string StatusChipClass => AlreadyReceived ? "received" : "ready";
    private string ModalMark => _modalKind switch
    {
        "danger" => "!",
        "warn" => "!",
        "success" => "OK",
        _ => "i"
    };
    private string ItemStatusLabel => _scan is null
        ? "-"
        : AlreadyReceived
            ? $"Incoming {Text(_scan.ReceivedStatus)}"
            : "PO Ready";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
            _scannerRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = ShowDeveloperScanButtons });
        }

        if (_scrollLocationAfterRender)
        {
            _scrollLocationAfterRender = false;
            await JS.InvokeVoidAsync("pdaScan.scrollTo", ".wh02-location-panel");
        }

        await FocusScannerAsync();
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        var value = NormalizeHardwareScan(scanText);
        if (string.IsNullOrWhiteSpace(value))
            return;

        await InvokeAsync(async () =>
        {
            if (!LocationEntryDisabled)
            {
                _loc = value;
                await ScanLocation();
            }
            else
            {
                _barcode = value;
                await Scan();
            }

            SaveModeState(_mode);
            StateHasChanged();
        });
    }

    private void OnNativeBarcodeScanned(string barcode)
    {
        _ = InvokeAsync(async () => await OnHardwareScanAsync(barcode));
    }

    private async Task FocusScannerAsync()
    {
        if (_modalOpen)
            return;

        try
        {
            var selector = !LocationEntryDisabled ? ".wh02-location-input" : ".wh02-barcode-input";
            await JS.InvokeVoidAsync("pdaScan.focus", selector);
        }
        catch
        {
            // Ignore focus failures while the WebView is navigating.
        }
    }

    private static string NormalizeHardwareScan(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Replace("\u0002", "").Replace("\u0003", "").Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;

        try
        {
            await JS.InvokeVoidAsync("pdaScan.unregister");
        }
        catch
        {
            // Ignore dispose-time JS disconnects.
        }

        _scannerRef?.Dispose();
    }

    private void SetMode(string mode)
    {
        if (IsSimpleTestMode)
            _simpleMode = mode;
        if (string.Equals(_mode, mode, StringComparison.OrdinalIgnoreCase)) return;

        SaveModeState(_mode);
        _mode = mode;
        LoadModeState(mode);
    }

    private void SaveModeState(string mode)
    {
        if (string.IsNullOrWhiteSpace(mode)) return;

        if (!_modeStates.TryGetValue(mode, out var state))
        {
            state = new ModeState();
            _modeStates[mode] = state;
        }

        state.Barcode = _barcode;
        state.Location = _loc;
        state.Message = _msg;
        state.MessageClass = _cls;
        state.IsLocationChangeMode = _isLocationChangeMode;
        state.ChangeFromLocation = _changeFromLocation;
        state.CurrentLocation = _currentLocation;
        state.SelectedLocation = _selectedLocation;
        state.Scan = _scan;
        state.Document = _document;
        state.DocumentLines = [.. _documentLines];
        state.DocumentBoxes = [.. _documentBoxes];
        state.PendingDocumentBoxes = new HashSet<string>(_pendingDocumentBoxes, StringComparer.OrdinalIgnoreCase);
        state.HighlightLocationScan = _highlightLocationScan;
    }

    private void LoadModeState(string mode)
    {
        if (!_modeStates.TryGetValue(mode, out var state))
        {
            state = new ModeState();
            _modeStates[mode] = state;
        }

        _barcode = state.Barcode;
        _loc = state.Location;
        _msg = state.Message;
        _cls = state.MessageClass;
        _isLocationChangeMode = state.IsLocationChangeMode;
        _changeFromLocation = state.ChangeFromLocation;
        _currentLocation = state.CurrentLocation;
        _selectedLocation = state.SelectedLocation;
        _scan = state.Scan;
        _document = state.Document;
        _documentLines = [.. state.DocumentLines];
        _documentBoxes = [.. state.DocumentBoxes];
        _pendingDocumentBoxes = new HashSet<string>(state.PendingDocumentBoxes, StringComparer.OrdinalIgnoreCase);
        _highlightLocationScan = state.HighlightLocationScan;
    }

    private void ResetForm()
    {
        ResetCurrentFields();
        SaveModeState(_mode);
    }

    private void ResetCurrentFields()
    {
        _scan = null;
        _document = null;
        _documentLines = [];
        _documentBoxes = [];
        _pendingDocumentBoxes.Clear();
        _highlightLocationScan = false;
        _barcode = "";
        _loc = "";
        _selectedLocation = null;
        _currentLocation = null;
        _isLocationChangeMode = false;
        _changeFromLocation = null;
        _msg = "";
        _cls = "dim";
    }

    private void ResetAllForms()
    {
        ResetCurrentFields();
        _modeStates["LOCAL"] = new();
        _modeStates["CKD"] = new();
    }

    private Task ResetFormAsync()
    {
        ResetForm();
        return Task.CompletedTask;
    }

    private Task ResetAllFormsAsync()
    {
        ResetAllForms();
        return Task.CompletedTask;
    }

    private string ModeClass(string mode) => _mode == mode ? "on" : "";

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Scan();
    }

    private void OnBarcodeInput(ChangeEventArgs e)
    {
        _barcode = e.Value?.ToString() ?? "";
    }

    private void OnLocationInput(ChangeEventArgs e)
    {
        _loc = e.Value?.ToString() ?? "";
        if (!string.Equals(_selectedLocation?.LocationId, _loc.Trim(), StringComparison.OrdinalIgnoreCase))
            _selectedLocation = null;
    }

    private async Task OnLocationKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ScanLocation();
    }

    private async Task Scan()
    {
        if (string.IsNullOrWhiteSpace(_mode))
        {
            _msg = "Select LOCAL or CKD before scanning.";
            _cls = "fail";
            ShowAlert("Receive Type Required", _msg, "warn");
            return;
        }

        if (DisableScan) return;

        _isScanning = true;
        _scan = null;
        _loc = "";
        _selectedLocation = null;
        _currentLocation = null;
        _isLocationChangeMode = false;
        _changeFromLocation = null;
        _highlightLocationScan = false;
        _msg = "Scanning...";
        _cls = "dim";

        try
        {
            var documentResult = await Api.WhInboundDocumentAsync(_mode, _barcode.Trim());
            if (documentResult.Document is not null)
            {
                _document = documentResult.Document;
                _documentLines = documentResult.Lines;
                _documentBoxes = documentResult.Boxes;
                _pendingDocumentBoxes.Clear();
                _barcode = documentResult.Document.DocumentBarcode;
                _msg = documentResult.Document.Yn == "Y"
                    ? "All boxes in this document are received."
                    : "Document loaded. Scan a box barcode.";
                _cls = documentResult.Document.Yn == "Y" ? "ok" : "dim";
                return;
            }

            var row = await Api.WhScanInboundAsync(_mode, _barcode.Trim());
            if (row is null)
            {
                _msg = "Barcode is not in the inbound list.";
                _cls = "fail";
                ShowAlert("Barcode Not Found", _msg, "warn");
                return;
            }

            if (_document is not null && !BelongsToCurrentDocument(row))
            {
                _barcode = "";
                _msg = "This box does not belong to the scanned document.";
                _cls = "fail";
                ShowAlert("Wrong Document Box", _msg, "warn");
                return;
            }

            if (_document is not null && _pendingDocumentBoxes.Contains(row.Barcode))
            {
                _barcode = "";
                _msg = "This box has already been scanned.";
                _cls = "fail";
                ShowAlert("Box Already Scanned", _msg, "danger");
                return;
            }

            _scan = row;
            _barcode = row.Barcode;

            if (_document is not null && !AlreadyReceived)
                _pendingDocumentBoxes.Add(row.Barcode);

            if (_document is null && AlreadyReceived && !string.IsNullOrWhiteSpace(row.ReceivedLocation))
            {
                _loc = row.ReceivedLocation;
                _changeFromLocation = row.ReceivedLocation;
                _selectedLocation = await Api.WhScanLocationAsync(row.ReceivedLocation);
                _currentLocation = _selectedLocation;
            }

            _msg = _document is not null
                ? DocumentReadyForLocation
                    ? "All boxes scanned. Scan the location."
                    : AlreadyReceived
                        ? "This box is already received. Scan a remaining box."
                        : $"Box scanned ({DisplayScannedBoxes}/{_document.TotalBoxes}). Scan the next box."
                : AlreadyReceived
                    ? "This box is already received."
                    : "Box matched. Scan the location and receive.";
            _cls = AlreadyReceived ? "fail" : "ok";

            if (DocumentReadyForLocation)
            {
                _highlightLocationScan = true;
                _scrollLocationAfterRender = true;
            }
            else if (_document is null && !AlreadyReceived)
            {
                _highlightLocationScan = true;
                _scrollLocationAfterRender = true;
            }
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
            _cls = "fail";
            ShowAlert("Barcode Scan Failed", ex.Message, "danger");
        }
        finally
        {
            _isScanning = false;
        }
    }

    private bool BelongsToCurrentDocument(PdaApi.InboundScanRow row)
    {
        var documentBarcode = _mode == "CKD" ? row.CaseBarcode : row.NoteNo;
        return _document is not null
            && !string.IsNullOrWhiteSpace(documentBarcode)
            && string.Equals(_document.DocumentBarcode, documentBarcode, StringComparison.OrdinalIgnoreCase);
    }

    private async Task PrepareNextBoxAsync()
    {
        if (_document is not null)
        {
            var result = await Api.WhInboundDocumentAsync(_mode, _document.DocumentBarcode);
            _document = result.Document;
            _documentLines = result.Lines;
            _documentBoxes = result.Boxes;
            _pendingDocumentBoxes.Clear();
        }

        _scan = null;
        _barcode = "";
        _loc = "";
        _selectedLocation = null;
        _currentLocation = null;
        _isLocationChangeMode = false;
        _changeFromLocation = null;
        _highlightLocationScan = false;
        _msg = _document?.Yn == "Y" ? "Document receive complete." : "Scan the next box barcode.";
        _cls = _document?.Yn == "Y" ? "ok" : "dim";
        SaveModeState(_mode);
    }

    private async Task ScanLocation()
    {
        if (DisableLocationScan) return;

        var locationNo = _loc.Trim();
        if (_isLocationChangeMode && IsSameAsCurrentLocation(locationNo))
        {
            _selectedLocation = null;
            _msg = "This box is already in the selected location.";
            _cls = "fail";
            ShowAlert("Same Location", _msg, "warn");
            return;
        }

        _isLocationScanning = true;
        _msg = "Scanning location...";
        _cls = "dim";

        try
        {
            var location = await Api.WhScanLocationAsync(locationNo);
            if (location is null)
            {
                _selectedLocation = null;
                _msg = "Location not found.";
                _cls = "fail";
                ShowAlert("Location Not Found", _msg, "warn");
                return;
            }

            _selectedLocation = location;
            _loc = location.LocationId;
            _highlightLocationScan = false;

            var locationIssue = LocationValidationMessage(location);
            if (locationIssue is not null)
            {
                _msg = locationIssue;
                _cls = "fail";
                ShowAlert("Location Not Available", locationIssue, "warn");
                return;
            }

            if (_isLocationChangeMode && IsSameAsCurrentLocation(location.LocationId))
            {
                _selectedLocation = null;
                _msg = "This box is already in the selected location.";
                _cls = "fail";
                ShowAlert("Same Location", _msg, "warn");
                return;
            }

            _msg = _isLocationChangeMode ? "New location loaded. Tap Confirm." : "";
            _cls = _isLocationChangeMode ? "ok" : "dim";
        }
        catch (Exception ex)
        {
            _selectedLocation = null;
            _msg = ex.Message;
            _cls = "fail";
            ShowAlert("Location Scan Failed", ex.Message, "danger");
        }
        finally
        {
            _isLocationScanning = false;
        }
    }

    private async Task Receive()
    {
        if (IsBusy) return;

        var validation = ReceiveValidationMessage();
        if (validation is not null)
        {
            _msg = validation;
            _cls = "fail";
            ShowAlert("Receive Check", validation, "warn");
            return;
        }

        if (_selectedLocation is null || (_document is null && _scan is null)) return;

        _isReceiving = true;
        _msg = "Receiving...";
        _cls = "dim";

        try
        {
            if (_document is not null)
            {
                var boxes = _pendingDocumentBoxes.ToList();
                foreach (var boxBarcode in boxes)
                {
                    var batchResult = await Api.WhReceiveInboundAsync(
                        new PdaApi.InboundReceiveReq(_mode, boxBarcode, _selectedLocation.LocationId, SimulateReceiveFailure));
                    if (!batchResult.Success)
                    {
                        await RefreshDocumentAsync();
                        _msg = batchResult.Message;
                        _cls = "fail";
                        ShowAlert("Receive Failed", $"Box: {boxBarcode}\n{batchResult.Message}", "danger");
                        return;
                    }

                    _pendingDocumentBoxes.Remove(boxBarcode);
                }

                await RefreshDocumentAsync();
                _msg = "Receive complete.";
                _cls = "ok";
                ShowAlert("Receive Complete", $"{boxes.Count} boxes were received successfully.", "success", ResetFormAsync);
                return;
            }

            var scan = _scan;
            if (scan is null) return;

            var result = await Api.WhReceiveInboundAsync(new PdaApi.InboundReceiveReq(
                _mode,
                scan.Barcode,
                _selectedLocation.LocationId,
                SimulateReceiveFailure));
            if (!result.Success)
            {
                _msg = result.Message;
                _cls = "fail";
                ShowAlert("Receive Failed", result.Message, "danger");
                return;
            }

            _msg = "Receive complete.";
            _cls = "ok";
            ShowAlert("Receive Complete", "The box was received successfully.", "success", PrepareNextBoxAsync);
        }
        finally
        {
            _isReceiving = false;
        }
    }

    private async Task StartLocationChange()
    {
        if (IsBusy) return;

        if (_scan is null)
        {
            ShowAlert("Box Required", "Scan a box barcode first.", "warn");
            return;
        }

        if (!AlreadyReceived)
        {
            ShowAlert("Incoming Required", "This box has not been received yet.", "warn");
            return;
        }

        _changeFromLocation = _scan.ReceivedLocation;
        _currentLocation = _selectedLocation ?? _currentLocation;
        if (_currentLocation is null && !string.IsNullOrWhiteSpace(_changeFromLocation))
        {
            _currentLocation = await Api.WhScanLocationAsync(_changeFromLocation);
        }

        _loc = "";
        _selectedLocation = null;
        _isLocationChangeMode = true;
        _msg = "Scan the new location.";
        _cls = "dim";
    }

    private async Task ConfirmLocationChange()
    {
        if (IsBusy) return;

        var validation = MoveValidationMessage();
        if (validation is not null)
        {
            _msg = validation;
            _cls = "fail";
            ShowAlert("Location Change Check", validation, "warn");
            return;
        }

        if (!await EnsureMoveLocationLoadedAsync())
            return;

        if (_scan is null || _selectedLocation is null) return;

        _isMoving = true;
        _msg = "Changing location...";
        _cls = "dim";
        var fromLocation = _changeFromLocation ?? _scan.ReceivedLocation;
        var toLocation = _selectedLocation.LocationId;

        try
        {
            var result = await Api.WhMoveInboundLocationAsync(new PdaApi.InboundReceiveReq(_mode, _scan.Barcode, toLocation));
            if (!result.Success)
            {
                _msg = result.Message;
                _cls = "fail";
                ShowAlert("Location Change Failed", result.Message, "danger");
                return;
            }

            _msg = "Location changed.";
            _cls = "ok";
            ShowAlert(
                "Location Changed",
                $"Previous Location: {Text(fromLocation)}\nNew Location: {Text(toLocation)}",
                "success",
                ResetFormAsync);
        }
        finally
        {
            _isMoving = false;
        }
    }

    private async Task CancelIncoming()
    {
        if (DisableCancel || _scan is null) return;

        ShowConfirm("Cancel Incoming", "Cancel incoming for this box?", CancelIncomingConfirmed);
        await Task.CompletedTask;
    }

    private async Task CancelIncomingConfirmed()
    {
        if (DisableCancel || _scan is null) return;

        _isCanceling = true;
        _msg = "Canceling incoming...";
        _cls = "dim";

        try
        {
            var result = await Api.WhCancelInboundAsync(new PdaApi.InboundCancelReq(_mode, _scan.Barcode));
            if (!result.Success)
            {
                _msg = result.Message;
                _cls = "fail";
                ShowAlert("Cancel Failed", result.Message, "danger");
                return;
            }

            _scan = result.Row ?? await Api.WhScanInboundAsync(_mode, _scan.Barcode);
            _loc = "";
            _selectedLocation = null;
            _isLocationChangeMode = false;
            _changeFromLocation = null;
            _msg = "Incoming canceled.";
            _cls = "ok";
            ShowAlert("Incoming Canceled", "Incoming was canceled successfully.", "success");
        }
        finally
        {
            _isCanceling = false;
        }
    }

    private IEnumerable<(string Label, string Value)> CommonFields()
    {
        if (_scan is null) yield break;

        yield return ("Item Status", ItemStatusLabel);
        yield return ("PO No", Text(_scan.PoNo));
        yield return ("PO Seq", _scan.PoSeq?.ToString() ?? "-");
        yield return ("Qty", QuantityText(_scan.Qty, _scan.Unit));
        yield return ("Vendor", Text(_scan.VendorName ?? _scan.VendorId));
        if (AlreadyReceived)
            yield return ("Current Loc", Text(_scan.ReceivedLocation));
    }

    private IEnumerable<(string Label, string Value)> DocumentFields()
    {
        if (_document is null) yield break;

        yield return ("Vendor", Text(_document.VendorName ?? _document.VendorId));
        if (_mode == "CKD")
        {
            yield return ("Case No", Text(_document.CaseNo));
            yield return ("Invoice", Text(_document.InvoiceNo));
            yield return ("Container", Text(_document.ContainerNo));
            yield return ("Ship Date", DateText(_document.ShipDate));
            yield return ("Pack Date", DateText(_document.PackDate));
        }
        else
        {
            yield return ("Delivery Date", DateText(_document.DeliveryDate));
            yield return ("Arrival Date", DateText(_document.ArrivalDate));
        }
    }

    private async Task RefreshDocumentAsync()
    {
        if (_document is null) return;

        var result = await Api.WhInboundDocumentAsync(_mode, _document.DocumentBarcode);
        _document = result.Document;
        _documentLines = result.Lines;
        _documentBoxes = result.Boxes;
    }

    private int DisplayScanCount(PdaApi.InboundDocumentLineRow line)
    {
        var pending = _documentBoxes.Count(box =>
            string.Equals(box.PartNo, line.PartNo, StringComparison.OrdinalIgnoreCase)
            && _pendingDocumentBoxes.Contains(box.BoxBarcode));
        return Math.Min(line.BoxCount, line.ScanCount + pending);
    }

    private IEnumerable<PdaApi.InboundDocumentBoxRow> DocumentBoxes(string partNo)
        => _documentBoxes.Where(box => string.Equals(box.PartNo, partNo, StringComparison.OrdinalIgnoreCase));

    private bool IsBoxScanned(PdaApi.InboundDocumentBoxRow box)
        => string.Equals(box.Yn, "Y", StringComparison.OrdinalIgnoreCase)
            || _pendingDocumentBoxes.Contains(box.BoxBarcode);

    private IEnumerable<(string Label, string Value)> LocationFields()
    {
        if (_selectedLocation is null) yield break;

        foreach (var field in LocationFieldsFor(_selectedLocation))
            yield return field;
    }

    private IEnumerable<(string Label, string Value)> CurrentLocationFields()
    {
        if (_currentLocation is null) yield break;

        foreach (var field in LocationFieldsFor(_currentLocation))
            yield return field;
    }

    private static IEnumerable<(string Label, string Value)> LocationFieldsFor(PdaApi.LocationRow location)
    {
        yield return ("WH", JoinCodeName(location.WarehouseCode, location.WarehouseName));
        yield return ("AREA", JoinCodeName(location.AreaCode, location.AreaName));
        yield return ("ZONE", JoinCodeName(location.Zone, location.ZoneName));
        yield return ("RACK X", Text(location.X));
        yield return ("RACK Y", Text(location.Y));
        yield return ("RACK Z", Text(location.Z));
        yield return ("STOCK LINES", location.LineCount.ToString("N0"));
        yield return ("STOCK QTY", location.TotalQty.ToString("N0"));
    }

    private IEnumerable<(string Label, string Value)> ModeFields()
    {
        if (_scan is null) yield break;

        if (_scan.ReceiveType == "CKD")
        {
            yield return ("Case Barcode", Text(_scan.CaseBarcode));
            yield return ("Case No", Text(_scan.CaseNo));
            yield return ("Invoice", Text(_scan.InvoiceNo));
            yield return ("Container", Text(_scan.ContainerNo));
            yield return ("Ship Date", DateText(_scan.ShipDate));
            yield return ("Pack Date", DateText(_scan.PackDate));
            yield break;
        }

        yield return ("Delivery Note", Text(_scan.NoteNo));
        yield return ("Prod Date", DateText(_scan.ProductionDate));
        yield return ("Delivery Date", DateText(_scan.DeliveryDate));
        yield return ("Arrival Date", DateText(_scan.ArrivalDate));
    }

    private string? ReceiveValidationMessage()
    {
        if (_document is not null)
        {
            if (_pendingDocumentBoxes.Count == 0)
                return "Scan the boxes in this document first.";
            if (!DocumentReadyForLocation)
                return $"Scan all boxes first ({DisplayScannedBoxes}/{_document.TotalBoxes}).";
            if (string.IsNullOrWhiteSpace(_loc))
                return "Scan a Location No first.";
            if (_selectedLocation is null)
                return "Load the location information first.";
            var documentLocationIssue = LocationValidationMessage(_selectedLocation);
            if (documentLocationIssue is not null)
                return documentLocationIssue;
            if (!string.Equals(_selectedLocation.LocationId, _loc.Trim(), StringComparison.OrdinalIgnoreCase))
                return "The entered Location No does not match the loaded location.";
            return null;
        }

        if (string.IsNullOrWhiteSpace(_barcode))
            return "Scan a box barcode first.";
        if (_scan is null)
            return "Scan a box barcode to load the item information first.";
        if (AlreadyReceived)
            return "This box is already received.";
        if (string.IsNullOrWhiteSpace(_loc))
            return "Enter or scan a Location No first.";
        if (_selectedLocation is null)
            return "Tap Location No SCAN to load the location information first.";
        var locationIssue = LocationValidationMessage(_selectedLocation);
        if (locationIssue is not null)
            return locationIssue;
        if (!string.Equals(_selectedLocation.LocationId, _loc.Trim(), StringComparison.OrdinalIgnoreCase))
            return "The entered Location No does not match the loaded location. Scan the Location No again.";

        return null;
    }

    private string? LocationValidationMessage(PdaApi.LocationRow? location)
    {
        if (location is null) return null;

        var type = location.LocationType?.Trim();
        if (type is not null && (type.Equals("BLOCKED", StringComparison.OrdinalIgnoreCase)
            || type.Equals("HOLD", StringComparison.OrdinalIgnoreCase)
            || type.Equals("QUARANTINE", StringComparison.OrdinalIgnoreCase)
            || type.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase)))
            return $"Location {location.LocationId} is blocked for inbound.";

        var incomingQty = _document is not null
            ? _documentBoxes.Where(box => _pendingDocumentBoxes.Contains(box.BoxBarcode)).Sum(box => box.Qty)
            : _scan?.Qty ?? 0;
        if (location.Capacity is > 0 && location.TotalQty + incomingQty > location.Capacity.Value)
            return $"Location {location.LocationId} capacity would be exceeded ({location.TotalQty + incomingQty:N0}/{location.Capacity:N0}).";

        return null;
    }

    private string? MoveValidationMessage()
    {
        if (string.IsNullOrWhiteSpace(_barcode))
            return "Scan a box barcode first.";
        if (_scan is null)
            return "Scan a box barcode to load the item information first.";
        if (!AlreadyReceived)
            return "This box has not been received yet. Receive it first.";
        if (!_isLocationChangeMode)
            return "Tap Change Location first.";
        if (string.IsNullOrWhiteSpace(_loc))
            return "Enter or scan the new Location No first.";
        if (IsSameAsCurrentLocation(_loc))
            return "This box is already in the selected location.";
        if (_selectedLocation is not null && !string.Equals(_selectedLocation.LocationId, _loc.Trim(), StringComparison.OrdinalIgnoreCase))
            return "The entered Location No does not match the loaded location. Scan the Location No again.";
        if (TargetMatchesCurrent)
            return "This box is already in the selected location.";

        return null;
    }

    private async Task<bool> EnsureMoveLocationLoadedAsync()
    {
        if (string.IsNullOrWhiteSpace(_loc))
            return false;

        if (IsSameAsCurrentLocation(_loc))
        {
            _selectedLocation = null;
            _msg = "This box is already in the selected location.";
            _cls = "fail";
            ShowAlert("Same Location", _msg, "warn");
            return false;
        }

        if (_selectedLocation is not null
            && string.Equals(_selectedLocation.LocationId, _loc.Trim(), StringComparison.OrdinalIgnoreCase)
            && !IsSameAsCurrentLocation(_selectedLocation.LocationId))
        {
            return true;
        }

        _isLocationScanning = true;
        _msg = "Loading new location...";
        _cls = "dim";

        try
        {
            var location = await Api.WhScanLocationAsync(_loc.Trim());
            if (location is null)
            {
                _selectedLocation = null;
                _msg = "Location not found.";
                _cls = "fail";
                ShowAlert("Location Not Found", _msg, "warn");
                return false;
            }

            if (IsSameAsCurrentLocation(location.LocationId))
            {
                _selectedLocation = null;
                _loc = location.LocationId;
                _msg = "This box is already in the selected location.";
                _cls = "fail";
                ShowAlert("Same Location", _msg, "warn");
                return false;
            }

            _selectedLocation = location;
            _loc = location.LocationId;
            _msg = "New location loaded. Tap Confirm.";
            _cls = "ok";
            return true;
        }
        catch (Exception ex)
        {
            _selectedLocation = null;
            _msg = ex.Message;
            _cls = "fail";
            ShowAlert("Location Load Failed", ex.Message, "danger");
            return false;
        }
        finally
        {
            _isLocationScanning = false;
        }
    }

    private bool IsSameAsCurrentLocation(string? locationId)
    {
        if (string.IsNullOrWhiteSpace(locationId)) return false;

        var current = _changeFromLocation ?? _scan?.ReceivedLocation;
        return !string.IsNullOrWhiteSpace(current)
            && string.Equals(locationId.Trim(), current.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private void ShowAlert(string title, string message, string kind = "info", Func<Task>? afterClose = null)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalConfirm = false;
        _modalPrimaryAction = null;
        _modalAfterCloseAction = afterClose;
        _modalOpen = true;
    }

    private void ShowConfirm(string title, string message, Func<Task> action)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = "danger";
        _modalConfirm = true;
        _modalPrimaryAction = action;
        _modalAfterCloseAction = null;
        _modalOpen = true;
    }

    private async Task DismissModal()
    {
        var afterClose = !_modalConfirm ? _modalAfterCloseAction : null;
        _modalOpen = false;
        _modalPrimaryAction = null;
        _modalAfterCloseAction = null;

        if (afterClose is not null)
            await afterClose();
    }

    private async Task ModalPrimary()
    {
        var action = _modalPrimaryAction;
        var afterClose = _modalAfterCloseAction;
        _modalOpen = false;
        _modalPrimaryAction = null;
        _modalAfterCloseAction = null;

        if (action is not null)
            await action();
        else if (afterClose is not null)
            await afterClose();
    }

    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string QuantityText(decimal value, string? unit)
        => string.IsNullOrWhiteSpace(unit) ? value.ToString("N0") : $"{value:N0} {unit}";
    private static string QuantityText(decimal value, string? unit, bool signed)
    {
        var prefix = signed && value > 0 ? "+" : "";
        return string.IsNullOrWhiteSpace(unit) ? $"{prefix}{value:N0}" : $"{prefix}{value:N0} {unit}";
    }

    private static string JoinCodeName(string? code, string? name)
    {
        if (string.IsNullOrWhiteSpace(code)) return Text(name);
        if (string.IsNullOrWhiteSpace(name)) return code;
        return $"{code} / {name}";
    }
    private static string DateText(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";
}
