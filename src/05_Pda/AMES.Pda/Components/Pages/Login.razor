@page "/login"
@using AMES.Devices
@implements IAsyncDisposable
@inject AuthState Auth
@inject AuthApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ApiEndpoint Endpoint

<div class="pda-login">
    <div class="pda-login-brand">EOS</div>
    <div class="pda-login-sub">SIGN IN / PDA</div>

    <div class="pda-login-center">
        @* 서버 선택은 서버가 둘 이상 설정됐을 때만 보인다 — 지금은 Dev Server 하나로 고정(11-24 사용자 요청) *@
        @if (Endpoint.Servers.Count > 1)
        {
        <div class="pda-login-server">
            <div class="pda-login-server-head">
                <span>SERVER</span>
                <button type="button" class="pda-login-server-test" data-no-busy disabled="@(_testing || _submitting)" @onclick="TestServersAsync">
                    @(_testing ? "TESTING..." : "TEST ALL")
                </button>
            </div>
            @foreach (var server in Endpoint.Servers)
            {
                var selected = string.Equals(server.Url, Endpoint.Current, StringComparison.OrdinalIgnoreCase);
                (bool Ok, long Ms, string Message)? test = _tests.TryGetValue(server.Url, out var t) ? t : null;
                <button type="button" class="pda-login-server-row @(selected ? "selected" : "")" data-no-busy
                        disabled="@(_submitting)" aria-pressed="@selected" @onclick="() => SelectServerAsync(server)">
                    <span class="pda-login-server-radio" aria-hidden="true"></span>
                    <span class="pda-login-server-text">
                        <strong>@server.Name</strong>
                        <small>@server.Url</small>
                    </span>
                    <span class="pda-login-server-state @(test is null ? "" : test.Value.Ok ? "ok" : "fail")">
                        @(test is null ? (_testing ? "..." : "—") : test.Value.Ok ? $"OK {test.Value.Ms}ms" : test.Value.Message)
                    </span>
                </button>
            }
        </div>
        }
        <div class="pda-login-panel">
            <div class="pda-fld">
                <RadzenLabel Text="EMPLOYEE ID" Component="employee-id" />
                <RadzenButton id="employee-id" Click="OpenEmployeeList" Disabled="@_submitting"
                              class="pda-login-employee-trigger" aria-label="Select employee ID"
                              aria-haspopup="dialog" aria-expanded="@_employeeListOpen">
                    <span class="@(string.IsNullOrWhiteSpace(_employeeNo) ? "placeholder" : "")">@(string.IsNullOrWhiteSpace(_employeeNo) ? "Select employee ID" : _employeeNo)</span>
                    <RadzenIcon Icon="expand_more" />
                </RadzenButton>
                @if (_employeeListError is not null)
                {
                    <div class="pda-login-list-note">
                        <span>@_employeeListError</span>
                        <RadzenButton Text="Retry" Click="LoadEmployeesAsync" Disabled="@_loadingEmployees" Size="ButtonSize.Small" />
                    </div>
                }
            </div>
            <div class="pda-fld">
                <label id="login-pin-label">PIN</label>
                <div class="pda-pin-dots" role="status" aria-live="polite" aria-label="@($"{_pin.Length} of 4 PIN digits entered")">
                    @for (var i = 0; i < 4; i++)
                    {
                        <span class="pda-pin-dot @(i < _pin.Length ? "on" : "")" aria-hidden="true"></span>
                    }
                </div>
                <div class="pda-keypad pda-login-keypad" role="group" aria-labelledby="login-pin-label">
                    @foreach (var digit in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
                    {
                        <RadzenButton Text="@digit" class="pda-key" Click="@(() => PressPinDigit(digit))" Disabled="@_submitting" />
                    }
                    <RadzenButton Text="CLEAR" class="pda-key del" Click="ClearPin" Disabled="@_submitting" />
                    <RadzenButton Text="0" class="pda-key" Click='@(() => PressPinDigit("0"))' Disabled="@_submitting" />
                    <RadzenButton Icon="backspace" class="pda-key del" Click="DeletePinDigit" Disabled="@_submitting" aria-label="Delete last PIN digit" />
                </div>
            </div>
            <RadzenButton Text="SIGN IN" Click="AuthenticatePinAsync" class="pda-login-submit"
                          Disabled="@(_submitting || string.IsNullOrWhiteSpace(_employeeNo) || _pin.Length != 4)" />
            @if (PdaCameraScan.IsAvailable)
            {
                <button type="button" class="pda-login-scan-state camera" data-no-busy
                        disabled="@(_submitting || _cameraBusy)" @onclick="ScanBadgeWithCamera">
                    <RadzenIcon Icon="photo_camera" />
                    <strong>@(_submitting ? "SIGNING IN..." : "TAP TO SCAN BADGE")</strong>
                </button>
            }
            else
            {
                <div class="pda-login-scan-state">
                    <RadzenIcon Icon="barcode_scanner" />
                    <strong>@(_submitting ? "SIGNING IN..." : "OR SCAN BADGE TO SIGN IN")</strong>
                </div>
            }
        </div>

        <div class="pda-status @_cls">@_status</div>
    </div>

    @if (_employeeListOpen)
    {
        <div class="wh08-filter-backdrop pda-login-employee-backdrop" @onclick="CloseEmployeeList">
            <section class="wh08-filter-sheet pda-login-employee-dialog" role="dialog" aria-modal="true"
                     aria-label="Select employee" tabindex="-1" @ref="_employeeDialog"
                     @onclick:stopPropagation="true" @onkeydown="OnEmployeeListKey">
                <div class="wh08-sheet-head">
                    <strong>SELECT EMPLOYEE</strong>
                    <RadzenButton Icon="close" Click="CloseEmployeeList" class="wh08-sheet-close"
                                  aria-label="Close employee list" />
                </div>
                <div class="pda-login-employee-options">
                    @foreach (var employee in _employees)
                    {
                        <RadzenButton class="@($"pda-login-employee-option {(employee.EmployeeNo == _employeeNo ? "selected" : "")}")"
                                      Click="@(() => SelectEmployee(employee))" aria-pressed="@(employee.EmployeeNo == _employeeNo)">
                            <strong>@employee.EmployeeNo</strong>
                            <span>@employee.EmployeeName</span>
                        </RadzenButton>
                    }
                    @if (_loadingEmployees) { <div class="pda-status dim">Loading employees...</div> }
                    else if (_employeeListError is not null)
                    {
                        <div class="pda-login-list-note">@_employeeListError</div>
                        <RadzenButton Text="Retry" Click="LoadEmployeesAsync" Size="ButtonSize.Small" />
                    }
                    else if (_employees.Count == 0) { <div class="pda-status dim">No employees available.</div> }
                </div>
            </section>
        </div>
    }
</div>

@code {
    private string _status = " ";
    private string _cls = "dim";
    private bool _submitting;
    private bool _cameraBusy;

    private async Task ScanBadgeWithCamera()
    {
        if (_cameraBusy || _submitting) return;
        _cameraBusy = true;
        try { await PdaCameraScan.ScanAsync(); }
        catch (Exception ex) { Set($"Camera scan failed. {ex.Message}", "fail"); }
        finally { _cameraBusy = false; }
    }
    private string _employeeNo = "";
    private string _pin = "";
    private List<LoginEmployeeDto> _employees = [];
    private bool _employeeListOpen, _focusEmployeeList;
    private ElementReference _employeeDialog;
    private bool _loadingEmployees, _disposed;
    private string? _employeeListError;
    private DotNetObjectReference<Login>? _scannerRef;

    private string EmployeeNo
    {
        get => _employeeNo;
        set
        {
            if (_employeeNo != value) _pin = "";
            _employeeNo = value ?? "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
            _scannerRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register", _scannerRef,
                new { minLength = 5, developerMode = MauiProgram.IsDeveloperMode });
            if (Endpoint.Servers.Count > 1) _ = TestServersAsync();
            await LoadEmployeesAsync();
        }
        if (_focusEmployeeList && _employeeListOpen)
        {
            _focusEmployeeList = false;
            await _employeeDialog.FocusAsync();
        }
    }

    private async Task LoadEmployeesAsync()
    {
        if (_loadingEmployees || _disposed) return;
        _loadingEmployees = true;
        _employeeListError = null;
        try { _employees = await Api.EmployeesAsync(); }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        { _employeeListError = "Server API update required for employee list. Scan badge or retry."; }
        catch { _employeeListError = "Cannot load employees. Check connection, scan badge or retry."; }
        finally
        {
            _loadingEmployees = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private readonly Dictionary<string, (bool Ok, long Ms, string Message)> _tests = new(StringComparer.OrdinalIgnoreCase);
    private bool _testing;

    private async Task TestServersAsync()
    {
        if (_testing || _disposed) return;
        _testing = true;
        _tests.Clear();
        StateHasChanged();
        try
        {
            await Task.WhenAll(Endpoint.Servers.Select(async s =>
            {
                var result = await ApiEndpoint.TestAsync(s.Url);
                _tests[s.Url] = result;
                if (!_disposed) await InvokeAsync(StateHasChanged);
            }));
        }
        finally
        {
            _testing = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task SelectServerAsync(PdaApiServer server)
    {
        if (_submitting) return;
        if (!string.Equals(server.Url, Endpoint.Current, StringComparison.OrdinalIgnoreCase))
        {
            Endpoint.Select(server.Url);
            EmployeeNo = "";
            _employees = [];
            Set($"Server: {server.Name}", "dim");
        }
        var result = await ApiEndpoint.TestAsync(server.Url);
        _tests[server.Url] = result;
        if (!result.Ok) Set($"Cannot reach {server.Name}: {result.Message}", "fail");
        await LoadEmployeesAsync();
    }

    private void OpenEmployeeList()
    {
        _employeeListOpen = true;
        _focusEmployeeList = true;
    }

    private void CloseEmployeeList() { _employeeListOpen = false; _focusEmployeeList = false; }
    private void OnEmployeeListKey(KeyboardEventArgs e) { if (e.Key == "Escape") CloseEmployeeList(); }
    private void SelectEmployee(LoginEmployeeDto employee)
    {
        EmployeeNo = employee.EmployeeNo;
        CloseEmployeeList();
        Set(" ", "dim");
    }

    private void PressPinDigit(string digit)
    {
        if (_submitting || _pin.Length >= 4) return;
        if (string.IsNullOrWhiteSpace(_employeeNo))
        {
            Set("Select employee ID first.", "fail");
            return;
        }
        _pin += digit;
    }

    private void ClearPin() { if (!_submitting) _pin = ""; }
    private void DeletePinDigit() { if (!_submitting && _pin.Length > 0) _pin = _pin[..^1]; }

    private async Task AuthenticatePinAsync()
    {
        if (_submitting) return;
        if (string.IsNullOrWhiteSpace(_employeeNo) || _pin.Length != 4 || !_pin.All(char.IsAsciiDigit))
        {
            Set("Enter employee ID and a 4-digit PIN.", "fail");
            return;
        }
        _submitting = true;
        Set("Signing in...", "dim");
        try
        {
            var result = await Api.LoginAsync(_employeeNo.Trim(), _pin);
            TrySignIn(result, "Check Employee ID and PIN.");
        }
        catch { Set("Authentication service is unavailable.", "fail"); }
        finally
        {
            _pin = "";
            _submitting = false;
            if (!_disposed) StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        if (_submitting) return;
        CloseEmployeeList();
        var barcode = NormalizeScan(scanText);
        if (barcode.Length == 0) return;
        var badge = BadgeScanParser.Parse(barcode);
        if (badge.WorkerNo.Length == 0 || badge.WorkerNo.Length > 20)
        {
            Set("Scan a valid employee badge.", "fail");
            return;
        }
        // A plain value only fills the ID; reject codes that are not on the loaded employee list.
        if (!badge.IsEosFormat && _employees.Count > 0
            && !_employees.Any(e => string.Equals(e.EmployeeNo, badge.WorkerNo, StringComparison.OrdinalIgnoreCase)))
        {
            Set($"Employee ID not found: {badge.WorkerNo}. Scan a valid employee badge.", "fail");
            return;
        }
        EmployeeNo = badge.WorkerNo;
        _pin = "";
        if (!badge.IsEosFormat)
        {
            Set("Employee ID entered. Enter your PIN to sign in.", "dim");
            return;
        }
        await AuthenticateBarcodeAsync(barcode);
    }

    private async Task AuthenticateBarcodeAsync(string barcode)
    {
        _submitting = true;
        Set("Signing in with employee barcode...", "dim");
        try
        {
            var res = await Api.LoginByBarcodeAsync(barcode);
            TrySignIn(res, "Scan a valid employee barcode.");
        }
        catch (Exception ex)
        {
            Set("Sign-in failed. " + ex.Message, "fail");
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    private void OnNativeBarcodeScanned(string barcode) =>
        _ = InvokeAsync(() => OnHardwareScanAsync(barcode));

    private bool TrySignIn((string Token, PopSessionDto Session, string? Reason)? result, string fallback)
    {
        if (result is null)
        {
            Set("Authentication service is unavailable.", "fail");
            return false;
        }

        if (result.Value.Session is null)
        {
            Set("Sign-in failed. " + (result.Value.Reason ?? fallback), "fail");
            return false;
        }

        Auth.SignIn(result.Value.Token, result.Value.Session);
        Nav.NavigateTo("/home", replace: true);
        return true;
    }

    private static string NormalizeScan(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Replace("\u0002", "").Replace("\u0003", "").Replace("\r", "").Replace("\n", "").Trim();

    private void Set(string message, string cssClass)
    {
        _status = message;
        _cls = cssClass;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
