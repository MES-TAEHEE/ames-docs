@page "/login"
@implements IAsyncDisposable
@inject AuthState Auth
@inject AuthApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="pda-login">
    <div class="pda-login-brand">A-MES</div>
    <div class="pda-login-sub">BARCODE LOGIN / PDA</div>

    <div class="pda-login-center">
        <div class="pda-login-panel">
            <div class="pda-fld">
                <label>EMPLOYEE BARCODE</label>
                <input class="pda-input pda-login-barcode"
                       @bind="_barcode"
                       @bind:event="oninput"
                       @onkeydown="OnBarcodeKeyDown"
                       placeholder="Scan employee barcode"
                       autocomplete="off"
                       disabled="@_submitting" />
            </div>
            <button class="pda-login-submit"
                    disabled="@(_submitting || string.IsNullOrWhiteSpace(_barcode))"
                    @onclick="SubmitBarcodeAsync">
                @(_submitting ? "SIGNING IN..." : "SIGN IN")
            </button>
        </div>

        <div class="pda-login-scan-state">
            <RadzenIcon Icon="barcode_scanner" />
            <strong>READY TO SCAN</strong>
        </div>

        <div class="pda-status @_cls">@_status</div>
    </div>
</div>

@code {
    private string _barcode = "";
    private string _status = " ";
    private string _cls = "dim";
    private bool _submitting;
    private DotNetObjectReference<Login>? _scannerRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
        _scannerRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pdaScan.register", _scannerRef,
            new { minLength = 5, developerMode = MauiProgram.IsDeveloperMode });
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        if (_submitting) return;
        _barcode = NormalizeScan(scanText);
        if (_barcode.Length == 0) return;

        await AuthenticateBarcodeAsync();
    }

    private async Task OnBarcodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitBarcodeAsync();
    }

    private Task SubmitBarcodeAsync()
    {
        _barcode = NormalizeScan(_barcode);
        if (_barcode.Length == 0)
        {
            Set("Scan or enter an employee barcode.", "fail");
            return Task.CompletedTask;
        }

        return AuthenticateBarcodeAsync();
    }

    private async Task AuthenticateBarcodeAsync()
    {
        _submitting = true;
        Set("Signing in with employee barcode...", "dim");
        try
        {
            var res = await Api.LoginByBarcodeAsync(_barcode);
            TrySignIn(res, "Scan or enter a valid employee barcode.");
        }
        catch (Exception ex)
        {
            Set("Sign-in failed. " + ex.Message, "fail");
        }
        finally
        {
            _submitting = false;
        }
    }

    private void OnNativeBarcodeScanned(string barcode) =>
        _ = InvokeAsync(() => OnHardwareScanAsync(barcode));

    private bool TrySignIn((string Token, PopSessionDto Session, string? Reason)? result, string fallback)
    {
        if (result is null)
        {
            Set("Authentication service is unavailable.", "fail");
            return false;
        }

        if (result.Value.Session is null)
        {
            Set("Sign-in failed. " + (result.Value.Reason ?? fallback), "fail");
            return false;
        }

        Auth.SignIn(result.Value.Token, result.Value.Session);
        Nav.NavigateTo("/home", replace: true);
        return true;
    }

    private static string NormalizeScan(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Replace("\u0002", "").Replace("\u0003", "").Replace("\r", "").Replace("\n", "").Trim();

    private void Set(string message, string cssClass)
    {
        _status = message;
        _cls = cssClass;
    }

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
