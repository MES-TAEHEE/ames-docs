@page "/dash"
@inject AuthState Auth
@inject PdaApi Api
@inject NavigationManager Nav

@*  Boot-of-day dashboard — confirms auth + shows a sample API call
    (WH inbound rows). Module tiles will land here as WH-01..FG-09 ship. *@

<div class="pda-shell">
    <div class="pda-tbar">
        <span class="pda-tbar-brand">A-MES PDA</span>
        <span class="pda-tbar-emp">@(Auth.Session?.EmployeeNo)</span>
        <button class="pda-tbar-out" @onclick="Logout">⏻</button>
    </div>

    <div class="pda-bd">
        <div class="pda-card">
            <div class="pda-card-h">▼ SESSION</div>
            <div class="pda-card-row">@(Auth.Session?.EmployeeName)</div>
            <div class="pda-card-row dim">@(Auth.Session?.LineId)  ·  @(Auth.Session?.ShiftCode)</div>
            <div class="pda-card-row dim">expires @(Auth.Session?.ExpiresAt.ToString("HH:mm"))</div>
        </div>

        <div class="pda-card">
            <div class="pda-card-h">▼ WH INBOUND · TODAY (@_rows.Count)</div>
            @if (_rows.Count == 0)
            {
                <div class="pda-empty">@_listStatus</div>
            }
            else
            {
                @foreach (var r in _rows)
                {
                    <div class="pda-row">
                        <span class="pda-row-code">@r.LotCode</span>
                        <span class="pda-row-item">@(r.ItemName ?? r.ItemNo ?? "—")</span>
                        <span class="pda-row-qty">@r.Qty.ToString("0")</span>
                    </div>
                }
            }
        </div>

        <button class="pda-btn-pri" @onclick="Reload">↻ REFRESH</button>
    </div>
</div>

@code {
    private List<PdaApi.InboundRow> _rows = new();
    private string _listStatus = "Loading...";

    protected override async Task OnInitializedAsync()
    {
        if (Auth.Session is null) { Nav.NavigateTo("/login", replace: true); return; }
        await Reload();
    }

    private async Task Reload()
    {
        try
        {
            _listStatus = "Loading...";
            _rows = await Api.WhInboundTodayAsync();
            if (_rows.Count == 0) _listStatus = "No inbound today.";
        }
        catch (Exception ex) { _listStatus = "× " + ex.Message; }
    }

    private async Task Logout()
    {
        try { await Api.LogoutAsync(); } catch { }
        Nav.NavigateTo("/login", replace: true);
        Auth.SignOut();
    }
}
