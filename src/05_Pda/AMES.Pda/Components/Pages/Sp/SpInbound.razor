@page "/sp/02"
@inject SparePartsApi Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh02-shell sp-screen">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/sp"))' Text="&lt;" />
        <span class="pda-tbar-brand">INBOUND</span>
        @if (IsSimpleTestMode)
        {
            <PptScenarioPanel Title="SP INBOUND" Steps="ScenarioSteps" Busy="_busy"
                              OnStart="StartScenario" OnValue="RunScenario" OnReset="ResetScenario"
                              OpenChanged="@((bool open) => _scenarioOpen = open)" />
        }
    </div>

    <div class="pda-bd wh02-body sp-body">
        <RadzenCard class="wh02-panel wh02-scan-panel hardware-scan-panel">
            <div class="pda-fld">
                <label>EOS SP NO</label>
                <RadzenTextBox class="pda-input wh02-barcode-input pda-scan-input"
                               Value="@_lotNo" @oninput="OnLotInput" @onkeydown="OnLotKey"
                               Placeholder="Scan EOS SP No" />
            </div>
        </RadzenCard>

        @if (_lot is not null)
        {
            <RadzenCard class="wh02-lot-card ready">
                <div class="wh02-lot-top">
                    <div class="wh02-lot-main"><span>EOS SP NO</span><strong>@_lot.EosSpNo</strong></div>
                    <RadzenBadge class="wh02-status-chip ready" Text="READY" />
                </div>
                <div class="sp-detail-grid">
                    @foreach (var field in DetailFields())
                    {
                        <div class="sp-detail-row"><span>@field.Label</span><strong>@Text(field.Value)</strong></div>
                    }
                </div>
            </RadzenCard>

            <RadzenCard class="wh02-panel wh02-location-panel hardware-scan-panel">
                <div class="pda-fld">
                    <label>STORAGE LOCATION</label>
                    <RadzenTextBox class="pda-input wh02-location-input pda-scan-input"
                                   Value="@_locationNo" @oninput="OnLocationInput" @onkeydown="OnLocationKey"
                                   Placeholder="Scan SP location" />
                </div>
            </RadzenCard>
            @if (_location is not null)
            {
                <RadzenCard class="wh02-location-card">
                    <div class="wh02-location-card-top"><span>STORAGE LOCATION</span><strong>@_location.LocationId</strong></div>
                </RadzenCard>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="pda-status @_messageClass">@_message</div>
        }

        <div class="wh02-action-bar has-reset">
            <RadzenButton class="wh02-clear-btn" Text="CLEAR" Click="Clear" Disabled="@_busy" />
            <RadzenButton class="@($"pda-btn-pri wh02-receive-btn wh02-receive-action-btn {(CanReceive ? "ready" : "blocked")}")"
                          Text="RECEIVE" Click="Receive" Disabled="@_busy" />
        </div>
    </div>

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@(_modalKind == "success" ? "OK" : "!")</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions"><RadzenButton class="wh-modal-btn primary" Click="CloseModal" Text="OK" /></div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    private static readonly PptScenarioPanel.Step[] ScenarioSteps =
    [
        new("EOS SP No 입고", "EOS SP No와 SP 위치를 스캔한 뒤 1 EA 입고를 확인합니다.",
            new PptScenarioPanel.Value("EOS SP NO", "EOS-SP-K9-269999", "INBOUND"), new PptScenarioPanel.Value("위치", "SP-EXTRA", "LOCATION")),
        new("미등록 EOS SP No", "등록되지 않은 EOS SP No의 조회 오류를 확인합니다.",
            new PptScenarioPanel.Value("EOS SP NO", "EOS-SP-X0-000000", "UNKNOWN"))
    ];

    private bool IsSimpleTestMode => PdaScenarioUsers.IsSimple(Auth.Session?.EmployeeNo);
    private bool CanReceive => _lot is not null && _location is not null;
    private string _lotNo = "";
    private string _locationNo = "";
    private string _message = "";
    private string _messageClass = "dim";
    private bool _busy;
    private bool _scenarioOpen;
    private bool _modalOpen;
    private string _modalTitle = "";
    private string _modalMessage = "";
    private string _modalKind = "info";
    private PdaApi.SparePartRow? _lot;
    private PdaApi.LocationRow? _location;
    private DotNetObjectReference<SpInbound>? _scannerRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
        _scannerRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = MauiProgram.IsDeveloperMode });
        await FocusScannerAsync();
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        if (_busy || _scenarioOpen || _modalOpen) return;
        var value = NormalizeScan(scanText);
        if (_lot is not null && _location is null)
        {
            _locationNo = value;
            await ScanLocation();
        }
        else
        {
            _lotNo = value;
            await ScanLot();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnNativeBarcodeScanned(string value) => _ = InvokeAsync(() => OnHardwareScanAsync(value));
    private void OnLotInput(ChangeEventArgs e) => _lotNo = e.Value?.ToString() ?? "";
    private void OnLocationInput(ChangeEventArgs e) => _locationNo = e.Value?.ToString() ?? "";
    private async Task OnLotKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ScanLot(); }
    private async Task OnLocationKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ScanLocation(); }

    private async Task ScanLot()
    {
        var value = NormalizeScan(_lotNo);
        if (value.Length == 0) { ShowModal("EOS SP No Required", "Scan an EOS SP No.", "warn"); return; }
        _busy = true;
        _lot = null;
        _location = null;
        _locationNo = "";
        try
        {
            _lot = await Api.SpItemAsync(value);
            if (_lot is null) { _message = "EOS SP No was not found."; _messageClass = "fail"; return; }
            _lotNo = _lot.EosSpNo;
            _message = "Spare part loaded. Scan a storage location.";
            _messageClass = "ok";
        }
        catch (Exception ex) { _message = ex.Message; _messageClass = "fail"; }
        finally { _busy = false; }
    }

    private async Task ScanLocation()
    {
        if (_lot is null) return;
        var value = NormalizeScan(_locationNo);
        if (value.Length == 0) { ShowModal("Location Required", "Scan a Spare Parts Area location.", "warn"); return; }
        _busy = true;
        try
        {
            _location = await Api.WhScanLocationAsync(value, PdaApi.SparePartsAreaCode);
            _locationNo = _location?.LocationId ?? value;
            _message = _location is null ? "Storage location was not found." : "Location verified. Ready to receive.";
            _messageClass = _location is null ? "fail" : "ok";
        }
        catch (Exception ex) { _location = null; _message = ex.Message; _messageClass = "fail"; }
        finally { _busy = false; }
    }

    private async Task Receive()
    {
        if (!CanReceive) { ShowModal("Not Ready", _lot is null ? "Scan an EOS SP No first." : "Scan a storage location first.", "warn"); return; }
        _busy = true;
        try
        {
            var result = await Api.SpReceiveAsync(new(_lot!.EosSpNo, 1, _location!.LocationId, "PDA spare parts inbound"));
            if (!result.Success) { ShowModal("Inbound Failed", result.Message, "fail"); return; }
            _lot = result.Row ?? await Api.SpItemAsync(_lot.EosSpNo);
            ShowModal("Inbound Complete", $"1 EA of {_lotNo} was received at {_locationNo}.", "success");
        }
        catch (Exception ex) { ShowModal("Inbound Failed", ex.Message, "fail"); }
        finally { _busy = false; }
    }

    private (string Label, string? Value)[] DetailFields() =>
    [
        ("CATEGORY", _lot?.Category), ("APPLICABLE EQUIPMENT", _lot?.ApplicableEquipment),
        ("PART NAME", _lot?.PartName), ("PART NO", _lot?.PartNo),
        ("MAKER", _lot?.Maker), ("VENDOR", _lot?.Vendor),
        ("QTY", _lot is null ? null : $"{_lot.Qty:N0} {Text(_lot.Unit)}")
    ];

    private async Task StartScenario(int step)
    {
        await Api.SpResetTestAsync();
        await RunScenario(step == 1 ? "INBOUND" : "UNKNOWN");
    }

    private async Task RunScenario(string command)
    {
        if (command == "LOCATION") { _locationNo = "SP-EXTRA"; await ScanLocation(); return; }
        _lotNo = command == "INBOUND" ? "EOS-SP-K9-269999" : "EOS-SP-X0-000000";
        await ScanLot();
    }

    private async Task ResetScenario()
    {
        await Api.SpResetTestAsync();
        Clear();
        ShowModal("Test Data Ready", "The EOS SP No test stock was reset.", "success");
    }

    private void Clear() { _lotNo = _locationNo = _message = ""; _lot = null; _location = null; }
    private void ShowModal(string title, string message, string kind) { _modalTitle = title; _modalMessage = message; _modalKind = kind; _modalOpen = true; }
    private void CloseModal() { _modalOpen = false; _ = FocusScannerAsync(); }
    private async Task FocusScannerAsync() { try { await JS.InvokeVoidAsync("pdaScan.focus", ".sp-screen .pda-scan-input"); } catch { } }
    private static string NormalizeScan(string? value) => string.IsNullOrWhiteSpace(value) ? "" : value.Replace("\u0002", "").Replace("\u0003", "").Trim();
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
