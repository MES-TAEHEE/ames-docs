@page "/"
@page "/home"
@inject AuthState Auth
@inject AuthApi Api
@inject NavigationManager Nav

@*  Module tile launcher — first screen after login. *@

@if (Auth.Session is null)
{
    <div class="pda-empty" style="padding-top:120px;">Redirecting to login…</div>
}
else
{
    <div class="pda-shell">
        <div class="pda-tbar">
            <span class="pda-tbar-brand">A-MES PDA</span>
            <span class="pda-tbar-emp">@Auth.Session.EmployeeNo</span>
            <button type="button" class="pda-tbar-out" @onclick="Logout" aria-label="Sign out" title="Sign out">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                    <path d="M18.36 6.64a9 9 0 1 1-12.72 0" />
                    <line x1="12" y1="2" x2="12" y2="12" />
                </svg>
            </button>
        </div>

        <div class="pda-bd">
            <div class="pda-greet">@Auth.Session.EmployeeName</div>
            <div class="pda-greet-sub">@Auth.Session.TerminalId</div>

            <div class="pda-tiles">
                <button class="pda-tile maintenance" @onclick='@(() => Nav.NavigateTo("/mnt"))'>
                    <div class="pda-tile-ic">🛠</div>
                    <div class="pda-tile-cap">MAINTENANCE</div>
                    <div class="pda-tile-sub">2 screens</div>
                </button>
                <button class="pda-tile wh" @onclick='@(() => Nav.NavigateTo("/wh"))'>
                    <div class="pda-tile-ic">📦</div>
                    <div class="pda-tile-cap">WAREHOUSE</div>
                    <div class="pda-tile-sub">6 screens</div>
                </button>
                <button class="pda-tile sp" @onclick='@(() => Nav.NavigateTo("/sp"))'>
                    <div class="pda-tile-ic">🔧</div>
                    <div class="pda-tile-cap">SPARE PARTS</div>
                    <div class="pda-tile-sub">5 screens</div>
                </button>
                <button class="pda-tile fg" @onclick='@(() => Nav.NavigateTo("/fg"))'>
                    <div class="pda-tile-ic">🚚</div>
                    <div class="pda-tile-cap">FINISHED GOODS</div>
                    <div class="pda-tile-sub">10 screens (soon)</div>
                </button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        if (Auth.Session is null) Nav.NavigateTo("/login", replace: true);
    }

    private async Task Logout()
    {
        try { await Api.LogoutAsync(); } catch { }
        Nav.NavigateTo("/login", replace: true);
        Auth.SignOut();
    }
}
