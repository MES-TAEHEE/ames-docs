@page "/fg"
@inject AuthState Auth
@inject NavigationManager Nav

<div class="pda-shell wh wh-home-shell fg-home-shell">
    <div class="pda-tbar">
        <button class="pda-tbar-back" @onclick='@(() => Nav.NavigateTo("/home"))'>&lt;</button>
        <div class="wh-home-title">
            <span class="pda-tbar-brand">FINISHED GOODS</span>
            <span>@Auth.Session?.EmployeeNo</span>
        </div>
    </div>
    <div class="pda-bd">
        <div class="pda-tile-grid wh-home-grid">
            <button class="pda-tile sm wh-home-tile schedule" @onclick='@(() => Nav.NavigateTo("/fg/01"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="fact_check" /></span><div class="wh-home-tile-copy"><div class="pda-tile-cap">QC Waiting</div></div><span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile inbound" @onclick='@(() => Nav.NavigateTo("/fg/02"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="move_to_inbox" /></span><div class="wh-home-tile-copy"><div class="pda-tile-cap">Put-Away</div></div><span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile inventory" @onclick='@(() => Nav.NavigateTo("/fg/03"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="inventory_2" /></span><div class="wh-home-tile-copy"><div class="pda-tile-cap">Inventory</div></div><span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile adjust" @onclick='@(() => Nav.NavigateTo("/fg/adjust"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="tune" /></span><div class="wh-home-tile-copy"><div class="pda-tile-cap">Adjust</div></div><span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile release" @onclick='@(() => Nav.NavigateTo("/fg/04"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="shopping_cart_checkout" /></span><div class="wh-home-tile-copy"><div class="pda-tile-cap">Release Picking</div></div><span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile adjust" @onclick='@(() => Nav.NavigateTo("/fg/05"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="local_shipping" /></span><div class="wh-home-tile-copy"><div class="pda-tile-cap">Truck Loading</div></div><span class="wh-home-tile-go">&gt;</span>
            </button>
            <button class="pda-tile sm wh-home-tile transactions" @onclick='@(() => Nav.NavigateTo("/fg/06"))'>
                <span class="wh-home-tile-ic"><RadzenIcon Icon="assignment_return" /></span><div class="wh-home-tile-copy"><div class="pda-tile-cap">Customer Return</div></div><span class="wh-home-tile-go">&gt;</span>
            </button>
        </div>
    </div>
</div>
