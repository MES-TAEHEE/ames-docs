@page "/fg/03"
@inject PdaApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh03-shell wh03-map-only fg03-shell inventory-browser-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/fg"))' Text="&lt;" />
        <div class="wh03-tbar-title"><span class="pda-tbar-brand">INVENTORY</span></div>
        <div class="wh03-tbar-actions"><RadzenButton class="wh03-refresh" Click="LoadInventory" Disabled="@_isLoading" Text="REFRESH" /></div>
    </div>

    <div class="pda-bd wh03-body">
        <div class="inventory-browse-tabs">
            <button type="button" class="@ModeClass("Location")" disabled="@_isLoading" @onclick='@(() => SetMode("Location"))'>BY LOCATION</button>
            <button type="button" class="@ModeClass("Part")" disabled="@_isLoading" @onclick='@(() => SetMode("Part"))'>BY PART</button>
        </div>

        @if (_selectedPart is not null)
        {
            <div class="inventory-detail-page">
                <div class="inventory-detail-head">
                    <RadzenButton class="inventory-back" Click="ClosePart" Text="&lt; BACK" />
                    <div><span>PART</span><strong>@Text(_selectedPart.PartNo)</strong><em>@Text(_selectedPart.PartName)</em></div>
                    <strong>@Qty(_selectedPart.TotalQty, _selectedPart.Unit)</strong>
                </div>
                <div class="inventory-table-head inventory-lot-grid"><span>LOT</span><span>QTY</span><span>LOCATION</span></div>
                <div class="inventory-table-list">
                    @foreach (var lot in _partLots)
                    {
                        <div class="inventory-table-row inventory-lot-grid">
                            <strong>@Text(lot.LotNo)</strong><strong>@Qty(lot.Qty, lot.Unit)</strong><strong>@Text(lot.Location)</strong>
                        </div>
                    }
                </div>
            </div>
        }
        else if (IsLocationMode && _selectedLocation is not null)
        {
            <div class="inventory-detail-page">
                <div class="inventory-detail-head">
                    <RadzenButton class="inventory-back" Click="CloseLocation" Text="&lt; BACK" />
                    <div><span>LOCATION</span><strong>@Text(_selectedLocation.Location)</strong></div>
                    <strong>@Qty(_selectedLocation.TotalQty, _selectedLocation.Unit)</strong>
                </div>
                <div class="inventory-table-head inventory-part-detail-grid"><span>PART</span><span>QTY</span></div>
                <div class="inventory-table-list">
                    @foreach (var part in LocationParts)
                    {
                        <button type="button" class="inventory-table-row inventory-part-detail-grid" @onclick="@(() => OpenPart(part))">
                            <span class="inventory-part-cell"><strong>@Text(part.PartNo)</strong><small>@Text(part.PartName)</small></span>
                            <strong>@Qty(part.TotalQty, part.Unit)</strong>
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <RadzenCard class="@($"wh03-search-card wh03-scan-card wh03-location-search {ScanPanelClass}")">
                <div class="pda-fld">
                    <label>INVENTORY SCAN</label>
                    <RadzenTextBox class="pda-input wh03-search-input wh03-location-query pda-scan-input"
                                   Value="@_query" @oninput="OnQueryInput" @onkeydown="OnQueryKey"
                                   Placeholder="Scan Lot, Part, or Location No" />
                </div>
                @if (ShowDeveloperScanButtons)
                {
                    <RadzenButton class="wh03-search-btn" Click="Search" Disabled="@_isLoading" Text="SCAN" />
                }
            </RadzenCard>

            @if (_isLoading)
            {
                <div class="pda-empty">Loading inventory...</div>
            }
            else if ((IsLocationMode && LocationRows.Count == 0) || (!IsLocationMode && PartRows.Count == 0))
            {
                <div class="pda-empty">@_message</div>
            }
            else if (IsLocationMode)
            {
                <div class="inventory-table-head inventory-location-grid"><span>LOCATION</span><span>QTY</span></div>
                <div class="inventory-table-list inventory-main-list">
                    @foreach (var location in LocationRows)
                    {
                        <button type="button" class="inventory-table-row inventory-location-grid" @onclick="@(() => OpenLocation(location))">
                            <strong>@Text(location.Location)</strong><strong>@Qty(location.TotalQty, location.Unit)</strong>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="inventory-table-head inventory-part-grid"><span>PART</span><span>QTY</span><span>LOCATION</span></div>
                <div class="inventory-table-list inventory-main-list">
                    @foreach (var part in PartRows)
                    {
                        <button type="button" class="inventory-table-row inventory-part-grid" @onclick="@(() => OpenPart(part))">
                            <span class="inventory-part-cell"><strong>@Text(part.PartNo)</strong><small>@Text(part.PartName)</small></span>
                            <strong>@Qty(part.TotalQty, part.Unit)</strong><strong>@Text(part.Location)</strong>
                        </button>
                    }
                </div>
            }

            <div class="wh03-location-clear-bar">
                <RadzenButton class="wh03-location-clear" Click="ClearSearch" Disabled="@string.IsNullOrWhiteSpace(_query)" Text="CLEAR" />
            </div>
        }
    </div>
</div>

@code {
    private string _mode = "Location";
    private string _query = "";
    private string _message = "No finished goods inventory found.";
    private bool _isLoading;
    private List<PdaApi.FgStockRow> _rows = [];
    private HashSet<int>? _matchedStockIds;
    private FgLocationSummary? _selectedLocation;
    private FgPartSummary? _selectedPart;
    private List<PdaApi.FgStockRow> _partLots = [];
    private DotNetObjectReference<Fg02Inventory>? _scannerRef;

    private static bool ShowDeveloperScanButtons => MauiProgram.IsDeveloperMode;
    private static string ScanPanelClass => ShowDeveloperScanButtons ? "dev-scan-panel" : "hardware-scan-panel";
    private bool IsLocationMode => string.Equals(_mode, "Location", StringComparison.OrdinalIgnoreCase);
    private IEnumerable<PdaApi.FgStockRow> VisibleRows => (_matchedStockIds is null ? _rows : _rows.Where(row => _matchedStockIds.Contains(row.StockId))).Where(IsCurrentStock);
    private List<FgLocationSummary> LocationRows => VisibleRows
        .Where(row => !string.IsNullOrWhiteSpace(row.Location))
        .GroupBy(row => row.Location!.Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(group => new FgLocationSummary(group.Key, group.Sum(row => row.Qty), Unit(group)))
        .OrderBy(row => row.Location, StringComparer.OrdinalIgnoreCase).ToList();
    private List<FgPartSummary> PartRows => VisibleRows
        .Where(row => !string.IsNullOrWhiteSpace(row.Location))
        .GroupBy(row => new { row.ItemNo, row.ItemName, Location = row.Location!.Trim(), Unit = Unit(row) })
        .Select(group => new FgPartSummary(group.Key.ItemNo, group.Key.ItemName, group.Key.Location, group.Sum(row => row.Qty), group.Key.Unit))
        .OrderBy(row => row.PartNo, StringComparer.OrdinalIgnoreCase).ThenBy(row => row.Location, StringComparer.OrdinalIgnoreCase).ToList();
    private List<FgPartSummary> LocationParts => _selectedLocation is null ? [] : _rows
        .Where(IsCurrentStock)
        .Where(row => string.Equals(row.Location?.Trim(), _selectedLocation.Location, StringComparison.OrdinalIgnoreCase))
        .GroupBy(row => new { row.ItemNo, row.ItemName, Unit = Unit(row) })
        .Select(group => new FgPartSummary(group.Key.ItemNo, group.Key.ItemName, _selectedLocation.Location, group.Sum(row => row.Qty), group.Key.Unit))
        .OrderBy(row => row.PartNo, StringComparer.OrdinalIgnoreCase).ToList();

    protected override async Task OnInitializedAsync() => await LoadInventory();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
        _scannerRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = ShowDeveloperScanButtons });
        await JS.InvokeVoidAsync("pdaScan.focus", ".fg03-shell .pda-scan-input");
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        _query = NormalizeScan(scanText);
        if (!string.IsNullOrWhiteSpace(_query)) await Search();
        await InvokeAsync(StateHasChanged);
    }

    private void OnNativeBarcodeScanned(string barcode) => _ = InvokeAsync(() => OnHardwareScanAsync(barcode));
    private void OnQueryInput(ChangeEventArgs e) => _query = e.Value?.ToString() ?? "";
    private async Task OnQueryKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }
    private string ModeClass(string mode) => $"inventory-browse-tab {(string.Equals(_mode, mode, StringComparison.OrdinalIgnoreCase) ? "on" : "")}";

    private void SetMode(string mode)
    {
        _mode = mode;
        _selectedLocation = null;
        _selectedPart = null;
        _partLots = [];
    }

    private async Task LoadInventory()
    {
        if (_isLoading) return;
        _isLoading = true;
        try
        {
            _rows = await Api.FgInventoryAsync();
            _matchedStockIds = null;
            _message = VisibleRows.Any() ? "" : "No finished goods inventory found.";
        }
        catch (Exception ex)
        {
            _rows = [];
            _message = ex.Message;
        }
        finally { _isLoading = false; }
    }

    private async Task Search()
    {
        if (_isLoading || string.IsNullOrWhiteSpace(_query)) return;
        _isLoading = true;
        try
        {
            var matches = await Api.FgInventoryAsync(_query.Trim());
            _matchedStockIds = matches.Where(IsCurrentStock).Select(row => row.StockId).ToHashSet();
            _message = _matchedStockIds.Count == 0 ? "No finished goods stock matches this barcode." : "";
        }
        finally { _isLoading = false; }
    }

    private void ClearSearch()
    {
        _query = "";
        _matchedStockIds = null;
        _message = VisibleRows.Any() ? "" : "No finished goods inventory found.";
    }

    private void OpenLocation(FgLocationSummary location)
    {
        _selectedLocation = location;
        _selectedPart = null;
    }

    private void CloseLocation()
    {
        _selectedLocation = null;
        _selectedPart = null;
        _partLots = [];
    }

    private void OpenPart(FgPartSummary part)
    {
        _selectedPart = part;
        _partLots = _rows.Where(IsCurrentStock)
            .Where(row => string.Equals(row.ItemNo, part.PartNo, StringComparison.OrdinalIgnoreCase)
                && string.Equals(row.Location?.Trim(), part.Location, StringComparison.OrdinalIgnoreCase))
            .OrderBy(row => row.LotNo, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void ClosePart()
    {
        _selectedPart = null;
        _partLots = [];
    }

    private static bool IsCurrentStock(PdaApi.FgStockRow row)
    {
        var status = (row.Status ?? "Available").Trim().ToUpperInvariant();
        return row.Qty > 0 && status is not ("SHIPPED" or "DELIVERED" or "CANCELLED" or "CLOSED");
    }
    private static string Unit(IEnumerable<PdaApi.FgStockRow> rows) => rows.Select(Unit).FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "EA";
    private static string Unit(PdaApi.FgStockRow row) => string.IsNullOrWhiteSpace(row.Unit) ? "EA" : row.Unit.Trim();
    private static string NormalizeScan(string? value) => string.IsNullOrWhiteSpace(value) ? "" : value.Replace("\u0002", "").Replace("\u0003", "").Trim();
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    private static string Qty(decimal qty, string? unit) => $"{qty:0.###} {(string.IsNullOrWhiteSpace(unit) ? "EA" : unit)}";

    private sealed record FgLocationSummary(string Location, decimal TotalQty, string Unit);
    private sealed record FgPartSummary(string PartNo, string? PartName, string Location, decimal TotalQty, string Unit);

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
