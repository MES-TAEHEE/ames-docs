@page "/fg/02"
@inject PdaApi Api
@inject NavigationManager Nav

<div class="pda-shell fg">
    <div class="pda-tbar">
        <button class="pda-tbar-back" @onclick='@(() => Nav.NavigateTo("/fg"))'>←</button>
        <span class="pda-tbar-brand">FG-002 INVENTORY</span>
    </div>
    <div class="pda-bd">
        <div class="pda-card">
            <input class="pda-input" @bind="_q" @bind:event="oninput" @onkeypress="OnKey" placeholder="Search item or name…" />
        </div>
        <div class="pda-card">
            <div class="pda-card-h">▼ FG STOCK (@_rows.Count)</div>
            @if (_rows.Count == 0) { <div class="pda-empty">@_msg</div> }
            else
            {
                @foreach (var r in _rows)
                {
                    var cls = r.Status == "Reserved" ? "warn" : "";
                    <div class="pda-row3 @cls">
                        <div class="r3-l">
                            <div class="r3-code">@r.StockNumber</div>
                            <div class="r3-sub">@(r.ItemName ?? r.ItemNo)</div>
                        </div>
                        <div class="r3-m">
                            <div>@(r.Location ?? "—")</div>
                            <div class="r3-sub">@(r.CustomerCode ?? "")</div>
                        </div>
                        <div class="r3-r">
                            <div class="big">@r.Qty.ToString("0.#")</div>
                            <div class="r3-sub">@(r.Status ?? "")</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    string _q = "", _msg = "Loading…";
    List<PdaApi.FgStockRow> _rows = new();
    protected override async Task OnInitializedAsync() => await Load();
    void OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") _ = Load(); }
    async Task Load()
    {
        _msg = "Loading…";
        _rows = await Api.FgInventoryAsync(_q);
        if (_rows.Count == 0) _msg = "No FG stock matches.";
    }
}
