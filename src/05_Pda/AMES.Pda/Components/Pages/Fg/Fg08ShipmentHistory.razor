@page "/fg/08"
@inject PdaApi Api
@inject NavigationManager Nav

<div class="pda-shell fg">
    <div class="pda-tbar">
        <button class="pda-tbar-back" @onclick='@(() => Nav.NavigateTo("/fg"))'>←</button>
        <span class="pda-tbar-brand">FG-008 HISTORY</span>
    </div>
    <div class="pda-bd">
        <div class="pda-card">
            <div class="pda-card-h">▼ RECENT SHIPMENTS (@_rows.Count)</div>
            @if (_rows.Count == 0) { <div class="pda-empty">@_msg</div> }
            else
            {
                @foreach (var r in _rows)
                {
                    var cls = r.OTDStatus == "OnTime" ? "ok" : r.OTDStatus == "Late" ? "bad" : "";
                    <div class="pda-row3 @cls">
                        <div class="r3-l">
                            <div class="r3-code">@r.LoadingNumber</div>
                            <div class="r3-sub">@r.ShipOrderNumber · @r.CustomerCode</div>
                        </div>
                        <div class="r3-m">
                            <div>@(r.LicensePlate ?? "—")</div>
                            <div class="r3-sub">@(r.DriverName ?? "")</div>
                        </div>
                        <div class="r3-r">
                            <div>@(r.DepartureTs?.ToString("MM-dd HH:mm") ?? "—")</div>
                            <div class="r3-sub">@(r.OTDStatus ?? "")</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    List<PdaApi.FgHistoryRow> _rows = new();
    string _msg = "Loading…";
    protected override async Task OnInitializedAsync()
    {
        _rows = await Api.FgHistoryAsync();
        if (_rows.Count == 0) _msg = "No shipment history.";
    }
}
