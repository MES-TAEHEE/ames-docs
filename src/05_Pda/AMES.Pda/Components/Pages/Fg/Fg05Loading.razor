@page "/fg/05"
@inject PdaApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh07-shell fg05-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/fg"))' Text="&lt;" />
        <div class="wh07-tbar-title"><span class="pda-tbar-brand">TRUCK LOADING</span></div>
    </div>

    <div class="fg05-scan-guide">
        <span>NEXT SCAN</span>
        <strong>@ScanPrompt</strong>
        <small>@ScanFormat</small>
    </div>

    <div class="pda-bd wh07-body fg05-body">
        <RadzenCard class="wh07-panel fg05-scan-panel scan-only">
            <div class="pda-fld">
                <label>BARCODE SCAN</label>
                <RadzenTextBox class="pda-input wh07-input fg05-barcode-input pda-scan-input"
                               Value="@ScanValue"
                               @oninput="OnScanInput"
                               @onkeydown="OnScanKey"
                               Placeholder="Scan barcode" />
            </div>
        </RadzenCard>

        @if (_truck is not null)
        {
            <div class="fg05-section-head truck"><strong>TRUCK INFORMATION</strong><span>Scanned truck</span></div>
            <RadzenCard class="wh07-summary-card fg05-truck-card">
                <div class="wh07-summary-top">
                    <div><span>TRUCK</span><strong>@_truck.LicensePlate</strong></div>
                    <RadzenBadge class="wh07-status ready" Text="VERIFIED" />
                </div>
            </RadzenCard>
        }

        @if (_truck is not null && _order is not null)
        {
            <div id="fg05-shipment-info" class="fg05-section-head order"><strong>SHIPMENT ORDER INFORMATION</strong><span>Scanned document</span></div>
            <RadzenCard class="wh07-summary-card fg05-order-card">
                <div class="fg05-order-head">
                    <div><span>SHIPMENT ORDER</span><strong>@_order.ShipOrderNumber</strong></div>
                    <RadzenBadge class="wh07-status ready" Text="@($"{_order.Items.Count} PRODUCTS")" />
                </div>
                <div class="fg05-detail-rows">
                    <div class="fg05-detail-row"><span>CUSTOMER</span><strong>@Text(_order.CustomerCode)</strong></div>
                    <div class="fg05-detail-row"><span>DESTINATION</span><strong>@Text(_order.Destination)</strong></div>
                    <div class="fg05-detail-row"><span>SHIP DATE</span><strong>@(_order.ShipDate?.ToString("MM/dd/yyyy") ?? "-")</strong></div>
                    <div class="fg05-detail-row"><span>SCANNED</span><strong>@_scannedStockIds.Count / @_order.Items.Count</strong></div>
                </div>
            </RadzenCard>
            <div class="fg05-section-head products"><strong>PRODUCTS TO LOAD</strong><span>@_order.Items.Count product(s) required</span></div>
            <div class="wh07-line-list fg05-item-list">
                @foreach (var item in _order.Items)
                {
                    var scanned = IsScanned(item);
                    <RadzenCard class="@($"wh07-line-card fg05-item-card {(scanned ? "scanned" : "open")}")">
                        <div class="fg05-item-row" title="@($"{Text(item.ItemName)} · {Text(item.Location)}")">
                            <div class="fg05-item-primary">
                                <strong>@Text(item.StockNumber)</strong>
                                <span class="fg05-row-location">@Text(item.Location)</span>
                            </div>
                            <div class="fg05-item-secondary">
                                <span>@item.ItemNo</span>
                                <span class="fg05-row-unit">@item.Qty.ToString("0.###") @(item.Unit ?? "EA")</span>
                            </div>
                        </div>
                    </RadzenCard>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="pda-status @_messageClass">@_message</div>
        }

        <div class="wh07-action-spacer"></div>
        <div class="wh07-release-bar fg05-action-bar">
            <RadzenButton class="wh07-clear-btn" Click="Clear" Disabled="@_isBusy" Text="CLEAR" />
            <RadzenButton class="@($"wh07-release-btn {(AllScanned ? "ready" : "blocked")}")"
                          Click="ConfirmLoading" Disabled="@(_isBusy || !AllScanned)" Text="CONFIRM" />
        </div>
    </div>

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@(_modalKind == "success" ? "OK" : "!")</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions"><RadzenButton class="wh-modal-btn primary" Click="CloseModal" Text="OK" /></div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    private static bool ShowDeveloperScanButtons => MauiProgram.IsDeveloperMode;

    private readonly HashSet<int> _scannedStockIds = new();
    private PdaApi.FgLoadingOrderRow? _order;
    private PdaApi.FgLoadingTruckRow? _truck;
    private string _orderBarcode = "";
    private string _truckBarcode = "";
    private string _productBarcode = "";
    private string _message = "";
    private string _messageClass = "dim";
    private bool _isBusy;
    private bool _scrollShipmentAfterRender;
    private bool _modalOpen;
    private string _modalTitle = "";
    private string _modalMessage = "";
    private string _modalKind = "info";
    private DotNetObjectReference<Fg05Loading>? _scannerRef;

    private bool AllScanned => _order is not null && _order.Items.Count > 0
        && _scannedStockIds.Count == _order.Items.Count;
    private string ScanValue
    {
        get => _truck is null ? _truckBarcode : _order is null ? _orderBarcode : _productBarcode;
        set
        {
            if (_truck is null) _truckBarcode = value;
            else if (_order is null) _orderBarcode = value;
            else _productBarcode = value;
        }
    }
    private string ScanPrompt => _truck is null
        ? "TRUCK BARCODE"
        : _order is null
            ? "SHIPMENT ORDER BARCODE"
            : "STOCK BARCODE";
    private string ScanFormat => _truck is null
        ? "Required format: TRUCK:<license plate>"
        : _order is null
            ? "Scan the shipment order document"
            : "Scan a stock from the loading list";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
            _scannerRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pdaScan.register", _scannerRef,
                new { minLength = 3, developerMode = ShowDeveloperScanButtons });
        }
        if (_scrollShipmentAfterRender)
        {
            _scrollShipmentAfterRender = false;
            await JS.InvokeVoidAsync("pdaScan.scrollTo", "#fg05-shipment-info", 0);
        }
        if (firstRender) await FocusScannerAsync();
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        var value = Normalize(scanText);
        if (string.IsNullOrWhiteSpace(value)) return;

        ScanValue = value;
        await ScanCurrent();
        await InvokeAsync(StateHasChanged);
    }

    private void OnNativeBarcodeScanned(string barcode) => _ = InvokeAsync(() => OnHardwareScanAsync(barcode));
    private void OnScanInput(ChangeEventArgs e) => ScanValue = e.Value?.ToString() ?? "";
    private async Task OnScanKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ScanCurrent(); }
    private Task ScanCurrent() => _truck is null
        ? ScanTruck()
        : _order is null
            ? ScanOrder()
            : ScanProduct();

    private async Task ScanOrder()
    {
        if (_truck is null)
        {
            ShowModal("Truck Required", "Scan the truck barcode before the shipment order.", "warn");
            return;
        }

        var barcode = Normalize(_orderBarcode);
        if (string.IsNullOrWhiteSpace(barcode))
        {
            ShowModal("Shipment Order Required", "Scan the shipment order barcode first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var result = await Api.FgLoadingOrderScanAsync(barcode);
            if (!result.Success || result.Order is null)
            {
                ShowModal("Shipment Order Validation", result.Message, "warn");
                return;
            }

            _order = result.Order;
            _scrollShipmentAfterRender = true;
            _orderBarcode = result.Order.Barcode;
            _productBarcode = "";
            _scannedStockIds.Clear();
            _message = result.Message;
            _messageClass = "ok";
        }
        finally
        {
            _isBusy = false;
            await FocusScannerAsync();
        }
    }

    private async Task ScanTruck()
    {
        var barcode = Normalize(_truckBarcode);
        if (string.IsNullOrWhiteSpace(barcode))
        {
            ShowModal("Truck Required", "Scan the truck barcode.", "warn");
            return;
        }
        if (!barcode.StartsWith("TRUCK:", StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(barcode["TRUCK:".Length..]))
        {
            _truckBarcode = "";
            ShowModal("Truck Barcode", "Invalid truck barcode. Expected TRUCK:<license plate>.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var result = await Api.FgLoadingTruckScanAsync(barcode);
            if (!result.Success || result.Truck is null)
            {
                ShowModal("Truck Validation", result.Message, "warn");
                return;
            }

            _truck = result.Truck;
            _truckBarcode = result.Truck.Barcode;
            _order = null;
            _orderBarcode = "";
            _productBarcode = "";
            _scannedStockIds.Clear();
            _message = "Truck verified. Scan the shipment order.";
            _messageClass = "ok";
        }
        finally
        {
            _isBusy = false;
            await FocusScannerAsync();
        }
    }

    private async Task ScanProduct()
    {
        if (_order is null || _truck is null)
        {
            ShowModal("Loading Not Ready", "Scan the truck and shipment order first.", "warn");
            return;
        }

        var barcode = Normalize(_productBarcode);
        if (string.IsNullOrWhiteSpace(barcode))
        {
            ShowModal("Product Required", "Scan an FG LOT or stock barcode.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var result = await Api.FgLoadingItemScanAsync(barcode, _order.ShipmentOrderId);
            if (!result.Success || result.Item is null)
            {
                ShowModal("Product Validation", result.Message, "warn");
                return;
            }

            var expected = _order.Items.FirstOrDefault(x => x.StockId == result.Item.StockId);
            if (expected is null)
            {
                ShowModal("Wrong Product", "This product is not in the scanned shipment order.", "danger");
                return;
            }
            if (!_scannedStockIds.Add(expected.StockId))
            {
                ShowModal("Already Scanned", "This product is already checked in the loading list.", "warn");
                return;
            }

            _productBarcode = "";
            _message = AllScanned
                ? "All products scanned. Confirm truck loading."
                : $"{_scannedStockIds.Count} of {_order.Items.Count} product(s) scanned.";
            _messageClass = "ok";
        }
        finally
        {
            _isBusy = false;
            await FocusScannerAsync();
        }
    }

    private async Task ConfirmLoading()
    {
        if (_truck is null)
        {
            ShowModal("Truck Required", "Scan the truck barcode first.", "warn");
            return;
        }
        if (_order is null)
        {
            ShowModal("Shipment Order Required", "Scan the shipment order barcode.", "warn");
            return;
        }
        if (!AllScanned)
        {
            var remaining = _order.Items.Count - _scannedStockIds.Count;
            ShowModal("Products Remaining", $"Scan the remaining {remaining} product(s) before confirming.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var result = await Api.FgLoadingAsync(new PdaApi.FgLoadingReq(
                _truck.Barcode,
                _order.ShipmentOrderId,
                _scannedStockIds.ToList()));
            if (!result.Success)
            {
                ShowModal("Loading Failed", result.Message, "danger");
                return;
            }

            var truck = _truck.LicensePlate;
            var count = _scannedStockIds.Count;
            Clear();
            ShowModal("Loading Complete", $"{count} product(s) were loaded onto truck {truck}.", "success");
        }
        finally { _isBusy = false; }
    }

    private bool IsScanned(PdaApi.FgLoadingItemRow item) => _scannedStockIds.Contains(item.StockId);

    private void Clear()
    {
        _order = null;
        _truck = null;
        _scannedStockIds.Clear();
        _orderBarcode = "";
        _truckBarcode = "";
        _productBarcode = "";
        _message = "";
        _ = FocusScannerAsync();
    }

    private void ShowModal(string title, string message, string kind)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalOpen = true;
    }

    private void CloseModal() { _modalOpen = false; _ = FocusScannerAsync(); }

    private async Task FocusScannerAsync()
    {
        try { await JS.InvokeVoidAsync("pdaScan.focus", ".fg05-shell .fg05-barcode-input"); } catch { }
    }

    private static string Normalize(string? value) => string.IsNullOrWhiteSpace(value)
        ? ""
        : value.Replace("\u0002", "").Replace("\u0003", "").Trim();
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
