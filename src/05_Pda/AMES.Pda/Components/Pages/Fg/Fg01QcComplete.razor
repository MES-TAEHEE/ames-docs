@page "/fg/01"
@inject PdaUomFormat Uom
@inject FinishedGoodsApi Api
@inject AuthState Auth
@inject NavigationManager Nav

<div class="pda-shell wh wh01-shell fg-waiting-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/fg"))' Text="&lt;" />
        <div class="wh01-tbar-title">
            <span class="pda-tbar-brand">ASSY READY</span>
        </div>
        <RadzenButton class="wh01-tbar-refresh" Click="Load" Disabled="@_isLoading" Text="REFRESH" />
        @if (IsPptTestMode)
        {
            <PptScenarioPanel Title="ASSY READY" Steps="ActiveScenarioSteps" ModeLabel="@ScenarioModeLabel" Busy="@_isLoading" OnStart="StartPptStep" OnValue="RunPptValue" OnReset="ResetPptData" />
        }
    </div>

    <div class="pda-bd wh01-body">
        <section class="wh01-head">
            <div class="pda-card-h">ASSY READY</div>
            @if (!_loadError && !_isLoading)
            {
            <div class="wh01-summary">
                <RadzenCard class="wh01-stat"><span>Groups</span><strong>@_rows.Count</strong></RadzenCard>
                <RadzenCard class="wh01-stat waiting-age waiting-age-1"><span>Over 1 Day</span><strong>@OverDaysCount(1)</strong></RadzenCard>
                <RadzenCard class="wh01-stat waiting-age waiting-age-5"><span>Over 5 Days</span><strong>@OverDaysCount(5)</strong></RadzenCard>
                <RadzenCard class="wh01-stat waiting-age waiting-age-10"><span>Over 10 Days</span><strong>@OverDaysCount(10)</strong></RadzenCard>
            </div>
            }
        </section>

        @if (_loadError)
        {
            <div class="pda-status fail" role="alert">@_message</div>
        }
        else if (_rows.Count == 0)
        {
            <div class="pda-empty">@_message</div>
        }
        else
        {
            <div class="wh01-list">
                @foreach (var row in _rows)
                {
                    <RadzenCard class="wh01-release-card" @key="ReadyBarcode(row)">
                        <div class="wh01-card-top wh01-card-top-compact">
                            <div class="wh01-po-no">@ReadyBarcode(row)</div>
                            <RadzenBadge class="@($"wh01-status waiting-age {AgeClass(row)}")" Text="@AgeText(row)" title="Since warehouse registration" />
                        </div>
                        <div class="wh01-desc">@row.LotCount ASSY LOTS · LOCATION NOT SET</div>
                        @foreach(var part in row.Parts)
                        {
                            <div class="wh01-release-facts">
                                <div><span>Part No</span><strong>@part.PartNo</strong></div>
                                <div><span>Qty</span><strong>@part.Qty.ToString("#,0.###") @Uom.Symbol(part.Unit)</strong></div>
                            </div>
                            <div class="wh01-desc">@(part.PartName??"-")</div>
                        }
                    </RadzenCard>
                }
            </div>
        }
    </div>

</div>

@code {
    private List<AssyReadyPalletDto> _rows = new();
    private bool _isLoading;
    private bool _loadError;
    private string _message = "Loading...";
    private DateTime _asOf;
    private static string ReadyBarcode(AssyReadyPalletDto row) => row.PalletNo ?? row.Lots![0].LotNo;
    private bool IsOverDays(AssyReadyPalletDto row, int days) => row.ReadyAt < _asOf.AddDays(-days);
    private int OverDaysCount(int days) => _rows.Count(row => IsOverDays(row, days));
    private string AgeClass(AssyReadyPalletDto row) =>
        IsOverDays(row, 10) ? "waiting-age-10" :
        IsOverDays(row, 5) ? "waiting-age-5" :
        IsOverDays(row, 1) ? "waiting-age-1" : "";

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        if (_isLoading) return;
        _isLoading = true;
        _loadError = false;
        _message = "Loading...";
        try
        {
            var groups = await Api.AssyReadyPalletsAsync();
            if(groups.Any(row=>row.PalletNo is null && row.Lots is null))
                throw new InvalidOperationException("ASSY LOT details could not be loaded.");
            _rows = groups
                .SelectMany(row=>row.PalletNo is not null ? new[] { row } : (row.Lots??[]).Select(lot=>
                    new AssyReadyPalletDto(null,lot.ReadyAt,1,
                        [new AssyReadyPartDto(lot.PartNo,lot.PartName,lot.Qty,lot.Unit,1)],[lot])))
                .OrderBy(x => x.ReadyAt ?? DateTime.MaxValue)
                .ThenBy(x => x.PalletNo)
                .ToList();
            _asOf = await Api.DatabaseTimeAsync();
            _message = _rows.Count == 0 ? "No registered ASSY LOTs are waiting for location assignment." : "";
        }
        catch (Exception ex)
        {
            _rows.Clear();
            _loadError = true;
            _message = ex.Message;
        }
        finally { _isLoading = false; }
    }

    private string AgeText(AssyReadyPalletDto row)
    {
        if (row.ReadyAt is null) return "-";
        var days = Math.Max(0, (int)(_asOf - row.ReadyAt.Value).TotalDays);
        return days == 0 ? "Under 1 day" : $"Over {days} {(days == 1 ? "day" : "days")}";
    }
}
