@page "/fg/04"
@inject FinishedGoodsApi Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh07-shell fg04-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/fg"))' Text="&lt;" />
        <div class="wh07-tbar-title"><span class="pda-tbar-brand">OUTBOUND</span></div>
        @if (IsPptTestMode)
        {
            <PptScenarioPanel Title="OUTBOUND" Steps="PptSteps" ModeLabel="@ScenarioModeLabel" Busy="_isBusy"
                              OnStart="StartPptStep" OnValue="RunPptValue" OnReset="ResetPptData"
                              OpenChanged="@((bool open) => _pptOpen = open)" />
        }
    </div>

    <div class="pda-bd wh07-body">
        <RadzenCard class="wh07-panel wh07-slip-panel scan-only">
            <div class="pda-fld">
                <label>PALLET LOT BARCODE</label>
                <RadzenTextBox class="pda-input wh07-input pda-scan-input" Value="@_barcode"
                               @oninput="OnScanInput" @onkeydown="OnScanKey"
                               Placeholder="Scan Pallet LOT Barcode" />
            </div>
        </RadzenCard>

        @if (_pallet is not null)
        {
            <div class="fg04-section-head outgoing">
                <strong>PALLET INFORMATION</strong>
                <span>@_pallet.PartCount part LOT(s)</span>
            </div>
            <RadzenCard class="wh07-summary-card fg04-summary-card">
                <div class="fg04-order-head">
                    <div><span>PALLET LOT</span><strong>@_pallet.PalletLotNo</strong></div>
                    <RadzenBadge class="wh07-status ready" Text="READY" />
                </div>
                <div class="fg04-detail-rows">
                    <div class="fg04-detail-row"><span>LOCATION</span><strong>@Text(_pallet.LocationNo)</strong></div>
                    <div class="fg04-detail-row"><span>TOTAL QTY</span><strong>@_pallet.TotalQty.ToString("N0") EA</strong></div>
                </div>
            </RadzenCard>

            <div class="fg04-section-head parts">
                <strong>PARTS IN PALLET</strong>
                <span>@_pallet.Items.Count item(s)</span>
            </div>
            <div class="wh07-line-list fg04-outbound-list">
                @foreach (var item in _pallet.Items)
                {
                    <RadzenCard class="wh07-line-card fg04-line-card open">
                        <div class="fg04-line-head">
                            <div><span>PART NO</span><strong>@item.PartNo</strong></div>
                            <span class="fg04-outbound-qty">@item.Qty.ToString("N0") EA</span>
                        </div>
                        <div class="fg04-detail-rows">
                            <div class="fg04-detail-row"><span>PART NAME</span><strong>@Text(item.PartName)</strong></div>
                            <div class="fg04-detail-row"><span>LOT NO</span><strong>@item.LotNo</strong></div>
                            <div class="fg04-detail-row"><span>LOCATION</span><strong>@Text(item.LocationNo)</strong></div>
                        </div>
                    </RadzenCard>
                }
            </div>

            <div class="wh07-action-spacer"></div>
            <div class="wh07-release-bar">
                <RadzenButton class="wh07-clear-btn" Click="Clear" Disabled="@_isBusy" Text="CLEAR" />
                <RadzenButton class="wh07-release-btn ready" Click="CompleteOutbound" Disabled="@_isBusy" Text="OUTBOUND" />
            </div>
        }
    </div>

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@(_modalKind == "success" ? "OK" : "!")</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions"><RadzenButton class="wh-modal-btn primary" Click="CloseModal" Text="OK" /></div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    private const string SamplePalletLot = "FGPAL-DEMO-001";
    private PdaApi.FgOutboundPalletRow? _pallet;
    private string _barcode = "";
    private bool _isBusy, _modalOpen;
    private string _modalTitle = "", _modalMessage = "", _modalKind = "info";
    private DotNetObjectReference<Fg04FifoPicking>? _scannerRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
        _scannerRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = MauiProgram.IsDeveloperMode });
        await FocusAsync();
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        if (_pptOpen || _isBusy) return;
        _barcode = Normalize(scanText);
        await ScanPallet();
        await InvokeAsync(StateHasChanged);
    }

    private void OnNativeBarcodeScanned(string barcode) => _ = InvokeAsync(() => OnHardwareScanAsync(barcode));
    private void OnScanInput(ChangeEventArgs e) => _barcode = e.Value?.ToString() ?? "";
    private async Task OnScanKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ScanPallet();
    }

    private async Task ScanPallet()
    {
        var barcode = Normalize(_barcode);
        if (string.IsNullOrWhiteSpace(barcode))
        {
            ShowModal("Pallet Required", "Scan a pallet LOT barcode.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var result = await Api.FgOutboundPalletScanAsync(barcode);
            if (!result.Success || result.Pallet is null)
            {
                _pallet = null;
                _barcode = "";
                ShowModal("Pallet Scan Failed", result.Message, "danger");
                return;
            }
            _pallet = result.Pallet;
            _barcode = result.Pallet.PalletLotNo;
        }
        finally
        {
            _isBusy = false;
            await FocusAsync();
        }
    }

    private async Task CompleteOutbound()
    {
        if (_pallet is null)
        {
            ShowModal("Pallet Required", "Scan a pallet LOT barcode first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var palletLot = _pallet.PalletLotNo;
            var result = await Api.FgOutboundPalletAsync(new PdaApi.FgOutboundPalletReq(palletLot));
            if (!result.Success)
            {
                ShowModal("Outbound Failed", result.Message, "danger");
                return;
            }
            Clear();
            ShowModal("Outbound Complete", $"Pallet {palletLot} and all contained parts were processed.\n{result.Message}", "success");
        }
        finally
        {
            _isBusy = false;
            await FocusAsync();
        }
    }

    private void Clear()
    {
        _pallet = null;
        _barcode = "";
    }

    private void ShowModal(string title, string message, string kind)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalOpen = true;
    }

    private void CloseModal()
    {
        _modalOpen = false;
        _ = FocusAsync();
    }

    private async Task FocusAsync()
    {
        if (_pptOpen || _modalOpen) return;
        try { await JS.InvokeVoidAsync("pdaScan.focus", ".fg04-shell .pda-scan-input"); } catch { }
    }

    private static string Normalize(string? value) => string.IsNullOrWhiteSpace(value)
        ? ""
        : value.Replace("\u0002", "").Replace("\u0003", "").Trim();
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
