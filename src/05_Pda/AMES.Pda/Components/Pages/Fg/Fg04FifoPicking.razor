@page "/fg/04"
@inject FinishedGoodsApi Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh02-shell fg04-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/fg"))' Text="&lt;" />
        <span class="pda-tbar-brand">OUTBOUND</span>
        @if (IsPptTestMode)
        {
            <PptScenarioPanel Title="OUTBOUND" Steps="PptSteps" ModeLabel="@ScenarioModeLabel" Busy="_isBusy"
                              OnStart="StartPptStep" OnValue="RunPptValue" OnReset="ResetPptData"
                              OpenChanged="@((bool open) => _pptOpen = open)" />
        }
    </div>

    <div class="pda-bd wh02-body fg04-body">
        <RadzenCard class="wh02-panel hardware-scan-panel">
            <div class="pda-fld">
                <label>BARCODE SCAN</label>
                <RadzenTextBox class="pda-input wh02-barcode-input pda-scan-input" Value="@_barcode" Disabled="@_isBusy"
                               @oninput="OnScanInput" @onkeydown="OnScanKey"
                               Placeholder="Scan Barcode" />
            </div>
        </RadzenCard>

        @if (_unit is not null)
        {
            <section class="fg04-unit">
                <div class="fg04-unit-head">
                    <div><span>@_unit.UnitType</span><strong>@_unit.OutboundBarcode</strong></div>
                    <span class="fg04-ready">READY</span>
                </div>
                <div class="fg04-totals">
                    <div><span>LOCATION</span><strong>@Text(_unit.LocationNo)</strong></div>
                    <div><span>LOTS</span><strong>@_unit.ItemCount</strong></div>
                    <div><span>TOTAL QTY</span><strong>@_unit.TotalQty.ToString("N0") EA</strong></div>
                </div>
                <div class="fg04-customer">
                    <label>CUSTOMER</label>
                    @if (_unit.CustomerId is not null)
                    {
                        <strong>@_unit.CustomerId · @_unit.CustomerName</strong>
                    }
                    else
                    {
                        <select @bind="_customerId" disabled="@_isBusy" aria-label="Outbound customer">
                            <option value="">Select Customer</option>
                            @foreach (var customer in _customers)
                            {
                                <option value="@customer.CustomerId">@customer.CustomerId · @customer.CustomerName</option>
                            }
                        </select>
                        @if (_customerError is not null)
                        {
                            <small>@_customerError</small>
                            <button @onclick="LoadCustomers" disabled="@_isBusy">Reload Customers</button>
                        }
                    }
                </div>
            </section>

            <section class="fg04-items">
                <header>OUTBOUND ITEMS <span>@_unit.Items.Count</span></header>
                @foreach (var item in _unit.Items)
                {
                    <article class="fg04-item">
                        <div class="fg04-item-head">
                            <strong>@item.PartNo</strong>
                            <strong class="fg04-qty">@item.Qty.ToString("N0") EA</strong>
                        </div>
                        <div class="fg04-part-name">@Text(item.PartName)</div>
                        <dl>
                            <dt>LOT NO</dt><dd>@item.LotNo</dd>
                            <dt>LOCATION</dt><dd>@Text(item.LocationNo)</dd>
                        </dl>
                    </article>
                }
            </section>
        }
        <div class="wh02-action-bar has-reset">
            <RadzenButton class="wh02-clear-btn" Click="Clear" Disabled="@_isBusy" Text="CLEAR" />
            <RadzenButton class="pda-btn-pri wh02-receive-btn wh02-receive-action-btn ready" Click="CompleteOutbound" Disabled="@(_isBusy || _unit is null)" Text="OUTBOUND" />
        </div>
    </div>

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@(_modalKind == "success" ? "OK" : "!")</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                <div class="wh-modal-actions"><RadzenButton class="wh-modal-btn primary" Click="CloseModal" Text="OK" /></div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    private const string SamplePalletLot = "FGPAL-DEMO-001";
    private const string SamplePartLot = "FGPART-DEMO-001";
    private PdaApi.FgOutboundUnitRow? _unit;
    private string _barcode = "";
    private string? _customerId, _customerError;
    private List<PdaApi.FgOutboundCustomerRow> _customers = [];
    private bool _isBusy, _modalOpen;
    private string _modalTitle = "", _modalMessage = "", _modalKind = "info";
    private DotNetObjectReference<Fg04FifoPicking>? _scannerRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
        _scannerRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = MauiProgram.IsDeveloperMode });
        await FocusAsync();
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        try { _customers = await Api.FgOutboundCustomersAsync(); _customerError = null; }
        catch (Exception ex) { _customerError = ex.Message; }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        if (_pptOpen || _isBusy || _modalOpen) return;
        _barcode = Normalize(scanText);
        await ScanOutboundUnit();
        await InvokeAsync(StateHasChanged);
    }

    private void OnNativeBarcodeScanned(string barcode) => _ = InvokeAsync(() => OnHardwareScanAsync(barcode));
    private void OnScanInput(ChangeEventArgs e) => _barcode = e.Value?.ToString() ?? "";
    private async Task OnScanKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ScanOutboundUnit();
    }

    private async Task ScanOutboundUnit()
    {
        if (_isBusy || _modalOpen) return;
        var barcode = Normalize(_barcode);
        if (string.IsNullOrWhiteSpace(barcode))
        {
            ShowModal("Barcode Required", "Scan Barcode first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var result = await Api.FgOutboundScanAsync(barcode);
            if (!result.Success || result.Unit is null)
            {
                _unit = null;
                _barcode = "";
                ShowModal("Outbound Scan Failed", result.Message, "danger");
                return;
            }
            _unit = result.Unit;
            _customerId = result.Unit.CustomerId;
            _barcode = result.Unit.OutboundBarcode;
        }
        finally
        {
            _isBusy = false;
            await FocusAsync();
        }
    }

    private async Task CompleteOutbound()
    {
        if (_isBusy || _modalOpen) return;
        if (_unit is null)
        {
            ShowModal("Barcode Required", "Scan an outbound barcode first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var barcode = _unit.OutboundBarcode;
            var unitType = _unit.UnitType;
            if (string.IsNullOrWhiteSpace(_customerId))
            {
                ShowModal("Customer Required", "Select the outbound customer before confirming shipment.", "warn");
                return;
            }
            var result = await Api.FgOutboundAsync(new PdaApi.FgOutboundUnitReq(barcode, _customerId));
            if (!result.Success)
            {
                ShowModal("Outbound Failed", result.Message, "danger");
                return;
            }
            Clear();
            ShowModal("Outbound Complete", $"{unitType} {barcode} was processed.\n{result.Message}", "success");
        }
        finally
        {
            _isBusy = false;
            await FocusAsync();
        }
    }

    private void Clear()
    {
        _unit = null;
        _barcode = "";
        _customerId = null;
    }

    private void ShowModal(string title, string message, string kind)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalOpen = true;
    }

    private void CloseModal()
    {
        _modalOpen = false;
        _ = FocusAsync();
    }

    private async Task FocusAsync()
    {
        if (_pptOpen || _modalOpen) return;
        try { await JS.InvokeVoidAsync("pdaScan.focus", ".fg04-shell .pda-scan-input"); } catch { }
    }

    private static string Normalize(string? value) => string.IsNullOrWhiteSpace(value)
        ? ""
        : value.Replace("\u0002", "").Replace("\u0003", "").Trim();
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
