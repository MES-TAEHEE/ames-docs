@page "/fg/04"
@using AMES.Contracts.Dto
@inject FinishedGoodsApi Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh02-shell fg04-shell loading-shell">
    <div class="pda-tbar">
        <RadzenButton class="pda-tbar-back" Click='@(() => Nav.NavigateTo("/fg"))' Text="&lt;" />
        <span class="pda-tbar-brand">OUTBOUND</span>
        @if (IsPptTestMode)
        {
            <PptScenarioPanel Title="OUTBOUND" Steps="PptSteps" ModeLabel="@ScenarioModeLabel" Busy="_isBusy"
                              OnStart="StartPptStep" OnValue="RunPptValue" OnReset="ResetPptData"
                              OpenChanged="@((bool open) => _pptOpen = open)" />
        }
    </div>

    <div class="pda-bd wh02-body fg04-body">
        <RadzenCard class="wh02-panel hardware-scan-panel">
            <div class="pda-fld">
                <label>BARCODE SCAN</label>
                <RadzenTextBox class="pda-input wh02-barcode-input pda-scan-input pda-barcode-input" Value="@_barcode" Disabled="@_isBusy"
                               @oninput="OnScanInput" @onkeydown="OnScanKey"
                               Placeholder="Scan Barcode" />
            </div>
        </RadzenCard>

        @if(_delivery is null)
        {
            <RadzenCard class="wh02-panel shipment-orders-panel">
                <div class="shipment-orders-head"><strong>DCR LIST · @_deliveries.Count</strong><RadzenButton Icon="refresh" Text="REFRESH" Click="ReloadDeliveries" Disabled="@(_isBusy||_loadingDeliveries)" Size="ButtonSize.Small" class="wh02-clear-btn" /></div>
                @if(_deliveriesError.Length>0){<div class="shipment-orders-empty error" role="alert">@_deliveriesError</div>}
                else if(!_loadingDeliveries&&_deliveries.Count==0){<div class="shipment-orders-empty">No open DCRs.</div>}
                @foreach(var dcr in _deliveries)
                {
                    <RadzenButton @key="dcr.DeliveryId" Click="@(()=>SelectDelivery(dcr))" Disabled="_isBusy" class="shipment-order-row"><ChildContent>
                        <span class="shipment-order-main"><strong>@dcr.DeliveryNo</strong><span>@dcr.Status</span></span>
                        <span class="shipment-order-meta">@dcr.CustomerId · @dcr.ShipDate.ToString("MM/dd/yyyy")</span>
                        <span class="shipment-order-parts">@dcr.OrderCount order(s) · @dcr.PartCount part(s)</span>
                    </ChildContent></RadzenButton>
                }
            </RadzenCard>
        }
        @if(_delivery is {} delivery)
        {
            <section class="load-summary"><strong>@delivery.DeliveryNo</strong><div>@delivery.CustomerId · @delivery.ShipDate.ToString("MM/dd/yyyy")</div><div>AWAITING TRAILER LOADING</div></section>
            <section class="load-parts"><header>PREPARED / REQUIRED</header>
                @foreach(var part in delivery.Parts)
                {
                    <article class="@(part.PreparedQty>=part.RequiredQty?"complete":"")">
                        <div><strong>@part.PartNo</strong><strong class="@(part.PreparedQty>0?"fg04-staged-qty":null)">@part.PreparedQty.ToString("N0") / @part.RequiredQty.ToString("N0")</strong></div>
                        <small>@part.PartName</small>
                        @if(part.StagingQty>0){<p class="fg04-at-shipping-area">✓ AT SHIPPING AREA · @part.StagingQty.ToString("N0") EA</p>}
                        @if(part.LoadedQty>0){<small>LOADED · @part.LoadedQty.ToString("N0") EA</small>}
                        @if(part.StockShortageQty>0){<p class="fg04-shortage" role="status">SHORTAGE · @part.StockShortageQty.ToString("N0") EA</p>}
                        @if(delivery.Recommendations?.Any(r=>r.PartNo==part.PartNo)==true)
                        {
                            <div class="fg04-recommendations"><small>PICK LOCATIONS · OLDEST FIRST</small>
                                @foreach(var stock in delivery.Recommendations.Where(r=>r.PartNo==part.PartNo))
                                {
                                    <div class="fg04-stock-recommendation">
                                        <div><strong>@stock.LocationNo</strong><b>@stock.Qty.ToString("N0") EA</b></div>
                                        @if(!string.IsNullOrWhiteSpace(stock.LocationName)){<small>@stock.LocationName</small>}
                                        <span>@stock.Barcode</span><small>Received · @(stock.ReceivedAt?.ToString("MM/dd/yyyy")??"—")</small>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }

        @if (_unit is not null)
        {
            <section class="fg04-unit">
                <div class="fg04-unit-head">
                    <div><span>@_unit.UnitType</span><strong>@_unit.OutboundBarcode</strong></div>
                    <span class="fg04-ready">@UnitStage</span>
                </div>
                <div class="fg04-totals">
                    <div><span>LOCATION</span><strong>@Text(_unit.LocationNo)</strong></div>
                    <div><span>LOTS</span><strong>@_unit.ItemCount</strong></div>
                    <div><span>TOTAL QTY</span><strong>@_unit.TotalQty.ToString("N0") EA</strong></div>
                </div>
                <div class="fg04-customer">
                    <label>CUSTOMER</label>
                    <strong>@_delivery?.CustomerId</strong>
                </div>
            </section>

            @if (_fifoWarnings.Count > 0)
            {
                <RadzenCard class="wh02-panel"><strong>FIFO WARNING</strong><FifoWarningList Items="_fifoWarnings" /></RadzenCard>
            }
            <section class="fg04-items">
                <header>OUTBOUND ITEMS <span>@_unit.Items.Count</span></header>
                @foreach (var item in _unit.Items)
                {
                    <article class="fg04-item">
                        <div class="fg04-item-head">
                            <strong>@item.PartNo</strong>
                            <strong class="fg04-qty">@item.Qty.ToString("N0") EA</strong>
                        </div>
                        <div class="fg04-part-name">@Text(item.PartName)</div>
                        <dl>
                            <dt>LOT NO</dt><dd>@item.LotNo</dd>
                            <dt>LOCATION</dt><dd>@Text(item.LocationNo)</dd>
                        </dl>
                    </article>
                }
            </section>
        }
        <div class="wh02-action-bar has-reset">
            <RadzenButton class="wh02-clear-btn" Click="Clear" Disabled="@_isBusy" Text="CLEAR" />
            <RadzenButton class="pda-btn-pri wh02-receive-btn wh02-receive-action-btn ready" Click="CompleteOutbound" Disabled="@(_isBusy || _unit is null || _delivery is null || UnitStage!="READY")" Text="OUTBOUND" />
        </div>
    </div>

    @if (_modalOpen)
    {
        <div class="wh-modal-backdrop" @onclick="CloseModal">
            <RadzenCard class="@($"wh-modal-card {_modalKind}")" @onclick:stopPropagation="true">
                <div class="wh-modal-mark">@(_modalKind == "success" ? "OK" : "!")</div>
                <div class="wh-modal-title">@_modalTitle</div>
                <div class="wh-modal-message">@_modalMessage</div>
                @if (_confirmFifo){<FifoWarningList Items="_fifoWarnings" />}
                <div class="wh-modal-actions">
                    @if (_confirmFifo){<RadzenButton class="wh-modal-btn primary" Click="ConfirmNonFifo" Text="CONTINUE" />}
                    <RadzenButton class="wh-modal-btn primary" Click="CloseModal" Text="@(_confirmFifo ? "CANCEL" : "OK")" />
                </div>
            </RadzenCard>
        </div>
    }
</div>

@code {
    private const string SamplePalletLot = "FGPAL-DEMO-001";
    private const string SamplePartLot = "FGPART-DEMO-001";
    private PdaApi.FgOutboundUnitRow? _unit;
    private string _barcode = "";
    private ShippingDeliveryDto? _delivery;
    private List<ShippingDeliveryListDto> _deliveries=[];
    private bool _loadingDeliveries;
    private string _deliveriesError="";
    private string UnitStage=>_unit is not null && _unit.Items.All(item=>_delivery?.Loads.Any(p=>p.LotNo==item.LotNo)==true) ? "LOADED"
        : _unit is not null && _unit.Items.All(item=>_delivery?.Preparations?.Any(p=>p.LotNo==item.LotNo)==true) ? "PREPARED" : "READY";
    protected override Task OnInitializedAsync()=>ReloadDeliveries();
    private async Task ReloadDeliveries()
    {
        if(_isBusy||_loadingDeliveries)return;
        _loadingDeliveries=true;_deliveriesError="";
        try{_deliveries=await Api.OpenShippingDeliveriesAsync();}
        catch(Exception ex){_deliveries=[];_deliveriesError=ex.Message;}
        finally{_loadingDeliveries=false;}
    }
    private async Task SelectDelivery(ShippingDeliveryListDto delivery)
    {
        if(_isBusy||_modalOpen)return;
        _barcode=delivery.DeliveryNo;await ScanOutboundUnit();
    }
    private bool _isBusy, _modalOpen;
    private bool _confirmFifo;
    private List<AMES.Contracts.Dto.FifoWarningDto> _fifoWarnings = [];
    private string _modalTitle = "", _modalMessage = "", _modalKind = "info";
    private DotNetObjectReference<Fg04FifoPicking>? _scannerRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        PdaBarcodeHub.Scanned += OnNativeBarcodeScanned;
        _scannerRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pdaScan.register", _scannerRef, new { minLength = 3, developerMode = MauiProgram.IsDeveloperMode });
        await FocusAsync();

    }

    [JSInvokable]
    public async Task OnHardwareScanAsync(string scanText)
    {
        if (_pptOpen || _isBusy || _modalOpen) return;
        _barcode = Normalize(scanText);
        await ScanOutboundUnit();
        await InvokeAsync(StateHasChanged);
    }

    private void OnNativeBarcodeScanned(string barcode) => _ = InvokeAsync(() => OnHardwareScanAsync(barcode));
    private void OnScanInput(ChangeEventArgs e) => _barcode = e.Value?.ToString() ?? "";
    private async Task OnScanKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ScanOutboundUnit();
    }

    private async Task ScanOutboundUnit()
    {
        if (_isBusy || _modalOpen) return;
        var barcode = Normalize(_barcode);
        if (string.IsNullOrWhiteSpace(barcode))
        {
            ShowModal("Barcode Required", "Scan Barcode first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            if(barcode.StartsWith("DCR-",StringComparison.OrdinalIgnoreCase))
            {
                var document=await Api.ShippingDeliveryAsync(barcode);
                if(!document.Success || document.Delivery is null)
                {ShowModal("DCR Unavailable",document.Message,"warn");return;}
                if(document.Delivery.Status is not ("Open" or "Loading"))
                {ShowModal("DCR Closed","This DCR cannot accept outbound preparation.","warn");return;}
                if(!document.Delivery.SupportsPreparation){ShowModal("Outbound Unavailable","Shipment preparation is unavailable. Please contact an administrator.","warn");return;}
                _delivery=document.Delivery;_unit=null;_barcode="";return;
            }
            if(_delivery is null){ShowModal("DCR Required","Scan or select a DCR first.","warn");return;}
            var result = await Api.FgOutboundScanAsync(barcode);
            if (!result.Success || result.Unit is null)
            {
                _unit = null;
                _barcode = "";
                ShowModal("Outbound Scan Failed", result.Message, "danger");
                return;
            }
            _unit = result.Unit;
            _fifoWarnings = result.FifoWarnings ?? [];

            _barcode = result.Unit.OutboundBarcode;
        }
        catch(Exception ex){ShowModal("Outbound Scan Failed",ex.Message,"danger");}
        finally
        {
            _isBusy = false;
            await FocusAsync();
        }
    }

    private Task CompleteOutbound() => SubmitOutbound(false);
    private async Task ConfirmNonFifo()
    {
        CloseModal();
        await SubmitOutbound(true);
    }

    private async Task SubmitOutbound(bool allowNonFifo)
    {
        if (_isBusy || _modalOpen) return;
        if (_unit is null)
        {
            ShowModal("Barcode Required", "Scan an outbound barcode first.", "warn");
            return;
        }

        _isBusy = true;
        try
        {
            var barcode = _unit.OutboundBarcode;
            var unitType = _unit.UnitType;
            if(_delivery is null){ShowModal("DCR Required","Scan or select a DCR first.","warn");return;}
            var result = await Api.FgOutboundAsync(new PdaApi.FgOutboundUnitReq(barcode, _delivery.CustomerId, allowNonFifo, _delivery.DeliveryNo));
            if (result.FifoWarnings is { Count: > 0 } warnings)
            {
                _fifoWarnings = warnings;
                _confirmFifo = true;
                ShowModal("FIFO Warning", "Continue with the currently scanned stock instead?", "warn");
                return;
            }
            if (!result.Success)
            {
                ShowModal("Outbound Failed", result.Message, "danger");
                return;
            }
            _delivery=result.Delivery ?? _delivery;
            ClearUnit();
            ShowModal("Outbound Complete", $"{unitType} {barcode}\nAwaiting trailer loading.", "success");
        }
        finally
        {
            _isBusy = false;
            await FocusAsync();
        }
    }

    private void Clear(){ClearUnit();_delivery=null;_=ReloadDeliveries();}
    private void ClearUnit()
    {
        _unit = null;
        _barcode = "";
        _fifoWarnings = [];
        _confirmFifo = false;
    }

    private void ShowModal(string title, string message, string kind)
    {
        _modalTitle = title;
        _modalMessage = message;
        _modalKind = kind;
        _modalOpen = true;
    }

    private void CloseModal()
    {
        _modalOpen = false;
        _confirmFifo = false;
        _ = FocusAsync();
    }

    private async Task FocusAsync()
    {
        if (_pptOpen || _modalOpen) return;
        try { await JS.InvokeVoidAsync("pdaScan.focus", ".fg04-shell .pda-scan-input"); } catch { }
    }

    private static string Normalize(string? value) => string.IsNullOrWhiteSpace(value)
        ? ""
        : value.Replace("\u0002", "").Replace("\u0003", "").Trim();
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    public async ValueTask DisposeAsync()
    {
        PdaBarcodeHub.Scanned -= OnNativeBarcodeScanned;
        try { await JS.InvokeVoidAsync("pdaScan.unregister"); } catch { }
        _scannerRef?.Dispose();
    }
}
