@page "/fg/05"
@using AMES.Contracts.Dto
@inject FinishedGoodsApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pda-shell wh wh02-shell loading-shell">
    <div class="pda-tbar"><button class="pda-tbar-back" @onclick='@(()=>Nav.NavigateTo("/fg"))'>&lt;</button><span class="pda-tbar-brand">TRAILER LOADING</span></div>
    <div class="pda-bd wh02-body">
        <RadzenCard class="wh02-panel hardware-scan-panel"><div class="pda-fld">
            <label>@(_delivery is null?"DCR BARCODE":_removing?"REMOVE PALLET BARCODE":"PALLET BARCODE")</label>
            <RadzenTextBox Value="@_barcode" @oninput="@(e=>_barcode=e.Value?.ToString()??"")" @onkeydown="OnKey" Disabled="_busy" Placeholder="Scan Barcode" class="pda-input pda-scan-input" />
            @if(_delivery is {Status:"Open" or "Loading",Loads.Count:>0})
            {
                <RadzenButton Text="@(_removing?"CANCEL REMOVE":"REMOVE PALLET")" Click="ToggleRemove" Disabled="_busy" Size="ButtonSize.Small" class="wh02-clear-btn" />
            }
        </div></RadzenCard>
        @if(_delivery is null)
        {
            <RadzenCard class="wh02-panel shipment-orders-panel">
                <div class="shipment-orders-head">
                    <strong>DCR LIST · @_deliveries.Count</strong>
                    <RadzenButton Icon="refresh" Text="REFRESH" Click="ReloadDeliveries" Disabled="@(_busy||_loadingDeliveries)" Size="ButtonSize.Small" class="wh02-clear-btn" />
                </div>
                @if(_deliveriesError.Length>0)
                {
                    <div class="shipment-orders-empty error" role="alert">@_deliveriesError</div>
                }
                else if(!_loadingDeliveries && _deliveries.Count==0)
                {
                    <div class="shipment-orders-empty">No open DCRs. Create a DCR on the web before loading.</div>
                }
                @foreach(var dcr in _deliveries)
                {
                    <RadzenButton @key="dcr.DeliveryId" Click="@(()=>SelectDelivery(dcr))" Disabled="@(_busy||!CanOpenDelivery(dcr))" class="shipment-order-row">
                        <ChildContent>
                            <span class="shipment-order-main"><strong>@dcr.DeliveryNo</strong><span>@dcr.Status</span></span>
                            <span class="shipment-order-meta">@dcr.CustomerId · @dcr.ShipDate.ToString("MM/dd/yyyy")</span>
                            <span class="shipment-order-parts">@dcr.OrderCount order(s) · @dcr.PartCount part(s)</span>
                            @if(!string.IsNullOrWhiteSpace(dcr.TrailerNo)){<span class="shipment-order-dcr">TRAILER: @dcr.TrailerNo</span>}
                        </ChildContent>
                    </RadzenButton>
                }
            </RadzenCard>
        }
        @if(_delivery is {} delivery)
        {
            <section class="load-summary"><strong>@delivery.DeliveryNo</strong><div>@delivery.CustomerId · @delivery.ShipDate.ToString("MM/dd/yyyy")</div><div>TRAILER: @(delivery.TrailerNo??"—") · @delivery.Status</div>
                <div>LOADED PALLETS: @delivery.Loads.Select(x=>x.RootLotNo).Distinct().Count()</div>
                @foreach(var order in delivery.OrderNos){<div class="load-order">@order</div>}
            </section>
            <section class="load-parts">
                <header>LOADED / REQUIRED</header>
                @foreach(var part in delivery.Parts)
                {
                    <article class="@(part.LoadedQty==part.RequiredQty?"complete":"")"><div><strong>@part.PartNo</strong><strong>@part.LoadedQty.ToString("N0") / @part.RequiredQty.ToString("N0")</strong></div><small>@part.PartName</small></article>
                }
            </section>
        }
        @if(_scanMessage.Length>0){<div class="pda-status ok">@_scanMessage</div>}
        <div class="wh02-action-bar has-reset">
            <RadzenButton Text="CLEAR" Click="Clear" Disabled="_busy" class="wh02-clear-btn" />
            <RadzenButton Text="CONFIRM SHIPMENT" Click="AskComplete" Disabled="@(_busy||!Ready)" class="pda-btn-pri wh02-receive-btn" />
        </div>
    </div>
    @if(_modal)
    {
        <div class="wh-modal-backdrop"><RadzenCard class="wh-modal-card info"><div class="wh-modal-mark">!</div><div class="wh-modal-title">@_title</div><div class="wh-modal-message">@_message</div>
            <div class="wh-modal-actions">@if(_confirm){<RadzenButton Text="CONFIRM" Click="Complete" Disabled="_busy" class="wh-modal-btn primary" />}<RadzenButton Text="@(_confirm?"CANCEL":"OK")" Click="CloseModal" Disabled="_busy" class="wh-modal-btn primary" /></div>
        </RadzenCard></div>
    }
</div>
@code {
    ShippingDeliveryDto? _delivery;string _barcode="",_title="",_message="";bool _busy,_modal,_confirm;
    List<ShippingDeliveryListDto> _deliveries=[];
    string _deliveriesError="";
    bool _loadingDeliveries;
    bool _removing;
    string _scanMessage="";
    DotNetObjectReference<Fg05TrailerLoading>? _scanner;
    bool Ready=>!_removing&&_delivery is {Status:"Open" or "Loading"} d&&d.Parts.Count>0&&d.Parts.All(x=>x.RequiredQty==x.LoadedQty);
    protected override Task OnInitializedAsync()=>ReloadDeliveries();
    static bool CanOpenDelivery(ShippingDeliveryListDto delivery)=>!string.IsNullOrWhiteSpace(delivery.DeliveryNo)&&delivery.Status is "Open" or "Loading";
    async Task ReloadDeliveries()
    {
        if(_busy||_loadingDeliveries)return;
        _loadingDeliveries=true;_deliveriesError="";
        try{_deliveries=await Api.OpenShippingDeliveriesAsync();}
        catch(Exception ex){_deliveries=[];_deliveriesError=ex.Message;}
        finally{_loadingDeliveries=false;}
    }
    async Task SelectDelivery(ShippingDeliveryListDto delivery)
    {
        if(_busy||_modal||_delivery is not null||!CanOpenDelivery(delivery))return;
        _barcode=delivery.DeliveryNo;await Scan();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)return;PdaBarcodeHub.Scanned+=NativeScan;_scanner=DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pdaScan.register",_scanner,new {minLength=3,developerMode=MauiProgram.IsDeveloperMode});await Focus();
    }
    void NativeScan(string barcode)=>_=InvokeAsync(()=>OnHardwareScanAsync(barcode));
    [JSInvokable]public async Task OnHardwareScanAsync(string barcode){if(_busy||_modal)return;_barcode=barcode.Trim();await Scan();await InvokeAsync(StateHasChanged);}
    async Task OnKey(KeyboardEventArgs e){if(e.Key=="Enter")await Scan();}
    async Task Scan()
    {
        if(_busy||_modal||string.IsNullOrWhiteSpace(_barcode))return;_busy=true;
        try
        {
            var value=_barcode.Replace("\u0002","").Replace("\u0003","").Trim();
            _scanMessage="";
            if(_delivery is null&&!value.StartsWith("DCR-",StringComparison.OrdinalIgnoreCase))
            {
                Show("DCR Required","Scan or select a DCR first, then scan the pallet barcode.");return;
            }
            var opening=_delivery is null;
            if(!opening&&_delivery!.Status is not ("Open" or "Loading"))
            {
                Show("DCR Closed","This DCR cannot be changed. Select an open DCR.");return;
            }
            if(!opening)
            {
                var loaded=_delivery!.Loads.Any(x=>string.Equals(x.RootLotNo,value,StringComparison.OrdinalIgnoreCase));
                if(_removing&&!loaded){Show("Pallet Not Loaded","This pallet is not loaded on the selected DCR.");return;}
                if(!_removing&&loaded){Show("Already Loaded","This pallet is already loaded. No quantity was added.");return;}
            }
            var result=opening?await Api.ShippingDeliveryAsync(value):_removing
                ?await Api.UnloadShippingDeliveryAsync(_delivery!.DeliveryNo,value)
                :await Api.LoadShippingDeliveryAsync(_delivery!.DeliveryNo,value);
            if(!result.Success||result.Delivery is null)Show("Loading Failed",result.Message);
            else
            {
                _scanMessage=opening?"DCR opened. Scan a pallet barcode.":_removing?$"Removed pallet: {value}":$"Loaded pallet: {value}";
                _delivery=result.Delivery;_barcode="";_removing=false;
            }
        }
        catch(Exception ex){Show("Loading Failed",ex.Message);}finally{_busy=false;await Focus();}
    }
    void ResetDelivery(){_delivery=null;_barcode="";_removing=false;_scanMessage="";_confirm=false;}
    async Task Clear(){ResetDelivery();await ReloadDeliveries();await Focus();}
    async Task ToggleRemove()
    {
        if(_busy||_delivery is null)return;
        _removing=!_removing;_barcode="";
        _scanMessage=_removing?"Scan a loaded pallet to remove it from this DCR.":"Scan a pallet barcode.";
        await Focus();
    }
    void AskComplete(){if(!Ready)return;_confirm=true;Show("Confirm Shipment","Ship all loaded pallets? Inventory will be deducted and the customer SO shipped quantity will be updated.");}
    async Task Complete()
    {
        if(_busy||!Ready||_delivery is null)return;_busy=true;
        var completed=false;
        var deliveryNo=_delivery.DeliveryNo;
        try
        {
            var result=await Api.CompleteShippingDeliveryAsync(deliveryNo);_confirm=false;
            if(result.Success)
            {
                ResetDelivery();
                _deliveries.RemoveAll(d=>d.DeliveryNo==deliveryNo);
                completed=true;
                Show("Shipment Complete",deliveryNo);
            }
            else Show("Shipment Failed",result.Message);
        }
        catch(Exception ex){_confirm=false;Show("Shipment Failed",ex.Message);}finally{_busy=false;}
        if(completed)await ReloadDeliveries();
    }
    void Show(string title,string message){_title=title;_message=message;_modal=true;}
    void CloseModal(){_modal=false;_confirm=false;_=Focus();}
    async Task Focus(){if(!_modal)try{await JS.InvokeVoidAsync("pdaScan.focus",".loading-shell .pda-scan-input");}catch{}}
    public async ValueTask DisposeAsync(){PdaBarcodeHub.Scanned-=NativeScan;try{await JS.InvokeVoidAsync("pdaScan.unregister");}catch{} _scanner?.Dispose();}
}
