<div class="pda-stock-filter" role="group" aria-label="Stock type">
    @if (IncludeAll)
    {
        <RadzenButton Text="ALL" Click='@(() => ValueChanged.InvokeAsync("ALL"))' Disabled="Disabled" class="@(Value == "ALL" ? "on" : "")" />
    }
    <RadzenButton Text="NON-FG" Click='@(() => ValueChanged.InvokeAsync("GENERAL"))' Disabled="Disabled" class="@(Value == "GENERAL" ? "on" : "")" />
    <RadzenButton Text="FG (ASSY)" Click='@(() => ValueChanged.InvokeAsync("FG"))' Disabled="Disabled" class="@(Value == "FG" ? "on" : "")" />
</div>
@code {
    [Parameter] public string Value { get; set; } = "ALL";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool IncludeAll { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
}
