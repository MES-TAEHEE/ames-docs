<div class="pda-date-filter-head">
    <div class="pda-card-h">@Title</div>
    <button class="rz-button wh08-filter-toggle @(ActiveCount > 0 ? "on" : "")" type="button" @ref="toggle"
            @onclick="() => SetOpen(true)" aria-label="Filters" aria-haspopup="dialog" aria-expanded="@Open">
        <RadzenIcon Icon="filter_alt" />
        @if (ActiveCount > 0) { <span class="pda-filter-count">@ActiveCount</span> }
    </button>
</div>
@if (Open)
{
    <div class="wh08-filter-backdrop" @onclick="() => SetOpen(false)">
        <section class="wh08-filter-sheet" role="dialog" aria-modal="true" aria-label="Filters" tabindex="-1"
                 @ref="panel" @onclick:stopPropagation="true" @onkeydown="OnKey">
            <div class="wh08-sheet-head">
                <strong>FILTERS</strong>
                <button class="wh08-sheet-close" type="button" @onclick="() => SetOpen(false)" aria-label="Close filters"><RadzenIcon Icon="close" /></button>
            </div>
            @ChildContent
            <RadzenButton class="wh08-date-apply" Click="() => SetOpen(false)" Text="DONE" />
        </section>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int ActiveCount { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ElementReference toggle, panel;
    private bool focusPanel, focusToggle;
    private async Task SetOpen(bool value)
    {
        focusPanel = value; focusToggle = !value;
        await OpenChanged.InvokeAsync(value);
    }
    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await SetOpen(false);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPanel && Open) { focusPanel = false; await panel.FocusAsync(); }
        else if (focusToggle && !Open) { focusToggle = false; await toggle.FocusAsync(); }
    }
}
