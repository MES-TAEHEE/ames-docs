<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AMES.InjAgent</RootNamespace>
    <!-- 아이콘 파일이 없어도 빌드되도록 있을 때만 적용 -->
    <ApplicationIcon Condition="Exists('Resources\injagent-icon.ico')">Resources\injagent-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\01_Shared\AMES.Contracts\AMES.Contracts.csproj" />
    <ProjectReference Include="..\..\02_Data\AMES.Data\AMES.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
