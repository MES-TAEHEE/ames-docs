@page "/map"
@inject TabletInventoryApi Inventory
@inject TabletAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="inventory-screen">
    <header class="inventory-header">
        <div>
            <span class="eyebrow">@Warehouse / @Area · FORKLIFT TABLET</span>
            <h1>@_areaName · @FloorLabel(_selectedFloor) Inventory Map</h1>
        </div>
    </header>

    @if (_loading)
    {
        <div class="screen-state"><span class="state-spinner"></span><strong>Loading inventory...</strong></div>
    }
    else
    {
        <div class="inventory-workspace">
            <section class="rack-pane" aria-label="Warehouse rack locations">
                @if (_selectingFloor)
                {
                    <div class="floor-selector-pane floor-panel-enter" aria-label="Select warehouse floor">
                        <div class="floor-card-list">
                            @foreach (var floor in Floors)
                            {
                                <button type="button"
                                        class="floor-card @(floor == _selectedFloor ? "selected" : "")"
                                        @onclick="@(() => SelectFloor(floor))">
                                    <strong class="floor-number">@FloorLabel(floor)</strong>
                                    <span class="floor-card-stock">@StockedLocationCount(floor)<small>STOCKED</small></span>
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="map-pane-content map-panel-enter">
                        <div class="pane-heading">
                            <div class="map-heading-actions">
                                <button type="button" class="floor-switch-button" @onclick="ShowAreas">AREAS</button>
                                <button type="button" class="floor-switch-button" @onclick="ShowFloorSelector" disabled="@(_openStorage || Floors.Count <= 1)">CHANGE FLOOR</button>
                                <RadzenButton Icon="refresh" Click="Load" Size="ButtonSize.Small" class="reset-button" title="Refresh inventory" />
                                <div class="zoom-controls" aria-label="Map zoom controls">
                                    <button type="button" @onclick="ZoomOut" disabled="@(_zoomLevel == 0)" aria-label="Zoom out">−</button>
                                    <span>@VisibleColumnCount × @VisibleRowCount</span>
                                    <button type="button" @onclick="ZoomIn" disabled="@(_zoomLevel == MaxZoomLevel || VisibleColumnCount == 1 && VisibleRowCount == 1)" aria-label="Zoom in">+</button>
                                </div>
                            </div>
                            <div class="rack-legend">
                                <span><i class="empty"></i>Empty</span>
                                <span><i class="stocked"></i>Stocked</span>
                                <span><i class="matched"></i>Search result</span>
                            </div>
                        </div>

                        <div class="rack-scroll">
                            @if (_rackSlots.Count > 0)
                            {
                            <div class="floor-map" style="@MapStyle" role="grid" aria-label="@($"{FloorLabel(_selectedFloor)} inventory locations")">
                                <div class="map-columns" aria-hidden="true">
                                    <span class="map-corner">@FloorLabel(_selectedFloor)</span>
                                    @foreach (var column in MapColumns)
                                    {
                                        <span>@column</span>
                                    }
                                </div>
                                @foreach (var row in MapRows)
                                {
                                    <div class="map-row" role="row">
                                        <strong class="map-row-label">@row.Code</strong>
                                        @foreach (var column in MapColumns)
                                        {
                                            var slot = row.Slots.FirstOrDefault(x => Same(x.Column, column));
                                            if (slot is null) { <span class="rack-slot missing" aria-hidden="true"></span> }
                                            else
                                            {
                                                <button id="@RackElementId(slot.LocationNo)" type="button"
                                                        class="@RackClass(slot)" title="@slot.LocationNo"
                                                        @onclick="@(() => SelectLocation(slot.LocationNo))"
                                                        aria-label="@slot.LocationNo">
                                                    <span>@column@row.Code</span>
                                                    @if (slot.TotalQty > 0) { <small>@Quantity(slot.TotalQty)</small> }
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            }
                            @if (StorageLocations.Count > 0)
                            {
                                <div class="tablet-hierarchy-cards">
                                    @foreach (var location in StorageLocations)
                                    {
                                        <RadzenButton id="@RackElementId(location.LocationNo)" class="tablet-location-card" Click="@(() => SelectLocation(location.LocationNo))">
                                            <div class="tablet-location-content">
                                                <span>@location.LocationNo</span>
                                                <strong>@(location.LocationName ?? location.LocationNo)</strong>
                                                <small>Load Capacity: @Capacity(location.Capacity)</small>
                                                <b>@Quantity(LocationQty(location.LocationNo)) <em>QTY</em></b>
                                            </div>
                                        </RadzenButton>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>

            <aside class="detail-pane">
                <div class="search-panel">
                    <label for="inventory-search">PART NO / PART NAME / LOT / LOCATION</label>
                    <div class="search-row">
                        <div class="part-search-combobox" @onfocusout="ClosePartSuggestions">
                            <input id="inventory-search" class="inventory-search rz-textbox" value="@_query"
                                   @oninput="OnPartSearchInput" @onfocus="OpenPartSuggestions" @onkeydown="HandleSearchKey"
                                   role="combobox" aria-autocomplete="list" aria-controls="part-suggestions"
                                   aria-expanded="@(_showPartSuggestions && PartSuggestions.Count > 0)"
                                   aria-activedescendant="@(_activePartSuggestion >= 0 ? $"part-option-{_activePartSuggestion}" : null)"
                                   autocomplete="off" placeholder="Enter part no, part name, lot, or location" />
                            @if (_showPartSuggestions && PartSuggestions.Count > 0)
                            {
                                <div id="part-suggestions" class="part-suggestions" role="listbox" aria-label="Matching parts">
                                    @for (var index = 0; index < PartSuggestions.Count; index++)
                                    {
                                        var optionIndex = index;
                                        var part = PartSuggestions[index];
                                        <button id="@($"part-option-{index}")" type="button" role="option" tabindex="-1"
                                                aria-selected="@(index == _activePartSuggestion)" class="@(index == _activePartSuggestion ? "active" : "")"
                                                @onpointerdown:preventDefault="true" @onclick="@(() => SelectPartSuggestion(part))">
                                            <span><strong>@part.PartNo</strong><b>@part.Floors</b></span>
                                            <small>@part.PartName</small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <RadzenButton class="search-button" Icon="search" Text="SEARCH" Click="Search" Disabled="@_loading" />
                        <RadzenButton class="reset-button" Icon="refresh" Text="RESET" Click="Reset" title="Reset search" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_notice))
                    {
                        <div class="search-notice @(_results.Count == 0 ? "warning" : "")">@_notice</div>
                    }
                </div>

                @if (_selected is not null)
                {
                    <section class="selected-detail">
                        <div class="detail-title">
                            <div>
                                <span class="eyebrow">SELECTED INVENTORY</span>
                                <h2>@Text(_selected.PartNo) <span class="part-floor">@FloorLabel(FloorOf(_selected))</span></h2>
                                <p>@Text(_selected.PartName)</p>
                            </div>
                            <RadzenBadge class="qty-badge" Text="@Qty(_selected)" />
                        </div>
                        <dl class="detail-grid">
                            <div><dt>Location</dt><dd>@_selected.LocationNo</dd></div>
                            <div><dt>Lot No</dt><dd>@Text(_selected.LotNo)</dd></div>
                            <div><dt>Part No</dt><dd>@Text(_selected.PartNo)</dd></div>
                            <div><dt>Rack</dt><dd>@RackAddress(_selected)</dd></div>
                            <div><dt>Load Capacity</dt><dd>@Capacity(_selected.Capacity)</dd></div>
                            <div><dt>Defect Qty</dt><dd class="tablet-defect-qty">@AMES.Contracts.Formatting.UomPrecisionMap.Empty.QtyUnit(_selected.DefectQty, _selected.Unit)</dd></div>
                            <div class="wide"><dt>Part Name</dt><dd>@Text(_selected.PartName)</dd></div>
                        </dl>
                    </section>
                }

                <section class="result-panel">
                    <div class="result-heading">
                        <div><span class="eyebrow">INVENTORY LIST</span><strong>@_results.Count rows</strong></div>
                        @if (_matchedLocations.Count > 0)
                        {
                            <span>@_matchedLocations.Count map locations found</span>
                        }
                    </div>
                    <div class="result-table-wrap">
                        <table class="result-table">
                            <thead>
                                <tr><th>Location</th><th>Lot No</th><th>Part No</th><th>Part Name</th><th>Qty</th></tr>
                            </thead>
                            <tbody>
                                @if (_results.Count == 0)
                                {
                                    <tr><td colspan="5" class="empty-result">No inventory found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _results)
                                    {
                                        <tr class="@ResultClass(row)" @onclick="@(() => SelectResult(row))">
                                            <td>@row.LocationNo</td>
                                            <td>@Text(row.LotNo)</td>
                                            <td>@Text(row.PartNo)<span class="part-floor">@FloorLabel(FloorOf(row))</span></td>
                                            <td title="@row.PartName">@Text(row.PartName)</td>
                                            <td>@Qty(row)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? Warehouse { get; set; }
    [SupplyParameterFromQuery] public string? Area { get; set; }
    private sealed record RackSlot(string LocationNo, string RowCode, string Column, decimal TotalQty, decimal? Capacity, bool HasStock);
    private sealed record FloorRow(string Code, IReadOnlyList<RackSlot> Slots);
    private sealed record PartSuggestion(string PartNo, string? PartName, string Floors);
    private const int MaxZoomLevel = 5;
    private List<TabletInventoryApi.InventoryRow> _rows = [], _results = [];
    private List<RackSlot> _rackSlots = [];
    private HashSet<string> _matchedLocations = new(StringComparer.OrdinalIgnoreCase);
    private TabletInventoryApi.InventoryRow? _selected;
    private string _query = "", _selectedFloor = "-", _areaName = "";
    private string? _notice, _loadMessage, _loadedScope;
    private bool _loading = true, _selectingFloor, _showPartSuggestions, _openStorage;
    private int _zoomLevel, _activePartSuggestion = -1;

    private List<string> Floors => _rows.Select(FloorOf).Distinct().OrderBy(TabletMapCoordinates.AxisOrder).ThenBy(x => x).ToList();
    private string[] MapColumns => _rackSlots.Select(x => x.Column).Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(TabletMapCoordinates.AxisOrder).ThenBy(x => x).ToArray();
    private string[] FloorRowCodes => _rackSlots.Select(x => x.RowCode).Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(TabletMapCoordinates.AxisOrder).ThenBy(x => x).ToArray();
    private IEnumerable<FloorRow> MapRows => FloorRowCodes.Select(code => new FloorRow(code, _rackSlots.Where(x => Same(x.RowCode, code)).ToList()));
    private int VisibleColumnCount => Math.Max(1, MapColumns.Length - _zoomLevel * 2);
    private int VisibleRowCount => Math.Max(1, FloorRowCodes.Length - _zoomLevel);
    private string MapStyle => FormattableString.Invariant(
        $"--map-columns:{Math.Max(1, MapColumns.Length)};--map-rows:{Math.Max(1, FloorRowCodes.Length)};--map-width:{100d * Math.Max(1, MapColumns.Length) / VisibleColumnCount:0.###}%;--map-height:{100d * Math.Max(1, FloorRowCodes.Length) / VisibleRowCount:0.###}%;");
    private List<TabletInventoryApi.InventoryRow> StorageLocations => _rows.Where(x => OnFloor(x) && (_openStorage || !TabletMapCoordinates.HasGrid(x)))
        .GroupBy(x => x.LocationNo, StringComparer.OrdinalIgnoreCase).Select(g => g.First()).ToList();
    private List<PartSuggestion> PartSuggestions => string.IsNullOrWhiteSpace(_query) ? [] : AllStockRows()
        .GroupBy(x => x.PartNo, StringComparer.OrdinalIgnoreCase)
        .Where(g => Contains(g.Key, _query.Trim()) || g.Any(x => Contains(x.PartName, _query.Trim())))
        .Take(12).Select(g => new PartSuggestion(g.Key!, g.First().PartName,
            string.Join(", ", g.Select(FloorOf).Distinct().OrderBy(TabletMapCoordinates.AxisOrder).Select(FloorLabel)))).ToList();

    protected override Task OnParametersSetAsync()
    {
        if (Auth.Session is null) { Nav.NavigateTo("/login", replace: true); return Task.CompletedTask; }
        if (string.IsNullOrWhiteSpace(Warehouse) || string.IsNullOrWhiteSpace(Area)) { Nav.NavigateTo("/areas", replace: true); return Task.CompletedTask; }
        var scope = $"{Warehouse}\n{Area}";
        if (_loadedScope == scope) return Task.CompletedTask;
        _loadedScope = scope;
        _selectedFloor = "-";
        _zoomLevel = 0;
        _query = "";
        return Load();
    }

    private async Task Load()
    {
        _loading = true;
        try
        {
            var snapshot = await Inventory.LoadAsync();
            if (snapshot.SessionExpired) { Auth.SignOut(); Nav.NavigateTo("/login", replace: true); return; }
            _rows = snapshot.Rows.Where(x => Same(x.WarehouseCode, Warehouse) && Same(x.AreaCode, Area)).ToList();
            var area = snapshot.Areas?.FirstOrDefault(x => Same(x.WarehouseCode, Warehouse) && Same(x.AreaCode, Area));
            _areaName = area?.AreaName ?? _rows.FirstOrDefault()?.AreaName ?? Area ?? "";
            _openStorage = area?.StorageMode == "OPEN";
            if (!Floors.Contains(_selectedFloor)) _selectedFloor = Floors.FirstOrDefault() ?? "-";
            _loadMessage = _notice = snapshot.Message;
            BuildRackSlots();
            ShowAllStock();
        }
        finally { _loading = false; }
    }

    private async Task Search()
    {
        ClosePartSuggestions();
        var query = _query.Trim();
        if (query.Length == 0) { Reset(); return; }
        _results = AllStockRows().Where(x => Contains(x.PartNo, query) || Contains(x.PartName, query)
            || Contains(x.LotNo, query) || Contains(x.LocationNo, query)).ToList();
        _selected = _results.FirstOrDefault();
        _matchedLocations = _results.Select(x => x.LocationNo).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _notice = _results.Count == 0 ? $"No inventory matches '{query}'."
            : $"{_results.Count} inventory rows found across {_results.Select(FloorOf).Distinct().Count()} floor(s).";
        if (_selected is not null)
        {
            ShowResultFloor(_selected);
            await Task.Yield();
            await ScrollTo(_selected.LocationNo);
        }
    }

    private void Reset()
    {
        ClosePartSuggestions();
        _query = "";
        _notice = _loadMessage;
        ShowAllStock();
    }

    private void ShowAllStock()
    {
        _results = StockRows();
        _matchedLocations.Clear();
        _selected = _results.FirstOrDefault();
    }

    private void SelectLocation(string locationNo)
    {
        _results = StockRows().Where(x => Same(x.LocationNo, locationNo)).ToList();
        _matchedLocations = new([locationNo], StringComparer.OrdinalIgnoreCase);
        _selected = _results.FirstOrDefault();
        _notice = _results.Count == 0 ? $"{locationNo} is empty." : $"{_results.Count} inventory rows at {locationNo}.";
    }

    private async Task SelectResult(TabletInventoryApi.InventoryRow row)
    {
        _selected = row;
        ShowResultFloor(row);
        _matchedLocations = new([row.LocationNo], StringComparer.OrdinalIgnoreCase);
        await Task.Yield();
        await ScrollTo(row.LocationNo);
    }

    private void ShowResultFloor(TabletInventoryApi.InventoryRow row)
    {
        _selectedFloor = FloorOf(row);
        _selectingFloor = false;
        BuildRackSlots();
    }

    private async Task HandleSearchKey(KeyboardEventArgs args)
    {
        var suggestions = PartSuggestions;
        if (args.Key == "Escape") ClosePartSuggestions();
        else if (args.Key is "ArrowDown" or "ArrowUp" && suggestions.Count > 0)
        {
            _showPartSuggestions = true;
            _activePartSuggestion = _activePartSuggestion < 0 ? (args.Key == "ArrowDown" ? 0 : suggestions.Count - 1)
                : (_activePartSuggestion + (args.Key == "ArrowDown" ? 1 : -1) + suggestions.Count) % suggestions.Count;
        }
        else if (args.Key == "Enter")
        {
            if (_showPartSuggestions && _activePartSuggestion >= 0 && _activePartSuggestion < suggestions.Count)
                await SelectPartSuggestion(suggestions[_activePartSuggestion]);
            else await Search();
        }
    }

    private void OnPartSearchInput(ChangeEventArgs e) { _query = Convert.ToString(e.Value) ?? ""; _activePartSuggestion = -1; _showPartSuggestions = true; }
    private void OpenPartSuggestions() => _showPartSuggestions = true;
    private void ClosePartSuggestions() { _showPartSuggestions = false; _activePartSuggestion = -1; }
    private Task SelectPartSuggestion(PartSuggestion part) { _query = part.PartNo; return Search(); }
    private Task ScrollTo(string locationNo) => JS.InvokeVoidAsync("tabletRack.scrollTo", RackElementId(locationNo)).AsTask();
    private void ShowFloorSelector() => _selectingFloor = true;
    private void ShowAreas() => Nav.NavigateTo($"/areas?warehouse={Uri.EscapeDataString(Warehouse ?? "")}");
    private void ZoomIn() => _zoomLevel = Math.Min(MaxZoomLevel, _zoomLevel + 1);
    private void ZoomOut() => _zoomLevel = Math.Max(0, _zoomLevel - 1);

    private void SelectFloor(string floor)
    {
        if (!Floors.Contains(floor)) return;
        ClosePartSuggestions();
        _selectedFloor = floor;
        _selectingFloor = false;
        _notice = _loadMessage;
        _query = "";
        BuildRackSlots();
        ShowAllStock();
    }

    private void BuildRackSlots() => _rackSlots = _rows.Where(x => !_openStorage && OnFloor(x) && TabletMapCoordinates.HasGrid(x))
        .GroupBy(x => x.LocationNo, StringComparer.OrdinalIgnoreCase).Select(g => new RackSlot(g.Key,
            TabletMapCoordinates.Row(g.First()), TabletMapCoordinates.Column(g.First()),
            g.Sum(x => x.Qty), g.First().Capacity, g.Any(TabletMapCoordinates.HasStock))).ToList();
    private bool OnFloor(TabletInventoryApi.InventoryRow row) => _openStorage || FloorOf(row) == _selectedFloor;
    private List<TabletInventoryApi.InventoryRow> AllStockRows() => _rows.Where(TabletMapCoordinates.HasStock)
        .OrderBy(x => x.PartNo).ThenBy(x => x.LocationNo).ThenBy(x => x.LotNo).ToList();
    private List<TabletInventoryApi.InventoryRow> StockRows() => AllStockRows().Where(OnFloor).ToList();
    private int StockedLocationCount(string floor) => _rows.Where(x => FloorOf(x) == floor && TabletMapCoordinates.HasStock(x))
        .Select(x => x.LocationNo).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private decimal LocationQty(string id) => _rows.Where(x => Same(x.LocationNo, id)).Sum(x => x.Qty);
    private string RackClass(RackSlot slot) => $"rack-slot {(slot.HasStock ? "stocked" : "empty")} {(TabletMapCoordinates.IsFull(slot.TotalQty, slot.Capacity) ? "capacity-full" : "")} {(_matchedLocations.Contains(slot.LocationNo) ? "matched" : "")} {(_selected is not null && Same(_selected.LocationNo, slot.LocationNo) ? "selected" : "")}";
    private string ResultClass(TabletInventoryApi.InventoryRow row) => ReferenceEquals(row, _selected) ? "selected" : "";
    private static string RackElementId(string locationNo) => $"rack-{locationNo}";
    private static string RackAddress(TabletInventoryApi.InventoryRow row) => string.Join(" / ", new[] { row.WarehouseCode, row.AreaCode, row.RackX, row.RackY, row.RackZ }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string FloorOf(TabletInventoryApi.InventoryRow row) => TabletMapCoordinates.Floor(row);
    private static string FloorLabel(string floor) => TabletMapCoordinates.FloorLabel(floor);
    private static bool Contains(string? value, string query) => value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
    private static bool Same(string? left, string? right) => string.Equals(left ?? "", right ?? "", StringComparison.OrdinalIgnoreCase);
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    private static string Quantity(decimal value) => AMES.Contracts.Formatting.UomQty.Format(value, null);
    private static string Capacity(decimal? value) => value is > 0 ? Quantity(value.Value) : "-";
    private static string Qty(TabletInventoryApi.InventoryRow row) => AMES.Contracts.Formatting.UomPrecisionMap.Empty.QtyUnit(row.Qty, row.Unit);
}
