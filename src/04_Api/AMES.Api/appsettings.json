{
  "Urls": "http://localhost:5210",
  "ConnectionStrings": {
    "AMES": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "SingleLine": true
      }
    }
  },
  "Notify": {
    "FcmServiceAccountPath": ""
  },
  "ScheduledWorker": {
    "TickSec": 60,
    "StartupDelaySec": 10,
    "TimeoutSec": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
