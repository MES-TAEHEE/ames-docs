@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<SharedResources> L
@inject AuthenticationStateProvider AuthPrvd
@inject AMES.Web.Services.PermissionService PermSvc
@inject AMES.Web.Services.MenuCatalog Catalog
@inject AMES.Web.Services.AppLanguageState Lang
@inject PageHeaderState Header
@inject NavigationManager Nav
@inject IJSRuntime JS
@using AMES.Web.Services
@using System.Security.Claims

@*  외부 개방 화면(/portal) 전용 셸 — 내부 셸(TopBar + NavMenu)과 같은 구조·같은 CSS 클래스를 쓰되 청록 테마와 외부 화면 전용 메뉴로 분리된다.
    내부 사용자가 URL 로 들어오면 같은 셸에 "내부 사이트로" 버튼이 붙고, 외부 사용자에게는 로그아웃(⏻)만 있다. *@

<div class="ames-shell portal-shell">
    <header class="ames-topbar portal-top">
        <div class="ames-brand">
            <div class="ames-brand-row">
                <img class="ames-brand-mark" src="brand/eos-logo.png" alt="EOS" />
                <div style="display:flex;align-items:baseline;gap:8px;">
                    <div class="ames-brand-logo">A-MES</div>
                    <div class="ames-brand-sub">@L["Portal.Sub"]</div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Header.Code) || !string.IsNullOrEmpty(Header.Title))
        {
            <div class="ames-topbar-loc">
                @if (!string.IsNullOrEmpty(Header.Code))
                {
                    <span class="ames-loc-code">@Header.Code</span>
                }
                <span class="ames-loc-name">@Header.Title</span>
            </div>
        }

        <div class="ames-topbar-spacer"></div>

        <button class="ames-theme-toggle" @onclick="ToggleTheme" aria-label="Toggle theme">@(_theme == "light" ? "🌙" : "☀")</button>
        @if (Lang.SwitcherVisible)
        {
            <CultureSwitcher />
        }

        <div class="ames-user">
            <div class="ames-user-av @(_internal ? "ames-user-av--admin" : "ames-user-av--user")"><RadzenIcon Icon="@(_internal ? "admin_panel_settings" : "handshake")" /></div>
            <div class="ames-user-info">
                <div class="ames-user-name">@_userName</div>
                <div class="ames-user-role">@(_internal ? _roles : L["Portal.Role.External"])</div>
            </div>
            @if (_internal)
            {
                <a class="ames-user-out portal-back" href="/" title="@L["Portal.Nav.Internal"]">⌂</a>
            }
            else
            {
                <a class="ames-user-out" href="/portal/logout" title="@L["Portal.Logout"]">⏻</a>
            }
        </div>
    </header>

    <div class="ames-body">
        <aside class="ames-side portal-side @(_collapsed ? "ames-side--collapsed" : "")">
            <div class="ames-nav-top">
                <div class="ames-nav-search">
                    <span class="ames-nav-search-ic">🔍</span>
                    <input type="text" value="@_query" @oninput="e => _query = e.Value?.ToString() ?? string.Empty"
                           placeholder="@L["Portal.Nav.Search"]" aria-label="@L["Portal.Nav.Search"]" />
                    @if (!string.IsNullOrEmpty(_query))
                    {
                        <button class="ames-nav-search-x" @onclick="() => _query = string.Empty" aria-label="clear">✕</button>
                    }
                </div>
                <button class="ames-side-toggle" @onclick="() => _collapsed = !_collapsed">@(_collapsed ? "▶" : "◀")</button>
            </div>

            <div class="ames-nav">
                <NavLink class="ames-nav-home" href="@PortalAuth.HomePath.TrimStart('/')" Match="NavLinkMatch.All">
                    <span class="ames-nav-ic">⌂</span>
                    <span>@L["Portal.Nav.Home"]</span>
                </NavLink>

                <div class="ames-nav-section portal @(_open ? "open" : "")" @onclick="() => _open = !_open">
                    <span class="ames-nav-section-ic">🌐</span>
                    <span class="ames-nav-section-t">PORTAL · @L["Portal.Sub"]</span>
                    <span class="ames-nav-section-n">@Filtered.Count</span>
                    <span class="ames-nav-chevron">@(_open ? "▾" : "▸")</span>
                </div>
                @if (_open)
                {
                    @foreach (var it in Filtered)
                    {
                        <div class="ames-nav-row">
                            <NavLink class="ames-nav-link" href="@it.Href">
                                <span class="lid">@it.Lid</span>
                                <span>@Label(it)</span>
                            </NavLink>
                        </div>
                    }
                    @if (Filtered.Count == 0)
                    {
                        <div class="ames-nav-empty">@L["Portal.Nav.Empty"]</div>
                    }
                }
            </div>
        </aside>

        <main class="ames-main">
            <div class="ames-content">
                @Body
            </div>
        </main>
    </div>
</div>

<RadzenComponents @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    @L["App.Error.Unhandled"]
    <a href="." class="reload">@L["App.Error.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    bool _internal, _open = true, _collapsed;
    string _userName = "", _roles = "", _query = "", _theme = "dark";
    List<MenuCatalog.Item> _items = new();

    List<MenuCatalog.Item> Filtered => string.IsNullOrWhiteSpace(_query)
        ? _items
        : _items.Where(i => i.Ko.Contains(_query, StringComparison.OrdinalIgnoreCase) || i.En.Contains(_query, StringComparison.OrdinalIgnoreCase) || i.Lid.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthPrvd.GetAuthenticationStateAsync();
        _internal = PortalAuth.IsInternalUser(state.User);
        _userName = state.User.Identity?.Name ?? "";
        _roles = string.Join(", ", state.User.FindAll(ClaimTypes.Role).Select(c => c.Value).Distinct());
        await PermSvc.EnsureAsync(AuthPrvd);
        Catalog.Load();
        _items = Catalog.SectionItems(MenuCatalog.PortalSection).Where(i => PermSvc.IsVisible(i.Href)).ToList();
        Header.OnChanged += OnHeaderChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _theme = await JS.InvokeAsync<string>("amesTheme.get"); StateHasChanged(); } catch { }
    }

    async Task ToggleTheme() { try { _theme = await JS.InvokeAsync<string>("amesTheme.toggle"); } catch { } }

    void OnHeaderChanged() => InvokeAsync(StateHasChanged);
    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() { Header.OnChanged -= OnHeaderChanged; Nav.LocationChanged -= OnLocationChanged; }

    string Label(MenuCatalog.Item it)
        => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ko" ? it.Ko : it.En;
}
