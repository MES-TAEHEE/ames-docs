@rendermode InteractiveServer
@implements IDisposable
@inject IStringLocalizer<SharedResources> L
@inject AuthenticationStateProvider AuthPrvd
@inject AMES.Web.Services.AppLanguageState Lang
@inject PageHeaderState Header
@inject IJSRuntime JS
@using AMES.Web.Services
@using System.Security.Claims

@*  외부 포탈 상단바 — 내부 TopBar 와 같은 구조. 레이아웃(PortalLayout)은 정적이라 테마 버튼 같은 클릭이 서버에 닿지 않아
    내부 셸처럼 대화형 컴포넌트로 분리했다. 외부 화면은 외부 사용자만 열 수 있다 — 협력업체와 로그아웃만 보인다. *@

<header class="ames-topbar portal-top">
    <div class="ames-brand">
        <div class="ames-brand-row">
            <img class="ames-brand-mark" src="brand/eos-logo.png" alt="EOS" />
            <div style="display:flex;align-items:baseline;gap:8px;">
                <div class="ames-brand-logo">A-MES</div>
                <div class="ames-brand-sub">@L["Portal.Sub"]</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Header.Code) || !string.IsNullOrEmpty(Header.Title))
    {
        <div class="ames-topbar-loc">
            @if (!string.IsNullOrEmpty(Header.Code))
            {
                <span class="ames-loc-code">@Header.Code</span>
            }
            <span class="ames-loc-name">@Header.Title</span>
        </div>
    }

    <div class="ames-topbar-spacer"></div>

    <button class="ames-theme-toggle" @onclick="ToggleTheme"
            title="@(_theme == "light" ? "다크 테마" : "라이트 테마")"
            aria-label="Toggle theme">@(_theme == "light" ? "🌙" : "☀")</button>
    @if (Lang.SwitcherVisible)
    {
        <CultureSwitcher />
    }

    <div class="ames-user">
        <div class="ames-user-av ames-user-av--user"><RadzenIcon Icon="handshake" /></div>
        <div class="ames-user-info">
            <div class="ames-user-name">@_userName</div>
            <div class="ames-user-role">@L["Portal.Role.External"] · @_vendor</div>
        </div>
        <button type="button" class="ames-user-cred" title="@L["Portal.Cred.Button"]" aria-label="@L["Portal.Cred.Button"]" @onclick="() => _cred = true"><RadzenIcon Icon="key" /></button>
        <a class="ames-user-out" href="/portal/logout" title="@L["Portal.Logout"]">⏻</a>
    </div>
</header>

@* 헤더 밖에 둔다 — .ames-topbar 의 backdrop-filter 가 고정 위치(fixed) 대화상자를 헤더 안에 가둔다 *@
<PortalPasswordDialog Visible="@_cred" OnClose="@(() => _cred = false)" />

@code {
    string _userName = "", _vendor = "", _theme = "dark";
    bool _cred;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthPrvd.GetAuthenticationStateAsync();
        _userName = state.User.Identity?.Name ?? "";
        _vendor = state.User.FindFirst(PortalAuth.VendorClaim)?.Value ?? "";
        Header.OnChanged += OnHeaderChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _theme = await JS.InvokeAsync<string>("amesTheme.get"); StateHasChanged(); }
        catch { /* 프리렌더/연결 끊김 무시 */ }
    }

    async Task ToggleTheme()
    {
        try { _theme = await JS.InvokeAsync<string>("amesTheme.toggle"); }
        catch { }
    }

    void OnHeaderChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Header.OnChanged -= OnHeaderChanged;
}
