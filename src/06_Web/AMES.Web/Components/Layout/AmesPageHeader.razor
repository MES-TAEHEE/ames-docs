@implements IDisposable
@using System.Globalization
@using AMES.Data.Repositories
@using AMES.Web.Services
@inject IStringLocalizer<SharedResources> L
@inject PageHeaderState State
@inject NavigationManager Nav
@inject SysRepository Sys
@inject ScreenCatalogNotifier ScreenCatalog

@* 화면엔 아무것도 렌더링하지 않는다 — 경로/이름은 TopBar 브레드크럼에 표시된다. *@

@code {
    /// <summary>경로 코드 (예: PP-004, MD-010).</summary>
    [Parameter] public string? Code { get; set; }

    /// <summary>현지화 리소스 키 (예: PP.WorkOrder.Title). Title이 있으면 무시된다.</summary>
    [Parameter] public string? TitleKey { get; set; }

    /// <summary>리소스를 거치지 않는 직접 지정 이름. 지정 시 TitleKey보다 우선.</summary>
    [Parameter] public string? Title { get; set; }

    protected override void OnInitialized() => ScreenCatalog.Changed += OnScreensChanged;

    protected override void OnParametersSet() => UpdateHeader();

    void UpdateHeader()
    {
        var fallback = !string.IsNullOrEmpty(Title)    ? Title
                     : !string.IsNullOrEmpty(TitleKey) ? L[TitleKey].Value
                     : null;
        var href = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        SysRepository.ScreenRow? screen = null;
        try
        {
            screen = Sys.ListScreens("WEB").FirstOrDefault(s =>
                string.Equals(s.HRef?.Trim('/'), href, StringComparison.OrdinalIgnoreCase));
        }
        catch { /* DB unavailable: keep the page's fallback header */ }

        var name = screen is null ? fallback
                 : CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ko" ? screen.ScreenName
                 : string.IsNullOrWhiteSpace(screen.ScreenNameEn) ? screen.ScreenName : screen.ScreenNameEn;
        State.Set(screen?.ScreenCode ?? Code, name);
    }

    void OnScreensChanged() => _ = InvokeAsync(UpdateHeader);

    public void Dispose() => ScreenCatalog.Changed -= OnScreensChanged;
}
