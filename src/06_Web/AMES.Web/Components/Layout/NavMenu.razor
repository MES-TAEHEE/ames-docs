@implements IDisposable
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject AMES.Web.Services.PermissionService Perm
@inject SysRepository Sys
@inject AMES.Data.Repositories.MasterDataRepository MD
@using System.Globalization
@using System.Net

<aside class="ames-side @(_collapsed ? "ames-side--collapsed" : "")">
<button class="ames-side-toggle" @onclick="ToggleSide"
        title="@(_collapsed ? "메뉴 펼치기" : "메뉴 접기")">
    @(_collapsed ? "▶" : "◀")
</button>

<div class="ames-nav">
    <NavLink class="ames-nav-home" href="" Match="NavLinkMatch.All">
        <span class="ames-nav-ic">⌂</span>
        <span>@NL("홈", "Home")</span>
    </NavLink>

    @foreach (var proc in _sectionOrder)
    {
        @if (_sectionMeta.TryGetValue(proc, out var meta)
             && VisibleScreens(proc) is var vs
             && vs.Count > 0)
        {
            <div class="ames-nav-section @meta.Css" @onclick='() => Toggle(proc)'>
                <span class="ames-nav-section-ic">@meta.Icon</span>
                <span class="ames-nav-section-t">@proc · @SL(meta.Ko, meta.En)</span>
                <span class="ames-nav-section-n">@vs.Count</span>
                <span class="ames-nav-chevron">@Chev(proc)</span>
            </div>
            @if (IsOpen(proc) && proc == "MD")
            {
                @foreach (var g in GroupedMd())
                {
                    <div class="ames-nav-sub @(IsSubOpen(g.Key) ? "open" : "")" @onclick='() => ToggleSub(g.Key)'>
                        <span class="ames-nav-sub-letter">@g.Letter</span>
                        <div class="ames-nav-sub-body">
                            <div class="ames-nav-sub-t">@SL(g.Ko, g.En)</div>
                            <div class="ames-nav-sub-s">@SL(g.En, g.Ko) · @g.Screens.Count</div>
                        </div>
                        <span class="ames-nav-sub-chevron">@(IsSubOpen(g.Key) ? "▾" : "▸")</span>
                    </div>
                    @if (IsSubOpen(g.Key))
                    {
                        @foreach (var s in g.Screens)
                        {
                            <NavLink class="ames-nav-link sub" href="@s.HRef!.TrimStart('/')">
                                <span class="lid">@(s.LidLabel ?? s.ScreenCode)</span>
                                <span>@NL(s.ScreenName, s.ScreenNameEn ?? s.ScreenName)</span>
                            </NavLink>
                        }
                    }
                }
            }
            else if (IsOpen(proc))
            {
                @foreach (var s in vs)
                {
                    <NavLink class="ames-nav-link" href="@s.HRef!.TrimStart('/')">
                        <span class="lid">@(s.LidLabel ?? s.ScreenCode)</span>
                        <span>@NL(s.ScreenName, s.ScreenNameEn ?? s.ScreenName)</span>
                    </NavLink>
                }
            }
        }
    }
</div>
</aside>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }

    bool            _collapsed;
    string?         _url;
    HashSet<string> _open = new();
    HashSet<string> _openSub = new();
    string          _lang = "ko";

    Dictionary<string, List<SysRepository.ScreenRow>> _screensByProcess = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _subprocessItems = new();

    // 섹션 표시 순서
    static readonly string[] _sectionOrder = ["PP", "MNT", "RPT", "MD", "SYS"];

    // ProcessCode → (아이콘, 한국어, 영어, CSS클래스)
    static readonly Dictionary<string, (string Icon, string Ko, string En, string Css)> _sectionMeta = new()
    {
        ["PP"]  = ("📅", "생산 계획",      "Production Planning", "pp"),
        ["MNT"] = ("🔧", "설비 보전",      "Maintenance",         "mnt"),
        ["RPT"] = ("📊", "보고서",         "Reports",             "rpt"),
        ["MD"]  = ("🗂️", "마스터 데이터", "Master Data",         "md"),
        ["SYS"] = ("⚙️", "시스템",        "System",              "sys"),
    };

    void ToggleSide() => _collapsed = !_collapsed;

    // 렌더마다 권한을 재평가해야 하므로 메서드로 처리
    List<SysRepository.ScreenRow> VisibleScreens(string proc) =>
        _screensByProcess.TryGetValue(proc, out var screens)
            ? screens.Where(s => !string.IsNullOrEmpty(s.HRef) && V(s.HRef)).ToList()
            : new();

    List<(string Key, string Letter, string En, string Ko, List<SysRepository.ScreenRow> Screens)> GroupedMd()
    {
        var visible = VisibleScreens("MD");
        return _subprocessItems
            .Select((g, i) => (
                Key:     g.CodeValue ?? "",
                Letter:  ((char)('A' + i)).ToString(),
                En:      g.CodeNameEn ?? g.CodeName ?? g.CodeValue ?? "",
                Ko:      g.CodeName   ?? g.CodeValue ?? "",
                Screens: visible.Where(s => s.SubProcessCode == g.CodeValue).ToList()
            ))
            .Where(g => g.Screens.Count > 0)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        _url  = Nav.ToBaseRelativePath(Nav.Uri);

        try
        {
            _screensByProcess = Sys.ListScreens("WEB")
                .Where(s => !string.IsNullOrEmpty(s.ProcessCode))
                .GroupBy(s => s.ProcessCode!)
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderBy(s => s.SortOrder ?? 999).ThenBy(s => s.ScreenCode).ToList());
            _subprocessItems = MD.ListCodeItems("SUBPROCESS");
        }
        catch { }

        Nav.LocationChanged += OnLocChanged;
        if (AuthState is not null)
            await Perm.EnsureAsync(AuthState);

        OpenCurrentSection();
    }

    void OpenCurrentSection()
    {
        var url = (_url ?? "").ToLowerInvariant();
        foreach (var proc in _sectionOrder)
        {
            if (!_screensByProcess.TryGetValue(proc, out var screens)) continue;
            var hit = screens.FirstOrDefault(s => s.HRef is not null &&
                    url.StartsWith(s.HRef.TrimStart('/').ToLowerInvariant()));
            if (hit is not null)
            {
                _open.Add(proc);
                if (proc == "MD") _openSub.Add(hit.SubProcessCode ?? "");
                return;
            }
        }
    }

    void OnLocChanged(object? sender, LocationChangedEventArgs e)
    {
        _url = Nav.ToBaseRelativePath(e.Location);
        var url = _url.ToLowerInvariant();
        foreach (var proc in _sectionOrder)
        {
            if (!_screensByProcess.TryGetValue(proc, out var screens)) continue;
            var hit = screens.FirstOrDefault(s => s.HRef is not null &&
                    url.StartsWith(s.HRef.TrimStart('/').ToLowerInvariant()));
            if (hit is not null)
            {
                _open.Add(proc);
                if (proc == "MD") _openSub.Add(hit.SubProcessCode ?? "");
                break;
            }
        }
        StateHasChanged();
    }

    void Toggle(string key)
    {
        if (_open.Contains(key)) _open.Remove(key);
        else { _open.Clear(); _open.Add(key); }
    }

    void ToggleSub(string key)
    {
        if (_openSub.Contains(key)) _openSub.Remove(key);
        else { _openSub.Clear(); _openSub.Add(key); }
    }

    bool   IsOpen(string key)    => _open.Contains(key);
    bool   IsSubOpen(string key) => _openSub.Contains(key);
    string Chev(string key)      => _open.Contains(key) ? "▾" : "▸";
    bool   V(string href)     => Perm.IsVisible(href);

    string SL(string ko, string en) => _lang == "en" ? en : ko;

    MarkupString NL(string ko, string en)
    {
        var (p, s) = _lang == "en" ? (en, ko) : (ko, en);
        return new MarkupString(
            $"{WebUtility.HtmlEncode(p)}<span style=\"display:block;font-size:.72em;color:#94a3b8;font-weight:400;line-height:1.2;\">{WebUtility.HtmlEncode(s)}</span>");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocChanged;
}
