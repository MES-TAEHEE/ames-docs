@implements IDisposable
@inject NavigationManager Nav

@*  AMES Office Web side-nav. Four module groups + identity row at top.
    Each NavLink target falls back to a "soon" stub until the matching
    page lands; the route hierarchy is fixed so the order doesn't shift
    between modules. *@

<div class="ames-brand">
    <span class="ames-brand-logo">A-MES</span>
    <span class="ames-brand-sub">OFFICE WEB</span>
</div>

<AuthorizeView>
    <Authorized>
        <div class="ames-user">
            <span class="ames-user-name">@context.User.Identity?.Name</span>
            <form action="Account/Logout" method="post" style="display:inline;">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@_url" />
                <button type="submit" class="ames-user-out" title="Sign out">⏻</button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="ames-user dim">not signed in</div>
    </NotAuthorized>
</AuthorizeView>

<div class="ames-nav">
    <NavLink class="ames-nav-home" href="" Match="NavLinkMatch.All">⌂ Home</NavLink>

    <div class="ames-nav-section">▼ PP · PRODUCTION PLAN</div>
    <NavLink class="ames-nav-link" href="pp/forecast">PP-01 Forecast</NavLink>
    <NavLink class="ames-nav-link" href="pp/sap-import">PP-02 SAP Import</NavLink>
    <NavLink class="ames-nav-link" href="pp/plan-confirm">PP-03 Plan Confirm</NavLink>
    <NavLink class="ames-nav-link" href="pp/work-order">PP-04 Work Order</NavLink>
    <NavLink class="ames-nav-link" href="pp/mrp">PP-05 MRP</NavLink>
    <NavLink class="ames-nav-link" href="pp/purchase-req">PP-06 Purchase Req</NavLink>
    <NavLink class="ames-nav-link" href="pp/wo-release">PP-07 WO Release</NavLink>
    <NavLink class="ames-nav-link" href="pp/calendar">PP-CAL Calendar</NavLink>
    <NavLink class="ames-nav-link" href="pp/line-schedule">PP-LSB Line Schedule</NavLink>
    <NavLink class="ames-nav-link" href="pp/oee">PP-OEE Line OEE</NavLink>
    <NavLink class="ames-nav-link" href="pp/downtime">PP-DTL Downtime Log</NavLink>
    <NavLink class="ames-nav-link" href="pp/downtime-monitor">PP-ODM Downtime Monitor</NavLink>
    <NavLink class="ames-nav-link" href="pp/delivery">PP-OTD On-Time Delivery</NavLink>

    <div class="ames-nav-section">▼ MNT · MAINTENANCE</div>
    <NavLink class="ames-nav-link" href="mnt/equipment-card">MNT-01 Equipment Card</NavLink>
    <NavLink class="ames-nav-link" href="mnt/failure">MNT-02 Failure Register</NavLink>
    <NavLink class="ames-nav-link" href="mnt/oee-analysis">MNT-03 OEE Analysis</NavLink>
    <NavLink class="ames-nav-link" href="mnt/mold">MNT-04 Mold Management</NavLink>
    <NavLink class="ames-nav-link" href="mnt/pm-schedule">MNT-05 PM Schedule</NavLink>
    <NavLink class="ames-nav-link" href="mnt/downtime">MNT-06 Downtime Log</NavLink>
    <NavLink class="ames-nav-link" href="mnt/work-order">MNT-07 Work Order</NavLink>
    <NavLink class="ames-nav-link" href="mnt/spare-parts">MNT-08 Spare Parts</NavLink>
    <NavLink class="ames-nav-link" href="mnt/dashboard">MNT-09 Dashboard</NavLink>

    <div class="ames-nav-section">▼ RPT · REPORTS</div>
    <NavLink class="ames-nav-link" href="rpt/daily-production">RPT-01 Daily Production</NavLink>
    <NavLink class="ames-nav-link" href="rpt/defect-pareto">RPT-02 Defect Pareto</NavLink>
    <NavLink class="ames-nav-link" href="rpt/daily-shipment">RPT-03 Daily Shipment</NavLink>
    <NavLink class="ames-nav-link" href="rpt/on-time">RPT-04 On-Time Delivery</NavLink>
    <NavLink class="ames-nav-link" href="rpt/inventory">RPT-05 Inventory Status</NavLink>
    <NavLink class="ames-nav-link" href="rpt/equipment-oee">RPT-06 Equipment OEE</NavLink>
    <NavLink class="ames-nav-link" href="rpt/monthly-kpi">RPT-07 Monthly KPI</NavLink>
    <NavLink class="ames-nav-link" href="rpt/schedule-adherence">RPT-08 Schedule Adherence</NavLink>
    <NavLink class="ames-nav-link" href="rpt/report-center">RPT-09 Report Center</NavLink>
    <NavLink class="ames-nav-link" href="rpt/report-builder">RPT-10 Report Builder</NavLink>

    <div class="ames-nav-section">▼ SYS · SYSTEM</div>
    <NavLink class="ames-nav-link" href="sys/users">SYS-01 User Management</NavLink>
    <NavLink class="ames-nav-link" href="sys/rbac">SYS-02 RBAC Permissions</NavLink>
    <NavLink class="ames-nav-link" href="sys/calendar">SYS-03 Factory Calendar</NavLink>
    <NavLink class="ames-nav-link" href="sys/interfaces">SYS-04 Interface Monitor</NavLink>
    <NavLink class="ames-nav-link" href="sys/audit">SYS-05 Audit Log</NavLink>
    <NavLink class="ames-nav-link" href="sys/notifications">SYS-06 Notifications</NavLink>
    <NavLink class="ames-nav-link" href="sys/config">SYS-07 System Config</NavLink>
    <NavLink class="ames-nav-link" href="sys/health">SYS-08 System Health</NavLink>
</div>

@code {
    private string? _url;
    protected override void OnInitialized()
    {
        _url = Nav.ToBaseRelativePath(Nav.Uri);
        Nav.LocationChanged += OnLocChanged;
    }
    private void OnLocChanged(object? sender, LocationChangedEventArgs e)
    {
        _url = Nav.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
    public void Dispose() => Nav.LocationChanged -= OnLocChanged;
}
