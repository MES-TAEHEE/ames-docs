@code {
    string?          _url;
    HashSet<string>  _open = new();

    static readonly Dictionary<string, string> _prefixMap = new()
    {
        ["pp/"]  = "pp",  ["mnt/"] = "mnt", ["rpt/"] = "rpt",
        ["md/"]  = "md",  ["sys/"] = "sys",
    };

    protected override void OnInitialized()
    {
        _url = Nav.ToBaseRelativePath(Nav.Uri);
        OpenCurrentSection();
        Nav.LocationChanged += OnLocChanged;
    }

    void OpenCurrentSection()
    {
        var url = _url ?? "";
        foreach (var (prefix, key) in _prefixMap)
            if (url.StartsWith(prefix)) { _open.Add(key); return; }
    }

    void OnLocChanged(object? sender, LocationChangedEventArgs e)
    {
        _url = Nav.ToBaseRelativePath(e.Location);
        foreach (var (prefix, key) in _prefixMap)
            if (_url.StartsWith(prefix)) { _open.Add(key); break; }
        StateHasChanged();
    }

    void Toggle(string key)
    {
        if (_open.Contains(key)) _open.Remove(key);
        else { _open.Clear(); _open.Add(key); }
    }

    bool IsOpen(string key) => _open.Contains(key);
    string Chev(string key) => _open.Contains(key) ? "▾" : "▸";

    public void Dispose() => Nav.LocationChanged -= OnLocChanged;
}
