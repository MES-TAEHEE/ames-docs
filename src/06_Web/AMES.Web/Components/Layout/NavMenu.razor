@implements IDisposable
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AMES.Web.Services.PermissionService PermSvc
@inject AMES.Web.Services.MenuCatalog Catalog
@using AMES.Web.Services
@inject AMES.Web.Services.ScreenCatalogNotifier ScreenCatalog
@inject AMES.Web.Services.AppLanguageState Lang
@using System.Globalization
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization

<aside class="ames-side @(_collapsed ? "ames-side--collapsed" : "")">
    @* ── 검색 + 사이드바 토글 (스크롤과 무관한 고정 헤더) ── *@
    <div class="ames-nav-top">
        <div class="ames-nav-search">
            <span class="ames-nav-search-ic">🔍</span>
            <input type="text" value="@_query"
                   @oninput="OnQueryInput" @onkeydown="OnQueryKeydown"
                   placeholder="@SL("화면 검색…", "Search screens…")"
                   aria-label="@SL("화면 검색", "Search screens")" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <button class="ames-nav-search-x" @onclick="ClearQuery"
                        title="@SL("지우기", "Clear")" aria-label="@SL("지우기", "Clear")">✕</button>
            }
        </div>
        <button class="ames-side-toggle" @onclick="ToggleSide"
                title="@(_collapsed ? "메뉴 펼치기" : "메뉴 접기")">
            @(_collapsed ? "▶" : "◀")
        </button>
    </div>

<div class="ames-nav">
    <NavLink class="ames-nav-home" href="" Match="NavLinkMatch.All">
        <span class="ames-nav-ic">⌂</span>
        <span>@NL("홈", "Home", "Inicio")</span>
    </NavLink>

    @if (!string.IsNullOrWhiteSpace(_query))
    {
        @* ── 검색 결과 (섹션 교차, 플랫) ── *@
        var results = Search(_query);
        if (results.Count == 0)
        {
            <div class="ames-nav-empty">@SL("결과 없음", "No results")</div>
        }
        else
        {
            <div class="ames-nav-results">
                @foreach (var it in results)
                {
                    @RenderRow(it, showTag: true)
                }
            </div>
        }
    }
    else
    {
        @* ── 즐겨찾기 ── *@
        var favs = Catalog.Items.Where(i => _favorites.Contains(i.Href) && V(i.Href)).ToList();
        @if (favs.Count > 0)
        {
            <div class="ames-nav-section ames-nav-fav" @onclick="ToggleFav">
                <span class="ames-nav-section-ic">⭐</span>
                <span class="ames-nav-section-t">@SL("즐겨찾기", "Favorites")</span>
                <span class="ames-nav-section-n">@favs.Count</span>
                <span class="ames-nav-chevron">@(_favOpen ? "▾" : "▸")</span>
            </div>
            @if (_favOpen)
            {
                @foreach (var it in favs)
                {
                    @RenderRow(it, showTag: true)
                }
            }
        }

        @* ── 섹션 아코디언 ── *@
        @foreach (var sec in MenuCatalog.Sections)
        {
            var secItems = SectionItems(sec.Key);
            if (secItems.Count == 0) { continue; }
            <div class="ames-nav-section @sec.Key @(IsOpen(sec.Key) ? "open" : "")" @onclick="() => Toggle(sec.Key)">
                <span class="ames-nav-section-ic">@sec.Icon</span>
                <span class="ames-nav-section-t">@sec.Key.ToUpperInvariant() · @SL(sec.Ko, sec.En, sec.Es)</span>
                <span class="ames-nav-section-n">@secItems.Count</span>
                <span class="ames-nav-chevron">@Chev(sec.Key)</span>
            </div>
            @if (IsOpen(sec.Key))
            {
                @if (sec.Key == "md" && Catalog.SubprocessItems.Count > 0)
                {
                    @* ── MD: SubProcessCode 서브그룹 아코디언 ── *@
                    @foreach (var g in Catalog.GroupedMd(secItems))
                    {
                        var (gp, gs) = LangPair(g.Ko, g.En, g.Es);
                        <div class="ames-nav-sub @(IsSubOpen(g.Key) ? "open" : "")" @onclick='() => ToggleSub(g.Key)'>
                            <span class="ames-nav-sub-letter">@g.Letter</span>
                            <div class="ames-nav-sub-body">
                                <div class="ames-nav-sub-t">@gp</div>
                                @if (_bilingual)
                                {
                                    <div class="ames-nav-sub-s">@gs · @g.Items.Count</div>
                                }
                            </div>
                            @if (!_bilingual)
                            {
                                <span class="ames-nav-section-n">@g.Items.Count</span>
                            }
                            <span class="ames-nav-sub-chevron">@(IsSubOpen(g.Key) ? "▾" : "▸")</span>
                        </div>
                        @if (IsSubOpen(g.Key))
                        {
                            @foreach (var it in g.Items)
                            {
                                @RenderRow(it, showTag: false)
                            }
                        }
                    }
                    @foreach (var it in Catalog.UngroupedMd(secItems))
                    {
                        @RenderRow(it, showTag: false)
                    }
                }
                else
                {
                    @foreach (var it in secItems)
                    {
                        @RenderRow(it, showTag: false)
                    }
                }
            }
        }
    }
</div>
</aside>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }

    bool            _collapsed;
    string?         _url;
    HashSet<string> _open = new();
    HashSet<string> _openSub = new(StringComparer.OrdinalIgnoreCase);
    HashSet<string> _favorites = new();
    string          _lang = "ko";
    bool            _bilingual = true;   // LANGUAGE_DEFAULT 비활성 시 false → 2차(부) 언어 표기 숨김
    string          _query = "";
    bool            _favOpen = true;   // 즐겨찾기 섹션: 기본 펼침
    bool            _loaded;   // localStorage 복원 완료 전엔 저장 스킵

    const string KeyOpen      = "ames.nav.open";
    const string KeyOpenSub   = "ames.nav.opensub";
    const string KeyCollapsed = "ames.nav.collapsed";
    const string KeyFavorites = "ames.nav.favorites";
    const string KeyFavOpen   = "ames.nav.favopen";





    RenderFragment RenderRow(MenuCatalog.Item it, bool showTag) => __builder =>
    {
        var isFav = _favorites.Contains(it.Href);
        var lid = DisplayLid(it);
        <div class="ames-nav-row @(isFav ? "is-fav" : "")">
            <NavLink class="ames-nav-link" href="@it.Href">
                @if (showTag)
                {
                    <span class="lid @it.Section">@lid</span>
                }
                else
                {
                    <span class="lid">@lid</span>
                }
                <span>@NavLabel(it)</span>
            </NavLink>
            <button class="ames-nav-star" @onclick="() => ToggleFavorite(it.Href)"
                    title="@SL(isFav ? "즐겨찾기 해제" : "즐겨찾기 추가", isFav ? "Remove favorite" : "Add favorite")"
                    aria-label="@SL("즐겨찾기", "Favorite")">@(isFav ? "★" : "☆")</button>
        </div>
    };

    void ToggleSide()
    {
        _collapsed = !_collapsed;
        _ = PersistCollapsed();
    }

    List<MenuCatalog.Item> Search(string q)
    {
        bool Has(string s) => s.IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0;
        return Catalog.Items.Where(i => V(i.Href) && (Has(i.Ko) || Has(i.En) || Has(i.Lid))).ToList();
    }

    void OnQueryInput(ChangeEventArgs e) => _query = e.Value?.ToString() ?? "";

    void OnQueryKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _query = "";
    }

    void ClearQuery() => _query = "";

    void ToggleFavorite(string href)
    {
        if (!_favorites.Remove(href)) _favorites.Add(href);
        _ = PersistFavorites();
    }

    static readonly Dictionary<string, string> _prefixMap = new()
    {
        ["wh/"]  = "wh",  ["fg/"]  = "fg",  ["pp/"]  = "pp",  ["mnt/"] = "mnt", ["rpt/"] = "rpt",
        ["md/"]  = "md",  ["sys/"] = "sys", ["scm/"] = "scm",
    };


    // 권한 필터: DB 로딩 시 PermissionService 기준(WH·FG 포함, SYS_Screen 등록이 정본), 폴백 시 전부 표시
    bool V(string href)
    {
        var normalized = href.TrimStart('/');
        // 외부 개방 화면(portal/…)은 내부 메뉴·검색·즐겨찾기에 내지 않는다 — 외부 포탈 셸(PortalLayout)에서만 보인다
        if (normalized.StartsWith(AMES.Web.Services.PortalAuth.Prefix.TrimStart('/') + "/", StringComparison.OrdinalIgnoreCase)) return false;
        return !MenuCatalog.IsHidden(normalized)
            && (Catalog.UsingFallback || PermSvc.IsVisible(normalized));
    }



    protected override async Task OnInitializedAsync()
    {
        _lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        _bilingual = Lang.SwitcherVisible;   // 비활성(en-US 강제) 시 단일 언어만 표기
        _url  = Nav.ToBaseRelativePath(Nav.Uri);

        Catalog.Load();

        if (AuthState is not null)
        {
            try { await PermSvc.EnsureAsync(AuthState); }
            catch { /* 권한 로딩 실패 — GetLevel 미초기화 시 전부 허용 */ }
        }

        OpenCurrentSection();
        Nav.LocationChanged += OnLocChanged;
        ScreenCatalog.Changed += OnScreensChanged;
    }


    List<MenuCatalog.Item> SectionItems(string section) =>
        Catalog.Items.Where(item => item.Section == section && V(item.Href)).ToList();


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var favJson = await JS.InvokeAsync<string?>("localStorage.getItem", KeyFavorites);
            if (!string.IsNullOrWhiteSpace(favJson))
                _favorites = JsonSerializer.Deserialize<HashSet<string>>(favJson) ?? new();

            var collapsed = await JS.InvokeAsync<string?>("localStorage.getItem", KeyCollapsed);
            if (collapsed is not null) _collapsed = collapsed == "1";

            var favOpen = await JS.InvokeAsync<string?>("localStorage.getItem", KeyFavOpen);
            if (favOpen is not null) _favOpen = favOpen == "1";

            var openSubJson = await JS.InvokeAsync<string?>("localStorage.getItem", KeyOpenSub);
            if (!string.IsNullOrWhiteSpace(openSubJson))
            {
                var storedSub = JsonSerializer.Deserialize<HashSet<string>>(openSubJson);
                if (storedSub is not null) _openSub.UnionWith(storedSub);
            }

            var openJson = await JS.InvokeAsync<string?>("localStorage.getItem", KeyOpen);
            if (!string.IsNullOrWhiteSpace(openJson))
            {
                var stored = JsonSerializer.Deserialize<HashSet<string>>(openJson);
                if (stored is not null)
                {
                    _open = stored;
                    OpenCurrentSection();   // 저장값 위에 현재 URL 섹션도 열어둠
                }
            }
        }
        catch (JsonException) { /* 손상된 값 무시 — 기본 상태 유지 */ }

        _loaded = true;
        StateHasChanged();
    }

    void OpenCurrentSection()
    {
        var url = _url ?? "";
        foreach (var (prefix, key) in _prefixMap)
            if (url.StartsWith(prefix)) { _open.Add(key); OpenCurrentSub(url); return; }
    }

    // 현재 URL이 속한 MD 서브그룹도 열어둠
    void OpenCurrentSub(string url)
    {
        _openSub.Clear();
        var hit = Catalog.Items.FirstOrDefault(i =>
            url.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(hit?.Sub)) _openSub.Add(hit!.Sub!.ToUpperInvariant());   // GroupedMd 의 Key 와 같은 대문자
    }

    void OnLocChanged(object? sender, LocationChangedEventArgs e)
    {
        _url = Nav.ToBaseRelativePath(e.Location);
        _open.Clear();
        foreach (var (prefix, key) in _prefixMap)
            if (_url.StartsWith(prefix)) { _open.Add(key); OpenCurrentSub(_url); break; }
        _ = PersistOpen();
        StateHasChanged();
    }

    void OnScreensChanged() => _ = InvokeAsync(async () =>
    {
        Catalog.Reload();   // SYS-003 화면 마스터 편집 반영 — 카탈로그를 다시 읽는다
        PermSvc.Reset();
        if (AuthState is not null) await PermSvc.EnsureAsync(AuthState);
        OpenCurrentSub(_url ?? "");
        StateHasChanged();
    });

    void Toggle(string key)
    {
        var isOpen = _open.Contains(key);
        _open.Clear();
        if (!isOpen) _open.Add(key);
        _ = PersistOpen();
    }

    void ToggleSub(string key)
    {
        var isOpen = _openSub.Contains(key);
        _openSub.Clear();
        if (!isOpen) _openSub.Add(key);
        _ = PersistOpenSub();
    }

    void ToggleFav()
    {
        _favOpen = !_favOpen;
        _ = PersistFavOpen();
    }

    bool   IsOpen(string key)    => _open.Contains(key);
    bool   IsSubOpen(string key) => _openSub.Contains(key);
    string Chev(string key)      => _open.Contains(key) ? "▾" : "▸";

    Task PersistOpen()      => Save(KeyOpen, JsonSerializer.Serialize(_open));
    Task PersistOpenSub()   => Save(KeyOpenSub, JsonSerializer.Serialize(_openSub));
    Task PersistFavorites() => Save(KeyFavorites, JsonSerializer.Serialize(_favorites));
    Task PersistCollapsed() => Save(KeyCollapsed, _collapsed ? "1" : "0");
    Task PersistFavOpen()   => Save(KeyFavOpen, _favOpen ? "1" : "0");

    async Task Save(string key, string value)
    {
        if (!_loaded) return;   // 초기 복원 전엔 기본값으로 덮어쓰지 않음
        try { await JS.InvokeVoidAsync("localStorage.setItem", key, value); }
        catch (JSException) { /* 프리렌더/연결 끊김 무시 */ }
    }




    // 언어별 (주 라벨, 부 라벨): ko=한/영, en=영/한, es=서/영 (서문 없으면 영문 폴백)
    (string Primary, string Secondary) LangPair(string ko, string en, string? es) => _lang switch
    {
        "en" => (en, ko),
        "es" => (string.IsNullOrEmpty(es) ? en : es!, en),
        _    => (ko, en),
    };

    // Section header: single language (secondary 없음). 스페인어 미제공 chrome은 영문 폴백.
    string SL(string ko, string en) => _lang == "ko" ? ko : en;
    string SL(string ko, string en, string es) => _lang switch { "en" => en, "es" => es, _ => ko };

    // Nav link label: primary (big) + secondary (small gray)
    MarkupString NL(string ko, string en, string? es)
    {
        var (p, s) = LangPair(ko, en, es);
        if (!_bilingual)
            return new MarkupString(WebUtility.HtmlEncode(p));
        return new MarkupString(
            $"{WebUtility.HtmlEncode(p)}<span style=\"display:block;font-size:.72em;color:#94a3b8;font-weight:400;line-height:1.2;\">{WebUtility.HtmlEncode(s)}</span>");
    }

    // 화면 표기(lid)는 SYS_Screen.LidLabel 그대로 — WH·FG 도 다른 모듈과 같다
    static string DisplayLid(MenuCatalog.Item item) => item.Lid;

    MarkupString NavLabel(MenuCatalog.Item item) => NL(item.Ko, item.En, MenuCatalog.EsFor(item.Href));

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocChanged;
        ScreenCatalog.Changed -= OnScreensChanged;
    }
}
