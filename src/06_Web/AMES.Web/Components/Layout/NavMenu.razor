    RenderFragment RenderRow(NavItem it, bool showTag) => __builder =>
    {
        var isFav = _favorites.Contains(it.Href);
        <div class="ames-nav-row @(isFav ? "is-fav" : "")">
            <NavLink class="ames-nav-link" href="@it.Href">
                @if (showTag)
                {
                    <span class="lid @it.Section">@it.Lid</span>
                }
                else
                {
                    <span class="lid">@it.Lid</span>
                }
                <span>@NL(it.Ko, it.En)</span>
            </NavLink>
            <button class="ames-nav-star" @onclick="() => ToggleFavorite(it.Href)"
                    title="@SL(isFav ? "즐겨찾기 해제" : "즐겨찾기 추가", isFav ? "Remove favorite" : "Add favorite")"
                    aria-label="@SL("즐겨찾기", "Favorite")">@(isFav ? "★" : "☆")</button>
        </div>
    };

    void ToggleSide()
    {
        _collapsed = !_collapsed;
        _ = PersistCollapsed();
    }

    List<NavItem> Search(string q)
    {
        bool Has(string s) => s.IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0;
        return _items.Where(i => V(i.Href) && (Has(i.Ko) || Has(i.En) || Has(i.Lid))).ToList();
    }

    void OnQueryInput(ChangeEventArgs e) => _query = e.Value?.ToString() ?? "";

    void OnQueryKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _query = "";
    }

    void ClearQuery() => _query = "";

    void ToggleFavorite(string href)
    {
        if (!_favorites.Remove(href)) _favorites.Add(href);
        _ = PersistFavorites();
    }

    static readonly Dictionary<string, string> _prefixMap = new()
    {
        ["pp/"]  = "pp",  ["mnt/"] = "mnt", ["rpt/"] = "rpt",
        ["md/"]  = "md",  ["sys/"] = "sys",
    };

    // 권한 필터: DB 로딩 시 PermissionService 기준, 폴백 시 전부 표시
    bool V(string href) => _usingFallback || Perm.IsVisible(href);

    List<(string Key, string Letter, string Ko, string En, List<NavItem> Items)> GroupedMd(List<NavItem> mdItems) =>
        _subprocessItems
            .Select((g, i) => (
                Key:    g.CodeValue ?? "",
                Letter: ((char)('A' + i)).ToString(),
                Ko:     g.CodeName   ?? g.CodeValue ?? "",
                En:     g.CodeNameEn ?? g.CodeName ?? g.CodeValue ?? "",
                Items:  mdItems.Where(x => x.Sub == g.CodeValue).ToList()))
            .Where(g => g.Items.Count > 0)
            .ToList();

    List<NavItem> UngroupedMd(List<NavItem> mdItems)
    {
        var keys = _subprocessItems.Select(g => g.CodeValue).ToHashSet();
        return mdItems.Where(x => string.IsNullOrEmpty(x.Sub) || !keys.Contains(x.Sub)).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        _url  = Nav.ToBaseRelativePath(Nav.Uri);

        LoadItems();

        if (AuthState is not null)
        {
            try { await Perm.EnsureAsync(AuthState); }
            catch { /* 권한 로딩 실패 — GetLevel 미초기화 시 전부 허용 */ }
        }

        OpenCurrentSection();
        Nav.LocationChanged += OnLocChanged;
    }

    void LoadItems()
    {
        try
        {
            var rows = Sys.ListScreens("WEB")
                .Where(s => !string.IsNullOrEmpty(s.ProcessCode) && !string.IsNullOrEmpty(s.HRef))
                .OrderBy(s => s.SortOrder ?? 999).ThenBy(s => s.ScreenCode)
                .Select(s => new NavItem(
                    s.ProcessCode!.ToLowerInvariant(),
                    s.HRef!.TrimStart('/'),
                    s.LidLabel ?? s.ScreenCode,
                    s.ScreenName,
                    s.ScreenNameEn ?? s.ScreenName,
                    s.SubProcessCode))
                .ToList();

            if (rows.Count > 0)
            {
                _items = rows;
                _usingFallback = false;
                try { _subprocessItems = MD.ListCodeItems("SUBPROCESS"); }
                catch { /* 서브그룹 정의 실패 시 MD 플랫 표시 */ }
                return;
            }
        }
        catch { /* fall through to fallback */ }

        _items = _fallbackItems.ToList();
        _usingFallback = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var favJson = await JS.InvokeAsync<string?>("localStorage.getItem", KeyFavorites);
            if (!string.IsNullOrWhiteSpace(favJson))
                _favorites = JsonSerializer.Deserialize<HashSet<string>>(favJson) ?? new();

            var collapsed = await JS.InvokeAsync<string?>("localStorage.getItem", KeyCollapsed);
            if (collapsed is not null) _collapsed = collapsed == "1";

            var favOpen = await JS.InvokeAsync<string?>("localStorage.getItem", KeyFavOpen);
            if (favOpen is not null) _favOpen = favOpen == "1";

            var openSubJson = await JS.InvokeAsync<string?>("localStorage.getItem", KeyOpenSub);
            if (!string.IsNullOrWhiteSpace(openSubJson))
            {
                var storedSub = JsonSerializer.Deserialize<HashSet<string>>(openSubJson);
                if (storedSub is not null) _openSub.UnionWith(storedSub);
            }

            var openJson = await JS.InvokeAsync<string?>("localStorage.getItem", KeyOpen);
            if (!string.IsNullOrWhiteSpace(openJson))
            {
                var stored = JsonSerializer.Deserialize<HashSet<string>>(openJson);
                if (stored is not null)
                {
                    _open = stored;
                    OpenCurrentSection();   // 저장값 위에 현재 URL 섹션도 열어둠
                }
            }
        }
        catch (JsonException) { /* 손상된 값 무시 — 기본 상태 유지 */ }

        _loaded = true;
        StateHasChanged();
    }

    void OpenCurrentSection()
    {
        var url = _url ?? "";
        foreach (var (prefix, key) in _prefixMap)
            if (url.StartsWith(prefix)) { _open.Add(key); OpenCurrentSub(url); return; }
    }

    // 현재 URL이 속한 MD 서브그룹도 열어둠
    void OpenCurrentSub(string url)
    {
        var hit = _items.FirstOrDefault(i =>
            url.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(hit?.Sub)) _openSub.Add(hit!.Sub!);
    }

    void OnLocChanged(object? sender, LocationChangedEventArgs e)
    {
        _url = Nav.ToBaseRelativePath(e.Location);
        foreach (var (prefix, key) in _prefixMap)
            if (_url.StartsWith(prefix)) { _open.Add(key); OpenCurrentSub(_url); break; }
        _ = PersistOpen();
        StateHasChanged();
    }

    void Toggle(string key)
    {
        if (!_open.Remove(key)) _open.Add(key);   // 다중-오픈: 다른 섹션 유지
        _ = PersistOpen();
    }

    void ToggleSub(string key)
    {
        if (!_openSub.Remove(key)) _openSub.Add(key);
        _ = PersistOpenSub();
    }

    void ToggleFav()
    {
        _favOpen = !_favOpen;
        _ = PersistFavOpen();
    }

    bool   IsOpen(string key)    => _open.Contains(key);
    bool   IsSubOpen(string key) => _openSub.Contains(key);
    string Chev(string key)      => _open.Contains(key) ? "▾" : "▸";

    Task PersistOpen()      => Save(KeyOpen, JsonSerializer.Serialize(_open));
    Task PersistOpenSub()   => Save(KeyOpenSub, JsonSerializer.Serialize(_openSub));
    Task PersistFavorites() => Save(KeyFavorites, JsonSerializer.Serialize(_favorites));
    Task PersistCollapsed() => Save(KeyCollapsed, _collapsed ? "1" : "0");
    Task PersistFavOpen()   => Save(KeyFavOpen, _favOpen ? "1" : "0");

    async Task Save(string key, string value)
    {
        if (!_loaded) return;   // 초기 복원 전엔 기본값으로 덮어쓰지 않음
        try { await JS.InvokeVoidAsync("localStorage.setItem", key, value); }
        catch (JSException) { /* 프리렌더/연결 끊김 무시 */ }
    }

    // Section header: single language (no secondary)
    string SL(string ko, string en) => _lang == "en" ? en : ko;

    // Nav link label: primary (big) + secondary (small gray)
    MarkupString NL(string ko, string en)
    {
        var (p, s) = _lang == "en" ? (en, ko) : (ko, en);
        return new MarkupString(
            $"{WebUtility.HtmlEncode(p)}<span style=\"display:block;font-size:.72em;color:#94a3b8;font-weight:400;line-height:1.2;\">{WebUtility.HtmlEncode(s)}</span>");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocChanged;
}
