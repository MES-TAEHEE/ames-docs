@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager Nav
@inject PageHeaderState Header
@inject AMES.Web.Services.AppLanguageState Lang
@inject IJSRuntime JS

<header class="ames-topbar">
    <div class="ames-brand">
        <div class="ames-brand-row">
            <span class="ames-brand-mark">⬢</span>
            <div style="display:flex;align-items:baseline;gap:10px;">
                <div class="ames-brand-logo">A-MES</div>
                <div class="ames-brand-sub">OFFICE WEB</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Header.Code) || !string.IsNullOrEmpty(Header.Title))
    {
        <div class="ames-topbar-loc">
            @if (!string.IsNullOrEmpty(Header.Code))
            {
                <span class="ames-loc-code">@Header.Code</span>
            }
            <span class="ames-loc-name">@Header.Title</span>
        </div>
    }

    <div class="ames-topbar-spacer"></div>

    <button class="ames-theme-toggle" @onclick="ToggleTheme"
            title="@(_theme == "light" ? "다크 테마" : "라이트 테마")"
            aria-label="Toggle theme">@(_theme == "light" ? "🌙" : "☀")</button>

    @* LANGUAGE_DEFAULT 비활성 시 언어 선택 숨김(앱은 en-US 강제) *@
    @if (Lang.SwitcherVisible)
    {
        <CultureSwitcher />
    }

    <AuthorizeView>
        <Authorized>
            <div class="ames-user">
                <div class="ames-user-av">@(context.User.Identity?.Name?.Substring(0,1).ToUpper() ?? "?")</div>
                <div class="ames-user-info">
                    <div class="ames-user-name">@context.User.Identity?.Name</div>
                    <div class="ames-user-role">Administrator</div>
                </div>
                <form action="Account/Logout" method="post" style="display:inline;">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@_url" />
                    <button type="submit" class="ames-user-out" title="Sign out">⏻</button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="ames-user dim">
                <div class="ames-user-av">?</div>
                <div class="ames-user-info"><div class="ames-user-name">Not signed in</div></div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</header>

@code {
    string? _url;
    string _theme = "dark";

    protected override void OnInitialized()
    {
        _url = Nav.ToBaseRelativePath(Nav.Uri);
        Header.OnChanged += OnHeaderChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _theme = await JS.InvokeAsync<string>("amesTheme.get"); StateHasChanged(); }
        catch { /* 프리렌더/연결 끊김 무시 */ }
    }

    async Task ToggleTheme()
    {
        try { _theme = await JS.InvokeAsync<string>("amesTheme.toggle"); }
        catch { }
    }

    void OnHeaderChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Header.OnChanged -= OnHeaderChanged;
}
