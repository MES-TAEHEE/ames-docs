@implements IDisposable
@inject NavigationManager Nav
@* 내부 화면 ↔ 외부 개방 화면(/portal) 사이를 옮길 때는 전체 새로고침으로 연다(11-19 D).
   두 영역은 실시간 연결 경로(/_blazor · /portal/_blazor)와 인증 쿠키가 달라, 한 연결 안에서 넘어가면
   다른 쪽 사용자로 화면이 그려진다. 같은 영역 안의 이동은 그대로 연결 안에서 처리한다. 정적 렌더 화면에서는 하는 일이 없다. *@

@code {
    IDisposable? _registration;
    bool _forcing;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _registration = Nav.RegisterLocationChangingHandler(ctx =>
        {
            if (_forcing) return ValueTask.CompletedTask;
            var target = Nav.ToAbsoluteUri(ctx.TargetLocation);
            if (IsPortal(new Uri(Nav.Uri)) != IsPortal(target))
            {
                _forcing = true;
                ctx.PreventNavigation();
                Nav.NavigateTo(target.ToString(), forceLoad: true);
            }
            return ValueTask.CompletedTask;
        });
    }

    static bool IsPortal(Uri uri) => AMES.Web.Services.PortalAuth.IsPortalPath(new PathString(uri.AbsolutePath));

    public void Dispose() => _registration?.Dispose();
}
