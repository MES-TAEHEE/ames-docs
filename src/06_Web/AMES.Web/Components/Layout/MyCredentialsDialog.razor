@using AMES.Data.Security
@inject UserManager<ApplicationUser> UserMgr
@inject AuthRepository AuthRepo
@inject SysRepository Sys
@inject AuditLogger Audit
@inject SignInRefreshTickets Tickets
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthPrvd
@inject IStringLocalizer<SharedResources> L

@*  상단바 「비밀번호·PIN 변경」(10-07) — 로그인한 본인 것만. 둘 다 현재 비밀번호로 본인을 다시 확인하며,
    틀린 횟수는 로그인 실패와 같은 계정 카운터에 쌓인다(5회면 LOCKED, Admin 해제).
    비밀번호를 바꾸면 보안 스탬프가 바뀌므로 1회용 표로 /Account/RefreshSignIn 에 가서 새 쿠키를 받는다(다른 PC 의 로그인은 재확인 주기 안에 끊긴다). *@

@if (Visible)
{
    <div class="ames-modal-bg" @onmousedown="() => _bgDown = true" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:460px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["TopBar.Cred.Title"] <span class="dim" style="font-weight:400;font-size:.85em;text-transform:none;">@_email</span></div>

            <RadzenSelectBar TValue="string" @bind-Value="_tab" Change="@((string _) => ResetMessages())" Size="ButtonSize.Small">
                <Items>
                    <RadzenSelectBarItem Value="@("pwd")" Text="@L["TopBar.Cred.Tab.Password"]" />
                    <RadzenSelectBarItem Value="@("pin")" Text="@L["TopBar.Cred.Tab.Pin"]" />
                </Items>
            </RadzenSelectBar>

            @* 브라우저 자동완성이 다른 계정 값을 채우지 않게 하는 더미 필드 *@
            <input type="text" style="display:none" autocomplete="username" />

            <RadzenStack Orientation="Orientation.Vertical" Gap="0.8rem" Style="width:100%;margin-top:6px;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["TopBar.Cred.Lbl.Current"]" class="ames-rz-modal-label" Component="CredCurrent" />
                    <RadzenPassword Name="CredCurrent" @bind-Value="_current" AutoCompleteType="AutoCompleteType.CurrentPassword" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
                @if (_tab == "pwd")
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                        <RadzenLabel Text="@L["TopBar.Cred.Lbl.NewPassword"]" class="ames-rz-modal-label" Component="CredNewPwd" />
                        <RadzenPassword Name="CredNewPwd" @bind-Value="_new" AutoCompleteType="AutoCompleteType.NewPassword" class="ames-rz-input" Style="flex:1;width:100%;" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                        <RadzenLabel Text="@L["TopBar.Cred.Lbl.ConfirmPassword"]" class="ames-rz-modal-label" Component="CredConfirmPwd" />
                        <RadzenPassword Name="CredConfirmPwd" @bind-Value="_confirm" AutoCompleteType="AutoCompleteType.NewPassword" class="ames-rz-input" Style="flex:1;width:100%;" />
                    </RadzenStack>
                    <span class="dim" style="font-size:.85em;">ⓘ @L["TopBar.Cred.Hint.Password"]</span>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                        <RadzenLabel Text="@L["TopBar.Cred.Lbl.NewPin"]" class="ames-rz-modal-label" Component="CredNewPin" />
                        <RadzenPassword Name="CredNewPin" @bind-Value="_new" MaxLength="4" inputmode="numeric" AutoCompleteType="AutoCompleteType.Off" class="ames-rz-input" Style="flex:1;width:100%;" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                        <RadzenLabel Text="@L["TopBar.Cred.Lbl.ConfirmPin"]" class="ames-rz-modal-label" Component="CredConfirmPin" />
                        <RadzenPassword Name="CredConfirmPin" @bind-Value="_confirm" MaxLength="4" inputmode="numeric" AutoCompleteType="AutoCompleteType.Off" class="ames-rz-input" Style="flex:1;width:100%;" />
                    </RadzenStack>
                    <span class="dim" style="font-size:.85em;">ⓘ @L["TopBar.Cred.Hint.Pin"]</span>
                }
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_err))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_err</RadzenAlert>
            }
            @if (!string.IsNullOrEmpty(_ok))
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false">@_ok</RadzenAlert>
            }

            <div class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@Save" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Close"]" Click="@Close" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    string _tab = "pwd";
    string _current = "", _new = "", _confirm = "";
    string? _err, _ok, _email;
    bool _busy, _bgDown;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && _email is null)
            _email = (await AuthPrvd.GetAuthenticationStateAsync()).User.Identity?.Name;
    }

    void ResetMessages() { _err = null; _ok = null; _current = _new = _confirm = ""; }

    async Task Close()
    {
        ResetMessages();
        _tab = "pwd";
        await OnClose.InvokeAsync();
    }

    async Task OnBgClick()
    {
        if (_bgDown && !_busy) await Close();
        _bgDown = false;
    }

    async Task Save()
    {
        _err = null; _ok = null;
        if (string.IsNullOrEmpty(_current) || string.IsNullOrEmpty(_new) || string.IsNullOrEmpty(_confirm)) { _err = L["TopBar.Cred.Err.Required"]; return; }
        if (_new != _confirm) { _err = L["TopBar.Cred.Err.Mismatch"]; return; }
        if (_tab == "pin" && !(_new.Length == 4 && _new.All(char.IsDigit))) { _err = L["SYS.Users.Err.PinFormat"]; return; }

        _busy = true;
        try
        {
            var principal = (await AuthPrvd.GetAuthenticationStateAsync()).User;
            var user = await UserMgr.GetUserAsync(principal);
            if (user is null) { _err = L["Auth.Err.Inactive"]; return; }
            if (!await VerifyCurrentAsync(user)) return;

            if (_tab == "pin")
            {
                await Task.Run(() => Sys.SetPin(user.Id, PinHasher.Hash(_new), ActorCode.Of(principal, "system")));
                Audit.Log("ACCOUNT", "PIN_SET", "AspNetUsers", user.Email, null, null, note: "self");
                ResetMessages();
                _ok = L["TopBar.Cred.Ok.Pin"];
                return;
            }

            var result = await UserMgr.ChangePasswordAsync(user, _current, _new);
            if (!result.Succeeded) { _err = string.Join(" ", result.Errors.Select(e => e.Description)); return; }
            Audit.Log("ACCOUNT", "PWD_CHANGE", "AspNetUsers", user.Email, null, null, note: "self");
            // 스탬프가 바뀐 기존 쿠키 대신 새 쿠키를 받는다 — 돌아올 곳은 지금 화면
            var back = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"Account/RefreshSignIn?t={Tickets.Issue(user.Id)}&returnUrl={Uri.EscapeDataString(back)}", forceLoad: true);
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _busy = false; }
    }

    // 현재 비밀번호 확인 — 틀리면 로그인 실패 카운터에 더한다(5회면 LOCKED). 이미 잠긴 계정은 바꿀 수 없다
    async Task<bool> VerifyCurrentAsync(ApplicationUser user)
    {
        var (status, _) = await Task.Run(() => AuthRepo.GetProfileStatus(user.Id));
        if (string.Equals(status, "LOCKED", StringComparison.OrdinalIgnoreCase)) { _err = L["Auth.Err.Locked"]; return false; }
        if (await UserMgr.CheckPasswordAsync(user, _current)) return true;
        var locked = await Task.Run(() => AuthRepo.IncrementFailedCount(user.Id));
        _current = "";
        _err = locked ? L["Auth.Err.Locked"] : L["TopBar.Cred.Err.WrongPassword"];
        return false;
    }
}
