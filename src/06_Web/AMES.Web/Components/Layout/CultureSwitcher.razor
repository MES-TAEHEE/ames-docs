@using System.Globalization

<div class="culture-switcher" style="display:flex;gap:4px;align-items:center;padding:6px 12px;">
    <a href="javascript:void(0)"
       onclick="document.cookie='.AspNetCore.Culture=c=ko|uic=ko;path=/;max-age=31536000;SameSite=Lax';location.reload();"
       style="font-size:.78em;text-decoration:none;cursor:pointer;
              color:@(IsCurrent("ko") ? "#38bdf8" : "#94a3b8");
              font-weight:@(IsCurrent("ko") ? "700" : "400");">🇰🇷 한국어</a>
    <span style="color:#475569;font-size:.75em;line-height:1;">|</span>
    <a href="javascript:void(0)"
       onclick="document.cookie='.AspNetCore.Culture=c=en|uic=en;path=/;max-age=31536000;SameSite=Lax';location.reload();"
       style="font-size:.78em;text-decoration:none;cursor:pointer;
              color:@(IsCurrent("en") ? "#38bdf8" : "#94a3b8");
              font-weight:@(IsCurrent("en") ? "700" : "400");">🇺🇸 English</a>
</div>

@code {
    private bool IsCurrent(string code) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == code;
}
