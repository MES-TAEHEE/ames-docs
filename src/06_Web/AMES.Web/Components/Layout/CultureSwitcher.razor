@using System.Globalization
@inject AMES.Data.Repositories.MasterDataRepository MD

<div class="culture-switcher" style="display:flex;gap:4px;align-items:center;padding:6px 12px;">
    @{ var langs = ActiveLanguages(); }
    @for (var i = 0; i < langs.Count; i++)
    {
        var lang = langs[i];
        @if (i > 0)
        {
            <span class="culture-sep">|</span>
        }
        @* 색은 app.css(.culture-switcher a / a.cur)에서 — 라이트 테마가 덮어쓸 수 있게 인라인 색상을 두지 않는다 *@
        <a href="javascript:void(0)" class="@(IsCurrent(lang.Uic) ? "cur" : null)"
           onclick="@($"document.cookie='.AspNetCore.Culture=c={lang.Culture}|uic={lang.Uic};path=/;max-age=31536000;SameSite=Lax';location.reload();")">@lang.Label</a>
    }
</div>

@code {
    record Lang(string Culture, string Uic, string Label);

    // 표기(국기+원어명)는 현재와 동일하게 유지. 노출/순서/활성만 LANGUAGE 공통코드에 따름.
    static readonly Dictionary<string, (string Flag, string Native)> _display = new()
    {
        ["ko"] = ("🇰🇷", "한국어"),
        ["en"] = ("🇺🇸", "English"),
        ["es"] = ("🇪🇸", "Español"),
    };

    List<Lang> ActiveLanguages()
    {
        try
        {
            return MD.ListCodeItems("LANGUAGE")
                .Where(c => c.UseFlag && !string.IsNullOrWhiteSpace(c.CodeValue))
                .OrderBy(c => c.SortOrder ?? 999)
                .Select(c =>
                {
                    var culture = c.CodeValue!;
                    var uic = TwoLetter(culture);
                    var label = _display.TryGetValue(uic, out var d)
                        ? $"{d.Flag} {d.Native}"
                        : (c.CodeName ?? culture);
                    return new Lang(culture, uic, label);
                })
                .ToList();
        }
        catch
        {
            // DB 미가용 시 기존 정적 목록으로 폴백
            return new()
            {
                new("en-US", "en", "🇺🇸 English"),
                new("ko-KR", "ko", "🇰🇷 한국어"),
            };
        }
    }

    static string TwoLetter(string culture)
    {
        var dash = culture.IndexOf('-');
        return (dash > 0 ? culture[..dash] : culture).ToLowerInvariant();
    }

    bool IsCurrent(string uic) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == uic;
}
