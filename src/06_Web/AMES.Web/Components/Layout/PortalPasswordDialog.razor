@inject ScmRepository Scm
@inject UserManager<ApplicationUser> UserMgr
@inject AuditLogger Audit
@inject AuthenticationStateProvider AuthPrvd
@inject SignInRefreshTickets Tickets
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

@*  외부 포탈 상단바 「비밀번호 변경」(10-07) — 로그인한 외부 사용자(SCM_PortalVendorUser) 본인 것만. 외부 사용자에게는 PIN 이 없다.
    현재 비밀번호로 다시 확인하고, 틀리면 로그인 실패와 같은 카운터(5회 잠금, SCM-004 해제)에 쌓인다.
    규칙은 SCM-004 와 같은 Identity 검증기. 바꾸면 비밀번호 버전(PortalAuth.PasswordVersionClaim)이 달라져 다른 PC 의 로그인은 다음 요청에 끊기고, 이 화면은 1회용 표로 /portal/refresh-signin 에서 새 쿠키를 받는다. *@

@if (Visible)
{
    <div class="ames-modal-bg" @onmousedown="() => _bgDown = true" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:460px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["Portal.Cred.Title"] <span class="dim" style="font-weight:400;font-size:.85em;text-transform:none;">@_email</span></div>

            <input type="text" style="display:none" autocomplete="username" />

            <RadzenStack Orientation="Orientation.Vertical" Gap="0.8rem" Style="width:100%;margin-top:6px;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["TopBar.Cred.Lbl.Current"]" class="ames-rz-modal-label" Component="PortalCredCurrent" />
                    <RadzenPassword Name="PortalCredCurrent" @bind-Value="_current" AutoCompleteType="AutoCompleteType.CurrentPassword" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["TopBar.Cred.Lbl.NewPassword"]" class="ames-rz-modal-label" Component="PortalCredNew" />
                    <RadzenPassword Name="PortalCredNew" @bind-Value="_new" AutoCompleteType="AutoCompleteType.NewPassword" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["TopBar.Cred.Lbl.ConfirmPassword"]" class="ames-rz-modal-label" Component="PortalCredConfirm" />
                    <RadzenPassword Name="PortalCredConfirm" @bind-Value="_confirm" AutoCompleteType="AutoCompleteType.NewPassword" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_err))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_err</RadzenAlert>
            }

            <div class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@Save" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Close"]" Click="@Close" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    string _current = "", _new = "", _confirm = "";
    string? _err, _email;
    bool _busy, _bgDown;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && _email is null)
            _email = (await AuthPrvd.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    async Task Close()
    {
        _err = null; _current = _new = _confirm = "";
        await OnClose.InvokeAsync();
    }

    async Task OnBgClick()
    {
        if (_bgDown && !_busy) await Close();
        _bgDown = false;
    }

    async Task Save()
    {
        _err = null;
        if (string.IsNullOrEmpty(_current) || string.IsNullOrEmpty(_new) || string.IsNullOrEmpty(_confirm)) { _err = L["TopBar.Cred.Err.Required"]; return; }
        if (_new != _confirm) { _err = L["TopBar.Cred.Err.Mismatch"]; return; }
        if (string.IsNullOrEmpty(_email)) return;

        _busy = true;
        try
        {
            var user = await Task.Run(() => Scm.FindPortalUser(_email));
            if (user is null || !user.ActiveFlag || !user.VendorActive) { _err = L["Auth.Err.Inactive"]; return; }
            if (user.LockedFlag) { _err = L["Auth.Err.Locked"]; return; }
            if (!PortalAuth.VerifyPassword(user.PasswordHash, _current))
            {
                var locked = await Task.Run(() => Scm.RecordPortalLoginFailure(user.UserID));
                _current = "";
                _err = locked ? L["Auth.Err.Locked"] : L["TopBar.Cred.Err.WrongPassword"];
                return;
            }

            // 규칙은 내부 사용자·SCM-004 와 같은 Identity 검증기(SYS_Config 최소 길이 포함)
            var probe = new ApplicationUser { UserName = user.UserID, Email = user.UserID };
            foreach (var v in UserMgr.PasswordValidators)
            {
                var r = await v.ValidateAsync(UserMgr, probe, _new);
                if (!r.Succeeded) { _err = string.Join(" ", r.Errors.Select(e => e.Description)); return; }
            }

            var actor = ActorCode.Normalize(user.UserID);
            await Task.Run(() => Scm.ChangePortalPassword(user.UserID, PortalAuth.HashPassword(_new), actor));
            Audit.Log("PORTAL", "PWD_CHANGE", "SCM_PortalVendorUser", user.UserID, null, null, note: "self", actor: actor);
            // 비밀번호 버전이 바뀌어 지금 쿠키도 다음 요청에 끊긴다 — 1회용 표로 새 쿠키를 받고 지금 화면으로 돌아온다(다른 PC 는 끊긴 채)
            var back = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"portal/refresh-signin?t={Tickets.Issue("portal:" + user.UserID)}&returnUrl={Uri.EscapeDataString(back)}", forceLoad: true);
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _busy = false; }
    }
}
