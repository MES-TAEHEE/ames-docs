@inject IStringLocalizer<SharedResources> L
@inherits LayoutComponentBase

@*  Bare-bones layout for the Login / Register / Lockout pages — no side
    nav, no shell. Just paint the page directly. *@

@Body

<div id="blazor-error-ui" data-nosnippet>
    @L["App.Error.Unhandled"]
    <a href="." class="reload">@L["App.Error.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
