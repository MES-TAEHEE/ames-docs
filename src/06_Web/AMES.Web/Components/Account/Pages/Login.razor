@page "/Account/Login"
@layout AMES.Web.Components.Layout.EmptyLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using AMES.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserMgr
@inject AMES.Data.Repositories.AuthRepository AuthRepo
@inject ILogger<Login> Logger
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Auth.Title.SignIn"] · A-MES</PageTitle>

<div class="ames-auth-page">
    <div class="ames-auth-bg-grid"></div>

    <div class="ames-auth-card">
        <div class="ames-auth-brand">
            <div class="ames-auth-logo">A-MES</div>
            <div class="ames-auth-sub">OFFICE WEB · @L["Auth.Sub.SignIn"]</div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="ames-auth-error">✕ @errorMessage</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login"
                  class="ames-auth-form" Enhance="false">
            <DataAnnotationsValidator />

            <label class="ames-auth-label">@L["Auth.Lbl.Email"]</label>
            <InputText @bind-Value="Input.Email" class="ames-auth-input"
                       autocomplete="username" placeholder="admin@ames.local" />
            <ValidationMessage For="() => Input.Email" class="ames-auth-vm" />

            <label class="ames-auth-label">@L["Auth.Lbl.Password"]</label>
            <InputText type="password" @bind-Value="Input.Password" class="ames-auth-input"
                       autocomplete="current-password" placeholder="••••••••" />
            <ValidationMessage For="() => Input.Password" class="ames-auth-vm" />

            <label class="ames-auth-remember">
                <InputCheckbox @bind-Value="Input.RememberMe" />
                <span>@L["Auth.Remember"]</span>
            </label>

            <button type="submit" class="ames-auth-submit">@L["Auth.Btn.SignIn"]  →</button>
        </EditForm>

        <div class="ames-auth-hint">
            @L["Auth.DevAccount"]: <code>admin@ames.local</code> / <code>Dev2026!</code>
        </div>

        <div class="ames-auth-meta">
            <a href="Account/ForgotPassword">@L["Auth.ForgotLink"]</a>
            <span>·</span>
            <a href="/Account/Register@(string.IsNullOrEmpty(ReturnUrl) ? "" : $"?ReturnUrl={Uri.EscapeDataString(ReturnUrl)}")">@L["Auth.RegisterLink"]</a>
        </div>
    </div>

    <div class="ames-auth-foot">A-MES · EOS · 2026</div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private InputModel _input = new();
    [SupplyParameterFromForm]
    private InputModel Input { get => _input; set => _input = value ?? new(); }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private const string RememberCookie = "ames_remember";
    private const string LoginIdCookie  = "ames_login_id";

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);

            // Restore the user's last RememberMe preference
            if (HttpContext.Request.Cookies.TryGetValue(RememberCookie, out var pref))
                Input.RememberMe = pref == "1";

            // Remember 를 켠 브라우저에는 마지막 로그인 ID 를 다시 채워 준다
            if (Input.RememberMe && HttpContext.Request.Cookies.TryGetValue(LoginIdCookie, out var lastId) && !string.IsNullOrWhiteSpace(lastId))
                Input.Email = lastId;
        }
    }

    public async Task LoginUser()
    {
        // Pre-check: if account is LOCKED in SYS_UserProfile, reject before attempting sign-in.
        var identityUser = await UserMgr.FindByEmailAsync(Input.Email);
        if (identityUser is not null)
        {
            // 외부 사용자(ExternalCustomer)는 내부 화면에 들어올 수 없다 — 외부 로그인(/portal/login)만 허용
            if (await UserMgr.IsInRoleAsync(identityUser, AMES.Web.Services.PortalAuth.Role))
            {
                errorMessage = L["Auth.Err.PortalOnly"];
                return;
            }
            var (accountStatus, _) = AuthRepo.GetProfileStatus(identityUser.Id);
            if (string.Equals(accountStatus, "LOCKED", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = L["Auth.Err.Locked"];
                return;
            }
            // ① 이메일 자기인증 완료 여부
            if (!identityUser.EmailConfirmed)
            {
                errorMessage = L["Auth.Err.EmailNotConfirmed"];
                return;
            }
            // ② 관리자 승인(ACTIVE) 여부. 프로필 없음=Active 취급, 자기가입 직후 PENDING 은 승인 대기.
            if (!string.Equals(accountStatus, "ACTIVE", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = L["Auth.Err.Pending"];
                return;
            }
        }

        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");

            if (identityUser is not null)
                AuthRepo.RecordSuccessfulLogin(identityUser.Id);

            // 같은 브라우저에 외부 포탈 쿠키가 남아 있으면 지운다(스킴 선택이 외부 쿠키 존재 여부로 갈린다)
            HttpContext.Response.Cookies.Delete(AMES.Web.Services.PortalAuth.CookieName);

            // Persist RememberMe choice for next visit
            HttpContext.Response.Cookies.Append(RememberCookie, Input.RememberMe ? "1" : "0",
                new CookieOptions
                {
                    Expires  = DateTimeOffset.UtcNow.AddYears(1),
                    IsEssential = true,
                    SameSite = SameSiteMode.Lax,
                });

            // ID 는 Remember 를 켰을 때만 남기고, 끄고 로그인하면 지운다(공용 PC)
            if (Input.RememberMe)
                HttpContext.Response.Cookies.Append(LoginIdCookie, Input.Email.Trim(),
                    new CookieOptions
                    {
                        Expires     = DateTimeOffset.UtcNow.AddYears(1),
                        IsEssential = true,
                        HttpOnly    = true,
                        SameSite    = SameSiteMode.Lax,
                    });
            else
                HttpContext.Response.Cookies.Delete(LoginIdCookie);

            var target = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
            if (!Uri.IsWellFormedUriString(target, UriKind.Relative))
                target = "/";

            HttpContext.Response.Redirect(target);
        }
        else if (result.RequiresTwoFactor)
        {
            var qs = $"?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "")}&rememberMe={Input.RememberMe.ToString().ToLower()}";
            HttpContext.Response.Redirect($"/Account/LoginWith2fa{qs}");
        }
        else if (result.IsLockedOut)
            HttpContext.Response.Redirect("/Account/Lockout");
        else if (result.IsNotAllowed)
            errorMessage = L["Auth.Err.EmailNotConfirmed"];
        else
        {
            // Increment domain failed counter; lock account on the 5th failure.
            if (identityUser is not null)
            {
                var isNowLocked = AuthRepo.IncrementFailedCount(identityUser.Id);
                if (isNowLocked)
                {
                    errorMessage = L["Auth.Err.LockedAfter5"];
                    return;
                }
            }
            errorMessage = L["Auth.Err.Invalid"];
        }
    }

    private sealed class InputModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required, DataType(DataType.Password)] public string Password { get; set; } = "";
        [Display(Name = "Remember me?")] public bool RememberMe { get; set; }
    }
}
