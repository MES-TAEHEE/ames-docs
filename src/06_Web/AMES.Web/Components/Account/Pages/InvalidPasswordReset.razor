@page "/Account/InvalidPasswordReset"
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Auth.Title.Reset"] · A-MES</PageTitle>

<AuthCard Sub="@L["Auth.Sub.ResetPassword"].Value">
    <div class="ames-auth-error">✕ @L["Auth.Reset.InvalidLink"]</div>
    <div class="ames-auth-meta">
        <a href="/Account/ForgotPassword">@L["Auth.Reset.RequestAgain"]</a>
        <span>·</span>
        <a href="/Account/Login">← @L["Auth.GoSignIn"]</a>
    </div>
</AuthCard>
