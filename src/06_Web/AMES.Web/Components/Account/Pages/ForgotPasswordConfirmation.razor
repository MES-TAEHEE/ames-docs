@page "/Account/ForgotPasswordConfirmation"
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Auth.Title.Forgot"] · A-MES</PageTitle>

<AuthCard Sub="@L["Auth.Sub.ResetPassword"].Value">
    <div class="ames-auth-hint" style="text-align:center;line-height:1.9;">
        @L["Auth.Forgot.CheckMail"]
    </div>
    <div class="ames-auth-meta">
        <a href="/Account/Login">← @L["Auth.BackToSignIn"]</a>
    </div>
</AuthCard>
