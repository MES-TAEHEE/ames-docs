@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using AMES.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject AMES.Data.Repositories.SysRepository Sys
@inject AMES.Web.Services.AuditLogger Audit
@inject IStringLocalizer<SharedResources> L
@inject AMES.Web.Services.AccountMail Mail

<PageTitle>@L["Auth.Title.Register"] · A-MES</PageTitle>

<div class="ames-auth-page">
    <div class="ames-auth-bg-grid"></div>

    <div class="ames-auth-card">
        <div class="ames-auth-brand">
            <div class="ames-auth-logo">A-MES</div>
            <div class="ames-auth-sub">OFFICE WEB · @L["Auth.Sub.Register"]</div>
        </div>

        @if (_registered)
        {
            <div class="ames-auth-hint" style="line-height:1.9;text-align:center;">
                ✅ @L["Auth.Register.Accepted"]<br />
                @((MarkupString)L["Auth.Register.Steps"].Value)
            </div>
            @if (_confirmLink is not null)
            {
                <a class="ames-auth-submit" href="@_confirmLink"
                   style="display:block;text-align:center;text-decoration:none;margin-top:12px;">@L["Auth.Btn.ConfirmEmail"]  →</a>
                <div class="ames-auth-vm" style="margin-top:6px;text-align:center;">@L["Auth.Register.DevHint"]</div>
            }
            else if (Mail.AdminConfirmsEmail)
            {
                <div class="ames-auth-hint" style="margin-top:10px;text-align:center;line-height:1.8;">@L["Auth.Register.AdminConfirm"]</div>
            }
            else
            {
                <div class="ames-auth-hint" style="margin-top:10px;text-align:center;">@L["Auth.CheckMailbox"]</div>
            }
            <div class="ames-auth-meta">
                <a href="/Account/Login">← @L["Auth.BackToSignIn"]</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="ames-auth-error">✕ @Message</div>
            }

            <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register"
                      class="ames-auth-form" Enhance="false">
                <DataAnnotationsValidator />

                <label class="ames-auth-label">@L["Auth.Lbl.Email"]</label>
                <InputText @bind-Value="Input.Email" class="ames-auth-input"
                           autocomplete="username" placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" class="ames-auth-vm" />

                <label class="ames-auth-label">@L["Auth.Lbl.Password"]</label>
                <InputText type="password" @bind-Value="Input.Password" class="ames-auth-input"
                           autocomplete="new-password" placeholder="••••••••" />
                <ValidationMessage For="() => Input.Password" class="ames-auth-vm" />

                <label class="ames-auth-label">@L["Auth.Lbl.ConfirmPassword"]</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="ames-auth-input"
                           autocomplete="new-password" placeholder="••••••••" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="ames-auth-vm" />

                <button type="submit" class="ames-auth-submit">@L["Auth.Btn.CreateAccount"]  →</button>
            </EditForm>

            <div class="ames-auth-meta">
                <a href="/Account/Login">← @L["Auth.BackToSignIn"]</a>
            </div>
        }
    </div>

    <div class="ames-auth-foot">A-MES · EOS · 2026</div>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private bool _registered;      // 가입 접수(이메일 인증+관리자 승인 대기) 화면 표시
    private string? _confirmLink;  // 메일을 못 보내는 개발 환경에서만 화면에 노출할 이메일 인증 링크

    private InputModel _input = new();
    [SupplyParameterFromForm]
    private InputModel Input { get => _input; set => _input = value ?? new(); }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    public async Task RegisterUser(EditContext editContext)
    {
        var user = CreateUser();

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User registered (email verification + admin approval required).");

        var userId = await UserManager.GetUserIdAsync(user);
        // 관리자 승인 전까지 승인대기(PENDING) 프로필 생성 — 자동 로그인하지 않음.
        // CreatedBy(varchar 20)는 사번이 없어 이메일 @ 앞 ID 를 임시로 넣고, 관리자 승인 때 사번으로 바뀐다(SysRepository.UpdateProfile).
        // 프로필을 만들지 못하면 방금 만든 계정을 지워 가입 자체를 실패시킨다(같은 이메일로 다시 가입할 수 있게).
        // 삭제까지 실패해도 그 계정은 프로필이 없어 로그인이 거부되고(승인 대기) SYS-001 에 "프로필 없음"으로 보인다.
        try
        {
            var email = Input.Email.Trim();
            Sys.CreatePendingProfile(userId, email.Length > 50 ? email[..50] : email, AMES.Web.Services.ActorCode.Normalize(email));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Pending profile creation failed for {UserId}; registration rolled back", userId);
            try
            {
                var del = await UserManager.DeleteAsync(user);
                if (!del.Succeeded)
                    Logger.LogError("Rollback delete failed for {UserId}: {Errs}", userId, string.Join("; ", del.Errors.Select(e => e.Description)));
            }
            catch (Exception delEx) { Logger.LogError(delEx, "Rollback delete failed for {UserId}", userId); }
            identityErrors = [new IdentityError { Description = L["Auth.Err.RegisterFailed"] }];
            return;
        }

        // 이메일 자기인증 링크 생성·발송 (개발환경은 NoOp 발신자 → 화면에 링크 노출)
        Audit.Log("ACCOUNT", "CREATE", "AspNetUsers", Input.Email, null, new { Input.Email, SelfRegistered = true }, actor: Input.Email);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });
        await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        _confirmLink = Mail.ShowLinkOnScreen ? callbackUrl : null;
        _registered  = true;
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        [StringLength(256, ErrorMessage = "The {0} must be at most {1} characters long.")]   // AspNetUsers.Email·UserName nvarchar(256) — 넘으면 계정 생성이 DB 오류로 끝난다
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required]
        // 최소 길이는 SYS_Config(PASSWORD_MIN_LEN) 기준 서버 검증(ConfigPasswordValidator)이 관장
        [StringLength(100, ErrorMessage = "The {0} must be at most {1} characters long.")]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
