@page "/Account/Lockout"
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Auth.Title.Lockout"] · A-MES</PageTitle>

<AuthCard Sub="@L["Auth.Sub.Lockout"].Value">
    <div class="ames-auth-error">✕ @L["Auth.Lockout.Msg"]</div>
    <div class="ames-auth-meta">
        <a href="/Account/Login">← @L["Auth.BackToSignIn"]</a>
    </div>
</AuthCard>
