@page "/Account/AccessDenied"
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Auth.Title.AccessDenied"] · A-MES</PageTitle>

<AuthCard Sub="@L["Auth.Sub.AccessDenied"].Value">
    <div class="ames-auth-error">✕ @L["Auth.AccessDenied.Msg"]</div>
    <div class="ames-auth-meta">
        <a href="/">← @L["Auth.GoHome"]</a>
        <span>·</span>
        <a href="/Account/Login">@L["Auth.GoSignIn"]</a>
    </div>
</AuthCard>
