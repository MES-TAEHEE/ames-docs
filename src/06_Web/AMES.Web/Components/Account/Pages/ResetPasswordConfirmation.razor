@page "/Account/ResetPasswordConfirmation"
@inject IStringLocalizer<SharedResources> L
<PageTitle>@L["Auth.Title.Reset"] · A-MES</PageTitle>

<AuthCard Sub="@L["Auth.Sub.ResetPassword"].Value">
    <div class="ames-auth-hint" style="text-align:center;line-height:1.9;">
        ✅ @L["Auth.Reset.Done"]
    </div>
    <div class="ames-auth-meta">
        <a href="/Account/Login">@L["Auth.GoSignIn"] →</a>
    </div>
</AuthCard>
