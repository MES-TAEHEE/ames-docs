@page "/Account/InvalidUser"
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Auth.Title.InvalidUser"] · A-MES</PageTitle>

<AuthCard Sub="@L["Auth.Sub.InvalidUser"].Value">
    <div class="ames-auth-error">✕ @L["Auth.InvalidUser.Msg"]</div>
    <div class="ames-auth-meta">
        <a href="/Account/Login">← @L["Auth.BackToSignIn"]</a>
    </div>
</AuthCard>
