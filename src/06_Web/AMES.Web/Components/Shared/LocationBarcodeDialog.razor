@inject IJSRuntime JS

<div class="ames-modal-bg location-label-modal-bg" @onclick="CloseAsync">
    <div class="ames-modal location-label-modal" @onclick:stopPropagation>
        <div class="ames-modal-h">Location Barcode</div>

        <div class="location-label-preview">
            <div class="location-label-print-area">
                <div class="location-label-paper">
                    <div class="location-label-caption">AMES LOCATION</div>
                    <div class="location-label-code">@LocationCode</div>
                    @{
                        var barcode = BuildCode128(LocationCode);
                    }
                    <svg class="location-label-barcode" viewBox="0 0 @barcode.Width 76" preserveAspectRatio="none" role="img" aria-label="Location barcode @LocationCode">
                        @foreach (var bar in barcode.Bars)
                        {
                            <rect x="@bar.X" y="0" width="@bar.Width" height="76"></rect>
                        }
                    </svg>
                    <div class="location-label-readable">@LocationCode</div>
                    <div class="location-label-name">@Display(LocationName)</div>
                    <div class="location-label-path">
                        <span>@Display(Warehouse)</span>
                        <span>@Display(Area)</span>
                        <span>@Display(Zone)</span>
                    </div>
                </div>
            </div>
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer location-label-actions">
            <RadzenButton Text="Print" Icon="print" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="PrintAsync" class="ames-rz-btn" />
            <RadzenButton Text="Close" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="CloseAsync" class="ames-rz-btn" />
        </RadzenStack>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string LocationCode { get; set; } = "";
    [Parameter] public string? LocationName { get; set; }
    [Parameter] public string? Warehouse { get; set; }
    [Parameter] public string? Area { get; set; }
    [Parameter] public string? Zone { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task PrintAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private static BarcodeImage BuildCode128(string value)
    {
        value = string.IsNullOrWhiteSpace(value) ? " " : value.Trim();
        var codes = new List<int> { 104 };
        var checksum = 104;
        for (var i = 0; i < value.Length; i++)
        {
            var ch = value[i];
            var code = ch is >= (char)32 and <= (char)126 ? ch - 32 : 0;
            codes.Add(code);
            checksum += code * (i + 1);
        }
        codes.Add(checksum % 103);
        codes.Add(106);

        var bars = new List<BarcodeBar>();
        var x = 10;
        foreach (var code in codes)
        {
            var pattern = Code128Patterns[code];
            var black = true;
            foreach (var c in pattern)
            {
                var width = c - '0';
                if (black)
                    bars.Add(new BarcodeBar(x, width));
                x += width;
                black = !black;
            }
        }
        return new BarcodeImage(bars, x + 10);
    }

    private sealed record BarcodeBar(int X, int Width);
    private sealed record BarcodeImage(IReadOnlyList<BarcodeBar> Bars, int Width);

    private static readonly string[] Code128Patterns =
    {
        "212222", "222122", "222221", "121223", "121322", "131222", "122213", "122312", "132212", "221213",
        "221312", "231212", "112232", "122132", "122231", "113222", "123122", "123221", "223211", "221132",
        "221231", "213212", "223112", "312131", "311222", "321122", "321221", "312212", "322112", "322211",
        "212123", "212321", "232121", "111323", "131123", "131321", "112313", "132113", "132311", "211313",
        "231113", "231311", "112133", "112331", "132131", "113123", "113321", "133121", "313121", "211331",
        "231131", "213113", "213311", "213131", "311123", "311321", "331121", "312113", "312311", "332111",
        "314111", "221411", "431111", "111224", "111422", "121124", "121421", "141122", "141221", "112214",
        "112412", "122114", "122411", "142112", "142211", "241211", "221114", "413111", "241112", "134111",
        "111242", "121142", "121241", "114212", "124112", "124211", "411212", "421112", "421211", "212141",
        "214121", "412121", "111143", "111341", "131141", "114113", "114311", "411113", "411311", "113141",
        "114131", "311141", "411131", "211412", "211214", "211232", "2331112"
    };
}
