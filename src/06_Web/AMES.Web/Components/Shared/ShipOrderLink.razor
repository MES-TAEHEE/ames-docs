@* 출하 오더 번호 링크 — 누르면 출하 오더 팝업(Fg/ShippingOrderDialog)을 연다. 사용: <ShipOrderLink OrderNo="@o.OrderNo" /> *@
@inject DialogService Dialog

@if (string.IsNullOrWhiteSpace(OrderNo))
{
    <span class="dim">—</span>
}
else
{
    <a href="javascript:void(0)" class="code wo-link" @onclick="Open" @onclick:stopPropagation="true">@OrderNo</a>
}

@code {
    [Parameter] public string? OrderNo { get; set; }

    /// <summary>팝업에서 오더를 수정·취소해 목록이 바뀌었을 때 알린다(목록 화면이 다시 읽는다).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    async Task Open()
    {
        var res = await Dialog.OpenAsync<AMES.Web.Components.Pages.Fg.ShippingOrderDialog>(OrderNo!, new Dictionary<string, object?> { ["OrderNo"] = OrderNo },
               new DialogOptions { Width = "65vw", Height = "auto", Resizable = true, CloseDialogOnOverlayClick = true });
        if (res is true) await Changed.InvokeAsync();
    }
}
