@inject IStringLocalizer<SharedResources> L
@inject UomFormat UomFmt
@inject DialogService Dialog
@inject IJSRuntime JS

<div class="inventory-lookup">
    @InventoryPanel
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LocationMapStock> Inventory { get; set; } = [];
    [Parameter] public IReadOnlyList<ScmRepository.ItemVendorRow> ItemVendors { get; set; } = [];
    [Parameter] public IReadOnlyList<MasterDataRepository.CodeItemRow> ItemCodes { get; set; } = [];
    [Parameter] public string SearchId { get; set; } = "inventory-search";
    [Parameter] public bool FinishedGoodsOnly { get; set; }
    [Parameter] public EventCallback InventoryChanged { get; set; }
    private string _query = "", _filter = "", _warehouse = "", _area = "";
    private string? _vendor, _category;
    private int _pageRows = 25;
    private bool IsFinishedGoods => FinishedGoodsOnly;
    private readonly IEnumerable<int> _pageSizeOptions = new[] { 25, 50, 100 };
    private sealed record FilterOption(string Code, string Name);
    private IEnumerable<LocationMapStock> ViewStock => Inventory.Where(x => InventorySearchRows.IsSemiFinished(x.ItemType) == IsFinishedGoods);
    private List<InventorySearchRows.LotRow> LotRows = [];
    private List<FilterOption> WarehouseOptions => ViewStock.Where(x => !string.IsNullOrWhiteSpace(x.WarehouseCode))
        .GroupBy(x => x.WarehouseCode, StringComparer.OrdinalIgnoreCase)
        .Select(g => new FilterOption(g.Key, Text(g.First().WarehouseName))).OrderBy(x => x.Name).ToList();
    private List<FilterOption> AreaOptions => ViewStock.Where(x => string.IsNullOrEmpty(_warehouse) || Same(x.WarehouseCode, _warehouse))
        .Where(x => !string.IsNullOrWhiteSpace(x.AreaCode)).GroupBy(x => x.AreaCode, StringComparer.OrdinalIgnoreCase)
        .Select(g => new FilterOption(g.Key, Text(g.First().AreaName))).OrderBy(x => x.Name).ToList();
    private List<FilterOption> VendorOptions => ItemVendors.Select(x => x.VendorID)
        .Concat(ViewStock.Select(x => x.VendorCode ?? "")).Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).Select(x => new FilterOption(x, x)).ToList();
    private List<FilterOption> CategoryOptions => CodeOptions(ViewStock.Select(x => x.ItemCategory), "ITEM_CATEGORY");
    private List<FilterOption> CodeOptions(IEnumerable<string> values, string group) => values.Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase).Select(code => new FilterOption(code, CodeName(group, code))).OrderBy(x => x.Name).ToList();
    private string CodeName(string group, string code) => ItemCodes.FirstOrDefault(x => x.GroupCode == group && Same(x.CodeValue, code)) is {} item
        ? MasterDataRepository.LocalName(item) : Text(code);

    private RenderFragment InventoryPanel => @<div class="inventory-panel">
        <div class="ames-kpis">
            <div class="ames-kpi"><div class="ames-kpi-l">@L["WH.Inventory.Kpi.Parts"]</div><div class="ames-kpi-v">@LotRows.Select(x => x.PartNo).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div></div>
            <div class="ames-kpi ok"><div class="ames-kpi-l">Stored · @L["Col.Lots"]</div><div class="ames-kpi-v">@LotRows.Count(x => !x.IsFloor)</div></div>
            <div class="ames-kpi bad"><div class="ames-kpi-l inventory-floor">Floor · @L["Col.Lots"]</div><div class="ames-kpi-v inventory-floor">@LotRows.Count(x => x.IsFloor)</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Col.Locations"]</div><div class="ames-kpi-v">@LotRows.Where(x => !x.IsFloor).Select(x => x.LocationNo).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div></div>
        </div>
        <section class="ames-card">
            <div class="ames-card-h master-list-toolbar">
                <span>@L[IsFinishedGoods ? "FG.Inventory.Title" : "WH.Inventory.Title"] · @LotRows.Count @L["Lbl.Items"]</span>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <AmesSearchBox @bind-Value="_query" Placeholder='@L["WH.Inventory.Ph.Search"]' Search="Search" />
                <RadzenLabel Text='@L["Col.Warehouse"].Value' Component="InventoryWarehouse" />
                    <RadzenDropDown Name="InventoryWarehouse" Value="@_warehouse" Change="ChangeWarehouse" Data="@WarehouseOptions" TextProperty="Name" ValueProperty="Code" AllowClear="true" Placeholder='@L["Filter.All"].Value' InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" />
                    <RadzenLabel Text='@L["Col.Area"].Value' Component="InventoryArea" />
                    <RadzenDropDown Name="InventoryArea" @bind-Value="_area" @bind-Value:after="ApplyFilter" Data="@AreaOptions" TextProperty="Name" ValueProperty="Code" AllowClear="true" Placeholder='@L["Filter.All"].Value' InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" />
                    <RadzenLabel Text='@L["Col.VendorId"].Value' Component="InventoryVendor" />
                    <RadzenDropDown Name="InventoryVendor" @bind-Value="_vendor" @bind-Value:after="ApplyFilter" Data="@VendorOptions" TextProperty="Name" ValueProperty="Code" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder='@L["Filter.All"].Value' InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
                    <RadzenLabel Text='@L["Col.Category"].Value' Component="InventoryCategory" />
                    <RadzenDropDown Name="InventoryCategory" @bind-Value="_category" @bind-Value:after="ApplyFilter" Data="@CategoryOptions" TextProperty="Name" ValueProperty="Code" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder='@L["Filter.All"].Value' InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />

                    <RadzenButton Text='@L["Btn.Refresh"].Value' Icon="refresh" Click="Refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text='@L["WH.Inventory.Export"].Value' Icon="download" Click="ExportXlsx" Disabled="@(LotRows.Count == 0)" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            </div>
        </section>
        @LotGrid
    </div>;

    private RenderFragment LotGrid => @<section class="ames-card inventory-summary-panel">
        <RadzenDataGrid AllowColumnResize="true" TItem="InventorySearchRows.LotRow" Data="@LotRows"
                        AllowPaging="true" PageSize="25" PageSizeOptions="@_pageSizeOptions" PagerHorizontalAlign="HorizontalAlign.Center"
                        ShowPagingSummary="true" PagingSummaryFormat='@L["Pager.Summary"]' PageSizeText='@L["Pager.PageSize"]'
                        AllowSorting="true" Density="Density.Compact" EmptyText='@L["WH.Inventory.Empty"].Value'
                        PageSizeChanged="@(s => _pageRows = s)"
                        Style="@($"--ames-page-rows:{_pageRows}")"
                        Class="ames-rz-grid ames-grid-fixed inventory-lot-grid">
            <Columns>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="LocationNo" Title='@L["Col.Location"].Value' Width="140px" MinWidth="80px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="LotNo" Title='@L["Col.LotNo"].Value' Width="240px" MinWidth="110px"><Template Context="r"><span class="code" title="@r.LotNo">@r.LotNo</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="PartNo" Title='@L["Col.ItemNo"].Value' Width="180px" MinWidth="90px" TextAlign="TextAlign.Center"><Template Context="r"><span class="code">@r.PartNo</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="PartName" Title='@L["Col.ItemName"].Value' Width="240px" MinWidth="120px"><Template Context="r"><span title="@r.PartName">@r.PartName</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="ReceivedAt" Title='@L["WH.Inventory.ReceivedAt"].Value' Width="180px" MinWidth="110px"><Template Context="r">@(r.ReceivedAt?.ToString(DateFmt.DateTimeSec) ?? "—")</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="ItemCategory" Title='@L["Col.Category"].Value' Width="110px" MinWidth="70px"><Template Context="r">@CodeName("ITEM_CATEGORY", r.ItemCategory)</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="Unit" Title='@L["Col.Unit"].Value' Width="80px" MinWidth="60px" TextAlign="TextAlign.Center"><Template Context="r">@UomFmt.Sym(r.Unit)</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="StoredQty" Title="Stored" Width="120px" MinWidth="75px" TextAlign="TextAlign.Right"><Template Context="r">@(r.StoredQty > 0 ? UomFmt.Qty(r.StoredQty, r.Unit) : "—")</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="FloorQty" Width="120px" MinWidth="75px" TextAlign="TextAlign.Right"><HeaderTemplate><span class="inventory-floor">Floor</span></HeaderTemplate><Template Context="r"><span class="inventory-floor">@(r.FloorQty > 0 ? UomFmt.Qty(r.FloorQty, r.Unit) : "—")</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventorySearchRows.LotRow" Property="VendorCodes" Title='@L["Col.VendorId"].Value' Width="140px" MinWidth="80px"><Template Context="r"><span class="code" title="@r.VendorCodes">@Text(r.VendorCodes)</span></Template></RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </section>;

    protected override void OnParametersSet() => ApplyFilter();
    private void ApplyFilter()
    {
        var filtered = InventorySearchRows.Filter(ViewStock, ItemVendors,
            _filter, _warehouse, _area, _vendor ?? "", "", _category ?? "");
        LotRows = InventorySearchRows.Lots(filtered, ItemVendors, IsFinishedGoods);
    }
    private void ChangeWarehouse(object? value) { _warehouse = value?.ToString() ?? ""; _area = ""; ApplyFilter(); }
    private void Search() { _filter = _query.Trim(); ApplyFilter(); }
    private Task Refresh() => InventoryChanged.InvokeAsync();
    private async Task ExportXlsx()
    {
        var rows = LotRows;
        if (rows.Count == 0) return;
        if (await Dialog.Confirm(L["WH.Inventory.ExportConfirm", rows.Count], L["WH.Inventory.Export"],
            new ConfirmOptions { OkButtonText = L["Btn.Confirm"], CancelButtonText = L["Btn.Cancel"] }) != true) return;
        var headers = new[] { L["Col.Location"].Value, L["Col.LotNo"].Value, L["Col.ItemNo"].Value, L["Col.ItemName"].Value,
            L["WH.Inventory.ReceivedAt"].Value, L["Col.Category"].Value, L["Col.Unit"].Value, "Stored", "Floor", L["Col.VendorId"].Value };
        var data = rows.Select(row => (IReadOnlyList<object?>)new object?[] { row.LocationNo, row.LotNo, row.PartNo, row.PartName,
            row.ReceivedAt?.ToString(DateFmt.DateTimeSec), CodeName("ITEM_CATEGORY", row.ItemCategory), UomFmt.Sym(row.Unit), row.StoredQty, row.FloorQty, row.VendorCodes });
        var bytes = XlsxWriter.Build(L[IsFinishedGoods ? "FG.Inventory.Title" : "WH.Inventory.Title"], headers, data, 24);
        await JS.InvokeVoidAsync("amesDownload", $"Inventory_{AMES.Data.Services.DbClock.Now:yyyyMMdd_HHmmss}.xlsx", Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
    private static bool Same(string? left, string? right) => string.Equals(left, right, StringComparison.OrdinalIgnoreCase);
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
}
