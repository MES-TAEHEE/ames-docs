@using System.Globalization
@using AMES.Data.Repositories
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L
@inject UomFormat UomFmt
@inject WarehouseRepository Warehouse
@inject AuditLogger Audit
@inject DialogService Dialog
@inject FinishedGoodsRepository FinishedGoodsRepo
@inject PermissionService Permissions
@inject AuthenticationStateProvider Auth

@if (!string.IsNullOrEmpty(_actionError)) { <RadzenAlert AlertStyle="Radzen.AlertStyle.Danger" Variant="Variant.Flat">@_actionError</RadzenAlert> }
<div class="ames-card location-explorer">
    <div class="ames-card-h master-list-toolbar location-navigation-toolbar">
        <nav class="location-navigation-path" aria-label="Location hierarchy">
            @if (_stage == MapStage.Warehouse)
            {
                <span aria-current="page">@L["Col.Warehouse"]</span>
            }
            else
            {
                <RadzenButton Text="@L["Col.Warehouse"]" Icon="warehouse" Click="ShowWarehouses" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenIcon Icon="chevron_right" />
                @if (_stage == MapStage.Area)
                {
                    <span aria-current="page">@_warehouse</span>
                }
                else
                {
                    <RadzenButton Text="@_warehouse" Click="ShowAreas" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenIcon Icon="chevron_right" />
                    @if (_selectingFloor || IsOpenStorage)
                    {
                        <span aria-current="page">@_area</span>
                    }
                    else
                    {
                        <RadzenButton Text="@_area" Click="ShowFloors" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                        <RadzenIcon Icon="chevron_right" />
                        <span aria-current="page">@FloorLabel</span>
                    }
                }
            }
        </nav>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="location-navigation-actions">
            @if (_stage != MapStage.Warehouse)
            {
                <RadzenButton Text="@L["Btn.Back"]" Icon="arrow_back" Click="Back" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            }
            @if (CanEdit && CanAddHierarchy)
            {
                <RadzenButton Text="@(_editing ? "Done" : "Edit")" Icon="@(_editing ? "check" : "edit")" aria-pressed="@_editing" Click="ToggleEdit" ButtonStyle="@(_editing ? ButtonStyle.Primary : ButtonStyle.Base)" Size="ButtonSize.Small" class="ames-rz-btn" />
            }
            <RadzenButton Text="@L["Btn.Refresh"]" Icon="refresh" Click="Refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <div class="location-explorer-workspace selection-only">
        <section class="location-map-pane" aria-label="Location map">
            @if (_stage != MapStage.Map || _selectingFloor)
            {
                <div class="ames-card location-hierarchy-panel location-panel-enter">
                    <div class="ames-card-h master-list-toolbar">
                        <span>@SelectionLabel · @SelectionRows.Count @L["Lbl.Items"]</span>
                        @if (_editing && CanEdit && CanAddHierarchy)
                        {
                            <RadzenButton Text="@($"Add {SelectionKind}")" Icon="add" Click="@(() => OpenDialog(SelectionKind))" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                        }
                    </div>
                    <div @key="SelectionScope" class="location-hierarchy-cards">
                        @foreach (var row in SelectionRows)
                        {
                            <div @key="row.Key" class="location-stage-tile location-hierarchy-tile">
                                <RadzenButton Click="@(() => SelectStageRow(row))" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="location-stage-card" aria-label="@($"{SelectionLabel}: {row.Name}")">
                                    <div class="location-hierarchy-content">
                                        <span>@SelectionLabel</span>
                                        <strong>@row.Name</strong>
                                        <small>@row.LocationCount.ToString("N0") @L["WH.LocMap.Locations"]</small>
                                        <b>@UomFmt.Qty(row.Qty, null) <em>@L["WH.LocMap.Qty"]</em></b>
                                    </div>
                                </RadzenButton>
                            @if (_editing && CanEdit && CanAddHierarchy)
                            {
                                @if ((_stage is MapStage.Warehouse or MapStage.Area) && !_selectingFloor)
                                {
                                    <RadzenButton Icon="edit" Click="@(() => OpenHierarchyName(row))" title="@($"Edit {SelectionKind.ToLowerInvariant()} name")" aria-label="@($"Edit {SelectionKind.ToLowerInvariant()} name: {row.Name}")" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="location-stage-rename ames-rz-btn" />
                                }
                                <RadzenButton Icon="close" Click="@(() => DeleteCard(row.Key))" Disabled="@_saving" aria-label="@($"Delete {SelectionKind} {row.Name}")" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="location-stage-remove ames-rz-btn" />
                            }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_stage == MapStage.Map)
            {
                <div class="location-map-view location-panel-enter">
                    <div class="ames-card-h master-list-toolbar location-grid-toolbar">
                        <span class="location-grid-title">@MapScope · @MapLocations.Count @L["WH.LocMap.Locations"]</span>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            @if (!IsOpenStorage)
                            {
                                <RadzenButton Text="@L["WH.LocMap.ChangeFloor"]" Icon="layers" Click="ShowFloors" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                                @if (CanEdit && _warehouse!="LINE" && LocationMapNaming.FloorNumber(_floor) > 0) { <RadzenButton Text="Edit Grid" Icon="grid_on" Click='() => OpenDialog("Grid")' ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" /> }
                            }
                        </RadzenStack>
                    </div>
                    <div class="location-map-statusbar">
                        <div class="location-map-legend">
                            <span><i class="empty"></i>@L["WH.LocMap.Legend.Empty"]</span>
                            <span><i class="stocked"></i>@L["WH.LocMap.Legend.Stocked"]</span>
                            <span><i class="capacity-full"></i>Full</span>
                        </div>
                    </div>
                    @if (IsOpenStorage || GridLocations.Count == 0)
                    {
                        <div class="location-open-storage">
                            <div class="location-storage-heading">@(IsOpenStorage ? "Open Storage" : "Locations without grid coordinates")</div>
                            @RenderStorageCards(UngridLocations)
                            @if (IsOpenStorage && GridLocations.Count > 0)
                            {
                                <div class="location-storage-heading">Existing grid locations · @GridLocations.Count</div>
                                <p class="location-storage-note">Existing stock stays at its current location. No inventory has been moved.</p>
                                <RadzenDataGrid TItem="LocationMapCell" Data="GridLocations" RowClick="@(args => { if (args.Data is not null) SelectLocation(args.Data); })" AllowPaging="true" PageSize="25" AllowSorting="true" Density="Density.Compact" Class="ames-rz-grid">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="LocationMapCell" Property="LocationNo" Title="@L["Col.LocationId"]" />
                                        <RadzenDataGridColumn TItem="LocationMapCell" Property="LocationName" Title="@L["Col.Name"]" />
                                        <RadzenDataGridColumn TItem="LocationMapCell" Property="Qty" Title="@L["Col.Qty"]" TextAlign="TextAlign.Right"><Template Context="row">@UomFmt.Qty(row.Qty, null)</Template></RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </div>
                    }
                    else
                    {
                        @RenderMap()
                    }
                </div>
            }
        </section>

    </div>

    @if (_locationDrawerOpen && !string.IsNullOrWhiteSpace(_highlightedLocation))
    {
        var loadCapacity = MapLocations.FirstOrDefault(x => Same(x.LocationNo, _highlightedLocation))?.Capacity;
        <div class="inventory-detail-backdrop" @onclick="CloseLocationDetail">
            <aside class="inventory-detail-drawer" role="dialog" aria-modal="true" aria-label="Location inventory detail" @onclick:stopPropagation="true">
                <header class="inventory-drawer-header">
                    <div>
                        <span>@L["WH.LocMap.Detail"]</span>
                        <strong>@_highlightedLocation</strong>
                        <small>@MapScope</small>
                    </div>
                    <div class="location-drawer-actions">
                        <RadzenButton Icon="print" Click="OpenLocationBarcode" title="Print location barcode" aria-label="Print location barcode" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                        <RadzenButton Icon="close" Click="CloseLocationDetail" aria-label="Close location detail" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    </div>
                </header>

                <div class="inventory-drawer-summary inventory-detail-summary">
                    <div><span>@L["WH.Inventory.AvailableQty"]</span><strong>@LocationQuantities()</strong></div>
                    <div><span>@L["Col.LoadCapacity"]</span><strong>@(loadCapacity is > 0 ? loadCapacity.Value.ToString("N0") : "-")</strong></div>
                    <div><span>@L["WH.LocMap.Lbl.Items"]</span><strong>@LocationDrawerRows.Select(x => x.PartNo).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong></div>
                    <div><span>@L["WH.Inventory.Lbl.Lots"]</span><strong>@LocationDrawerRows.Select(x => x.LotNo).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong></div>
                </div>

                <div class="inventory-drawer-table-wrap">
                    <RadzenDataGrid TItem="LocationMapStock" Data="LocationDrawerRows" AllowPaging="false" AllowSorting="true" EmptyText="@L["WH.LocMap.EmptyLocation"]" Density="Density.Compact" Class="ames-rz-grid">
                        <Columns>
                            <RadzenDataGridColumn TItem="LocationMapStock" Property="LotNo" Title="@L["Col.LotNo"]"><Template Context="row">@Text(row.LotNo)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="LocationMapStock" Property="PartNo" Title="@L["Col.ItemNo"]" />
                            <RadzenDataGridColumn TItem="LocationMapStock" Property="PartName" Title="@L["Col.ItemName"]"><Template Context="row">@Text(row.PartName)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="LocationMapStock" Property="Qty" Title="@L["Col.Qty"]" TextAlign="TextAlign.Right"><Template Context="row">@Qty(row)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="LocationMapStock" Property="DefectQty" Title="@L["WH.Inventory.DefectQty"]" TextAlign="TextAlign.Right"><HeaderTemplate><span class="location-defect-qty">@L["WH.Inventory.DefectQty"]</span></HeaderTemplate><Template Context="row"><span class="location-defect-qty">@UomFmt.QtyUnit(row.DefectQty, row.Unit)</span></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="LocationMapStock" Width="88px" Sortable="false" TextAlign="TextAlign.Center">
                                <HeaderTemplate><RadzenIcon Icon="report_problem" title="@L["WH.Inventory.DefectAction"]" aria-label="@L["WH.Inventory.DefectAction"]" /></HeaderTemplate>
                                <Template Context="row">
                                    @if (row.DefectQty > 0)
                                    {
                                        <RadzenIcon Icon="task_alt" title="@L["WH.Inventory.DefectRecorded"]" aria-label="@L["WH.Inventory.DefectRecorded"]" Style="color:var(--ames-tx-green-300);vertical-align:middle;" />
                                    }
                                    @if (_canReject && row.Qty > 0 && _eligibleLots.Contains(row.LotNo ?? ""))
                                    {
                                        <RadzenButton Icon="report_problem" title="@L["WH.Inventory.DefectAction"]" aria-label="@L["WH.Inventory.DefectAction"]" Click="@(() => OpenDefect(row))" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                                    }
                                    else if (row.DefectQty <= 0) { <span class="dim" title="@L["WH.Inventory.DefectNotEligible"]">—</span> }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </aside>
        </div>
    }

    @if (_defectLot is {} defectLot)
    {
        <InventoryDefectDialog @key="defectLot" Lot="defectLot" OnClose="CloseDefect" OnCompleted="DefectCompleted" />
    }

    @if (_barcodeLocation is not null)
    {
        <LocationBarcodeDialog LocationCode="@_barcodeLocation.LocationNo" OnClose="CloseLocationBarcode" />
    }

    @if (_dialog is not null)
    {
        <div class="ames-modal-bg" @onclick="CloseDialog">
            <div class="ames-modal ames-modal-wide" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <div class="ames-modal-h">@(_dialog == "WarehouseName" ? $"Edit Warehouse Name · {_code}" : _dialog == "AreaName" ? $"Edit Area Name · {_code}" : _dialog == "Grid" ? $"Edit Grid · {_area} / {FloorLabel}" : $"Add {_dialog}")</div>
                @if (_dialog is "AreaName" or "WarehouseName")
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                        <RadzenLabel Text="Name" Component="EditHierarchyName" class="ames-rz-modal-label" />
                        <RadzenTextBox Name="EditHierarchyName" @bind-Value="_name" MaxLength="60" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    </RadzenStack>
                }
                else if (_dialog is "Warehouse" or "Area")
                {
                    <div>Existing @(_dialog == "Warehouse" ? "warehouses" : $"areas in {_warehouse}"): @string.Join(", ", _dialog == "Warehouse" ? Areas.Select(x => x.WarehouseName).Distinct() : Areas.Where(x => Same(x.WarehouseCode, _warehouse) && !string.IsNullOrEmpty(x.AreaCode)).Select(x => x.AreaName))</div>
                    <RadzenRow Gap="8px" Style="margin-top:8px;">
                        <RadzenColumn Size="4"><RadzenLabel Text="Two-letter code" /><RadzenTextBox @bind-Value="_code" MaxLength="2" class="ames-rz-input" Style="width:100%;" /></RadzenColumn>
                        <RadzenColumn Size="8"><RadzenLabel Text="Name" /><RadzenTextBox @bind-Value="_name" MaxLength="60" class="ames-rz-input" Style="width:100%;" /></RadzenColumn>
                    </RadzenRow>
                    @if (_dialog == "Area")
                    {
                        <RadzenLabel Text="Storage mode" Component="LocationStorageMode" />
                        <RadzenDropDown Name="LocationStorageMode" @bind-Value="_storageMode" Data="StorageModes" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                        <p class="location-storage-note">Grid starts with a 1 × 1 grid on floor 1F. Open Storage creates a shared location without coordinates. Storage mode cannot be changed after creation.</p>
                    }
                }
                else if (_dialog == "Grid")
                {
                    <p>Set aisles × bays for this floor. Only locations containing stock block a reduction; history-only locations are hidden.</p>
                    <RadzenRow Gap="8px"><RadzenColumn Size="6"><RadzenLabel Text="Aisles (A1, B1, …)" /><RadzenNumeric TValue="int" @bind-Value="_aisles" Min="1" Max="1000" Style="width:100%;" /></RadzenColumn><RadzenColumn Size="6"><RadzenLabel Text="Bays (01, 02, …)" /><RadzenNumeric TValue="int" @bind-Value="_bays" Min="1" Max="1000" Style="width:100%;" /></RadzenColumn></RadzenRow>
                    @if (_gridStockAtRisk > 0) { <RadzenAlert AlertStyle="Radzen.AlertStyle.Warning">Cannot reduce this grid: @_gridStockAtRisk locations outside the new size contain stock.</RadzenAlert> }
                }
                else { <p>Add the next floor to @_area.</p> }
                @if (!string.IsNullOrEmpty(_dialogError)) { <RadzenAlert AlertStyle="Radzen.AlertStyle.Danger">@_dialogError</RadzenAlert> }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                    <RadzenButton Text="@(_dialog is "AreaName" or "WarehouseName" ? "Save" : _dialog == "Grid" ? "Save Grid" : "Add")" Click="SaveDialog" Disabled="@(_saving || _dialog == "Grid" && _gridStockAtRisk > 0)" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text="Cancel" Click="CloseDialog" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            </div>
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LocationMapCell> Locations { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<LocationMapStock> Inventory { get; set; } = [];
    [Parameter] public IReadOnlyList<LocationMapArea> Areas { get; set; } = [];
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanAddHierarchy { get; set; } = true;
    [Parameter] public string SearchId { get; set; } = "location-map-search";

    private enum MapStage { Warehouse, Area, Map }
    private sealed record StageCard(string Key, string Name, int LocationCount, decimal Qty);

    private MapStage _stage;
    private string? _warehouse, _area, _floor, _highlightedLocation;
    private bool _selectingFloor, _locationDrawerOpen, _saving, _editing;
    private bool _canReject;
    private HashSet<string> _eligibleLots = new(StringComparer.OrdinalIgnoreCase);
    private LocationMapStock? _defectLot;
    private LocationMapCell? _barcodeLocation;
    private string? _dialog, _actionError;
    private string _code = "", _name = "", _dialogError = "";
    private string _originalName = "";
    private int _aisles = 1, _bays = 1;
    private string _storageMode = "GRID";
    private static readonly object[] StorageModes = [new { Value = "GRID", Text = "Grid" }, new { Value = "OPEN", Text = "Open Storage" }];
    private LocationMapArea? SelectedArea => Areas.FirstOrDefault(x => Same(x.WarehouseCode, _warehouse) && Same(x.AreaCode, _area));
    private bool IsOpenStorage => SelectedArea?.StorageMode == "OPEN";

    private List<LocationMapCell> ActiveLocations => Locations.Where(x => !string.IsNullOrWhiteSpace(x.LocationNo)).ToList();
    private List<LocationMapCell> MapLocations => ActiveLocations
        .Where(x => Same(x.WarehouseCode, _warehouse) && Same(x.AreaCode, _area) && (IsOpenStorage || Same(x.Floor, _floor)))
        .ToList();
    private List<LocationMapCell> GridLocations => MapLocations.Where(x => x.HasGridCoordinates).ToList();
    private List<LocationMapCell> UngridLocations => MapLocations.Where(x => !x.HasGridCoordinates).ToList();

    private List<LocationMapStock> LocationDrawerRows => string.IsNullOrWhiteSpace(_highlightedLocation)
        ? []
        : Inventory.Where(x => Same(x.LocationNo, _highlightedLocation)).OrderBy(x => x.PartNo).ThenBy(x => x.LotNo).ToList();

    private List<StageCard> StageCards => _stage switch
    {
        MapStage.Warehouse => Areas.Count == 0 ? Cards(ActiveLocations, x => x.WarehouseCode, x => x.WarehouseName)
            : Areas.GroupBy(x => x.WarehouseCode).Select(g => StageAreaCard(g.Key, g.First().WarehouseName, null)).ToList(),
        MapStage.Area => Areas.Count == 0 ? Cards(ActiveLocations.Where(x => Same(x.WarehouseCode, _warehouse)), x => x.AreaCode, x => x.AreaName)
            : Areas.Where(x => Same(x.WarehouseCode, _warehouse) && !string.IsNullOrEmpty(x.AreaCode)).Select(x => StageAreaCard(x.AreaCode, x.AreaName, x.AreaCode)).ToList(),
        _ => []
    };

    private List<StageCard> FloorCards => Cards(
        ActiveLocations.Where(x => Same(x.WarehouseCode, _warehouse) && Same(x.AreaCode, _area)),
        x => x.Floor,
        x => FloorName(x.Floor));

    private string StageLabel => _stage == MapStage.Warehouse ? L["Col.Warehouse"].Value : L["Col.Area"].Value;
    private string FloorLabel => string.IsNullOrWhiteSpace(_floor) ? L["Col.Floor"].Value : FloorName(_floor);
    private string MapScope => string.Join(" / ", new[] { _warehouse, _area, IsOpenStorage ? null : FloorLabel }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private List<StageCard> SelectionRows => _selectingFloor ? FloorCards : StageCards;
    private string SelectionLabel => _selectingFloor ? L["Col.Floor"].Value : StageLabel;
    private string SelectionKind => _selectingFloor ? "Floor" : _stage == MapStage.Warehouse ? "Warehouse" : "Area";
    private string SelectionScope => $"{_stage}/{_warehouse}/{_area}/{_selectingFloor}";
    private int _gridStockAtRisk => MapLocations.Count(x => !LocationMapNaming.InGrid(x.Column, x.Row, _aisles, _bays)
        && Inventory.Any(i => i.Qty > 0 && Same(i.LocationNo, x.LocationNo)));

    protected override async Task OnInitializedAsync() => await LoadDefectAccess();

    private async Task LoadDefectAccess()
    {
        try
        {
            await Permissions.EnsureAsync(Auth);
            _canReject = Permissions.CanApprove(FinishedGoodsRepository.DefectPermissionHref);
            _eligibleLots = _canReject ? await Task.Run(() => FinishedGoodsRepo.ListDefectLots()) : [];
        }
        catch { _canReject = false; _eligibleLots.Clear(); }
    }

    private void OpenDefect(LocationMapStock lot)
    {
        if (!_canReject || lot.Qty <= 0 || !_eligibleLots.Contains(lot.LotNo ?? "")) return;
        _locationDrawerOpen = false;
        _defectLot = lot;
    }

    private void CloseDefect()
    {
        _defectLot = null;
        _locationDrawerOpen = !string.IsNullOrWhiteSpace(_highlightedLocation);
    }

    private async Task DefectCompleted(LocationMapStock lot)
    {
        _eligibleLots.Remove(lot.LotNo!);
        _defectLot = null;
        _editing = false;
        if (OnRefresh.HasDelegate) await OnRefresh.InvokeAsync();
        _locationDrawerOpen = ActiveLocations.Any(x => Same(x.LocationNo, _highlightedLocation));
    }

    protected override void OnParametersSet()
    {
        if (ActiveLocations.Count == 0 && Areas.Count == 0 || (_warehouse is not null && !Areas.Any(x => Same(x.WarehouseCode, _warehouse)) && !ActiveLocations.Any(x => Same(x.WarehouseCode, _warehouse))))
            ShowWarehouses();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_stage == MapStage.Map && !_selectingFloor && !IsOpenStorage && GridLocations.Count > 0)
        {
            try { await JS.InvokeVoidAsync("locationMapScroll.init", MapScrollId); }
            catch { }
        }
    }

    private async Task Refresh()
    {
        if (OnRefresh.HasDelegate) await OnRefresh.InvokeAsync();
        await LoadDefectAccess();
        CloseLocationDetail();
    }

    private void ToggleEdit() { _editing = !_editing; _actionError = null; }

    private void OpenHierarchyName(StageCard row)
    {
        if (!_editing || !CanEdit || !CanAddHierarchy || _stage is not (MapStage.Warehouse or MapStage.Area) || _selectingFloor) return;
        _code = row.Key;
        _originalName = _name = row.Name;
        _dialogError = "";
        _dialog = _stage == MapStage.Warehouse ? "WarehouseName" : "AreaName";
    }

    private async Task DeleteCard(string key)
    {
        if (!_editing || !CanEdit || !CanAddHierarchy || _saving) return;
        _actionError = null;
        var warehouse = _stage == MapStage.Warehouse ? key : _warehouse;
        var area = _stage == MapStage.Area ? key : _area;
        var floor = _stage == MapStage.Map && _selectingFloor ? key : null;
        if (warehouse is null || _stage == MapStage.Map && (area is null || floor is null)) return;
        var label = floor is not null ? $"floor {warehouse} / {area} / {floor}"
            : area is not null ? $"area {warehouse} / {area}" : $"warehouse {warehouse}";
        _saving = true;
        try
        {
            var impact = Warehouse.GetLocationMapDeleteImpact(warehouse, area, floor);
            if (impact.StockRows > 0)
            {
                _actionError = $"Cannot delete {label}: {impact.StockRows:N0} inventory records remain. Move the inventory first.";
                return;
            }
            if (await Dialog.Confirm($"Are you sure you want to delete {label} and its locations?",
                "Confirm Deletion", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }) != true) return;
            Warehouse.DeleteLocationMapScope(warehouse, area, floor);
            _editing = false;
            Audit.Deleted("WH-003", "MD_Location", label, impact);
            if (floor is not null) { _floor = null; ShowFloors(); }
            else if (area is null) ShowWarehouses();
            else ShowAreas();
            await Refresh();
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _saving = false; }
    }

    private void OpenDialog(string kind)
    {
        if (!CanEdit || !CanAddHierarchy) return;
        if (kind is not ("Warehouse" or "Area" or "Floor" or "Grid")) return;
        _dialogError = _code = _name = "";
        if ((kind is "Area" or "Floor" or "Grid") && string.IsNullOrWhiteSpace(_warehouse))
        { _dialogError = "Select a Warehouse first."; return; }
        if ((kind is "Floor" or "Grid") && string.IsNullOrWhiteSpace(_area))
        { _dialogError = "Select an Area first."; return; }
        if (kind == "Area") _storageMode = "GRID";
        if (kind == "Grid")
        {
            _aisles = Math.Max(1, MapLocations.Select(x => LocationMapNaming.YOrder(x.Column)).DefaultIfEmpty(0).Max());
            _bays = Math.Max(1, MapLocations.Select(x => int.TryParse(x.Row, out var bay) ? bay : 0).DefaultIfEmpty(0).Max());
        }
        _dialog = kind;
    }

    private void CloseDialog() { if (!_saving) { _dialog = null; _dialogError = ""; } }

    private async Task SaveDialog()
    {
        if (!CanEdit || !CanAddHierarchy || _dialog is null || _saving) return;
        if (_dialog == "AreaName" && (!_editing || _stage != MapStage.Area)) return;
        if (_dialog == "WarehouseName" && (!_editing || _stage != MapStage.Warehouse)) return;
        _dialogError = "";
        _saving = true;
        try
        {
            if (_dialog is "WarehouseName" or "AreaName" or "Grid")
            {
                var target = _dialog == "WarehouseName" ? $"warehouse {_code}"
                    : _dialog == "AreaName" ? $"area {_warehouse} / {_code}" : $"grid {MapScope}";
                if (await Dialog.Confirm($"Are you sure you want to save changes to {target}?",
                    "Confirm Changes", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }) != true) return;
            }
            switch (_dialog)
            {
                case "WarehouseName":
                    Warehouse.RenameLocationMapWarehouse(_code, _name);
                    break;
                case "AreaName":
                    Warehouse.RenameLocationMapArea(_warehouse!, _code, _name);
                    break;
                case "Warehouse":
                case "Area":
                    var code = _code.Trim().ToUpperInvariant();
                    if (!LocationMapNaming.ValidPrefix(code)) throw new InvalidOperationException("Use a unique two-letter code (A–Z).");
                    var name = string.IsNullOrWhiteSpace(_name) ? code : _name.Trim();
                    if (_dialog == "Warehouse")
                    {
                        if (Warehouse.WarehouseExists(code)) throw new InvalidOperationException("Warehouse code already exists.");
                        Warehouse.SaveWarehouse(code, name, true);
                        _warehouse = code;
                        _stage = MapStage.Area;
                    }
                    else
                    {
                        Warehouse.CreateLocationMapArea(_warehouse!, code, name, _storageMode);
                        _area = code;
                        _floor = _storageMode == "GRID" ? "F1" : null;
                        _stage = MapStage.Map;
                        _selectingFloor = false;
                    }
                    break;
                case "Floor":
                    _floor = Warehouse.AddLocationMapAxis(_warehouse!, _area!, "Floor", _floor);
                    _selectingFloor = false;
                    break;
                case "Grid":
                    Warehouse.SetLocationMapGrid(_warehouse!, _area!, _floor!, _aisles, _bays);
                    break;
            }
            _editing = false;
            if (_dialog is "AreaName" or "WarehouseName")
                Audit.Updated("WH-003", "MD_CodeItem", _dialog == "WarehouseName" ? _code : $"{_warehouse}/{_code}", new { Name = _originalName }, new { Name = _name.Trim() });
            else
                Audit.Log("WH-003", _dialog == "Grid" ? "UPDATE" : "CREATE", _dialog == "Area" ? "MD_CodeItem" : "MD_Location",
                    $"{_warehouse}/{_area}/{_floor}", null, new { Kind=_dialog, Code=_code, Name=_name, Aisles=_aisles, Bays=_bays, StorageMode=_storageMode });
            _dialog = null;
            await Refresh();
        }
        catch (Exception ex) { _dialogError = ex.Message; }
        finally { _saving = false; }
    }

    private void SelectStageRow(StageCard row)
    {
        if (_editing && CanEdit && CanAddHierarchy && (_stage is MapStage.Warehouse or MapStage.Area) && !_selectingFloor) OpenHierarchyName(row);
        else if (_selectingFloor) SelectFloor(row.Key);
        else SelectCard(row.Key);
    }

    private void SelectCard(string key)
    {
        if (_stage == MapStage.Warehouse)
        {
            _warehouse = key;
            _stage = MapStage.Area;
        }
        else
        {
            _area = key;
            _floor = IsOpenStorage ? null : FloorCards.FirstOrDefault(x => x.Key.StartsWith('F') && int.TryParse(x.Key[1..], out _))?.Key ?? FloorCards.FirstOrDefault()?.Key;
            _stage = MapStage.Map;
        }

        _selectingFloor = _stage == MapStage.Map && !IsOpenStorage && _floor is null;
        ClearSelection();
    }

    private void SelectFloor(string floor)
    {
        _floor = floor;
        _selectingFloor = false;
        _highlightedLocation = null;
        _locationDrawerOpen = false;
    }

    private void Back()
    {
        if (_stage == MapStage.Map && _selectingFloor) _selectingFloor = false;
        else if (_stage == MapStage.Map) ShowAreas();
        else ShowWarehouses();
    }

    private void ShowWarehouses()
    {
        _stage = MapStage.Warehouse;
        _warehouse = _area = _floor = _highlightedLocation = null;
        _selectingFloor = false;
        ClearSelection();
    }

    private void ShowAreas()
    {
        if (string.IsNullOrWhiteSpace(_warehouse)) { ShowWarehouses(); return; }
        _stage = MapStage.Area;
        _area = _floor = _highlightedLocation = null;
        _selectingFloor = false;
        ClearSelection();
    }

    private void ShowFloors()
    {
        if (string.IsNullOrWhiteSpace(_area)) { ShowAreas(); return; }
        if (IsOpenStorage) return;
        _selectingFloor = true;
        _highlightedLocation = null;
        _locationDrawerOpen = false;
    }

    private void ClearSelection()
    {
        _locationDrawerOpen = false;
    }

    private void SelectLocation(LocationMapCell location)
    {
        _highlightedLocation = location.LocationNo;
        _locationDrawerOpen = true;
    }

    private void OpenLocationBarcode()
    {
        _barcodeLocation = MapLocations.FirstOrDefault(x => Same(x.LocationNo, _highlightedLocation));
    }

    private void CloseLocationBarcode() => _barcodeLocation = null;

    private void CloseLocationDetail()
    {
        _locationDrawerOpen = false;
        _highlightedLocation = null;
    }

    private async Task ScrollMap(string direction) => await JS.InvokeVoidAsync("locationMapScroll.move", MapScrollId, direction);

    private RenderFragment RenderMap() => __builder =>
    {
        var columns = GridLocations.Select(x => Axis(x.Column)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(LocationMapNaming.YOrder).ThenBy(x => x).ToList();
        var rows = GridLocations.Select(x => Axis(x.Row)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(SortKey).ThenBy(x => x).ToList();

        if (MapLocations.Count == 0)
        {
            <div class="location-empty">@L["WH.LocMap.NoLocations"]</div>
            return;
        }

        <div class="location-map-scroll-shell">
            <div id="@MapScrollId" class="location-coordinate-scroll">
                <div class="location-coordinate-map" style="@MapStyle(columns.Count)">
                <div class="location-axis corner">@FloorLabel</div>
                @foreach (var column in columns) { <div class="location-axis">@column</div> }
                @foreach (var row in rows)
                {
                    <div class="location-axis row">@row</div>
                    @foreach (var column in columns)
                    {
                        var cell = GridLocations.FirstOrDefault(x => Same(Axis(x.Column), column) && Same(Axis(x.Row), row));
                        if (cell is null) { <div class="location-map-cell missing"></div> }
                        else
                        {
                            <button type="button" class="@MapCellClass(cell)" title="@(cell.IsFull ? $"{cell.LocationNo} · Load Capacity: {cell.Qty:N0}/{cell.Capacity:N0} (Full)" : cell.LocationNo)" @onclick="() => SelectLocation(cell)">
                                <span>@MapCellLabel(cell)</span>
                                @if (cell.Qty > 0) { <small>@UomFmt.Qty(cell.Qty, null)</small> }
                            </button>
                        }
                    }
                }
                </div>
                @if (UngridLocations.Count > 0)
                {
                    <div class="location-storage-heading">Locations without grid coordinates</div>
                    @RenderStorageCards(UngridLocations)
                }
            </div>
            <button type="button" hidden class="location-map-scroll-arrow left" data-scroll-dir="left" @onclick='() => ScrollMap("left")' aria-label="Scroll map left"><RadzenIcon Icon="arrow_back" /></button>
            <button type="button" hidden class="location-map-scroll-arrow right" data-scroll-dir="right" @onclick='() => ScrollMap("right")' aria-label="Scroll map right"><RadzenIcon Icon="arrow_forward" /></button>
            <button type="button" hidden class="location-map-scroll-arrow up" data-scroll-dir="up" @onclick='() => ScrollMap("up")' aria-label="Scroll map up"><RadzenIcon Icon="arrow_upward" /></button>
            <button type="button" hidden class="location-map-scroll-arrow down" data-scroll-dir="down" @onclick='() => ScrollMap("down")' aria-label="Scroll map down"><RadzenIcon Icon="arrow_downward" /></button>
        </div>
    };

    private RenderFragment RenderStorageCards(IReadOnlyList<LocationMapCell> locations) => __builder =>
    {
        @if (locations.Count == 0) { <div class="location-empty">@L["WH.LocMap.NoLocations"]</div> }
        <div class="location-hierarchy-cards location-storage-cards">
            @foreach (var cell in locations)
            {
                <div @key="cell.LocationNo" class="location-hierarchy-tile">
                    <RadzenButton Click="@(() => SelectLocation(cell))" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="@($"location-stage-card {(cell.IsFull ? "capacity-full" : "")}")" aria-label="@cell.LocationNo">
                        <div class="location-hierarchy-content">
                            <span>@cell.LocationNo</span>
                            <strong>@(cell.LocationName ?? cell.LocationNo)</strong>
                            <small>@L["Col.LoadCapacity"]: @(cell.Capacity is > 0 ? cell.Capacity.Value.ToString("N0") : "-")</small>
                            <b>@UomFmt.Qty(cell.Qty, null) <em>@L["WH.LocMap.Qty"]</em></b>
                        </div>
                    </RadzenButton>
                </div>
            }
        </div>
    };

    private string MapCellClass(LocationMapCell cell)
    {
        var classes = new List<string> { "location-map-cell", cell.Qty > 0 ? "stocked" : "empty" };
        if (cell.IsFull) classes.Add("capacity-full");
        if (Same(cell.LocationNo, _highlightedLocation)) classes.Add("selected");
        return string.Join(' ', classes);
    }

    private string MapScrollId => $"{SearchId}-scroll";
    private static string MapStyle(int columns) => $"--location-columns:{Math.Max(1, columns)};--location-cell-width:92px;--location-cell-height:62px;";
    private List<StageCard> Cards(IEnumerable<LocationMapCell> source, Func<LocationMapCell, string> key, Func<LocationMapCell, string?> name) => source
        .GroupBy(key, StringComparer.OrdinalIgnoreCase)
        .Select(group => new StageCard(group.Key, name(group.First()) ?? group.Key, group.Select(x => x.LocationNo).Distinct(StringComparer.OrdinalIgnoreCase).Count(), group.Sum(x => x.Qty)))
        .OrderBy(x => SortKey(x.Key)).ThenBy(x => x.Key)
        .ToList();

    private StageCard StageAreaCard(string key, string name, string? area) => new(key, name,
        ActiveLocations.Count(x => area is null ? Same(x.WarehouseCode, key) : Same(x.WarehouseCode, _warehouse) && Same(x.AreaCode, area)),
        ActiveLocations.Where(x => area is null ? Same(x.WarehouseCode, key) : Same(x.WarehouseCode, _warehouse) && Same(x.AreaCode, area)).Sum(x => x.Qty));

    private static int SortKey(string? value)
    {
        if (int.TryParse(value?.Trim('F', 'f'), NumberStyles.Integer, CultureInfo.InvariantCulture, out var number)) return number;
        return int.MaxValue;
    }

    private static string FloorName(string? value) => string.IsNullOrWhiteSpace(value) || value == "-" ? "Default"
        : LocationMapNaming.FloorNumber(value) is var number && number > 0 ? $"{number}F" : value;
    private static string MapCellLabel(LocationMapCell cell) => $"{Axis(cell.Column)}{Axis(cell.Row)}";
    private static string Axis(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    private static bool Same(string? left, string? right) => string.Equals(left, right, StringComparison.OrdinalIgnoreCase);
    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    private string Qty(LocationMapStock row) => UomFmt.QtyUnit(row.Qty, row.Unit);
    private string LocationQuantities() => string.Join(" / ", LocationDrawerRows.GroupBy(x => x.Unit, StringComparer.OrdinalIgnoreCase)
        .Select(group => UomFmt.QtyUnit(group.Sum(x => x.Qty), group.Key)).DefaultIfEmpty("0"));
}
