@* LOT 번호 링크 — 누르면 그 LOT 의 내용(공정·상태·작업지시·부모/자식 LOT·실적·불량·현재 재고)을 팝업(Pp/LotDetailDialog)으로 연다.
   사용: <LotLink LotCode="@code" /> *@
@inject DialogService Dialog

@if (string.IsNullOrWhiteSpace(LotCode))
{
    <span class="dim">—</span>
}
else
{
    <a href="javascript:void(0)" class="code wo-link" @onclick="Open" @onclick:stopPropagation="true">@LotCode</a>
}

@code {
    [Parameter] public string? LotCode { get; set; }

    async Task Open()
        => await Dialog.OpenAsync<AMES.Web.Components.Pages.Pp.LotDetailDialog>(LotCode!, new Dictionary<string, object?> { ["LotCode"] = LotCode },
               new DialogOptions { Width = "62vw", Height = "auto", Resizable = true, CloseDialogOnOverlayClick = true });
}
