    async Task SaveOrderCore()
    {
        if (!await Permissions.RecheckEditAsync(Authentication,Href) || IsPortal || _edit is null) return;
        if (!await Task.Run(()=>ValidateMaterial(_edit))) return;
        if (string.IsNullOrWhiteSpace(_edit.Destination) || _edit.Due.Date < _edit.Ordered.Date)
        { _error = L["Scm.Text.CheckItemDestinationQuantityPriceAndDueDate"]; return; }
        string number;
        var previous = _selected?.Copy();
        try
        {
            var isNew = string.IsNullOrEmpty(_edit.Number);
            var draft=ToDatabase(_edit); var versions=new Dictionary<int,string>(_edit.Versions);
            number = await Task.Run(()=>Scm.SavePurchaseOrder(draft, versions, _actor));
            _edit.Number = number;
            if (isNew) Audit.Created(ScreenCode, "WH_PurchaseOrder", number, ToDatabase(_edit));
            else Audit.Updated(ScreenCode, "WH_PurchaseOrder", number, previous, ToDatabase(_edit));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Purchase order save failed");
            _error = L["Scm.Text.SaveFailedCheckQuantityPricePrecisionDestinationMappingsAnd"];
            return;
        }
        _edit = null;
        if (await ReloadOrdersAsync(number)) _message = L["Scm.Text.OrderSaved"];
        else _message = L["Scm.Text.SavedButReloadFailedRefreshTheList"];
    }
    async Task ChangeStatus(string status)
    {
        if (_orderBusy) return;
        _orderBusy=true;
        ++_loadRevision;
        try { await ChangeStatusCore(status); } finally { _orderBusy=false; }
    }
    async Task ChangeStatusCore(string status)
    {
        if (!await Permissions.RecheckEditAsync(Authentication,Href) || _selected is null) return;
        if(_selected.DataIssue is not null){_message=_selected.DataIssue;return;}
        if (status == "Published" && (IsPortal || !CanApprove || _selected.Status != "Draft")) return;
        if (status == "Published" && !await Task.Run(()=>ValidateMaterial(_selected))) { _message = _error; return; }
        if (status == "Confirmed" && (!IsPortal || _selected.Status != "Published")) return;
        if (status == "Cancelled" && (IsPortal || _selected.Status is not ("Draft" or "Published") || Store.Delivered(_selected) > 0)) return;
        if (!IsPortal)
        {
            if (status is not ("Published" or "Cancelled")) return;
            var number = _selected.Number;
            try
            {
                var order=ToDatabase(_selected); var versions=new Dictionary<int,string>(_selected.Versions);
                await Task.Run(()=>Scm.ChangePurchaseOrderStatus(order, versions, status == "Published" ? "Open" : "Cancelled", _actor));
                Audit.Log(ScreenCode, status == "Published" ? "PUBLISH" : "CANCEL", "WH_PurchaseOrder", number, new { _selected.Status }, new { Status = status });
            }
            catch (Exception ex) { Logger.LogError(ex,"Order status change failed"); _message = L["Scm.Text.UnableToChangeStatusReloadAndCheckInboundReferences"]; return; }
            if (await ReloadOrdersAsync(number)) _message = status == "Published"
                ? L["Scm.Text.OrderIssued"]
                : L["Scm.Text.OrderCancelled"];
            else _message = L["Scm.Text.StatusSavedButReloadFailed"];
            return;
        }
        _selected.Status = status; Done();
    }
