                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.ConfirmedAt"]</div><div class="scm-dv">@_selected.SupplierConfirmedAt.Value.ToString(DateFmt.DateTimeSec)</div></div>
                }

                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.Buyer"]</div><div class="scm-dv">EOS</div></div>
