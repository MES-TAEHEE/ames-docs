            _materials=items;
            _error=items.Count==0 ? L["Scm.Text.NoMATERIALItemsLinkedToThisVendorAddMappings"] : "";
        }
        catch(Exception ex){if(revision==_materialRevision && _edit==editor){_materials.Clear();_error=L["Scm.Text.UnableToLoadItemsPleaseRetry"];}Logger.LogError(ex,"SCM item lookup failed");}
        finally{if(revision==_materialRevision)_materialLoading=false;}
