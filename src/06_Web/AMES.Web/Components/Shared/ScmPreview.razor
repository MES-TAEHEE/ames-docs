                        {
                            <tr><td class="code">@line.Item@if(line.DataIssue is not null){<div class="scm-data-issue">@line.DataIssue</div>}</td><td>@line.Name</td><td class="scm-unit">@UomFmt.Sym(line.Unit)</td><td class="num">@QuantityText(line.Quantity, line.Unit, 2)</td><td class="num">@QuantityText(Store.Delivered(_selected, line), line.Unit, 2)</td><td class="num">@QuantityText(Store.Remaining(_selected, line), line.Unit, 2)</td>@if(Mode=="Progress"){<td class="num">@QtyFormat.Text(line.ShippedQuantity,line.Unit)</td>}else{<td class="num">@line.Price.ToString("#,##0.00##")</td><td class="num">@line.Amount.ToString("N2")</td>}</tr>
