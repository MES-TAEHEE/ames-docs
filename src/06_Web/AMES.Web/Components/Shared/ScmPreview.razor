                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                    <RadzenButton Text='@L["Btn.Save"]' Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="SaveOrder" Disabled="@(_orderBusy || _materialLoading || _priceLoading.Count>0)" class="ames-rz-btn" />
                    <RadzenButton Text='@L["Btn.Close"]' Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(() => _edit = null)" Disabled="@_orderBusy" class="ames-rz-btn" />
                </RadzenStack>
            </div>
        </div>
    }
}
@code {
    string QuantityText(decimal quantity,string unit,int digits) => IsPortal ? QtyFormat.Text(quantity,unit) : UomFmt.Qty(quantity,unit);
    // ── 화면 구성(표준 화면과 같은 목록·모달) ─────────────────────────
    RadzenDataGrid<ScmPreviewStore.Order>? _orderGrid;
    RadzenDataGrid<ScmPreviewStore.Delivery>? _deliveryGrid;
