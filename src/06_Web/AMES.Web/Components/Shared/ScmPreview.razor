            return false;
        }
    }
    string Quantities(ScmPreviewStore.Order order, Func<ScmPreviewStore.OrderLine, decimal> quantity)
        => string.Join(" / ", order.Lines.GroupBy(l => l.Unit).Select(g => $"{QuantityText(g.Sum(quantity),g.Key,2)} {g.Key}"));
    void AddLine()
    {
        if (_edit is null) return;
        _edit.Lines.Add(new() { Id = _edit.Lines.Select(l => l.Id).DefaultIfEmpty().Max() + 1 });
    }
    void RemoveLine(ScmPreviewStore.OrderLine line)
    {
        if (_edit?.Lines.Count > 1) _edit.Lines.Remove(line);
    }
    void SelectMaterial(ScmPreviewStore.OrderLine line)
    {
        var item = _materials.Find(x => x.ItemNo == line.Item);
        line.Name = item?.ItemName ?? "";
        line.Unit = item?.DefaultUOM ?? "";
        line.Price = item?.UnitCost ?? 0m;
    }
    bool ValidateMaterial(ScmPreviewStore.Order order)
    {
        if (!LoadMaterials(order.Vendor)) return false;
        if (!LoadVendors()) return false;
        if (!_vendors.Any(v => v.VendorID == order.Vendor && v.ActiveFlag))
        {
            _error = T("사용 중인 협력업체를 선택하세요.", "Select an active vendor.", "Seleccione un proveedor activo.");
            return false;
        }
        if (order.Lines.Count == 0)
        {
            _error = T("품목을 한 개 이상 추가하세요.", "Add at least one item.", "Añada al menos un artículo.");
            return false;
        }
        foreach (var line in order.Lines)
        {
            var item = _materials.Find(x => x.ItemNo == line.Item);
            if (item is null || line.Quantity <= 0 || line.Price < 0)
            {
                _error = $"{order.Lines.IndexOf(line) + 1}: " + T("선택한 업체에 연결된 MATERIAL 품목, 양수 수량, 0 이상의 단가를 확인하세요.", "Check vendor-linked MATERIAL item, positive quantity and non-negative price.", "Revise artículo MATERIAL vinculado, cantidad positiva y precio no negativo.");
                return false;
            }
            line.Name = item.ItemName;
            line.Unit = item.DefaultUOM ?? "";
        }
        return true;
    }
    void NewOrder() { if (!CanEdit || IsPortal) return; _edit = new() { Vendor = "" }; LoadMaterials(_edit.Vendor); LoadVendors(); }
    void EditOrder() { if (!CanEdit || IsPortal || _selected?.Status != "Draft") return; _edit = _selected.Copy(); LoadMaterials(_edit.Vendor); LoadVendors(); }
    void ChangeVendor()
    {
        if (_edit is null) return;
        _edit.Lines = [new()];
        LoadMaterials(_edit.Vendor);
    }
    void SelectDeliveryLine()
    {
        var line = _selected?.Lines.Find(l => l.Id == _deliveryLineId);
        if (_selected is not null && (line is null || Store.Remaining(_selected, line) == 0))
        {
            line = _selected.Lines.FirstOrDefault(l => Store.Remaining(_selected, l) > 0);
            _deliveryLineId = line?.Id ?? 0;
        }
        _deliveryQuantity = line is null ? 0 : Store.Remaining(_selected!, line);
    }
    void SaveOrder()
    {
        if (!CanEdit || IsPortal || _edit is null) return;
        if (!ValidateMaterial(_edit)) return;
        if (string.IsNullOrWhiteSpace(_edit.Destination) || _edit.Due.Date < _edit.Ordered.Date)
        { _error = T("품목·납품장소, 수량, 단가와 납기를 확인하세요.", "Check item, destination, quantity, price and due date.", "Revise artículo, destino, cantidad, precio y fecha."); return; }
        string number;
        var previous = _selected?.Copy();
        try
        {
            var isNew = string.IsNullOrEmpty(_edit.Number);
            number = Scm.SavePurchaseOrder(ToDatabase(_edit), _edit.Versions, _actor);
            _edit.Number = number;
            if (isNew) Audit.Created(ScreenCode, "WH_PurchaseOrder", number, ToDatabase(_edit));
            else Audit.Updated(ScreenCode, "WH_PurchaseOrder", number, previous, ToDatabase(_edit));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Purchase order save failed");
            _error = T("저장하지 못했습니다. 수량(소수 3자리)·단가(소수 4자리)·납품장소(200자)와 업체 연결을 확인하세요. 다른 사용자가 수정했거나 입고에 연결된 발주라면 닫고 다시 조회하세요.", "Save failed. Check quantity/price precision, destination, mappings and concurrent or inbound changes. Close and reload.", "No se pudo guardar. Revise valores y vínculos. Cierre y recargue.");
            return;
        }
        _edit = null;
        if (ReloadOrders(number)) _message = T("발주서를 저장했습니다.", "Order saved.", "Pedido guardado.");
        else _message = T("저장은 완료됐지만 조회에 실패했습니다. 초기화를 눌러 다시 조회하세요.", "Saved, but reload failed. Refresh the list.", "Guardado, pero no se pudo recargar.");
    }
    void ChangeStatus(string status)
    {
        if (!CanEdit || _selected is null) return;
        if (status == "Published" && (IsPortal || !CanApprove || _selected.Status != "Draft")) return;
        if (status == "Published" && !ValidateMaterial(_selected)) { _message = _error; return; }
        if (status == "Confirmed" && (!IsPortal || _selected.Status != "Published")) return;
        if (status == "Cancelled" && (IsPortal || _selected.Status is not ("Draft" or "Published") || Store.Delivered(_selected) > 0)) return;
        if (!IsPortal)
        {
            if (status is not ("Published" or "Cancelled")) return;
            var number = _selected.Number;
            try
            {
                Scm.ChangePurchaseOrderStatus(ToDatabase(_selected), _selected.Versions, status == "Published" ? "Open" : "Cancelled", _actor);
                Audit.Log(ScreenCode, status == "Published" ? "PUBLISH" : "CANCEL", "WH_PurchaseOrder", number, new { _selected.Status }, new { Status = status });
            }
            catch (Exception ex) { Logger.LogError(ex,"Order status change failed"); _message = T("변경하지 못했습니다. 다른 사용자의 수정 또는 입고 연결 여부를 확인하고 다시 조회하세요.", "Unable to change status. Reload and check inbound references or concurrent changes.", "No se pudo cambiar. Recargue y revise las recepciones."); return; }
            if (ReloadOrders(number)) _message = status == "Published"
                ? T("발주서를 발행했습니다.", "Order issued.", "Pedido emitido.")
                : T("발주를 취소했습니다.", "Order cancelled.", "Pedido cancelado.");
            else _message = T("상태는 저장됐지만 조회에 실패했습니다. 다시 조회하세요.", "Status saved, but reload failed.", "Estado guardado. Recargue.");
            return;
        }
        _selected.Status = status; Done();
    }
    void ConfirmOrder()
    {
        if (!CanConfirmOrder || _selected is null) return;
        var number = _selected.Number;
        _confirmPrompt = false;
        try
        {
            var changed = Scm.ConfirmSupplierOrder(number, _selected.Versions, _portalUserId!, _actor, _adminPreview);
            if (changed) Audit.Log(ScreenCode, _adminPreview ? "CONFIRM_PROXY" : "CONFIRM", "WH_PurchaseOrder", number,
                new { SupplierConfirmedAt = _selected.SupplierConfirmedAt }, new { Confirmed = true, Actor = _actor, AdminOnBehalf = _adminPreview });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Supplier order confirmation failed");
            _message = T("수주 확인을 저장하지 못했습니다. 다시 조회한 뒤 발주 상태와 업체 연결 권한을 확인하세요.", "Confirmation failed. Reload and check order status and vendor access.", "No se pudo confirmar. Recargue y revise el estado y los permisos.");
            return;
        }
        if (ReloadOrders(number)) _message = T("수주 확인을 완료했습니다.", "Order confirmation completed.", "Confirmación del pedido completada.");
        else _message = T("확인은 저장됐지만 조회에 실패했습니다. 다시 조회하세요.", "Confirmation saved, but reload failed.", "Confirmación guardada. Recargue.");
    }
    bool _confirmPrompt, _isExternalPortalUser;
    string _actor = "";
    string? _portalUserId;
    bool _adminPreview;
    List<ScmPreviewStore.Order> _dbOrders = new();
    static ScmRepository.PurchaseOrder ToDatabase(ScmPreviewStore.Order o) => new(o.Number,o.Vendor,o.Ordered,o.Due,o.Destination,o.Status,o.Currency,
        o.Lines.Select(l => new ScmRepository.PurchaseLine(l.Id,l.Item,l.Name,l.Unit,l.Quantity,l.Price,l.Received)).ToList());
    bool ReloadOrders(string? selectedNumber = null)
    {
        try
        {
            _dbOrders = Scm.ListPurchaseOrders(IsPortal, _portalUserId, IsPortal && _adminPreview).Select(o => new ScmPreviewStore.Order {
                Number=o.Number,Vendor=o.Vendor,VendorName=o.VendorName,SupplierConfirmedAt=o.SupplierConfirmedAt,SupplierConfirmedBy=o.SupplierConfirmedBy,Ordered=o.Ordered,Due=o.Due,Destination=o.Destination,Currency=o.Currency,Persistent=true,
                Status=o.Status switch { "Open" => "Published", "Partial" => "Confirmed", "Complete" or "Received" => "Closed", "Draft" => "Draft", "Cancelled" => "Cancelled", _ => o.Status },
                Versions=o.Lines.ToDictionary(l => l.PoID,l => l.Version),
                Lines=o.Lines.Select(l => new ScmPreviewStore.OrderLine {PoID=l.PoID,Id=l.Id,Item=l.Item,Name=l.Name,Unit=l.Unit,Quantity=l.Quantity,Price=l.Price,Received=l.Received}).ToList()
            }).ToList();
            var deliveries = Scm.ListSupplierDeliveries(IsPortal, _portalUserId, IsPortal && _adminPreview);
            Store.Deliveries.Clear();
            Store.Deliveries.AddRange(deliveries.Select(d => new ScmPreviewStore.Delivery {
                Number=d.Number,OrderNumber=d.OrderNumber,PoID=d.PoID,LineId=d.LineId,Item=d.Item,Unit=d.Unit,
                VendorLotNo=d.VendorLotNo,ProductionDate=d.ProductionDate,Date=d.Date,Quantity=d.Quantity,Received=d.Received,Status=d.Status,Version=d.Version,ShipDate=d.ShipDate,ShippedAt=d.ShippedAt,ShippedBy=d.ShippedBy
            }));
            foreach(var order in _dbOrders)
                foreach(var line in order.Lines)
                    line.PendingDelivery=deliveries.Where(d=>d.PoID==line.PoID && d.Status!="Cancelled").Sum(d=>d.Quantity-d.Received);
            _selected = _dbOrders.Find(o => o.Number == selectedNumber);
            PrepareDelivery();
            return true;
        }
        catch (Exception ex) { Logger.LogError(ex,"Purchase order load failed"); _dbOrders.Clear(); _selected=null; _message=T("발주 조회에 실패했습니다. 다시 조회하세요.", "Unable to load orders. Retry.", "No se pudieron cargar los pedidos."); return false; }
    }
    sealed class DeliveryEntryLine
    {
        public ScmPreviewStore.OrderLine Line { get; set; } = new();
        public bool Selected { get; set; }
        public decimal Quantity { get; set; }
        public string VendorLotNo { get; set; } = "";
        public DateTime ProductionDate { get; set; }
        public decimal? PackingQty { get; set; }
        public decimal? BoxCount => PackingQty is > 0 ? decimal.Ceiling(Math.Max(0,Quantity)/PackingQty.Value) : null;
    }
    string _packingError="";
    static string DefaultLot(DateTime date) => date.ToString("yyyyMMdd",CultureInfo.InvariantCulture);
    void ChangeDeliveryDate(DateTime date)
    {
        foreach(var line in _deliveryEntries)
        {
            if(line.VendorLotNo==DefaultLot(_deliveryDate)) line.VendorLotNo=DefaultLot(date);
            if(line.ProductionDate.Date==_deliveryDate.Date) line.ProductionDate=date.Date;
        }
        _deliveryDate=date.Date;
    }
    void ChangeEditedDeliveryDate(DateTime date)
    {
        if(_delivery is null) return;
        foreach(var line in _deliveryEditLines)
        {
            if(line.VendorLotNo==DefaultLot(_delivery.Date)) line.VendorLotNo=DefaultLot(date);
            if(line.ProductionDate.Date==_delivery.Date.Date) line.ProductionDate=date.Date;
        }
        _delivery.Date=date.Date;
    }
    void UpdateDeliveryQuantity(DeliveryEntryLine entry, ChangeEventArgs e)
    {
        if(decimal.TryParse(e.Value?.ToString(),System.Globalization.NumberStyles.Number,System.Globalization.CultureInfo.CurrentCulture,out var quantity))
            entry.Quantity=quantity;
        else if(string.IsNullOrWhiteSpace(e.Value?.ToString())) entry.Quantity=0;
    }
    List<DeliveryEntryLine> _deliveryEntries = new();
    Guid _deliveryRequest = Guid.NewGuid();
    bool CanRegisterDelivery => IsPortal && Mode == "Entry"
        && (_adminPreview || _isExternalPortalUser) && !string.IsNullOrEmpty(_portalUserId)
        && _selected is { SupplierConfirmedAt: not null, Status: "Published" or "Confirmed" }
        && _selected.Lines.Any(l=>l.AvailableDelivery>0);
    void PrepareDelivery()
    {
        _deliveryRequest=Guid.NewGuid();
        _packingError="";
        var packing=new Dictionary<string,decimal?>(StringComparer.OrdinalIgnoreCase);
        if(CanRegisterDelivery && _selected is not null)
        {
            try { packing=Scm.ListPortalPackingQuantities(_portalUserId!,_adminPreview)
                .Where(r=>string.Equals(r.VendorID,_selected.Vendor,StringComparison.OrdinalIgnoreCase))
                .ToDictionary(r=>r.ItemNo,r=>r.PackingQty,StringComparer.OrdinalIgnoreCase); }
            catch(Exception ex) { Logger.LogError(ex,"Delivery packing quantity load failed");
                _packingError=T("적입량을 조회하지 못했습니다. 다시 조회해 주세요.","Unable to load packing quantities. Reload.","No se pudo cargar la cantidad por caja."); }
        }
        _deliveryEntries=_selected?.Lines.Where(l=>l.AvailableDelivery>0)
            .Select(l=>new DeliveryEntryLine{VendorLotNo=DefaultLot(_deliveryDate),ProductionDate=_deliveryDate.Date,Line=l,Quantity=l.AvailableDelivery,PackingQty=packing.GetValueOrDefault(l.Item)}).ToList() ?? new();
    }
    void CreateDelivery()
    {
        if (!CanRegisterDelivery || _selected is null) return;
        var entries=_deliveryEntries.Where(x=>x.Selected).ToList();
        if(entries.Count==0 || entries.Any(x=>x.Quantity<=0 || x.Quantity>x.Line.AvailableDelivery || decimal.Round(x.Quantity,3)!=x.Quantity))
        { _message=T("품목을 선택하고 등록 가능 수량 이내로 입력하세요. 소수 3자리까지 가능합니다.", "Select items and quantities within the available balance, up to 3 decimals.", "Seleccione artículos y cantidades disponibles, hasta 3 decimales."); return; }
        if(_packingError.Length>0 || entries.Any(x=>x.PackingQty is null or <=0))
        { _message=T("선택한 품목의 적입량이 없거나 0입니다. 포털 6번 적입량 관리에서 등록한 후 다시 조회해 주세요.","Set a positive packing quantity in PORTAL-006 and reload.","Registre una cantidad por caja positiva en PORTAL-006 y recargue."); return; }
        var orderNumber=_selected.Number;
        string deliveryNumber;
        try
        {
            deliveryNumber=Scm.RegisterSupplierDelivery(orderNumber,_deliveryDate,
                entries.Select(x=>new ScmRepository.DeliveryInput(x.Line.PoID,x.Quantity,x.VendorLotNo,x.ProductionDate)).ToList(),
                _selected.Versions,_deliveryRequest,_portalUserId!,_actor,_adminPreview);
            Audit.Created(ScreenCode,"SCM_Delivery",deliveryNumber,new {OrderNumber=orderNumber,Date=_deliveryDate,AdminOnBehalf=_adminPreview,
                Lines=entries.Select(x=>new {x.Line.PoID,x.Quantity,x.VendorLotNo,x.ProductionDate}).ToArray()});
        }
        catch(ScmRepository.DeliveryBoxLimitException)
        { _message=T("품목당 박스수량은 1,000개까지 등록할 수 있습니다. 적입량과 납품수량을 확인해 주세요.","Maximum 1,000 boxes per item. Check quantities.","Máximo 1.000 cajas por artículo."); return; }
        catch(ScmRepository.PackingQuantityRequiredException)
        {
            _message=T("선택한 품목의 적입량이 없거나 0입니다. 포털 6번 적입량 관리에서 등록한 후 다시 조회해 주세요.","Set a positive packing quantity in PORTAL-006 and reload.","Registre una cantidad por caja positiva en PORTAL-006 y recargue.");
            return;
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Supplier delivery registration failed");
            _message=T("등록하지 못했습니다. 납품 예정일, 발주 상태·잔량과 업체 연결을 확인하세요. 다른 사용자가 변경했다면 초기화 후 다시 조회하세요.", "Registration failed. Check date, order status, balance and vendor access. Reload after concurrent changes.", "No se pudo registrar. Revise fecha, saldo y permisos; recargue.");
            return;
        }
        if(ReloadOrders(orderNumber)) Nav.NavigateTo($"/portal/delivery-boxes?Number={Uri.EscapeDataString(deliveryNumber)}");
        else _message=T("등록은 완료됐지만 조회에 실패했습니다. 초기화 후 다시 조회하세요.","Saved, but reload failed. Refresh.","Guardado. Recargue.");
    }
    void OpenShipPrompt()
    {
        if(!DeliveryEditable || _delivery is null) return;
        var original=Store.Deliveries.Where(d=>d.Number==_delivery.Number).ToList();
        if(original.Any(d=>d.Date!=_delivery.Date || _deliveryEditLines.Any(l=>l.PoID==d.PoID && (l.Quantity!=d.Quantity || l.VendorLotNo!=d.VendorLotNo || l.ProductionDate!=d.ProductionDate))))
        { _message=T("변경한 내용을 먼저 수정 저장한 후 출하 확정하세요.", "Save your edits before confirming shipment.", "Guarde los cambios antes de confirmar."); return; }
        _cancelDeliveryPrompt=false; _shipDeliveryPrompt=true;
    }
    void ShipDelivery() => UpdateDelivery(false,true);
    void SaveDelivery() => UpdateDelivery(false);
    void CancelDelivery() => UpdateDelivery(true);
    void UpdateDelivery(bool cancel, bool ship=false)
    {
        if(!DeliveryEditable || _delivery is null || _selected is null) return;
        if(!cancel && !ship && _deliveryEditLines.Any(l=>l.Quantity<=0 || l.Quantity>EditableDeliveryBalance(l) || decimal.Round(l.Quantity,3)!=l.Quantity))
        { _message=T("수량은 수정 가능 최대수량 이내의 양수로 입력하세요. 소수 3자리까지 가능합니다.", "Enter positive quantities within the available maximum, up to 3 decimals.", "Introduzca cantidades positivas disponibles, hasta 3 decimales."); return; }
        var number=_delivery.Number; var orderNumber=_delivery.OrderNumber;
        var before=Store.Deliveries.Where(d=>d.Number==number).Select(d=>d.Copy()).ToArray();
        try
        {
            Scm.UpdateSupplierDelivery(number,ship?_shipDate:_delivery.Date,
                (ship?before.AsEnumerable():_deliveryEditLines).Select(l=>new ScmRepository.DeliveryInput(l.PoID,l.Quantity,l.VendorLotNo,l.ProductionDate)).ToList(),
                _delivery.Version,_selected.Versions,_portalUserId!,_actor,cancel,_adminPreview,ship);
            Audit.Log(ScreenCode,ship?"SHIP":cancel?"CANCEL":"UPDATE","SCM_Delivery",number,before,
                new {Date=_delivery.Date,ShipDate=ship?(DateTime?)_shipDate:null,Shipped=ship,Cancelled=cancel,AdminOnBehalf=_adminPreview,Lines=_deliveryEditLines.Select(l=>new {l.PoID,l.Quantity,l.VendorLotNo,l.ProductionDate}).ToArray()});
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Delivery update failed");
            _message=T("저장하지 못했습니다. 예정일·잔량·업체 권한을 확인하세요. 다른 사용자가 변경했거나 입고에 연결되었다면 초기화 후 다시 조회하세요.", "Save failed. Check date, balance, permissions and receiving references. Reload after concurrent changes.", "No se pudo guardar. Revise fecha, saldo, permisos y recepciones; recargue.");return;
        }
        _cancelDeliveryPrompt=false;
        if(ReloadOrders(orderNumber))
        {
            var updated=Store.Deliveries.FirstOrDefault(d=>d.Number==number);
            if(updated is not null) SelectDelivery(updated); else _delivery=null;
            _message=ship?T("납품서 출하를 확정했습니다. EOS 입고 대기 상태입니다.","Shipment confirmed. Awaiting EOS receipt.","Envío confirmado. Pendiente de recepción EOS."):cancel?T("납품서를 취소하고 등록 가능 잔량을 복원했습니다.","Delivery cancelled; quantities released.","Entrega cancelada; cantidades liberadas.")
                :T("납품서 변경사항을 저장했습니다.","Delivery changes saved.","Cambios guardados.");
        }
        else {_delivery=null;_message=T("저장은 완료됐지만 조회에 실패했습니다. 초기화 후 다시 조회하세요.","Saved, but reload failed. Refresh.","Guardado. Recargue.");}
    }
    void Done() => _message = T("미리보기 데이터에 반영했습니다. 실제 업무 데이터는 저장되지 않습니다.", "Preview updated. No business data was saved.", "Vista previa actualizada. No se guardaron datos reales.");
    static string T(string ko, string en, string es) => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch { "ko" => ko, "es" => es, _ => en };
    static string Badge(string status) => status switch { "Closed" or "Inspected" => "ok", "Draft" => "warn", "Cancelled" => "bad", _ => "info" };
    string Status(string status) => status switch {
