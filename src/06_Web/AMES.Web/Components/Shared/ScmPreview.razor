                                    <td>@QtyFormat.Text(mismatch.Before,mismatch.Unit) @UomFmt.Sym(mismatch.Unit)</td><td>@QtyFormat.Text(mismatch.After,mismatch.Unit) @UomFmt.Sym(mismatch.Unit)</td>
                                    <td class="@(mismatch.Change<0?"scm-shortage":"scm-overage")">@(mismatch.Change>0?"+":"")@QtyFormat.Text(mismatch.Change,mismatch.Unit) @UomFmt.Sym(mismatch.Unit)</td>
                                    <td>@mismatch.Reason<div class="dim">@mismatch.Comment</div></td></tr>
