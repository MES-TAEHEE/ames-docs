    bool _isExternalPortalUser;
    string _actor = "";
    string? _portalUserId;
    List<ScmPreviewStore.Order> _dbOrders = new();
    static ScmRepository.PurchaseOrder ToDatabase(ScmPreviewStore.Order o) => new(o.Number,o.Vendor,o.Ordered,o.Due,o.Destination,o.Status,o.Currency,
        o.Lines.Select(l => new ScmRepository.PurchaseLine(l.Id,l.Item,l.Name,l.Unit,l.Quantity,l.Price,l.Received)).ToList(),DataIssue:o.DataIssue);
    ScmRepository.PurchaseOrderFilter? CurrentFilter() => IsPortal ? null : new(_search,_vendor,_creator,_from,_to);
    (List<ScmRepository.PurchaseOrder> Orders,List<ScmRepository.SupplierDelivery> Deliveries,Dictionary<int,decimal> Prepared) ReadOrderData(ScmRepository.PurchaseOrderFilter? filter=null)
    {
        var orders=Scm.ListPurchaseOrders(IsPortal,_portalUserId,filter:filter);
        var deliveries=Scm.ListSupplierDeliveries(IsPortal,_portalUserId,orders.SelectMany(o=>o.Lines).Select(l=>l.PoID).ToArray());
        var prepared=IsPortal && Mode=="Due" && _isExternalPortalUser
            ? Scm.ListDeliveryCases(null,_portalUserId!).Where(c=>c.Status=="Prepared" && c.NoteNumber.Length==0 && c.Delivery is null)
                .SelectMany(c=>c.Boxes).GroupBy(b=>b.PoID).ToDictionary(g=>g.Key,g=>g.Sum(b=>b.Quantity))
            : new Dictionary<int,decimal>();
        return (orders,deliveries,prepared);
    }
    void ApplyOrderData((List<ScmRepository.PurchaseOrder> Orders,List<ScmRepository.SupplierDelivery> Deliveries,Dictionary<int,decimal> Prepared) data,string? selectedNumber)
    {
            _dbOrders = data.Orders.Select(o => new ScmPreviewStore.Order {
                Number=o.Number,Vendor=o.Vendor,VendorName=o.VendorName,CreatedBy=o.CreatedBy,SupplierConfirmedAt=o.SupplierConfirmedAt,SupplierConfirmedBy=o.SupplierConfirmedBy,Ordered=o.Ordered,Due=o.Due,Destination=o.Destination,Currency=o.Currency,Persistent=true,DataIssue=o.DataIssue,
                Status=o.Status switch { "Open" => "Published", "Partial" => "Confirmed", "Complete" or "Received" => "Closed", "Draft" => "Draft", "Cancelled" => "Cancelled", _ => o.Status },
                Versions=o.Lines.ToDictionary(l => l.PoID,l => l.Version),
                Lines=o.Lines.Where(l=>!(IsPortal && Mode=="Due") || l.ItemExists && MasterDataRepository.IsQuantityUnit(l.Unit)).Select(l => new ScmPreviewStore.OrderLine {PoID=l.PoID,Id=l.Id,Item=l.Item,Name=l.Name,Unit=l.Unit,Quantity=l.Quantity,Price=l.Price,Received=l.Received,ItemExists=l.ItemExists,ItemActive=l.ItemActive,MasterUnit=l.MasterUnit,DeliveryReceived=l.DeliveryReceived}).ToList()
            }).Where(o=>!(IsPortal && Mode=="Due") || o.Lines.Count>0).ToList();
            foreach(var order in _dbOrders)if(!string.IsNullOrWhiteSpace(order.CreatedBy))_creators.Add(order.CreatedBy);
            var deliveries = data.Deliveries;
            Store.Deliveries.Clear();
            Store.Deliveries.AddRange(deliveries.Select(d => new ScmPreviewStore.Delivery {
                Number=d.Number,OrderNumber=d.OrderNumber,PoID=d.PoID,LineId=d.LineId,Item=d.Item,Unit=d.Unit,
                VendorLotNo=d.VendorLotNo,ProductionDate=d.ProductionDate,Date=d.Date,Quantity=d.Quantity,Received=d.Received,Status=d.Status,Version=d.Version,ShipDate=d.ShipDate,ShippedAt=d.ShippedAt,ShippedBy=d.ShippedBy
            }));
            var byPo=deliveries.Where(d=>d.Status!="Cancelled").ToLookup(d=>d.PoID);
            foreach(var order in _dbOrders)
                foreach(var line in order.Lines)
                {
                    var active=byPo[line.PoID].ToList();
                    line.RegisteredDelivery=active.Sum(d=>d.Quantity);
                    line.ShippedQuantity=active.Where(d=>d.ShippedAt.HasValue || d.Status is "Shipped" or "Received").Sum(d=>d.Quantity);
                    line.PendingDelivery=active.Sum(d=>d.Quantity-d.Received);
                    line.PreparedQuantity=data.Prepared.GetValueOrDefault(line.PoID);
                }
            _selected = _dbOrders.Find(o => o.Number == selectedNumber);
    }
    bool ReloadOrders(string? selectedNumber = null)
    {
        try
        {
            ApplyOrderData(ReadOrderData(CurrentFilter()),selectedNumber);
            LoadNotes();
            LoadReceiptResults();
            return true;
        }
        catch (Exception ex) { Logger.LogError(ex,"Purchase order load failed"); _dbOrders.Clear(); _selected=null; _message=L["Scm.Text.UnableToLoadOrdersRetry"]; return false; }
    }
    int _loadRevision;
    async Task<bool> ReloadOrdersAsync(string? selectedNumber=null)
    {
        var revision=++_loadRevision;
        try
        {
            var filter=CurrentFilter();
            var data=await Task.Run(()=>ReadOrderData(filter));
            if(revision!=_loadRevision)return false;
            ApplyOrderData(data,selectedNumber);
            if(IsPortal && Mode=="Deliveries" && _isExternalPortalUser && !string.IsNullOrEmpty(_portalUserId))
            {
                try
                {
                    var extras=await Task.Run(()=>(Notes:Scm.ListNoteDeliveries(_portalUserId),Receipts:Scm.ListPortalReceiptResults(_portalUserId),Mismatches:Scm.ListPortalDeliveryDiscrepancies(_portalUserId)));
                    _noteDeliveries=extras.Notes.ToDictionary(x=>x.Number,StringComparer.OrdinalIgnoreCase);
                    _portalReceipts=extras.Receipts;_portalMismatches=extras.Mismatches;_receiptError="";
                }
                catch(Exception ex){Logger.LogWarning(ex,"Portal receipt results load failed");_receiptError=L["SCM.Preview.Err.Receipts"];}
            }
            return true;
        }
        catch(Exception ex){if(revision!=_loadRevision)return false;Logger.LogError(ex,"Purchase order load failed");_dbOrders.Clear();Store.Deliveries.Clear();_selected=null;_edit=null;_message=L["Scm.Text.UnableToLoadOrdersRetry"];return false;}
    }
    static string DefaultLot(DateTime date) => date.ToString("yyyyMMdd",CultureInfo.InvariantCulture);
    void ChangeEditedDeliveryDate(DateTime date)
    {
        if(_delivery is null) return;
        foreach(var line in _deliveryEditLines)
        {
            if(line.VendorLotNo==DefaultLot(_delivery.Date)) line.VendorLotNo=DefaultLot(date);
            if(line.ProductionDate.Date==_delivery.Date.Date) line.ProductionDate=date.Date;
        }
        _delivery.Date=date.Date;
    }
    void SaveDelivery()
    {
        if(!DeliveryEditable || _delivery is null || _selected is null) return;
        if(_deliveryEditLines.Any(l=>l.Quantity<=0 || l.Quantity>EditableDeliveryBalance(l) || decimal.Round(l.Quantity,3)!=l.Quantity))
        { _message=L["Scm.Text.EnterPositiveQuantitiesWithinTheAvailableMaximumUpTo"]; return; }
        var number=_delivery.Number; var orderNumber=_delivery.OrderNumber;
        var before=Store.Deliveries.Where(d=>d.Number==number).Select(d=>d.Copy()).ToArray();
        try
        {
            Scm.UpdateSupplierDelivery(number,_delivery.Date,
                _deliveryEditLines.Select(l=>new ScmRepository.DeliveryInput(l.PoID,l.Quantity,l.VendorLotNo,l.ProductionDate)).ToList(),
                _delivery.Version,_selected.Versions,_portalUserId!,_actor);
            Audit.Log(ScreenCode,"UPDATE","SCM_Delivery",number,before,
                new {Date=_delivery.Date,Lines=_deliveryEditLines.Select(l=>new {l.PoID,l.Quantity,l.VendorLotNo,l.ProductionDate}).ToArray()});
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Delivery update failed");
            _message=L["Scm.Text.SaveFailedCheckDateBalancePermissionsAndReceivingReferences"];return;
        }
        if(ReloadOrders(orderNumber))
        {
            var updated=Store.Deliveries.FirstOrDefault(d=>d.Number==number);
            if(updated is not null) SelectDelivery(updated); else _delivery=null;
            _message=L["Scm.Text.DeliveryChangesSaved"];
        }
        else {_delivery=null;_message=L["Scm.Text.SavedButReloadFailedRefresh.757eb2"];}
    }
    void Done() => _message = L["Scm.Text.PreviewUpdatedNoBusinessDataWasSaved"];
    static string PortalOrderStatus(ScmPreviewStore.Order order) => ScmRepository.PortalOrderStatus(
        order.Status=="Cancelled",order.Lines.Select(line=>(line.Quantity,line.ShippedQuantity,line.Received)));
    static bool ProgressReceived(ScmPreviewStore.Order order) => order.Status=="Closed"
        || order.Lines.Count>0 && order.Lines.All(line=>line.Received>=line.Quantity);
    static string ProgressCode(ScmPreviewStore.Order o) => ScmRepository.ProgressOrderStatus(o.Status,o.SupplierConfirmedAt.HasValue,
        o.Lines.Select(l=>(l.Quantity,l.ShippedQuantity,l.Received,l.RegisteredDelivery)));
    string ProgressStatus(ScmPreviewStore.Order o) => Status(ProgressCode(o));
    static string Badge(string status) => status switch { "Closed" or "Received" or "Inspected" => "ok", "Draft" or "PartiallyReceived" => "warn", "Cancelled" => "bad", _ => "info" };
    string Status(string status) => status switch {
        "AwaitingConfirmation" => L["Scm.Text.AwaitingConfirmation.c207aa"],
        "SupplierConfirmed" => L["Scm.Text.Confirmed.538025"],
        "PreparingDelivery" => L["Scm.Text.PreparingDelivery"],
        "Outstanding" => L["Scm.Text.AvailableToRegister.388045"],
        "Draft" => L["Scm.Text.Draft"], "Published" => L["Scm.Text.Published"],
        "Confirmed" => L["Scm.Text.Receiving"], "Closed" => L["Scm.Text.Closed"],
        "PartiallyReceived" => L["Scm.Text.PartiallyReceived"],
        "Shipped" => L["Scm.Text.Shipped.b0d543"], "Received" => L["Scm.Text.Received.2a92a7"], "Registered" => L["Scm.Text.Scheduled.b83eb1"], "Inspected" => L["Scm.Text.Received.2a92a7"],
        _ => L["Scm.Text.Cancelled.7cc538"]
    };
}
