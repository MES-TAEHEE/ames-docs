    async Task LoadEditorMaterials()
    {
        if(_edit is null)return;
        var editor=_edit;var vendor=editor.Vendor;var revision=++_materialRevision;
        _materialLoading=true;
        try
        {
            var items=await Task.Run(()=>
            {
                var linked=Scm.ListItemVendors().Where(x=>x.VendorID==vendor && x.VendorActive).Select(x=>x.ItemNo).ToHashSet(StringComparer.OrdinalIgnoreCase);
                return MasterData.ListItems(itemType:"MATERIAL").Where(x=>x.ActiveFlag && linked.Contains(x.ItemNo) && MasterDataRepository.IsQuantityUnit(x.DefaultUOM)).ToList();
            });
