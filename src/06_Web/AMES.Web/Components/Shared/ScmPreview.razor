                </div>

<div class="scm-dgrid">                @if (Mode != "Progress") { <div class="scm-dt"><div class="scm-dl">@(IsPortal ? L["SCM.Preview.Col.Confirmation"] : L["Scm.Text.SupplierConfirmation"])</div><div class="scm-dv">@ConfirmationLabel(_selected)</div></div> }
