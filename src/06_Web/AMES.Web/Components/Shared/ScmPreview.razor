@inject PortalQuantityFormat QtyFormat
@inject ScmPreviewStore Store
@inject PermissionService Permissions
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Nav
@inject MasterDataRepository MasterData
@inject ScmRepository Scm
@inject ILogger<ScmPreview> Logger
@inject AuditLogger Audit
@inject IStringLocalizer<SharedResources> L
@inject UomFormat UomFmt
@using System.Globalization

<PageTitle>@ScreenCode @Title · AMES</PageTitle>
<AmesPageHeader Code="@ScreenCode" Title="@Title" />
@if(IsPortal && (Mode=="Entry" || Mode=="Deliveries")) { <PortalDeliveryNav /> }
@if (_ready)
{
    @if (Mode == "Deliveries")
    {
        <div class="ames-kpis">
            <div class="ames-kpi info"><div class="ames-kpi-l">@T("납품서 건수", "Delivery notes", "Entregas")</div><div class="ames-kpi-v">@DeliveryRows.Count</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@T("납품 예정", "Scheduled", "Programadas")</div><div class="ames-kpi-v">@DeliveryRows.Count(d=>d.Status=="Registered")</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@T("출하 완료", "Shipped", "Enviadas")</div><div class="ames-kpi-v">@DeliveryRows.Count(d=>d.Status=="Shipped")</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@T("입고 완료", "Received", "Recibidas")</div><div class="ames-kpi-v">@DeliveryRows.Count(d=>d.Status=="Received")</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@T("취소", "Cancelled", "Canceladas")</div><div class="ames-kpi-v">@DeliveryRows.Count(d=>d.Status=="Cancelled")</div></div>
        </div>
    }
    else
    {
    <div class="ames-kpis">
        <div class="ames-kpi info"><div class="ames-kpi-l">@T("발주 건수", "Orders", "Pedidos")</div><div class="ames-kpi-v">@Rows.Count</div></div>
        <div class="ames-kpi"><div class="ames-kpi-l">@T("확인 대기", "Awaiting confirmation", "Pendientes")</div><div class="ames-kpi-v">@Rows.Count(x => (x.Status is "Published" or "Confirmed") && x.SupplierConfirmedAt is null)</div></div>
        <div class="ames-kpi warn"><div class="ames-kpi-l">@T("납품 진행", "In delivery", "En entrega")</div><div class="ames-kpi-v">@Rows.Count(x => x.Lines.Any(l => l.PendingDelivery > 0))</div></div>
        <div class="ames-kpi bad"><div class="ames-kpi-l">@T("납기 지연", "Overdue", "Atrasados")</div><div class="ames-kpi-v">@Rows.Count(x => x.Due.Date < DbClock.Today && Store.Remaining(x) > 0 && x.Status is "Published" or "Confirmed")</div></div>
    </div>
    }
    @if (!string.IsNullOrEmpty(_message) && _selected is null && _edit is null && _delivery is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false">@_message</RadzenAlert>
    }

    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="white-space:nowrap;">▼ @Title · @(Mode is "Deliveries" or "Receipts" ? DeliveryRows.Count : Rows.Count) @T("건", "items", "registros")</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="_search" Immediate="true" Placeholder='@(Mode == "Deliveries" ? T("납품서 / 발주 / 품목", "Delivery / order / item", "Entrega / pedido / artículo") : T("발주번호 / 품목", "Order / item", "Pedido / artículo"))' InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
                @if (!IsPortal)
                {
                    <RadzenLabel Text='@T("협력업체", "Supplier", "Proveedor")' Component="ScmDropDownVendor" />
                    <RadzenDropDown Name="ScmDropDownVendor" @bind-Value="_vendor" Data="@VendorFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@T("전체", "All", "Todos")' AllowClear="true" AllowFiltering="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
                }
                <RadzenLabel Text='@T("상태", "Status", "Estado")' Component="ScmDropDownStatus" />
                <RadzenDropDown Name="ScmDropDownStatus" @bind-Value="_status" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@T("전체", "All", "Todos")' AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
                <RadzenLabel Text='@(Mode == "Deliveries" ? T("납품 예정일", "Delivery date", "Entrega") : T("납기", "Due", "Vencimiento"))' />
                <RadzenDatePicker TValue="DateTime?" @bind-Value="_from" DateFormat="@DateFmt.Date" AllowClear="true" Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
                <span class="dim">~</span>
                <RadzenDatePicker TValue="DateTime?" @bind-Value="_to" DateFormat="@DateFmt.Date" AllowClear="true" Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
                <RadzenButton Text='@T("초기화", "Reset", "Restablecer")' Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="Reset" class="ames-rz-btn" />
                @if (!IsPortal && Mode == "Orders" && CanEdit)
                {
                    <RadzenButton Text='@T("신규 발주", "New order", "Nuevo pedido")' Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="NewOrder" class="ames-rz-btn" />
                }
            </RadzenStack>
        </div>
        <div class="dim" style="font-size:var(--ames-fs-hint);padding:0 0 6px;">
            ℹ
            @if (IsPortal) { @T("발주 내역을 조회하고 수주 확인·납품서 등록·출하 확정을 진행합니다. 입고·검수는 별도 처리합니다.", "View purchase orders, confirm orders, register deliveries and confirm shipments. Receipt and inspection are handled separately.", "Consulte pedidos, confirme órdenes, registre entregas y confirme envíos. La recepción y la inspección se gestionan por separado.") }
            else { @T("발주서를 작성하고 발행·취소 상태와 입고수량을 확인합니다.", "Create purchase orders and view their status and received quantities.", "Cree pedidos y consulte su estado y las cantidades recibidas.") }
            @if (IsPortal) { <span> · @(_adminPreview ? T("관리자 전체 조회", "Administrator preview", "Vista de administrador") : T("계정에 연결된 업체의 발주만 표시됩니다. 연결 정보가 없으면 표시되지 않습니다.", "Only orders for linked vendors are visible. Unlinked accounts see no orders.", "Solo pedidos de proveedores vinculados."))</span> }
        </div>
        @if (_from > _to)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@T("종료일은 시작일 이후여야 합니다.", "End date must follow start date.", "La fecha final debe ser posterior a la inicial.")</RadzenAlert>
        }

        @if (Mode is "Deliveries" or "Receipts")
        {
            <RadzenDataGrid @ref="_deliveryGrid" TItem="ScmPreviewStore.Delivery" Data="@DeliveryRows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@PagerSummary" PageSizeText="@PagerSize"
                            RowClick="@(args => { if (args.Data is not null) SelectDelivery(args.Data); })" RowRender="@RowLinkDelivery" EmptyText="@Empty" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Title="No." Width="60px" MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="d"><span class="dim">@GridRowNo.Of(_deliveryGrid, d)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Property="Number" Title='@T("납품서번호", "Delivery note", "Albarán")' Width="150px">
                        <Template Context="d"><span class="code">@d.Number</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Property="OrderNumber" Title='@T("발주번호", "Order", "Pedido")' Width="150px">
                        <Template Context="d"><span class="code">@d.OrderNumber</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Title='@T("품목", "Item", "Artículo")'><Template Context="d">@d.Item</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Property="Date" Title='@T("납품일", "Delivery date", "Fecha de entrega")' TextAlign="TextAlign.Center" Width="120px">
                        <Template Context="d">@d.Date.ToString(DateFmt.Date)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Title='@T("납품수량", "Quantity", "Cantidad")' TextAlign="TextAlign.Right" Width="140px"><Template Context="d">@DeliveryQuantities(d.Number)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Property="ShipDate" FormatString="{0:yyyy-MM-dd}" Title='@T("출하일", "Ship date", "Fecha de envío")' Width="120px" />
                    @if (Mode == "Receipts")
                    {
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Property="Accepted" Title='@T("합격수량", "Accepted", "Aceptados")' TextAlign="TextAlign.Right" Width="110px" />
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Property="Rejected" Title='@T("불합격수량", "Rejected", "Rechazados")' TextAlign="TextAlign.Right" Width="110px" />
                    }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Title='@T("상태", "Status", "Estado")' TextAlign="TextAlign.Center" Width="110px">
                        <Template Context="d"><span class="pill @Badge(d.Status)">@Status(d.Status)</span></Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenDataGrid @ref="_orderGrid" TItem="ScmPreviewStore.Order" Data="@Rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@PagerSummary" PageSizeText="@PagerSize"
                            RowClick="@(args => { if (args.Data is not null) Select(args.Data); })" RowRender="@RowLinkOrder" EmptyText="@Empty" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Title="No." Width="60px" MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="o"><span class="dim">@GridRowNo.Of(_orderGrid, o)</span></Template>
                    </RadzenDataGridColumn>
                    @if (Mode == "Due") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Property="Due" Title='@T("납기일", "Due date", "Vencimiento")' TextAlign="TextAlign.Center" Width="120px"><Template Context="o">@o.Due.ToString(DateFmt.Date)</Template></RadzenDataGridColumn> }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Property="Number" Title='@T("발주번호", "Order", "Pedido")' Width="160px">
                        <Template Context="o"><span class="code">@o.Number</span></Template>
                    </RadzenDataGridColumn>
                    @if (!IsPortal || _adminPreview) { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Property="Vendor" Title='@T("협력업체", "Supplier", "Proveedor")' Width="220px"><Template Context="order"><span class="code">@order.Vendor</span><span class="dim" style="font-size:.8em;margin-left:4px;">@VendorName(order.Vendor)</span></Template></RadzenDataGridColumn> }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Property="Item" Title='@T("품번", "Item", "Artículo")' Width="170px"><Template Context="o"><span class="code">@(o.Lines.FirstOrDefault()?.Item)</span>@if (o.LineCount > 1) { <span class="pill info" style="margin-left:6px;" title="@o.Item">+@(o.LineCount - 1)</span> }</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Property="Name" Title='@T("품명", "Description", "Descripción")'><Template Context="o"><span title="@o.Name">@(o.Lines.FirstOrDefault()?.Name)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Property="LineCount" Title='@T("품목 수", "Lines", "Líneas")' TextAlign="TextAlign.Right" Width="90px" />
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Title='@T("발주수량", "Ordered", "Pedidos")' TextAlign="TextAlign.Right" Width="140px"><Template Context="o">@Quantities(o, l => l.Quantity)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Title='@T("입고수량", "Received", "Recibidos")' TextAlign="TextAlign.Right" Width="140px"><Template Context="o">@Quantities(o, l => Store.Delivered(o, l))</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Title='@T("미납수량", "Remaining", "Pendientes")' TextAlign="TextAlign.Right" Width="140px"><Template Context="o">@Quantities(o, l => Store.Remaining(o, l))</Template></RadzenDataGridColumn>
                    @if (Mode != "Due") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Property="Due" Title='@T("납기일", "Due date", "Vencimiento")' TextAlign="TextAlign.Center" Width="120px"><Template Context="o">@o.Due.ToString(DateFmt.Date)</Template></RadzenDataGridColumn> }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Title='@T("상태", "Status", "Estado")' TextAlign="TextAlign.Center" Width="110px"><Template Context="o"><span class="pill @Badge(o.Status)">@Status(o.Status)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Title='@T("수주 확인", "Supplier confirmation", "Confirmación")' Width="130px"><Template Context="o">@ConfirmationLabel(o)</Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </div>

    @* ── 발주 상세 ─────────────────────────────────────────────────── *@
    @if (_selected is not null && _delivery is null && _edit is null)
    {
        <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
            <div class="ames-modal ames-modal-wide scm-order-detail" @onmousedown:stopPropagation @onclick:stopPropagation>
                <div class="ames-modal-h">
                    @T("발주 상세", "Order details", "Detalle del pedido") <span class="code" style="font-weight:400;font-size:.9em;">@_selected.Number</span>
                    <span class="pill @Badge(_selected.Status)" style="margin-left:8px;">@Status(_selected.Status)</span>
                </div>

            @if (_confirmPrompt && CanConfirmOrder)
            {
                <div class="scm-act" role="group" aria-label="수주 확인 안내" style="padding:16px">
                    <span>@_selected.Number · @T("품목·수량·납기를 확인하고 수주를 확정하시겠습니까?", "Confirm acceptance of the listed items, quantities and due date?", "¿Confirmar artículos, cantidades y fecha?")</span>
                    <RadzenButton Text="@T("확인 저장", "Save confirmation", "Guardar confirmación")" Click="ConfirmOrder" />
                    <RadzenButton Text="@T("취소", "Cancel", "Cancelar")" Click="@(() => _confirmPrompt = false)" ButtonStyle="ButtonStyle.Light" />
                </div>
            }
<div class="scm-dgrid">                <div class="scm-dt"><div class="scm-dl">@T("수주 확인", "Supplier confirmation", "Confirmación")</div><div class="scm-dv">@ConfirmationLabel(_selected)</div></div>
                @if (_selected.SupplierConfirmedAt is not null)
                {
                    <div class="scm-dt"><div class="scm-dl">@T("확인자", "Confirmed by", "Confirmado por")</div><div class="scm-dv">@_selected.SupplierConfirmedBy</div></div>
                    <div class="scm-dt"><div class="scm-dl">@T("확인일시", "Confirmed at", "Fecha de confirmación")</div><div class="scm-dv">@_selected.SupplierConfirmedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</div></div>
                }

                    <div class="scm-dt"><div class="scm-dl">@T("발주처", "Buyer", "Comprador")</div><div class="scm-dv">EOS</div></div>
                    <div class="scm-dt"><div class="scm-dl">@T("협력업체", "Supplier", "Proveedor")</div><div class="scm-dv">@VendorLabel(_selected.Vendor)</div></div>
                    <div class="scm-dt"><div class="scm-dl">@T("발주일", "Order date", "Fecha")</div><div class="scm-dv">@_selected.Ordered.ToString(DateFmt.Date)</div></div>
                    <div class="scm-dt"><div class="scm-dl">@T("납기일", "Due date", "Vencimiento")</div><div class="scm-dv">@_selected.Due.ToString(DateFmt.Date)</div></div>
                    <div class="scm-dt"><div class="scm-dl">@T("납품장소", "Destination", "Destino")</div><div class="scm-dv">@_selected.Destination</div></div>
                    <div class="scm-dt"><div class="scm-dl">@T("금액", "Amount", "Importe") (@_selected.Currency)</div><div class="scm-dv">@_selected.Amount.ToString("N2")</div></div>
                </div>

                <div class="scm-dsub">@T("발주 품목", "Order lines", "Líneas del pedido") · @_selected.LineCount</div>
                <div class="scm-scroll">
                    <table class="ames-table">
                        <thead><tr><th>@T("품번", "Item", "Artículo")</th><th>@T("품명", "Description", "Descripción")</th><th>@T("단위", "Unit", "Unidad")</th><th class="num">@T("발주수량", "Ordered", "Pedidos")</th><th class="num">@T("입고수량", "Received", "Recibidos")</th><th class="num">@T("미납수량", "Remaining", "Pendientes")</th><th class="num">@T("단가", "Unit price", "Precio") (@_selected.Currency)</th><th class="num">@T("금액", "Amount", "Importe") (@_selected.Currency)</th></tr></thead>
                        <tbody>
                        @foreach (var line in _selected.Lines)
                        {
                            <tr><td class="code">@line.Item</td><td>@line.Name</td><td>@line.Unit</td><td class="num">@QuantityText(line.Quantity, line.Unit, 2)</td><td class="num">@QuantityText(Store.Delivered(_selected, line), line.Unit, 2)</td><td class="num">@QuantityText(Store.Remaining(_selected, line), line.Unit, 2)</td><td class="num">@line.Price.ToString("N2")</td><td class="num">@line.Amount.ToString("N2")</td></tr>
                        }
                        </tbody>
                    </table>
                </div>

            @if (CanRegisterDelivery)
            {
                <div class="scm-act">
                    <label>@T("납품 예정일", "Expected delivery date", "Fecha prevista")<RadzenDatePicker TValue="DateTime" Value="_deliveryDate" ValueChanged="ChangeDeliveryDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" /></label>
                    <span>@T("등록할 품목을 선택하고 수량을 입력하세요. 분할 납품이 가능합니다.", "Select items and quantities. Partial deliveries are supported.", "Seleccione artículos y cantidades. Se permiten entregas parciales.")</span>
                </div>
                <div class="scm-scroll">
                    <table class="ames-table scm-lines scm-delivery-entry">
                        <thead><tr><th>@T("선택", "Select", "Elegir")</th><th>@T("품번", "Item", "Artículo")</th><th>@T("품명", "Description", "Descripción")</th><th>@T("단위", "Unit", "Unidad")</th><th>@T("기등록 미입고", "Pending receipt", "Pendiente recepción")</th><th>@T("등록 가능", "Available", "Disponible")</th><th>@T("적입량", "Packing quantity", "Cantidad por caja")</th><th>@T("이번 납품수량", "Delivery quantity", "Cantidad")</th><th>@T("박스수량", "Boxes", "Cajas")</th><th>@T("업체 LOT", "Vendor LOT", "Lote proveedor") / @T("제조일자", "Production date", "Fecha de producción")</th></tr></thead>
                        <tbody>
                            @foreach (var entry in _deliveryEntries)
                            {
                                <tr @key="entry.Line.PoID">
                                    <td><input type="checkbox" aria-label="@($"{entry.Line.Item} 선택")" @bind="entry.Selected" /></td>
                                    <td>@entry.Line.Item</td><td>@entry.Line.Name</td><td>@entry.Line.Unit</td>
                                    <td>@QuantityText(entry.Line.PendingDelivery, entry.Line.Unit, 3)</td><td>@QuantityText(entry.Line.AvailableDelivery, entry.Line.Unit, 3)</td>
                                    <td class="num">@(entry.PackingQty is > 0 ? QtyFormat.Text(entry.PackingQty.Value,entry.Line.Unit) : T("미등록","Not set","Sin registrar"))</td>
                                    <td><RadzenNumeric TValue="decimal" class="ames-rz-input scm-number" @oninput="@(e=>UpdateDeliveryQuantity(entry,e))" aria-label="@($"{entry.Line.Item} 납품수량")" Min="0.001m" Step="0.001" Max="@entry.Line.AvailableDelivery" Disabled="@(!entry.Selected)" @bind-Value="entry.Quantity" Format="@QtyFormat.Format(entry.Line.Unit)" ShowUpDown="false" /></td>
                                    <td class="scm-box-count"><strong>@(entry.BoxCount?.ToString("N0") ?? "—")</strong>
                                    </td>
                                <td class="scm-trace-fields"><input class="ames-input" aria-label="@(entry.Line.Item + " 업체 LOT")" maxlength="30" @bind="entry.VendorLotNo" disabled="@(!entry.Selected)" />
                                    <RadzenDatePicker TValue="DateTime" @bind-Value="entry.ProductionDate" DateFormat="@DateFmt.Date" Disabled="@(!entry.Selected)" InputSize="InputSize.Small" class="ames-rz-input" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="dim scm-packing-hint">@T("박스수량은 납품수량 ÷ 적입량을 올림하여 계산합니다. 적입량이 없거나 0인 품목은 등록할 수 없습니다.", "Boxes are rounded up from quantity divided by packing quantity. Items without a positive packing quantity cannot be registered.", "Las cajas se calculan redondeando hacia arriba. Se requiere una cantidad por caja positiva.")</div>
                @if(_packingError.Length>0) { <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@_packingError</RadzenAlert> }
                <div class="scm-act"><RadzenButton Text='@T("납품서 등록", "Create delivery", "Crear entrega")' Icon="add" Click="CreateDelivery" /></div>
            }
                <div class="scm-dsub">@T("관련 납품서", "Related deliveries", "Entregas relacionadas")</div>
                <div class="scm-log">
                    @foreach (var d in Store.Deliveries.Where(d => d.OrderNumber == _selected.Number))
                    { <div><span class="code">@d.Number</span> · @d.Date.ToString(DateFmt.Date) · @QuantityText(d.Quantity, d.Unit, 3) @d.Unit · @d.Item · @Status(d.Status)</div> }
                    @if (!Store.Deliveries.Any(d => d.OrderNumber == _selected.Number)) { <div class="dim">@Empty</div> }
                </div>

                @if (!string.IsNullOrEmpty(_message)) { <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false">@_message</RadzenAlert> }

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                    @if (!IsPortal && Mode == "Orders" && CanEdit && _selected.Status == "Draft")
                    {
                        <RadzenButton Text='@T("수정", "Edit", "Editar")' Icon="edit" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="EditOrder" class="ames-rz-btn" />
                        @if (CanApprove) { <RadzenButton Text='@T("발행", "Publish", "Publicar")' Icon="send" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click='@(() => ChangeStatus("Published"))' class="ames-rz-btn" /> }
                    }
                    @if (!IsPortal && Mode == "Orders" && CanEdit && _selected.Status is "Draft" or "Published" && Store.Delivered(_selected) == 0)
                    { <RadzenButton Text='@T("발주 취소", "Cancel order", "Cancelar pedido")' Icon="block" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='@(() => ChangeStatus("Cancelled"))' class="ames-rz-btn" /> }
                    @if (CanConfirmOrder)
                    { <RadzenButton Text="@(_adminPreview ? T("대리 수주 확인", "Confirm on behalf", "Confirmar en representación") : T("수주 확인", "Confirm order", "Confirmar pedido"))" Icon="task_alt" Click="@(() => _confirmPrompt=true)" class="ames-rz-btn" /> }
                    <RadzenButton Text='@T("닫기", "Close", "Cerrar")' Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="CloseDetail" class="ames-rz-btn" />
                </RadzenStack>
            </div>
        </div>
    }

    @* ── 납품서 상세 ───────────────────────────────────────────────── *@
    @if (_delivery is not null)
    {
        <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick"><div class="ames-modal ames-modal-wide scm-delivery-detail" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@_delivery.Number · @T("납품서 상세", "Delivery details", "Detalle de entrega")</div>
            <div class="scm-act">
                <label>@T("납품일", "Delivery date", "Fecha de entrega")<RadzenDatePicker TValue="DateTime" Value="_delivery.Date" ValueChanged="ChangeEditedDeliveryDate" DateFormat="@DateFmt.Date" Disabled="@(!DeliveryEditable)" InputSize="InputSize.Small" class="ames-rz-input" /></label>

                @if (DeliveryEditable)
                {
                    <RadzenButton Text='@T("출하 확정", "Confirm shipment", "Confirmar envío")' ButtonStyle="ButtonStyle.Success" Click="OpenShipPrompt" />
                    <RadzenButton Text='@T("수정 저장", "Save changes", "Guardar cambios")' Click="SaveDelivery" />
                    <RadzenButton Text='@T("납품 취소", "Cancel delivery", "Cancelar entrega")' ButtonStyle="ButtonStyle.Danger" Click="@(() => _cancelDeliveryPrompt=true)" />
                }
            </div>
            @if (IsPortal && (_adminPreview || _isExternalPortalUser) && _delivery.Status is ("Shipped" or "Received"))
            {
                <div class="scm-act"><RadzenButton Text='@T("딜리버리 노트 발행 / 재출력", "Issue / reprint delivery note", "Emitir / reimprimir nota de entrega")' Icon="print" Click="OpenDeliveryNote" /></div>
            }
            @if (_delivery.ShippedAt is not null)
            {
                <div class="scm-act"><span>@T("출하일", "Ship date", "Fecha de envío"): @_delivery.ShipDate?.ToString("yyyy-MM-dd")</span>
                    <span>@T("출하 처리자", "Shipped by", "Enviado por"): @_delivery.ShippedBy</span>
                    <span>@T("확정일시", "Confirmed at", "Confirmado el"): @_delivery.ShippedAt?.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
            }
            @if (_shipDeliveryPrompt && DeliveryEditable)
            {
                <div class="scm-act">
                    <label>@T("실제 출하일", "Actual ship date", "Fecha real de envío")<RadzenDatePicker TValue="DateTime" @bind-Value="_shipDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" /></label>
                    <span>@T("저장된 납품서 전체 품목을 출하 확정합니다. 이후 수정·취소할 수 없습니다.", "Confirm shipment of all saved delivery lines. Editing and cancellation will be locked.", "Confirmar todas las líneas guardadas. No se podrá editar ni cancelar.")</span>
                    <RadzenButton Text='@T("출하 확정 저장", "Save shipment", "Guardar envío")' Click="ShipDelivery" />
                    <RadzenButton Text='@T("돌아가기", "Back", "Volver")' ButtonStyle="ButtonStyle.Light" Click="@(() => _shipDeliveryPrompt=false)" />
                </div>
            }
            @if (_cancelDeliveryPrompt && DeliveryEditable)
            {
                <div class="scm-act"><span>@T("납품서 전체를 취소하고 등록 가능 잔량을 복원합니다.", "Cancel the entire delivery and release its reserved quantities.", "Cancelar toda la entrega y liberar cantidades.")</span>
                    <RadzenButton Text='@T("취소 확정", "Confirm cancellation", "Confirmar cancelación")' ButtonStyle="ButtonStyle.Danger" Click="CancelDelivery" />
                    <RadzenButton Text='@T("돌아가기", "Back", "Volver")' ButtonStyle="ButtonStyle.Light" Click="@(() => _cancelDeliveryPrompt=false)" />
                </div>
            }
            <div class="scm-scroll"><table class="ames-table scm-lines">
                <thead><tr><th>@T("품번", "Item", "Artículo")</th><th>@T("단위", "Unit", "Unidad")</th>@if (DeliveryEditable) { <th>@T("수정 가능 최대수량", "Maximum quantity", "Cantidad máxima")</th> }<th>@T("납품수량", "Quantity", "Cantidad")</th><th>@T("업체 LOT", "Vendor LOT", "Lote proveedor")</th><th>@T("제조일자", "Production date", "Fecha de producción")</th></tr></thead>
                <tbody>@foreach(var line in _deliveryEditLines)
                {
                    <tr @key="line.PoID"><td data-label="품번">@line.Item</td><td data-label="단위">@line.Unit</td>@if (DeliveryEditable) { <td data-label="수정 가능 최대수량">@QuantityText(EditableDeliveryBalance(line), line.Unit, 3)</td> }
                        <td data-label="납품수량">@if (DeliveryEditable) { <RadzenNumeric TValue="decimal" class="ames-rz-input scm-number" aria-label="@($"{line.Item} 수정수량")" Min="0.001m" Step="0.001" @bind-Value="line.Quantity" Format="@QtyFormat.Format(line.Unit)" ShowUpDown="false" /> } else { @QuantityText(line.Quantity, line.Unit, 3) }</td><td data-label="업체 LOT"><input class="ames-input" maxlength="30" aria-label="@(line.Item + " 업체 LOT")" @bind="line.VendorLotNo" disabled="@(!DeliveryEditable)" /></td>
                        <td data-label="제조일자"><RadzenDatePicker TValue="DateTime" @bind-Value="line.ProductionDate" DateFormat="@DateFmt.Date" Disabled="@(!DeliveryEditable)" InputSize="InputSize.Small" class="ames-rz-input" /></td></tr>
                }</tbody>
            </table></div>
            @if (!DeliveryEditable) { <div class="scm-act">@T("출하 확정·취소되었거나 입고가 진행된 납품서는 수정할 수 없습니다.", "Shipped, cancelled or receiving deliveries cannot be edited.", "No se pueden editar entregas canceladas o recibidas.")</div> }
            @if (!string.IsNullOrEmpty(_message)) { <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">@_message</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="ames-modal-footer"><RadzenButton Text='@T("닫기", "Close", "Cerrar")' Icon="close" Click="CloseDetail" ButtonStyle="ButtonStyle.Base" /></RadzenStack>
        </div></div>
    }
    @* ── 발주 작성 ─────────────────────────────────────────────────── *@
    @if (_edit is not null)
    {
        <div class="ames-modal-bg">
            <div class="ames-modal ames-modal-wide scm-editor" role="dialog" aria-modal="true" aria-labelledby="scm-edit-title">
                <div class="ames-modal-h" id="scm-edit-title">@T("발주 작성", "Order editor", "Editor de pedido") <span class="code" style="font-weight:400;font-size:.9em;">@(string.IsNullOrEmpty(_edit.Number) ? T("저장 시 자동 발급", "Assigned on save", "Se asigna al guardar") : _edit.Number)</span></div>
                <RadzenRow Gap="8px">
                    <RadzenColumn Size="4">
                        <RadzenLabel Text='@T("협력업체", "Supplier", "Proveedor")' />
                        <RadzenDropDown @bind-Value="_edit.Vendor" @bind-Value:after="ChangeVendor" Data="@VendorEditOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@T("업체 선택", "Select vendor", "Seleccione proveedor")' AllowFiltering="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenLabel Text='@T("납기일", "Due date", "Vencimiento")' />
                        <RadzenDatePicker TValue="DateTime" @bind-Value="_edit.Due" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="5">
                        <RadzenLabel Text='@T("납품장소", "Destination", "Destino")' />
                        <RadzenTextBox @bind-Value="_edit.Destination" MaxLength="200" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>
                <div class="scm-dsub scm-line-toolbar">
                    <span>@T("발주 품목", "Order lines", "Líneas del pedido") · @_edit.Lines.Count</span>
                    <RadzenButton Text='@T("품목 추가", "Add item", "Añadir artículo")' Icon="add" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="AddLine" class="ames-rz-btn" />
                </div>
                <div class="scm-scroll">
                    <table class="ames-table scm-lines">
                        <thead><tr>
                            <th>#</th><th>@T("발주 품목 (MATERIAL)", "Order item (MATERIAL)", "Artículo (MATERIAL)")</th>
                            <th>@T("단위", "Unit", "Unidad")</th><th>@T("수량", "Quantity", "Cantidad")</th>
                            <th>@T("단가 (USD)", "Unit price (USD)", "Precio (USD)")</th>
                            <th class="num">@T("금액 (USD)", "Amount (USD)", "Importe (USD)")</th><th></th>
                        </tr></thead>
                        <tbody>
                        @foreach (var line in _edit.Lines)
                        {
                            <tr @key="line.Id">
                                <td class="dim">@(_edit.Lines.IndexOf(line) + 1)</td>
                                <td>
                                    <RadzenDropDown TValue="string" @bind-Value="line.Item" @bind-Value:after="() => SelectMaterial(line)"
                                        Data="@MaterialOptions" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" Disabled="@(_materials.Count == 0)"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowClear="true"
                                        Placeholder='@T("품번·품명 검색", "Search item / description", "Buscar artículo")'
                                        InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                                    <div class="dim">@line.Name</div>
                                </td>
                                <td data-label="단위">@line.Unit</td>
                                <td><RadzenNumeric TValue="decimal" @bind-Value="line.Quantity" Min="0.001m" Step="1" aria-label='@($"{T("수량", "Quantity", "Cantidad")} {line.Id}")' InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" /></td>
                                <td><RadzenNumeric TValue="decimal" @bind-Value="line.Price" Min="0" Step="0.01" aria-label='@($"{T("단가", "Unit price", "Precio")} {line.Id}")' InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" /></td>
                                <td class="num">@line.Amount.ToString("N2")</td>
                                <td><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => RemoveLine(line))" Disabled="@(_edit.Lines.Count == 1)" title='@T("삭제", "Remove", "Eliminar")' class="ames-rz-btn" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="scm-total">@T("합계 (USD)", "Total (USD)", "Total (USD)") <strong>@_edit.Amount.ToString("N2")</strong></div>
                @if (!string.IsNullOrEmpty(_error)) { <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@_error</RadzenAlert> }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                    <RadzenButton Text='@T("저장", "Save", "Guardar")' Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="SaveOrder" class="ames-rz-btn" />
                    <RadzenButton Text='@T("닫기", "Close", "Cerrar")' Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(() => _edit = null)" class="ames-rz-btn" />
                </RadzenStack>
            </div>
        </div>
    }
}
@code {
    string QuantityText(decimal quantity,string unit,int digits) => UomFmt.Qty(quantity,unit);
    // ── 화면 구성(표준 화면과 같은 목록·모달) ─────────────────────────
    RadzenDataGrid<ScmPreviewStore.Order>? _orderGrid;
    RadzenDataGrid<ScmPreviewStore.Delivery>? _deliveryGrid;
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    int _pageRows = 25;   // 고정 페이저: 본문 높이 = 헤더 + 페이지 행 수 × 행 높이(.ames-grid-fixed)
    bool _bgMouseDownOnSelf;
    string PagerSummary => L["Pager.Summary"];
    string PagerSize => L["Pager.PageSize"];
    public record Opt(string Value, string Text);
    public record LineOpt(int Id, string Text);
    IEnumerable<Opt> VendorFilterOptions => _vendors.Select(v => new Opt(v.VendorID, $"[{v.VendorID}] {v.VendorName}"));
    IEnumerable<Opt> VendorEditOptions => _vendors.Where(v => v.ActiveFlag).Select(v => new Opt(v.VendorID, $"[{v.VendorID}] {v.VendorName}"));
    IEnumerable<Opt> StatusFilterOptions => OrderStatuses.Select(x => new Opt(x, Status(x)));
    IEnumerable<LineOpt> DeliveryLineOptions => _selected is null ? [] : _selected.Lines.Where(l => Store.Remaining(_selected, l) > 0).Select(l => new LineOpt(l.Id, $"{l.Item} · {l.Name}"));
    string VendorName(string vendorId) => _vendors.Find(x => x.VendorID == vendorId)?.VendorName ?? _dbOrders.FirstOrDefault(o => o.Vendor == vendorId)?.VendorName ?? "";
    static void RowLinkOrder(RowRenderEventArgs<ScmPreviewStore.Order> args) => args.Attributes["class"] = (args.Attributes.TryGetValue("class", out var c) ? c + " " : "") + "ames-row-link";
    static void RowLinkDelivery(RowRenderEventArgs<ScmPreviewStore.Delivery> args) => args.Attributes["class"] = (args.Attributes.TryGetValue("class", out var c) ? c + " " : "") + "ames-row-link";
    void CloseDetail() { _selected = null; _delivery = null; _message = ""; }
    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseDetail(); _bgMouseDownOnSelf = false; }

    [Parameter] public string ScreenCode { get; set; } = "";
    [Parameter] public string Href { get; set; } = "";
    [Parameter] public string Mode { get; set; } = "Orders";
    [Parameter] public bool IsPortal { get; set; }
    bool _ready;
    string _search = "", _vendor = "", _status = "", _message = "", _error = "";
    DateTime? _from, _to;
    DateTime _deliveryDate = DbClock.Today;
    decimal _deliveryQuantity = 1;
    int _deliveryLineId;
    ScmPreviewStore.Order? _selected, _edit;
    ScmPreviewStore.Delivery? _delivery;
    List<MasterDataRepository.ItemRow> _materials = new();
    public record MaterialOption(string Value, string Text);
    IEnumerable<MaterialOption> MaterialOptions => _materials.Select(x => new MaterialOption(x.ItemNo, $"{x.ItemNo} · {x.ItemName}"));
    bool CanEdit => !IsPortal && Permissions.CanEdit(Href);
    bool CanConfirmOrder => IsPortal && Mode == "Orders"
        && (_adminPreview || _isExternalPortalUser) && !string.IsNullOrEmpty(_portalUserId)
        && _selected is { SupplierConfirmedAt: null, Status: "Published" or "Confirmed" };
    string ConfirmationLabel(ScmPreviewStore.Order o) => o.SupplierConfirmedAt.HasValue
        ? T("확인 완료", "Confirmed", "Confirmado") : o.Status is "Published" or "Confirmed"
        ? T("확인 대기", "Awaiting confirmation", "Pendiente") : "—";
    bool CanApprove => Permissions.CanApprove(Href);
    bool DeliveryEditable => IsPortal && Mode == "Deliveries"
        && (_adminPreview || _isExternalPortalUser) && !string.IsNullOrEmpty(_portalUserId)
        && _delivery?.Status == "Registered" && _deliveryEditLines.All(l=>l.Received==0);
    string Empty => T("조회 결과가 없습니다.", "No results.", "Sin resultados.");
    IEnumerable<string> OrderStatuses => Mode == "Deliveries" ? ["Registered", "Shipped", "Received", "Cancelled"] : IsPortal ? ["Published", "Confirmed", "Closed", "Cancelled"] : ["Draft", "Published", "Confirmed", "Closed", "Cancelled"];
    string Title => Mode switch {
        "Orders" => IsPortal ? T("발주 조회·수주 확인", "Orders & confirmation", "Pedidos y confirmación") : T("구매발주 관리", "Purchase orders", "Pedidos de compra"),
        "Progress" => T("발주 진행 현황", "Order progress", "Seguimiento de pedidos"),
        "Due" => T("납기별 발주 현황", "Orders by due date", "Pedidos por vencimiento"),
        "Entry" => T("납품서 등록", "Create delivery", "Crear entrega"),
        "Deliveries" => T("납품서 조회·수정", "Delivery notes", "Albaranes"),
        _ => T("입고·검수 결과", "Receipt & inspection", "Recepción e inspección")
    };
    List<ScmPreviewStore.Order> Rows => _dbOrders
        .Where(o => Mode != "Entry" || o.SupplierConfirmedAt.HasValue && (o.Status is "Published" or "Confirmed") && o.Lines.Any(l => l.AvailableDelivery > 0))
        .Where(o => (string.IsNullOrEmpty(_vendor) || o.Vendor == _vendor) && (string.IsNullOrEmpty(_status) || o.Status == _status))
        .Where(o => _from <= _to || _from == null || _to == null)
        .Where(o => (!_from.HasValue || o.Due >= _from) && (!_to.HasValue || o.Due <= _to))
        .Where(o => string.IsNullOrWhiteSpace(_search) || (o.Number + " " + o.Item + " " + o.Name).Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(o => Mode == "Due" ? o.Due : o.Ordered).ThenBy(o => o.Number).ToList();
    List<ScmPreviewStore.Delivery> DeliveryRows => Store.Deliveries
        .Where(d=>_dbOrders.Any(o=>o.Number==d.OrderNumber))
        .Where(d=>string.IsNullOrEmpty(_status) || d.Status==_status)
        .Where(d=>(!_from.HasValue || d.Date>=_from) && (!_to.HasValue || d.Date<=_to))
        .Where(d=>Mode!="Receipts" || d.Status=="Inspected")
        .GroupBy(d=>d.Number)
        .Where(g=>string.IsNullOrWhiteSpace(_search) || g.Any(d=>(d.Number+" "+d.OrderNumber+" "+d.Item).Contains(_search,StringComparison.OrdinalIgnoreCase)))
        .Select(g=> {var d=g.First().Copy();d.Item=string.Join(", ",g.Select(x=>x.Item));return d;}).ToList();
    string DeliveryQuantities(string number) => string.Join(" / ",Store.Deliveries.Where(d=>d.Number==number)
        .GroupBy(d=>d.Unit).Select(g=>$"{QuantityText(g.Sum(d=>d.Quantity),g.Key,3)} {g.Key}"));
    protected override async Task OnParametersSetAsync()
    {
        _ready = false;
        await Permissions.EnsureAsync(Authentication);
        if (!IsPortal && !Permissions.IsVisible(Href)) { Nav.NavigateTo("/unauthorized"); return; }
        Reset();
        if (!IsPortal && !LoadVendors()) _message = _error;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _actor = ActorCode.Of(user);
        _portalUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _adminPreview = PortalAuth.IsInternalUser(user) && user.IsInRole("Admin");
        _isExternalPortalUser = PortalAuth.IsPortalUser(user);
        ReloadOrders();
        _ready = true;
    }
    void Reset() { _confirmPrompt = false; _search = _vendor = _status = _message = ""; _from = _to = null; _selected = _edit = null; _delivery = null; if (_ready) ReloadOrders(); }
    void Select(ScmPreviewStore.Order o) { _confirmPrompt = false; _selected = o; _delivery = null; _deliveryLineId = o.Lines.FirstOrDefault(l => Store.Remaining(o, l) > 0)?.Id ?? 0; SelectDeliveryLine(); PrepareDelivery(); _message = ""; }
    List<ScmPreviewStore.Delivery> _deliveryEditLines = new();
    bool _cancelDeliveryPrompt, _shipDeliveryPrompt;
    DateTime _shipDate=DbClock.Today;
    void OpenDeliveryNote() => Nav.NavigateTo("/portal/delivery-notes");
    void SelectDelivery(ScmPreviewStore.Delivery d)
    {
        _selected = _dbOrders.First(o => o.Number == d.OrderNumber);
        _delivery = d.Copy();
        _deliveryEditLines=Store.Deliveries.Where(x=>x.Number==d.Number).Select(x=>x.Copy()).ToList();
        _cancelDeliveryPrompt=false; _shipDeliveryPrompt=false; _shipDate=DbClock.Today; _message="";
    }
    decimal EditableDeliveryBalance(ScmPreviewStore.Delivery d)
    {
        var line=_selected?.Lines.Find(l=>l.PoID==d.PoID);
        var original=Store.Deliveries.FirstOrDefault(x=>x.Number==d.Number && x.PoID==d.PoID);
        return line is null ? 0 : Math.Max(0, line.Quantity-line.Received-line.PendingDelivery+(original is { Status: not "Cancelled" } ? original.Quantity-original.Received : 0));
    }
    bool LoadMaterials(string vendorId)
    {
        _materials.Clear();
        if (string.IsNullOrWhiteSpace(vendorId))
        {
            _error = T("협력업체를 먼저 선택하세요.", "Select a vendor first.", "Seleccione primero un proveedor.");
            return true;
        }
        try
        {
            var itemNos = Scm.ListItemVendors().Where(x => x.VendorID == vendorId && x.VendorActive)
                .Select(x => x.ItemNo).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _materials = MasterData.ListItems(itemType: "MATERIAL").Where(x => itemNos.Contains(x.ItemNo)).ToList();
            _error = _materials.Count == 0 ? T("이 업체에 연결된 MATERIAL 품목이 없습니다. SCM-003 발주품목 관리에서 업체를 연결하세요.", "No MATERIAL items linked to this vendor. Add mappings in SCM-003.", "No hay artículos MATERIAL vinculados. Configure los vínculos en SCM-003.") : "";
            return true;
        }
        catch (Exception ex)
        {
            _materials.Clear();
            Logger.LogError(ex, "Failed to load SCM MATERIAL items");
            _error = T("품목 조회에 실패했습니다. 다시 시도하세요.", "Unable to load items. Please retry.", "No se pudieron cargar los artículos. Inténtelo de nuevo.");
            return false;
        }
    }
    List<MasterDataRepository.VendorRow> _vendors = new();
    string VendorLabel(string vendorId)
    {
        var vendor = _vendors.Find(x => x.VendorID == vendorId);
        var name = vendor?.VendorName ?? _dbOrders.FirstOrDefault(o => o.Vendor == vendorId)?.VendorName;
        return string.IsNullOrWhiteSpace(name) ? vendorId : $"{vendorId} · {name}";
