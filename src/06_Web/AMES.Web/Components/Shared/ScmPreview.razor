    IEnumerable<Opt> CreatorFilterOptions => _creators.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Select(x => new Opt(x, Actors.Display(x))).OrderBy(x => x.Text);
    IEnumerable<Opt> VendorEditOptions => _vendors.Where(v => v.ActiveFlag).Select(v => new Opt(v.VendorID, $"[{v.VendorID}] {v.VendorName}"));
    IEnumerable<Opt> StatusFilterOptions => OrderStatuses.Select(x => new Opt(x, Status(x)));
    IEnumerable<LineOpt> DeliveryLineOptions => _selected is null ? [] : _selected.Lines.Where(l => Store.Remaining(_selected, l) > 0).Select(l => new LineOpt(l.Id, $"{l.Item} · {l.Name}"));
    string VendorName(string vendorId) => _vendors.Find(x => x.VendorID == vendorId)?.VendorName ?? _dbOrders.FirstOrDefault(o => o.Vendor == vendorId)?.VendorName ?? "";
    static void RowLinkOrder(RowRenderEventArgs<ScmPreviewStore.Order> args) => args.Attributes["class"] = (args.Attributes.TryGetValue("class", out var c) ? c + " " : "") + "ames-row-link";
    static void RowLinkDelivery(RowRenderEventArgs<ScmPreviewStore.Delivery> args) => args.Attributes["class"] = (args.Attributes.TryGetValue("class", out var c) ? c + " " : "") + "ames-row-link";
    void CloseDetail() { if(_orderBusy)return; _selected = null; _delivery = null; _message = ""; }
    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseDetail(); _bgMouseDownOnSelf = false; }

    [Parameter] public string ScreenCode { get; set; } = "";
    [Parameter] public string Href { get; set; } = "";
    [Parameter] public string Mode { get; set; } = "Orders";
    [Parameter] public bool IsPortal { get; set; }
    bool _ready;
    Dictionary<string,ScmRepository.NoteDeliveryChoice> _noteDeliveries=new(StringComparer.OrdinalIgnoreCase);
    bool _noteBusy;
    List<ScmRepository.PortalReceiptLine> _portalReceipts=[];
    List<ScmRepository.PortalDiscrepancy> _portalMismatches=[];
    string _receiptError="";
    bool _showMismatch;
    ScmPreviewStore.Delivery? _printingDelivery;
    string? _previewUrl;
    List<ScmRepository.DeliveryCase> _printingCases=[];
    string _printingError="";
    Task OpenPrinting(ScmPreviewStore.Delivery delivery) => OpenPrintingGroup(new PortalNoteRow(NoteNumber(delivery.Number),[delivery]));
    async Task OpenPrintingGroup(PortalNoteRow note)
    {
        if(!IsPortal || Mode!="Deliveries" || !_isExternalPortalUser || string.IsNullOrEmpty(_portalUserId))return;
        var first=note.Deliveries.FirstOrDefault(d=>d.Status!="Cancelled");
        if(first is null)return;
        _printingDelivery=first;_printingNote=note;_printingCases=[];_printingError="";_message="";_previewUrl=null;
        try
        {
            var cases=await Task.Run(()=>note.Deliveries.Where(d=>d.Status!="Cancelled")
                .SelectMany(d=>Scm.ListDeliveryCases(null,_portalUserId!,delivery:d.Number)).DistinctBy(c=>c.Number)
                .OrderBy(c=>c.CreatedAt).ThenBy(c=>c.Number).ToList());
            if(_printingNote==note)_printingCases=cases;
        }
        catch(Exception ex) { Logger.LogWarning(ex,"Print case list failed"); if(_printingNote==note)_printingError=L["SCM.Preview.Err.LoadCases"]; }
    }
    void OpenPreview(string url) => _previewUrl=url;
    void OpenCasePreview(string number) => OpenPreview("/portal/case-label/"+Uri.EscapeDataString(number));
    void OpenNote(string number) => OpenPreview("/portal/delivery-note/"+Uri.EscapeDataString(number));
    void LoadNotes()
    {
        _noteDeliveries.Clear();
        if(!IsPortal || Mode!="Deliveries" || !_isExternalPortalUser || string.IsNullOrEmpty(_portalUserId))return;
        try { _noteDeliveries=Scm.ListNoteDeliveries(_portalUserId).ToDictionary(x=>x.Number,StringComparer.OrdinalIgnoreCase); }
        catch(Exception ex) { Logger.LogWarning(ex,"Delivery notes load failed");_message=L["Portal.Text.UnableToLoadTheList"]; }
    }
    void IssueNote(string number)
    {
        if(_noteBusy || !IsPortal || Mode!="Deliveries" || !_isExternalPortalUser || string.IsNullOrEmpty(_portalUserId) || string.IsNullOrEmpty(number))return;
        _noteBusy=true;_message="";
        try
        {
            var note=Scm.IssueDeliveryNote([number],_portalUserId,_actor);
            Audit.Log(ScreenCode, "ISSUE", "SCM_DeliveryNote", note.Number, null, new { note.Number, note.OrderNumber });
            LoadNotes();
            OpenNote(note.Number);
        }
        catch(Exception ex)
        {
            Logger.LogWarning(ex,"Delivery note issue failed");
            LoadNotes();
            _message=L["Portal.Text.UnableToIssueRefreshAndCheckVendorAccessAnd"];
        }
        finally { _noteBusy=false; }
    }
    string _search = "", _vendor = "", _creator = "", _status = "", _message = "", _error = "";
    bool _includeClosed = true, _includeCancelled = true;
    void ToggleClosed(bool value) { _includeClosed=value; if(!value && _status is "Received" or "Closed")_status=""; }
    void ToggleCancelled(bool value) { _includeCancelled=value; if(!value && _status is "Cancelled")_status=""; }
    DateTime? _from = DbClock.Today.AddMonths(-1), _to = DbClock.Today.AddMonths(1);
    decimal _deliveryQuantity = 1;
    int _deliveryLineId;
    ScmPreviewStore.Order? _selected, _edit;
    ScmPreviewStore.Delivery? _delivery;
    List<MasterDataRepository.ItemRow> _materials = new();
    public record MaterialOption(string Value, string Text);
    IEnumerable<MaterialOption> MaterialOptions => _materials.Select(x => new MaterialOption(x.ItemNo, $"{x.ItemNo} · {x.ItemName}"));
    bool CanEdit => !IsPortal && Permissions.CanEdit(Href);
    bool CanConfirmOrder => IsPortal && Mode == "Orders"
        && !_confirmOrderBusy
        && _isExternalPortalUser && !string.IsNullOrEmpty(_portalUserId)
        && _selected is { SupplierConfirmedAt: null, Status: "Published" or "Confirmed" };
    string ConfirmationLabel(ScmPreviewStore.Order o) => o.SupplierConfirmedAt.HasValue
        ? L["Scm.Text.Confirmed"] : o.Status is "Published" or "Confirmed"
        ? L["Scm.Text.AwaitingConfirmation.6a70d7"] : "—";
    static string ConfirmationBadge(ScmPreviewStore.Order o) => o.SupplierConfirmedAt.HasValue ? "ok" : "warn";
    bool CanApprove => Permissions.CanApprove(Href);
    bool DeliveryEditable => IsPortal && Mode == "Deliveries"
        && _isExternalPortalUser && !string.IsNullOrEmpty(_portalUserId)
        && _delivery?.Status == "Registered" && _deliveryEditLines.All(l=>l.Received==0);
    string Empty => L["Scm.Text.NoResults"];
    bool DeliveryContentEditable => DeliveryEditable && !(_delivery is not null && _noteDeliveries.TryGetValue(_delivery.Number,out var note) && note.NoteNumber is not null);
    IEnumerable<string> OrderStatuses => IsPortal && Mode=="Due" ? ["Published","Confirmed"]
        : IsPortal && Mode=="Deliveries" ? ["Registered","Shipped","PartiallyReceived",..(_includeClosed ? new[]{"Received"} : []),..(_includeCancelled ? new[]{"Cancelled"} : [])]
        : IsPortal && Mode=="Orders" ? ["Published","Shipped","PartiallyReceived",..(_includeClosed ? new[]{"Received"} : []),..(_includeCancelled ? new[]{"Cancelled"} : [])]
        : Mode == "Progress" ? ["Draft","AwaitingConfirmation","SupplierConfirmed","PreparingDelivery","Shipped","PartiallyReceived",..(_includeClosed ? new[]{"Received"} : []),..(_includeCancelled ? new[]{"Cancelled"} : [])]
        : Mode == "Deliveries" ? ["Registered", "Shipped", "Received", "Cancelled"]
        : IsPortal ? ["Published", "Confirmed", "Closed", "Cancelled"] : ["Draft", "Published", "Confirmed", "Closed", "Cancelled"];
    string Title => Mode switch {
        "Orders" => IsPortal ? L["Scm.Text.OrdersConfirmation"] : L["Scm.Text.PurchaseOrders"],
        "Progress" => L["Scm.Text.OrderProgress"],
        "Due" => IsPortal ? L["Portal.Create.Title"] : L["Scm.Text.DeliveryPreparation"],
        "Entry" => L["Scm.Text.CreateDelivery"],
        "Deliveries" => L["Scm.Text.DeliveryManagement"],
        _ => L["Scm.Text.ReceiptStatus"]
    };
    List<ScmPreviewStore.Order> Rows => _dbOrders
        .Where(o=>!IsPortal || Mode!="Orders" || (_includeClosed || PortalOrderStatus(o)!="Received") && (_includeCancelled || PortalOrderStatus(o)!="Cancelled"))
        .Where(o=>Mode!="Progress" || (_includeClosed || !ProgressReceived(o)) && (_includeCancelled || o.Status!="Cancelled"))
        .Where(o => !IsPortal || Mode!="Due" || (o.SupplierConfirmedAt.HasValue && (o.Status is "Published" or "Confirmed") && o.Lines.Any(l=>l.AvailableDelivery>0)))
        .Where(o => Mode != "Entry" || o.SupplierConfirmedAt.HasValue && (o.Status is "Published" or "Confirmed") && o.Lines.Any(l => l.AvailableDelivery > 0))
        .Where(o => (string.IsNullOrEmpty(_vendor) || o.Vendor == _vendor) && (string.IsNullOrEmpty(_creator) || o.CreatedBy == _creator) && (string.IsNullOrEmpty(_status) || (_status=="Outstanding" ? (o.Status is "Published" or "Confirmed") && o.Lines.Any(l=>l.AvailableDelivery>0) : IsPortal && Mode=="Orders" ? PortalOrderStatus(o)==_status : Mode=="Progress" ? ProgressCode(o)==_status : o.Status == _status)))
        .Where(o => _from <= _to || _from == null || _to == null)
        .Where(o => (!_from.HasValue || o.Due >= _from) && (!_to.HasValue || o.Due <= _to))
        .Where(o => string.IsNullOrWhiteSpace(_search) || (o.Number + " " + o.Item + " " + o.Name).Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(o => !IsPortal && Mode == "Due" ? o.Due : o.Ordered).ThenBy(o => o.Number).ToList();
    string? _creationOrder;
    void OpenCaseSelection() { _creationOrder=""; }
    async Task RefreshCreation() => await ReloadOrdersAsync();
    void CloseCreation() => _creationOrder=null;
    List<ScmPreviewStore.Delivery> DeliveryRows => Store.Deliveries
        .Where(d=>_dbOrders.Any(o=>o.Number==d.OrderNumber))
        .Where(d=>string.IsNullOrEmpty(_status) || d.Status==_status)
        .Where(d=>(!_from.HasValue || d.Date>=_from) && (!_to.HasValue || d.Date<=_to))
        .Where(d=>Mode!="Receipts" || d.Received>0)
        .GroupBy(d=>d.Number)
        .Where(g=>string.IsNullOrWhiteSpace(_search) || g.Any(d=>(d.Number+" "+d.OrderNumber+" "+d.Item).Contains(_search,StringComparison.OrdinalIgnoreCase)))
        .Select(g=> {var d=g.First().Copy();d.Item=string.Join(", ",g.Select(x=>x.Item));return d;}).ToList();
    sealed record PortalNoteRow(string Number,List<ScmPreviewStore.Delivery> Deliveries)
    {
        public ScmPreviewStore.Delivery First => Deliveries[0];
        public HashSet<string> Numbers => Deliveries.Select(d=>d.Number).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }
    RadzenDataGrid<PortalNoteRow>? _portalNoteGrid;
    PortalNoteRow? _selectedNote,_printingNote;
    List<PortalNoteRow> PortalNoteRows => Store.Deliveries
        .Where(d=>_dbOrders.Any(o=>o.Number==d.OrderNumber))
        .GroupBy(d=>NoteNumber(d.Number),StringComparer.OrdinalIgnoreCase)
        .Select(g=>new PortalNoteRow(g.Key,g.GroupBy(d=>d.Number,StringComparer.OrdinalIgnoreCase).Select(x=>x.First().Copy()).ToList()))
        .Where(g=>(_includeClosed || NoteStatus(g)!="Received") && (_includeCancelled || NoteStatus(g)!="Cancelled"))
        .Where(g=>string.IsNullOrEmpty(_status)||g.Deliveries.Any(d=>d.Status==_status))
        .Where(g=>g.Deliveries.Any(d=>(!_from.HasValue||d.Date>=_from)&&(!_to.HasValue||d.Date<=_to)))
        .Where(g=>string.IsNullOrWhiteSpace(_search)||g.Number.Contains(_search,StringComparison.OrdinalIgnoreCase)
            ||Store.Deliveries.Any(d=>g.Numbers.Contains(d.Number)&&(d.Number+" "+d.OrderNumber+" "+d.Item).Contains(_search,StringComparison.OrdinalIgnoreCase)))
        .OrderBy(g=>g.Deliveries.Min(d=>d.Date)).ThenBy(g=>g.Number).ToList();
    string NoteQuantities(PortalNoteRow note,Func<ScmPreviewStore.Delivery,decimal> quantity) => string.Join(" / ",Store.Deliveries
        .Where(d=>note.Numbers.Contains(d.Number)).GroupBy(d=>d.Unit).Select(g=>$"{QuantityText(g.Sum(quantity),g.Key,3)} {UomFmt.Sym(g.Key)}"));
    string PartName(int poId) => _dbOrders.SelectMany(o=>o.Lines).FirstOrDefault(l=>l.PoID==poId)?.Name ?? "";
    string NoteReceiptQuantities(PortalNoteRow note,bool received) => NoteQuantities(note,d=>received?d.Received:Math.Max(0,d.Quantity-d.Received));
    string NoteReceiptStatus(PortalNoteRow note)
    {
        if(note.Deliveries.All(d=>d.Status=="Cancelled"))return "Cancelled";
        var lines=Store.Deliveries.Where(d=>note.Numbers.Contains(d.Number) && d.Status!="Cancelled").ToList();
        if(lines.All(d=>d.Status=="Registered"))return "NotShipped";
        if(lines.All(d=>d.Received<=0))return "NotReceived";
        return lines.All(d=>d.Received>=d.Quantity) ? "Received" : "Partial";
    }
    string NoteStatus(PortalNoteRow note)
    {
        var active=note.Deliveries.Where(d=>d.Status!="Cancelled").ToList();
        if(active.Count==0) return "Cancelled";
        if(active.All(d=>d.Status=="Received")) return "Received";
        if(active.Any(d=>d.Status=="Received")) return "PartiallyReceived";
        if(active.Any(d=>d.Status=="Shipped")) return "Shipped";
        return "Registered";
    }
    List<ScmRepository.PortalDiscrepancy> NoteMismatches(PortalNoteRow note) => _portalMismatches.Where(r=>note.Numbers.Contains(r.Delivery)).OrderBy(r=>r.OccurredAt).ToList();
    static void RowLinkNote(RowRenderEventArgs<PortalNoteRow> args)=>args.Attributes["style"]="cursor:pointer";
    void SelectNote(PortalNoteRow note) { _selectedNote=note; _showMismatch=false; _cancelNoteError=""; }
    bool _cancelNoteBusy;
    string _cancelNoteError="";
    bool CanCancelNote(PortalNoteRow note) => IsPortal && Mode=="Deliveries" && _isExternalPortalUser
        && !string.IsNullOrEmpty(_portalUserId) && note.Deliveries.All(d=>d.Status is "Registered" or "Shipped")
        && Store.Deliveries.Where(d=>note.Numbers.Contains(d.Number)).All(d=>d.Received==0);
    string CancellationBlockedReason(PortalNoteRow note) => note.Deliveries.Any(d=>d.Status=="Cancelled")
        ? L["SCM.Preview.Cancellation.AlreadyCancelled"] : NoteStatus(note)=="Received"
        ? L["SCM.Preview.Cancellation.AlreadyReceived"]
        : Store.Deliveries.Any(d=>note.Numbers.Contains(d.Number) && d.Received>0)
        ? L["SCM.Preview.Cancellation.PartiallyReceived"] : L["SCM.Preview.Cancellation.NotAllowed"];
    async Task CancelNote(PortalNoteRow note)
    {
        if(_cancelNoteBusy || !CanCancelNote(note))return;
        _cancelNoteBusy=true;_cancelNoteError="";
        var versions=note.Deliveries.ToDictionary(d=>d.Number,d=>d.Version,StringComparer.OrdinalIgnoreCase);
        try
        {
            if(await Dialog.Confirm(L["SCM.Preview.Cancellation.Confirm"],L["SCM.Preview.Cancellation.Cancel"],
                new ConfirmOptions { OkButtonText=L["Lbl.Yes"],CancelButtonText=L["Msg.No"] })!=true)return;
            await Task.Run(()=>Scm.CancelSupplierDeliveryNote(note.Number,versions,_portalUserId!,_actor));
            try{Audit.Log(ScreenCode,"CANCEL","SCM_DeliveryNote",note.Number,new {Versions=versions},new {Status="Cancelled",LabelsVoided=true});}
            catch(Exception ex){Logger.LogError(ex,"Delivery note cancellation audit failed for {Note}",note.Number);}
            var refreshed=await ReloadOrdersAsync();
            if(_selectedNote==note)_selectedNote=null;
            _message=refreshed ? L["SCM.Preview.Cancellation.Done"] : L["SCM.Preview.Cancellation.ReloadFailed"];
        }
        catch(Exception ex)
        {
            Logger.LogWarning(ex,"Delivery note cancellation failed for {Note}",note.Number);
            _cancelNoteError=ex is InvalidOperationException or ArgumentException ? ex.Message : L["SCM.Preview.Cancellation.Failed"];
            if(await ReloadOrdersAsync())
            {
                if(_selectedNote?.Number==note.Number)_selectedNote=PortalNoteRows.FirstOrDefault(n=>n.Number==note.Number);
                if(_selectedNote is null)_message=_cancelNoteError;
            }
        }
        finally{_cancelNoteBusy=false;}
    }
