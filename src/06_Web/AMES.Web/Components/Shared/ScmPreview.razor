@inject PortalQuantityFormat QtyFormat
@inject ScmPreviewStore Store
@inject PermissionService Permissions
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Nav
@inject MasterDataRepository MasterData
@inject ScmRepository Scm
@inject ILogger<ScmPreview> Logger
@inject AuditLogger Audit
@inject IStringLocalizer<SharedResources> L
@inject UomFormat UomFmt
@inject DialogService Dialog
@inject ActorNames Actors
@using System.Globalization

<PageTitle>@ScreenCode @Title · AMES</PageTitle>
<AmesPageHeader Code="@ScreenCode" Title="@Title" />
@if (_ready)
{
    @if (Mode == "Deliveries")
    {
        <div class="ames-kpis">
            <div class="ames-kpi info"><div class="ames-kpi-l">@L["Scm.Text.DeliveryNotes"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count : DeliveryRows.Count)</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.Scheduled"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count(d=>NoteStatus(d)=="Registered") : DeliveryRows.Count(d=>d.Status=="Registered"))</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.Shipped"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count(d=>NoteStatus(d)=="Shipped") : DeliveryRows.Count(d=>d.Status=="Shipped"))</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.Received"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count(d=>NoteStatus(d)=="Received") : DeliveryRows.Count(d=>d.Status=="Received"))</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.Cancelled"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count(d=>NoteStatus(d)=="Cancelled") : DeliveryRows.Count(d=>d.Status=="Cancelled"))</div></div>
        </div>
    }
    else
    {
    <div class="ames-kpis">
        <div class="ames-kpi info"><div class="ames-kpi-l">@L["Portal.Home.Kpi.Orders"]</div><div class="ames-kpi-v">@Rows.Count</div></div>
        <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.AwaitingConfirmation"]</div><div class="ames-kpi-v">@Rows.Count(x => (x.Status is "Published" or "Confirmed") && x.SupplierConfirmedAt is null)</div></div>
        <div class="ames-kpi warn"><div class="ames-kpi-l">@L["Portal.Home.Kpi.InDelivery"]</div><div class="ames-kpi-v">@Rows.Count(x => x.Lines.Any(l => l.PendingDelivery > 0))</div></div>
        <div class="ames-kpi bad"><div class="ames-kpi-l">@L["Portal.Home.Kpi.Overdue"]</div><div class="ames-kpi-v">@Rows.Count(x => x.Due.Date < DbClock.Today && Store.Remaining(x) > 0 && x.Status is "Published" or "Confirmed")</div></div>
    </div>
    }
    @if (!string.IsNullOrEmpty(_message) && _selected is null && _edit is null && _delivery is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false">@_message</RadzenAlert>
    }

    @if(IsPortal && Mode=="Due" && _isExternalPortalUser)
    {
        <div class="scm-creation-actions">
            <RadzenButton Text="Create Delivery Note" Icon="description" Size="ButtonSize.Small" Click="OpenCaseSelection" />
        </div>
    }
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="white-space:nowrap;">▼ @Title · @(IsPortal && Mode=="Deliveries" ? PortalNoteRows.Count : Mode is "Deliveries" or "Receipts" ? DeliveryRows.Count : Rows.Count) @L["Scm.Text.Items"]</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="_search" Immediate="true" Placeholder='@(Mode == "Deliveries" ? L["SCM.Preview.Ph.DeliverySearch"] : L["SCM.Preview.Ph.OrderSearch"])' InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
                @if (!IsPortal)
                {
                    <RadzenLabel Text='@L["Scm.Text.Supplier"]' Component="ScmDropDownVendor" />
                    <RadzenDropDown Name="ScmDropDownVendor" @bind-Value="_vendor" Data="@VendorFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@L["Scm.Text.All"]' AllowClear="true" AllowFiltering="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
                }
                @if (!IsPortal && Mode == "Orders")
                {
                    <RadzenLabel Text="Created By" Component="ScmDropDownCreator" />
                    <RadzenDropDown Name="ScmDropDownCreator" @bind-Value="_creator" Data="@CreatorFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="All users" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:210px;" />
                }
                <RadzenLabel Text='@L["Col.Status"]' Component="ScmDropDownStatus" />
                <RadzenDropDown Name="ScmDropDownStatus" @bind-Value="_status" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@L["Scm.Text.All"]' AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
                @if (IsPortal && (Mode is "Orders" or "Deliveries"))
                {
                    <label style="display:flex;align-items:center;gap:5px;white-space:nowrap;"><input type="checkbox" checked="@_includeClosed" @onchange="e=>ToggleClosed(e.Value is true)" /> Include Closed</label>
                    <label style="display:flex;align-items:center;gap:5px;white-space:nowrap;"><input type="checkbox" checked="@_includeCancelled" @onchange="e=>ToggleCancelled(e.Value is true)" /> Include Cancelled</label>
                }
                @if (!IsPortal && Mode == "Progress")
                {
                    <label style="display:flex;align-items:center;gap:5px;white-space:nowrap;"><input type="checkbox" checked="@_includeClosed" @onchange="e=>ToggleClosed(e.Value is true)" /> Include Received</label>
                    <label style="display:flex;align-items:center;gap:5px;white-space:nowrap;"><input type="checkbox" checked="@_includeCancelled" @onchange="e=>ToggleCancelled(e.Value is true)" /> Include Cancelled</label>
                }
                <RadzenLabel Text='@(Mode == "Deliveries" ? L["Scm.Text.DeliveryDate"] : L["Scm.Text.Due"])' />
                <RadzenDatePicker TValue="DateTime?" @bind-Value="_from" DateFormat="@DateFmt.Date" AllowClear="true" Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
                <span class="dim">~</span>
                <RadzenDatePicker TValue="DateTime?" @bind-Value="_to" DateFormat="@DateFmt.Date" AllowClear="true" Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
                <RadzenButton Text='@L["Btn.Search"]' Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="Search" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Reset"]' Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="Reset" class="ames-rz-btn" />
                @if (!IsPortal && Mode == "Orders" && CanEdit)
                {
                    <RadzenButton Text='@L["Scm.Text.NewOrder"]' Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="NewOrder" class="ames-rz-btn" />
                }
            </RadzenStack>
        </div>
        @if (!IsPortal) { <div class="dim" style="font-size:var(--ames-fs-hint);padding:0 0 6px;">
            ℹ
            @if (IsPortal && Mode=="Due") { @L["Scm.Text.OriginalRegisteredAndRemainingQuantitiesAreShownForConfirmed"] }
            else if(Mode=="Progress") { @L["Scm.Text.TrackSupplierConfirmationAndDeliveriesShippedIsTheCumulative"] }
            else if (IsPortal) { @L["Scm.Text.ViewPurchaseOrdersConfirmOrdersRegisterDeliveriesAndConfirm"] }
            else { @L["Scm.Text.CreatePurchaseOrdersAndViewTheirStatusAndReceived"] }
            @if (IsPortal) { <span> · @L["Scm.Text.OnlyOrdersForLinkedVendorsAreVisibleUnlinkedAccounts"]</span> }
        </div>
        }
        @if (_from > _to)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@L["Scm.Text.EndDateMustFollowStartDate"]</RadzenAlert>
        }

        @if (IsPortal && Mode=="Deliveries")
        {
            <RadzenDataGrid @ref="_portalNoteGrid" TItem="PortalNoteRow" Data="@PortalNoteRows" AllowPaging="true" PageSize="25" AllowSorting="true"
                            RowClick="@(args => { if(args.Data is not null) SelectNote(args.Data); })" RowRender="RowLinkNote" EmptyText="@Empty" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="60px" MinWidth="60px" Title="No." TextAlign="TextAlign.Center" Sortable="false"><Template Context="n"><span class="dim">@GridRowNo.Of(_portalNoteGrid,n)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="190px" MinWidth="190px" Property="Number" Title='@L["Scm.Text.DeliveryNote"]' TextAlign="TextAlign.Center"><Template Context="n"><span class="code">@n.Number</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="170px" MinWidth="170px" Title='@L["Scm.Text.Order"]'><Template Context="n">@string.Join(", ",n.Deliveries.Select(d=>d.OrderNumber).Distinct())</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" MinWidth="200px" Title='@L["Scm.Text.ItemLabel"]'><Template Context="n">@string.Join(", ",Store.Deliveries.Where(d=>n.Numbers.Contains(d.Number)).Select(d=>d.Item).Distinct())</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="135px" MinWidth="135px" Title='@L["Scm.Text.DeliveryDate.246618"]' TextAlign="TextAlign.Center"><Template Context="n">@n.Deliveries.Min(d=>d.Date).ToString(DateFmt.Date)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="145px" MinWidth="145px" Title='@L["Scm.Text.Quantity"]' TextAlign="TextAlign.Right"><Template Context="n">@NoteQuantities(n,d=>d.Quantity)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="145px" MinWidth="145px" Title="Received Qty" TextAlign="TextAlign.Right"><Template Context="n">@NoteReceiptQuantities(n,true)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="145px" MinWidth="145px" Title="Remaining Qty" TextAlign="TextAlign.Right"><Template Context="n">@NoteReceiptQuantities(n,false)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="125px" MinWidth="125px" Title='@L["Scm.Text.ShipDate"]' TextAlign="TextAlign.Center"><Template Context="n">@n.Deliveries.Where(d=>d.ShipDate.HasValue).Min(d=>d.ShipDate)?.ToString(DateFmt.Date)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="115px" MinWidth="115px" Title='@L["Col.Status"]' TextAlign="TextAlign.Center"><Template Context="n"><span class="pill @Badge(NoteStatus(n))">@Status(NoteStatus(n))</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="150px" MinWidth="150px" Title="Shipment Action" TextAlign="TextAlign.Center" Sortable="false"><Template Context="n"><div @onclick:stopPropagation="true">@if(_isExternalPortalUser && n.Deliveries.Any(d=>d.Status=="Registered")){<RadzenButton Text="Start Shipping" Icon="local_shipping" Size="ButtonSize.ExtraSmall" Click="@(()=>StartShipping(n))" />}else{<span class="dim">@(NoteStatus(n)=="Cancelled"?"Cancelled":n.Deliveries.Any(d=>d.Status is "Shipped" or "Received")?"Already shipped":"No action")</span>}</div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="150px" MinWidth="150px" Title="Receipt Status" TextAlign="TextAlign.Center"><Template Context="n"><span class="pill @(NoteReceiptStatus(n)=="Received"?"ok":NoteReceiptStatus(n)=="Partially received"?"warn":"info")">@NoteReceiptStatus(n)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="110px" MinWidth="110px" Title="Qty Mismatch" TextAlign="TextAlign.Center" Sortable="false"><Template Context="n"><div @onclick:stopPropagation="true">@if(NoteMismatches(n).Count>0){<button type="button" class="scm-mismatch-button" title="View quantity mismatches" aria-label="View quantity mismatches" @onclick="()=>OpenNoteMismatch(n)"><RadzenIcon Icon="check_circle" /> Yes</button>}else{<span class="dim">None</span>}</div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="110px" MinWidth="110px" Title='@L["Btn.Print"]' TextAlign="TextAlign.Center" Sortable="false"><Template Context="n"><div @onclick:stopPropagation="true"><RadzenButton Text='@L["Btn.Print"]' Icon="print" Size="ButtonSize.ExtraSmall" Disabled="@(n.Deliveries.All(d=>d.Status=="Cancelled") || _noteBusy)" Click="@(()=>OpenPrintingGroup(n))" /></div></Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else if (Mode is "Deliveries" or "Receipts")
        {
            <RadzenDataGrid @ref="_deliveryGrid" TItem="ScmPreviewStore.Delivery" Data="@DeliveryRows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@PagerSummary" PageSizeText="@PagerSize"
                            RowClick="@(args => { if (args.Data is not null) SelectDelivery(args.Data); })" RowRender="@RowLinkDelivery" EmptyText="@Empty" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="60px" Title="No." MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="d"><span class="dim">@GridRowNo.Of(_deliveryGrid, d)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="150px" MinWidth="150px" TextAlign="TextAlign.Center" Property="Number" Title='@L["Scm.Text.DeliveryNote"]'>
                        <Template Context="d"><span class="code">@NoteNumber(d.Number)</span>@if(NoteNumber(d.Number)!=d.Number){<div class="dim">@d.Number</div>}</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="160px" MinWidth="160px" TextAlign="TextAlign.Center" Property="OrderNumber" Title='@L["Scm.Text.Order"]'>
                        <Template Context="d"><span class="code">@d.OrderNumber</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" MinWidth="200px" Title='@L["Scm.Text.ItemLabel"]'><Template Context="d">@d.Item</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="170px" MinWidth="170px" Property="Date" Title='@L["Scm.Text.DeliveryDate.246618"]' TextAlign="TextAlign.Center">
                        <Template Context="d">@d.Date.ToString(DateFmt.Date)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="170px" MinWidth="170px" Title='@L["Scm.Text.Quantity"]' TextAlign="TextAlign.Right"><Template Context="d">@DeliveryQuantities(d.Number)</Template></RadzenDataGridColumn>
                    @if (IsPortal && Mode=="Deliveries")
                    {
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="150px" MinWidth="150px" Title="Received Qty" TextAlign="TextAlign.Right"><Template Context="d">@ReceiptQuantity(d.Number, true)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="150px" MinWidth="150px" Title="Remaining Qty" TextAlign="TextAlign.Right"><Template Context="d">@ReceiptQuantity(d.Number, false)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="160px" MinWidth="160px" Title="Receipt Status" TextAlign="TextAlign.Center"><Template Context="d"><span class="pill @ReceiptBadge(d.Number)">@ReceiptStatus(d.Number)</span></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="120px" MinWidth="120px" Title="Qty Mismatch" TextAlign="TextAlign.Center" Sortable="false"><Template Context="d"><div @onclick:stopPropagation="true"><button type="button" class="receipt-mismatch" disabled="@(MismatchCount(d.Number)==0)" @onclick="()=>OpenMismatch(d)">@MismatchCount(d.Number)</button></div></Template></RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="150px" MinWidth="150px" TextAlign="TextAlign.Center" Property="ShipDate" FormatString="{0:yyyy-MM-dd}" Title='@L["Scm.Text.ShipDate"]' />
                    @if (Mode == "Receipts")
                    {
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="120px" MinWidth="120px" Property="Accepted" Title='@L["Scm.Text.Accepted"]' TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="130px" MinWidth="130px" Property="Rejected" Title='@L["Scm.Text.Rejected"]' TextAlign="TextAlign.Right" />
                    }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="120px" MinWidth="120px" Title='@L["Col.Status"]' TextAlign="TextAlign.Center">
                        <Template Context="d"><span class="pill @Badge(d.Status)">@Status(d.Status)</span></Template>
                    </RadzenDataGridColumn>
                    @if (IsPortal && Mode=="Deliveries" && _isExternalPortalUser)
                    {
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="130px" MinWidth="130px" Title='@L["Btn.Print"]' TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                            <Template Context="d">
                                <div @onclick:stopPropagation="true">
                                    <RadzenButton Text='@L["Btn.Print"]' Icon="print" Size="ButtonSize.ExtraSmall" class="ames-rz-btn" Disabled="@(_noteBusy || d.Status=="Cancelled")" Click="@(()=>OpenPrinting(d))" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        }
        else if(IsPortal && Mode=="Due")
        {
            <RadzenDataGrid TItem="ScmPreviewStore.Order" Data="@Rows" AllowPaging="true" PageSize="25" AllowSorting="true" EmptyText="@Empty" Class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="190px" MinWidth="190px" TextAlign="TextAlign.Center" Property="Number" Title="PO No" />
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="130px" MinWidth="130px" TextAlign="TextAlign.Center" Property="Due" Title="Due Date"><Template Context="o"><span style="@(o.Due.Date < DbClock.Today ? "color:#ef4444" : null)">@o.Due.ToString(DateFmt.Date)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" MinWidth="160px" Property="VendorName" Title="Supplier" />
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="90px" MinWidth="90px" TextAlign="TextAlign.Right" Title="Items"><Template Context="o">@o.Lines.Count</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="120px" MinWidth="120px" TextAlign="TextAlign.Right" Title="Order Qty"><Template Context="o">@Quantities(o,l=>l.Quantity)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="130px" MinWidth="130px" TextAlign="TextAlign.Right" Title="Registered Qty"><Template Context="o">@Quantities(o,l=>l.RegisteredDelivery)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="130px" MinWidth="130px" TextAlign="TextAlign.Right" Title="Remaining Qty"><Template Context="o">@Quantities(o,l=>l.AvailableDelivery)</Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenDataGrid @ref="_orderGrid" TItem="ScmPreviewStore.Order" Data="@Rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@PagerSummary" PageSizeText="@PagerSize"
                            RowClick="@(args => { if (args.Data is not null) Select(args.Data); })" RowRender="@RowLinkOrder" EmptyText="@Empty" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="60px" Title="No." MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="o"><span class="dim">@GridRowNo.Of(_orderGrid, o)</span></Template>
                    </RadzenDataGridColumn>
                    @if (Mode == "Due") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="130px" MinWidth="130px" Property="Due" Title='@L["Scm.Text.DueDate"]' TextAlign="TextAlign.Center"><Template Context="o">@o.Due.ToString(DateFmt.Date)</Template></RadzenDataGridColumn> }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="160px" MinWidth="160px" TextAlign="TextAlign.Center" Property="Number" Title='@L["Scm.Text.Order"]'>
                        <Template Context="o"><span class="code">@o.Number</span></Template>
                    </RadzenDataGridColumn>
                    @if (Mode == "Orders") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="125px" MinWidth="125px" Property="Ordered" Title='@L["Scm.Text.OrderDate"]' TextAlign="TextAlign.Center"><Template Context="o">@o.Ordered.ToString(DateFmt.Date)</Template></RadzenDataGridColumn> }
                    @if (!IsPortal && Mode == "Orders") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="160px" MinWidth="160px" Property="CreatedBy" Title="Created By" TextAlign="TextAlign.Center"><Template Context="o">@Actors.Display(o.CreatedBy)</Template></RadzenDataGridColumn> }
                    @if (!IsPortal) { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" MinWidth="160px" Property="Vendor" Title='@L["Scm.Text.Supplier"]'><Template Context="order"><span class="code">@order.Vendor</span><span class="dim" style="font-size:.8em;margin-left:4px;">@VendorName(order.Vendor)</span></Template></RadzenDataGridColumn> }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="210px" MinWidth="210px" TextAlign="TextAlign.Center" Property="Item" Title='@L["Scm.Text.Item"]'><Template Context="o"><span class="code">@(o.Lines.FirstOrDefault()?.Item)</span>@if (o.LineCount > 1) { <span class="pill info" style="margin-left:6px;" title="@o.Item">+@(o.LineCount - 1)</span> }</Template></RadzenDataGridColumn>
                    @if(Mode!="Progress")
                    {
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" MinWidth="200px" Property="Name" Title='@L["Scm.Text.Description"]'><Template Context="o"><span title="@o.Name">@(o.Lines.FirstOrDefault()?.Name)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="90px" MinWidth="90px" Property="LineCount" Title='@L["Scm.Text.Lines"]' TextAlign="TextAlign.Right" />
                    }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="140px" MinWidth="140px" Title='@L["Scm.Text.Ordered"]' TextAlign="TextAlign.Right"><Template Context="o">@Quantities(o, l => l.Quantity)</Template></RadzenDataGridColumn>
                    @if(Mode=="Progress")
                    {
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="140px" MinWidth="140px" Title='@L["Scm.Text.Shipped.f4dea6"]' TextAlign="TextAlign.Right"><Template Context="o">@Quantities(o,l=>l.ShippedQuantity)</Template></RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="140px" MinWidth="140px" Title='@L["Scm.Text.Received.2c7750"]' TextAlign="TextAlign.Right"><Template Context="o">@Quantities(o, l => Store.Delivered(o, l))</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="140px" MinWidth="140px" Title='@L["Scm.Text.Remaining"]' TextAlign="TextAlign.Right"><Template Context="o">@Quantities(o, l => Store.Remaining(o, l))</Template></RadzenDataGridColumn>
                    @if (Mode != "Due") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="130px" MinWidth="130px" Property="Due" Title='@L["Scm.Text.DueDate"]' TextAlign="TextAlign.Center"><Template Context="o"><span style="@(IsPortal && o.Due.Date < DbClock.Today ? "color:#ef4444" : null)">@o.Due.ToString(DateFmt.Date)</span></Template></RadzenDataGridColumn> }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="180px" MinWidth="180px" Title='@L["Col.Status"]' TextAlign="TextAlign.Center"><Template Context="o">@{var status=IsPortal && Mode=="Orders" ? PortalOrderStatus(o) : o.Status;}<span class="pill @Badge(status)">@(Mode=="Progress" ? ProgressStatus(o) : Status(status))</span></Template></RadzenDataGridColumn>
                    @if (Mode != "Progress") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="180px" MinWidth="180px" TextAlign="TextAlign.Center" Title='@(IsPortal ? "Confirmation" : L["Scm.Text.SupplierConfirmation"])'><Template Context="o">@if(o.SupplierConfirmedAt.HasValue || o.Status is "Published" or "Confirmed"){<span class="pill @ConfirmationBadge(o)">@ConfirmationLabel(o)</span>}else{<span class="dim">—</span>}</Template></RadzenDataGridColumn> }
                </Columns>
            </RadzenDataGrid>
