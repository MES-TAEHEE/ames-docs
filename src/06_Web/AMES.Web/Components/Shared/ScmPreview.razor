                                <td>@QtyFormat.Text(receipt.Quantity,receipt.Unit) @UomFmt.Sym(receipt.Unit)</td><td>@QtyFormat.Text(receipt.Received,receipt.Unit) @UomFmt.Sym(receipt.Unit)</td><td>@QtyFormat.Text(receipt.Remaining,receipt.Unit) @UomFmt.Sym(receipt.Unit)</td>
                                <td>@ReceiptLabel(receipt.Received<=0 ? "NotReceived" : receipt.Remaining==0 ? "Received" : "Partial")</td></tr>
                        }</tbody>
                    </table></div>
                }
                else { <div class="scm-act">@L["SCM.Preview.Hint.ReceiptAfterShip"]</div> }
                @if(MismatchCount(_delivery.Number)>0)
                {
                    <div class="scm-act"><button type="button" @onclick="()=>_showMismatch=!_showMismatch">@L["SCM.Preview.Col.QtyMismatch"] · @MismatchCount(_delivery.Number)</button></div>
                    @if(_showMismatch)
                    {
                        <div class="scm-scroll"><table class="ames-table scm-lines">
                            <thead><tr><th>@L["SCM.Preview.Col.AdjustedAt"]</th><th>@L["SCM.Preview.Col.BoxLot"]</th><th>@L["SCM.Preview.Col.PartNoName"]</th><th>@L["SCM.Preview.Col.Before"]</th><th>@L["SCM.Preview.Col.After"]</th><th>@L["SCM.Preview.Col.Difference"]</th><th>@L["SCM.Preview.Col.ReasonNote"]</th></tr></thead>
                            <tbody>@foreach(var mismatch in MismatchRows(_delivery.Number))
