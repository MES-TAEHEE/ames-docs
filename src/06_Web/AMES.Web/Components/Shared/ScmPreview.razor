                    <RadzenButton Text='@L["Btn.Close"]' Icon="close" data-portal-close ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="()=>_selectedNote=null" class="ames-rz-btn" />
                </RadzenStack>
            </div>
