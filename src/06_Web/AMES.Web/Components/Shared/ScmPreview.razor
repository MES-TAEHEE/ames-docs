    @if (_printingDelivery is not null)
    {
        <div class="ames-modal-bg" data-no-busy>
            <div class="ames-modal" role="dialog" aria-modal="true" aria-label="Printing" style="width:min(1300px,96vw);max-width:96vw;max-height:92vh;display:flex;flex-direction:column;">
                <div class="ames-modal-h" style="display:flex;justify-content:space-between;align-items:center;">
                    <span>Printing · @(_printingNote?.Number ?? _printingDelivery.Number)</span>
                    <RadzenButton Icon="close" aria-label="Close printing" Click="@(()=>{_printingDelivery=null;_printingNote=null;})" />
                </div>
                <div class="ames-modal-body" style="overflow:auto;min-height:0;">
                    <RadzenTabs>
                        <Tabs>
                            <RadzenTabsItem Text="Delivery Note">
                                @if(_printingNote is { } selectedNote && selectedNote.Number!=_printingDelivery.Number)
                                {
                                    <p class="code">@selectedNote.Number</p>
                                    <RadzenButton Text="Print Delivery Note" Icon="print" Click="@(()=>OpenNote(selectedNote.Number))" />
                                }
                                else if(_noteDeliveries.TryGetValue(_printingDelivery.Number,out var printNote) && printNote.NoteNumber is not null)
                                {
                                    <p class="code">@printNote.NoteNumber</p>
                                    <RadzenButton Text="Print Delivery Note" Icon="print" Click="@(()=>OpenNote(printNote.NoteNumber))" />
                                }
                                else
                                {
                                    <p>Print the Delivery Note. Printing does not confirm shipment.</p>
                                    <RadzenButton Text="Issue / Print Delivery Note" Icon="print" Disabled="@(_noteBusy || !_noteDeliveries.ContainsKey(_printingDelivery.Number))" Click="@(()=>IssueNote(_printingDelivery.Number))" />
                                }
                                @if(!string.IsNullOrEmpty(_message)){<RadzenAlert AlertStyle="AlertStyle.Info">@_message</RadzenAlert>}
                            </RadzenTabsItem>
                            <RadzenTabsItem Text="Case Barcode">
                                @if(_printingError.Length>0){<RadzenAlert AlertStyle="AlertStyle.Warning">@_printingError</RadzenAlert>}
                                <table class="ames-table"><thead><tr><th>Case No</th><th>Boxes</th><th>Printing</th></tr></thead><tbody>
                                @foreach(var item in _printingCases)
                                {
                                    <tr><td>@item.Number</td><td>@item.Boxes.Count</td><td><button type="button" @onclick="()=>OpenCasePreview(item.Number)">Print Case Barcode</button></td></tr>
                                }
                                </tbody></table>
                                @if(_printingCases.Count==0 && _printingError.Length==0){<p>No cases in this delivery.</p>}
                            </RadzenTabsItem>
                            <RadzenTabsItem Text="Box / Part Barcode">
                                @if(_printingNote is { } printGroup)
                                {
                                    @foreach(var delivery in printGroup.Deliveries.Where(d=>d.Status!="Cancelled"))
                                    {
                                        <AMES.Web.Components.Pages.Portal.DeliveryBoxes @key="delivery.Number" Embedded="true" Number="@delivery.Number" PreviewRequested="OpenPreview" />
                                    }
                                }
                                else { <AMES.Web.Components.Pages.Portal.DeliveryBoxes Embedded="true" Number="@_printingDelivery.Number" PreviewRequested="OpenPreview" /> }
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </div>
            </div>
        </div>
    }

    @if (_previewUrl is not null)
    {
        <div class="ames-modal-bg" style="z-index:1200;" data-no-busy>
            <div class="ames-modal" role="dialog" aria-modal="true" aria-label="Print preview" style="width:min(1100px,96vw);max-width:96vw;height:92vh;display:flex;flex-direction:column;">
                <div class="ames-modal-h" style="display:flex;justify-content:space-between;align-items:center;"><span>Print Preview</span><RadzenButton Icon="close" aria-label="Close preview" Click="@(()=>_previewUrl=null)" /></div>
                <iframe title="Print preview" src="@_previewUrl" style="width:100%;flex:1;min-height:0;border:0;background:white;"></iframe>
            </div>
        </div>
