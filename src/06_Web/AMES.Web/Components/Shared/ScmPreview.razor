    @if (_selectedNote is { } noteDetail)
    {
        <div class="ames-modal-bg" @onclick="()=>_selectedNote=null">
            <div class="ames-modal ames-modal-wide scm-note-detail" role="dialog" aria-modal="true" aria-label="Delivery Note details" @onclick:stopPropagation="true" style="width:min(1200px,96vw);max-width:96vw;max-height:92vh;overflow:auto;">
                <div class="ames-modal-h" style="display:flex;justify-content:space-between;align-items:center;">
                    <span>Delivery Note · @noteDetail.Number</span>
                    <RadzenButton Icon="close" aria-label="Close details" Click="()=>_selectedNote=null" />
                </div>
                <div class="scm-dsub">Items · @Status(NoteStatus(noteDetail)) · Receipt @NoteReceiptStatus(noteDetail)</div>
                <div class="scm-scroll"><table class="ames-table scm-lines">
                    <thead><tr><th>PO No</th><th>Part No / Name</th><th>Delivered</th><th>Received</th><th>Remaining</th>@if(_isExternalPortalUser && noteDetail.Deliveries.Any(d=>d.Status=="Registered")){<th>Shipment</th>}</tr></thead>
                    <tbody>@foreach(var line in Store.Deliveries.Where(d=>noteDetail.Numbers.Contains(d.Number)))
                    {
                        <tr><td class="code">@line.OrderNumber</td><td>@line.Item<div class="dim">@PartName(line.PoID)</div></td>
                            <td>@QtyFormat.Text(line.Quantity,line.Unit) @line.Unit</td><td>@QtyFormat.Text(line.Received,line.Unit) @line.Unit</td>
                            <td>@QtyFormat.Text(Math.Max(0,line.Quantity-line.Received),line.Unit) @line.Unit</td>
                            @if(_isExternalPortalUser && noteDetail.Deliveries.Any(d=>d.Status=="Registered"))
                            {<td>@if(line.Status=="Registered"){<button type="button" @onclick="()=>StartShipping(line)">Start Shipping</button>}</td>}
                        </tr>
                    }</tbody>
                </table></div>
                <div class="scm-dsub">Qty Mismatch · @NoteMismatches(noteDetail).Count</div>
                @if(_receiptError.Length>0){<RadzenAlert AlertStyle="AlertStyle.Warning">@_receiptError</RadzenAlert>}
                else if(NoteMismatches(noteDetail).Count==0){<div class="dim">None</div>}
                else
                {
                    <div class="scm-scroll"><table class="ames-table scm-lines">
                        <thead><tr><th>Adjusted At</th><th>Box / LOT</th><th>Part No / Name</th><th>Before</th><th>After</th><th>Difference</th><th>Reason / Note</th></tr></thead>
                        <tbody>@foreach(var mismatch in NoteMismatches(noteDetail))
                        {
                            <tr><td>@mismatch.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@mismatch.Lot</td><td>@mismatch.Item<div class="dim">@mismatch.Name</div></td>
                                <td>@QtyFormat.Text(mismatch.Before,mismatch.Unit) @mismatch.Unit</td><td>@QtyFormat.Text(mismatch.After,mismatch.Unit) @mismatch.Unit</td>
                                <td class="@(mismatch.Change<0?"scm-shortage":"scm-overage")">@(mismatch.Change>0?"+":"")@QtyFormat.Text(mismatch.Change,mismatch.Unit) @mismatch.Unit</td>
                                <td>@mismatch.Reason<div class="dim">@mismatch.Comment</div></td></tr>
                        }</tbody>
                    </table></div>
                }
            </div>
        </div>
    }

    @* ── 발주 상세 ─────────────────────────────────────────────────── *@
    @if (_selected is not null && _delivery is null && _edit is null)
    {
        <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
            <div class="ames-modal ames-modal-wide scm-order-detail" @onmousedown:stopPropagation @onclick:stopPropagation>
                <div class="ames-modal-h">
                    @L["Scm.Text.OrderDetails"] <span class="code" style="font-weight:400;font-size:.9em;">@_selected.Number</span>
                    @{var orderStatus=IsPortal && Mode=="Orders" ? PortalOrderStatus(_selected) : _selected.Status;}
                    <span class="pill @Badge(orderStatus)" style="margin-left:8px;">@Status(orderStatus)</span>
                </div>

<div class="scm-dgrid">                @if (Mode != "Progress") { <div class="scm-dt"><div class="scm-dl">@(IsPortal ? "Confirmation" : L["Scm.Text.SupplierConfirmation"])</div><div class="scm-dv">@ConfirmationLabel(_selected)</div></div> }
                @if (Mode != "Progress" && _selected.SupplierConfirmedAt is not null)
                {
                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.ConfirmedBy"]</div><div class="scm-dv">@_selected.SupplierConfirmedBy</div></div>
                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.ConfirmedAt"]</div><div class="scm-dv">@_selected.SupplierConfirmedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</div></div>
                }

                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.Buyer"]</div><div class="scm-dv">EOS</div></div>
                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.Supplier"]</div><div class="scm-dv">@VendorLabel(_selected.Vendor)</div></div>
                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.OrderDate"]</div><div class="scm-dv">@_selected.Ordered.ToString(DateFmt.Date)</div></div>
                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.DueDate"]</div><div class="scm-dv" style="@(IsPortal && _selected.Due.Date < DbClock.Today ? "color:#ef4444" : null)">@_selected.Due.ToString(DateFmt.Date)</div></div>
                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.Destination"]</div><div class="scm-dv">@_selected.Destination</div></div>
                    <div class="scm-dt"><div class="scm-dl">@L["Scm.Text.Amount"] (@_selected.Currency)</div><div class="scm-dv">@_selected.Amount.ToString("N2")</div></div>
                </div>

                <div class="scm-dsub">@L["Scm.Text.OrderLines"] · @_selected.LineCount</div>
                <div class="scm-scroll">
                    <table class="ames-table">
                        <thead><tr><th>@L["Scm.Text.Item"]</th><th>@L["Scm.Text.Description"]</th><th>@L["Scm.Text.Unit"]</th><th class="num">@L["Scm.Text.Ordered"]</th><th class="num">@L["Scm.Text.Received.2c7750"]</th><th class="num">@L["Scm.Text.Remaining"]</th>@if(Mode=="Progress"){<th class="num">@L["Scm.Text.Shipped.f4dea6"]</th>}else{<th class="num">@L["Scm.Text.UnitPrice"] (@_selected.Currency)</th><th class="num">@L["Scm.Text.Amount"] (@_selected.Currency)</th>}</tr></thead>
                        <tbody>
                        @foreach (var line in _selected.Lines)
                        {
                            <tr><td class="code">@line.Item</td><td>@line.Name</td><td>@UomFmt.Sym(line.Unit)</td><td class="num">@QuantityText(line.Quantity, line.Unit, 2)</td><td class="num">@QuantityText(Store.Delivered(_selected, line), line.Unit, 2)</td><td class="num">@QuantityText(Store.Remaining(_selected, line), line.Unit, 2)</td>@if(Mode=="Progress"){<td class="num">@QtyFormat.Text(line.ShippedQuantity,line.Unit)</td>}else{<td class="num">@line.Price.ToString("#,##0.00##")</td><td class="num">@line.Amount.ToString("N2")</td>}</tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="scm-dsub">@L["Scm.Text.RelatedDeliveries"]</div>
                <div class="scm-log">
                    @foreach (var d in Store.Deliveries.Where(d => d.OrderNumber == _selected.Number))
                    { <div><span class="code">@d.Number</span> · @d.Date.ToString(DateFmt.Date) · @QuantityText(d.Quantity, d.Unit, 3) @UomFmt.Sym(d.Unit) · @d.Item · @Status(d.Status)</div> }
                    @if (!Store.Deliveries.Any(d => d.OrderNumber == _selected.Number)) { <div class="dim">@Empty</div> }
                </div>

                @if (!string.IsNullOrEmpty(_message)) { <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false">@_message</RadzenAlert> }

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                    @if (!IsPortal && Mode == "Orders" && CanEdit && _selected.Status == "Draft")
                    {
                        <RadzenButton Text='@L["Btn.Edit"]' Icon="edit" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="EditOrder" class="ames-rz-btn" />
                        @if (CanApprove) { <RadzenButton Text='@L["Scm.Text.Publish"]' Icon="send" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click='@(() => ChangeStatus("Published"))' class="ames-rz-btn" /> }
                    }
                    @if (!IsPortal && Mode == "Orders" && CanEdit && _selected.Status is "Draft" or "Published" && Store.Delivered(_selected) == 0)
                    { <RadzenButton Text='@L["Scm.Text.CancelOrder"]' Icon="block" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='@(() => ChangeStatus("Cancelled"))' class="ames-rz-btn" /> }
                    @if (CanConfirmOrder)
                    { <RadzenButton Text="@L["Scm.Text.ConfirmOrder"]" Icon="task_alt" Click="ConfirmOrderPrompt" class="ames-rz-btn" /> }
                    <RadzenButton Text='@L["Btn.Close"]' Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="CloseDetail" class="ames-rz-btn" />
                </RadzenStack>
            </div>
        </div>
    }

    @* ── 납품서 상세 ───────────────────────────────────────────────── *@
    @if (_delivery is not null)
    {
        <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick"><div class="ames-modal ames-modal-wide scm-delivery-detail" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@_delivery.Number · @L["Scm.Text.DeliveryDetails"]</div>
            @if(_assignedCases.Count>0)
            {
                <div class="scm-act"><strong>CASE</strong>
                    @foreach(var item in _assignedCases){<span>@item.Number (@item.Boxes.Count boxes)</span>}
                    <span>Quantities are fixed by CASE contents. Cancel this delivery to change cases.</span>
                </div>
            }
            <div class="scm-act">
                <label>@L["Scm.Text.DeliveryDate.246618"]<RadzenDatePicker TValue="DateTime" Value="_delivery.Date" ValueChanged="ChangeEditedDeliveryDate" DateFormat="@DateFmt.Date" Disabled="@(!DeliveryContentEditable)" InputSize="InputSize.Small" class="ames-rz-input" /></label>

                @if (DeliveryEditable)
                {
                    <RadzenButton Text='@L["Scm.Text.ConfirmShipment"]' ButtonStyle="ButtonStyle.Success" Click="OpenShipPrompt" />
                    @if(DeliveryContentEditable){<RadzenButton Text='@L["Scm.Text.SaveChanges"]' Click="SaveDelivery" />}
                    <RadzenButton Text='@L["Scm.Text.CancelDelivery"]' ButtonStyle="ButtonStyle.Danger" Click="@(() => _cancelDeliveryPrompt=true)" />
                }
            </div>
            @if (_delivery.ShippedAt is not null)
            {
                <div class="scm-act"><span>@L["Scm.Text.ShipDate"]: @_delivery.ShipDate?.ToString("yyyy-MM-dd")</span>
                    <span>@L["Scm.Text.ShippedBy"]: @_delivery.ShippedBy</span>
                    <span>@L["Scm.Text.ConfirmedAt.17ae74"]: @_delivery.ShippedAt?.ToString("yyyy-MM-dd HH:mm:ss")</span></div>
            }
            @if (_shipDeliveryPrompt && DeliveryEditable)
            {
                <div class="scm-act">
                    <label>@L["Scm.Text.ActualShipDate"]<RadzenDatePicker TValue="DateTime" @bind-Value="_shipDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" /></label>
                    <span>@L["Scm.Text.ConfirmShipmentOfAllSavedDeliveryLinesEditingAnd"]</span>
                    <RadzenButton Text='@L["Scm.Text.SaveShipment"]' Click="ShipDelivery" />
                    <RadzenButton Text='@L["Scm.Text.Back"]' ButtonStyle="ButtonStyle.Light" Click="@(() => _shipDeliveryPrompt=false)" />
                </div>
            }
            @if (_cancelDeliveryPrompt && DeliveryEditable)
            {
                <div class="scm-act"><span>@L["Scm.Text.CancelTheEntireDeliveryAndReleaseItsReservedQuantities"]</span>
                    <RadzenButton Text='@L["Scm.Text.ConfirmCancellation"]' ButtonStyle="ButtonStyle.Danger" Click="CancelDelivery" />
                    <RadzenButton Text='@L["Scm.Text.Back"]' ButtonStyle="ButtonStyle.Light" Click="@(() => _cancelDeliveryPrompt=false)" />
                </div>
            }
            <div class="scm-scroll"><table class="ames-table scm-lines">
                <thead><tr><th>@L["Scm.Text.Item"]</th><th>@L["Scm.Text.Unit"]</th>@if (DeliveryContentEditable) { <th>@L["Scm.Text.MaximumQuantity"]</th> }<th>@L["Scm.Text.Quantity"]</th><th>@L["Scm.Text.VendorLOT"]</th><th>@L["Scm.Text.ProductionDate"]</th></tr></thead>
                <tbody>@foreach(var line in _deliveryEditLines)
                {
                    <tr @key="line.PoID"><td data-field="item" data-label='@L["Portal.Text.ItemCode.7b3b81"]'>@line.Item</td><td data-label='@L["Scm.Text.Unit"]'>@UomFmt.Sym(line.Unit)</td>@if (DeliveryContentEditable) { <td data-label='@L["Scm.Text.MaximumQuantity"]'>@QuantityText(EditableDeliveryBalance(line), line.Unit, 3)</td> }
                        <td data-field="quantity" data-label='@L["Portal.Text.DeliveryQuantity"]'>@if (DeliveryContentEditable && _assignedCases.Count==0) { <RadzenNumeric TValue="decimal" class="ames-rz-input scm-number" aria-label='@L["Scm.Accessibility.EditQuantity", line.Item]' Min="0.001m" Step="0.001" @bind-Value="line.Quantity" Format="@QtyFormat.Format(line.Unit)" ShowUpDown="false" /> } else { @QuantityText(line.Quantity, line.Unit, 3) }</td><td data-field="lot" data-label='@L["Portal.Text.VendorLOT"]'><input class="ames-input" maxlength="30" aria-label='@L["Scm.Accessibility.VendorLot", line.Item]' @bind="line.VendorLotNo" disabled="@(!DeliveryContentEditable)" /></td>
                        <td data-field="production-date" data-label='@L["Scm.Text.ProductionDate"]'><RadzenDatePicker TValue="DateTime" @bind-Value="line.ProductionDate" DateFormat="@DateFmt.Date" Disabled="@(!DeliveryContentEditable)" InputSize="InputSize.Small" class="ames-rz-input" /></td></tr>
                }</tbody>
            </table></div>
            @if (IsPortal && Mode=="Deliveries")
            {
                <div class="scm-dsub">Receipt Status · @ReceiptStatus(_delivery.Number)</div>
                @if(_receiptError.Length>0){<RadzenAlert AlertStyle="AlertStyle.Warning">@_receiptError</RadzenAlert>}
                else if(ReceiptDocumentLines(_delivery.Number) is { Count: > 0 } receiptLines)
                {
                    <div class="scm-scroll"><table class="ames-table scm-lines">
                        <thead><tr><th>Delivery</th><th>PO No</th><th>Part No / Name</th><th>Delivered</th><th>Received</th><th>Remaining</th><th>Status</th></tr></thead>
                        <tbody>@foreach(var receipt in receiptLines)
                        {
                            <tr><td class="code">@receipt.Delivery</td><td class="code">@receipt.Order</td><td class="code">@receipt.Item<div class="dim">@receipt.Name</div></td>
                                <td>@QtyFormat.Text(receipt.Quantity,receipt.Unit) @receipt.Unit</td><td>@QtyFormat.Text(receipt.Received,receipt.Unit) @receipt.Unit</td><td>@QtyFormat.Text(receipt.Remaining,receipt.Unit) @receipt.Unit</td>
                                <td>@(receipt.Received<=0 ? "Not received" : receipt.Remaining==0 ? "Received" : "Partially received")</td></tr>
                        }</tbody>
                    </table></div>
                }
                else { <div class="scm-act">Receipt details become available after shipment.</div> }
                @if(MismatchCount(_delivery.Number)>0)
                {
                    <div class="scm-act"><button type="button" @onclick="()=>_showMismatch=!_showMismatch">Qty Mismatch · @MismatchCount(_delivery.Number)</button></div>
                    @if(_showMismatch)
                    {
                        <div class="scm-scroll"><table class="ames-table scm-lines">
                            <thead><tr><th>Adjusted At</th><th>Box / LOT</th><th>Part No / Name</th><th>Before</th><th>After</th><th>Difference</th><th>Reason / Note</th></tr></thead>
                            <tbody>@foreach(var mismatch in MismatchRows(_delivery.Number))
                            {
                                <tr><td>@mismatch.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@mismatch.Lot</td><td>@mismatch.Item<div class="dim">@mismatch.Name</div></td>
                                    <td>@QtyFormat.Text(mismatch.Before,mismatch.Unit) @mismatch.Unit</td><td>@QtyFormat.Text(mismatch.After,mismatch.Unit) @mismatch.Unit</td>
                                    <td class="@(mismatch.Change<0?"scm-shortage":"scm-overage")">@(mismatch.Change>0?"+":"")@QtyFormat.Text(mismatch.Change,mismatch.Unit) @mismatch.Unit</td>
                                    <td>@mismatch.Reason<div class="dim">@mismatch.Comment</div></td></tr>
                            }</tbody>
                        </table></div>
                    }
                }
            }
            @if (!DeliveryEditable) { <div class="scm-act">@L["Scm.Text.ShippedCancelledOrReceivingDeliveriesCannotBeEdited"]</div> }
            else if(!DeliveryContentEditable){<div class="scm-act">Delivery Note issued. To change its contents, cancel and recreate the delivery.</div>}
            @if (!string.IsNullOrEmpty(_message)) { <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">@_message</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="ames-modal-footer"><RadzenButton Text='@L["Btn.Close"]' Icon="close" Click="CloseDetail" ButtonStyle="ButtonStyle.Base" /></RadzenStack>
        </div></div>
    }
    @* ── 발주 작성 ─────────────────────────────────────────────────── *@
    @if (_edit is not null)
    {
        <div class="ames-modal-bg">
            <div class="ames-modal ames-modal-wide scm-editor" role="dialog" aria-modal="true" aria-labelledby="scm-edit-title">
                <div class="ames-modal-h" id="scm-edit-title">@L["Scm.Text.OrderEditor"] <span class="code" style="font-weight:400;font-size:.9em;">@(string.IsNullOrEmpty(_edit.Number) ? L["Scm.Text.AssignedOnSave"] : _edit.Number)</span></div>
                <RadzenRow Gap="8px">
                    <RadzenColumn Size="4">
                        <RadzenLabel Text='@L["Scm.Text.Supplier"]' />
                        <RadzenDropDown @bind-Value="_edit.Vendor" @bind-Value:after="ChangeVendor" Data="@VendorEditOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@L["Scm.Text.SelectVendor"]' AllowFiltering="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenLabel Text='@L["Scm.Text.DueDate"]' />
                        <RadzenDatePicker TValue="DateTime" @bind-Value="_edit.Due" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="5">
                        <RadzenLabel Text='@L["Scm.Text.Destination"]' />
                        <RadzenTextBox @bind-Value="_edit.Destination" MaxLength="200" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>
                <div class="scm-dsub scm-line-toolbar">
                    <span>@L["Scm.Text.OrderLines"] · @_edit.Lines.Count</span>
                    <RadzenButton Text='@L["Scm.Text.AddItem"]' Icon="add" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="AddLine" class="ames-rz-btn" />
                </div>
                <div class="scm-scroll">
                    <table class="ames-table scm-lines">
                        <thead><tr>
                            <th>#</th><th>@L["Scm.Text.OrderItemMATERIAL"]</th>
                            <th>@L["Scm.Text.Unit"]</th><th>@L["Col.Quantity"]</th>
                            <th>@L["Scm.Text.UnitPriceUSD"]</th>
                            <th class="num">@L["Scm.Text.AmountUSD"]</th><th></th>
                        </tr></thead>
                        <tbody>
                        @foreach (var line in _edit.Lines)
                        {
                            <tr @key="line.Id">
                                <td class="dim">@(_edit.Lines.IndexOf(line) + 1)</td>
                                <td>
                                    <RadzenDropDown TValue="string" @bind-Value="line.Item" @bind-Value:after="() => SelectMaterial(line)"
                                        Data="@MaterialOptions" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" Disabled="@(_materials.Count == 0)"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowClear="true"
                                        Placeholder='@L["SCM.Preview.Ph.ItemSearch"]'
                                        InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                                    <div class="dim">@line.Name</div>
                                </td>
                                <td data-label='@L["Scm.Text.Unit"]'>@UomFmt.Sym(line.Unit)</td>
                                <td><RadzenNumeric TValue="decimal" @bind-Value="line.Quantity" Min="0.001m" Step="1" aria-label='@($"{L["Col.Quantity"]} {line.Id}")' InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" /></td>
                                <td><RadzenNumeric TValue="decimal" @bind-Value="line.Price" Min="0" Step="0.01" Format="#,##0.00##" aria-label='@($"{L["Scm.Text.UnitPrice"]} {line.Id}")' InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" /></td>
                                <td class="num">@line.Amount.ToString("N2")</td>
                                <td><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => RemoveLine(line))" Disabled="@(_edit.Lines.Count == 1)" title='@L["Scm.Text.Remove"]' class="ames-rz-btn" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="scm-total">@L["Scm.Text.TotalUSD"] <strong>@_edit.Amount.ToString("N2")</strong></div>
                @if (!string.IsNullOrEmpty(_error)) { <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@_error</RadzenAlert> }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                    <RadzenButton Text='@L["Btn.Save"]' Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="SaveOrder" class="ames-rz-btn" />
                    <RadzenButton Text='@L["Btn.Close"]' Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(() => _edit = null)" class="ames-rz-btn" />
                </RadzenStack>
            </div>
        </div>
    }
}
@code {
    string QuantityText(decimal quantity,string unit,int digits) => IsPortal ? QtyFormat.Text(quantity,unit) : UomFmt.Qty(quantity,unit);
    // ── 화면 구성(표준 화면과 같은 목록·모달) ─────────────────────────
    RadzenDataGrid<ScmPreviewStore.Order>? _orderGrid;
    RadzenDataGrid<ScmPreviewStore.Delivery>? _deliveryGrid;
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    int _pageRows = 25;   // 고정 페이저: 본문 높이 = 헤더 + 페이지 행 수 × 행 높이(.ames-grid-fixed)
    bool _bgMouseDownOnSelf;
    string PagerSummary => L["Pager.Summary"];
    string PagerSize => L["Pager.PageSize"];
    public record Opt(string Value, string Text);
    public record LineOpt(int Id, string Text);
    IEnumerable<Opt> VendorFilterOptions => _vendors.Select(v => new Opt(v.VendorID, $"[{v.VendorID}] {v.VendorName}"));
    IEnumerable<Opt> CreatorFilterOptions => _dbOrders.Select(o => o.CreatedBy).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Select(x => new Opt(x, Actors.Display(x))).OrderBy(x => x.Text);
    IEnumerable<Opt> VendorEditOptions => _vendors.Where(v => v.ActiveFlag).Select(v => new Opt(v.VendorID, $"[{v.VendorID}] {v.VendorName}"));
    IEnumerable<Opt> StatusFilterOptions => OrderStatuses.Select(x => new Opt(x, Mode=="Progress" && x=="Closed" ? "Received" : Status(x)));
    IEnumerable<LineOpt> DeliveryLineOptions => _selected is null ? [] : _selected.Lines.Where(l => Store.Remaining(_selected, l) > 0).Select(l => new LineOpt(l.Id, $"{l.Item} · {l.Name}"));
    string VendorName(string vendorId) => _vendors.Find(x => x.VendorID == vendorId)?.VendorName ?? _dbOrders.FirstOrDefault(o => o.Vendor == vendorId)?.VendorName ?? "";
    static void RowLinkOrder(RowRenderEventArgs<ScmPreviewStore.Order> args) => args.Attributes["class"] = (args.Attributes.TryGetValue("class", out var c) ? c + " " : "") + "ames-row-link";
    static void RowLinkDelivery(RowRenderEventArgs<ScmPreviewStore.Delivery> args) => args.Attributes["class"] = (args.Attributes.TryGetValue("class", out var c) ? c + " " : "") + "ames-row-link";
    void CloseDetail() { _selected = null; _delivery = null; _message = ""; }
    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseDetail(); _bgMouseDownOnSelf = false; }

    [Parameter] public string ScreenCode { get; set; } = "";
    [Parameter] public string Href { get; set; } = "";
    [Parameter] public string Mode { get; set; } = "Orders";
    [Parameter] public bool IsPortal { get; set; }
    bool _ready;
    Dictionary<string,ScmRepository.NoteDeliveryChoice> _noteDeliveries=new(StringComparer.OrdinalIgnoreCase);
    bool _noteBusy;
    List<ScmRepository.PortalReceiptLine> _portalReceipts=[];
    List<ScmRepository.PortalDiscrepancy> _portalMismatches=[];
    string _receiptError="";
    bool _showMismatch;
    ScmPreviewStore.Delivery? _printingDelivery;
    string? _previewUrl;
    List<ScmRepository.DeliveryCase> _printingCases=[];
    string _printingError="";
    void OpenPrinting(ScmPreviewStore.Delivery delivery)
    {
        if(!IsPortal || Mode!="Deliveries" || !_isExternalPortalUser || string.IsNullOrEmpty(_portalUserId) || delivery.Status=="Cancelled")return;
        _printingNote=null;
        _printingDelivery=delivery;_printingCases=[];_printingError="";_message="";_previewUrl=null;
        try{_printingCases=Scm.ListDeliveryCases(null,_portalUserId,delivery:delivery.Number);}
        catch(Exception ex){Logger.LogWarning(ex,"Print case list failed");_printingError="Unable to load cases for this delivery.";}
    }
    void OpenPrintingGroup(PortalNoteRow note)
    {
        if(!IsPortal || Mode!="Deliveries" || !_isExternalPortalUser || string.IsNullOrEmpty(_portalUserId))return;
        var first=note.Deliveries.FirstOrDefault(d=>d.Status!="Cancelled");
        if(first is null)return;
        OpenPrinting(first);
        _printingNote=note;
        try { _printingCases=note.Deliveries.Where(d=>d.Number!=first.Number && d.Status!="Cancelled")
            .SelectMany(d=>Scm.ListDeliveryCases(null,_portalUserId!,delivery:d.Number)).Concat(_printingCases)
            .DistinctBy(c=>c.Number).ToList(); }
        catch(Exception ex) { Logger.LogWarning(ex,"Print case list failed"); _printingError="Unable to load all cases for this Delivery Note."; }
    }
    void OpenPreview(string url) => _previewUrl=url;
    void OpenCasePreview(string number) => OpenPreview("/portal/case-label/"+Uri.EscapeDataString(number));
    void OpenNote(string number) => OpenPreview("/portal/delivery-note/"+Uri.EscapeDataString(number));
    void LoadNotes()
    {
        _noteDeliveries.Clear();
        if(!IsPortal || Mode!="Deliveries" || !_isExternalPortalUser || string.IsNullOrEmpty(_portalUserId))return;
        try { _noteDeliveries=Scm.ListNoteDeliveries(_portalUserId).ToDictionary(x=>x.Number,StringComparer.OrdinalIgnoreCase); }
        catch(Exception ex) { Logger.LogWarning(ex,"Delivery notes load failed");_message=L["Portal.Text.UnableToLoadTheList"]; }
    }
    void IssueNote(string number)
    {
        if(_noteBusy || !IsPortal || Mode!="Deliveries" || !_isExternalPortalUser || string.IsNullOrEmpty(_portalUserId) || string.IsNullOrEmpty(number))return;
        _noteBusy=true;_message="";
        try
        {
            var note=Scm.IssueDeliveryNote([number],_portalUserId,_actor);
            LoadNotes();
            OpenNote(note.Number);
        }
        catch(Exception ex)
        {
            Logger.LogWarning(ex,"Delivery note issue failed");
            LoadNotes();
            _message=L["Portal.Text.UnableToIssueRefreshAndCheckVendorAccessAnd"];
        }
        finally { _noteBusy=false; }
    }
    string _search = "", _vendor = "", _creator = "", _status = "", _message = "", _error = "";
    bool _includeClosed, _includeCancelled;
    void ToggleClosed(bool value) { _includeClosed=value; if(!value && _status is "Received" or "Closed")_status=""; }
    void ToggleCancelled(bool value) { _includeCancelled=value; if(!value && _status is "Cancelled")_status=""; }
    DateTime? _from, _to;
    decimal _deliveryQuantity = 1;
    int _deliveryLineId;
    ScmPreviewStore.Order? _selected, _edit;
    ScmPreviewStore.Delivery? _delivery;
    List<MasterDataRepository.ItemRow> _materials = new();
    public record MaterialOption(string Value, string Text);
    IEnumerable<MaterialOption> MaterialOptions => _materials.Select(x => new MaterialOption(x.ItemNo, $"{x.ItemNo} · {x.ItemName}"));
    bool CanEdit => !IsPortal && Permissions.CanEdit(Href);
    bool CanConfirmOrder => IsPortal && Mode == "Orders"
        && _isExternalPortalUser && !string.IsNullOrEmpty(_portalUserId)
        && _selected is { SupplierConfirmedAt: null, Status: "Published" or "Confirmed" };
    string ConfirmationLabel(ScmPreviewStore.Order o) => o.SupplierConfirmedAt.HasValue
        ? L["Scm.Text.Confirmed"] : o.Status is "Published" or "Confirmed"
        ? L["Scm.Text.AwaitingConfirmation.6a70d7"] : "—";
    static string ConfirmationBadge(ScmPreviewStore.Order o) => o.SupplierConfirmedAt.HasValue ? "ok" : "warn";
    bool CanApprove => Permissions.CanApprove(Href);
    bool DeliveryEditable => IsPortal && Mode == "Deliveries"
        && _isExternalPortalUser && !string.IsNullOrEmpty(_portalUserId)
        && _delivery?.Status == "Registered" && _deliveryEditLines.All(l=>l.Received==0);
    string Empty => L["Scm.Text.NoResults"];
    bool DeliveryContentEditable => DeliveryEditable && !(_delivery is not null && _noteDeliveries.TryGetValue(_delivery.Number,out var note) && note.NoteNumber is not null);
    IEnumerable<string> OrderStatuses => IsPortal && Mode=="Due" ? ["Published","Confirmed"]
        : IsPortal && Mode=="Deliveries" ? ["Registered","Shipped","PartiallyReceived",..(_includeClosed ? new[]{"Received"} : []),..(_includeCancelled ? new[]{"Cancelled"} : [])]
        : IsPortal && Mode=="Orders" ? ["Published","Shipped","PartiallyReceived",..(_includeClosed ? new[]{"Received"} : []),..(_includeCancelled ? new[]{"Cancelled"} : [])]
        : Mode == "Progress" ? ["Draft","Published","Confirmed",..(_includeClosed ? new[]{"Closed"} : []),..(_includeCancelled ? new[]{"Cancelled"} : [])]
        : Mode == "Deliveries" ? ["Registered", "Shipped", "Received", "Cancelled"]
        : IsPortal ? ["Published", "Confirmed", "Closed", "Cancelled"] : ["Draft", "Published", "Confirmed", "Closed", "Cancelled"];
    string Title => Mode switch {
        "Orders" => IsPortal ? L["Scm.Text.OrdersConfirmation"] : L["Scm.Text.PurchaseOrders"],
        "Progress" => L["Scm.Text.OrderProgress"],
        "Due" => IsPortal ? "Delivery Creation" : L["Scm.Text.DeliveryPreparation"],
        "Entry" => L["Scm.Text.CreateDelivery"],
        "Deliveries" => L["Scm.Text.DeliveryManagement"],
        _ => L["Scm.Text.ReceiptStatus"]
    };
    List<ScmPreviewStore.Order> Rows => _dbOrders
        .Where(o=>!IsPortal || Mode!="Orders" || (_includeClosed || PortalOrderStatus(o)!="Received") && (_includeCancelled || PortalOrderStatus(o)!="Cancelled"))
        .Where(o=>Mode!="Progress" || (_includeClosed || !ProgressReceived(o)) && (_includeCancelled || o.Status!="Cancelled"))
        .Where(o => !IsPortal || Mode!="Due" || (o.SupplierConfirmedAt.HasValue && o.Status is "Published" or "Confirmed"))
        .Where(o => Mode != "Entry" || o.SupplierConfirmedAt.HasValue && (o.Status is "Published" or "Confirmed") && o.Lines.Any(l => l.AvailableDelivery > 0))
        .Where(o => (string.IsNullOrEmpty(_vendor) || o.Vendor == _vendor) && (string.IsNullOrEmpty(_creator) || o.CreatedBy == _creator) && (string.IsNullOrEmpty(_status) || (_status=="Outstanding" ? (o.Status is "Published" or "Confirmed") && o.Lines.Any(l=>l.AvailableDelivery>0) : IsPortal && Mode=="Orders" ? PortalOrderStatus(o)==_status : o.Status == _status)))
        .Where(o => _from <= _to || _from == null || _to == null)
        .Where(o => (!_from.HasValue || o.Due >= _from) && (!_to.HasValue || o.Due <= _to))
        .Where(o => string.IsNullOrWhiteSpace(_search) || (o.Number + " " + o.Item + " " + o.Name).Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(o => Mode == "Due" ? o.Due : o.Ordered).ThenBy(o => o.Number).ToList();
    string? _creationOrder;
    void OpenCaseSelection() { _creationOrder=""; }
    void RefreshCreation() { ReloadOrders(); }
    void CloseCreation() { _creationOrder=null; ReloadOrders(); }
    List<ScmPreviewStore.Delivery> DeliveryRows => Store.Deliveries
        .Where(d=>_dbOrders.Any(o=>o.Number==d.OrderNumber))
        .Where(d=>string.IsNullOrEmpty(_status) || d.Status==_status)
        .Where(d=>(!_from.HasValue || d.Date>=_from) && (!_to.HasValue || d.Date<=_to))
        .Where(d=>Mode!="Receipts" || d.Received>0)
        .GroupBy(d=>d.Number)
        .Where(g=>string.IsNullOrWhiteSpace(_search) || g.Any(d=>(d.Number+" "+d.OrderNumber+" "+d.Item).Contains(_search,StringComparison.OrdinalIgnoreCase)))
        .Select(g=> {var d=g.First().Copy();d.Item=string.Join(", ",g.Select(x=>x.Item));return d;}).ToList();
    sealed record PortalNoteRow(string Number,List<ScmPreviewStore.Delivery> Deliveries)
    {
        public ScmPreviewStore.Delivery First => Deliveries[0];
        public HashSet<string> Numbers => Deliveries.Select(d=>d.Number).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }
    RadzenDataGrid<PortalNoteRow>? _portalNoteGrid;
    PortalNoteRow? _selectedNote,_printingNote;
    List<PortalNoteRow> PortalNoteRows => Store.Deliveries
        .Where(d=>_dbOrders.Any(o=>o.Number==d.OrderNumber))
        .GroupBy(d=>NoteNumber(d.Number),StringComparer.OrdinalIgnoreCase)
        .Select(g=>new PortalNoteRow(g.Key,g.GroupBy(d=>d.Number,StringComparer.OrdinalIgnoreCase).Select(x=>x.First().Copy()).ToList()))
        .Where(g=>(_includeClosed || NoteStatus(g)!="Received") && (_includeCancelled || NoteStatus(g)!="Cancelled"))
        .Where(g=>string.IsNullOrEmpty(_status)||g.Deliveries.Any(d=>d.Status==_status))
        .Where(g=>g.Deliveries.Any(d=>(!_from.HasValue||d.Date>=_from)&&(!_to.HasValue||d.Date<=_to)))
        .Where(g=>string.IsNullOrWhiteSpace(_search)||g.Number.Contains(_search,StringComparison.OrdinalIgnoreCase)
            ||Store.Deliveries.Any(d=>g.Numbers.Contains(d.Number)&&(d.Number+" "+d.OrderNumber+" "+d.Item).Contains(_search,StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(g=>g.Deliveries.Max(d=>d.Date)).ThenBy(g=>g.Number).ToList();
    string NoteQuantities(PortalNoteRow note,Func<ScmPreviewStore.Delivery,decimal> quantity) => string.Join(" / ",Store.Deliveries
        .Where(d=>note.Numbers.Contains(d.Number)).GroupBy(d=>d.Unit).Select(g=>$"{QuantityText(g.Sum(quantity),g.Key,3)} {g.Key}"));
    string PartName(int poId) => _dbOrders.SelectMany(o=>o.Lines).FirstOrDefault(l=>l.PoID==poId)?.Name ?? "";
    string NoteReceiptQuantities(PortalNoteRow note,bool received) => NoteQuantities(note,d=>received?d.Received:Math.Max(0,d.Quantity-d.Received));
    string NoteReceiptStatus(PortalNoteRow note)
    {
        if(note.Deliveries.All(d=>d.Status=="Cancelled"))return "Cancelled";
        var lines=Store.Deliveries.Where(d=>note.Numbers.Contains(d.Number) && d.Status!="Cancelled").ToList();
        if(lines.All(d=>d.Status=="Registered"))return "Not shipped";
        if(lines.All(d=>d.Received<=0))return "Not received";
        return lines.All(d=>d.Received>=d.Quantity) ? "Received" : "Partially received";
    }
    string NoteStatus(PortalNoteRow note)
    {
        var active=note.Deliveries.Where(d=>d.Status!="Cancelled").ToList();
        if(active.Count==0) return "Cancelled";
        if(active.All(d=>d.Status=="Received")) return "Received";
        if(active.Any(d=>d.Status=="Received")) return "PartiallyReceived";
        if(active.Any(d=>d.Status=="Shipped")) return "Shipped";
        return "Registered";
    }
    List<ScmRepository.PortalDiscrepancy> NoteMismatches(PortalNoteRow note) => _portalMismatches.Where(r=>note.Numbers.Contains(r.Delivery)).ToList();
    static void RowLinkNote(RowRenderEventArgs<PortalNoteRow> args)=>args.Attributes["style"]="cursor:pointer";
    void SelectNote(PortalNoteRow note) { _selectedNote=note; _showMismatch=false; }
    void OpenNoteMismatch(PortalNoteRow note) => SelectNote(note);
    void SelectNoteDelivery(ScmPreviewStore.Delivery delivery) { _selectedNote=null; SelectDelivery(delivery); }
    void StartShipping(PortalNoteRow note)
    {
        var registered=note.Deliveries.Where(d=>d.Status=="Registered").ToList();
        if(registered.Count==1) StartShipping(registered[0]);
        else SelectNote(note);
    }
    void StartShipping(ScmPreviewStore.Delivery delivery) { SelectNoteDelivery(delivery); OpenShipPrompt(); }
    string DeliveryQuantities(string number) => string.Join(" / ",Store.Deliveries.Where(d=>d.Number==number)
        .GroupBy(d=>d.Unit).Select(g=>$"{QuantityText(g.Sum(d=>d.Quantity),g.Key,3)} {UomFmt.Sym(g.Key)}"));
    string NoteNumber(string delivery) => _noteDeliveries.TryGetValue(delivery,out var n) && !string.IsNullOrEmpty(n.NoteNumber) ? n.NoteNumber : delivery;
    List<ScmRepository.PortalReceiptLine> ReceiptLines(string delivery) => _portalReceipts.Where(r=>r.Delivery==delivery).ToList();
    List<ScmRepository.PortalReceiptLine> ReceiptDocumentLines(string delivery) => _portalReceipts.Where(r=>NoteNumber(r.Delivery)==NoteNumber(delivery)).ToList();
    string ReceiptQuantity(string delivery,bool received)
    {
        if(_receiptError.Length>0)return "—";
        var lines=ReceiptLines(delivery);
        if(lines.Count==0)return "—";
        return string.Join(" / ",lines.GroupBy(r=>r.Unit).Select(g=>$"{QtyFormat.Text(g.Sum(r=>received?r.Received:r.Remaining),g.Key)} {g.Key}"));
    }
    string ReceiptStatus(string delivery)
    {
        if(_receiptError.Length>0)return "Unavailable";
        var lines=ReceiptLines(delivery);
        if(lines.Count==0)return "Not shipped";
        if(lines.All(r=>r.Received<=0))return "Not received";
        return lines.All(r=>r.Remaining==0) ? "Received" : "Partially received";
    }
    string ReceiptBadge(string delivery) => ReceiptStatus(delivery) switch { "Received"=>"ok", "Partially received"=>"warn", _=>"info" };
    List<ScmRepository.PortalDiscrepancy> MismatchRows(string delivery) => _portalMismatches.Where(r=>r.Delivery==delivery || (NoteNumber(delivery)!=delivery && r.Note==NoteNumber(delivery))).ToList();
    int MismatchCount(string delivery) => MismatchRows(delivery).Count;
    void OpenMismatch(ScmPreviewStore.Delivery delivery) { SelectDelivery(delivery); _showMismatch=true; }
    void LoadReceiptResults()
    {
        _portalReceipts=[];_portalMismatches=[];_receiptError="";
        if(!IsPortal || Mode!="Deliveries" || !_isExternalPortalUser || string.IsNullOrEmpty(_portalUserId))return;
        try { _portalReceipts=Scm.ListPortalReceiptResults(_portalUserId); _portalMismatches=Scm.ListPortalDeliveryDiscrepancies(_portalUserId); }
        catch(Exception ex) { Logger.LogWarning(ex,"Portal receipt results load failed"); _receiptError="Receipt results are unavailable. Refresh to retry."; }
    }
    protected override async Task OnParametersSetAsync()
    {
        _ready = false;
        await Permissions.EnsureAsync(Authentication);
        if (!IsPortal && !Permissions.IsVisible(Href)) { Nav.NavigateTo("/unauthorized"); return; }
        Reset();
        if (!IsPortal && !LoadVendors()) _message = _error;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _actor = ActorCode.Of(user);
        _portalUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _isExternalPortalUser = PortalAuth.IsPortalUser(user);
        ReloadOrders();
        _ready = true;
    }
    // 필터는 입력 즉시 적용된다 — 조회는 조건을 둔 채 DB 에서 다시 읽는다(다른 사용자·외부 변경분 반영)
    void Search() { _message = ""; ReloadOrders(); }
    void Reset() { _search = _vendor = _creator = _message = _status = ""; _includeClosed=_includeCancelled=false; _from = _to = null; _selected = _edit = null; _delivery = null; _selectedNote=null; if (_ready) ReloadOrders(); }
    void Select(ScmPreviewStore.Order o) { _selected = o; _delivery = null; _deliveryLineId = o.Lines.FirstOrDefault(l => Store.Remaining(o, l) > 0)?.Id ?? 0; SelectDeliveryLine(); _message = ""; }
    List<ScmPreviewStore.Delivery> _deliveryEditLines = new();
    List<ScmRepository.DeliveryCase> _assignedCases=[];
    bool _cancelDeliveryPrompt, _shipDeliveryPrompt;
    DateTime _shipDate=DbClock.Today;
    void SelectDelivery(ScmPreviewStore.Delivery d)
    {
        _showMismatch=false;
        _selected = _dbOrders.First(o => o.Number == d.OrderNumber);
        _delivery = d.Copy();
        _deliveryEditLines=Store.Deliveries.Where(x=>x.Number==d.Number).Select(x=>x.Copy()).ToList();
        _cancelDeliveryPrompt=false; _shipDeliveryPrompt=false; _shipDate=DbClock.Today; _message="";
        _assignedCases=[];
        if(IsPortal)
        {
            try { _assignedCases=Scm.ListDeliveryCases(null,_portalUserId!,delivery:d.Number); }
            catch(Exception ex) { Logger.LogWarning(ex,"Unable to load delivery CASEs"); _message="Unable to load CASE information. Check the CASE schema and connection."; }
        }
    }
    decimal EditableDeliveryBalance(ScmPreviewStore.Delivery d)
    {
        var line=_selected?.Lines.Find(l=>l.PoID==d.PoID);
        var original=Store.Deliveries.FirstOrDefault(x=>x.Number==d.Number && x.PoID==d.PoID);
        return line is null ? 0 : Math.Max(0, line.Quantity-line.Received-line.PendingDelivery+(original is { Status: not "Cancelled" } ? original.Quantity-original.Received : 0));
    }
    bool LoadMaterials(string vendorId)
    {
        _materials.Clear();
        if (string.IsNullOrWhiteSpace(vendorId))
        {
            _error = L["Scm.Text.SelectAVendorFirst"];
            return true;
        }
        try
        {
            var itemNos = Scm.ListItemVendors().Where(x => x.VendorID == vendorId && x.VendorActive)
                .Select(x => x.ItemNo).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _materials = MasterData.ListItems(itemType: "MATERIAL").Where(x => itemNos.Contains(x.ItemNo)).ToList();
            _error = _materials.Count == 0 ? L["Scm.Text.NoMATERIALItemsLinkedToThisVendorAddMappings"] : "";
            return true;
        }
        catch (Exception ex)
        {
            _materials.Clear();
            Logger.LogError(ex, "Failed to load SCM MATERIAL items");
            _error = L["Scm.Text.UnableToLoadItemsPleaseRetry"];
            return false;
        }
    }
    List<MasterDataRepository.VendorRow> _vendors = new();
    string VendorLabel(string vendorId)
    {
        var vendor = _vendors.Find(x => x.VendorID == vendorId);
        var name = vendor?.VendorName ?? _dbOrders.FirstOrDefault(o => o.Vendor == vendorId)?.VendorName;
        return string.IsNullOrWhiteSpace(name) ? vendorId : $"{vendorId} · {name}";
    }
    bool LoadVendors()
    {
        try { _vendors = MasterData.ListVendors(); return true; }
        catch (Exception ex)
        {
            _vendors.Clear();
            Logger.LogError(ex, "Failed to load SCM vendors");
            _error = L["Scm.Text.UnableToLoadVendorsPleaseRetry"];
            return false;
        }
    }
    string Quantities(ScmPreviewStore.Order order, Func<ScmPreviewStore.OrderLine, decimal> quantity)
        => string.Join(" / ", order.Lines.GroupBy(l => l.Unit).Select(g => $"{QuantityText(g.Sum(quantity),g.Key,2)} {UomFmt.Sym(g.Key)}"));
    void AddLine()
    {
        if (_edit is null) return;
        _edit.Lines.Add(new() { Id = _edit.Lines.Select(l => l.Id).DefaultIfEmpty().Max() + 1 });
    }
    void RemoveLine(ScmPreviewStore.OrderLine line)
    {
        if (_edit?.Lines.Count > 1) _edit.Lines.Remove(line);
    }
    void SelectMaterial(ScmPreviewStore.OrderLine line)
    {
        var item = _materials.Find(x => x.ItemNo == line.Item);
        line.Name = item?.ItemName ?? "";
        line.Unit = item?.DefaultUOM ?? "";
        line.Price = _dbOrders.Where(o => o.Vendor == _edit?.Vendor && o.Currency == "USD" && o.Status != "Cancelled")
            .SelectMany(o => o.Lines.Where(l => l.Item == line.Item && l.Unit == line.Unit && l.Price > 0)
                .Select(l => new { o.Ordered, o.Number, l.Price }))
            .OrderByDescending(x => x.Ordered).ThenByDescending(x => x.Number)
            .Select(x => (decimal?)x.Price).FirstOrDefault() ?? item?.UnitCost ?? 0m;
    }
    bool ValidateMaterial(ScmPreviewStore.Order order)
    {
        if (!LoadMaterials(order.Vendor)) return false;
        if (!LoadVendors()) return false;
        if (!_vendors.Any(v => v.VendorID == order.Vendor && v.ActiveFlag))
        {
            _error = L["Scm.Text.SelectAnActiveVendor"];
            return false;
        }
        if (order.Lines.Count == 0)
        {
            _error = L["Scm.Text.AddAtLeastOneItem"];
            return false;
        }
        foreach (var line in order.Lines)
        {
            var item = _materials.Find(x => x.ItemNo == line.Item);
            if (item is null || line.Quantity <= 0 || line.Price < 0)
            {
                _error = $"{order.Lines.IndexOf(line) + 1}: " + L["Scm.Text.CheckVendorLinkedMATERIALItemPositiveQuantityAndNon"];
                return false;
            }
            line.Name = item.ItemName;
            line.Unit = item.DefaultUOM ?? "";
        }
        return true;
    }
    void NewOrder() { if (!CanEdit || IsPortal) return; _edit = new() { Vendor = "" }; LoadMaterials(_edit.Vendor); LoadVendors(); }
    void EditOrder() { if (!CanEdit || IsPortal || _selected?.Status != "Draft") return; _edit = _selected.Copy(); LoadMaterials(_edit.Vendor); LoadVendors(); }
    void ChangeVendor()
    {
        if (_edit is null) return;
        _edit.Lines = [new()];
        LoadMaterials(_edit.Vendor);
    }
    void SelectDeliveryLine()
    {
        var line = _selected?.Lines.Find(l => l.Id == _deliveryLineId);
        if (_selected is not null && (line is null || Store.Remaining(_selected, line) == 0))
        {
            line = _selected.Lines.FirstOrDefault(l => Store.Remaining(_selected, l) > 0);
            _deliveryLineId = line?.Id ?? 0;
        }
        _deliveryQuantity = line is null ? 0 : Store.Remaining(_selected!, line);
    }
    void SaveOrder()
    {
        if (!CanEdit || IsPortal || _edit is null) return;
        if (!ValidateMaterial(_edit)) return;
        if (string.IsNullOrWhiteSpace(_edit.Destination) || _edit.Due.Date < _edit.Ordered.Date)
        { _error = L["Scm.Text.CheckItemDestinationQuantityPriceAndDueDate"]; return; }
        string number;
        var previous = _selected?.Copy();
        try
        {
            var isNew = string.IsNullOrEmpty(_edit.Number);
            number = Scm.SavePurchaseOrder(ToDatabase(_edit), _edit.Versions, _actor);
            _edit.Number = number;
            if (isNew) Audit.Created(ScreenCode, "WH_PurchaseOrder", number, ToDatabase(_edit));
            else Audit.Updated(ScreenCode, "WH_PurchaseOrder", number, previous, ToDatabase(_edit));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Purchase order save failed");
            _error = L["Scm.Text.SaveFailedCheckQuantityPricePrecisionDestinationMappingsAnd"];
            return;
        }
        _edit = null;
        if (ReloadOrders(number)) _message = L["Scm.Text.OrderSaved"];
        else _message = L["Scm.Text.SavedButReloadFailedRefreshTheList"];
    }
    void ChangeStatus(string status)
    {
        if (!CanEdit || _selected is null) return;
        if (status == "Published" && (IsPortal || !CanApprove || _selected.Status != "Draft")) return;
        if (status == "Published" && !ValidateMaterial(_selected)) { _message = _error; return; }
        if (status == "Confirmed" && (!IsPortal || _selected.Status != "Published")) return;
        if (status == "Cancelled" && (IsPortal || _selected.Status is not ("Draft" or "Published") || Store.Delivered(_selected) > 0)) return;
        if (!IsPortal)
        {
            if (status is not ("Published" or "Cancelled")) return;
            var number = _selected.Number;
            try
            {
                Scm.ChangePurchaseOrderStatus(ToDatabase(_selected), _selected.Versions, status == "Published" ? "Open" : "Cancelled", _actor);
                Audit.Log(ScreenCode, status == "Published" ? "PUBLISH" : "CANCEL", "WH_PurchaseOrder", number, new { _selected.Status }, new { Status = status });
            }
            catch (Exception ex) { Logger.LogError(ex,"Order status change failed"); _message = L["Scm.Text.UnableToChangeStatusReloadAndCheckInboundReferences"]; return; }
            if (ReloadOrders(number)) _message = status == "Published"
                ? L["Scm.Text.OrderIssued"]
                : L["Scm.Text.OrderCancelled"];
            else _message = L["Scm.Text.StatusSavedButReloadFailed"];
            return;
        }
        _selected.Status = status; Done();
    }
    async Task ConfirmOrderPrompt()
    {
        if (!CanConfirmOrder || _selected is null) return;
        var confirmed = await Dialog.Confirm($"Confirm order {_selected.Number}?", "Confirm Order",
            new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (confirmed == true) ConfirmOrder();
    }
    void ConfirmOrder()
    {
        if (!CanConfirmOrder || _selected is null) return;
        var number = _selected.Number;
        try
        {
            var changed = Scm.ConfirmSupplierOrder(number, _selected.Versions, _portalUserId!, _actor);
            if (changed) Audit.Log(ScreenCode, "CONFIRM", "WH_PurchaseOrder", number,
                new { SupplierConfirmedAt = _selected.SupplierConfirmedAt }, new { Confirmed = true, Actor = _actor });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Supplier order confirmation failed");
            _message = L["Scm.Text.ConfirmationFailedReloadAndCheckOrderStatusAndVendor"];
            return;
        }
        if (ReloadOrders(number)) _message = L["Scm.Text.OrderConfirmationCompleted"];
        else _message = L["Scm.Text.ConfirmationSavedButReloadFailed"];
    }
    bool _isExternalPortalUser;
    string _actor = "";
    string? _portalUserId;
    List<ScmPreviewStore.Order> _dbOrders = new();
    static ScmRepository.PurchaseOrder ToDatabase(ScmPreviewStore.Order o) => new(o.Number,o.Vendor,o.Ordered,o.Due,o.Destination,o.Status,o.Currency,
        o.Lines.Select(l => new ScmRepository.PurchaseLine(l.Id,l.Item,l.Name,l.Unit,l.Quantity,l.Price,l.Received)).ToList());
    bool ReloadOrders(string? selectedNumber = null)
    {
        _noteDeliveries.Clear();
        try
        {
            _dbOrders = Scm.ListPurchaseOrders(IsPortal, _portalUserId).Select(o => new ScmPreviewStore.Order {
                Number=o.Number,Vendor=o.Vendor,VendorName=o.VendorName,CreatedBy=o.CreatedBy,SupplierConfirmedAt=o.SupplierConfirmedAt,SupplierConfirmedBy=o.SupplierConfirmedBy,Ordered=o.Ordered,Due=o.Due,Destination=o.Destination,Currency=o.Currency,Persistent=true,
                Status=o.Status switch { "Open" => "Published", "Partial" => "Confirmed", "Complete" or "Received" => "Closed", "Draft" => "Draft", "Cancelled" => "Cancelled", _ => o.Status },
                Versions=o.Lines.ToDictionary(l => l.PoID,l => l.Version),
                Lines=o.Lines.Where(l=>!(IsPortal && Mode=="Due") || l.ItemExists).Select(l => new ScmPreviewStore.OrderLine {PoID=l.PoID,Id=l.Id,Item=l.Item,Name=l.Name,Unit=l.Unit,Quantity=l.Quantity,Price=l.Price,Received=l.Received}).ToList()
            }).Where(o=>!(IsPortal && Mode=="Due") || o.Lines.Count>0).ToList();
            var deliveries = Scm.ListSupplierDeliveries(IsPortal, _portalUserId);
            var prepared=IsPortal && Mode=="Due" && _isExternalPortalUser
                ? Scm.ListDeliveryCases(null,_portalUserId!).Where(c=>c.Status=="Prepared" && c.NoteNumber.Length==0 && c.Delivery is null)
                    .SelectMany(c=>c.Boxes).GroupBy(b=>b.PoID).ToDictionary(g=>g.Key,g=>g.Sum(b=>b.Quantity))
                : new Dictionary<int,decimal>();
            Store.Deliveries.Clear();
            Store.Deliveries.AddRange(deliveries.Select(d => new ScmPreviewStore.Delivery {
                Number=d.Number,OrderNumber=d.OrderNumber,PoID=d.PoID,LineId=d.LineId,Item=d.Item,Unit=d.Unit,
                VendorLotNo=d.VendorLotNo,ProductionDate=d.ProductionDate,Date=d.Date,Quantity=d.Quantity,Received=d.Received,Status=d.Status,Version=d.Version,ShipDate=d.ShipDate,ShippedAt=d.ShippedAt,ShippedBy=d.ShippedBy
            }));
            foreach(var order in _dbOrders)
                foreach(var line in order.Lines)
                {
                    var active=deliveries.Where(d=>d.PoID==line.PoID && d.Status!="Cancelled").ToList();
                    line.RegisteredDelivery=active.Sum(d=>d.Quantity);
                    line.ShippedQuantity=active.Where(d=>d.ShippedAt.HasValue || d.Status is "Shipped" or "Received").Sum(d=>d.Quantity);
                    line.PendingDelivery=active.Sum(d=>d.Quantity-d.Received);
                    line.PreparedQuantity=prepared.GetValueOrDefault(line.PoID);
                }
            _selected = _dbOrders.Find(o => o.Number == selectedNumber);
            LoadNotes();
            LoadReceiptResults();
            return true;
        }
        catch (Exception ex) { Logger.LogError(ex,"Purchase order load failed"); _dbOrders.Clear(); _selected=null; _message=L["Scm.Text.UnableToLoadOrdersRetry"]; return false; }
    }
    static string DefaultLot(DateTime date) => date.ToString("yyyyMMdd",CultureInfo.InvariantCulture);
    void ChangeEditedDeliveryDate(DateTime date)
    {
        if(_delivery is null) return;
        foreach(var line in _deliveryEditLines)
        {
            if(line.VendorLotNo==DefaultLot(_delivery.Date)) line.VendorLotNo=DefaultLot(date);
            if(line.ProductionDate.Date==_delivery.Date.Date) line.ProductionDate=date.Date;
        }
        _delivery.Date=date.Date;
    }
    void OpenShipPrompt()
    {
        if(!DeliveryEditable || _delivery is null) return;
        var original=Store.Deliveries.Where(d=>d.Number==_delivery.Number).ToList();
        if(original.Any(d=>d.Date!=_delivery.Date || _deliveryEditLines.Any(l=>l.PoID==d.PoID && (l.Quantity!=d.Quantity || l.VendorLotNo!=d.VendorLotNo || l.ProductionDate!=d.ProductionDate))))
        { _message=L["Scm.Text.SaveYourEditsBeforeConfirmingShipment"]; return; }
        _cancelDeliveryPrompt=false; _shipDeliveryPrompt=true;
    }
    void ShipDelivery() => UpdateDelivery(false,true);
    void SaveDelivery() => UpdateDelivery(false);
    void CancelDelivery() => UpdateDelivery(true);
    void UpdateDelivery(bool cancel, bool ship=false)
    {
        if(!DeliveryEditable || _delivery is null || _selected is null) return;
        if(!cancel && !ship && _deliveryEditLines.Any(l=>l.Quantity<=0 || l.Quantity>EditableDeliveryBalance(l) || decimal.Round(l.Quantity,3)!=l.Quantity))
        { _message=L["Scm.Text.EnterPositiveQuantitiesWithinTheAvailableMaximumUpTo"]; return; }
        var number=_delivery.Number; var orderNumber=_delivery.OrderNumber;
        var before=Store.Deliveries.Where(d=>d.Number==number).Select(d=>d.Copy()).ToArray();
        try
        {
            Scm.UpdateSupplierDelivery(number,ship?_shipDate:_delivery.Date,
                (ship?before.AsEnumerable():_deliveryEditLines).Select(l=>new ScmRepository.DeliveryInput(l.PoID,l.Quantity,l.VendorLotNo,l.ProductionDate)).ToList(),
                _delivery.Version,_selected.Versions,_portalUserId!,_actor,cancel,ship);
            Audit.Log(ScreenCode,ship?"SHIP":cancel?"CANCEL":"UPDATE","SCM_Delivery",number,before,
                new {Date=_delivery.Date,ShipDate=ship?(DateTime?)_shipDate:null,Shipped=ship,Cancelled=cancel,Lines=_deliveryEditLines.Select(l=>new {l.PoID,l.Quantity,l.VendorLotNo,l.ProductionDate}).ToArray()});
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Delivery update failed");
            _message=L["Scm.Text.SaveFailedCheckDateBalancePermissionsAndReceivingReferences"];return;
        }
        _cancelDeliveryPrompt=false;
        if(ReloadOrders(orderNumber))
        {
            var updated=Store.Deliveries.FirstOrDefault(d=>d.Number==number);
            if(updated is not null) SelectDelivery(updated); else _delivery=null;
            _message=ship?L["Scm.Text.ShipmentConfirmedAwaitingEOSReceipt"]:cancel?L["Scm.Text.DeliveryCancelledQuantitiesReleased"]
                :L["Scm.Text.DeliveryChangesSaved"];
        }
        else {_delivery=null;_message=L["Scm.Text.SavedButReloadFailedRefresh.757eb2"];}
    }
    void Done() => _message = L["Scm.Text.PreviewUpdatedNoBusinessDataWasSaved"];
    static string PortalOrderStatus(ScmPreviewStore.Order order) => ScmRepository.PortalOrderStatus(
        order.Status=="Cancelled",order.Lines.Select(line=>(line.Quantity,line.ShippedQuantity,line.Received)));
    static bool ProgressReceived(ScmPreviewStore.Order order) => order.Status=="Closed"
        || order.Lines.Count>0 && order.Lines.All(line=>line.Received>=line.Quantity);
    string ProgressStatus(ScmPreviewStore.Order o)
    {
        if(o.Status is "Draft" or "Cancelled") return Status(o.Status);
        if(o.Lines.Count>0 && o.Lines.All(l=>l.Received>=l.Quantity)) return L["Scm.Text.Received.2a92a7"];
        if(o.Lines.Any(l=>l.Received>0)) return L["Scm.Text.PartiallyReceived"];
        if(o.Lines.Any(l=>l.ShippedQuantity>0)) return L["Scm.Text.Shipped.b0d543"];
        if(o.Lines.Any(l=>l.RegisteredDelivery>0)) return L["Scm.Text.PreparingDelivery"];
        return o.SupplierConfirmedAt.HasValue ? L["Scm.Text.Confirmed.538025"] : L["Scm.Text.AwaitingConfirmation.c207aa"];
    }
    static string Badge(string status) => status switch { "Closed" or "Received" or "Inspected" => "ok", "Draft" or "PartiallyReceived" => "warn", "Cancelled" => "bad", _ => "info" };
    string Status(string status) => status switch {
        "Outstanding" => L["Scm.Text.AvailableToRegister.388045"],
        "Draft" => L["Scm.Text.Draft"], "Published" => L["Scm.Text.Published"],
        "Confirmed" => L["Scm.Text.Receiving"], "Closed" => L["Scm.Text.Closed"],
        "PartiallyReceived" => "Partially received",
        "Shipped" => L["Scm.Text.Shipped.b0d543"], "Received" => L["Scm.Text.Received.2a92a7"], "Registered" => L["Scm.Text.Scheduled.b83eb1"], "Inspected" => L["Scm.Text.Received.2a92a7"],
        _ => L["Scm.Text.Cancelled.7cc538"]
    };
