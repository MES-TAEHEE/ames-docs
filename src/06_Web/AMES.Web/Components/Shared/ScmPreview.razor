    string ReceiptQuantity(string delivery,bool received)
    {
        if(_receiptError.Length>0)return "—";
        var lines=ReceiptLines(delivery);
        if(lines.Count==0)return "—";
        return string.Join(" / ",lines.GroupBy(r=>r.Unit).Select(g=>$"{QtyFormat.Text(g.Sum(r=>received?r.Received:r.Remaining),g.Key)} {UomFmt.Sym(g.Key)}"));
    }
    string ReceiptStatus(string delivery)
    {
        if(_receiptError.Length>0)return "Unavailable";
        var lines=ReceiptLines(delivery);
        if(lines.Count==0)return "NotShipped";
        if(lines.All(r=>r.Received<=0))return "NotReceived";
        return lines.All(r=>r.Remaining==0) ? "Received" : "Partial";
    }
