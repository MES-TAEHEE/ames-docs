    async Task SelectMaterial(ScmPreviewStore.OrderLine line)
    {
        var item=_materials.Find(x=>x.ItemNo==line.Item);
        line.Name=item?.ItemName ?? "";
        line.Unit=item?.DefaultUOM ?? "";
        line.Price=item?.UnitCost ?? 0m;
        if(item is null || _edit is null)return;
        var editor=_edit;var vendor=editor.Vendor;var itemNo=line.Item;var unit=line.Unit;
        _priceLoading.Add(line);
        var initialPrice=line.Price;
        try
        {
            var price=await Task.Run(()=>Scm.FindPurchasePrice(vendor,itemNo,unit));
            if(_edit==editor && editor.Vendor==vendor && line.Item==itemNo && line.Unit==unit && line.Price==initialPrice)line.Price=price ?? item.UnitCost ?? 0m;
        }
        catch(Exception ex){Logger.LogWarning(ex,"SCM price lookup failed");_error=L["SCM.Preview.Err.LastPrice"];}
        finally{_priceLoading.Remove(line);}
    }
    bool ValidateMaterial(ScmPreviewStore.Order order)
    {
        if (!LoadMaterials(order.Vendor)) return false;
        if (!LoadVendors()) return false;
        if (!_vendors.Any(v => v.VendorID == order.Vendor && v.ActiveFlag))
        {
            _error = L["Scm.Text.SelectAnActiveVendor"];
            return false;
        }
        if (order.Lines.Count == 0)
        {
            _error = L["Scm.Text.AddAtLeastOneItem"];
            return false;
        }
        foreach (var line in order.Lines)
        {
            var item = _materials.Find(x => x.ItemNo == line.Item);
            if (item is null || !item.ActiveFlag || line.Quantity <= 0 || line.Price < 0)
            {
                _error = $"{order.Lines.IndexOf(line) + 1}: " + L["Scm.Text.CheckVendorLinkedMATERIALItemPositiveQuantityAndNon"];
                return false;
            }
            if (!string.Equals(line.Unit,item.DefaultUOM,StringComparison.OrdinalIgnoreCase))
            { _error=L["SCM.Preview.Err.UnitChangedFmt", line.Item, line.Unit, item.DefaultUOM ?? ""]; return false; }
            line.Name = item.ItemName;
        }
        return true;
    }
