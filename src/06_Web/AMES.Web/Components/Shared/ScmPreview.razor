@inject PortalQuantityFormat QtyFormat
@inject ScmPreviewStore Store
@inject PermissionService Permissions
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Nav
@inject MasterDataRepository MasterData
@inject ScmRepository Scm
@inject ILogger<ScmPreview> Logger
@inject AuditLogger Audit
@inject IStringLocalizer<SharedResources> L
@inject UomFormat UomFmt
@inject DialogService Dialog
@inject ActorNames Actors
@using System.Globalization

<PageTitle>@ScreenCode @Title · AMES</PageTitle>
<AmesPageHeader Code="@ScreenCode" Title="@Title" />
@if (_ready)
{
    @if (Mode == "Deliveries")
    {
        <div class="ames-kpis">
            <div class="ames-kpi info"><div class="ames-kpi-l">@L["Scm.Text.DeliveryNotes"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count : DeliveryRows.Count)</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.Scheduled"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count(d=>NoteStatus(d)=="Registered") : DeliveryRows.Count(d=>d.Status=="Registered"))</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.Shipped"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count(d=>NoteStatus(d)=="Shipped") : DeliveryRows.Count(d=>d.Status=="Shipped"))</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.Received"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count(d=>NoteStatus(d)=="Received") : DeliveryRows.Count(d=>d.Status=="Received"))</div></div>
            <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.Cancelled"]</div><div class="ames-kpi-v">@(IsPortal ? PortalNoteRows.Count(d=>NoteStatus(d)=="Cancelled") : DeliveryRows.Count(d=>d.Status=="Cancelled"))</div></div>
        </div>
    }
    else
    {
    <div class="ames-kpis">
        <div class="ames-kpi info"><div class="ames-kpi-l">@L["Portal.Home.Kpi.Orders"]</div><div class="ames-kpi-v">@Rows.Count</div></div>
        <div class="ames-kpi"><div class="ames-kpi-l">@L["Scm.Text.AwaitingConfirmation"]</div><div class="ames-kpi-v">@Rows.Count(x => (x.Status is "Published" or "Confirmed") && x.SupplierConfirmedAt is null)</div></div>
        <div class="ames-kpi warn"><div class="ames-kpi-l">@L["Portal.Home.Kpi.InDelivery"]</div><div class="ames-kpi-v">@Rows.Count(x => x.Lines.Any(l => l.PendingDelivery > 0))</div></div>
        <div class="ames-kpi bad"><div class="ames-kpi-l">@L["Portal.Home.Kpi.Overdue"]</div><div class="ames-kpi-v">@Rows.Count(x => x.Due.Date < DbClock.Today && Store.Remaining(x) > 0 && x.Status is "Published" or "Confirmed")</div></div>
    </div>
    }
    @if (!string.IsNullOrEmpty(_message) && _selected is null && _edit is null && _delivery is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false">@_message</RadzenAlert>
    }

    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="white-space:nowrap;">▼ @Title · @(IsPortal && Mode=="Deliveries" ? PortalNoteRows.Count : Mode is "Deliveries" or "Receipts" ? DeliveryRows.Count : Rows.Count) @L["Scm.Text.Items"]</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="_search" Immediate="true" @onkeydown="SearchKeyDown" Placeholder='@(Mode == "Deliveries" ? L["SCM.Preview.Ph.DeliverySearch"] : L["SCM.Preview.Ph.OrderSearch"])' InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
                @if (!IsPortal)
                {
                    <RadzenLabel Text='@L["Scm.Text.Supplier"]' Component="ScmDropDownVendor" />
                    <RadzenDropDown Name="ScmDropDownVendor" @bind-Value:get="_vendor" @bind-Value:set="SetVendor" Data="@VendorFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" InputSize="InputSize.Small" class="ames-rz-input" Style="width:360px;" />
                }
                @if (!IsPortal && Mode == "Orders")
                {
                    <RadzenLabel Text='@L["SCM.Preview.Col.CreatedBy"]' Component="ScmDropDownCreator" />
                    <RadzenDropDown Name="ScmDropDownCreator" @bind-Value:get="_creator" @bind-Value:set="SetCreator" Data="@CreatorFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
                }
                <RadzenLabel Text='@L["Col.Status"]' Component="ScmDropDownStatus" />
                <RadzenDropDown Name="ScmDropDownStatus" @bind-Value:get="_status" @bind-Value:set="SetStatus" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:190px;" />
                @if ((IsPortal && (Mode is "Orders" or "Deliveries")) || (!IsPortal && Mode == "Progress"))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenCheckBox TValue="bool" Value="@_includeClosed" Change="@ToggleClosed" Name="ScmChkClosed" />
                        <RadzenLabel Text='@(IsPortal ? L["SCM.Preview.Lbl.IncludeClosed"] : L["SCM.Preview.Lbl.IncludeReceived"])' Component="ScmChkClosed" style="cursor:pointer;" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenCheckBox TValue="bool" Value="@_includeCancelled" Change="@ToggleCancelled" Name="ScmChkCancelled" />
                        <RadzenLabel Text='@L["SCM.Preview.Lbl.IncludeCancelled"]' Component="ScmChkCancelled" style="cursor:pointer;" />
                    </RadzenStack>
                }
                <div class="scm-date-range">
                    <RadzenLabel Text='@(Mode == "Deliveries" ? L["Scm.Text.DeliveryDate"] : L["Scm.Text.Due"])' Component="ScmDateFrom" />
                    <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" Name="ScmDateFrom" @bind-Value="_from" @bind-Value:after="Search" DateFormat="@DateFmt.Date" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
                    <span class="dim">~</span>
                    <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" Name="ScmDateTo" @bind-Value="_to" @bind-Value:after="Search" DateFormat="@DateFmt.Date" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
                </div>
                <RadzenButton Text='@L["Btn.Search"]' Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="Search" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Reset"]' Icon="restart_alt" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ResetAndReload" class="ames-rz-btn" />
                @if (!IsPortal && Mode == "Orders" && CanEdit)
                {
                    <RadzenButton Text='@L["Scm.Text.NewOrder"]' Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="NewOrder" class="ames-rz-btn" />
                }
                @if (IsPortal && Mode == "Due" && _isExternalPortalUser)
                {
                    <RadzenButton Text='@L["SCM.Preview.Btn.CreateNote"]' Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCaseSelection" class="ames-rz-btn" />
                }
            </RadzenStack>
        </div>
        @if (!IsPortal) { <div class="dim" style="font-size:var(--ames-fs-hint);padding:0 0 6px;">
            ℹ
            @if (IsPortal && Mode=="Due") { @L["Scm.Text.OriginalRegisteredAndRemainingQuantitiesAreShownForConfirmed"] }
            else if(Mode=="Progress") { @L["Scm.Text.TrackSupplierConfirmationAndDeliveriesShippedIsTheCumulative"] }
            else if (IsPortal) { @L["Scm.Text.ViewPurchaseOrdersConfirmOrdersRegisterDeliveriesAndConfirm"] }
            else { @L["Scm.Text.CreatePurchaseOrdersAndViewTheirStatusAndReceived"] }
            @if (IsPortal) { <span> · @L["Scm.Text.OnlyOrdersForLinkedVendorsAreVisibleUnlinkedAccounts"]</span> }
        </div>
        }
        @if (_from > _to)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@L["Scm.Text.EndDateMustFollowStartDate"]</RadzenAlert>
        }

        @if (IsPortal && Mode=="Deliveries")
        {
            <RadzenDataGrid @ref="_portalNoteGrid" TItem="PortalNoteRow" Data="@PortalNoteRows" AllowPaging="true" PageSize="@_pageRows" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@PagerSummary" PageSizeText="@PagerSize"
                            RowClick="@(args => { if(args.Data is not null) SelectNote(args.Data); })" RowRender="RowLinkNote" EmptyText="@Empty" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="60px" MinWidth="60px" Title='@L["Col.RowNo"]' TextAlign="TextAlign.Center" Sortable="false"><Template Context="n"><span class="dim">@GridRowNo.Of(_portalNoteGrid,n)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="110px" MinWidth="110px" Title='@L["Btn.Print"]' TextAlign="TextAlign.Center" Sortable="false"><Template Context="n"><div @onclick:stopPropagation="true"><RadzenButton Text='@L["Btn.Print"]' Icon="print" Size="ButtonSize.ExtraSmall" Disabled="@(n.Deliveries.All(d=>d.Status=="Cancelled") || _noteBusy)" Click="@(()=>OpenPrintingGroup(n))" /></div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="190px" MinWidth="190px" Property="Number" Title='@L["Scm.Text.DeliveryNote"]' TextAlign="TextAlign.Center"><Template Context="n"><span class="code">@n.Number</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="170px" MinWidth="170px" Title='@L["Scm.Text.Order"]'><Template Context="n">@string.Join(", ",n.Deliveries.Select(d=>d.OrderNumber).Distinct())</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" MinWidth="200px" Title='@L["Scm.Text.ItemLabel"]'><Template Context="n">@string.Join(", ",Store.Deliveries.Where(d=>n.Numbers.Contains(d.Number)).Select(d=>d.Item).Distinct())</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="170px" MinWidth="170px" Title='@L["Scm.Text.DeliveryDate.246618"]' TextAlign="TextAlign.Center"><Template Context="n">@n.Deliveries.Min(d=>d.Date).ToString(DateFmt.Date)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="145px" MinWidth="145px" Title='@L["Scm.Text.Quantity"]' TextAlign="TextAlign.Right"><Template Context="n">@NoteQuantities(n,d=>d.Quantity)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="145px" MinWidth="145px" Title='@L["Portal.Receipts.Col.ReceivedQty"]' TextAlign="TextAlign.Right"><Template Context="n">@NoteReceiptQuantities(n,true)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="150px" MinWidth="150px" Title='@L["Portal.Receipts.Col.RemainingQty"]' TextAlign="TextAlign.Right"><Template Context="n">@NoteReceiptQuantities(n,false)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="150px" MinWidth="150px" Title='@L["Scm.Text.ShipDate"]' TextAlign="TextAlign.Center"><Template Context="n">@n.Deliveries.Where(d=>d.ShipDate.HasValue).Min(d=>d.ShipDate)?.ToString(DateFmt.Date)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="240px" MinWidth="240px" Title='@L["Col.Status"]' TextAlign="TextAlign.Center"><Template Context="n"><span class="pill @Badge(NoteStatus(n))">@Status(NoteStatus(n))</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="170px" MinWidth="170px" Title='@L["Portal.Text.ReceiptStatus"]' TextAlign="TextAlign.Center"><Template Context="n"><span class="pill @ReceiptBadgeOf(NoteReceiptStatus(n))">@ReceiptLabel(NoteReceiptStatus(n))</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PortalNoteRow" Width="170px" MinWidth="170px" Title='@L["SCM.Preview.Col.QtyMismatch"]' TextAlign="TextAlign.Center" Sortable="false"><Template Context="n"><div @onclick:stopPropagation="true">@if(NoteMismatches(n).Count>0){<button type="button" class="scm-mismatch-button" title='@L["SCM.Preview.Hint.ViewMismatch"]' aria-label='@L["SCM.Preview.Hint.ViewMismatch"]' @onclick="()=>OpenNoteMismatch(n)"><RadzenIcon Icon="check_circle" /> @L["Lbl.Yes"]</button>}else{<span class="dim">@L["SCM.Preview.Msg.None"]</span>}</div></Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else if (Mode is "Deliveries" or "Receipts")
        {
            <RadzenDataGrid @ref="_deliveryGrid" TItem="ScmPreviewStore.Delivery" Data="@DeliveryRows" AllowPaging="true" PageSize="@_pageRows" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@PagerSummary" PageSizeText="@PagerSize"
                            RowClick="@(args => { if (args.Data is not null) SelectDelivery(args.Data); })" RowRender="@RowLinkDelivery" EmptyText="@Empty" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="60px" Title='@L["Col.RowNo"]' MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="d"><span class="dim">@GridRowNo.Of(_deliveryGrid, d)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="150px" MinWidth="150px" TextAlign="TextAlign.Center" Property="Number" Title='@L["Scm.Text.DeliveryNote"]'>
                        <Template Context="d"><span class="code">@NoteNumber(d.Number)</span>@if(NoteNumber(d.Number)!=d.Number){<div class="dim">@d.Number</div>}</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="160px" MinWidth="160px" TextAlign="TextAlign.Center" Property="OrderNumber" Title='@L["Scm.Text.Order"]'>
                        <Template Context="d"><span class="code">@d.OrderNumber</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" MinWidth="200px" Title='@L["Scm.Text.ItemLabel"]'><Template Context="d">@d.Item</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="170px" MinWidth="170px" Property="Date" Title='@L["Scm.Text.DeliveryDate.246618"]' TextAlign="TextAlign.Center">
                        <Template Context="d">@d.Date.ToString(DateFmt.Date)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="170px" MinWidth="170px" Title='@L["Scm.Text.Quantity"]' TextAlign="TextAlign.Right"><Template Context="d">@DeliveryQuantities(d.Number)</Template></RadzenDataGridColumn>
                    @if (IsPortal && Mode=="Deliveries")
                    {
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="150px" MinWidth="150px" Title='@L["Portal.Receipts.Col.ReceivedQty"]' TextAlign="TextAlign.Right"><Template Context="d">@ReceiptQuantity(d.Number, true)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="150px" MinWidth="150px" Title='@L["Portal.Receipts.Col.RemainingQty"]' TextAlign="TextAlign.Right"><Template Context="d">@ReceiptQuantity(d.Number, false)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="160px" MinWidth="160px" Title='@L["Portal.Text.ReceiptStatus"]' TextAlign="TextAlign.Center"><Template Context="d"><span class="pill @ReceiptBadgeOf(ReceiptStatus(d.Number))">@ReceiptLabel(ReceiptStatus(d.Number))</span></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="170px" MinWidth="170px" Title='@L["SCM.Preview.Col.QtyMismatch"]' TextAlign="TextAlign.Center" Sortable="false"><Template Context="d"><div @onclick:stopPropagation="true"><button type="button" class="receipt-mismatch" disabled="@(MismatchCount(d.Number)==0)" @onclick="()=>OpenMismatch(d)">@MismatchCount(d.Number)</button></div></Template></RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="150px" MinWidth="150px" TextAlign="TextAlign.Center" Property="ShipDate" FormatString="@DateFmt.Fmt(DateFmt.Date)" Title='@L["Scm.Text.ShipDate"]' />
                    @if (Mode == "Receipts")
                    {
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="120px" MinWidth="120px" Property="Accepted" Title='@L["Scm.Text.Accepted"]' TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="130px" MinWidth="130px" Property="Rejected" Title='@L["Scm.Text.Rejected"]' TextAlign="TextAlign.Right" />
                    }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="240px" MinWidth="240px" Title='@L["Col.Status"]' TextAlign="TextAlign.Center">
                        <Template Context="d"><span class="pill @Badge(d.Status)">@Status(d.Status)</span></Template>
                    </RadzenDataGridColumn>
                    @if (IsPortal && Mode=="Deliveries" && _isExternalPortalUser)
                    {
                        <RadzenDataGridColumn TItem="ScmPreviewStore.Delivery" Width="130px" MinWidth="130px" Title='@L["Btn.Print"]' TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                            <Template Context="d">
                                <div @onclick:stopPropagation="true">
                                    <RadzenButton Text='@L["Btn.Print"]' Icon="print" Size="ButtonSize.ExtraSmall" class="ames-rz-btn" Disabled="@(_noteBusy || d.Status=="Cancelled")" Click="@(()=>OpenPrinting(d))" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        }
        else if(IsPortal && Mode=="Due")
        {
            <RadzenDataGrid @ref="_orderGrid" TItem="ScmPreviewStore.Order" Data="@Rows" AllowPaging="true" PageSize="@_pageRows" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@PagerSummary" PageSizeText="@PagerSize"
                            EmptyText="@Empty" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="60px" Title='@L["Col.RowNo"]' MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="o"><span class="dim">@GridRowNo.Of(_orderGrid, o)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="190px" MinWidth="190px" TextAlign="TextAlign.Center" Property="Number" Title='@L["SCM.Preview.Col.PoNo"]'><Template Context="o"><span class="code">@o.Number</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="130px" MinWidth="130px" TextAlign="TextAlign.Center" Property="Due" Title='@L["Scm.Text.DueDate"]'><Template Context="o"><span style="@(o.Due.Date < DbClock.Today ? "color:var(--ames-tx-red-500)" : null)">@o.Due.ToString(DateFmt.Date)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" MinWidth="160px" Property="VendorName" Title='@L["Scm.Text.Supplier"]' />
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="90px" MinWidth="90px" TextAlign="TextAlign.Right" Title='@L["Scm.Text.Lines"]'><Template Context="o">@o.Lines.Count</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="120px" MinWidth="120px" TextAlign="TextAlign.Right" Title='@L["Scm.Text.Ordered"]'><Template Context="o">@Quantities(o,l=>l.Quantity)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="150px" MinWidth="150px" TextAlign="TextAlign.Right" Title='@L["SCM.Preview.Col.RegisteredQty"]'><Template Context="o">@Quantities(o,l=>l.RegisteredDelivery)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="170px" MinWidth="170px" TextAlign="TextAlign.Right" Title='@L["SCM.Preview.Col.QtyToDeliver"]'><Template Context="o">@Quantities(o,l=>l.AvailableDelivery)</Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenDataGrid @ref="_orderGrid" TItem="ScmPreviewStore.Order" Data="@Rows" AllowPaging="true" PageSize="@_pageRows" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@PagerSummary" PageSizeText="@PagerSize"
                            RowClick="@(args => { if (args.Data is not null) Select(args.Data); })" RowRender="@RowLinkOrder" EmptyText="@Empty" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
                <Columns>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="60px" Title='@L["Col.RowNo"]' MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="o"><span class="dim">@GridRowNo.Of(_orderGrid, o)</span></Template>
                    </RadzenDataGridColumn>
                    @if (Mode == "Due") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="140px" MinWidth="140px" Property="Due" Title='@L["Scm.Text.DueDate"]' TextAlign="TextAlign.Center"><Template Context="o">@o.Due.ToString(DateFmt.Date)</Template></RadzenDataGridColumn> }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="160px" MinWidth="160px" TextAlign="TextAlign.Center" Property="Number" Title='@L["Scm.Text.Order"]'>
                        <Template Context="o"><span class="code">@o.Number</span></Template>
                    </RadzenDataGridColumn>
                    @if (Mode == "Orders") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="125px" MinWidth="125px" Property="Ordered" Title='@L["Scm.Text.OrderDate"]' TextAlign="TextAlign.Center"><Template Context="o">@o.Ordered.ToString(DateFmt.Date)</Template></RadzenDataGridColumn> }
                    @if (!IsPortal && Mode == "Orders") { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="160px" MinWidth="160px" Property="CreatedBy" Title='@L["SCM.Preview.Col.CreatedBy"]' TextAlign="TextAlign.Center"><Template Context="o">@Actors.Display(o.CreatedBy)</Template></RadzenDataGridColumn> }
                    @if (!IsPortal) { <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="240px" MinWidth="240px" Property="Vendor" Title='@L["Scm.Text.Supplier"]'><Template Context="order"><span class="code">@order.Vendor</span><span class="dim" style="font-size:.8em;margin-left:4px;">@VendorName(order.Vendor)</span></Template></RadzenDataGridColumn> }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="210px" MinWidth="210px" TextAlign="TextAlign.Center" Property="Item" Title='@L["Scm.Text.Item"]'><Template Context="o"><span class="code">@(o.Lines.FirstOrDefault()?.Item)</span>@if (o.LineCount > 1) { <span class="pill info" style="margin-left:6px;" title="@o.Item">+@(o.LineCount - 1)</span> }</Template></RadzenDataGridColumn>
                    @if(Mode!="Progress")
                    {
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" MinWidth="200px" Property="Name" Title='@L["Scm.Text.Description"]'><Template Context="o"><span title="@o.Name">@(o.Lines.FirstOrDefault()?.Name)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="90px" MinWidth="90px" Property="LineCount" Title='@L["Scm.Text.Lines"]' TextAlign="TextAlign.Right" />
                    }
                    <RadzenDataGridColumn TItem="ScmPreviewStore.Order" Width="170px" MinWidth="170px" Title='@L["Scm.Text.Ordered"]' TextAlign="TextAlign.Right"><Template Context="o">@Quantities(o, l => l.Quantity)</Template></RadzenDataGridColumn>
                    @if(Mode=="Progress")
                    {
