                <div class="ames-modal-h" style="display:flex;justify-content:space-between;align-items:center;"><span>@L["SCM.Preview.Print.Preview"]</span><RadzenButton Icon="close" aria-label='@L["Btn.Close"]' data-portal-close Click="@(()=>_previewUrl=null)" /></div>
