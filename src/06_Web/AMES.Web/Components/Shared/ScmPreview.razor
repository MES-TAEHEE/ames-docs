    @if (IsPortal && Mode=="Due" && _creationOrder is not null)
    {
        <div class="ames-modal-bg" data-no-busy>
            <div class="ames-modal" role="dialog" aria-modal="true" aria-label="Create Delivery Note" style="width:min(1500px,96vw);max-width:96vw;max-height:92vh;display:flex;flex-direction:column;">
                <div class="ames-modal-h" style="display:flex;align-items:center;justify-content:space-between;gap:16px;">
                    <span>Create Delivery Note</span>
                    <RadzenButton Icon="close" aria-label="Close creation" ButtonStyle="ButtonStyle.Light" Click="CloseCreation" />
                </div>
                <div class="ames-modal-body" style="overflow:auto;min-height:0;">
                    <AMES.Web.Components.Pages.Portal.DeliveryCases @key="_creationOrder" Embedded="true" InitialOrder="@_creationOrder" Changed="RefreshCreation" />
                </div>
            </div>
        </div>
