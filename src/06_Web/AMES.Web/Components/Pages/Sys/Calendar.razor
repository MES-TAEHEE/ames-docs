@page "/sys/calendar"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject SysRepository Sys
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-005 @L["SYS.Calendar.Title"] · AMES</PageTitle>
<AmesPageHeader Code="SYS-005" TitleKey="SYS.Calendar.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Calendar.Kpi.Days"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_days</div>
            <div class="ames-kpi-s">@L["SYS.Calendar.Kpi.DaysSub"]</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Calendar.Kpi.Work"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_work</div>
            <div class="ames-kpi-s">@L["SYS.Calendar.Kpi.WorkSub"]</div>
        </div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["SYS.Calendar.Kpi.Weekend"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_wknd</div>
            <div class="ames-kpi-s">@L["SYS.Calendar.Kpi.WeekendSub"]</div>
        </div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">@L["SYS.Calendar.Kpi.Holiday"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_hol</div>
            <div class="ames-kpi-s">@L["SYS.Calendar.Kpi.HolidaySub"]</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

@* ── Tab bar ───────────────────────────────────────────────────── *@
<div class="ames-cal-tabs">
    <div class="ames-cal-tab-group">
        <button class="ames-cal-tab @(_view == "list" ? "active" : "")" @onclick='() => SwitchView("list")'>≡ @L["SYS.Calendar.Tab.List"]</button>
        <button class="ames-cal-tab @(_view == "calendar" ? "active" : "")" @onclick='() => SwitchView("calendar")'>▦ @L["SYS.Calendar.Tab.Calendar"]</button>
    </div>
    <div style="flex:1;"></div>
    @if (_canEdit) { <RadzenButton Text="@L["SYS.Calendar.Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" Style="align-self:center;" /> }
</div>

@* ── LIST VIEW ──────────────────────────────────────────────────── *@
@if (_view == "list")
{
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
            <span>▼ @L["SYS.Calendar.Tab.List"] · @_byDay.Count @L["Lbl.Days"]</span>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <RadzenDatePicker TValue="DateTime" @bind-Value="_filterFrom" DateFormat="yyyy-MM-dd" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
                <span class="dim">~</span>
                <RadzenDatePicker TValue="DateTime" @bind-Value="_filterTo" DateFormat="yyyy-MM-dd" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
                <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Load" class="ames-rz-btn" />
            </div>
        </div>

        @if (_byDay.Count == 0)
        {
            <div class="ames-empty">@L["SYS.Calendar.Empty"]</div>
        }
        else
        {
            <RadzenDataGrid TItem="CalendarDaySummary" Data="@DaySummaries.ToList()" AllowPaging="false" AllowSorting="true" RowRender="@CalDayRowRender"
                            RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data.Date, args.Data.Shifts); })" Class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="CalendarDaySummary" Property="Date" Title="@L["SYS.Calendar.Col.Date"]">
                        <Template Context="row">
                            <span class="code">@(row.Date.ToString("yyyy-MM-dd ddd"))</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CalendarDaySummary" Property="DayType" Title="@L["SYS.Calendar.Col.DayType"]">
                        <Template Context="row">
                            @DayTypePill(row.DayType)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CalendarDaySummary" Property="HolidayName" Title="@L["SYS.Calendar.Col.HolidayName"]">
                        <Template Context="row">
                            <span class="dim">@(row.HolidayName ?? "—")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CalendarDaySummary" Title="@L["Col.ShiftA"]" TextAlign="TextAlign.Center" Width="72px" Sortable="false">
                        <Template Context="row">
                            <span class="ames-cal-sh @(row.HasA ? "sh-a" : "sh-off")">A</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CalendarDaySummary" Title="@L["Col.ShiftB"]" TextAlign="TextAlign.Center" Width="72px" Sortable="false">
                        <Template Context="row">
                            <span class="ames-cal-sh @(row.HasB ? "sh-b" : "sh-off")">B</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CalendarDaySummary" Title="@L["Col.ShiftC"]" TextAlign="TextAlign.Center" Width="72px" Sortable="false">
                        <Template Context="row">
                            <span class="ames-cal-sh @(row.HasC ? "sh-c" : "sh-off")">C</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CalendarDaySummary" Property="PlantCode" Title="@L["Col.Plant"]">
                        <Template Context="row">
                            <span class="dim">@(row.PlantCode ?? "—")</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </div>
}

@* ── CALENDAR VIEW ────────────────────────────────────────────────── *@
@if (_view == "calendar")
{
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;">
            <div style="display:flex;align-items:center;gap:12px;">
                <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@PrevMonth" class="ames-rz-btn" />
                <span style="font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:2px;color:#fff;">
                    @string.Format(L["SYS.Calendar.Fmt.YearMonth"].Value, _calYear, _calMonth.ToString("D2"))
                </span>
                <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@NextMonth" class="ames-rz-btn" />
            </div>
            <RadzenButton Text="@L["SYS.Calendar.Btn.Today"]" Icon="done" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@GoToday" class="ames-rz-btn" />
        </div>

        @{
            var firstOfMonth = new DateTime(_calYear, _calMonth, 1);
            var daysInMonth  = DateTime.DaysInMonth(_calYear, _calMonth);
            int startOffset  = (int)firstOfMonth.DayOfWeek; // 0=Sun
            int totalCells   = startOffset + daysInMonth;
            int rows         = (int)Math.Ceiling(totalCells / 7.0);
        }

        @* Day-of-week header *@
        <div class="ames-cal-grid">
            @foreach (var (label, cls) in new[] { (L["Day.Sun"].Value,"sun"),(L["Day.Mon"].Value,""),(L["Day.Tue"].Value,""),(L["Day.Wed"].Value,""),(L["Day.Thu"].Value,""),(L["Day.Fri"].Value,""),(L["Day.Sat"].Value,"sat") })
            {
                <div class="ames-cal-head @cls">@label</div>
            }

            @* Day cells *@
            @for (int cell = 0; cell < rows * 7; cell++)
            {
                int dayNum = cell - startOffset + 1;
                if (dayNum < 1 || dayNum > daysInMonth)
                {
                    <div class="ames-cal-cell ames-cal-cell--empty"></div>
                }
                else
                {
                    var date     = new DateTime(_calYear, _calMonth, dayNum);
                    bool hasData = _byDay.TryGetValue(date.Date, out var ds);
                    var  sample  = ds?.FirstOrDefault();
                    int  dow     = (int)date.DayOfWeek;   // 0=Sun, 6=Sat
                    bool isSun   = dow == 0;
                    bool isSat   = dow == 6;
                    bool isToday = date.Date == DateTime.Today;
                    bool hasA    = ds?.Any(r => r.ShiftCode == "A") ?? false;
                    bool hasB    = ds?.Any(r => r.ShiftCode == "B") ?? false;
                    bool hasC    = ds?.Any(r => r.ShiftCode == "C") ?? false;

                    var capDate   = date;
                    var capShifts = ds;

                    string cellCls = "ames-cal-cell";
                    if (isToday) cellCls += " ames-cal-cell--today";
                    if (hasData) cellCls += " ames-cal-cell--data";
                    if (sample?.DayType == "HOLIDAY")                        cellCls += " ames-cal-cell--holiday";
                    else if (sample?.DayType == "WEEKEND" || isSat || isSun) cellCls += " ames-cal-cell--weekend";

                    <div class="@cellCls" style="cursor:pointer;"
                         @onclick="() => OpenEdit(capDate, capShifts)">

                        <div class="ames-cal-daynum @(isSun ? "sun" : isSat ? "sat" : "")">
                            @dayNum
                            @if (isToday) { <span class="ames-cal-today-dot"></span> }
                        </div>

                        @if (sample is not null)
                        {
                            @if (sample.DayType == "HOLIDAY")
                            {
                                <div class="ames-cal-badge ames-cal-badge--holiday">@DayTypeName("HOLIDAY")</div>
                                @if (!string.IsNullOrWhiteSpace(sample.HolidayName))
                                {
                                    <div class="ames-cal-hname">@sample.HolidayName</div>
                                }
                            }
                            else if (sample.DayType == "WEEKEND")
                            {
                                <div class="ames-cal-badge ames-cal-badge--weekend">@DayTypeName("WEEKEND")</div>
                            }
                        }

                        @if (hasData)
                        {
                            <div class="ames-cal-shifts">
                                <span class="ames-cal-sh @(hasA ? "sh-a" : "sh-off")">A</span>
                                <span class="ames-cal-sh @(hasB ? "sh-b" : "sh-off")">B</span>
                                <span class="ames-cal-sh @(hasC ? "sh-c" : "sh-off")">C</span>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* Legend *@
        <div class="ames-cal-legend">
            <span class="ames-cal-sh sh-a">A</span> @L["SYS.Calendar.Legend.ShiftA"]
            <span class="ames-cal-sh sh-b" style="margin-left:10px;">B</span> @L["SYS.Calendar.Legend.ShiftB"]
            <span class="ames-cal-sh sh-c" style="margin-left:10px;">C</span> @L["SYS.Calendar.Legend.ShiftC"]
            <span class="pill ok"  style="margin-left:16px;">@DayTypeName("WORKDAY")</span>
            <span class="pill warn">@DayTypeName("WEEKEND")</span>
            <span class="pill bad">@DayTypeName("HOLIDAY")</span>
        </div>
    </div>
}

@* ── Generate Modal ───────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:780px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Calendar.Modal.Generate"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>@L["Col.From"] *</label>
                    <RadzenDatePicker TValue="DateTime" @bind-Value="_genFrom" DateFormat="yyyy-MM-dd" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <label>@L["SYS.Calendar.Lbl.EndDate"]</label>
                    <RadzenDatePicker TValue="DateTime" @bind-Value="_genTo" DateFormat="yyyy-MM-dd" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <label style="margin-top:8px;">@L["SYS.Calendar.Lbl.Plant"]</label>
            <RadzenDropDown @bind-Value="_genPlant" Data="@PlantOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />

            <div style="margin-top:12px;font-size:.84em;font-weight:600;color:#94a3b8;letter-spacing:.05em;">@L["SYS.Calendar.Lbl.ShiftConfig"]</div>
            <table class="ames-table" style="margin-top:4px;">
                <thead>
                    <tr>
                        <th style="width:44px;">@L["Col.Active"]</th>
                        <th style="width:56px;">@L["Col.Code"]</th>
                        <th style="width:130px;">@L["Col.Start"]</th>
                        <th style="width:130px;">@L["Col.End"]</th>
                        <th style="width:90px;">@L["Col.BreakMin"]</th>
                        <th style="width:80px;">@L["Col.NetWorkH"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int gi = 0; gi < _genShifts.Length; gi++)
                    {
                        var i = gi;
                        <tr style="@(!_genShifts[i].Active ? "opacity:.35;" : "")">
                            <td><input type="checkbox" @bind="_genShifts[i].Active" style="accent-color:#60a5fa;" /></td>
                            <td><span class="ames-cal-sh @ShiftBadgeCls(_genShifts[i].Code, _genShifts[i].Active)">@_genShifts[i].Code</span></td>
                            <td>
                                <input type="time" class="ames-input" value="@_genShifts[i].Start" @onchange="e => _genShifts[i].Start = e.Value?.ToString() ?? _genShifts[i].Start" disabled="@(!_genShifts[i].Active)" />
                            </td>
                            <td>
                                <input type="time" class="ames-input" value="@_genShifts[i].End" @onchange="e => _genShifts[i].End = e.Value?.ToString() ?? _genShifts[i].End" disabled="@(!_genShifts[i].Active)" />
                            </td>
                            <td>
                                <input type="number" class="ames-input" min="0" max="120" value="@_genShifts[i].BreakMin" @onchange="e => { if (int.TryParse(e.Value?.ToString(), out int b)) _genShifts[i].BreakMin = b; }" disabled="@(!_genShifts[i].Active)" />
                            </td>
                            <td class="num dim">
                                @(_genShifts[i].Active ? CalcNet(_genShifts[i].Start, _genShifts[i].End, _genShifts[i].BreakMin).ToString("0.0") : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="margin-top:14px;">
                <label class="ames-line-item" style="flex-direction:row;gap:8px;">
                    <input type="checkbox" @bind="_genSkipExisting" style="accent-color:#60a5fa;width:14px;height:14px;" />
                    <span>@L["SYS.Calendar.Lbl.SkipExisting"]</span>
                </label>
            </div>

            <div style="margin-top:10px;font-size:.84em;font-weight:600;color:#94a3b8;letter-spacing:.05em;">
                @L["SYS.Calendar.Lbl.Holidays"] <span class="dim" style="font-weight:400;">@L["SYS.Calendar.Hint.Holidays"]</span>
                <RadzenButton Text="@L["Btn.Add"]" Icon="add" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" Click="@AddHoliday" class="ames-rz-btn" Style="margin-left:8px;" />
            </div>
            @if (_genHolidays.Count > 0)
            {
                <table class="ames-table" style="margin-top:4px;">
                    <thead><tr><th>@L["Col.Date"]</th><th>@L["Col.HolidayName"]</th><th style="width:32px;"></th></tr></thead>
                    <tbody>
                        @for (int hi = 0; hi < _genHolidays.Count; hi++)
                        {
                            var hidx = hi;
                            <tr>
                                <td>
                                    <input type="date" class="ames-input" value="@_genHolidays[hidx].Date" @onchange="e => _genHolidays[hidx].Date = e.Value?.ToString() ?? _genHolidays[hidx].Date" />
                                </td>
                                <td>
                                    <input class="ames-input" placeholder="@L["SYS.Calendar.Ph.HolidayName"]" value="@_genHolidays[hidx].Name" @onchange="e => _genHolidays[hidx].Name = e.Value?.ToString() ?? _genHolidays[hidx].Name" autocomplete="off" />
                                </td>
                                <td>
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="() => _genHolidays.RemoveAt(hidx)" class="ames-rz-btn" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Generating"] : L["Btn.Generate"])" Icon="event" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@Generate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _selDate.HasValue)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:780px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">
                @_selDate.Value.ToString("yyyy-MM-dd ddd")
                <span class="dim" style="font-weight:400;font-size:.85em;margin-left:8px;">@L["SYS.Calendar.Lbl.EditTitle"]</span>
            </div>

            <div style="display:flex;gap:8px;align-items:flex-end;">
                <div style="flex:0 0 220px;">
                    <label>@L["SYS.Calendar.Lbl.DayType"]</label>
                    <RadzenDropDown @bind-Value="_editDayType" Data="@DayTypeOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div style="flex:0 0 200px;">
                    <label>@L["Col.Plant"]</label>
                    <RadzenDropDown @bind-Value="_selPlant" Data="@PlantOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                @if (_editDayType == "HOLIDAY")
                {
                    <div style="flex:1;">
                        <label>@L["SYS.Calendar.Lbl.HolidayName"]</label>
                        <RadzenTextBox @bind-Value="_editHolidayName" Placeholder="@L["SYS.Calendar.Ph.HolidayNameInput"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" AutoComplete="false" />
                    </div>
                }
            </div>

            <div style="margin-top:12px;font-size:.84em;font-weight:600;color:#94a3b8;letter-spacing:.05em;">
                @L["SYS.Calendar.Lbl.ShiftConfig"]
                <span class="dim" style="font-weight:400;margin-left:8px;">@L["SYS.Calendar.Lbl.ShiftNote"]</span>
            </div>
            <table class="ames-table" style="margin-top:4px;">
                <thead>
                    <tr>
                        <th style="width:44px;">@L["Col.Active"]</th>
                        <th style="width:56px;">@L["Col.Code"]</th>
                        <th style="width:130px;">@L["Col.Start"]</th>
                        <th style="width:130px;">@L["Col.End"]</th>
                        <th style="width:90px;">@L["Col.BreakMin"]</th>
                        <th style="width:80px;">@L["Col.NetWorkH"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int ei = 0; ei < _editShifts.Length; ei++)
                    {
                        var i = ei;
                        var timeDis = !_editShifts[i].Active;
                        <tr style="@(timeDis ? "opacity:.35;" : "")">
                            <td><input type="checkbox" @bind="_editShifts[i].Active" style="accent-color:#60a5fa;" /></td>
                            <td><span class="ames-cal-sh @ShiftBadgeCls(_editShifts[i].Code, _editShifts[i].Active)">@_editShifts[i].Code</span></td>
                            <td>
                                <input type="time" class="ames-input" value="@_editShifts[i].Start" @onchange="e => _editShifts[i].Start = e.Value?.ToString() ?? _editShifts[i].Start" disabled="@timeDis" />
                            </td>
                            <td>
                                <input type="time" class="ames-input" value="@_editShifts[i].End" @onchange="e => _editShifts[i].End = e.Value?.ToString() ?? _editShifts[i].End" disabled="@timeDis" />
                            </td>
                            <td>
                                <input type="number" class="ames-input" min="0" max="120" value="@_editShifts[i].BreakMin" @onchange="e => { if (int.TryParse(e.Value?.ToString(), out int b)) _editShifts[i].BreakMin = b; }" disabled="@timeDis" />
                            </td>
                            <td class="num dim">
                                @(timeDis ? "—" : CalcNet(_editShifts[i].Start, _editShifts[i].End, _editShifts[i].BreakMin).ToString("0.0"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["SYS.Calendar.Confirm.Delete"].Value, _selDate.Value.ToString("yyyy-MM-dd"))</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    // ── State ────────────────────────────────────────────────────────────
    List<MasterDataRepository.CodeItemRow> _dayTypes = new();
    List<MasterDataRepository.CodeItemRow> _plants   = new();
    List<SysRepository.CalendarRow> _rows = new();
    Dictionary<DateTime, List<SysRepository.CalendarRow>> _byDay = new();
    int _days, _work, _wknd, _hol;

    string   _view       = "list";
    DateTime _filterFrom = DateTime.Today.AddDays(-14);
    DateTime _filterTo   = DateTime.Today.AddDays(60);
    int      _calYear    = DateTime.Today.Year;
    int      _calMonth   = DateTime.Today.Month;

    string _modal = "";
    bool   _busy, _confirmDelete, _bgMouseDownOnSelf, _isErr;
    string _msg = "", _modalErr = "";
    bool   _canEdit;
    string _actor = "system";

    // ── Edit form ────────────────────────────────────────────────────────
    DateTime?  _selDate;
    string     _selPlant        = "";
    string     _editDayType     = "WORKDAY";
    string     _editHolidayName = "";
    ShiftRow[] _editShifts      = Array.Empty<ShiftRow>();

    // ── Generate form ────────────────────────────────────────────────────
    DateTime      _genFrom         = DateTime.Today;
    DateTime      _genTo           = DateTime.Today.AddMonths(1).AddDays(-1);
    string        _genPlant        = "";
    bool          _genSkipExisting = true;
    ShiftGenRow[] _genShifts       = new[]
    {
        new ShiftGenRow("A", true,  "08:00", "16:00", 60),
        new ShiftGenRow("B", true,  "16:00", "00:00", 60),
        new ShiftGenRow("C", false, "00:00", "08:00", 60),
    };
    List<HolidayEntry> _genHolidays = new();

    // ── Init ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("sys/calendar");
        try { _dayTypes = MD.ListCodeItems("CALENDAR_DAY_TYPE"); } catch { }
        try { _plants = MD.ListCodeItems("PLANT"); } catch { }
        if (_dayTypes.Count == 0)
            _dayTypes = new()
            {
                new("CAL_DAY_WORKDAY", "CALENDAR_DAY_TYPE", "WORKDAY", "근무일", "Workday", null, 1, null, true, null, null, null, null, null),
                new("CAL_DAY_WEEKEND", "CALENDAR_DAY_TYPE", "WEEKEND", "주말",   "Weekend", null, 2, null, true, null, null, null, null, null),
                new("CAL_DAY_HOLIDAY", "CALENDAR_DAY_TYPE", "HOLIDAY", "공휴일", "Holiday", null, 3, null, true, null, null, null, null, null),
            };
        Reload();
    }

    void Reload()
    {
        try { _rows = Sys.ListCalendarRange(_filterFrom, _filterTo); } catch { _rows = new(); }
        _byDay = _rows
            .Where(r => r.CalendarDate.HasValue)
            .GroupBy(r => r.CalendarDate!.Value.Date)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.ToList());
        _days = _byDay.Count;
        _work = _byDay.Count(g => g.Value.Any(x => x.DayType == "WORKDAY"));
        _wknd = _byDay.Count(g => g.Value.All(x => x.DayType == "WEEKEND"));
        _hol  = _byDay.Count(g => g.Value.Any(x => x.DayType == "HOLIDAY"));
    }

    void Load() => Reload();

    // ── View switching ────────────────────────────────────────────────────
    void SwitchView(string view)
    {
        _view = view;
        if (view == "calendar") LoadCalendarMonth();
    }

    void PrevMonth()
    {
        var d = new DateTime(_calYear, _calMonth, 1).AddMonths(-1);
        _calYear = d.Year; _calMonth = d.Month;
        LoadCalendarMonth();
    }

    void NextMonth()
    {
        var d = new DateTime(_calYear, _calMonth, 1).AddMonths(1);
        _calYear = d.Year; _calMonth = d.Month;
        LoadCalendarMonth();
    }

    void GoToday()
    {
        _calYear = DateTime.Today.Year; _calMonth = DateTime.Today.Month;
        LoadCalendarMonth();
    }

    void LoadCalendarMonth()
    {
        _filterFrom = new DateTime(_calYear, _calMonth, 1);
        _filterTo   = _filterFrom.AddMonths(1).AddDays(-1);
        Reload();
    }

    // ── Modal ─────────────────────────────────────────────────────────────
    void OpenCreate()
    {
        _modalErr = ""; _confirmDelete = false;
        _genHolidays.Clear();
        if (string.IsNullOrEmpty(_genPlant))
            _genPlant = _plants.FirstOrDefault()?.CodeValue ?? "";
        _modal = "create";
    }

    void OpenEdit(DateTime date, List<SysRepository.CalendarRow>? shifts)
    {
        if (!_canEdit) return;
        shifts ??= new();
        _selDate         = date;
        _selPlant        = shifts.FirstOrDefault()?.PlantCode
                           ?? _plants.FirstOrDefault()?.CodeValue ?? "";
        _editDayType     = shifts.FirstOrDefault()?.DayType
                           ?? (date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "WEEKEND" : "WORKDAY");
        _editHolidayName = shifts.FirstOrDefault()?.HolidayName ?? "";
        _editShifts = new[]
        {
            MakeShiftRow("A", "08:00", "16:00", shifts),
            MakeShiftRow("B", "16:00", "00:00", shifts),
            MakeShiftRow("C", "00:00", "08:00", shifts),
        };
        _confirmDelete = false; _modalErr = "";
        _modal = "edit";
    }

    void CloseModal()
    {
        _modal = ""; _selDate = null; _modalErr = ""; _confirmDelete = false;
    }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick()
    {
        if (_bgMouseDownOnSelf) CloseModal();
        _bgMouseDownOnSelf = false;
    }

    void AddHoliday() => _genHolidays.Add(new HolidayEntry());

    // ── Generate ──────────────────────────────────────────────────────────
    void Generate()
    {
        _modalErr = "";
        if (_genFrom > _genTo) { _modalErr = L["SYS.Calendar.Err.DateRange"].Value; return; }
        var active = _genShifts.Where(s => s.Active).ToList();

        var holidays = _genHolidays
            .Where(h => DateTime.TryParse(h.Date, out _) && !string.IsNullOrEmpty(h.Name))
            .ToDictionary(h => DateTime.Parse(h.Date).Date, h => h.Name.Trim());

        int inserted = 0;
        _busy = true;
        try
        {
            for (var d = _genFrom.Date; d <= _genTo.Date; d = d.AddDays(1))
            {
                if (_genSkipExisting && Sys.CalendarDateExists(d)) continue;

                string dayType; string? holidayName = null;
                if (d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
                    dayType = "WEEKEND";
                else if (holidays.TryGetValue(d, out var hname))
                { dayType = "HOLIDAY"; holidayName = hname; }
                else
                    dayType = "WORKDAY";

                if (dayType is "HOLIDAY" or "WEEKEND")
                {
                    Sys.InsertCalendarShift(d, dayType, holidayName,
                        null, null, null, null, null, null, d.Year, _genPlant, _actor);
                    inserted++;
                }
                else if (active.Count > 0)
                {
                    foreach (var shift in active)
                    {
                        TimeSpan? start = TimeSpan.TryParse(shift.Start, out var ts) ? ts : null;
                        TimeSpan? end   = TimeSpan.TryParse(shift.End,   out var te) ? te : null;
                        decimal   net   = CalcNet(shift.Start, shift.End, shift.BreakMin);
                        Sys.InsertCalendarShift(d, dayType, holidayName, active.Count,
                            shift.Code, start, end, shift.BreakMin, net, d.Year, _genPlant, _actor);
                        inserted++;
                    }
                }
                else
                {
                    Sys.InsertCalendarShift(d, dayType, holidayName,
                        null, null, null, null, null, null, d.Year, _genPlant, _actor);
                    inserted++;
                }
            }
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Calendar.Ok.Generated"].Value, inserted), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    // ── Save Edit ─────────────────────────────────────────────────────────
    void SaveEdit()
    {
        if (!_selDate.HasValue) return;
        _modalErr = ""; _busy = true;
        try
        {
            string? actualHoliday = _editDayType == "HOLIDAY"
                ? (string.IsNullOrWhiteSpace(_editHolidayName) ? null : _editHolidayName.Trim())
                : null;

            Sys.DeleteCalendarDate(_selDate.Value);

            var active = _editShifts.Where(s => s.Active).ToList();
            if (active.Count > 0)
            {
                foreach (var shift in active)
                {
                    TimeSpan? start = TimeSpan.TryParse(shift.Start, out var ts) ? ts : null;
                    TimeSpan? end   = TimeSpan.TryParse(shift.End,   out var te) ? te : null;
                    decimal   net   = CalcNet(shift.Start, shift.End, shift.BreakMin);
                    Sys.InsertCalendarShift(_selDate.Value, _editDayType, actualHoliday,
                        active.Count, shift.Code, start, end, shift.BreakMin, net,
                        _selDate.Value.Year, _selPlant, _actor);
                }
            }
            else
            {
                Sys.InsertCalendarShift(_selDate.Value, _editDayType, actualHoliday,
                    null, null, null, null, null, null,
                    _selDate.Value.Year, _selPlant, _actor);
            }
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Calendar.Ok.Edited"].Value, _selDate.Value.ToString("yyyy-MM-dd")), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    // ── Save Delete ───────────────────────────────────────────────────────
    void SaveDelete()
    {
        if (!_selDate.HasValue) return;
        _busy = true;
        try
        {
            Sys.DeleteCalendarDate(_selDate.Value);
            var d = _selDate.Value;
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Calendar.Ok.Deleted"].Value, d.ToString("yyyy-MM-dd")), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    // ── Helpers ───────────────────────────────────────────────────────────
    static string ShiftBadgeCls(string code, bool active) =>
        active ? code switch { "A" => "sh-a", "B" => "sh-b", "C" => "sh-c", _ => "" } : "sh-off";

    static decimal CalcNet(string start, string end, int breakMin)
    {
        if (!TimeSpan.TryParse(start, out var s) || !TimeSpan.TryParse(end, out var e)) return 0m;
        var diff = e - s;
        if (diff < TimeSpan.Zero) diff += TimeSpan.FromHours(24);
        return Math.Round((decimal)(diff.TotalHours - breakMin / 60.0), 1);
    }

    static ShiftRow MakeShiftRow(string code, string defStart, string defEnd,
        List<SysRepository.CalendarRow> existing)
    {
        var found = existing.FirstOrDefault(r => r.ShiftCode == code);
        return found is not null
            ? new ShiftRow
            {
                Code = code, Active = true, ExistingId = found.FactoryCalendarId,
                Start = found.StartTime?.ToString(@"hh\:mm") ?? defStart,
                End   = found.EndTime?.ToString(@"hh\:mm")   ?? defEnd,
                BreakMin = found.BreakMinutes ?? 30
            }
            : new ShiftRow { Code = code, Active = false, Start = defStart, End = defEnd, BreakMin = 60 };
    }

    string DayTypeName(string? code)
    {
        if (code is null) return "—";
        var item = _dayTypes.FirstOrDefault(d => d.CodeValue == code);
        return item is null ? code : MasterDataRepository.LocalName(item);
    }

    Microsoft.AspNetCore.Components.RenderFragment DayTypePill(string? dt) => builder =>
    {
        var cls = dt switch { "WORKDAY" => "ok", "WEEKEND" => "warn", "HOLIDAY" => "bad", _ => "info" };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"pill {cls}");
        builder.AddContent(2, dt is null ? "—" : DayTypeName(dt));
        builder.CloseElement();
    };

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> PlantOptions =>
        _plants.Select(p => new DropDownItem { Value = p.CodeValue ?? "", Text = $"[{p.CodeValue}] {MasterDataRepository.LocalName(p)}" });

    private IEnumerable<DropDownItem> DayTypeOptions =>
        _dayTypes.Select(d => new DropDownItem { Value = d.CodeValue ?? "", Text = $"[{d.CodeValue}] {MasterDataRepository.LocalName(d)}" });

    private record CalendarDaySummary(
        DateTime Date, string? DayType, string? HolidayName,
        bool HasA, bool HasB, bool HasC, string? PlantCode,
        List<SysRepository.CalendarRow> Shifts);

    private IEnumerable<CalendarDaySummary> DaySummaries =>
        _byDay.Select(g => new CalendarDaySummary(
            g.Key,
            g.Value.FirstOrDefault()?.DayType,
            g.Value.FirstOrDefault()?.HolidayName,
            g.Value.Any(r => r.ShiftCode == "A"),
            g.Value.Any(r => r.ShiftCode == "B"),
            g.Value.Any(r => r.ShiftCode == "C"),
            g.Value.FirstOrDefault()?.PlantCode,
            g.Value));

    void CalDayRowRender(RowRenderEventArgs<CalendarDaySummary> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    // ── Inner types ───────────────────────────────────────────────────────
    class ShiftRow
    {
        public string Code       { get; set; } = "";
        public bool   Active     { get; set; }
        public int?   ExistingId { get; set; }
        public string Start      { get; set; } = "08:00";
        public string End        { get; set; } = "16:00";
        public int    BreakMin   { get; set; } = 30;
    }

    class ShiftGenRow
    {
        public string Code     { get; set; }
        public bool   Active   { get; set; }
        public string Start    { get; set; }
        public string End      { get; set; }
        public int    BreakMin { get; set; }
        public ShiftGenRow(string c, bool a, string s, string e, int b)
        { Code = c; Active = a; Start = s; End = e; BreakMin = b; }
    }

    class HolidayEntry
    {
        public string Date { get; set; } = "";
        public string Name { get; set; } = "";
    }
}