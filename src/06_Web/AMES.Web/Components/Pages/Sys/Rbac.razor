@page "/sys/rbac"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-004 @L["SYS.Rbac.Title"] · AMES</PageTitle>

<AmesPageHeader Code="SYS-004" TitleKey="SYS.Rbac.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Rbac.Kpi.Roles"]</div>
        <div class="ames-kpi-v">@_roles.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Rbac.Kpi.Perms"]</div>
        <div class="ames-kpi-v">@_rows.Count</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["SYS.Rbac.Kpi.Screens"]</div>
        <div class="ames-kpi-v">@_rows.Select(r => r.ScreenCode).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Rbac.Kpi.Users"]</div>
        <div class="ames-kpi-v">@_roles.Sum(r => r.UserCount)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;">
        <span>▼ @L["SYS.Rbac.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <div style="display:flex;gap:6px;">
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Search"]</button>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["SYS.Rbac.Empty"]</div>
    }
    else
    {
        @foreach (var grp in _rows.GroupBy(r => r.RoleName).OrderBy(g => g.Key))
        {
            <div style="margin-top:12px;">
                <div class="ames-card-h" style="font-size:.8em;padding:6px 12px;">
                    <span class="pill info">@grp.Key</span>
                    <span class="dim" style="margin-left:6px;">@grp.Count() @L["Lbl.Items"]</span>
                </div>
                <table class="ames-table">
                    <thead>
                        <tr>
                            <th>@L["SYS.Rbac.Col.Module"]</th><th>@L["SYS.Rbac.Col.Screen"]</th><th>@L["SYS.Rbac.Col.Level"]</th><th>@L["SYS.Rbac.Col.System"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in grp.OrderBy(x => x.ModuleCode).ThenBy(x => x.ScreenCode))
                        {
                            <tr class="ames-row-link" @onclick="() => OpenEdit(p)">
                                <td><span class="pill info">@(p.ModuleCode ?? "—")</span></td>
                                <td class="code">@(p.ScreenCode ?? "—")</td>
                                @{
                                    var pl2 = _permLevels.FirstOrDefault(pl => pl.CodeValue == p.PermissionLevel);
                                    var lvlLbl = pl2 is null ? (p.PermissionLevel ?? "—") : MasterDataRepository.LocalName(pl2);
                                }
                                <td><span class="pill @LvlClass(p.PermissionLevel)">@lvlLbl</span></td>
                                <td class="dim">@(p.IsSystemRole ? "yes" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Rbac.Modal.Create"]</div>

            <label>@L["SYS.Rbac.Lbl.Role"]</label>
            <select class="ames-input"
                    value="@_f.RoleName"
                    @onchange="e => _f.RoleName = e.Value?.ToString() ?? string.Empty">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var r in _roles) { <option value="@r.RoleName">@r.RoleName</option> }
            </select>

            <label>@L["SYS.Rbac.Lbl.Module"]</label>
            <select class="ames-input"
                    value="@_f.ModuleCode"
                    @onchange="e => _f.ModuleCode = e.Value?.ToString() ?? string.Empty">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var m in _modules) { <option value="@m.CodeValue">[@m.CodeValue] @(MasterDataRepository.LocalName(m))</option> }
            </select>

            <label>@L["SYS.Rbac.Lbl.Screen"]</label>
            <input class="ames-input" @bind="_f.ScreenCode" placeholder="@L["SYS.Rbac.Ph.ScreenCode"]" autocomplete="off" />

            <label>@L["SYS.Rbac.Lbl.Level"]</label>
            <select class="ames-input"
                    value="@_f.PermissionLevel"
                    @onchange="e => _f.PermissionLevel = e.Value?.ToString() ?? string.Empty">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var pl in _permLevels.Where(pl => pl.UseFlag))
                { <option value="@pl.CodeValue">[@pl.CodeValue] @(MasterDataRepository.LocalName(pl))</option> }
            </select>

            <label class="ames-line-item" style="flex-direction:row;gap:8px;margin-top:4px;">
                <input type="checkbox" @bind="_f.IsSystemRole" style="accent-color:#60a5fa;width:14px;height:14px;" />
                <span>@L["SYS.Rbac.Lbl.IsSystem"]</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">
                    @(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])
                </button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["Btn.Edit"] — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.RoleName · @_sel.ScreenCode</span></div>

            <label>@L["SYS.Rbac.Lbl.Role"]</label>
            <select class="ames-input"
                    value="@_f.RoleName"
                    @onchange="e => _f.RoleName = e.Value?.ToString() ?? string.Empty">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var r in _roles) { <option value="@r.RoleName">@r.RoleName</option> }
            </select>

            <label>@L["SYS.Rbac.Lbl.Module"]</label>
            <select class="ames-input"
                    value="@_f.ModuleCode"
                    @onchange="e => _f.ModuleCode = e.Value?.ToString() ?? string.Empty">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var m in _modules) { <option value="@m.CodeValue">[@m.CodeValue] @(MasterDataRepository.LocalName(m))</option> }
            </select>

            <label>@L["SYS.Rbac.Lbl.Screen"]</label>
            <input class="ames-input" @bind="_f.ScreenCode" autocomplete="off" />

            <label>@L["SYS.Rbac.Lbl.Level"]</label>
            <select class="ames-input"
                    value="@_f.PermissionLevel"
                    @onchange="e => _f.PermissionLevel = e.Value?.ToString() ?? string.Empty">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var pl in _permLevels.Where(pl => pl.UseFlag))
                { <option value="@pl.CodeValue">[@pl.CodeValue] @(MasterDataRepository.LocalName(pl))</option> }
            </select>

            <label class="ames-line-item" style="flex-direction:row;gap:8px;margin-top:4px;">
                <input type="checkbox" @bind="_f.IsSystemRole" style="accent-color:#60a5fa;width:14px;height:14px;" />
                <span>@L["SYS.Rbac.Lbl.IsSystem"]</span>
            </label>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">
                        @(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveEdit" disabled="@_busy">
                    @(_busy ? @L["Msg.Saving"] : @L["Btn.Save"])
                </button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.SysRepository.RolePermRow>       _rows      = new();
    List<AMES.Data.Repositories.SysRepository.RoleRow>           _roles     = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _modules   = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _permLevels = new();
    AMES.Data.Repositories.SysRepository.RolePermRow?            _sel;

    string _modal = "";   // "" | "create" | "edit"
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    string _actorEmail = "system";

    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actorEmail = auth.User.Identity?.Name ?? "system";
        try { _modules    = Md.ListCodeItems("MODULE"); } catch { }
        try { _permLevels = Md.ListCodeItems("PERMISSION_LEVEL"); } catch { }
        Reload();
    }

    void Reload()
    {
        try { _rows  = Sys.ListRolePermissions(); } catch { }
        try { _roles = Sys.ListRoles(); } catch { }
    }

    void OpenCreate()
    {
        _f = new(); _modalErr = ""; _confirmDelete = false;
        _modal = "create";
    }

    void OpenEdit(AMES.Data.Repositories.SysRepository.RolePermRow p)
    {
        _sel = p; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            RoleName        = p.RoleName        ?? "",
            ModuleCode      = p.ModuleCode      ?? "",
            ScreenCode      = p.ScreenCode      ?? "",
            PermissionLevel = p.PermissionLevel ?? "",
            IsSystemRole    = p.IsSystemRole
        };
        _modal = "edit";
    }

    void CloseModal()
    {
        _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false;
    }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick()
    {
        if (_bgMouseDownOnSelf) CloseModal();
        _bgMouseDownOnSelf = false;
    }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.RoleName))        { _modalErr = L["SYS.Rbac.Err.RoleRequired"].Value; return; }
        if (string.IsNullOrWhiteSpace(_f.ModuleCode))      { _modalErr = L["SYS.Rbac.Err.ModuleRequired"].Value; return; }
        if (string.IsNullOrWhiteSpace(_f.ScreenCode))      { _modalErr = L["SYS.Rbac.Err.ScreenCodeRequired"].Value; return; }
        if (string.IsNullOrWhiteSpace(_f.PermissionLevel)) { _modalErr = L["SYS.Rbac.Err.LevelRequired"].Value; return; }

        _busy = true;
        try
        {
            var roleId = _roles.FirstOrDefault(r => r.RoleName == _f.RoleName)?.RoleId;
            Sys.CreateRolePerm(roleId, _f.RoleName, _f.ModuleCode,
                _f.ScreenCode.Trim(), _f.PermissionLevel, _f.IsSystemRole, _actorEmail);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Rbac.Ok.Created"].Value, _f.RoleName, _f.ScreenCode), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.RoleName))        { _modalErr = L["SYS.Rbac.Err.RoleRequired"].Value; return; }
        if (string.IsNullOrWhiteSpace(_f.ModuleCode))      { _modalErr = L["SYS.Rbac.Err.ModuleRequired"].Value; return; }
        if (string.IsNullOrWhiteSpace(_f.ScreenCode))      { _modalErr = L["SYS.Rbac.Err.ScreenCodeRequired"].Value; return; }
        if (string.IsNullOrWhiteSpace(_f.PermissionLevel)) { _modalErr = L["SYS.Rbac.Err.LevelRequired"].Value; return; }

        _busy = true;
        try
        {
            var roleId = _roles.FirstOrDefault(r => r.RoleName == _f.RoleName)?.RoleId
                         ?? _sel.RoleId;
            Sys.UpdateRolePerm(_sel.RolePermissionId, roleId, _f.RoleName, _f.ModuleCode,
                _f.ScreenCode.Trim(), _f.PermissionLevel, _f.IsSystemRole, _actorEmail);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Rbac.Ok.Updated"].Value, _f.RoleName, _f.ScreenCode), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            Sys.DeleteRolePerm(_sel.RolePermissionId);
            var info = $"{_sel.RoleName} · {_sel.ScreenCode}";
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Rbac.Ok.Deleted"].Value, _sel.RoleName, _sel.ScreenCode), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string LvlClass(string? l) => l switch
    { "FULL" => "bad", "EDIT" => "warn", "VIEW" => "ok", _ => "info" };

    class FormModel
    {
        public string RoleName        { get; set; } = "";
        public string ModuleCode      { get; set; } = "";
        public string ScreenCode      { get; set; } = "";
        public string PermissionLevel { get; set; } = "";
        public bool   IsSystemRole    { get; set; }
    }
}
