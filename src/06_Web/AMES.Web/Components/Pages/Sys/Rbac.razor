@page "/sys/rbac"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>SYS-004 @L["SYS.Rbac.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Rbac.Kpi.Roles"]</div>
        <div class="ames-kpi-v">@_roles.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Rbac.Kpi.Modules"]</div>
        <div class="ames-kpi-v">@_screens.Select(s => s.ModuleCode).Distinct().Count()</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["SYS.Rbac.Kpi.Users"]</div>
        <div class="ames-kpi-v">@(_selRole?.UserCount ?? 0)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Rbac.Kpi.Granted"]</div>
        <div class="ames-kpi-v">@(_selRole is null ? "—" : $"{GrantedCount()} / {TotalCells()}")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div style="display:flex;gap:16px;align-items:flex-start;">

    @* ── 좌: 역할 목록 ─────────────────────────────────────────────── *@
    <div style="flex:0 0 300px;">
        <div class="ames-card">
            <div class="ames-card-h">@L["SYS.Rbac.Roles"]</div>
            @if (_roles.Count == 0)
            {
                <div class="ames-empty">@L["SYS.Rbac.Empty"]</div>
            }
            else
            {
                <table class="ames-table">
                    <tbody>
                        @foreach (var r in _roles)
                        {
                            var rCap = r;
                            <tr class="ames-row-link @(_selRole?.RoleId == r.RoleId ? "ames-row-selected" : "")"
                                @onclick="() => SelectRole(rCap)">
                                <td>
                                    <div style="font-weight:600;">@r.RoleName</div>
                                    <div class="dim" style="font-size:.82em;">@ModuleSummary(r)</div>
                                </td>
                                <td style="text-align:right;width:1%;white-space:nowrap;">
                                    <span class="pill info">@r.UserCount</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* ── 우: 권한 매트릭스 ─────────────────────────────────────────── *@
    <div style="flex:1;min-width:0;">
        <div class="ames-card">
            @if (_selRole is null)
            {
                <div class="dim" style="padding:24px 0;text-align:center;">@L["SYS.Rbac.Hint.SelectRole"]</div>
            }
            else
            {
                <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span style="font-weight:600;">
                        @L["SYS.Rbac.Matrix"] — <span class="pill info">@_selRole.RoleName</span>
                        <span class="dim" style="font-weight:400;margin-left:6px;">
                            @string.Format(L["SYS.Rbac.Matrix.UsersAssigned"].Value, _selRole.UserCount)
                        </span>
                    </span>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <RadzenLabel Text="@L["Col.Module"]" />
                        <RadzenDropDown @bind-Value="_fModule" Data="@ModuleOptions" TextProperty="Text" ValueProperty="Value"
                                        InputSize="InputSize.Small" class="ames-rz-input" Style="width:180px;" />
                        @if (_canEdit)
                        {
                            <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])"
                                          Icon="save"
                                          ButtonStyle="@(_dirty ? ButtonStyle.Primary : ButtonStyle.Base)"
                                          Size="ButtonSize.Small" Click="@SaveAll" Disabled="@(!_dirty || _busy)"
                                          class="ames-rz-btn" />
                        }
                    </RadzenStack>
                </div>

                @if (!ScreensFiltered.Any())
                {
                    <div class="ames-empty">@L["SYS.Screen.Empty"]</div>
                }
                else
                {
                    <RadzenDataGrid TItem="AMES.Data.Repositories.SysRepository.ScreenRow"
                                    Data="@ScreensFiltered.ToList()"
                                    AllowPaging="false"
                                    AllowSorting="false"
                                    AllowGrouping="false"
                                    Groups="@_groupDescriptors"
                                    Class="ames-rz-grid">
                        <GroupHeaderTemplate Context="group">
                            @{ var grpKey = group.Data.Key?.ToString(); }
                            @if (!string.IsNullOrEmpty(grpKey))
                            {
                                <span class="pill" style="background:rgba(56,189,248,.12);color:#7dd3fc;">@grpKey</span>
                            }
                        </GroupHeaderTemplate>
                        <Columns>
                            <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.ScreenRow"
                                                  Property="ScreenCode" Title="@L["SYS.Screen.Col.Code"]" Width="110px">
                                <Template Context="s">
                                    <span class="code" style="white-space:nowrap;">@s.ScreenCode</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.ScreenRow"
                                                  Title="@L["SYS.Rbac.Col.Screen"]">
                                <Template Context="s">
                                    @SL(s.ScreenName, s.ScreenNameEn)
                                </Template>
                            </RadzenDataGridColumn>
                            @foreach (var pl in _permLevels)
                            {
                                var plCap = pl;
                                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.ScreenRow"
                                                      TextAlign="TextAlign.Center" Width="80px" Sortable="false">
                                    <HeaderTemplate>
                                        <span style="cursor:pointer;user-select:none;"
                                              @onclick="() => ToggleColumn(plCap)"
                                              @onclick:stopPropagation="true">
                                            @MasterDataRepository.LocalName(plCap)
                                        </span>
                                    </HeaderTemplate>
                                    <Template Context="s">
                                        <RadzenCheckBox TValue="bool"
                                                        Value="@IsChecked(s.ScreenCode, plCap)"
                                                        Change="@(v => ToggleCell(s, plCap, v))"
                                                        Disabled="@(!_canEdit)" />
                                    </Template>
                                </RadzenDataGridColumn>
                            }
                        </Columns>
                    </RadzenDataGrid>
                }
            }
        </div>
    </div>
</div>

@code {
    List<AMES.Data.Repositories.SysRepository.RoleRow>            _roles      = new();
    List<AMES.Data.Repositories.SysRepository.RolePermRow>        _rows       = new();
    List<AMES.Data.Repositories.SysRepository.ScreenRow>          _screens    = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _permLevels = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _modules    = new();
    AMES.Data.Repositories.SysRepository.RoleRow? _selRole;

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ModuleOptions =>
        _modules.Select(m => new DropDownItem { Value = m.CodeValue ?? "", Text = $"[{m.CodeValue}] {ModuleName(m.CodeValue ?? "")}" });

    private IList<GroupDescriptor> _groupDescriptors = new List<GroupDescriptor>
    {
        new GroupDescriptor { Property = "ProcessCode", SortOrder = SortOrder.Ascending }
    };

    // ScreenCode → PermissionLevel 문자열 (현재 선택 역할, e.g. "RE")
    Dictionary<string, string> _grants = new();

    string _fModule = "";
    string _lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    bool _dirty;
    bool _busy;
    string _msg = "";
    bool _isErr;
    bool _canEdit;
    string _actorEmail = "system";

    IEnumerable<AMES.Data.Repositories.SysRepository.ScreenRow> ScreensFiltered =>
        (string.IsNullOrEmpty(_fModule) ? _screens : _screens.Where(s => s.ModuleCode == _fModule))
            .OrderBy(s => s.ProcessCode ?? "￿")
            .ThenBy(s => s.SortOrder ?? 9999);

    string SL(string? ko, string? en) => _lang == "en" ? (en ?? ko ?? "") : (ko ?? en ?? "");

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actorEmail = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("sys/rbac");
        try { _permLevels = Md.ListCodeItems("PERMISSION_LEVEL").Where(p => p.UseFlag).ToList(); } catch { }
        try { _modules    = Md.ListCodeItems("MODULE"); } catch { }
        Reload();
        if (_fModule == "" && _modules.Count > 0)
            _fModule = _modules[0].CodeValue ?? "";
    }

    void Reload()
    {
        try { _roles   = Sys.ListRoles(); } catch { }
        try { _rows    = Sys.ListRolePermissions(); } catch { }
        try { _screens = Sys.ListScreens(); } catch { }

        if (_selRole is not null)
        {
            var again = _roles.FirstOrDefault(r => r.RoleId == _selRole.RoleId);
            _selRole = again;
            if (again is not null) BuildGrants();
            else _grants.Clear();
        }
        _dirty = false;
    }

    void SelectRole(AMES.Data.Repositories.SysRepository.RoleRow r)
    {
        _selRole = r;
        _dirty   = false;
        BuildGrants();
    }

    void BuildGrants()
    {
        _grants = _rows
            .Where(x => x.RoleName == _selRole!.RoleName && x.ScreenCode is not null)
            .ToDictionary(x => x.ScreenCode!, x => NormalizeLevel(x.PermissionLevel));
    }

    /// 저장된 값에서 유효 문자(R/E/A)만 추출, REA 순 정렬
    static string NormalizeLevel(string? level)
    {
        if (string.IsNullOrWhiteSpace(level)) return "";
        return new string(level.ToUpperInvariant()
                               .Where(c => c == 'R' || c == 'E' || c == 'A')
                               .Distinct()
                               .OrderBy(c => "REA".IndexOf(c))
                               .ToArray());
    }

    static string ToggleLetter(string current, char letter, bool add)
    {
        var chars = current.ToUpperInvariant().ToHashSet();
        if (add) chars.Add(letter); else chars.Remove(letter);
        return new string(chars.OrderBy(c => "REA".IndexOf(c)).ToArray());
    }

    bool IsChecked(string screenCode, AMES.Data.Repositories.MasterDataRepository.CodeItemRow pl)
    {
        var letter = (pl.CodeValue ?? "").Trim().ToUpperInvariant();
        return letter.Length == 1
            && _grants.TryGetValue(screenCode, out var lvl)
            && lvl.Contains(letter[0]);
    }

    void ToggleCell(AMES.Data.Repositories.SysRepository.ScreenRow s,
        AMES.Data.Repositories.MasterDataRepository.CodeItemRow pl, bool isChecked)
    {
        if (!_canEdit || _selRole is null) return;
        var letter = (pl.CodeValue ?? "").Trim().ToUpperInvariant();
        if (letter.Length != 1) return;
        _grants.TryGetValue(s.ScreenCode, out var cur);
        _grants[s.ScreenCode] = ToggleLetter(cur ?? "", letter[0], isChecked);
        _dirty = true;
    }

    void ToggleColumn(AMES.Data.Repositories.MasterDataRepository.CodeItemRow pl)
    {
        if (!_canEdit || _selRole is null) return;
        var letter = (pl.CodeValue ?? "").Trim().ToUpperInvariant();
        if (letter.Length != 1) return;
        var ch       = letter[0];
        var filtered = ScreensFiltered.ToList();
        var allSet   = filtered.All(s => _grants.TryGetValue(s.ScreenCode, out var m) && m.Contains(ch));
        foreach (var s in filtered)
        {
            _grants.TryGetValue(s.ScreenCode, out var cur);
            _grants[s.ScreenCode] = ToggleLetter(cur ?? "", ch, !allSet);
        }
        _dirty = true;
    }

    void ToggleModule(string moduleCode)
    {
        if (!_canEdit || _selRole is null) return;
        var filtered  = ScreensFiltered.ToList();
        var fullLevel = new string(_permLevels
            .Select(pl => (pl.CodeValue ?? "").Trim().ToUpperInvariant())
            .Where(v => v.Length == 1)
            .Select(v => v[0])
            .Distinct()
            .OrderBy(c => "REA".IndexOf(c))
            .ToArray());
        var allSet = filtered.All(s => _grants.TryGetValue(s.ScreenCode, out var m) && m == fullLevel);
        foreach (var s in filtered)
            _grants[s.ScreenCode] = allSet ? "" : fullLevel;
        _dirty = true;
    }

    void SaveAll()
    {
        if (_selRole is null) return;
        _busy = true;
        try
        {
            foreach (var s in _screens)
            {
                _grants.TryGetValue(s.ScreenCode, out var level);
                Sys.SetRolePermission(
                    _selRole.RoleId, _selRole.RoleName,
                    s.ModuleCode, s.ProcessCode,
                    s.ScreenCode, level, _actorEmail);
            }
            _rows  = Sys.ListRolePermissions();
            _dirty = false;
            Perm.Reset(); // 권한 변경 후 캐시 무효화
            ShowMsg(L["Msg.Saved"].Value, false);
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    int GrantedCount()
    {
        if (_selRole is null) return 0;
        return _screens.Count(s => _grants.TryGetValue(s.ScreenCode, out var lvl) && lvl.Contains('R'));
    }

    int TotalCells() => _screens.Count * _permLevels.Count;

    string ModuleSummary(AMES.Data.Repositories.SysRepository.RoleRow r)
    {
        var mods = _rows
            .Where(x => x.RoleName == r.RoleName && x.ModuleCode is not null
                     && NormalizeLevel(x.PermissionLevel).Contains('R'))
            .Select(x => x.ModuleCode!)
            .Distinct()
            .OrderBy(m => m)
            .ToList();
        return mods.Count > 0 ? string.Join(", ", mods) : L["SYS.Rbac.NoPerm"].Value;
    }

    string ModuleName(string moduleCode)
    {
        var m = _modules.FirstOrDefault(x => x.CodeValue == moduleCode);
        return m is null ? moduleCode : AMES.Data.Repositories.MasterDataRepository.LocalName(m);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}