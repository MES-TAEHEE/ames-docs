@page "/sys/notifications"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-008 @L["SYS.Notifications.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">SYS-008</div>
    <div class="ames-page-t">@L["SYS.Notifications.Title"]</div>
    <div class="ames-page-sub">@L["SYS.Notifications.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["SYS.Notifications.Kpi.Rules"]</div>
        <div class="ames-kpi-v">@_rules.Count</div><div class="ames-kpi-s">전체 규칙</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["SYS.Notifications.Kpi.ActiveRules"]</div>
        <div class="ames-kpi-v">@_rules.Count(r => r.IsEnabled)</div><div class="ames-kpi-s">활성</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["SYS.Notifications.Kpi.Channels"]</div>
        <div class="ames-kpi-v">@_channels.Count</div><div class="ames-kpi-s">등록된 채널</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["SYS.Notifications.Kpi.Sent"]</div>
        <div class="ames-kpi-v">@_sent</div><div class="ames-kpi-s">발송 완료</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">@L["SYS.Notifications.Kpi.Failed"]</div>
        <div class="ames-kpi-v">@_failed</div><div class="ames-kpi-s">발송 오류</div></div>
</div>

@* ── 탭 헤더 (Calendar 스타일) ── *@
<div class="ames-cal-tabs">
    <button class="ames-cal-tab @(_tab=="rules"?"active":"")"    @onclick='() => _tab="rules"'>@L["SYS.Notifications.Tab.Rules"]</button>
    <button class="ames-cal-tab @(_tab=="channels"?"active":"")" @onclick='() => _tab="channels"'>@L["SYS.Notifications.Tab.Channels"]</button>
    <button class="ames-cal-tab @(_tab=="history"?"active":"")"  @onclick='() => _tab="history"'>@L["SYS.Notifications.Tab.History"]</button>
    <div style="flex:1;"></div>
    <button class="ames-btn ok" @onclick="Reload" style="align-self:center;">@L["Btn.Reload"]</button>
    @if (_tab == "rules")
    {
        <button class="ames-btn" @onclick="OpenRuleCreate" style="align-self:center;">+ @L["Btn.Create"]</button>
    }
    @if (_tab == "channels")
    {
        <button class="ames-btn" @onclick="OpenChCreate" style="align-self:center;">+ @L["Btn.Create"]</button>
    }
</div>

@* ── 탭 1: 알림 규칙 ── *@
@if (_tab == "rules")
{
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
            <span>▼ @L["SYS.Notifications.Rules.List"] · @_ruleRows.Count @L["Lbl.Items"]@(_ruleRows.Count < _rules.Count ? $" / {L["Lbl.TotalOf"]} {_rules.Count}" : "")</span>
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                <input class="ames-input" style="width:150px;padding:4px 8px;"
                       placeholder="@L["SYS.Notifications.Ph.RuleSearch"]" @bind="_fRuleSearch" autocomplete="off" />
                <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fRuleModule">
                    <option value="">@L["SYS.Notifications.Filter.AllModules"]</option>
                    <option value="PP">PP</option>
                    <option value="MNT">MNT</option>
                    <option value="QC">QC</option>
                    <option value="WH">WH</option>
                    <option value="FG">FG</option>
                    <option value="SYS">SYS</option>
                </select>
                <select class="ames-input" style="width:90px;padding:4px 8px;" @bind="_fRuleEnabled">
                    <option value="">@L["SYS.Notifications.Filter.AllEnabled"]</option>
                    <option value="Y">@L["SYS.Notifications.Filter.Active"]</option>
                    <option value="N">@L["SYS.Notifications.Filter.Inactive"]</option>
                </select>
                <button class="ames-btn ok" @onclick="ApplyRuleFilter">@L["SYS.Notifications.Btn.Apply"]</button>
            </div>
        </div>

        @if (_ruleRows.Count == 0)
        {
            <div class="ames-empty">@L["SYS.Notifications.Rules.Empty"]</div>
        }
        else
        {
            <table class="ames-table">
                <thead>
                    <tr>
                        <th>이벤트 코드</th><th>이벤트명</th><th>모듈</th><th>트리거 조건</th>
                        <th style="text-align:center;">상태</th><th>채널</th><th>수신 역할</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _ruleRows)
                    {
                        <tr class="ames-row-link" @onclick="() => OpenRuleEdit(r)">
                            <td class="code">@(r.EventTypeCode ?? "—")</td>
                            <td>@(r.EventName ?? "—")</td>
                            <td><span class="pill info">@(r.SourceModule ?? "—")</span></td>
                            <td class="dim" style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;">@(r.TriggerCondition ?? "—")</td>
                            <td style="text-align:center;">
                                @if (r.IsEnabled) { <span class="pill ok">ON</span> }
                                else { <span class="pill warn">OFF</span> }
                            </td>
                            <td class="dim code" style="font-size:11px;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(r.ChannelsJson ?? "—")</td>
                            <td class="dim code" style="font-size:11px;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(r.RecipientRolesJson ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@* ── 탭 2: 채널 설정 ── *@
@if (_tab == "channels")
{
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="white-space:nowrap;">▼ @L["SYS.Notifications.Channels.List"] · @_chRows.Count @L["Lbl.Items"]@(_chRows.Count < _channels.Count ? $" / {L["Lbl.TotalOf"]} {_channels.Count}" : "")</span>
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                <input class="ames-input" style="width:160px;padding:4px 8px;"
                       placeholder="@L["SYS.Notifications.Ph.ChSearch"]" @bind="_fChSearch" autocomplete="off" />
                <select class="ames-input" style="width:110px;padding:4px 8px;" @bind="_fChType">
                    <option value="">@L["SYS.Notifications.Filter.AllChannels"]</option>
                    <option value="EMAIL">EMAIL</option>
                    <option value="SMS">SMS</option>
                    <option value="KAKAO">KAKAO</option>
                    <option value="SLACK">SLACK</option>
                </select>
                <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fChEnabled">
                    <option value="">@L["SYS.Notifications.Filter.AllEnabled"]</option>
                    <option value="Y">@L["SYS.Notifications.Filter.Active"]</option>
                    <option value="N">@L["SYS.Notifications.Filter.Inactive"]</option>
                </select>
                <button class="ames-btn ok" @onclick="ApplyChFilter">@L["SYS.Notifications.Btn.Apply"]</button>
            </div>
        </div>

        @if (_chRows.Count == 0)
        {
            <div class="ames-empty">@L["SYS.Notifications.Channels.Empty"]</div>
        }
        else
        {
            <table class="ames-table">
                <thead>
                    <tr><th>사용자</th><th>채널</th><th>주소</th><th>수신여부</th><th>방해금지 시작</th><th>방해금지 종료</th><th>인증일시</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in _chRows)
                    {
                        <tr class="ames-row-link" @onclick="() => OpenChEdit(c)">
                            <td class="dim" style="font-size:12px;max-width:140px;overflow:hidden;text-overflow:ellipsis;">@(c.UserName ?? c.UserId ?? "—")</td>
                            <td><span class="pill info">@(c.Channel ?? "—")</span></td>
                            <td>@(c.Address ?? "—")</td>
                            <td>
                                @if (c.IsEnabled) { <span class="pill ok">ON</span> }
                                else { <span class="pill bad">OFF</span> }
                            </td>
                            <td class="dim">@(c.QuietHoursStart?.ToString(@"hh\:mm") ?? "—")</td>
                            <td class="dim">@(c.QuietHoursEnd?.ToString(@"hh\:mm") ?? "—")</td>
                            <td class="dim">@(c.VerifiedAt?.ToString("MM-dd HH:mm") ?? "미인증")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@* ── 탭 3: 발송 이력 ── *@
@if (_tab == "history")
{
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;">
            <span>▼ @L["SYS.Notifications.History.List"]</span>
        </div>
        @if (_hist.Count == 0)
        {
            <div class="ames-empty">@L["SYS.Notifications.History.Empty"]</div>
        }
        else
        {
            <table class="ames-table">
                <thead>
                    <tr>
                        <th>발송시각</th><th>이벤트</th><th>수신자</th><th>채널</th>
                        <th>제목</th><th>상태</th><th class="num">재시도</th><th>오류</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in _hist)
                    {
                        <tr>
                            <td class="dim">@(h.SentAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                            <td class="code">@(h.EventTypeCode ?? "—")</td>
                            <td class="dim" style="font-size:11px;max-width:140px;overflow:hidden;text-overflow:ellipsis;">@(h.RecipientUserId ?? "—")</td>
                            <td><span class="pill info">@(h.Channel ?? "—")</span></td>
                            <td>@(h.Subject ?? "—")</td>
                            <td>
                                @if (h.Status == "SENT")       { <span class="pill ok">SENT</span> }
                                else if (h.Status == "FAILED") { <span class="pill bad">FAILED</span> }
                                else { <span class="pill warn">@(h.Status ?? "—")</span> }
                            </td>
                            <td class="num">@(h.RetryCount?.ToString() ?? "—")</td>
                            <td class="dim">@(h.ErrorMsg ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@* ── 알림 규칙 등록 모달 ── *@
@if (_ruleModal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:540px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">알림 규칙 등록</div>

            <label>이벤트 코드 <span class="dim-label">(예: WO_CREATED, DEFECT_HIGH)</span></label>
            <input class="ames-input" @bind="_rf.EventTypeCode" placeholder="EVENT_CODE" autocomplete="off" />

            <label>이벤트명</label>
            <input class="ames-input" @bind="_rf.EventName" placeholder="이벤트 표시명" autocomplete="off" />

            <label>소스 모듈</label>
            <select class="ames-input" @bind="_rf.SourceModule">
                <option value="">— 선택 —</option>
                <option value="PP">PP (생산계획)</option>
                <option value="MNT">MNT (설비보전)</option>
                <option value="QC">QC (품질)</option>
                <option value="WH">WH (창고)</option>
                <option value="FG">FG (완성품)</option>
                <option value="SYS">SYS (시스템)</option>
            </select>

            <label>트리거 조건 <span class="dim-label">(선택)</span></label>
            <textarea class="ames-input" rows="2" @bind="_rf.TriggerCondition"
                      placeholder="예: DefectCount > 5" style="resize:vertical;"></textarea>

            <label>채널 JSON <span class="dim-label">(예: [&quot;EMAIL&quot;,&quot;KAKAO&quot;])</span></label>
            <input class="ames-input" @bind="_rf.ChannelsJson" placeholder='["EMAIL"]' autocomplete="off" />

            <label>수신 역할 JSON <span class="dim-label">(예: [&quot;PP_USER&quot;,&quot;Administrator&quot;])</span></label>
            <input class="ames-input" @bind="_rf.RecipientRolesJson" placeholder='["Administrator"]' autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:6px;">
                <input type="checkbox" @bind="_rf.IsEnabled" />
                <span>활성 (즉시 적용)</span>
            </label>

            @if (!string.IsNullOrEmpty(_ruleModalErr))
            { <div class="ames-alert bad">@_ruleModalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveRuleCreate" disabled="@_ruleBusy">@(_ruleBusy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn"    @onclick="CloseRuleModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── 알림 규칙 수정 모달 ── *@
@if (_ruleModal == "edit" && _ruleSel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:540px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">알림 규칙 수정 — <span class="dim" style="font-weight:400;font-size:.9em;">@(_ruleSel.EventTypeCode ?? "—")</span></div>

            <label>이벤트 코드</label>
            <input class="ames-input" @bind="_rf.EventTypeCode" autocomplete="off" />

            <label>이벤트명</label>
            <input class="ames-input" @bind="_rf.EventName" autocomplete="off" />

            <label>소스 모듈</label>
            <select class="ames-input" @bind="_rf.SourceModule">
                <option value="">— 선택 —</option>
                <option value="PP">PP (생산계획)</option>
                <option value="MNT">MNT (설비보전)</option>
                <option value="QC">QC (품질)</option>
                <option value="WH">WH (창고)</option>
                <option value="FG">FG (완성품)</option>
                <option value="SYS">SYS (시스템)</option>
            </select>

            <label>트리거 조건</label>
            <textarea class="ames-input" rows="2" @bind="_rf.TriggerCondition" style="resize:vertical;"></textarea>

            <label>채널 JSON</label>
            <input class="ames-input" @bind="_rf.ChannelsJson" autocomplete="off" />

            <label>수신 역할 JSON</label>
            <input class="ames-input" @bind="_rf.RecipientRolesJson" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:6px;">
                <input type="checkbox" @bind="_rf.IsEnabled" />
                <span>활성</span>
            </label>

            @if (_ruleConfirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn" @onclick='() => _ruleConfirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveRuleDelete" disabled="@_ruleBusy">@(_ruleBusy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_ruleModalErr))
            { <div class="ames-alert bad">@_ruleModalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok"  @onclick="SaveRuleEdit"   disabled="@_ruleBusy">@(_ruleBusy ? @L["Msg.Saving"] : @L["Btn.Save"])</button>
                <button class="ames-btn bad" @onclick='() => { _ruleConfirmDelete = true; _ruleModalErr = ""; }' disabled="@_ruleBusy">@L["Btn.Delete"]</button>
                <button class="ames-btn"     @onclick="CloseRuleModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── 채널 등록 모달 ── *@
@if (_chModal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">신규 채널 등록</div>

            <label>사용자</label>
            <select class="ames-input" value="@_cf.UserId" @onchange="OnCreateUserChanged">
                <option value="">— 사용자 선택 —</option>
                @foreach (var u in _userList)
                {
                    <option value="@u.Id">@(u.UserName ?? u.Id)@(!string.IsNullOrEmpty(u.Email) ? $"  ({u.Email})" : "")</option>
                }
            </select>

            <label>채널</label>
            <select class="ames-input" value="@_cf.Channel" @onchange="OnCreateChannelChanged">
                <option value="EMAIL">EMAIL</option>
                <option value="SMS">SMS</option>
                <option value="KAKAO">KAKAO</option>
                <option value="SLACK">SLACK</option>
            </select>

            <label>주소 <span class="dim-label">(EMAIL·SMS는 사용자 선택 시 자동 입력)</span></label>
            <input class="ames-input" @bind="_cf.Address" placeholder="이메일 / 전화번호 / 훅 URL" autocomplete="off" />

            <label>방해금지 시작 (HH:mm)</label>
            <input class="ames-input" type="time" @bind="_cf.QuietStart" />

            <label>방해금지 종료 (HH:mm)</label>
            <input class="ames-input" type="time" @bind="_cf.QuietEnd" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:4px;">
                <input type="checkbox" @bind="_cf.IsEnabled" />
                <span>활성</span>
            </label>

            @if (!string.IsNullOrEmpty(_chModalErr))
            { <div class="ames-alert bad">@_chModalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveChCreate" disabled="@_chBusy">@(_chBusy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn" @onclick="CloseChModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

