<style>
    .dim-label { font-weight: 400; color: #64748b; font-size: .85em; }
</style>

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    bool _bgMouseDownOnSelf, _canEdit;
    string _actor = "system";

    // ── 공통코드 ──────────────────────────────────────────────────────────
    List<MasterDataRepository.CodeItemRow> _modules            = new();
    List<MasterDataRepository.CodeItemRow> _processItems       = new();
    List<MasterDataRepository.CodeItemRow> _channelCodes       = new();
    List<MasterDataRepository.CodeItemRow> _notifStatusItems   = new();
    List<MasterDataRepository.CodeItemRow> _deliveryStatusItems = new();
    List<string> _rolesList = new();

    // ── 알림 규칙 ──────────────────────────────────────────────────────
    List<SysRepository.NotifRuleRow> _rules    = new();
    List<SysRepository.NotifRuleRow> _ruleRows = new();
    SysRepository.NotifRuleRow? _ruleSel;
    string _fRuleSearch = "", _fRuleProcess = "";
    string? _fRuleModule, _fRuleStatus;
    string _ruleModal = "", _ruleModalErr = "";
    bool _ruleBusy, _ruleConfirmDelete;
    RuleForm _rf = new();

    // ── 발송 이력 ──────────────────────────────────────────────────────
    List<SysRepository.NotifHistoryRow> _hist     = new();
    List<SysRepository.NotifHistoryRow> _histRows = new();
    string _fHistSearch = "";
    string? _fHistChannel, _fHistStatus;
    int _sent, _failed;

    // ── 채널 설정 ──────────────────────────────────────────────────────
    List<SysRepository.UserSelectRow>   _userList = new();
    List<SysRepository.NotifChannelRow> _channels = new();
    List<SysRepository.NotifChannelRow> _chRows   = new();
    string _fChSearch = "";
    SysRepository.NotifChannelRow? _chSel;
    string _chModal = "", _chModalErr = "";
    bool _chBusy, _chConfirmDelete;
    ChForm _cf = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("sys/notifications");

        try { _modules             = MD.ListCodeItems("MODULE"); }               catch { }
        try { _processItems        = MD.ListCodeItems("PROCESS"); }              catch { }
        try { _channelCodes        = MD.ListCodeItems("NOTIFICATION_CHANNEL"); } catch { }
        try { _notifStatusItems    = MD.ListCodeItems("NOTIFICATION_STATUS"); }  catch { }
        try { _deliveryStatusItems = MD.ListCodeItems("DELIVERY_STATUS"); }      catch { }
        try { _rolesList           = RoleMgr.Roles.Select(r => r.Name!).OrderBy(n => n).ToList(); } catch { }
        try { _userList            = Sys.ListUsersForSelect(); }                 catch { }
        Reload();
    }

    RadzenDataGrid<SysRepository.NotifRuleRow>?    _ruleGrid;
    RadzenDataGrid<SysRepository.NotifChannelRow>? _chGrid;
    int _rulePage, _chPage;
    void OnRulePage(PagerEventArgs args) => _rulePage = args.PageIndex;
    void OnChPage(PagerEventArgs args)   => _chPage   = args.PageIndex;

    // Reload 후 규칙/채널 목록의 현재 페이지를 유지 (Reload가 두 목록을 함께 재로딩)
    async Task ReloadRestore()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_ruleGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_ruleRows.Count / (double)_ruleGrid.PageSize));
            await _ruleGrid.GoToPage(Math.Min(_rulePage, pages - 1));
        }
        if (_chGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_chRows.Count / (double)_chGrid.PageSize));
            await _chGrid.GoToPage(Math.Min(_chPage, pages - 1));
        }
    }

    void Reload()
    {
        try { _rules    = Sys.ListNotificationRules(); }    catch { }
        try { _hist     = Sys.ListNotificationHistory(); }  catch { }
        try { _channels = Sys.ListNotificationChannels(); } catch { }

        var recent = _hist.Where(h => h.SentAt.HasValue && (DateTime.Now - h.SentAt.Value).TotalHours <= 24).ToList();
        _sent   = recent.Count(h => h.Status == "SENT");
        _failed = recent.Count(h => h.Status == "FAILED");

        ApplyRuleFilter();
        ApplyHistFilter();
        ApplyChFilter();
    }

    // ── 규칙 필터 ──────────────────────────────────────────────────────
    void ApplyRuleFilter()
    {
        _ruleRows = _rules.Where(r =>
            (string.IsNullOrEmpty(_fRuleSearch) ||
                (r.EventTypeCode ?? "").Contains(_fRuleSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.EventName     ?? "").Contains(_fRuleSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_fRuleModule)  || r.ModuleCode  == _fRuleModule) &&
            (string.IsNullOrEmpty(_fRuleProcess) || r.ProcessCode == _fRuleProcess) &&
            (string.IsNullOrEmpty(_fRuleStatus)  || StatusMatches(r.IsEnabled, _fRuleStatus))
        ).ToList();
    }

    void OnRuleSearchChanged(string value) => _fRuleSearch = value ?? "";
    void OnRuleSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyRuleFilter(); }

    // ── 채널 필터 ──────────────────────────────────────────────────────
    void ApplyChFilter()
    {
        _chRows = _channels.Where(c =>
            string.IsNullOrEmpty(_fChSearch) ||
            (c.UserName ?? "").Contains(_fChSearch, StringComparison.OrdinalIgnoreCase) ||
            (c.UserId   ?? "").Contains(_fChSearch, StringComparison.OrdinalIgnoreCase) ||
            (c.Address  ?? "").Contains(_fChSearch, StringComparison.OrdinalIgnoreCase) ||
            (c.Channel  ?? "").Contains(_fChSearch, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    void OnChSearchChanged(string value) => _fChSearch = value ?? "";
    void OnChSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyChFilter(); }

    // NOTIFICATION_STATUS CodeValue → IsEnabled 매핑 (ACTIVE=true, 그 외=false)
    static bool StatusMatches(bool isEnabled, string statusCode) =>
        statusCode is "ACTIVE" ? isEnabled : !isEnabled;

    void OpenRuleCreate()
    {
        _rf = new() { StatusCode = "ACTIVE" };
        _ruleModalErr = ""; _ruleConfirmDelete = false; _ruleModal = "create";
    }

    void OpenRuleEdit(SysRepository.NotifRuleRow r)
    {
        _ruleSel = r; _ruleModalErr = ""; _ruleConfirmDelete = false;
        _rf = new()
        {
            EventTypeCode    = r.EventTypeCode    ?? "",
            EventName        = r.EventName        ?? "",
            ModuleCode       = r.ModuleCode       ?? "",
            ProcessCode      = r.ProcessCode      ?? "",
            TriggerCondition = r.TriggerCondition ?? "",
            StatusCode       = r.IsEnabled ? "ACTIVE" : "INACTIVE",
            SelectedChannels = ParseJsonList(r.ChannelsJson),
            SelectedRoles    = ParseJsonList(r.RecipientRolesJson),
        };
        _ruleModal = "edit";
    }

    void CloseRuleModal() { _ruleModal = ""; _ruleSel = null; _ruleModalErr = ""; _ruleConfirmDelete = false; }

    void ToggleChannel(string code, bool check)
    {
        if (check) { if (!_rf.SelectedChannels.Contains(code)) _rf.SelectedChannels.Add(code); }
        else _rf.SelectedChannels.Remove(code);
    }

    void ToggleRole(string role, bool check)
    {
        if (check) { if (!_rf.SelectedRoles.Contains(role)) _rf.SelectedRoles.Add(role); }
        else _rf.SelectedRoles.Remove(role);
    }

    async Task SaveRuleCreate()
    {
        _ruleModalErr = "";
        if (string.IsNullOrWhiteSpace(_rf.EventTypeCode))
        { _ruleModalErr = L["SYS.Notifications.Err.EventCodeRequired"]; return; }
        _ruleBusy = true;
        try
        {
            Sys.InsertNotificationRule(
                NE(_rf.EventTypeCode), NE(_rf.EventName), NE(_rf.ModuleCode),
                NE(_rf.ProcessCode), NE(_rf.TriggerCondition), _rf.IsEnabled,
                NE(_rf.ChannelsJson), NE(_rf.RecipientRolesJson), _actor);
            CloseRuleModal(); await ReloadRestore();
        }
        catch (Exception ex) { _ruleModalErr = ex.Message; }
        finally { _ruleBusy = false; }
    }

    async Task SaveRuleEdit()
    {
        if (_ruleSel is null) return;
        _ruleModalErr = "";
        if (string.IsNullOrWhiteSpace(_rf.EventTypeCode))
        { _ruleModalErr = L["SYS.Notifications.Err.EventCodeRequired"]; return; }
        _ruleBusy = true;
        try
        {
            Sys.UpdateNotificationRule(
                _ruleSel.NotificationRuleId,
                NE(_rf.EventTypeCode), NE(_rf.EventName), NE(_rf.ModuleCode),
                NE(_rf.ProcessCode), NE(_rf.TriggerCondition), _rf.IsEnabled,
                NE(_rf.ChannelsJson), NE(_rf.RecipientRolesJson), _actor);
            CloseRuleModal(); await ReloadRestore();
        }
        catch (Exception ex) { _ruleModalErr = ex.Message; }
        finally { _ruleBusy = false; }
    }

    async Task SaveRuleDelete()
    {
        if (_ruleSel is null) return;
        _ruleBusy = true;
        try { Sys.DeleteNotificationRule(_ruleSel.NotificationRuleId); CloseRuleModal(); await ReloadRestore(); }
        catch (Exception ex) { _ruleModalErr = ex.Message; _ruleConfirmDelete = false; }
        finally { _ruleBusy = false; }
    }

    // ── 발송 이력 필터 ─────────────────────────────────────────────────
    void ApplyHistFilter()
    {
        _histRows = _hist.Where(h =>
            (string.IsNullOrEmpty(_fHistSearch) ||
                (h.EventTypeCode   ?? "").Contains(_fHistSearch, StringComparison.OrdinalIgnoreCase) ||
                (h.RecipientUserId ?? "").Contains(_fHistSearch, StringComparison.OrdinalIgnoreCase) ||
                (h.Subject         ?? "").Contains(_fHistSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_fHistChannel) || h.Channel == _fHistChannel) &&
            (string.IsNullOrEmpty(_fHistStatus)  || h.Status  == _fHistStatus)
        ).ToList();
    }

    void OnHistSearchChanged(string value) => _fHistSearch = value ?? "";
    void OnHistSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyHistFilter(); }

    // ── 채널 설정 ──────────────────────────────────────────────────────
    void OpenChCreate()
    {
        _cf = new() { IsEnabled = true, Channel = _channelCodes.FirstOrDefault(c => c.UseFlag)?.CodeValue ?? "EMAIL" };
        _chModalErr = ""; _chConfirmDelete = false; _chModal = "create";
    }

    void OpenChEdit(SysRepository.NotifChannelRow c)
    {
        _chSel = c; _chModalErr = ""; _chConfirmDelete = false;
        _cf = new()
        {
            UserId    = c.UserId    ?? "",
            Channel   = c.Channel   ?? "EMAIL",
            Address   = c.Address   ?? "",
            IsEnabled = c.IsEnabled,
            QuietStart = c.QuietHoursStart.HasValue ? TimeOnly.FromTimeSpan(c.QuietHoursStart.Value) : null,
            QuietEnd   = c.QuietHoursEnd.HasValue   ? TimeOnly.FromTimeSpan(c.QuietHoursEnd.Value)   : null,
        };
        _chModal = "edit";
    }

    void CloseChModal() { _chModal = ""; _chSel = null; _chModalErr = ""; _chConfirmDelete = false; }

    void AutoFillAddress()
    {
        if (string.IsNullOrEmpty(_cf.UserId)) return;
        var u = _userList.FirstOrDefault(x => x.Id == _cf.UserId);
        if (u is null) return;
        _cf.Address = _cf.Channel switch
        {
            "EMAIL" => u.Email       ?? _cf.Address,
            "SMS"   => u.PhoneNumber ?? _cf.Address,
            _       => _cf.Address,
        };
    }

    async Task SaveChCreate()
    {
        _chModalErr = "";
        if (string.IsNullOrWhiteSpace(_cf.Channel)) { _chModalErr = L["SYS.Notifications.Err.ChannelRequired"]; return; }
        _chBusy = true;
        try
        {
            Sys.InsertNotificationChannel(NE(_cf.UserId), _cf.Channel, NE(_cf.Address),
                _cf.IsEnabled,
                _cf.QuietStart.HasValue ? _cf.QuietStart.Value.ToTimeSpan() : null,
                _cf.QuietEnd.HasValue   ? _cf.QuietEnd.Value.ToTimeSpan()   : null,
                _actor);
            CloseChModal(); await ReloadRestore();
        }
        catch (Exception ex) { _chModalErr = ex.Message; }
        finally { _chBusy = false; }
    }

    async Task SaveChEdit()
    {
        if (_chSel is null) return;
        _chBusy = true;
        try
        {
            Sys.UpdateNotificationChannel(_chSel.NotificationChannelId,
                NE(_cf.UserId), _cf.Channel, NE(_cf.Address),
                _cf.IsEnabled,
                _cf.QuietStart.HasValue ? _cf.QuietStart.Value.ToTimeSpan() : null,
                _cf.QuietEnd.HasValue   ? _cf.QuietEnd.Value.ToTimeSpan()   : null,
                _actor);
            CloseChModal(); await ReloadRestore();
        }
        catch (Exception ex) { _chModalErr = ex.Message; }
        finally { _chBusy = false; }
    }

    async Task SaveChDelete()
    {
        if (_chSel is null) return;
        _chBusy = true;
        try { Sys.DeleteNotificationChannel(_chSel.NotificationChannelId); CloseChModal(); await ReloadRestore(); }
        catch (Exception ex) { _chModalErr = ex.Message; _chConfirmDelete = false; }
        finally { _chBusy = false; }
    }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick()
    {
        if (!_bgMouseDownOnSelf) { _bgMouseDownOnSelf = false; return; }
        _bgMouseDownOnSelf = false;
        CloseRuleModal();
        CloseChModal();
    }

