@page "/sys/notifications"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject SysRepository Sys
@inject MasterDataRepository MD
@inject RoleManager<IdentityRole> RoleMgr
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-008 @L["SYS.Notifications.Title"] · AMES</PageTitle>
<AmesPageHeader Code="SYS-008" TitleKey="SYS.Notifications.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Notifications.Kpi.Rules"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_rules.Count</div>
            <div class="ames-kpi-s">@L["SYS.Notifications.Kpi.AllRules"]</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Notifications.Kpi.ActiveRules"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_rules.Count(r => r.IsEnabled)</div>
            <div class="ames-kpi-s">@L["Lbl.Active"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Notifications.Kpi.Channels"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_channels.Count</div>
            <div class="ames-kpi-s">@L["SYS.Notifications.Kpi.RegisteredChannels"]</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Notifications.Kpi.Sent"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_sent</div>
            <div class="ames-kpi-s">@L["SYS.Notifications.Kpi.SentToday"]</div>
        </div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">@L["SYS.Notifications.Kpi.Failed"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_failed</div>
            <div class="ames-kpi-s">@L["SYS.Notifications.Kpi.FailedToday"]</div>
        </div>
    </div>
</div>

<AmesTabs>

@* ── Tab 1 : Notification rules ─────────────────────────────────────────── *@
<AmesTab Title="@L["SYS.Notifications.Tab.Rules"].Value">
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="white-space:nowrap;">▼ @L["SYS.Notifications.Rules.List"] · @_ruleRows.Count @L["Lbl.Items"]@(_ruleRows.Count < _rules.Count ? $" / {L["Lbl.TotalOf"]} {_rules.Count}" : "")</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="_fRuleSearch" Change="@OnRuleSearchChanged" @onkeydown="OnRuleSearchKeyDown" Immediate="true" Placeholder="@L["SYS.Notifications.Ph.RuleSearch"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
                <RadzenLabel Text="@L["Col.Module"]" Component="DropDownRuleModule" />
                <RadzenDropDown AllowFiltering="true" Name="DropDownRuleModule" @bind-Value="_fRuleModule" Data="@ModuleOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
                <RadzenLabel Text="@L["Col.ProcessCode"]" Component="DropDownRuleProcess" />
                <RadzenDropDown AllowFiltering="true" Name="DropDownRuleProcess" @bind-Value="_fRuleProcess" Data="@ProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
                <RadzenLabel Text="@L["Col.Status"]" Component="DropDownRuleStatus" />
                <RadzenDropDown Name="DropDownRuleStatus" @bind-Value="_fRuleStatus" Data="@NotifStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />

                <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyRuleFilter" class="ames-rz-btn" />
                @if (_canEdit)
                {
                    <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenRuleCreate" class="ames-rz-btn" />
                }
            </RadzenStack>
        </div>

        <RadzenDataGrid @ref="_ruleGrid" Page="OnRulePage" TItem="SysRepository.NotifRuleRow" Data="@_ruleRows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                        PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRuleRowClick" RowRender="@RuleRowRender" EmptyText="@L["SYS.Notifications.Rules.Empty"]" Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="SysRepository.NotifRuleRow" Property="EventTypeCode" Title="@L["Col.EventCode"]" Width="130px">
                    <Template Context="r"><span class="code">@(r.EventTypeCode ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifRuleRow" Property="EventName" Title="@L["Col.EventName"]">
                    <Template Context="r">@(r.EventName ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifRuleRow" Property="ModuleCode" Title="@L["Col.Module"]" Width="90px">
                    <Template Context="r"><span class="pill info">@(r.ModuleCode ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifRuleRow" Property="ProcessCode" Title="@L["Col.ProcessCode"]" Width="110px">
                    <Template Context="r">
                        @if (r.ProcessCode != null)
                        {
                            var procName = _processItems.FirstOrDefault(c2 => c2.CodeValue == r.ProcessCode) is { } pf ? MasterDataRepository.LocalName(pf) : null;
                            <span class="pill @Ui.ProcessClass(r.ProcessCode)">@r.ProcessCode</span>
                            @if (procName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@procName</span> }
                        }
                        else { <span class="dim">—</span> }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifRuleRow" Property="TriggerCondition" Title="@L["Col.TriggerCond"]">
                    <Template Context="r"><span class="dim" style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;display:block;">@(r.TriggerCondition ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifRuleRow" Property="IsEnabled" Title="@L["Col.Status"]" Width="90px" TextAlign="TextAlign.Center">
                    <Template Context="r">
                        @if (r.IsEnabled) { <span class="pill ok">@NotifStatusName("ACTIVE")</span> }
                        else { <span class="pill warn">@NotifStatusName("INACTIVE")</span> }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifRuleRow" Title="@L["Col.Channel"]" Width="120px" Sortable="false">
                    <Template Context="r">@ChipList(ParseJsonList(r.ChannelsJson))</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifRuleRow" Title="@L["Col.RoleName"]" Width="120px" Sortable="false">
                    <Template Context="r">@ChipList(ParseJsonList(r.RecipientRolesJson))</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</AmesTab>

@* ── Tab 2 : Channel settings ──────────────────────────────────────────── *@
<AmesTab Title="@L["SYS.Notifications.Tab.Channels"].Value">
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="white-space:nowrap;">▼ @L["SYS.Notifications.Channels.List"] · @_chRows.Count @L["Lbl.Items"]@(_chRows.Count < _channels.Count ? $" / {L["Lbl.TotalOf"]} {_channels.Count}" : "")</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="_fChSearch" Change="@OnChSearchChanged" @onkeydown="OnChSearchKeyDown" Immediate="true" Placeholder="@L["SYS.Notifications.Ph.ChSearch"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />

                <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyChFilter" class="ames-rz-btn" />
                @if (_canEdit)
                {
                    <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenChCreate" class="ames-rz-btn" />
                }
            </RadzenStack>
        </div>
        <RadzenDataGrid @ref="_chGrid" Page="OnChPage" TItem="SysRepository.NotifChannelRow" Data="@_chRows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                        PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnChRowClick" RowRender="@ChRowRender" EmptyText="@L["SYS.Notifications.Channels.Empty"]" Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="SysRepository.NotifChannelRow" Property="UserName" Title="@L["Col.User"]" Width="160px">
                    <Template Context="c"><span class="dim" style="font-size:12px;max-width:150px;overflow:hidden;text-overflow:ellipsis;display:block;">@(c.UserName ?? c.UserId ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifChannelRow" Property="Channel" Title="@L["Col.Channel"]" Width="90px">
                    <Template Context="c"><span class="pill info">@(c.Channel ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifChannelRow" Property="Address" Title="@L["Col.Address"]">
                    <Template Context="c">@(c.Address ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifChannelRow" Property="IsEnabled" Title="@L["Col.Subscribe"]" Width="90px" TextAlign="TextAlign.Center">
                    <Template Context="c">
                        @if (c.IsEnabled) { <span class="pill ok">ON</span> } else { <span class="pill bad">OFF</span> }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifChannelRow" Property="QuietHoursStart" Title="@L["Col.DndStart"]" Width="90px">
                    <Template Context="c"><span class="dim">@(c.QuietHoursStart?.ToString(@"hh\:mm") ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifChannelRow" Property="QuietHoursEnd" Title="@L["Col.DndEnd"]" Width="90px">
                    <Template Context="c"><span class="dim">@(c.QuietHoursEnd?.ToString(@"hh\:mm") ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifChannelRow" Property="VerifiedAt" Title="@L["Col.AuthTs"]" Width="120px">
                    <Template Context="c"><span class="dim">@(c.VerifiedAt?.ToString(DateFmt.MonthDayTime) ?? L["SYS.Notifications.Lbl.Unverified"].Value)</span></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</AmesTab>

@* ── Tab 3 : Notification histories ───────────────────────────────────────── *@
<AmesTab Title="@L["SYS.Notifications.Tab.History"].Value">
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="white-space:nowrap;">▼ @L["SYS.Notifications.History.List"] · @_histRows.Count @L["Lbl.Items"]@(_histRows.Count < _hist.Count ? $" / {L["Lbl.TotalOf"]} {_hist.Count}" : "")</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="_fHistSearch" Change="@OnHistSearchChanged" @onkeydown="OnHistSearchKeyDown" Immediate="true" Placeholder="@L["SYS.Notifications.Ph.HistSearch"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
                <RadzenLabel Text="@L["Col.Channel"]" Component="DropDownHistChannel" />
                <RadzenDropDown AllowFiltering="true" Name="DropDownHistChannel" @bind-Value="_fHistChannel" Data="@ChannelCodeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
                <RadzenLabel Text="@L["Col.Status"]" Component="DropDownHistStatus" />
                <RadzenDropDown Name="DropDownHistStatus" @bind-Value="_fHistStatus" Data="@DeliveryStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />

                <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyHistFilter" class="ames-rz-btn" />
            </RadzenStack>
        </div>
        <RadzenDataGrid TItem="SysRepository.NotifHistoryRow" Data="@_histRows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                        PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" EmptyText="@L["SYS.Notifications.History.Empty"]" Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="SysRepository.NotifHistoryRow" Property="SentAt" Title="@L["Col.SentAt"]" Width="110px">
                    <Template Context="h"><span class="dim">@(h.SentAt?.ToString(DateFmt.MonthDayTime) ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifHistoryRow" Property="EventTypeCode" Title="@L["Col.EventName"]" Width="130px">
                    <Template Context="h"><span class="code">@(h.EventTypeCode ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifHistoryRow" Property="RecipientUserId" Title="@L["Col.Recipient"]">
                    <Template Context="h"><span class="dim" style="font-size:11px;max-width:140px;overflow:hidden;text-overflow:ellipsis;display:block;">@(h.RecipientUserId ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifHistoryRow" Property="Channel" Title="@L["Col.Channel"]" Width="90px">
                    <Template Context="h"><span class="pill info">@(h.Channel ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifHistoryRow" Property="Subject" Title="@L["Col.Name"]">
                    <Template Context="h">@(h.Subject ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifHistoryRow" Property="Status" Title="@L["Col.Status"]" Width="90px" TextAlign="TextAlign.Center">
                    <Template Context="h">@DeliveryStatusPill(h.Status)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifHistoryRow" Property="RetryCount" Title="@L["Col.EventCount"]" Width="80px" TextAlign="TextAlign.Center">
                    <Template Context="h">@(h.RetryCount?.ToString() ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SysRepository.NotifHistoryRow" Property="ErrorMsg" Title="@L["Col.Error"]">
                    <Template Context="h"><span class="dim">@(h.ErrorMsg ?? "—")</span></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</AmesTab>
</AmesTabs>

@* ── Notification rules ─ Create Modal ─────────────────────────────────────── *@
@if (_ruleModal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Notifications.Modal.CreateRule"]</div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@(L["Col.EventCode"].Value + " *")" class="ames-rz-modal-label" Component="CreateRuleTextBoxEventCode" />
                    <RadzenTextBox Name="CreateRuleTextBoxEventCode" @bind-Value="_rf.EventTypeCode" Placeholder="EVENT_CODE" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.EventName"]" class="ames-rz-modal-label" Component="CreateRuleTextBoxEventName" />
                    <RadzenTextBox Name="CreateRuleTextBoxEventName" @bind-Value="_rf.EventName" Placeholder="@L["SYS.Notifications.Ph.EventName"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Module"]" class="ames-rz-modal-label" Component="CreateRuleDropDownModule" />
                    <RadzenDropDown AllowFiltering="true" Name="CreateRuleDropDownModule" @bind-Value="_rf.ModuleCode" Data="@ModuleOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.ProcessCode"]" class="ames-rz-modal-label" Component="CreateRuleDropDownProcess" />
                    <RadzenDropDown AllowFiltering="true" Name="CreateRuleDropDownProcess" @bind-Value="_rf.ProcessCode" Data="@ProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.TriggerCond"]" class="ames-rz-modal-label" Component="CreateRuleTextAreaTrigger" />
                    <RadzenTextArea Name="CreateRuleTextAreaTrigger" @bind-Value="_rf.TriggerCondition" Rows="2" Placeholder="DefectCount > 5" class="ames-rz-input" Style="flex:1;width:100%;resize:vertical;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Channel"]" class="ames-rz-modal-label" />
                    <div style="flex:1;width:100%;">
                        @if (_channelCodes.Count == 0)
                        {
                            <span class="dim" style="font-size:.8em;">@L["SYS.Notifications.Lbl.NoChannels"]</span>
                        }
                        else
                        {
                            <div class="ames-line-picker">
                                @foreach (var ch in _channelCodes.Where(c => c.UseFlag))
                                {
                                    <label class="ames-line-item">
                                        <RadzenCheckBox TValue="bool" Value="@_rf.SelectedChannels.Contains(ch.CodeValue!)" Change="@(v => ToggleChannel(ch.CodeValue!, v))" />
                                        <span class="code">@ch.CodeValue</span>
                                        <span class="dim">@MasterDataRepository.LocalName(ch)</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.RoleName"]" class="ames-rz-modal-label" />
                    <div style="flex:1;width:100%;">
                        @if (_rolesList.Count == 0)
                        {
                            <span class="dim" style="font-size:.8em;">@L["SYS.Notifications.Lbl.NoRoles"]</span>
                        }
                        else
                        {
                            <div class="ames-line-picker">
                                @foreach (var role in _rolesList)
                                {
                                    <label class="ames-line-item">
                                        <RadzenCheckBox TValue="bool" Value="@_rf.SelectedRoles.Contains(role)" Change="@(v => ToggleRole(role, v))" />
                                        <span class="code">@role</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Status"]" class="ames-rz-modal-label" Component="CreateRuleDropDownStatus" />
                    <RadzenDropDown Name="CreateRuleDropDownStatus" @bind-Value="_rf.StatusCode" Data="@NotifStatusOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_ruleModalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_ruleModalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_ruleBusy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveRuleCreate" Disabled="@_ruleBusy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseRuleModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Notification rules ─ Edit Modal ──────────────────────────────────────── *@
@if (_ruleModal == "edit" && _ruleSel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Notifications.Modal.EditRule"] — <span class="dim" style="font-weight:400;font-size:.9em;">@(_ruleSel.EventTypeCode ?? "—")</span></div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@(L["Col.EventCode"].Value + " *")" class="ames-rz-modal-label" Component="EditRuleTextBoxEventCode" />
                    <RadzenTextBox Name="EditRuleTextBoxEventCode" @bind-Value="_rf.EventTypeCode" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.EventName"]" class="ames-rz-modal-label" Component="EditRuleTextBoxEventName" />
                    <RadzenTextBox Name="EditRuleTextBoxEventName" @bind-Value="_rf.EventName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Module"]" class="ames-rz-modal-label" Component="EditRuleDropDownModule" />
                    <RadzenDropDown AllowFiltering="true" Name="EditRuleDropDownModule" @bind-Value="_rf.ModuleCode" Data="@ModuleOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.ProcessCode"]" class="ames-rz-modal-label" Component="EditRuleDropDownProcess" />
                    <RadzenDropDown AllowFiltering="true" Name="EditRuleDropDownProcess" @bind-Value="_rf.ProcessCode" Data="@ProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.TriggerCond"]" class="ames-rz-modal-label" Component="EditRuleTextAreaTrigger" />
                    <RadzenTextArea Name="EditRuleTextAreaTrigger" @bind-Value="_rf.TriggerCondition" Rows="2" class="ames-rz-input" Style="flex:1;width:100%;resize:vertical;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Channel"]" class="ames-rz-modal-label" />
                    <div style="flex:1;width:100%;">
                        @if (_channelCodes.Count == 0)
                        {
                            <span class="dim" style="font-size:.8em;">@L["SYS.Notifications.Lbl.NoChannels"]</span>
                        }
                        else
                        {
                            <div class="ames-line-picker">
                                @foreach (var ch in _channelCodes.Where(c => c.UseFlag))
                                {
                                    <label class="ames-line-item">
                                        <RadzenCheckBox TValue="bool" Value="@_rf.SelectedChannels.Contains(ch.CodeValue!)" Change="@(v => ToggleChannel(ch.CodeValue!, v))" />
                                        <span class="code">@ch.CodeValue</span>
                                        <span class="dim">@MasterDataRepository.LocalName(ch)</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.RoleName"]" class="ames-rz-modal-label" />
                    <div style="flex:1;width:100%;">
                        @if (_rolesList.Count == 0)
                        {
                            <span class="dim" style="font-size:.8em;">@L["SYS.Notifications.Lbl.NoRoles"]</span>
                        }
                        else
                        {
                            <div class="ames-line-picker">
                                @foreach (var role in _rolesList)
                                {
                                    <label class="ames-line-item">
                                        <RadzenCheckBox TValue="bool" Value="@_rf.SelectedRoles.Contains(role)" Change="@(v => ToggleRole(role, v))" />
                                        <span class="code">@role</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Status"]" class="ames-rz-modal-label" Component="EditRuleDropDownStatus" />
                    <RadzenDropDown Name="EditRuleDropDownStatus" @bind-Value="_rf.StatusCode" Data="@NotifStatusOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
            </RadzenStack>

            @if (_ruleConfirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _ruleConfirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_ruleBusy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveRuleDelete" Disabled="@_ruleBusy" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_ruleModalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_ruleModalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_ruleBusy ? L["Msg.Saving"] : L["Btn.Save"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveRuleEdit" Disabled="@_ruleBusy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _ruleConfirmDelete = true; _ruleModalErr = ""; }' Disabled="@_ruleBusy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseRuleModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

