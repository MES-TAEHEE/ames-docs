                <RadzenButton Text="@(_chBusy ? L["Msg.Saving"] : L["Btn.Save"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveChEdit" Disabled="@_chBusy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _chConfirmDelete = true; _chModalErr = ""; }' Disabled="@_chBusy" class="ames-rz-btn" />
