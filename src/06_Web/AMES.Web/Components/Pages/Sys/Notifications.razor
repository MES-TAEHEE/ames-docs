<style>
    .dim-label { font-weight: 400; color: #64748b; font-size: .85em; }
</style>

@code {
    string _tab = "rules";
    bool _bgMouseDownOnSelf;
    string _actor = "system";

    // ── 알림 규칙 ──────────────────────────────────────────────────────
    List<AMES.Data.Repositories.SysRepository.NotifRuleRow> _rules    = new();
    List<AMES.Data.Repositories.SysRepository.NotifRuleRow> _ruleRows = new();
    AMES.Data.Repositories.SysRepository.NotifRuleRow? _ruleSel;

    string _fRuleSearch = "", _fRuleModule = "", _fRuleEnabled = "";
    string _ruleModal = "", _ruleModalErr = "";
    bool _ruleBusy, _ruleConfirmDelete;
    RuleForm _rf = new();

    // ── 발송 이력 ──────────────────────────────────────────────────────
    List<AMES.Data.Repositories.SysRepository.NotifHistoryRow> _hist = new();
    int _sent, _failed;

    // ── 채널 설정 ──────────────────────────────────────────────────────
    List<AMES.Data.Repositories.SysRepository.UserSelectRow>   _userList = new();
    List<AMES.Data.Repositories.SysRepository.NotifChannelRow> _channels = new();
    List<AMES.Data.Repositories.SysRepository.NotifChannelRow> _chRows   = new();
    AMES.Data.Repositories.SysRepository.NotifChannelRow? _chSel;

    string _fChSearch = "", _fChType = "", _fChEnabled = "";
    string _chModal = "", _chModalErr = "";
    bool _chBusy, _chConfirmDelete;
    ChForm _cf = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        try { _userList = Sys.ListUsersForSelect(); } catch { }
        Reload();
    }

    void Reload()
    {
        try { _rules    = Sys.ListNotificationRules(); }    catch { }
        try { _hist     = Sys.ListNotificationHistory(); }  catch { }
        try { _channels = Sys.ListNotificationChannels(); } catch { }

        var recent = _hist.Where(h => h.SentAt.HasValue
                        && (DateTime.Now - h.SentAt.Value).TotalHours <= 24).ToList();
        _sent   = recent.Count(h => h.Status == "SENT");
        _failed = recent.Count(h => h.Status == "FAILED");

        ApplyRuleFilter();
        ApplyChFilter();
    }

    // ── 규칙 필터 ──────────────────────────────────────────────────────
    void ApplyRuleFilter() => _ruleRows = _rules.Where(r =>
        (string.IsNullOrEmpty(_fRuleSearch) ||
            (r.EventTypeCode ?? "").Contains(_fRuleSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EventName     ?? "").Contains(_fRuleSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fRuleModule)  || r.SourceModule == _fRuleModule) &&
        (string.IsNullOrEmpty(_fRuleEnabled) || (_fRuleEnabled == "Y" ? r.IsEnabled : !r.IsEnabled))
    ).ToList();

    void OpenRuleCreate()
    {
        _rf = new() { IsEnabled = true };
        _ruleModalErr = ""; _ruleConfirmDelete = false; _ruleModal = "create";
    }

    void OpenRuleEdit(AMES.Data.Repositories.SysRepository.NotifRuleRow r)
    {
        _ruleSel = r; _ruleModalErr = ""; _ruleConfirmDelete = false;
        _rf = new()
        {
            EventTypeCode     = r.EventTypeCode     ?? "",
            EventName         = r.EventName         ?? "",
            SourceModule      = r.SourceModule      ?? "",
            TriggerCondition  = r.TriggerCondition  ?? "",
            IsEnabled         = r.IsEnabled,
            ChannelsJson      = r.ChannelsJson      ?? "",
            RecipientRolesJson= r.RecipientRolesJson ?? "",
        };
        _ruleModal = "edit";
    }

    void CloseRuleModal() { _ruleModal = ""; _ruleSel = null; _ruleModalErr = ""; _ruleConfirmDelete = false; }

    void SaveRuleCreate()
    {
        _ruleModalErr = "";
        if (string.IsNullOrWhiteSpace(_rf.EventTypeCode))
        { _ruleModalErr = "이벤트 코드를 입력하세요."; return; }
        _ruleBusy = true;
        try
        {
            Sys.InsertNotificationRule(
                NE(_rf.EventTypeCode), NE(_rf.EventName), NE(_rf.SourceModule),
                NE(_rf.TriggerCondition), _rf.IsEnabled,
                NE(_rf.ChannelsJson), NE(_rf.RecipientRolesJson), _actor);
            CloseRuleModal(); Reload();
        }
        catch (Exception ex) { _ruleModalErr = ex.Message; }
        finally { _ruleBusy = false; }
    }

    void SaveRuleEdit()
    {
        if (_ruleSel is null) return;
        _ruleModalErr = "";
        if (string.IsNullOrWhiteSpace(_rf.EventTypeCode))
        { _ruleModalErr = "이벤트 코드를 입력하세요."; return; }
        _ruleBusy = true;
        try
        {
            Sys.UpdateNotificationRule(
                _ruleSel.NotificationRuleId,
                NE(_rf.EventTypeCode), NE(_rf.EventName), NE(_rf.SourceModule),
                NE(_rf.TriggerCondition), _rf.IsEnabled,
                NE(_rf.ChannelsJson), NE(_rf.RecipientRolesJson), _actor);
            CloseRuleModal(); Reload();
        }
        catch (Exception ex) { _ruleModalErr = ex.Message; }
        finally { _ruleBusy = false; }
    }

    void SaveRuleDelete()
    {
        if (_ruleSel is null) return;
        _ruleBusy = true;
        try
        {
            Sys.DeleteNotificationRule(_ruleSel.NotificationRuleId);
            CloseRuleModal(); Reload();
        }
        catch (Exception ex) { _ruleModalErr = ex.Message; _ruleConfirmDelete = false; }
        finally { _ruleBusy = false; }
    }

    // ── 채널 필터 ──────────────────────────────────────────────────────
    void ApplyChFilter() => _chRows = _channels.Where(c =>
        (string.IsNullOrEmpty(_fChSearch) ||
            (c.UserName ?? c.UserId ?? "").Contains(_fChSearch, StringComparison.OrdinalIgnoreCase) ||
            (c.Address  ?? "").Contains(_fChSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fChType)    || c.Channel == _fChType) &&
        (string.IsNullOrEmpty(_fChEnabled) || (_fChEnabled == "Y" ? c.IsEnabled : !c.IsEnabled))
    ).ToList();

    void OpenChCreate()
    {
        _cf = new() { IsEnabled = true, Channel = "EMAIL" };
        _chModalErr = ""; _chConfirmDelete = false; _chModal = "create";
    }

    void OpenChEdit(AMES.Data.Repositories.SysRepository.NotifChannelRow c)
    {
        _chSel = c; _chModalErr = ""; _chConfirmDelete = false;
        _cf = new()
        {
            UserId     = c.UserId     ?? "",
            Channel    = c.Channel    ?? "EMAIL",
            Address    = c.Address    ?? "",
            IsEnabled  = c.IsEnabled,
            QuietStart = c.QuietHoursStart.HasValue ? TimeOnly.FromTimeSpan(c.QuietHoursStart.Value) : null,
            QuietEnd   = c.QuietHoursEnd.HasValue   ? TimeOnly.FromTimeSpan(c.QuietHoursEnd.Value)   : null,
        };
        _chModal = "edit";
    }

    void CloseChModal() { _chModal = ""; _chSel = null; _chModalErr = ""; _chConfirmDelete = false; }

    void OnCreateUserChanged(ChangeEventArgs e)
    {
        _cf.UserId = e.Value?.ToString() ?? "";
        AutoFillAddress();
    }

    void OnCreateChannelChanged(ChangeEventArgs e)
    {
        _cf.Channel = e.Value?.ToString() ?? "EMAIL";
        AutoFillAddress();
    }

    void AutoFillAddress()
    {
        if (string.IsNullOrEmpty(_cf.UserId)) return;
        var u = _userList.FirstOrDefault(x => x.Id == _cf.UserId);
        if (u is null) return;
        _cf.Address = _cf.Channel switch
        {
            "EMAIL" => u.Email        ?? _cf.Address,
            "SMS"   => u.PhoneNumber  ?? _cf.Address,
            _       => _cf.Address,
        };
    }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick()
    {
        if (!_bgMouseDownOnSelf) { _bgMouseDownOnSelf = false; return; }
        _bgMouseDownOnSelf = false;
        CloseRuleModal();
        CloseChModal();
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveChCreate()
    {
        _chModalErr = "";
        if (string.IsNullOrWhiteSpace(_cf.Channel))
        { _chModalErr = "채널을 선택하세요."; return; }
        _chBusy = true;
        try
        {
            Sys.InsertNotificationChannel(NE(_cf.UserId), _cf.Channel, NE(_cf.Address),
                _cf.IsEnabled,
                _cf.QuietStart.HasValue ? _cf.QuietStart.Value.ToTimeSpan() : null,
                _cf.QuietEnd.HasValue   ? _cf.QuietEnd.Value.ToTimeSpan()   : null,
                _actor);
            CloseChModal(); Reload();
