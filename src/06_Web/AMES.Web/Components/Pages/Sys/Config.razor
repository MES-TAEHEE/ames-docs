@page "/sys/config"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys

<PageTitle>SYS-009 시스템 설정 · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">SYS-009</div>
    <div class="ames-page-t">시스템 설정</div>
    <div class="ames-page-sub">환경설정 (Key-Value) — 카테고리별</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">키</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">전체 설정 키</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">활성</div>
        <div class="ames-kpi-v">@_active</div><div class="ames-kpi-s">IsActive=true</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">카테고리</div>
        <div class="ames-kpi-v">@_cat</div><div class="ames-kpi-s">구분 수</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">보안</div>
        <div class="ames-kpi-v">@_sec</div><div class="ames-kpi-s">보안 키</div></div>
</div>

@foreach (var grp in _rows.GroupBy(r => r.Category ?? "기타").OrderBy(g => g.Key))
{
    <div class="ames-card">
        <div class="ames-card-h">▼ @grp.Key  ·  @grp.Count()개</div>
        <table class="ames-table">
            <thead><tr><th>키</th><th>설명</th><th>값</th><th>단위</th><th>유형</th><th>상태</th></tr></thead>
            <tbody>
                @foreach (var c in grp.OrderBy(x => x.SortOrder ?? 999).ThenBy(x => x.ConfigKey))
                {
                    <tr>
                        <td class="code">@(c.ConfigKey ?? "—")</td>
                        <td class="dim">@(c.CodeName ?? "—")</td>
                        <td class="code"><span style="color:#fff">@(c.ConfigValue ?? "—")</span></td>
                        <td class="dim">@(c.Unit ?? "")</td>
                        <td class="dim">@(c.ConfigType ?? "—")</td>
                        <td>@(c.IsActive ? (MarkupString)"<span class=\"pill ok\">활성</span>"
                                          : (MarkupString)"<span class=\"pill warn\">비활성</span>")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_rows.Count == 0)
{
    <div class="ames-card"><div class="ames-empty">설정 키가 없습니다.</div></div>
}

@code {
    List<AMES.Data.Repositories.SysRepository.ConfigRow> _rows = new();
    int _active, _cat, _sec;
    protected override void OnInitialized()
    {
        try { _rows = Sys.ListConfig(); } catch { }
        _active = _rows.Count(r => r.IsActive);
        _cat    = _rows.Select(r => r.Category).Distinct().Count();
        _sec    = _rows.Count(r => r.Category == "Security");
    }
}
