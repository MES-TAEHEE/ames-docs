@page "/sys/config"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-009 @L["SYS.Config.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">SYS-009</div>
    <div class="ames-page-t">@L["SYS.Config.Title"]</div>
    <div class="ames-page-sub">@L["SYS.Config.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["SYS.Config.Kpi.Keys"]</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">@L["SYS.Config.Kpi.KeysSub"]</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["SYS.Config.Kpi.Active"]</div>
        <div class="ames-kpi-v">@_active</div><div class="ames-kpi-s">@L["SYS.Config.Kpi.ActiveSub"]</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["SYS.Config.Kpi.Categories"]</div>
        <div class="ames-kpi-v">@_cat</div><div class="ames-kpi-s">@L["SYS.Config.Kpi.CategoriesSub"]</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["SYS.Config.Kpi.Security"]</div>
        <div class="ames-kpi-v">@_sec</div><div class="ames-kpi-s">@L["SYS.Config.Kpi.SecuritySub"]</div></div>
</div>

@foreach (var grp in _rows.Skip(_page * _pageSize).Take(_pageSize).GroupBy(r => r.Category ?? L["SYS.Config.GroupOther"].Value).OrderBy(g => g.Key))
{
    <div class="ames-card">
        <div class="ames-card-h">▼ @grp.Key  ·  @grp.Count() @L["Lbl.Count"]</div>
        <table class="ames-table">
            <thead><tr><th>@L["SYS.Config.Col.Key"]</th><th>@L["SYS.Config.Col.Desc"]</th><th>@L["SYS.Config.Col.Value"]</th><th>@L["SYS.Config.Col.Unit"]</th><th>@L["SYS.Config.Col.Type"]</th><th>@L["Col.Status"]</th></tr></thead>
            <tbody>
                @foreach (var c in grp.OrderBy(x => x.SortOrder ?? 999).ThenBy(x => x.ConfigKey))
                {
                    <tr>
                        <td class="code">@(c.ConfigKey ?? "—")</td>
                        <td class="dim">@(c.CodeName ?? "—")</td>
                        <td class="code"><span style="color:#fff">@(c.ConfigValue ?? "—")</span></td>
                        <td class="dim">@(c.Unit ?? "")</td>
                        <td class="dim">@(c.ConfigType ?? "—")</td>
                        <td>@(c.IsActive ? (MarkupString)$"<span class=\"pill ok\">{L["SYS.Config.Active"]}</span>"
                                          : (MarkupString)$"<span class=\"pill warn\">{L["SYS.Config.Inactive"]}</span>")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />

@if (_rows.Count == 0)
{
    <div class="ames-card"><div class="ames-empty">@L["SYS.Config.Empty"]</div></div>
}

@code {
    List<AMES.Data.Repositories.SysRepository.ConfigRow> _rows = new();
    int _page = 0;
    const int _pageSize = 20;
    int _active, _cat, _sec;
    protected override void OnInitialized()
    {
        try { _rows = Sys.ListConfig(); } catch { }
        _active = _rows.Count(r => r.IsActive);
        _cat    = _rows.Select(r => r.Category).Distinct().Count();
        _sec    = _rows.Count(r => r.Category == "Security");
    }
}
