@page "/sys/audit"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using AMES.Data.Repositories
@using Radzen

@attribute [Authorize]
@inject SysRepository Sys
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-007 @L["SYS.Audit.Title"] · AMES</PageTitle>
<AmesPageHeader Code="SYS-007" TitleKey="SYS.Audit.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Audit.Kpi.Events"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allRows.Count</div>
            <div class="ames-kpi-s">@L["SYS.Audit.Kpi.EventsSub"]</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Audit.Kpi.Ok"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_ok</div>
            <div class="ames-kpi-s">@L["SYS.Audit.Kpi.OkSub"]</div>
        </div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">@L["SYS.Audit.Kpi.Fail"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_fail</div>
            <div class="ames-kpi-s">@L["SYS.Audit.Kpi.FailSub"]</div>
        </div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["SYS.Audit.Kpi.Last24h"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_day</div>
            <div class="ames-kpi-s">@L["Lbl.Items"]</div>
        </div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["SYS.Audit.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Lbl.Period"]" />
            <RadzenDatePicker TValue="DateTime" @bind-Value="_fFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:125px;" />
            <span class="dim">~</span>
            <RadzenDatePicker TValue="DateTime" @bind-Value="_fTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:125px;" />

            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["SYS.Audit.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenLabel Text="@L["Col.Module"]" Component="DropDownModule" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownModule" @bind-Value="_fModule" Data="@ModuleOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenLabel Text="@L["Col.Process"]" Component="DropDownProcess" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownProcess" @bind-Value="_fProcess" Data="@ProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Lbl.Result"]" Component="DropDownResult" />
            <RadzenDropDown Name="DropDownResult" @bind-Value="_fResult" Data="@ResultOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:90px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="SysRepository.AuditRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["SYS.Audit.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="EventTs" Title="@L["SYS.Audit.Col.Time"]" Width="140px">
                <Template Context="a"><span class="code dim" style="font-size:13px;white-space:nowrap;">@(a.EventTs?.ToString(DateFmt.MonthDayTimeSec) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="ActorUserId" Title="@L["SYS.Audit.Col.Actor"]" Width="150px">
                <Template Context="a"><span class="dim" style="font-family:'JetBrains Mono',monospace;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;max-width:140px;">@(a.ActorUserId ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="ModuleCode" Title="@L["SYS.Audit.Col.Module"]" Width="90px">
                <Template Context="a"><span class="pill @ModClass(a.ModuleCode)">@(a.ModuleCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="ProcessCode" Title="@L["Col.ProcessCode"]" Width="110px">
                <Template Context="a">
                    @if (a.ProcessCode != null)
                    {
                        var procName = _processItems.FirstOrDefault(c2 => c2.CodeValue == a.ProcessCode) is { } pf ? MasterDataRepository.LocalName(pf) : null;
                        <span class="pill @Ui.ProcessClass(a.ProcessCode)">@a.ProcessCode</span>
                        @if (procName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@procName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="ScreenCode" Title="@L["SYS.Audit.Col.Screen"]" Width="110px">
                <Template Context="a"><span class="code" style="font-size:13px;">@(a.ScreenCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="ActionType" Title="@L["SYS.Audit.Col.Action"]" Width="100px">
                <Template Context="a"><span class="pill @ActClass(a.ActionType)">@(a.ActionType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="TargetEntity" Title="@L["SYS.Audit.Col.Entity"]">
                <Template Context="a"><span class="dim" style="font-size:13px;">@(a.TargetEntity ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="TargetId" Title="@L["SYS.Audit.Col.TargetId"]" Width="120px">
                <Template Context="a"><span class="code dim" style="font-size:13px;">@(a.TargetId ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="Result" Title="@L["SYS.Audit.Col.Result"]" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="a">@ResultPill(a.Result)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.AuditRow" Property="IpAddress" Title="@L["SYS.Audit.Col.Ip"]" Width="130px">
                <Template Context="a"><span class="dim code" style="font-size:12px;">@(a.IpAddress ?? "—")</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Detail Modal ─────────────────────────────────────────────────── *@
@if (_sel is not null)
{
    <div class="ames-modal-bg" @onclick="() => _sel = null">
        <div class="ames-modal" @onclick:stopPropagation>
            <div class="ames-modal-h" style="display:flex;align-items:center;gap:10px;">
                <span>@L["SYS.Audit.Detail"]</span>
                @ResultPill(_sel.Result)
            </div>

            @* 기본 정보 *@
            <div class="audit-section-label">@L["SYS.Audit.Sect.Basic"]</div>
            <div class="audit-detail-grid">
                <div class="audit-kv">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.Time"]</span>
                    <span class="audit-kv-v code">@(_sel.EventTs?.ToString(DateFmt.DateTimeSec) ?? "—")</span>
                </div>
                <div class="audit-kv">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.Actor"]</span>
                    <span class="audit-kv-v code">@(_sel.ActorUserId ?? "—")</span>
                </div>
                <div class="audit-kv">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.Ip"]</span>
                    <span class="audit-kv-v code">@(_sel.IpAddress ?? "—")</span>
                </div>
                <div class="audit-kv">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.Result"]</span>
                    <span class="audit-kv-v">@ResultPill(_sel.Result)</span>
                </div>
            </div>

            @* 이벤트 정보 *@
            <div class="audit-section-label" style="margin-top:14px;">@L["SYS.Audit.Sect.Event"]</div>
            <div class="audit-detail-grid">
                <div class="audit-kv">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.Module"]</span>
                    <span class="audit-kv-v"><span class="pill @ModClass(_sel.ModuleCode)">@(_sel.ModuleCode ?? "—")</span></span>
                </div>
                <div class="audit-kv">
                    <span class="audit-kv-l">@L["Col.ProcessCode"]</span>
                    <span class="audit-kv-v code">@(_sel.ProcessCode ?? "—")</span>
                </div>
                <div class="audit-kv">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.Screen"]</span>
                    <span class="audit-kv-v code">@(_sel.ScreenCode ?? "—")</span>
                </div>
                <div class="audit-kv">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.Action"]</span>
                    <span class="audit-kv-v"><span class="pill @ActClass(_sel.ActionType)">@(_sel.ActionType ?? "—")</span></span>
                </div>
                <div class="audit-kv" style="grid-column:1/3;">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.Entity"]</span>
                    <span class="audit-kv-v code">@(_sel.TargetEntity ?? "—")</span>
                </div>
                <div class="audit-kv" style="grid-column:1/3;">
                    <span class="audit-kv-l">@L["SYS.Audit.Col.TargetId"]</span>
                    <span class="audit-kv-v code">@(_sel.TargetId ?? "—")</span>
                </div>
            </div>

            @* 비고 *@
            @if (!string.IsNullOrWhiteSpace(_sel.Note))
            {
                <div class="audit-section-label" style="margin-top:14px;">@L["SYS.Audit.Col.Note"]</div>
                <div style="margin-top:4px;padding:10px 12px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:6px;
                            font-size:13px;color:#94a3b8;white-space:pre-wrap;word-break:break-all;line-height:1.6;">@_sel.Note</div>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@L["Btn.Close"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="() => _sel = null" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<SysRepository.AuditRow> _allRows = new();
    List<SysRepository.AuditRow> _rows    = new();
    SysRepository.AuditRow? _sel;
    List<MasterDataRepository.CodeItemRow> _moduleItems  = new();
    List<MasterDataRepository.CodeItemRow> _processItems = new();
    List<MasterDataRepository.CodeItemRow> _resultItems  = new();

    int _ok, _fail, _day;
    string  _fSearch = "";
    string? _fModule, _fProcess, _fResult;
    DateTime _fFrom = DateTime.Today.AddDays(-7);
    DateTime _fTo = DateTime.Today;

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ModuleOptions => _moduleItems.Where(m => m.UseFlag).Select(m => new DropDownItem { Value = m.CodeValue ?? "", Text = $"[{m.CodeValue}] {MasterDataRepository.LocalName(m)}" });
    private IEnumerable<DropDownItem> ProcessOptions => _processItems.Where(p => p.UseFlag).Select(p => new DropDownItem { Value = p.CodeValue ?? "", Text = $"[{p.CodeValue}] {MasterDataRepository.LocalName(p)}" });
    private IEnumerable<DropDownItem> ResultOptions => _resultItems.Where(r => r.UseFlag).Select(r => new DropDownItem { Value = r.CodeValue ?? "", Text = $"[{r.CodeValue}] {MasterDataRepository.LocalName(r)}" });

    protected override void OnInitialized()
    {
        try { _moduleItems  = MD.ListCodeItems("MODULE"); } catch { }
        try { _processItems = MD.ListCodeItems("PROCESS"); } catch { }
        try { _resultItems  = MD.ListCodeItems("AUDIT_STATUS"); } catch { }
        Reload();
    }

    void Reload()
    {
        try { _allRows = Sys.ListAudit(); } catch { _allRows = new(); }
        _ok   = _allRows.Count(r => r.Result == "OK");
        _fail = _allRows.Count(r => r.Result != "OK" && r.Result is not null);
        _day  = _allRows.Count(r => r.EventTs.HasValue && (DateTime.Now - r.EventTs.Value).TotalHours <= 24);
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _allRows.Where(r =>
            (string.IsNullOrEmpty(_fSearch) ||
                (r.ActorUserId  ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.TargetId     ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.TargetEntity ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.Note         ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_fModule)  || r.ModuleCode  == _fModule) &&
            (string.IsNullOrEmpty(_fProcess) || r.ProcessCode == _fProcess) &&
            (string.IsNullOrEmpty(_fResult)  || r.Result      == _fResult) &&
            (!r.EventTs.HasValue || (r.EventTs.Value.Date >= _fFrom.Date && r.EventTs.Value.Date <= _fTo.Date))
        ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<SysRepository.AuditRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<SysRepository.AuditRow> args)
    {
        if (args.Data is not null) OpenDetail(args.Data);
    }

    void OpenDetail(SysRepository.AuditRow r) => _sel = r;

    RenderFragment ResultPill(string? result) => builder =>
    {
        var (cls, lbl) = result switch
        {
            "OK"   => ("ok",  "OK"),
            "FAIL" => ("bad", "FAIL"),
            _      => ("info", result ?? "—")
        };
        if (result is null) { builder.AddContent(0, "—"); return; }
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"pill {cls}");
        builder.AddContent(2, lbl);
        builder.CloseElement();
    };

    static string ModClass(string? m) => m switch
    {
        "SYS"           => "info",
        "QC"            => "warn",
        "PP"            => "info",
        "WH" or "FG"    => "ok",
        "MNT"           => "warn",
        _               => "info"
    };

    static string ActClass(string? a) => a switch
    {
        "DELETE" or "REJECT"             => "bad",
        "CREATE" or "UPDATE" or "APPROVE" => "warn",
        "LOGIN"  or "LOGOUT"             => "info",
        _                                 => "info"
    };
}