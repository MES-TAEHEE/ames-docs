@page "/sys/audit"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-007 @L["SYS.Audit.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">SYS-007</div>
    <div class="ames-page-t">@L["SYS.Audit.Title"]</div>
    <div class="ames-page-sub">@L["SYS.Audit.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["SYS.Audit.Kpi.Events"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div><div class="ames-kpi-s">@L["SYS.Audit.Kpi.EventsSub"]</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["SYS.Audit.Kpi.Ok"]</div>
        <div class="ames-kpi-v">@_ok</div><div class="ames-kpi-s">@L["SYS.Audit.Kpi.OkSub"]</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">@L["SYS.Audit.Kpi.Fail"]</div>
        <div class="ames-kpi-v">@_fail</div><div class="ames-kpi-s">@L["SYS.Audit.Kpi.FailSub"]</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["SYS.Audit.Kpi.Last24h"]</div>
        <div class="ames-kpi-v">@_day</div><div class="ames-kpi-s">@L["Lbl.Items"]</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span>▼ @L["SYS.Audit.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input type="date" class="ames-input" style="width:145px;" @bind="_fFrom" @bind:format="yyyy-MM-dd" />
            <span style="color:#94a3b8;">~</span>
            <input type="date" class="ames-input" style="width:145px;" @bind="_fTo" @bind:format="yyyy-MM-dd" />
            <input class="ames-input" style="width:150px;padding:4px 8px;"
                   placeholder="@L["SYS.Audit.Ph.Search"]" @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fModule">
                <option value="">@L["SYS.Audit.Filter.AllModules"]</option>
                <option value="PP">PP</option>
                <option value="MNT">MNT</option>
                <option value="QC">QC</option>
                <option value="WH">WH</option>
                <option value="FG">FG</option>
                <option value="SYS">SYS</option>
            </select>
            <select class="ames-input" style="width:85px;padding:4px 8px;" @bind="_fResult">
                <option value="">@L["SYS.Audit.Filter.AllResults"]</option>
                <option value="OK">OK</option>
                <option value="FAIL">FAIL</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
        </div>
    </div>
    <table class="ames-table">
        <thead>
            <tr>
                <th>@L["SYS.Audit.Col.Time"]</th><th>@L["SYS.Audit.Col.Actor"]</th><th>@L["SYS.Audit.Col.Module"]</th><th>@L["SYS.Audit.Col.Screen"]</th>
                <th>@L["SYS.Audit.Col.Action"]</th><th>@L["SYS.Audit.Col.Entity"]</th><th>@L["SYS.Audit.Col.TargetId"]</th>
                <th>@L["SYS.Audit.Col.Result"]</th><th>@L["SYS.Audit.Col.Ip"]</th><th>@L["SYS.Audit.Col.Note"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _rows.Skip(_page * _pageSize).Take(_pageSize))
            {
                <tr>
                    <td class="dim">@(a.EventTs?.ToString("MM-dd HH:mm:ss") ?? "—")</td>
                    <td class="dim" style="font-family:'JetBrains Mono',monospace;font-size:11px;max-width:140px;overflow:hidden;text-overflow:ellipsis;display:inline-block;">@(a.ActorUserId ?? "—")</td>
                    <td><span class="pill info">@(a.ModuleCode ?? "—")</span></td>
                    <td class="code">@(a.ScreenCode ?? "—")</td>
                    <td><span class="pill @ActClass(a.ActionType)">@(a.ActionType ?? "—")</span></td>
                    <td class="dim">@(a.TargetEntity ?? "—")</td>
                    <td class="code dim">@(a.TargetId ?? "—")</td>
                    <td>
                        @if (a.Result == "OK")     { <span class="pill ok">OK</span> }
                        else if (a.Result == "FAIL") { <span class="pill bad">FAIL</span> }
                        else { <span class="dim">@(a.Result ?? "—")</span> }
                    </td>
                    <td class="dim code">@(a.IpAddress ?? "—")</td>
                    <td class="dim">@(a.Note ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
    <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    @if (_rows.Count == 0) { <div class="ames-empty">@L["SYS.Audit.Empty"]</div> }
</div>

@code {
    int _page = 0;
    const int _pageSize = 20;
    List<AMES.Data.Repositories.SysRepository.AuditRow> _allRows = new();
    List<AMES.Data.Repositories.SysRepository.AuditRow> _rows    = new();
    int _ok, _fail, _day;
    string _fSearch = "", _fModule = "", _fResult = "";
    DateTime _fFrom = DateTime.Today.AddDays(-7);
    DateTime _fTo   = DateTime.Today;
    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Sys.ListAudit(); } catch { _allRows = new(); }
        _ok   = _allRows.Count(r => r.Result == "OK");
        _fail = _allRows.Count(r => r.Result == "FAIL");
        _day  = _allRows.Count(r => r.EventTs.HasValue
                    && (DateTime.Now - r.EventTs.Value).TotalHours <= 24);
        ApplyFilter();
    }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.ActorUserId ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.TargetId    ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.Note        ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fModule)  || r.ModuleCode == _fModule) &&
        (string.IsNullOrEmpty(_fResult)  || r.Result     == _fResult) &&
        (!r.EventTs.HasValue || (r.EventTs.Value.Date >= _fFrom.Date && r.EventTs.Value.Date <= _fTo.Date))
    ).ToList(); }
    static string ActClass(string? a) => a switch
    { "DELETE" => "bad", "REJECT" => "bad",
      "CREATE" or "UPDATE" or "APPROVE" => "warn",
      "LOGIN" or "LOGOUT" => "info",
      _ => "info" };
}
