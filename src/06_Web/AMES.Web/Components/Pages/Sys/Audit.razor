@page "/sys/audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-007 @L["SYS.Audit.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">SYS-007</div>
    <div class="ames-page-t">@L["SYS.Audit.Title"]</div>
    <div class="ames-page-sub">@L["SYS.Audit.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["SYS.Audit.Kpi.Events"]</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">최근 항목</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["SYS.Audit.Kpi.Ok"]</div>
        <div class="ames-kpi-v">@_ok</div><div class="ames-kpi-s">결과 OK</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">@L["SYS.Audit.Kpi.Fail"]</div>
        <div class="ames-kpi-v">@_fail</div><div class="ames-kpi-s">결과 FAIL</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["SYS.Audit.Kpi.Last24h"]</div>
        <div class="ames-kpi-v">@_day</div><div class="ames-kpi-s">@L["Lbl.Items"]</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;">
        <span>▼ @L["SYS.Audit.List"]</span>
        <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
    </div>
    <table class="ames-table">
        <thead>
            <tr>
                <th>@L["SYS.Audit.Col.Time"]</th><th>@L["SYS.Audit.Col.Actor"]</th><th>@L["SYS.Audit.Col.Module"]</th><th>@L["SYS.Audit.Col.Screen"]</th>
                <th>@L["SYS.Audit.Col.Action"]</th><th>@L["SYS.Audit.Col.Entity"]</th><th>@L["SYS.Audit.Col.TargetId"]</th>
                <th>@L["SYS.Audit.Col.Result"]</th><th>@L["SYS.Audit.Col.Ip"]</th><th>@L["SYS.Audit.Col.Note"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _rows)
            {
                <tr>
                    <td class="dim">@(a.EventTs?.ToString("MM-dd HH:mm:ss") ?? "—")</td>
                    <td class="dim" style="font-family:'JetBrains Mono',monospace;font-size:11px;max-width:140px;overflow:hidden;text-overflow:ellipsis;display:inline-block;">@(a.ActorUserId ?? "—")</td>
                    <td><span class="pill info">@(a.ModuleCode ?? "—")</span></td>
                    <td class="code">@(a.ScreenCode ?? "—")</td>
                    <td><span class="pill @ActClass(a.ActionType)">@(a.ActionType ?? "—")</span></td>
                    <td class="dim">@(a.TargetEntity ?? "—")</td>
                    <td class="code dim">@(a.TargetId ?? "—")</td>
                    <td>
                        @if (a.Result == "OK")     { <span class="pill ok">OK</span> }
                        else if (a.Result == "FAIL") { <span class="pill bad">FAIL</span> }
                        else { <span class="dim">@(a.Result ?? "—")</span> }
                    </td>
                    <td class="dim code">@(a.IpAddress ?? "—")</td>
                    <td class="dim">@(a.Note ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
    @if (_rows.Count == 0) { <div class="ames-empty">@L["SYS.Audit.Empty"]</div> }
</div>

@code {
    List<AMES.Data.Repositories.SysRepository.AuditRow> _rows = new();
    int _ok, _fail, _day;
    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _rows = Sys.ListAudit(); } catch { }
        _ok   = _rows.Count(r => r.Result == "OK");
        _fail = _rows.Count(r => r.Result == "FAIL");
        _day  = _rows.Count(r => r.EventTs.HasValue
                    && (DateTime.Now - r.EventTs.Value).TotalHours <= 24);
    }
    static string ActClass(string? a) => a switch
    { "DELETE" => "bad", "REJECT" => "bad",
      "CREATE" or "UPDATE" or "APPROVE" => "warn",
      "LOGIN" or "LOGOUT" => "info",
      _ => "info" };
}
