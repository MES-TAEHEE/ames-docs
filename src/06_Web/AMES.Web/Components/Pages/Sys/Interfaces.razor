@page "/sys/interfaces"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys

<PageTitle>SYS-006 인터페이스 모니터 · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">SYS-006</div>
    <div class="ames-page-t">인터페이스 모니터</div>
    <div class="ames-page-sub">SAP / PLC / WMS / EDI 연결 상태</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">인터페이스</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">전체 등록</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">정상</div>
        <div class="ames-kpi-v">@_ok</div><div class="ames-kpi-s">연결 OK</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">경고</div>
        <div class="ames-kpi-v">@_warn</div><div class="ames-kpi-s">지연 위험</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">비정상</div>
        <div class="ames-kpi-v">@_down</div><div class="ames-kpi-s">연결 불가</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;">
        <span>▼ 인터페이스 목록</span>
        <button class="ames-btn ok" @onclick="Reload">조회</button>
    </div>
    <table class="ames-table">
        <thead>
            <tr>
                <th>코드</th><th>명칭</th><th>방향</th><th>엔드포인트</th>
                <th>프로토콜</th><th>상태</th>
                <th>최근 동기화</th><th class="num">경과(분)</th>
                <th class="num">마지막 행수</th><th class="num">재시도</th><th>오류</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in _rows)
            {
                <tr>
                    <td class="code">@(i.InterfaceCode ?? "—")</td>
                    <td>@(i.InterfaceName ?? "—")</td>
                    <td class="dim">@(i.Direction ?? "—")</td>
                    <td class="dim" style="font-family:'JetBrains Mono',monospace;font-size:11px;overflow:hidden;text-overflow:ellipsis;max-width:280px;display:inline-block;">@(i.Endpoint ?? "—")</td>
                    <td class="dim">@(i.Protocol ?? "—")</td>
                    <td><span class="pill @StClass(i.ConnStatus)">@(i.ConnStatus ?? "—")</span></td>
                    <td class="dim">@(i.LastSyncTs?.ToString("MM-dd HH:mm") ?? "—")</td>
                    <td class="num">@i.MinutesSinceSync</td>
                    <td class="num">@(i.LastRecordCount?.ToString() ?? "—")</td>
                    <td class="num">@(i.RetryCount?.ToString() ?? "—")</td>
                    <td class="dim">@(i.LastErrorMsg ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
    @if (_rows.Count == 0) { <div class="ames-empty">등록된 인터페이스가 없습니다.</div> }
</div>

@code {
    List<AMES.Data.Repositories.SysRepository.InterfaceRow> _rows = new();
    int _ok, _warn, _down;
    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _rows = Sys.ListInterfaces(); } catch { }
        _ok   = _rows.Count(r => r.ConnStatus is "OK" or "UP");
        _warn = _rows.Count(r => r.ConnStatus is "WARN" or "DEGRADED");
        _down = _rows.Count(r => r.ConnStatus is "DOWN" or "ERROR" or "FAULT");
    }
    static string StClass(string? s) => s switch
    { "OK" or "UP"             => "ok",
      "WARN" or "DEGRADED"     => "warn",
      "DOWN" or "ERROR" or "FAULT" => "bad",
      _                         => "info" };
}
