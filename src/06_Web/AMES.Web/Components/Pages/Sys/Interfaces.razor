@page "/sys/interfaces"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>SYS-006 @L["SYS.Interfaces.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Interfaces.Kpi.All"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allRows.Count</div>
            <div class="ames-kpi-s">@L["SYS.Interfaces.Kpi.AllSub"]</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Interfaces.Kpi.Ok"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_ok</div>
            <div class="ames-kpi-s">@L["SYS.Interfaces.Kpi.OkSub"]</div>
        </div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["SYS.Interfaces.Kpi.Warn"]</div>
            <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_warn</div>
            <div class="ames-kpi-s">@L["SYS.Interfaces.Kpi.WarnSub"]</div>
        </div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">@L["SYS.Interfaces.Kpi.Down"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_down</div>
            <div class="ames-kpi-s">@L["SYS.Interfaces.Kpi.DownSub"]</div>
        </div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span>▼ @L["SYS.Interfaces.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["SYS.Interfaces.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:250px;" />
            <RadzenLabel Text="@L["Lbl.Direction"]" Component="DropDownDir" />
            <RadzenDropDown Name="DropDownDir" @bind-Value="_fDir" Data="@DirList.Where(x => !string.IsNullOrEmpty(x.Value))" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:250px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusList.Where(x => !string.IsNullOrEmpty(x.Value))" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenButton Click=@(args => Reload()) Text="@L["Btn.Search"]" Icon="refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    @if (_err is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_err</RadzenAlert>
    }
    else if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["SYS.Interfaces.Empty"]</div>
    }
    else
    {
        <RadzenDataGrid TItem="AMES.Data.Repositories.SysRepository.InterfaceRow"
                        Data="@_rows" AllowPaging="true" PageSize="20"
                        PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true"
                        PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                        Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="InterfaceCode" Title="@L["SYS.Interfaces.Col.Code"]">
                    <Template Context="i">
                        <span class="code">@(i.InterfaceCode ?? "—")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="InterfaceName" Title="@L["SYS.Interfaces.Col.Name"]" />
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="Direction" Title="@L["SYS.Interfaces.Col.Dir"]">
                    <Template Context="i">
                        <span class="dim">@DirName(i.Direction)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="Endpoint" Title="@L["SYS.Interfaces.Col.Endpoint"]">
                    <Template Context="i">
                        <span class="dim" style="font-family:'JetBrains Mono',monospace;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;max-width:260px;">@(i.Endpoint ?? "—")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="Protocol" Title="@L["SYS.Interfaces.Col.Protocol"]">
                    <Template Context="i">
                        <span class="dim">@(i.Protocol ?? "—")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="ConnStatus" Title="@L["Col.Status"]">
                    <Template Context="i">
                        <span class="pill @StClass(i.ConnStatus)">@StatusName(i.ConnStatus)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="LastSyncTs" Title="@L["SYS.Interfaces.Col.LastSync"]">
                    <Template Context="i">
                        <span class="dim">@(i.LastSyncTs?.ToString("MM-dd HH:mm") ?? "—")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="MinutesSinceSync" Title="@L["SYS.Interfaces.Col.Elapsed"]" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="LastRecordCount" Title="@L["SYS.Interfaces.Col.LastCount"]" TextAlign="TextAlign.Right">
                    <Template Context="i">
                        <span>@(i.LastRecordCount?.ToString() ?? "—")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="RetryCount" Title="@L["SYS.Interfaces.Col.Retry"]" TextAlign="TextAlign.Right">
                    <Template Context="i">
                        <span>@(i.RetryCount?.ToString() ?? "—")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.InterfaceRow" Property="LastErrorMsg" Title="@L["SYS.Interfaces.Col.Error"]">
                    <Template Context="i">
                        <span class="dim">@(i.LastErrorMsg ?? "—")</span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</div>

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 20, 50, 100 };

    List<AMES.Data.Repositories.SysRepository.InterfaceRow> _allRows = new();
    List<AMES.Data.Repositories.SysRepository.InterfaceRow> _rows    = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _statusItems = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _dirItems    = new();
    int _ok, _warn, _down;
    string _fSearch = "", _fStatus = "", _fDir = "";
    string? _err;

    public class DropDownItem
    {
        public string Text  { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private IEnumerable<DropDownItem> DirList    => _dirItems.Where(d => d.UseFlag).Select(d => new DropDownItem { Text = $"[{d.CodeValue}] {MasterDataRepository.LocalName(d)}", Value = d.CodeValue ?? "" });
    private IEnumerable<DropDownItem> StatusList => _statusItems.Where(s => s.UseFlag).Select(s => new DropDownItem { Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}", Value = s.CodeValue ?? "" });

    protected override void OnInitialized()
    {
        try { _statusItems = Md.ListCodeItems("IF_STATUS"); }    catch { }
        try { _dirItems    = Md.ListCodeItems("IF_DIRECTION"); } catch { }
        Reload();
    }

    private void OnSearchChanged(string value) => _fSearch = value ?? "";

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Reload();
    }

    void Reload()
    {
        _err = null;
        try { _allRows = Sys.ListInterfaces(); }
        catch (Exception ex) { _err = ex.Message; _allRows = new(); }
        _ok   = _allRows.Count(r => r.ConnStatus is "OK" or "UP");
        _warn = _allRows.Count(r => r.ConnStatus is "WARN" or "DEGRADED");
        _down = _allRows.Count(r => r.ConnStatus is "DOWN" or "ERROR" or "FAULT");
        ApplyFilter();
    }

    void ApplyFilter() => _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.InterfaceCode ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.InterfaceName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fStatus) || r.ConnStatus == _fStatus) &&
        (string.IsNullOrEmpty(_fDir)    || r.Direction  == _fDir)
    ).ToList();

    string DirName(string? code)
    {
        if (code is null) return "—";
        var item = _dirItems.FirstOrDefault(d => d.CodeValue == code);
        return item is null ? code : MasterDataRepository.LocalName(item);
    }

    string StatusName(string? code)
    {
        if (code is null) return "—";
        var item = _statusItems.FirstOrDefault(s => string.Equals(s.CodeValue, code, StringComparison.OrdinalIgnoreCase));
        return item is null ? code : MasterDataRepository.LocalName(item);
    }

    static string StClass(string? s) => s switch
    {
        "OK" or "UP"                  => "ok",
        "WARN" or "DEGRADED"          => "warn",
        "DOWN" or "ERROR" or "FAULT"  => "bad",
        _                             => "info"
    };
}