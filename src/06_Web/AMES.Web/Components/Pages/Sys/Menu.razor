@page "/sys/menu"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject AuthenticationStateProvider Auth

<PageTitle>SYS-004 메뉴 관리 · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">SYS-004</div>
    <div class="ames-page-t">메뉴 관리</div>
    <div class="ames-page-sub">MD_Menu / MD_MenuRole — 메뉴 가시성 · 역할별 권한 (VIEW / EDIT / APPROVE) 설정</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">전체 메뉴</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">표시</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.IsVisible)</div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">숨김</div>
        <div class="ames-kpi-v">@_allRows.Count(r => !r.IsVisible)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">역할 제한</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RoleCount > 0)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ 메뉴 목록 · @_rows.Count 건@(_rows.Count < _allRows.Count ? $" / 전체 {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:160px;padding:4px 8px;"
                   placeholder="코드 / 메뉴명 / 경로" @bind="_fSearch" autocomplete="off" />
            <select class="ames-input" style="width:110px;padding:4px 8px;" @bind="_fSection">
                <option value="">섹션 전체</option>
                <option value="PP">PP</option>
                <option value="MNT">MNT</option>
                <option value="RPT">RPT</option>
                <option value="MD">MD</option>
                <option value="SYS">SYS</option>
            </select>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fVisible">
                <option value="">전체</option>
                <option value="Y">표시</option>
                <option value="N">숨김</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">조회</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">표시할 메뉴 항목이 없습니다.</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>코드</th><th>섹션</th><th>메뉴명 (한국어)</th><th>영문명</th>
                    <th>경로</th><th style="text-align:center;">표시</th><th style="text-align:center;">역할</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var prevSection = "";
                }
                @foreach (var r in _rows)
                {
                    @if (r.SectionCode != prevSection)
                    {
                        prevSection = r.SectionCode;
                        <tr style="background:#f8fafc;">
                            <td colspan="7" style="font-size:.8rem;font-weight:700;color:#64748b;letter-spacing:.05em;padding:6px 10px;">
                                ── @r.SectionCode ──────────────────────────────────
                            </td>
                        </tr>
                    }
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.MenuCode</td>
                        <td><span class="pill info">@r.SectionCode</span></td>
                        <td>@r.MenuName</td>
                        <td class="dim" style="font-size:12px;">@(r.MenuNameEn ?? "—")</td>
                        <td class="dim" style="font-size:12px;font-family:'JetBrains Mono',monospace;">@(r.HRef ?? "—")</td>
                        <td style="text-align:center;">
                            @if (r.IsVisible) { <span class="pill ok">표시</span> }
                            else { <span class="pill bad">숨김</span> }
                        </td>
                        <td style="text-align:center;">
                            @if (r.RoleCount > 0) { <span class="pill warn">@r.RoleCount 역할</span> }
                            else { <span class="pill dim" style="background:#f1f5f9;color:#94a3b8;">공개</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* ── Edit Modal ── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:560px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">메뉴 설정 — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.MenuCode · @_sel.MenuName</span></div>

            @* ── 기본 정보 ── *@
            <div class="menu-section-title">기본 설정</div>

            <label>영문명 (MenuNameEn)</label>
            <input class="ames-input" @bind="_f.MenuNameEn" placeholder="English menu name" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:8px;">
                <input type="checkbox" @bind="_f.IsVisible" />
                <span>메뉴 표시 (NavMenu 노출)</span>
            </label>

            @* ── 역할 권한 ── *@
            <div class="menu-section-title" style="margin-top:18px;">역할 권한 (MD_MenuRole)</div>
            <div style="font-size:.82rem;color:#64748b;margin-bottom:8px;">
                역할이 없으면 로그인한 모든 사용자가 접근 가능합니다.
            </div>

            @if (_selRoles.Count > 0)
            {
                <table class="ames-table" style="margin-bottom:10px;">
                    <thead>
                        <tr><th>역할명</th><th>권한</th><th style="width:44px;"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var rr in _selRoles)
                        {
                            <tr>
                                <td>@rr.RoleName</td>
                                <td>
                                    @if (rr.PermType == "VIEW")    { <span class="pill ok">VIEW</span> }
                                    else if (rr.PermType == "EDIT") { <span class="pill warn">EDIT</span> }
                                    else                            { <span class="pill bad">APPROVE</span> }
                                </td>
                                <td>
                                    <button class="ames-btn bad" style="padding:2px 8px;font-size:.78rem;"
                                            @onclick="() => DeleteRole(rr.MenuRoleId)">삭제</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="font-size:.85rem;color:#94a3b8;margin-bottom:10px;padding:8px;background:#f8fafc;border-radius:6px;">
                    등록된 역할 권한이 없습니다. (공개 메뉴)
                </div>
            }

            @* 역할 추가 폼 *@
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;padding:8px;background:#f8fafc;border-radius:6px;border:1px solid #e2e8f0;">
                <input class="ames-input" style="flex:1;min-width:120px;padding:4px 8px;"
                       placeholder="역할명 (예: Administrator)" @bind="_newRole" autocomplete="off" />
                <select class="ames-input" style="width:110px;padding:4px 8px;" @bind="_newPerm">
                    <option value="VIEW">VIEW</option>
                    <option value="EDIT">EDIT</option>
                    <option value="APPROVE">APPROVE</option>
                </select>
                <button class="ames-btn ok" style="padding:4px 12px;" @onclick="AddRole">+ 추가</button>
            </div>

            @if (!string.IsNullOrEmpty(_roleErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_roleErr</div> }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveBasic" disabled="@_busy">@(_busy ? "저장 중…" : "기본 설정 저장")</button>
                <button class="ames-btn"    @onclick="CloseModal">닫기</button>
            </div>
        </div>
    </div>
}

<style>
    .menu-section-title {
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .06em;
        color: #64748b;
        text-transform: uppercase;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 4px;
        margin-bottom: 10px;
    }
</style>

@code {
    List<AMES.Data.Repositories.SysRepository.MenuRow>     _allRows  = new();
    List<AMES.Data.Repositories.SysRepository.MenuRow>     _rows     = new();
    List<AMES.Data.Repositories.SysRepository.MenuRoleRow> _selRoles = new();
    AMES.Data.Repositories.SysRepository.MenuRow? _sel;

    string _fSearch = "", _fSection = "", _fVisible = "";
    string _modal = "", _modalErr = "", _roleErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr;
    string _actor = "system";

    string _newRole = "";
    string _newPerm = "VIEW";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        Reload();
    }

    void Reload() { _allRows = Sys.ListMenus(); ApplyFilter(); }

    void ApplyFilter() => _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.MenuCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            r.MenuName.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MenuNameEn ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.HRef ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fSection) || r.SectionCode == _fSection) &&
        (string.IsNullOrEmpty(_fVisible) || (_fVisible == "Y" ? r.IsVisible : !r.IsVisible))
    ).ToList();

    void OpenEdit(AMES.Data.Repositories.SysRepository.MenuRow r)
    {
        _sel = r;
        _modalErr = ""; _roleErr = ""; _newRole = ""; _newPerm = "VIEW";
        _f = new() { IsVisible = r.IsVisible, MenuNameEn = r.MenuNameEn ?? "" };
        _selRoles = Sys.ListMenuRoles(r.MenuId);
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _roleErr = ""; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveBasic()
    {
        if (_sel is null) return;
        _busy = true; _modalErr = "";
        try
        {
            var nameEn = string.IsNullOrWhiteSpace(_f.MenuNameEn) ? null : _f.MenuNameEn.Trim();
            Sys.UpdateMenuBasic(_sel.MenuId, nameEn, _f.IsVisible, _actor);
            Reload();
            // _sel 갱신
            _sel = _allRows.FirstOrDefault(r => r.MenuId == _sel.MenuId) ?? _sel;
            ShowMsg($"{_sel.MenuCode} 기본 설정 저장 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void AddRole()
    {
        if (_sel is null) return;
        _roleErr = "";
        if (string.IsNullOrWhiteSpace(_newRole))
        { _roleErr = "역할명을 입력하세요."; return; }
        var role = _newRole.Trim();
        if (Sys.MenuRoleExists(_sel.MenuId, role, _newPerm))
        { _roleErr = $"이미 등록된 역할/권한입니다: {role} / {_newPerm}"; return; }
        try
        {
            Sys.InsertMenuRole(_sel.MenuId, role, _newPerm, _actor);
            _selRoles = Sys.ListMenuRoles(_sel.MenuId);
            // KPI 갱신을 위해 목록도 재로드
            _allRows = Sys.ListMenus();
            ApplyFilter();
            _newRole = "";
        }
        catch (Exception ex) { _roleErr = ex.Message; }
    }

    void DeleteRole(int menuRoleId)
    {
        if (_sel is null) return;
        try
        {
            Sys.DeleteMenuRole(menuRoleId);
            _selRoles = Sys.ListMenuRoles(_sel.MenuId);
            _allRows = Sys.ListMenus();
            ApplyFilter();
        }
        catch (Exception ex) { _roleErr = ex.Message; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public bool   IsVisible  { get; set; } = true;
        public string MenuNameEn { get; set; } = "";
    }
}
