@page "/sys/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.AuthRepository Auth

<PageTitle>SYS-01 User Management · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">SYS-01</div>
    <div class="ames-page-t">User Management</div>
    <div class="ames-page-sub">전 사용자 — 사번 · 이름 · 부서 · 배정 라인</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">TOTAL USERS</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">PRODUCTION</div><div class="ames-kpi-v">@_rows.Count(u => u.Department == "Production")</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">QUALITY</div><div class="ames-kpi-v">@_rows.Count(u => u.Department == "Quality")</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h">▼ ALL USERS</div>
    @if (_rows.Count == 0)
    {
        <div class="ames-empty">No users.</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr><th>Emp No</th><th>Name</th><th>Department</th><th>Shift</th><th>Assigned Lines</th></tr>
            </thead>
            <tbody>
                @foreach (var u in _rows.OrderBy(x => x.EmployeeNo))
                {
                    <tr>
                        <td class="code">@u.EmployeeNo</td>
                        <td>@u.EmployeeName</td>
                        <td class="dim">@u.Department</td>
                        <td class="dim">@u.DefaultShift</td>
                        <td class="dim">@(u.AssignedLinesJson ?? "(all)")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Contracts.Dto.EmployeeProfileDto> _rows = new();
    protected override void OnInitialized()
    {
        try { _rows = Auth.ListAllProfiles(); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[SYS-01] {ex.Message}"); }
    }
}
