@page "/sys/users"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.SysRepository Sys
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Data.Repositories.AuthRepository AuthRepo
@inject UserManager<ApplicationUser> UserMgr
@inject RoleManager<IdentityRole> RoleMgr
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-001 @L["SYS.Users.Title"] · AMES</PageTitle>

<AmesPageHeader Code="SYS-001" TitleKey="SYS.Users.Title" />

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["SYS.Users.Kpi.Users"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["SYS.Users.Kpi.Verified"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.EmailConfirmed)</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">@L["SYS.Users.Kpi.Locked"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.LockedOut || r.AccountStatus == "LOCKED")</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["SYS.Users.Kpi.RecentLogin"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.LastLoginTs.HasValue && (DateTime.Now - r.LastLoginTs.Value).TotalHours <= 24)</div></div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["SYS.Users.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:300px;padding:4px 8px;"
                   placeholder="@L["SYS.Users.Ph.UserName"]" @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <select class="ames-input" style="width:120px;padding:4px 8px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _statusItems.Where(s => s.UseFlag))
                { <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option> }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["SYS.Users.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["SYS.Users.Col.UserName"]</th><th>@L["SYS.Users.Col.Email"]</th><th>@L["SYS.Users.Col.EmployeeNo"]</th><th>@L["SYS.Users.Col.EmployeeName"]</th>
                    <th>@L["SYS.Users.Col.Dept"]</th><th>@L["Col.Status"]</th><th>@L["SYS.Users.Col.Roles"]</th>
                    <th class="num">@L["SYS.Users.Col.FailCount"]</th><th>@L["SYS.Users.Col.LastLogin"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(u)">
                        <td class="code">@(u.UserName ?? "—")</td>
                        <td class="dim">@(u.Email ?? "—")</td>
                        <td class="dim">@(u.EmployeeNo ?? "—")</td>
                        <td>@(u.EmployeeName ?? "—")</td>
                        <td class="dim">@DeptName(u.Department)</td>
                        <td>
                            @{
                                var stEff = EffectiveStatus(u);
                                var unver = !u.EmailConfirmed && stEff == "Active";
                                var stCls = unver ? "warn" : stEff switch { "LOCKED" => "bad", "INACTIVE" => "dim", _ => "ok" };
                                var stLbl = unver ? L["SYS.Users.Status.Unverified"].Value : StatusName(stEff);
                            }
                            <span class="pill @stCls">@stLbl</span>
                        </td>
                        <td class="dim">@(u.RolesCsv ?? "—")</td>
                        <td class="num">@u.FailedLoginCount</td>
                        <td class="dim">@(u.LastLoginTs?.ToString("MM-dd HH:mm") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Users.Modal.Create"]</div>

            @* Chrome 자동완성/비밀번호 관리자 억제용 더미 필드 *@
            <input type="text"     style="display:none" autocomplete="username" />
            <input type="password" style="display:none" autocomplete="new-password" />

            <label>Email *</label>
            <input class="ames-input" @bind="_f.Email" placeholder="user@ames.local" autocomplete="off" />

            <label>@L["SYS.Users.Lbl.Password"]</label>
            <input class="ames-input" type="password" @bind="_f.Password" placeholder="@L["SYS.Users.Ph.Password"]" autocomplete="new-password" />

            <label>@L["SYS.Users.Lbl.EmployeeNo"]</label>
            <input class="ames-input" @bind="_f.EmployeeNo" placeholder="EMP001" autocomplete="off" />

            <label>@L["SYS.Users.Lbl.EmployeeName"]</label>
            <input class="ames-input" @bind="_f.EmployeeName" placeholder='@L["SYS.Users.Ph.Name"]' autocomplete="off" />

            <label>@L["SYS.Users.Lbl.Dept"]</label>
            <select class="ames-input" @bind="_f.Department">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var o in _deptOptions) { <option value="@o.Value">@o.Display</option> }
            </select>

            <label>@L["SYS.Users.Lbl.Plant"]</label>
            <select class="ames-input" @bind="_f.PlantCode">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var o in _plantOptions) { <option value="@o.Value">@o.Display</option> }
            </select>

            <label>@L["SYS.Users.Lbl.DefaultShift"]</label>
            <select class="ames-input" @bind="_f.DefaultShift">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var o in _shiftOptions) { <option value="@o.Value">@o.Display</option> }
            </select>

            <label>@L["SYS.Users.Lbl.Role"]</label>
            <select class="ames-input"
                    value="@_f.Role"
                    @onchange="e => _f.Role = e.Value?.ToString() ?? string.Empty">
                <option value="">@L["SYS.Users.Opt.NoRole"]</option>
                @foreach (var r in _roles) { <option value="@r">@r</option> }
            </select>

            <label>@L["SYS.Users.Lbl.Lines"] <span style="font-weight:400;color:#64748b;">@L["SYS.Users.Hint.Lines"]</span></label>
            <div class="ames-line-picker">
                @if (_lines.Count == 0)
                { <span class="dim" style="font-size:.8em;">@L["SYS.Users.Lbl.NoLines"]</span> }
                @foreach (var ln in _lines)
                {
                    <label class="ames-line-item">
                        <input type="checkbox"
                               checked="@_f.SelectedLines.Contains(ln.LineId)"
                               @onchange="e => ToggleLine(ln.LineId, (bool)e.Value!)" />
                        <span class="code">@ln.LineId</span>
                        <span class="dim">@ln.LineName</span>
                    </label>
                }
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">
                    @(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])
                </button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal — 행 클릭 시 바로 수정 폼 열림 ───────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Users.Modal.Edit"] — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.Email</span></div>

            @* Chrome 자동완성/비밀번호 관리자 억제용 더미 필드 *@
            <input type="text"     style="display:none" autocomplete="username" />
            <input type="password" style="display:none" autocomplete="new-password" />

            <label>@L["SYS.Users.Lbl.EmployeeNo"]</label>
            <input class="ames-input" @bind="_f.EmployeeNo" autocomplete="off" />

            <label>@L["SYS.Users.Lbl.EmployeeName"]</label>
            <input class="ames-input" @bind="_f.EmployeeName" autocomplete="off" />

            <label>@L["SYS.Users.Lbl.Dept"]</label>
            <select class="ames-input" @bind="_f.Department">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var o in _deptOptions) { <option value="@o.Value">@o.Display</option> }
            </select>

            <label>@L["SYS.Users.Lbl.Plant"]</label>
            <select class="ames-input" @bind="_f.PlantCode">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var o in _plantOptions) { <option value="@o.Value">@o.Display</option> }
            </select>

            <label>@L["SYS.Users.Lbl.DefaultShift"]</label>
            <select class="ames-input" @bind="_f.DefaultShift">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var o in _shiftOptions) { <option value="@o.Value">@o.Display</option> }
            </select>

            <label>@L["SYS.Users.Lbl.AccountStatus"]</label>
            @if (_sel!.AccountStatus == "LOCKED")
            {
                <div class="ames-alert bad" style="padding:5px 10px;margin-bottom:4px;font-size:.85em;">
                    🔒 @L["SYS.Users.Locked.Domain"] · @L["SYS.Users.Col.FailCount"]: @_sel.FailedLoginCount
                </div>
            }
            <select class="ames-input" @bind="_f.AccountStatus">
                @if (_sel!.AccountStatus == "LOCKED")
                {
                    <option value="LOCKED" disabled>🔒 @StatusName("LOCKED")</option>
                }
                @foreach (var s in _statusItems.Where(s => s.UseFlag && (_sel!.AccountStatus != "LOCKED" || s.CodeValue != "LOCKED")))
                { <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option> }
            </select>

            <label>@L["SYS.Users.Lbl.Role"]</label>
            <select class="ames-input"
                    value="@_f.Role"
                    @onchange="e => _f.Role = e.Value?.ToString() ?? string.Empty">
                <option value="">@L["SYS.Users.Opt.NoRole"]</option>
                @foreach (var r in _roles) { <option value="@r">@r</option> }
            </select>

            <label>@L["SYS.Users.Lbl.Lines"] <span style="font-weight:400;color:#64748b;">@L["SYS.Users.Hint.Lines"]</span></label>
            <div class="ames-line-picker">
                @if (_lines.Count == 0)
                { <span class="dim" style="font-size:.8em;">@L["SYS.Users.Lbl.NoLines"]</span> }
                @foreach (var ln in _lines)
                {
                    <label class="ames-line-item">
                        <input type="checkbox"
                               checked="@_f.SelectedLines.Contains(ln.LineId)"
                               @onchange="e => ToggleLine(ln.LineId, (bool)e.Value!)" />
                        <span class="code">@ln.LineId</span>
                        <span class="dim">@ln.LineName</span>
                    </label>
                }
            </div>

            <label>@L["SYS.Users.Lbl.NewPassword"]</label>
            <input class="ames-input" type="password" @bind="_f.Password" placeholder="@L["SYS.Users.Ph.NewPassword"]" autocomplete="new-password" />

            @if (_sel.LockedOut)
            {
                <div style="margin-top:6px;">
                    <button class="ames-btn warn" @onclick="UnlockUser">🔓 @L["SYS.Users.Unlock"]</button>
                </div>
            }
            @if (_sel.AccountStatus == "LOCKED")
            {
                <div style="margin-top:6px;">
                    <button class="ames-btn warn" @onclick="UnlockDomainAccount">🔓 @L["SYS.Users.Unlock.Domain"]</button>
                </div>
            }

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">
                        @(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit" disabled="@_busy">
                    @(_busy ? @L["Msg.Saving"] : @L["Btn.Save"])
                </button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    int _page = 0;
    const int _pageSize = 20;
    List<AMES.Data.Repositories.SysRepository.UserRow> _allRows = new();
    List<AMES.Data.Repositories.SysRepository.UserRow> _rows    = new();
    List<string> _roles = new();
    List<AMES.Data.Repositories.SysRepository.LineRow> _lines = new();
    List<CodeOption> _deptOptions  = new();
    List<CodeOption> _plantOptions = new();
    List<CodeOption> _shiftOptions = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _statusItems = new();
    Dictionary<string, string> _deptSearchNames = new(); // dept code → "CodeName CodeNameEn"
    AMES.Data.Repositories.SysRepository.UserRow? _sel;

    string _fSearch = "", _fStatus = "";

    string _modal = "";   // "" | "create" | "edit"
    bool _busy;
    bool _confirmDelete;
    bool _bgMouseDownOnSelf;   // backdrop mousedown 발생 위치 추적
    string _msg = "", _modalErr = "";
    bool _isErr;

    FormModel _f = new();
    string _actorEmail = "system";

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actorEmail = auth.User.Identity?.Name ?? "system";
        _roles = RoleMgr.Roles.Select(r => r.Name!).OrderBy(n => n).ToList();
        _lines = Sys.ListActiveLines();
        var deptItems  = MD.ListCodeItems("Department").ToList();
        _deptOptions   = ToOptions(deptItems);
        _deptSearchNames = deptItems
            .Where(c => c.UseFlag && !string.IsNullOrWhiteSpace(c.CodeValue))
            .ToDictionary(c => c.CodeValue!, c => $"{c.CodeName ?? ""} {c.CodeNameEn ?? ""}");
        _plantOptions  = ToOptions(MD.ListCodeItems("Plant"));
        _shiftOptions  = ToOptions(MD.ListCodeItems("WORK_SHIFT"));
        _statusItems   = MD.ListCodeItems("USER_STATUS");
        Reload();
    }

    void Reload() { _allRows = Sys.ListUsers(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.UserName     ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.Email        ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EmployeeNo   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EmployeeName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (_deptSearchNames.GetValueOrDefault(r.Department ?? "") ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fStatus) || MatchStatus(r, _fStatus))
    ).ToList(); }

    static string EffectiveStatus(AMES.Data.Repositories.SysRepository.UserRow r) =>
        (r.LockedOut || r.AccountStatus == "LOCKED") ? "LOCKED" : (r.AccountStatus ?? "Active");

    static bool MatchStatus(AMES.Data.Repositories.SysRepository.UserRow r, string s) =>
        EffectiveStatus(r) == s;

    string DeptName(string? code)
    {
        if (string.IsNullOrEmpty(code)) return "—";
        var opt = _deptOptions.FirstOrDefault(o => o.Value == code);
        if (opt is null) return code;
        var idx = opt.Display.IndexOf("] ");
        return idx >= 0 ? opt.Display[(idx + 2)..] : opt.Display;
    }

    string StatusName(string? code)
    {
        if (string.IsNullOrEmpty(code)) return "—";
        var found = _statusItems.FirstOrDefault(s => s.CodeValue == code);
        return found is null ? code : MasterDataRepository.LocalName(found);
    }

    void OpenCreate()
    {
        _f = new(); _modalErr = ""; _confirmDelete = false;
        _modal = "create";
    }

    void OpenEdit(AMES.Data.Repositories.SysRepository.UserRow u)
    {
        _sel = u; _modalErr = ""; _confirmDelete = false;
        List<string> parsedLines = new();
        if (!string.IsNullOrEmpty(u.AssignedLines))
        {
            try { parsedLines = System.Text.Json.JsonSerializer.Deserialize<List<string>>(u.AssignedLines) ?? new(); }
            catch { parsedLines = new(); }
        }

        _f = new()
        {
            EmployeeNo    = u.EmployeeNo    ?? "",
            EmployeeName  = u.EmployeeName  ?? "",
            Department    = u.Department    ?? "",
            PlantCode     = u.PlantCode     ?? "",
            DefaultShift  = u.DefaultShift  ?? "",
            AccountStatus = u.AccountStatus ?? "Active",
            Role          = u.RolesCsv?.Split(',').FirstOrDefault()?.Trim() ?? "",
            SelectedLines = parsedLines
        };
        _modal = "edit";
    }

    void CloseModal()
    {
        _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false;
    }

    // backdrop에서 mousedown이 시작됐을 때만 click으로 닫힘 허용.
    // Chrome 자동완성 팝업 닫힘 등 외부 이벤트로 인한 오닫힘 방지.
    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick()
    {
        if (_bgMouseDownOnSelf) CloseModal();
        _bgMouseDownOnSelf = false;
    }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.Email))        { _modalErr = L["SYS.Users.Err.EmailRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.Password))     { _modalErr = L["SYS.Users.Err.PasswordRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.EmployeeNo))   { _modalErr = L["SYS.Users.Err.EmpNoRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.EmployeeName)) { _modalErr = L["SYS.Users.Err.NameRequired"]; return; }

        _busy = true;
        try
        {
            var user = new ApplicationUser { UserName = _f.Email, Email = _f.Email, EmailConfirmed = true };
            var result = await UserMgr.CreateAsync(user, _f.Password);
            if (!result.Succeeded)
            {
                _modalErr = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }

            var linesJson = _f.SelectedLines.Count > 0
                ? System.Text.Json.JsonSerializer.Serialize(_f.SelectedLines)
                : null;
            Sys.CreateProfile(user.Id, _f.EmployeeNo, _f.EmployeeName,
                _f.Department, _f.PlantCode, _f.DefaultShift, _actorEmail, linesJson);

            if (!string.IsNullOrEmpty(_f.Role))
                await UserMgr.AddToRoleAsync(user, _f.Role);

            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Users.Ok.Created"].Value, _f.Email), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EmployeeNo))   { _modalErr = L["SYS.Users.Err.EmpNoRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.EmployeeName)) { _modalErr = L["SYS.Users.Err.NameRequired"]; return; }

        _busy = true;
        try
        {
            var linesJson = _f.SelectedLines.Count > 0
                ? System.Text.Json.JsonSerializer.Serialize(_f.SelectedLines)
                : null;
            if (Sys.ProfileExists(_sel.UserId))
                Sys.UpdateProfile(_sel.UserId, _f.EmployeeNo, _f.EmployeeName,
                    _f.Department, _f.PlantCode, _f.DefaultShift, _f.AccountStatus, _actorEmail, linesJson);
            else
                Sys.CreateProfile(_sel.UserId, _f.EmployeeNo, _f.EmployeeName,
                    _f.Department, _f.PlantCode, _f.DefaultShift, _actorEmail, linesJson);

            if (!string.IsNullOrWhiteSpace(_f.Password))
            {
                var u = await UserMgr.FindByIdAsync(_sel.UserId);
                if (u is not null)
                {
                    await UserMgr.RemovePasswordAsync(u);
                    var pr = await UserMgr.AddPasswordAsync(u, _f.Password);
                    if (!pr.Succeeded)
                    {
                        _modalErr = string.Join(" ", pr.Errors.Select(e => e.Description));
                        return;
                    }
                }
            }

            var iUser = await UserMgr.FindByIdAsync(_sel.UserId);
            if (iUser is not null)
            {
                var currentRoles = await UserMgr.GetRolesAsync(iUser);
                await UserMgr.RemoveFromRolesAsync(iUser, currentRoles);
                if (!string.IsNullOrEmpty(_f.Role))
                    await UserMgr.AddToRoleAsync(iUser, _f.Role);
            }

            var email = _sel.Email;
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Users.Ok.Updated"].Value, email), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            Sys.DeleteProfile(_sel.UserId);
            var u = await UserMgr.FindByIdAsync(_sel.UserId);
            if (u is not null) await UserMgr.DeleteAsync(u);

            var email = _sel.Email;
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Users.Ok.Deleted"].Value, email), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    async Task UnlockUser()
    {
        if (_sel is null) return;
        var u = await UserMgr.FindByIdAsync(_sel.UserId);
        if (u is null) return;
        await UserMgr.SetLockoutEndDateAsync(u, null);
        await UserMgr.ResetAccessFailedCountAsync(u);
        CloseModal(); Reload();
        ShowMsg(string.Format(L["SYS.Users.Ok.Unlocked"].Value, _sel.Email), false);
    }

    async Task UnlockDomainAccount()
    {
        if (_sel is null) return;
        AuthRepo.UnlockAccount(_sel.UserId, _actorEmail);
        var u = await UserMgr.FindByIdAsync(_sel.UserId);
        if (u is not null)
        {
            await UserMgr.SetLockoutEndDateAsync(u, null);
            await UserMgr.ResetAccessFailedCountAsync(u);
        }
        var email = _sel.Email;
        CloseModal(); Reload();
        ShowMsg(string.Format(L["SYS.Users.Ok.DomainUnlocked"].Value, email), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    void ToggleLine(string lineId, bool check)
    {
        if (check) { if (!_f.SelectedLines.Contains(lineId)) _f.SelectedLines.Add(lineId); }
        else _f.SelectedLines.Remove(lineId);
    }

    class FormModel
    {
        public string       Email         { get; set; } = "";
        public string       Password      { get; set; } = "";
        public string       EmployeeNo    { get; set; } = "";
        public string       EmployeeName  { get; set; } = "";
        public string       Department    { get; set; } = "";
        public string       PlantCode     { get; set; } = "";
        public string       DefaultShift  { get; set; } = "";
        public string       AccountStatus { get; set; } = "Active";
        public string       Role          { get; set; } = "";
        public List<string> SelectedLines { get; set; } = new();
    }

    static string OptionName(CodeOption o)
    {
        var idx = o.Display.IndexOf("] ");
        return idx >= 0 ? o.Display[(idx + 2)..] : o.Display;
    }

    // 현재 UI 언어에 맞게 "[CodeValue] 이름" 형태의 표시 텍스트를 생성
    static List<CodeOption> ToOptions(IEnumerable<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> rows)
    {
        return rows
            .Where(c => c.UseFlag && !string.IsNullOrWhiteSpace(c.CodeValue))
            .Select(c => new CodeOption(c.CodeValue!, $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}"))
            .ToList();
    }

    record CodeOption(string Value, string Display);
}
