@page "/sys/roles"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject RoleManager<IdentityRole> RoleMgr
@inject AMES.Data.Repositories.SysRepository Sys
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>SYS-002 @L["SYS.Roles.Title"] · AMES</PageTitle>

<AmesPageHeader Code="SYS-002" TitleKey="SYS.Roles.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Roles.Kpi.Roles"]</div>
        <div class="ames-kpi-v">@_rows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Roles.Kpi.Assigned"]</div>
        <div class="ames-kpi-v">@_rows.Count(r => r.UserCount > 0)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["SYS.Roles.Kpi.Unused"]</div>
        <div class="ames-kpi-v">@_rows.Count(r => r.UserCount == 0)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;">
        <span>▼ @L["SYS.Roles.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <div style="display:flex;gap:6px;">
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["SYS.Roles.Empty"]</div>
    }
    else
    {
        <RadzenStack Gap="1rem">
            <RadzenDataGrid TItem="AMES.Data.Repositories.SysRepository.RoleRow" Data="@_rows" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@pageSizeOptions" ShowPagingSummary="@showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" Class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.RoleRow" Property="RoleName" Title="@L["Col.RoleName"]">
                        <Template Context="r">
                            <span class="code">@(r.RoleName ?? "—")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AMES.Data.Repositories.SysRepository.RoleRow" Property="UserCount" Title="@L["Col.UserCount"]" TextAlign="TextAlign.Right">
                        <Template Context="r">
                            @if (r.UserCount > 0)
                            {
                                <span class="pill ok">@r.UserCount</span>
                            }
                            else
                            {

                                <span class="dim">0</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Roles.Modal.Create"]</div>

            <label>@L["SYS.Roles.Lbl.RoleName"]</label>
            <input class="ames-input" @bind="_roleName" placeholder="@L["SYS.Roles.Ph.RoleName"]" autocomplete="off" />

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">
                    @(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)
                </button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Roles.Modal.Edit"] — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.RoleName</span></div>

            <label>@L["SYS.Roles.Lbl.RoleName"]</label>
            <input class="ames-input" @bind="_roleName" autocomplete="off" />

            @if (_sel.UserCount > 0)
            {
                <div style="font-size:.82em;color:#94a3b8;margin-top:4px;">
                    @L["SYS.Roles.InUseBy"] <strong style="color:#fbbf24;">@_sel.UserCount @L["Lbl.Persons"]</strong>
                </div>
            }

            @* 삭제 인라인 확인 *@
            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    @if (_sel.UserCount > 0)
                    {
                        <span>@string.Format(L["SYS.Roles.ConfirmDeleteInUse"].Value, _sel.UserCount)</span>
                    }
                    else
                    {
                        <span>@L["Msg.Confirm.Delete"]</span>
                    }
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">
                        @(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit" disabled="@_busy">
                    @(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)
                </button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    IEnumerable<int> pageSizeOptions = new int[] { 10, 15, 20, 30, 50, 100 };
    bool showPagerSummary = true;
    List<AMES.Data.Repositories.SysRepository.RoleRow> _rows = new();
    AMES.Data.Repositories.SysRepository.RoleRow? _sel;

    string _modal = "";   // "" | "create" | "edit"
    string _roleName = "";
    bool _busy;
    bool _confirmDelete;
    bool _bgMouseDownOnSelf;
    bool _canEdit;
    string _msg = "", _modalErr = "";
    bool _isErr;

    protected override async Task OnInitializedAsync()
    {
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("sys/roles");
        Reload();
    }

    void Reload() { _rows = Sys.ListRoles(); }

    void OpenCreate()
    {
        _roleName = ""; _modalErr = ""; _confirmDelete = false;
        _modal = "create";
    }

    void RowRender(RowRenderEventArgs<AMES.Data.Repositories.SysRepository.RoleRow> args)
    {
        args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<AMES.Data.Repositories.SysRepository.RoleRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenEdit(AMES.Data.Repositories.SysRepository.RoleRow r)
    {
        if (!_canEdit) return;
        _sel = r; _roleName = r.RoleName; _modalErr = ""; _confirmDelete = false;
        _modal = "edit";
    }

    void CloseModal()
    {
        _modal = ""; _sel = null; _roleName = ""; _modalErr = ""; _confirmDelete = false;
    }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick()
    {
        if (_bgMouseDownOnSelf) CloseModal();
        _bgMouseDownOnSelf = false;
    }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_roleName)) { _modalErr = L["SYS.Roles.Err.NameRequired"]; return; }

        _busy = true;
        try
        {
            var result = await RoleMgr.CreateAsync(new IdentityRole(_roleName.Trim()));
            if (!result.Succeeded)
            {
                _modalErr = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }
            var name = _roleName.Trim();
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Roles.Ok.Created"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_roleName)) { _modalErr = L["SYS.Roles.Err.NameRequired"]; return; }

        _busy = true;
        try
        {
            var role = await RoleMgr.FindByIdAsync(_sel.RoleId);
            if (role is null) { _modalErr = L["SYS.Roles.Err.NotFound"]; return; }

            role.Name = _roleName.Trim();
            var result = await RoleMgr.UpdateAsync(role);
            if (!result.Succeeded)
            {
                _modalErr = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }
            var name = _roleName.Trim();
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Roles.Ok.Updated"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var role = await RoleMgr.FindByIdAsync(_sel.RoleId);
            if (role is not null) await RoleMgr.DeleteAsync(role);

            var name = _sel.RoleName;
            CloseModal(); Reload();
            ShowMsg(string.Format(L["SYS.Roles.Ok.Deleted"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
