@page "/sys/roles"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject SysRepository Sys
@inject RoleManager<IdentityRole> RoleMgr
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-002 @L["SYS.Roles.Title"] · AMES</PageTitle>
<AmesPageHeader Code="SYS-002" TitleKey="SYS.Roles.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Roles.Kpi.Roles"]</div>
        <div class="ames-kpi-v">@_rows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Roles.Kpi.Assigned"]</div>
        <div class="ames-kpi-v">@_rows.Count(r => r.UserCount > 0)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["SYS.Roles.Kpi.Unused"]</div>
        <div class="ames-kpi-v">@_rows.Count(r => r.UserCount == 0)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["SYS.Roles.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="SysRepository.RoleRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["SYS.Roles.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="SysRepository.RoleRow" Property="RoleName" Title="@L["Col.RoleName"]">
                <Template Context="r"><span class="code">@(r.RoleName ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.RoleRow" Property="UserCount" Title="@L["Col.UserCount"]" TextAlign="TextAlign.Right">
                <Template Context="r">
                    @if (r.UserCount > 0)
                    {
                        <span class="pill ok">@r.UserCount</span>
                    }
                    else
                    {

                        <span class="dim">0</span>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Roles.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Roles.Lbl.RoleName"]" class="ames-rz-modal-label" Component="CreateTextBoxRoleName" />
                    <RadzenTextBox Name="CreateTextBoxRoleName" @bind-Value="_roleName" Placeholder="@L["SYS.Roles.Ph.RoleName"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Roles.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.RoleName</span></div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Roles.Lbl.RoleName"]" class="ames-rz-modal-label" Component="EditTextBoxRoleName" />
                    <RadzenTextBox Name="EditTextBoxRoleName" @bind-Value="_roleName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                @if (_sel.UserCount > 0)
                {
                    <div style="font-size:.82em;color:#94a3b8;">
                        @L["SYS.Roles.InUseBy"] <strong style="color:#fbbf24;">@_sel.UserCount @L["Lbl.Persons"]</strong>
                    </div>
                }
            </RadzenStack>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    @if (_sel.UserCount > 0)
                    {
                        <span>@string.Format(L["SYS.Roles.ConfirmDeleteInUse"].Value, _sel.UserCount)</span>
                    }
                    else
                    {
                        <span>@L["Msg.Confirm.Delete"]</span>
                    }
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<SysRepository.RoleRow> _rows = new();
    SysRepository.RoleRow? _sel;

    string _modal = "";   // "" | "create" | "edit"
    string _roleName = "";
    bool _busy;
    bool _confirmDelete;
    bool _bgMouseDownOnSelf;
    bool _canEdit;
    string _msg = "", _modalErr = "";
    bool _isErr;

    protected override async Task OnInitializedAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("sys/roles");
        Reload();
    }

    RadzenDataGrid<SysRepository.RoleRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _rows = Sys.ListRoles(); }

    void OpenCreate()
    {
        _roleName = ""; _modalErr = ""; _confirmDelete = false;
        _modal = "create";
    }

    void RowRender(RowRenderEventArgs<SysRepository.RoleRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<SysRepository.RoleRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenEdit(SysRepository.RoleRow r)
    {
        if (!_canEdit) return;
        _sel = r; _roleName = r.RoleName; _modalErr = ""; _confirmDelete = false;
        _modal = "edit";
    }

    void CloseModal()
    {
        _modal = ""; _sel = null; _roleName = ""; _modalErr = ""; _confirmDelete = false;
    }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick()
    {
        if (_bgMouseDownOnSelf) CloseModal();
        _bgMouseDownOnSelf = false;
    }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_roleName)) { _modalErr = L["SYS.Roles.Err.NameRequired"]; return; }

        _busy = true;
        try
        {
            var result = await RoleMgr.CreateAsync(new IdentityRole(_roleName.Trim()));
            if (!result.Succeeded)
            {
                _modalErr = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }
            var name = _roleName.Trim();
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["SYS.Roles.Ok.Created"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_roleName)) { _modalErr = L["SYS.Roles.Err.NameRequired"]; return; }

        _busy = true;
        try
        {
            var role = await RoleMgr.FindByIdAsync(_sel.RoleId);
            if (role is null) { _modalErr = L["SYS.Roles.Err.NotFound"]; return; }

            role.Name = _roleName.Trim();
            var result = await RoleMgr.UpdateAsync(role);
            if (!result.Succeeded)
            {
                _modalErr = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }
            var name = _roleName.Trim();
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["SYS.Roles.Ok.Updated"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var role = await RoleMgr.FindByIdAsync(_sel.RoleId);
            if (role is not null) await RoleMgr.DeleteAsync(role);

            var name = _sel.RoleName;
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["SYS.Roles.Ok.Deleted"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}