@page "/sys/screens"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject SysRepository Sys
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>SYS-003 @L["SYS.Screen.Title"] · AMES</PageTitle>
<AmesPageHeader Code="SYS-003" TitleKey="SYS.Screen.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["SYS.Screen.Kpi.All"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["SYS.Screen.Kpi.Visible"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.IsVisible)</div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">@L["SYS.Screen.Kpi.Hidden"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => !r.IsVisible)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["SYS.Screen.Kpi.Restricted"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RoleCount > 0)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["SYS.Screen.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["SYS.Screen.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Module"]" Component="DropDownModule" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownModule" @bind-Value="_fModule" Data="@ModuleOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenLabel Text="@L["Col.Process"]" Component="DropDownProcess" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownProcess" @bind-Value="_fProcess" Data="@ProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Lbl.Visible"]" Component="DropDownVisible" />
            <RadzenDropDown Name="DropDownVisible" @bind-Value="_fVisible" Data="@VisibleList" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="SysRepository.ScreenRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["SYS.Screen.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="ScreenCode" Title="@L["SYS.Screen.Col.Code"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r"><span class="code">@r.ScreenCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="ModuleCode" Title="@L["Col.Module"]" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="r"><span class="pill info">@r.ModuleCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="ProcessCode" Title="@L["Col.Process"]" Width="140px">
                <Template Context="r">
                    @if (r.ProcessCode != null)
                    {
                        var procName = _processItems.FirstOrDefault(c2 => c2.CodeValue == r.ProcessCode) is { } pf ? MasterDataRepository.LocalName(pf) : null;
                        <span class="pill @Ui.ProcessClass(r.ProcessCode)">@r.ProcessCode</span>
                        @if (procName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@procName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="SubProcessCode" Title="@L["Col.SubProcess"]" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="r">
                    @if (r.SubProcessCode is not null)
                    { <span class="pill" style="background:rgba(134,239,172,.12);color:#86efac;">@r.SubProcessCode</span> }
                    else
                    { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="ScreenName" Title="@L["SYS.Screen.Col.NameKo"]" />
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="ScreenNameEn" Title="@L["SYS.Screen.Col.NameEn"]">
                <Template Context="r"><span class="dim" style="font-size:12px;">@(r.ScreenNameEn ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="HRef" Title="@L["SYS.Screen.Col.Path"]">
                <Template Context="r"><span class="dim" style="font-size:12px;font-family:'JetBrains Mono',monospace;">@(r.HRef ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="LidLabel" Title="@L["SYS.Screen.Col.LidLabel"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="dim code" style="font-size:12px;">@(r.LidLabel ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="SortOrder" Title="@L["SYS.Screen.Col.SortOrder"]" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="r"><span class="dim">@(r.SortOrder?.ToString() ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="IsVisible" Title="@L["SYS.Screen.Col.Visible"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r">
                    @if (r.IsVisible) { <span class="pill ok">@L["SYS.Screen.Filter.Visible"]</span> }
                    else { <span class="pill bad">@L["SYS.Screen.Filter.Hidden"]</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SysRepository.ScreenRow" Property="RoleCount" Title="@L["SYS.Screen.Col.Roles"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r">
                    @if (r.RoleCount > 0) { <span class="pill warn">@r.RoleCount @L["SYS.Screen.Col.Roles"]</span> }
                    else { <span class="dim">@L["Filter.All"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Screen.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@(L["SYS.Screen.Col.Code"].Value + " *")" class="ames-rz-modal-label" Component="CreateTextBoxScreenCode" />
                    <RadzenTextBox Name="CreateTextBoxScreenCode" @bind-Value="_f.ScreenCode" Placeholder="@L["SYS.Screen.Ph.Code"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@(L["Col.Module"].Value + " *")" class="ames-rz-modal-label" Component="CreateDropDownModuleCode" />
                    <RadzenDropDown AllowFiltering="true" Name="CreateDropDownModuleCode" @bind-Value="_f.ModuleCode" Data="@ModuleOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Process"]" class="ames-rz-modal-label" Component="CreateDropDownProcessCode" />
                    <RadzenDropDown AllowFiltering="true" Name="CreateDropDownProcessCode" @bind-Value="_f.ProcessCode" Data="@ProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.SubProcess"]" class="ames-rz-modal-label" Component="CreateDropDownSubProcessCode" />
                    <RadzenDropDown AllowFiltering="true" Name="CreateDropDownSubProcessCode" @bind-Value="_f.SubProcessCode" Data="@SubProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.None"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@(L["SYS.Screen.Col.NameKo"].Value + " *")" class="ames-rz-modal-label" Component="CreateTextBoxScreenNameKo" />
                    <RadzenTextBox Name="CreateTextBoxScreenNameKo" @bind-Value="_f.ScreenName" Placeholder="@L["SYS.Screen.Ph.NameKo"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Screen.Col.NameEn"]" class="ames-rz-modal-label" Component="CreateTextBoxScreenNameEn" />
                    <RadzenTextBox Name="CreateTextBoxScreenNameEn" @bind-Value="_f.ScreenNameEn" Placeholder="@L["SYS.Screen.Ph.NameEn"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Screen.Col.Path"]" class="ames-rz-modal-label" Component="CreateTextBoxHRef" />
                    <RadzenTextBox Name="CreateTextBoxHRef" @bind-Value="_f.HRef" Placeholder="@L["SYS.Screen.Ph.HRef"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Screen.Col.LidLabel"]" class="ames-rz-modal-label" Component="CreateTextBoxLidLabel" />
                    <RadzenTextBox Name="CreateTextBoxLidLabel" @bind-Value="_f.LidLabel" Placeholder="@L["SYS.Screen.Ph.LidLabel"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Screen.Col.SortOrder"]" class="ames-rz-modal-label" Component="CreateTextBoxSortOrder" />
                    <RadzenTextBox Name="CreateTextBoxSortOrder" @bind-Value="_f.SortOrderStr" Placeholder="@L["SYS.Screen.Ph.SortOrder"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.IsVisible" Name="CreateChkVisible" />
                    <RadzenLabel Text="@($"{L["SYS.Screen.Col.Visible"]} {L["SYS.Screen.Lbl.NavMenu"]}")" Component="CreateChkVisible" style="cursor:pointer;" />
                </RadzenStack>
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["SYS.Screen.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.ScreenCode</span></div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@(L["SYS.Screen.Col.Code"].Value + " *")" class="ames-rz-modal-label" Component="EditTextBoxScreenCode" />
                    <RadzenTextBox Name="EditTextBoxScreenCode" @bind-Value="_f.ScreenCode" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@(L["Col.Module"].Value + " *")" class="ames-rz-modal-label" Component="EditDropDownModuleCode" />
                    <RadzenDropDown AllowFiltering="true" Name="EditDropDownModuleCode" @bind-Value="_f.ModuleCode" Data="@ModuleOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Process"]" class="ames-rz-modal-label" Component="EditDropDownProcessCode" />
                    <RadzenDropDown AllowFiltering="true" Name="EditDropDownProcessCode" @bind-Value="_f.ProcessCode" Data="@ProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.SubProcess"]" class="ames-rz-modal-label" Component="EditDropDownSubProcessCode" />
                    <RadzenDropDown AllowFiltering="true" Name="EditDropDownSubProcessCode" @bind-Value="_f.SubProcessCode" Data="@SubProcessOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.None"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@(L["SYS.Screen.Col.NameKo"].Value + " *")" class="ames-rz-modal-label" Component="EditTextBoxScreenNameKo" />
                    <RadzenTextBox Name="EditTextBoxScreenNameKo" @bind-Value="_f.ScreenName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Screen.Col.NameEn"]" class="ames-rz-modal-label" Component="EditTextBoxScreenNameEn" />
                    <RadzenTextBox Name="EditTextBoxScreenNameEn" @bind-Value="_f.ScreenNameEn" Placeholder="@L["SYS.Screen.Ph.NameEn"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Screen.Col.Path"]" class="ames-rz-modal-label" Component="EditTextBoxHRef" />
                    <RadzenTextBox Name="EditTextBoxHRef" @bind-Value="_f.HRef" Placeholder="@L["SYS.Screen.Ph.HRef"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Screen.Col.LidLabel"]" class="ames-rz-modal-label" Component="EditTextBoxLidLabel" />
                    <RadzenTextBox Name="EditTextBoxLidLabel" @bind-Value="_f.LidLabel" Placeholder="@L["SYS.Screen.Ph.LidLabelEdit"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenLabel Text="@L["SYS.Screen.Col.SortOrder"]" class="ames-rz-modal-label" Component="EditTextBoxSortOrder" />
                    <RadzenTextBox Name="EditTextBoxSortOrder" @bind-Value="_f.SortOrderStr" Placeholder="@L["SYS.Screen.Ph.SortOrder"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.IsVisible" Name="EditChkVisible" />
                    <RadzenLabel Text="@($"{L["SYS.Screen.Col.Visible"]} {L["SYS.Screen.Lbl.NavMenu"]}")" Component="EditChkVisible" style="cursor:pointer;" />
                </RadzenStack>
            </RadzenStack>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<SysRepository.ScreenRow> _allRows      = new();
    List<SysRepository.ScreenRow> _rows         = new();
    List<MasterDataRepository.CodeItemRow> _moduleItems      = new();
    List<MasterDataRepository.CodeItemRow> _processItems    = new();
    List<MasterDataRepository.CodeItemRow> _subprocessItems = new();
    SysRepository.ScreenRow? _sel;

    string _fSearch = "", _fModule = "", _fProcess = "", _fVisible = "";
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ModuleOptions     => _moduleItems.Where(m => m.UseFlag).Select(m => new DropDownItem { Value = m.CodeValue ?? "", Text = $"[{m.CodeValue}] {MasterDataRepository.LocalName(m)}" });
    private IEnumerable<DropDownItem> ProcessOptions    => _processItems.Where(p => p.UseFlag).Select(p => new DropDownItem { Value = p.CodeValue ?? "", Text = $"[{p.CodeValue}] {MasterDataRepository.LocalName(p)}" });
    private IEnumerable<DropDownItem> SubProcessOptions => _subprocessItems.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });
    private List<DropDownItem> VisibleList => new()
    {
        new() { Value = "Y", Text = L["SYS.Screen.Filter.Visible"].Value },
        new() { Value = "N", Text = L["SYS.Screen.Filter.Hidden"].Value }
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("sys/screens");
        _moduleItems      = MD.ListCodeItems("MODULE");
        _processItems    = MD.ListCodeItems("PROCESS");
        _subprocessItems = MD.ListCodeItems("SUBPROCESS");
        Reload();
    }

    RadzenDataGrid<SysRepository.ScreenRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _allRows = Sys.ListScreens(); ApplyFilter(); }

    void ApplyFilter() => _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.ScreenCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            r.ScreenName.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ScreenNameEn ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.HRef        ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fModule)  || r.ModuleCode  == _fModule) &&
        (string.IsNullOrEmpty(_fProcess) || r.ProcessCode == _fProcess) &&
        (string.IsNullOrEmpty(_fVisible) || (_fVisible == "Y" ? r.IsVisible : !r.IsVisible))
    ).OrderBy(r => r.ModuleCode).ThenBy(r => r.ProcessCode ?? "￿").ThenBy(r => r.ScreenCode).ToList();

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<SysRepository.ScreenRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<SysRepository.ScreenRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate()
    {
        _f = new() { ModuleCode = _moduleItems.FirstOrDefault()?.CodeValue ?? "", IsVisible = true };
        _modalErr = ""; _confirmDelete = false;
        _modal = "create";
    }

    void OpenEdit(SysRepository.ScreenRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            ScreenCode     = r.ScreenCode,
            ModuleCode     = r.ModuleCode,
            ProcessCode    = r.ProcessCode    ?? "",
            SubProcessCode = r.SubProcessCode ?? "",
            ScreenName     = r.ScreenName,
            ScreenNameEn   = r.ScreenNameEn  ?? "",
            HRef           = r.HRef           ?? "",
            LidLabel       = r.LidLabel       ?? "",
            SortOrderStr   = r.SortOrder?.ToString() ?? "",
            IsVisible      = r.IsVisible,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ScreenCode)) { _modalErr = L["SYS.Screen.Err.CodeRequired"].Value;   return; }
        if (string.IsNullOrWhiteSpace(_f.ModuleCode)) { _modalErr = L["SYS.Screen.Err.ModuleRequired"].Value; return; }
        if (string.IsNullOrWhiteSpace(_f.ScreenName)) { _modalErr = L["SYS.Screen.Err.NameRequired"].Value;   return; }
        _busy = true;
        try
        {
            Sys.InsertScreen(
                _f.ScreenCode.Trim(), _f.ModuleCode.Trim(), Nz(_f.ProcessCode),
                Nz(_f.SubProcessCode),
                _f.ScreenName.Trim(), Nz(_f.ScreenNameEn), Nz(_f.HRef), Nz(_f.LidLabel),
                _f.SortOrder, _f.IsVisible, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["SYS.Screen.Ok.Created"].Value, _f.ScreenCode), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ScreenCode)) { _modalErr = L["SYS.Screen.Err.CodeRequired"].Value;   return; }
        if (string.IsNullOrWhiteSpace(_f.ModuleCode)) { _modalErr = L["SYS.Screen.Err.ModuleRequired"].Value; return; }
        if (string.IsNullOrWhiteSpace(_f.ScreenName)) { _modalErr = L["SYS.Screen.Err.NameRequired"].Value;   return; }
        _busy = true;
        try
        {
            Sys.UpdateScreen(
                _sel.ScreenId, _f.ScreenCode.Trim(), _f.ModuleCode.Trim(), Nz(_f.ProcessCode),
                Nz(_f.SubProcessCode),
                _f.ScreenName.Trim(), Nz(_f.ScreenNameEn), Nz(_f.HRef), Nz(_f.LidLabel),
                _f.SortOrder, _f.IsVisible, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["SYS.Screen.Ok.Updated"].Value, _f.ScreenCode), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var code = _sel.ScreenCode;
            Sys.DeleteScreen(_sel.ScreenId, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["SYS.Screen.Ok.Deleted"].Value, code), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? Nz(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    class FormModel
    {
        public string ScreenCode     { get; set; } = "";
        public string ModuleCode     { get; set; } = "";
        public string ProcessCode    { get; set; } = "";
        public string SubProcessCode { get; set; } = "";
        public string ScreenName     { get; set; } = "";
        public string ScreenNameEn   { get; set; } = "";
        public string HRef           { get; set; } = "";
        public string LidLabel       { get; set; } = "";
        public string SortOrderStr   { get; set; } = "";
        public bool   IsVisible      { get; set; } = true;
        public int?   SortOrder      => int.TryParse(SortOrderStr, out var n) ? n : null;
    }
}
