@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MntRepository Mnt
@inject SysRepository Sys
@inject MasterDataRepository MD
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

@* ── PM 달력 본체 — MNT-005 설비 PM(EQUIP) · MNT-010 보전 PM(MAINT) 이 공유. 테이블은 MNT_PMSchedule 하나이고 PmClass 로만 나뉜다 ── *@

@* ── KPI strip (표시 중인 달 기준) ─────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MNT.PmSchedule.Kpi.Total"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_events.Count</div>
            <div class="ames-kpi-s">@string.Format(L["MNT.PmSchedule.Kpi.TotalSub"].Value, MonthTitle)</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["MNT.PmSchedule.Kpi.Completed"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@Count("pm-done")</div>
            <div class="ames-kpi-s">@L["MNT.PmSchedule.Kpi.CompletedSub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MNT.PmSchedule.Kpi.Upcoming"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@(Count("pm-planned") + Count("pm-today"))</div>
            <div class="ames-kpi-s">@L["MNT.PmSchedule.Kpi.UpcomingSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(Count("pm-overdue") > 0 ? "bad" : "ok")">
        <div class="ames-kpi-l">@L["MNT.PmSchedule.Kpi.Overdue"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@Count("pm-overdue")</div>
            <div class="ames-kpi-s">@L["MNT.PmSchedule.Kpi.OverdueSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(Compliance is null ? "" : Compliance >= 90 ? "ok" : Compliance >= 70 ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["MNT.PmSchedule.Kpi.Compliance"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@(Compliance is { } c ? $"{c:0}%" : "—")</div>
            <div class="ames-kpi-s">@L["MNT.PmSchedule.Kpi.ComplianceSub"]</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

@* ── 월간 달력 (Pp/Calendar.razor 월 보기 패턴) ────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <div style="display:flex;align-items:center;gap:10px;">
            <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@PrevMonth" class="ames-rz-btn" />
            <span style="font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:2px;color:#fff;">
                @MonthTitle
            </span>
            <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@NextMonth" class="ames-rz-btn" />
            <span class="pill mute">@PmClassName(PmClass)</span>
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="@L["PP.Calendar.Btn.Today"]" Icon="done" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@GoToday" class="ames-rz-btn" />
            <RadzenLabel Text="@L["Col.Equip"]" Component="DropDownEquip" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownEquip" @bind-Value="_fEquip" Data="@EquipOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:320px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>
    <div class="dim" style="font-size:10px;padding:0 0 6px;">@string.Format(L["MNT.PmSchedule.Hint.Class"].Value, PmClassName(PmClass))</div>

    @{
        var firstOfMonth = new DateTime(_calYear, _calMonth, 1);
        var daysInMonth  = DateTime.DaysInMonth(_calYear, _calMonth);
        int startOffset  = (int)firstOfMonth.DayOfWeek;
        int rows         = (int)Math.Ceiling((startOffset + daysInMonth) / 7.0);
    }

    <div class="ames-cal-grid pp-wo-grid">
        @foreach (var (key, cls) in new[] {
            ("PP.Calendar.Day.Sun","sun"),
            ("PP.Calendar.Day.Mon",""),
            ("PP.Calendar.Day.Tue",""),
            ("PP.Calendar.Day.Wed",""),
            ("PP.Calendar.Day.Thu",""),
            ("PP.Calendar.Day.Fri",""),
            ("PP.Calendar.Day.Sat","sat") })
        {
            <div class="ames-cal-head @cls">@L[key]</div>
        }

        @for (int cell = 0; cell < rows * 7; cell++)
        {
            int dayNum = cell - startOffset + 1;
            if (dayNum < 1 || dayNum > daysInMonth)
            {
                <div class="ames-cal-cell ames-cal-cell--empty"></div>
            }
            else
            {
                var date      = new DateTime(_calYear, _calMonth, dayNum);
                var evs       = GetEvents(date);
                int dow       = (int)date.DayOfWeek;
                bool isSun    = dow == 0;
                bool isSat    = dow == 6;
                bool isToday  = date.Date == DateTime.Today;
                var holiday   = HolidayName(date);

                string cellCls = "ames-cal-cell";
                if (isToday)           cellCls += " ames-cal-cell--today";
                if (evs.Count > 0)     cellCls += " ames-cal-cell--data";
                if (holiday is not null) cellCls += " ames-cal-cell--holiday";
                else if (isSat || isSun) cellCls += " ames-cal-cell--weekend";

                const int MaxChips = 3;
                <div class="@cellCls">
                    <div class="ames-cal-daynum @(isSun ? "sun" : isSat ? "sat" : "")">
                        @dayNum
                        @if (isToday) { <span class="ames-cal-today-dot"></span> }
                    </div>
                    @if (holiday is not null)
                    {
                        <div class="ames-cal-hname" title="@holiday">@holiday</div>
                    }
                    @foreach (var ev in evs.Take(MaxChips))
                    {
                        var capEv = ev;
                        <div class="ames-cal-wo @ev.Cls" title="@Tip(ev)" @onclick="() => ShowDetail(capEv)" @onclick:stopPropagation>
                            @ev.Label
                        </div>
                    }
                    @if (evs.Count > MaxChips)
                    {
                        var capDate = date;
                        <div class="ames-cal-wo-more" @onclick="() => ShowDayModal(capDate)" @onclick:stopPropagation>
                            @string.Format(L["PP.Calendar.More"].Value, evs.Count - MaxChips)
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="ames-cal-legend">@Legend()</div>
</div>

@* ── Day overflow modal ──────────────────────────────────────────── *@
@if (_showDay && _dayDate.HasValue)
{
    var dayEvs = GetEvents(_dayDate.Value);
    <div class="ames-modal-bg" @onclick="() => _showDay = false">
        <div class="ames-modal" style="max-width:500px;" @onclick:stopPropagation>
            <div class="ames-modal-h">@_dayDate.Value.ToString("yyyy-MM-dd ddd") — @L["MNT.PmSchedule.Modal.DayList"]</div>
            @foreach (var ev in dayEvs)
            {
                var capEv = ev;
                <div class="ames-cal-wo @ev.Cls" style="font-size:12px;padding:5px 8px;margin-bottom:4px;"
                     @onclick="() => { _showDay = false; ShowDetail(capEv); }">
                    <span style="font-weight:700;">@ev.Pm.PmPlanNumber</span>
                    <span style="opacity:.75;margin-left:6px;">@ev.Label</span>
                    <span class="pill @PillCls(ev.Cls)" style="float:right;font-size:10px;padding:1px 6px;">@LegendText(ev.Cls)</span>
                </div>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@L["Btn.Close"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="() => _showDay = false" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── PM Detail Modal (읽기 전용, Pp/Calendar 상세 패턴) ─────────────── *@
@if (_showDetail && _detail is not null)
{
    var d = _detail.Pm;
    <div class="ames-modal-bg" @onclick="() => _showDetail = false">
        <div class="ames-modal" @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MNT.PmSchedule.Modal.Detail"] @(d.PmPlanNumber ?? $"PM#{d.PmScheduleId}")</div>
            <div class="ames-detail-grid">
                <div class="ames-detail-label">@L["Col.Equip"]</div>
                <div>@EquipText(d.EquipId)</div>
                <div class="ames-detail-label">@L["MNT.PmSchedule.Col.Class"]</div>
                <div><span class="pill mute">@PmClassName(d.PmClass)</span></div>
                <div class="ames-detail-label">@L["Col.Type"]</div>
                <div><span class="pill info">@PmTypeName(d.PmType)</span></div>
                <div class="ames-detail-label">@L["Col.BasisCycle"] / @L["Col.Cycle"]</div>
                <div>@CodeName(_cycleBases, d.CycleBasis) / @(d.CycleValue?.ToString("N0") ?? "—")</div>
                <div class="ames-detail-label">@L["Col.LastPm"]</div>
                <div>@(d.LastPmDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                <div class="ames-detail-label">@L["Col.NextDue"]</div>
                <div>@(d.NextDueDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                <div class="ames-detail-label">@L["PP.Calendar.Detail.DDay"]</div>
                <div>
                    @{ var dd = d.NextDueDate is null ? (int?)null : d.DaysToDue; var ddc = dd is null ? "dim" : dd < 0 ? "bad" : dd <= 3 ? "warn" : "ok"; }
                    <span class="pill @ddc">@DdTxt(dd)</span>
                </div>
                <div class="ames-detail-label">@L["MNT.PmSchedule.Lbl.Checklist"]</div>
                <div>@TemplateText(d.ChecklistId)</div>
                <div class="ames-detail-label">@L["MNT.PmSchedule.Lbl.Tech"]</div>
                <div>@TechText(d.AssignedTechId)</div>
                <div class="ames-detail-label">@L["Col.Status"]</div>
                <div><span class="pill @PillCls(_detail.Cls)">@LegendText(_detail.Cls)</span> <span class="dim" style="font-size:11px;margin-left:6px;">@CodeName(_pmStatuses, d.Status)</span></div>
                <div class="ames-detail-label">@L["Col.OpenWo"]</div>
                <div>@(d.ActiveWoId is { } wo ? $"#{wo}" : "—")</div>
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                @if (_canEdit)
                {
                    <RadzenButton Text="@L["Btn.Edit"]" Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => OpenEdit(d))" class="ames-rz-btn" />
                }
                <RadzenButton Text="@L["MNT.Dashboard.Tile.Wo"]" Icon="list" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Click='() => Nav.NavigateTo("/mnt/work-order")' class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Close"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="() => _showDetail = false" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 등록 / 수정 모달 (MD·SYS 등록 모달 패턴) ──────────────────────── *@
@if (_modal is "create" or "edit")
{
    var editing = _modal == "edit";
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">
                @PmClassName(PmClass) PM — @(editing ? L["Modal.Edit"] : L["Modal.Create"])
                @if (editing) { <span class="dim" style="font-weight:400;font-size:.9em;margin-left:6px;">@_f.PlanNo</span> }
            </div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["MNT.PmSchedule.Lbl.PlanNo"]" class="ames-rz-modal-label" Component="PmTextBoxPlanNo" />
                    <RadzenTextBox Name="PmTextBoxPlanNo" @bind-Value="_f.PlanNo" MaxLength="30" Placeholder="@L["MNT.PmSchedule.Ph.PlanNo"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["Col.Equip"]} *")' class="ames-rz-modal-label" Component="PmDropDownEquip" />
                    <RadzenDropDown AllowFiltering="true" Name="PmDropDownEquip" @bind-Value="_f.EquipId" Data="@EquipOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["Col.Type"]} *")' class="ames-rz-modal-label" Component="PmDropDownType" />
                    <RadzenDropDown Name="PmDropDownType" @bind-Value="_f.PmType" Data="@CodeOptions(_pmTypes)" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.BasisCycle"]" class="ames-rz-modal-label" Component="PmDropDownBasis" />
                    <RadzenDropDown Name="PmDropDownBasis" @bind-Value="_f.CycleBasis" Data="@CodeOptions(_cycleBases)" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    <RadzenLabel Text="@L["MNT.PmSchedule.Lbl.CycleValue"]" class="ames-rz-modal-label" Component="PmNumericCycle" />
                    <RadzenNumeric TValue="int?" Name="PmNumericCycle" @bind-Value="_f.CycleValue" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.LastPm"]" class="ames-rz-modal-label" Component="PmDateLast" />
                    <RadzenDatePicker TValue="DateTime?" Name="PmDateLast" @bind-Value="_f.LastPmDate" DateFormat="@DateFmt.Date" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    <RadzenLabel Text='@($"{L["Col.NextDue"]} *")' class="ames-rz-modal-label" Component="PmDateDue" />
                    <RadzenDatePicker TValue="DateTime?" Name="PmDateDue" @bind-Value="_f.NextDueDate" DateFormat="@DateFmt.Date" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["MNT.PmSchedule.Lbl.Checklist"]" class="ames-rz-modal-label" Component="PmDropDownChecklist" />
                    <RadzenDropDown AllowFiltering="true" Name="PmDropDownChecklist" @bind-Value="_f.ChecklistId" Data="@TemplateOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.None"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["MNT.PmSchedule.Lbl.Tech"]" class="ames-rz-modal-label" Component="PmDropDownTech" />
                    <RadzenDropDown AllowFiltering="true" Name="PmDropDownTech" @bind-Value="_f.TechId" Data="@TechOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.None"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Status"]" class="ames-rz-modal-label" Component="PmDropDownStatus" />
                    <RadzenDropDown Name="PmDropDownStatus" @bind-Value="_f.Status" Data="@CodeOptions(_pmStatuses)" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
            </RadzenStack>

            @if (editing && _confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : (editing ? L["Btn.Save"] : L["Btn.Create"]))" Click="@Save" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                @if (editing)
                {
                    <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                }
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    /// <summary>공통코드 PM_CLASS 값 — 이 보드가 다루는 PM 분류(EQUIP 설비 / MAINT 보전). 조회 필터이자 등록 시 고정값.</summary>
    [Parameter] public string PmClass { get; set; } = "EQUIP";
    /// <summary>권한 키(SYS_Screen.HRef).</summary>
    [Parameter] public string Href { get; set; } = "mnt/pm-schedule";

    // 달력 이벤트: 예정일(NextDueDate) → 예정/오늘/지연, 마지막 PM 일(LastPMDate) → 완료
    public sealed record PmEvent(MntRepository.PmRow Pm, DateTime Date, string Cls, string Label);

    List<MntRepository.PmRow>               _all       = new();
    List<PmEvent>                           _events    = new();
    Dictionary<DateTime, List<PmEvent>>     _byDate    = new();
    Dictionary<DateTime, string>            _holidays  = new();
    List<MasterDataRepository.EquipmentRow>  _equipList = new();
    List<MasterDataRepository.PmTemplateRow> _templates = new();
    List<SysRepository.UserRow>              _users     = new();
    List<MasterDataRepository.CodeItemRow>  _pmTypes    = new();   // 공통코드 PM_TYPE
    List<MasterDataRepository.CodeItemRow>  _pmClasses  = new();   // 공통코드 PM_CLASS
    List<MasterDataRepository.CodeItemRow>  _cycleBases = new();   // 공통코드 PM_CYCLE_BASIS
    List<MasterDataRepository.CodeItemRow>  _pmStatuses = new();   // 공통코드 PM_STATUS

    int _calYear  = DateTime.Today.Year;
    int _calMonth = DateTime.Today.Month;
    string? _fEquip, _fStatus;
    string _msg = "", _modalErr = "";
    bool _isErr, _busy, _confirmDelete, _bgMouseDownOnSelf, _canEdit;
    string _actor = "system";

    bool      _showDay;
    DateTime? _dayDate;
    bool      _showDetail;
    PmEvent?  _detail;

    string _modal = "";   // "" | "create" | "edit"
    int?   _editId;
    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    // 설비 콤보: 마스터(MD_Equipment) 기준 [ID] 명칭 — 다른 MNT 화면과 같은 규칙
    IEnumerable<DropDownItem> EquipOptions => _equipList.Select(e => new DropDownItem { Value = e.EquipID, Text = string.IsNullOrEmpty(e.EquipName) ? $"[{e.EquipID}]" : $"[{e.EquipID}] {e.EquipName}" });
    // 상태 콤보(조회부): 달력 범례와 같은 4가지(완료·오늘·지연·예정)
    IEnumerable<DropDownItem> StatusOptions => new[] { "pm-done", "pm-today", "pm-overdue", "pm-planned" }.Select(c => new DropDownItem { Value = c, Text = LegendText(c) });
    IEnumerable<DropDownItem> CodeOptions(List<MasterDataRepository.CodeItemRow> items) =>
        items.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    IEnumerable<DropDownItem> TemplateOptions => _templates.Where(t => t.ActiveFlag).Select(t => new DropDownItem { Value = t.PMTemplateID, Text = $"[{t.PMTemplateID}] {t.TemplateName}" });
    IEnumerable<DropDownItem> TechOptions => _users.Where(u => !string.IsNullOrEmpty(u.EmployeeName) || !string.IsNullOrEmpty(u.UserName))
        .Select(u => new DropDownItem { Value = u.UserId, Text = string.IsNullOrEmpty(u.EmployeeNo) ? (u.EmployeeName ?? u.UserName ?? u.UserId) : $"[{u.EmployeeNo}] {u.EmployeeName ?? u.UserName}" });

    string MonthTitle => string.Format(L["Fmt.CalYearMonth"].Value, _calYear, _calMonth);
    int Count(string cls) => _events.Count(e => e.Cls == cls);
    double? Compliance
    {
        get { int done = Count("pm-done"), over = Count("pm-overdue"); return done + over == 0 ? null : 100.0 * done / (done + over); }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit(Href);

        try { _equipList   = MD.ListEquipments(); } catch { }
        try { _templates   = MD.ListPmTemplates(); } catch { }
        try { _users       = Sys.ListUsers(500); } catch { }
        try { _pmTypes     = MD.ListCodeItems("PM_TYPE");  } catch { }
        try { _pmClasses   = MD.ListCodeItems("PM_CLASS"); } catch { }
        try { _cycleBases  = MD.ListCodeItems("PM_CYCLE_BASIS"); } catch { }
        try { _pmStatuses  = MD.ListCodeItems("PM_STATUS"); } catch { }
        Reload();

        // 이번 달에 PM 이 하나도 없으면 데이터가 있는 가장 최근 달로 이동
        if (_events.Count == 0)
        {
            try
            {
                var last = Mnt.ListPmSchedule(3650, 3650, PmClass).Select(p => p.NextDueDate ?? p.LastPmDate).Where(d => d is { }).Max();
                if (last is { } m) { _calYear = m.Year; _calMonth = m.Month; Reload(); }
            }
            catch { }
        }
    }

    void Reload()
    {
        var from = new DateTime(_calYear, _calMonth, 1);
        var to   = from.AddMonths(1).AddDays(-1);
        try { _all = Mnt.ListPmCalendar(from, to, PmClass); }
        catch (Exception ex) { ShowMsg(ex.Message, true); _all = new(); }
        try { _holidays = Sys.ListCalendarRange(from, to).Where(c => c.CalendarDate is { } && !string.IsNullOrEmpty(c.HolidayName)).GroupBy(c => c.CalendarDate!.Value.Date).ToDictionary(g => g.Key, g => g.First().HolidayName!); }
        catch { _holidays = new(); }
        Rebuild();
    }

    void Rebuild()
    {
        var from = new DateTime(_calYear, _calMonth, 1);
        var to   = from.AddMonths(1).AddDays(-1);
        var today = DateTime.Today;

        var rows = _all.Where(p => string.IsNullOrEmpty(_fEquip) || p.EquipId == _fEquip);

        var list = new List<PmEvent>();
        foreach (var p in rows)
        {
            var label = $"{ShortEquip(p.EquipId)} {(p.PmType is null ? "" : PmTypeName(p.PmType))}".Trim();
            if (p.LastPmDate is { } done && done.Date >= from && done.Date <= to)
                list.Add(new PmEvent(p, done.Date, "pm-done", label));
            if (p.NextDueDate is { } due && due.Date >= from && due.Date <= to)
            {
                // 예정일이 지났는데 그 뒤로 실시(LastPMDate ≥ NextDueDate) 기록이 없으면 지연
                var cls = due.Date == today ? "pm-today"
                        : due.Date > today  ? "pm-planned"
                        : p.LastPmDate is { } lp && lp.Date >= due.Date ? "pm-done" : "pm-overdue";
                if (!(cls == "pm-done" && p.LastPmDate!.Value.Date == due.Date && list.Any(e => e.Pm == p && e.Cls == "pm-done")))
                    list.Add(new PmEvent(p, due.Date, cls, label));
            }
        }
        if (!string.IsNullOrEmpty(_fStatus)) list = list.Where(e => e.Cls == _fStatus).ToList();
        _events = list.OrderBy(e => e.Date).ThenBy(e => e.Pm.EquipId).ToList();
        _byDate = _events.GroupBy(e => e.Date).ToDictionary(g => g.Key, g => g.ToList());
    }

    List<PmEvent> GetEvents(DateTime date) => _byDate.TryGetValue(date.Date, out var l) ? l : new();
    string? HolidayName(DateTime date) => _holidays.TryGetValue(date.Date, out var h) ? h : null;

    void PrevMonth() { var d = new DateTime(_calYear, _calMonth, 1).AddMonths(-1); _calYear = d.Year; _calMonth = d.Month; Reload(); }
    void NextMonth() { var d = new DateTime(_calYear, _calMonth, 1).AddMonths(1);  _calYear = d.Year; _calMonth = d.Month; Reload(); }
    void GoToday()   { _calYear = DateTime.Today.Year; _calMonth = DateTime.Today.Month; Reload(); }

    void ShowDayModal(DateTime date) { _dayDate = date; _showDay = true; }
    void ShowDetail(PmEvent ev) { _detail = ev; _showDetail = true; }

    // ── 등록 / 수정 / 삭제 ─────────────────────────────────────────────
    void OpenCreate()
    {
        _f = new() { NextDueDate = new DateTime(_calYear, _calMonth, Math.Min(DateTime.Today.Day, DateTime.DaysInMonth(_calYear, _calMonth))), Status = "OK" };
        _editId = null; _modalErr = ""; _confirmDelete = false;
        _modal = "create";
    }

    void OpenEdit(MntRepository.PmRow p)
    {
        if (!_canEdit) return;
        _showDetail = false;
        _f = new()
        {
            PlanNo = p.PmPlanNumber ?? "", EquipId = p.EquipId ?? "", PmType = p.PmType ?? "",
            CycleBasis = p.CycleBasis ?? "", CycleValue = p.CycleValue,
            LastPmDate = p.LastPmDate, NextDueDate = p.NextDueDate,
            ChecklistId = p.ChecklistId ?? "", TechId = p.AssignedTechId ?? "", Status = p.Status ?? "",
        };
        _editId = p.PmScheduleId; _modalErr = ""; _confirmDelete = false;
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _editId = null; _modalErr = ""; _confirmDelete = false; }
    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void Save()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipId))  { _modalErr = L["MNT.PmSchedule.Err.EquipRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.PmType))   { _modalErr = L["MNT.PmSchedule.Err.TypeRequired"]; return; }
        if (_f.NextDueDate is null)                 { _modalErr = L["MNT.PmSchedule.Err.DueRequired"]; return; }
        if (_f.CycleValue is < 1)                   { _modalErr = L["MNT.PmSchedule.Err.CycleValue"]; return; }

        _busy = true;
        try
        {
            var planNo = _f.PlanNo.Trim();
            if (planNo.Length == 0) planNo = Mnt.NextPmPlanNumber(DateTime.Today);
            if (Mnt.PmPlanNumberExists(planNo, _editId)) { _modalErr = string.Format(L["MNT.PmSchedule.Err.Duplicate"].Value, planNo); return; }

            if (_editId is int id)
            {
                Mnt.UpdatePm(id, planNo, _f.EquipId, _f.PmType, NE(_f.CycleBasis), _f.CycleValue,
                    _f.LastPmDate, _f.NextDueDate.Value, NE(_f.ChecklistId), NE(_f.TechId), NE(_f.Status), _actor);
                ShowMsg(string.Format(L["MNT.PmSchedule.Ok.Updated"].Value, planNo), false);
            }
            else
            {
                var (_, woNo) = Mnt.InsertPm(PmClass, planNo, _f.EquipId, _f.PmType, NE(_f.CycleBasis), _f.CycleValue,
                    _f.LastPmDate, _f.NextDueDate.Value, NE(_f.ChecklistId), NE(_f.TechId), NE(_f.Status), _actor);
                ShowMsg(string.Format(L["MNT.PmSchedule.Ok.CreatedWo"].Value, planNo, woNo), false);
            }
            // 저장한 예정일의 달로 이동해 결과가 바로 보이게
            _calYear = _f.NextDueDate.Value.Year; _calMonth = _f.NextDueDate.Value.Month;
            CloseModal(); Reload();
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_editId is not int id) return;
        _busy = true;
        try
        {
            var planNo = _f.PlanNo;
            Mnt.DeletePm(id);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MNT.PmSchedule.Ok.Deleted"].Value, planNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    class FormModel
    {
        public string    PlanNo      { get; set; } = "";
        public string    EquipId     { get; set; } = "";
        public string    PmType      { get; set; } = "";
        public string    CycleBasis  { get; set; } = "";
        public int?      CycleValue  { get; set; }
        public DateTime? LastPmDate  { get; set; }
        public DateTime? NextDueDate { get; set; }
        public string    ChecklistId { get; set; } = "";
        public string    TechId      { get; set; } = "";
        public string    Status      { get; set; } = "";
    }

    // ── 표시 헬퍼 ─────────────────────────────────────────────────────
    string EquipName(string? id) =>
        id is null ? "" : _equipList.FirstOrDefault(e => e.EquipID == id)?.EquipName ?? "";
    string EquipText(string? id) =>
        id is null ? "—" : EquipName(id) is { Length: > 0 } nm ? $"[{id}] {nm}" : $"[{id}]";
    string TemplateText(string? id) =>
        id is null ? "—" : _templates.FirstOrDefault(t => t.PMTemplateID == id) is { } t ? $"[{id}] {t.TemplateName}" : id;
    string TechText(string? id) =>
        id is null ? "—" : _users.FirstOrDefault(u => u.UserId == id) is { } u ? (string.IsNullOrEmpty(u.EmployeeNo) ? (u.EmployeeName ?? u.UserName ?? id) : $"[{u.EmployeeNo}] {u.EmployeeName ?? u.UserName}") : id;
    // 공통코드 명칭 — 코드에 없는 값(구 데이터)은 코드 그대로
    static string CodeName(List<MasterDataRepository.CodeItemRow> items, string? c) =>
        c is null ? "—" : items.FirstOrDefault(x => string.Equals(x.CodeValue, c, StringComparison.OrdinalIgnoreCase)) is { } i ? MasterDataRepository.LocalName(i) : c;
    string PmTypeName(string? c)  => CodeName(_pmTypes, c);
    string PmClassName(string? c) => CodeName(_pmClasses, c);

    // 칩은 좁아서 설비 ID 만 (목업의 "INJ#1" 처럼 짧게)
    static string ShortEquip(string? id) => id ?? "—";

    string Tip(PmEvent ev) =>
        $"{ev.Pm.PmPlanNumber} | {EquipText(ev.Pm.EquipId)}\n{PmClassName(ev.Pm.PmClass)} · {PmTypeName(ev.Pm.PmType)} · {CodeName(_cycleBases, ev.Pm.CycleBasis)} {ev.Pm.CycleValue}\n{LegendText(ev.Cls)} | {L["Col.LastPm"]}: {ev.Pm.LastPmDate?.ToString("MM-dd") ?? "—"} | {L["Col.NextDue"]}: {ev.Pm.NextDueDate?.ToString("MM-dd") ?? "—"}";

    string DdTxt(int? days) => days switch
    {
        null  => L["PP.Calendar.DdTxt.None"].Value,
        < 0   => string.Format(L["PP.Calendar.DdTxt.Late"].Value, -days.Value),
        0     => L["PP.Calendar.DdTxt.DDay"].Value,
        { } v => string.Format(L["PP.Calendar.DdTxt.DaysTo"].Value, v)
    };

    string LegendText(string cls) => cls switch
    {
        "pm-done"    => L["MNT.PmSchedule.Legend.Completed"].Value,
        "pm-today"   => L["MNT.PmSchedule.Legend.Today"].Value,
        "pm-overdue" => L["MNT.PmSchedule.Legend.Overdue"].Value,
        _            => L["MNT.PmSchedule.Legend.Planned"].Value,
    };
    static string PillCls(string cls) => cls switch { "pm-done" => "ok", "pm-today" => "warn", "pm-overdue" => "bad", _ => "info" };

    RenderFragment Legend() => __builder =>
    {
        foreach (var cls in new[] { "pm-done", "pm-today", "pm-overdue", "pm-planned" })
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class", $"ames-cal-wo {cls}");
            __builder.AddAttribute(2, "style", "display:inline-block;position:static;margin:0 2px 4px;cursor:default;opacity:1;");
            __builder.AddContent(3, LegendText(cls));
            __builder.CloseElement();
        }
    };
}
