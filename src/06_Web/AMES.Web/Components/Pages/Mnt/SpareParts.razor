@page "/mnt/spare-parts"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject MntRepository Mnt
@inject MasterDataRepository MD
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-008 @L["MNT.SpareParts.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MNT-008" TitleKey="MNT.SpareParts.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MNT.SpareParts.Kpi.Parts"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allParts.Count</div>
            <div class="ames-kpi-s">@L["MNT.SpareParts.Kpi.PartsSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(LowCount > 0 ? "bad" : "ok")">
        <div class="ames-kpi-l">@L["MNT.SpareParts.Kpi.Low"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@LowCount</div>
            <div class="ames-kpi-s">@L["MNT.SpareParts.Kpi.LowSub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MNT.SpareParts.Kpi.Value"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_value.ToString("N0")</div>
            <div class="ames-kpi-s">@L["MNT.SpareParts.Kpi.ValueSub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MNT.SpareParts.Kpi.Txn"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allTxns.Count</div>
            <div class="ames-kpi-s">@string.Format(L["MNT.SpareParts.Kpi.TxnSub"].Value, _txnTopN)</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

@* ── 부품 목록 ───────────────────────────────────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.SpareParts.List"] · @_parts.Count @L["Lbl.Items"]@(_parts.Count < _allParts.Count ? $" / {L["Lbl.TotalOf"]} {_allParts.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fPart" Change="@(v => _fPart = v ?? "")" @onkeydown="OnPartKeyDown" Immediate="true" Placeholder="@L["MNT.SpareParts.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.Cat"]" Component="DropDownCat" />
            <RadzenDropDown Name="DropDownCat" @bind-Value="_fCat" Data="@CatFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.ApplicableEquip"]" Component="DropDownEquip" />
            <RadzenDropDown Name="DropDownEquip" @bind-Value="_fEquip" Data="@EquipFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" />
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenCheckBox TValue="bool" @bind-Value="_fLowOnly" Name="ChkLowOnly" />
                <RadzenLabel Text="@L["MNT.SpareParts.LowOnly"]" Component="ChkLowOnly" />
            </RadzenStack>

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@SearchParts" class="ames-rz-btn" />
            <RadzenButton Text="@L["MNT.SpareParts.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@ExportParts" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <div class="dim" style="font-size:var(--ames-fs-hint);padding:0 0 6px;">@L["MNT.SpareParts.Hint.Detail"]</div>

    <RadzenDataGrid @ref="_partGrid" Page="OnPartPage" TItem="MntRepository.SparePartRow" Data="@_parts" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_partPageSizeOptions" ShowPagingSummary="@_showPagerSummary" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" RowClick="@OnPartRowClick" RowRender="@RowRender" EmptyText="@L["MNT.SpareParts.Empty"]" PageSizeChanged="@(s => _partPageRows = s)" Style="@($"--ames-page-rows:{_partPageRows}")" Class="ames-rz-grid ames-grid-fixed ames-grid-top">
        <Columns>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="SparePartNo" Title="@L["Col.SparePartNo"]" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="r"><span class="code">@(r.SparePartNo ?? "—")</span></Template>
            </RadzenDataGridColumn>
            @* 열 구성·순서·너비는 MD-026(Md/Re/SparePart) 목록과 같다 — 맨 끝 재주문 플래그만 이 화면 고유 *@
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="Category" Title="@L["Col.Category"]" Width="140px">
                <Template Context="r">
                    @{ var ci = _catItems.FirstOrDefault(x => x.CodeValue == r.Category); }
                    @if (!string.IsNullOrEmpty(r.Category))
                    {
                        <span class="code">@r.Category</span>
                        @if (ci != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@MasterDataRepository.LocalName(ci)</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="ApplicableEquip" Title="@L["Col.ApplicableEquip"]" Width="100px">
                <Template Context="r">
                    @{ var ei = _equipItems.FirstOrDefault(x => x.CodeValue == r.ApplicableEquip); }
                    @if (!string.IsNullOrEmpty(r.ApplicableEquip))
                    {
                        <span class="code">@r.ApplicableEquip</span>
                        @if (ei != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@MasterDataRepository.LocalName(ei)</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="PartNo" Title="@L["Col.PartNo"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="code">@r.PartNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="PartName" Title="@L["Col.Name"]">
                <Template Context="r">@(r.PartName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="Uom" Title="@L["Col.Uom"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="r"><span class="code dim">@(r.Uom ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="UnitCost" Title="@L["Col.UnitPrice"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@(r.UnitCost?.ToString("N2") ?? "—")</Template>
            </RadzenDataGridColumn>
            @* 이미지 열은 이 목록에 두지 않는다 — 이미지는 상세 모달 미리보기로만 본다 *@
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="ZoneCode" Title="@L["Col.Zone"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="r"><span class="pill">@CodeLabel(_zoneItems, r.ZoneCode)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="Slot" Title="@L["Col.Slot"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="r"><span class="dim">@CodeLabel(_slotItems, r.Slot)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="OnHand" Title="@L["Col.OnHand"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r"><b>@r.OnHand.ToString("N0")</b></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="SafetyStock" Title="@L["Col.Safety"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r">@(r.SafetyStock?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="ReorderPoint" Title="@L["Col.Reorder"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r">@(r.ReorderPoint?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="ReorderQty" Title="@L["Col.ReorderQty"]" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="r">@(r.ReorderQty?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="LeadTimeDays" Title="@L["Col.LeadDays"]" TextAlign="TextAlign.Right" Width="140px">
                <Template Context="r">@(r.LeadTimeDays?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="Maker" Title="@L["Col.Maker"]" Width="140px">
                <Template Context="r">@(string.IsNullOrEmpty(r.Maker) ? "—" : r.Maker)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartRow" Property="SupplierId" Title="@L["Col.Supplier"]" Width="150px">
                <Template Context="r">
                    @{ var v = _vendors.FirstOrDefault(x => x.VendorID == r.SupplierId); }
                    @if (!string.IsNullOrEmpty(r.SupplierId))
                    {
                        <span class="code">@r.SupplierId</span>
                        @if (v?.VendorName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@v.VendorName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            @* 활성·플래그 열은 두지 않는다 — 목록은 ActiveFlag=1 만 조회하고, 재고 부족은 MD-026 과 같이 행을 붉게(RowRender) 표시 *@
        </Columns>
    </RadzenDataGrid>
</div>

@* ── 입출고 이력 ─────────────────────────────────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.SpareParts.TxnList"] · @_txns.Count @L["Lbl.Items"]@(_txns.Count < _allTxns.Count ? $" / {L["Lbl.TotalOf"]} {_allTxns.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fTxnPart" Change="@(v => _fTxnPart = v ?? "")" @onkeydown="OnTxnKeyDown" Immediate="true" Placeholder="@L["MNT.SpareParts.Ph.TxnSearch"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownMove" />
            <RadzenDropDown Name="DropDownMove" @bind-Value="_fMove" Data="@MoveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />
            <RadzenLabel Text="@L["Lbl.Recent"]" Component="DropDownTxnTopN" />
            <RadzenDropDown Name="DropDownTxnTopN" @bind-Value="_txnTopN" Data="@TopNOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@SearchTxn" class="ames-rz-btn" />
            <RadzenButton Text="@L["MNT.SpareParts.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@ExportTxn" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_txnGrid" Page="OnTxnPage" TItem="MntRepository.SparePartsTxnRow" Data="@_txns" AllowPaging="true" PageSize="5" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_txnPageSizeOptions" ShowPagingSummary="@_showPagerSummary" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" EmptyText="@L["MNT.SpareParts.TxnEmpty"]" PageSizeChanged="@(s => _txnPageRows = s)" Style="@($"--ames-page-rows:{_txnPageRows}")" Class="ames-rz-grid ames-grid-fixed ames-grid-rest">
        <Columns>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="SparePartsTxnId" Title="@L["Col.TxnNo"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="t"><span class="code">@t.SparePartsTxnId</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="TxnAt" Title="@L["Col.When"]" TextAlign="TextAlign.Center" Width="130px">
                <Template Context="t"><span class="dim">@t.TxnAt.ToString("MM-dd HH:mm")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="SparePartNo" Title="@L["Col.SparePartNo"]" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="t"><span class="code">@t.SparePartNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="SerialNo" Title="@L["Col.SerialNo"]" TextAlign="TextAlign.Center" Width="170px">
                <Template Context="t"><span class="code">@(t.SerialNo ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="PartNo" Title="@L["Col.PartNo"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="t"><span class="code">@(t.PartNo ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="PartName" Title="@L["Col.Name"]">
                <Template Context="t"><span style="white-space:nowrap;">@(t.PartName ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="MoveType" Title="@L["Col.Type"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="t"><span class="pill @MoveCls(t.MoveType)">@MoveLabel(t.MoveType)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="Qty" Title="@L["Col.Qty"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="t">@t.Qty.ToString("N0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="BalanceBefore" Title="@L["Col.BalanceBefore"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="t"><span class="dim">@t.BalanceBefore.ToString("N0")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="BalanceAfter" Title="@L["Col.Balance"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="t"><b>@t.BalanceAfter.ToString("N0")</b></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="RefId" Title="@L["Col.Ref"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="t"><span class="dim">@RefText(t)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Property="Note" Title="@L["Col.Note"]">
                <Template Context="t"><span class="dim" style="white-space:nowrap;">@(t.Note ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.SparePartsTxnRow" Title="@L["Col.Label"]" TextAlign="TextAlign.Center" Width="92px" Sortable="false" Filterable="false">
                <Template Context="t">
                    <RadzenButton Text="@L["Btn.Reprint"]" Icon="print" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall"
                                  Disabled="@string.IsNullOrWhiteSpace(t.SerialNo)" Click="@(() => OpenLabel(t))" class="ames-rz-btn" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_printTxn is not null && !string.IsNullOrWhiteSpace(_printTxn.SerialNo))
{
    <SparePartLabelDialog SerialNo="@(_printTxn.SerialNo!)" SparePartNo="@_printTxn.SparePartNo"
                          PartName="@_printTxn.PartName" VendorName="@_printTxn.VendorName"
                          LocationId="@_printTxn.LocationId" ExtraLocation="@_printTxn.ExtraLocation"
                          OnClose="CloseLabel" />
}

@* ── Detail Modal (읽기 전용) ─────────────────────────────────────── *@
@if (_modal == "detail" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MNT.SpareParts.Title"] <span class="dim" style="font-weight:400;font-size:.9em;">@(_sel.SparePartNo ?? "") · @_sel.PartNo</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.Name"]" class="ames-rz-modal-label" Component="DetailTextBoxName" />
                <RadzenTextBox Name="DetailTextBoxName" Value="@(_sel.PartName ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            @* 행·필드 구성은 MD-026 수정 모달과 같다(읽기 전용) — 이 화면의 기능은 입출고 이력 이동뿐 *@
            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Category"]" />
                    <RadzenTextBox Value="@CodeText(_catItems, _sel.Category)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.ApplicableEquip"]" />
                    <RadzenTextBox Value="@CodeText(_equipItems, _sel.ApplicableEquip)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Uom"]" />
                    <RadzenTextBox Value="@(_sel.Uom ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.UnitPrice"]" />
                    <RadzenTextBox Value="@(_sel.UnitCost?.ToString("N2") ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.OnHand"]" />
                    <RadzenTextBox Value="@_sel.OnHand.ToString("N0")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Safety"]" />
                    <RadzenTextBox Value="@(_sel.SafetyStock?.ToString("N0") ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Image"]" />
                    <div class="ames-img-preview">
                        @if (_selImage is { Length: > 0 })
                        {
                            <img src="@ImageBytes.DataUrl(_selImage)" alt="" />
                        }
                        else
                        {
                            <span class="dim" style="font-size:calc(11px + var(--ames-fs-bump));">@L["MD.SparePart.NoImage"]</span>
                        }
                    </div>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Zone"]" />
                    <RadzenTextBox Value="@CodeText(_zoneItems, _sel.ZoneCode)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Slot"]" />
                    <RadzenTextBox Value="@CodeText(_slotItems, _sel.Slot)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Reorder"]" />
                    <RadzenTextBox Value="@(_sel.ReorderPoint?.ToString("N0") ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ReorderQty"]" />
                    <RadzenTextBox Value="@(_sel.ReorderQty?.ToString("N0") ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.LeadDays"]" />
                    <RadzenTextBox Value="@(_sel.LeadTimeDays?.ToString() ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Maker"]" />
                    <RadzenTextBox Value="@(_sel.Maker ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Supplier"]" />
                    <RadzenTextBox Value="@VendorText(_sel.SupplierId)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" Value="@_sel.ActiveFlag" Disabled="true" Name="DetailChkActive" />
                <RadzenLabel Text="@L["Lbl.Active"]" Component="DetailChkActive" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@L["MNT.SpareParts.Btn.ShowTxn"]" Click="@ShowTxnForSelected" Icon="history" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Close"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    // 상·하 2단 목록: 상단 부품 15행(15/30/50/100), 하단 이력 5행(5/10/20/30/50) — 고정 페이저 높이가 페이지 행 수를 따라간다(.ames-grid-fixed)
    IEnumerable<int> _partPageSizeOptions = new int[] { 15, 30, 50, 100 };
    IEnumerable<int> _txnPageSizeOptions  = new int[] { 5, 10, 20, 30, 50 };
    bool _showPagerSummary = true;
    int  _partPageRows = 15, _txnPageRows = 5;    // 고정 페이저(.ames-grid-fixed) 그리드별 페이지 행 수
    List<MntRepository.SparePartRow>       _allParts = new();
    List<MntRepository.SparePartRow>       _parts    = new();
    List<MntRepository.SparePartsTxnRow>   _allTxns  = new();
    List<MntRepository.SparePartsTxnRow>   _txns     = new();
    List<MasterDataRepository.CodeItemRow> _catItems   = new();   // 공통코드 SPAREPARTS_CATEGORY (A~K)
    List<MasterDataRepository.CodeItemRow> _equipItems = new();   // 공통코드 SPAREPARTS_EQUIP (1~9)
    List<MasterDataRepository.CodeItemRow> _zoneItems  = new();   // 공통코드 MNT_ZONE (보관 구역)
    List<MasterDataRepository.CodeItemRow> _slotItems  = new();   // 공통코드 MNT_SLOT (보관 칸)
    List<MasterDataRepository.VendorRow>   _vendors    = new();   // 공급업체 명칭 표시용
    MntRepository.SparePartRow? _sel;
    MntRepository.SparePartsTxnRow? _printTxn;
    byte[]? _selImage;   // 상세 모달 미리보기 — 행을 열 때만 MD_SparePart.SparePartImage 를 읽는다

    string  _fPart = "", _fTxnPart = "";
    string? _fCat, _fEquip, _fMove;
    bool    _fLowOnly;
    int     _txnTopN = 50;
    // 재고 금액 = 마스터 현재고 × 마스터 단가(UnitCost) — 이력에는 단가를 두지 않는다
    decimal _value => _allParts.Sum(p => p.OnHand * (p.UnitCost ?? 0m));
    string  _modal = "", _msg = "";
    bool    _bgMouseDownOnSelf, _isErr;

    static readonly string[] MoveCodes = { "LABEL", "IN", "OUT", "IN_CANCEL", "OUT_CANCEL", "ADJ" };
    static readonly int[]    TopNs     = { 50, 100, 200, 500 };

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    public class TopNItem     { public string Text { get; set; } = ""; public int Value { get; set; } }

    // 분류 콤보: SPAREPARTS_CATEGORY 공통코드 ∪ 데이터에만 있는 값 — 코드 미등록 값도 걸러 볼 수 있게
    IEnumerable<DropDownItem> CatFilterOptions =>
        _catItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" })
        .Concat(_allParts.Select(p => p.Category).Where(c => c is { Length: > 0 } && !_catItems.Any(x => x.CodeValue == c)).Distinct().Select(c => new DropDownItem { Value = c!, Text = $"[{c}]" }));
    IEnumerable<DropDownItem> EquipFilterOptions =>
        _equipItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" })
        .Concat(_allParts.Select(p => p.ApplicableEquip).Where(c => c is { Length: > 0 } && !_equipItems.Any(x => x.CodeValue == c)).Distinct().Select(c => new DropDownItem { Value = c!, Text = $"[{c}]" }));
    IEnumerable<DropDownItem> MoveFilterOptions => MoveCodes.Select(m => new DropDownItem { Value = m, Text = $"[{m}] {MoveLabel(m)}" });
    IEnumerable<TopNItem>     TopNOptions       => TopNs.Select(n => new TopNItem { Value = n, Text = $"{n}{L["Lbl.Items"]}" });

    int LowCount => _allParts.Count(IsLow);

    protected override void OnInitialized()
    {
        try { _catItems   = MD.ListCodeItems("SPAREPARTS_CATEGORY"); } catch { }
        try { _equipItems = MD.ListCodeItems("SPAREPARTS_EQUIP"); } catch { }
        try { _zoneItems  = MD.ListCodeItems("MNT_ZONE"); } catch { }
        try { _slotItems  = MD.ListCodeItems("MNT_SLOT"); } catch { }
        try { _vendors    = MD.ListVendors(); } catch { }
        try { _allParts = Mnt.ListSpareParts(); }
        catch (Exception ex) { _allParts = new(); ShowMsg(ex.Message, true); }
        ReloadTxn();
        ApplyPartFilter();
    }

    RadzenDataGrid<MntRepository.SparePartRow>?     _partGrid;
    RadzenDataGrid<MntRepository.SparePartsTxnRow>? _txnGrid;
    int _partPgIndex, _txnPgIndex;
    void OnPartPage(PagerEventArgs args) => _partPgIndex = args.PageIndex;
    void OnTxnPage(PagerEventArgs args)  => _txnPgIndex  = args.PageIndex;

    // ── 부품 목록 ──────────────────────────────────────────────────────
    async Task SearchParts()
    {
        _partPgIndex = 0;
        ApplyPartFilter();
        await InvokeAsync(StateHasChanged);
        if (_partGrid is not null) await _partGrid.GoToPage(0);
    }

    void ApplyPartFilter() { _parts = _allParts.Where(p =>
        (string.IsNullOrEmpty(_fPart) ||
            p.PartNo.Contains(_fPart, StringComparison.OrdinalIgnoreCase) ||
            (p.SparePartNo ?? "").Contains(_fPart, StringComparison.OrdinalIgnoreCase) ||
            (p.PartName ?? "").Contains(_fPart, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fCat) || p.Category == _fCat) &&
        (string.IsNullOrEmpty(_fEquip) || p.ApplicableEquip == _fEquip) &&
        (!_fLowOnly || IsLow(p))
    ).ToList();
    }

    async Task OnPartKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchParts(); }

    // ── 입출고 이력 ────────────────────────────────────────────────────
    async Task SearchTxn()
    {
        _txnPgIndex = 0;
        ReloadTxn();
        await InvokeAsync(StateHasChanged);
        if (_txnGrid is not null) await _txnGrid.GoToPage(0);
    }

    // 검색어가 등록 부품번호와 정확히 일치하면 서버에서 그 부품만 최근 N건을 가져온다 — 최근 N건 안에서
    // 부분 일치로 거르면 오래된 이력이 잘려 특정 부품의 이력이 비어 보이기 때문. 그 외는 최근 N건 내 부분 일치.
    void ReloadTxn()
    {
        // 정확히 일치하는 예비품번호 또는 부품번호 → 서버는 SparePartNo 로 거른다.
        // 목록은 활성 부품만이라, 비활성 부품의 예비품번호(EOS-SP-…, 16자)를 그대로 입력한 경우도 서버 필터로 넘긴다
        var q = _fTxnPart.Trim();
        var exact = _allParts.FirstOrDefault(p =>
            (p.SparePartNo ?? "").Equals(q, StringComparison.OrdinalIgnoreCase) ||
            p.PartNo.Equals(q, StringComparison.OrdinalIgnoreCase))?.SparePartNo
            ?? (q.Length == 16 && q.StartsWith("EOS-SP-", StringComparison.OrdinalIgnoreCase) ? q.ToUpperInvariant() : null);
        try { _allTxns = Mnt.ListSparePartsTxn(_txnTopN, exact); }
        catch (Exception ex) { _allTxns = new(); ShowMsg(ex.Message, true); }

        _txns = _allTxns.Where(t =>
            (exact is not null || string.IsNullOrEmpty(q) ||
                t.SparePartNo.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (t.SerialNo ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (t.PartNo   ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (t.PartName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                RefText(t).Contains(q, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_fMove) || t.MoveType == _fMove)
        ).ToList();

    }

    async Task OnTxnKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchTxn(); }

    async Task ShowTxnForSelected()
    {
        if (_sel is null) return;
        _fTxnPart = _sel.SparePartNo ?? _sel.PartNo; _fMove = null;
        CloseModal();
        await SearchTxn();
    }

    // ── 행 클릭 · 모달 ────────────────────────────────────────────────
    // 현재고 < 안전재고 인 행은 붉게 (.ames-row-low) — MD-026 과 같은 규칙 (재주문 플래그와는 별개)
    void RowRender(RowRenderEventArgs<MntRepository.SparePartRow> args)
    {
        var cls = "ames-row-link" + (args.Data is { } d && d.OnHand < (d.SafetyStock ?? 0) ? " ames-row-low" : "");
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " " + cls;
        else
            args.Attributes["class"] = cls;
    }

    void OnPartRowClick(DataGridRowMouseEventArgs<MntRepository.SparePartRow> args)
    {
        if (args.Data is null) return;
        _sel = args.Data; _modal = "detail";
        _selImage = null;
        if (_sel.HasImage && _sel.SparePartNo is { } no) { try { _selImage = MD.GetSparePartImage(no); } catch { } }
    }

    void OpenLabel(MntRepository.SparePartsTxnRow txn) => _printTxn = txn;
    void CloseLabel() => _printTxn = null;

    void CloseModal() { _modal = ""; _sel = null; _selImage = null; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    // ── 내보내기 — 화면 컬럼 순서 그대로 ──────────────────────────────
    async Task ExportParts()
    {
        if (_parts.Count == 0) { ShowMsg(L["MNT.SpareParts.Err.NoExport"], true); return; }

        var headers = new[]
        {
            L["Col.SparePartNo"].Value, L["Col.Category"].Value, L["Col.ApplicableEquip"].Value, L["Col.PartNo"].Value, L["Col.Name"].Value, L["Col.Uom"].Value,
            L["Col.UnitPrice"].Value, L["Col.Zone"].Value, L["Col.Slot"].Value,
            L["Col.OnHand"].Value, L["Col.Safety"].Value, L["Col.Reorder"].Value, L["Col.ReorderQty"].Value,
            L["Col.LeadDays"].Value, L["Col.Maker"].Value, L["Col.Supplier"].Value,
        };
        var data = _parts.Select(p => (IReadOnlyList<object?>)new object?[]
        {
            p.SparePartNo, CodeText(_catItems, p.Category), CodeText(_equipItems, p.ApplicableEquip), p.PartNo, p.PartName, p.Uom,
            p.UnitCost, CodeLabel(_zoneItems, p.ZoneCode), CodeLabel(_slotItems, p.Slot),
            p.OnHand, p.SafetyStock, p.ReorderPoint, p.ReorderQty,
            p.LeadTimeDays, p.Maker, VendorText(p.SupplierId),
        });
        await Download(L["MNT.SpareParts.List"].Value, "SpareParts", headers, data, _parts.Count);
    }

    async Task ExportTxn()
    {
        if (_txns.Count == 0) { ShowMsg(L["MNT.SpareParts.Err.NoExport"], true); return; }

        var headers = new[]
        {
            L["Col.TxnNo"].Value, L["Col.When"].Value, L["Col.SparePartNo"].Value, L["Col.SerialNo"].Value, L["Col.PartNo"].Value, L["Col.Name"].Value, L["Col.Type"].Value,
            L["Col.Qty"].Value, L["Col.BalanceBefore"].Value, L["Col.Balance"].Value,
            L["Col.Ref"].Value, L["Col.Note"].Value,
        };
        var data = _txns.Select(t => (IReadOnlyList<object?>)new object?[]
        {
            t.SparePartsTxnId, t.TxnAt.ToString(DateFmt.DateTime), t.SparePartNo, t.SerialNo, t.PartNo, t.PartName, MoveLabel(t.MoveType),
            t.Qty, t.BalanceBefore, t.BalanceAfter,
            RefText(t), t.Note,
        });
        await Download(L["MNT.SpareParts.TxnList"].Value, "SparePartsTxn", headers, data, _txns.Count);
    }

    async Task Download(string sheet, string prefix, string[] headers, IEnumerable<IReadOnlyList<object?>> data, int count)
    {
        var bytes = AMES.Web.Services.XlsxWriter.Build(sheet, headers, data);
        var name  = $"{prefix}_{DbClock.Now:yyyyMMdd_HHmmss}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["MNT.SpareParts.Ok.Exported"].Value, count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    // ── 표시 헬퍼 ─────────────────────────────────────────────────────
    static bool IsLow(MntRepository.SparePartRow p) => p.OnHand <= (p.ReorderPoint ?? 0);

    // 공통코드 값 → 명칭(코드 미등록 값은 원문). CodeText 는 "[코드] 명칭" 꼴로 모달·내보내기에 쓴다
    static string CodeLabel(List<MasterDataRepository.CodeItemRow> codes, string? value)
        => string.IsNullOrEmpty(value) ? "—"
         : codes.FirstOrDefault(c => c.CodeValue == value) is { } ci ? MasterDataRepository.LocalName(ci) : value;
    static string CodeText(List<MasterDataRepository.CodeItemRow> codes, string? value)
        => string.IsNullOrEmpty(value) ? ""
         : codes.FirstOrDefault(c => c.CodeValue == value) is { } ci ? $"[{value}] {MasterDataRepository.LocalName(ci)}" : value;
    string VendorText(string? id)
        => string.IsNullOrEmpty(id) ? ""
         : _vendors.FirstOrDefault(v => v.VendorID == id) is { VendorName: { } name } ? $"[{id}] {name}" : id;

    string MoveLabel(string? m) => m switch
    {
        null => "—", "LABEL" => L["MNT.SpareParts.Move.Label"],
        "IN" => L["MNT.SpareParts.Move.In"], "OUT" => L["MNT.SpareParts.Move.Out"],
        "IN_CANCEL" => L["MNT.SpareParts.Move.InCancel"], "OUT_CANCEL" => L["MNT.SpareParts.Move.OutCancel"],
        "ADJ" => L["MNT.SpareParts.Move.Adj"], _ => m
    };
    static string MoveCls(string? m) => m switch
    {
        "IN" or "OUT_CANCEL" => "ok", "OUT" or "IN_CANCEL" => "warn", "ADJ" => "info", _ => "mute"
    };

    // RefID 가 이미 유형 접두어를 품고 있으면(MWO-2606-003) 유형을 다시 붙이지 않는다
    static string RefText(MntRepository.SparePartsTxnRow t) =>
        string.IsNullOrEmpty(t.RefType) && string.IsNullOrEmpty(t.RefId) ? "—"
        : !string.IsNullOrEmpty(t.RefType) && (t.RefId ?? "").StartsWith(t.RefType, StringComparison.OrdinalIgnoreCase) ? t.RefId!
        : $"{t.RefType} {t.RefId}".Trim();
}
