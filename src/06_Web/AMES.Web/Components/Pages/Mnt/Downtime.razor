@page "/mnt/downtime"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MntRepository Mnt
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-06 @L["MNT.Downtime.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MNT-06</div>
    <div class="ames-page-t">@L["MNT.Downtime.Title"]</div>
    <div class="ames-page-sub">@L["MNT.Downtime.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">EVENTS</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">filtered</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">TOTAL MIN</div>
        <div class="ames-kpi-v">@_totMin.ToString("N0")</div><div class="ames-kpi-s">minutes lost</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">AVG MIN/EV</div>
        <div class="ames-kpi-v">@_avgMin.ToString("0")</div><div class="ames-kpi-s">avg per event</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">OPEN</div>
        <div class="ames-kpi-v">@_open</div><div class="ames-kpi-s">EndTS = null</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.Downtime.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:110px;padding:4px 8px;"
                   placeholder="@L["MNT.Downtime.Ph.Line"]" @bind="_fLine" autocomplete="off" />
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Period"]</label>
            <select class="ames-input" style="width:70px;padding:4px 8px;" @bind="_daysBack">
                <option value="7">7@L["Lbl.Days"]</option>
                <option value="14">14@L["Lbl.Days"]</option>
                <option value="30">30@L["Lbl.Days"]</option>
                <option value="60">60@L["Lbl.Days"]</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MNT.Downtime.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>DT #</th><th>Line</th><th>Start</th><th>End</th>
                    <th class="num">Min</th><th>Reason</th><th>Cause</th><th>Comment</th><th>WO</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in _rows)
                {
                    <tr>
                        <td class="code">@d.DowntimeId</td>
                        <td>@(d.LineId ?? "—")</td>
                        <td class="dim">@(d.StartTs?.ToString("MM-dd HH:mm") ?? "—")</td>
                        <td class="dim">@(d.EndTs?.ToString("MM-dd HH:mm") ?? "—")</td>
                        <td class="num">@(d.DurationMin?.ToString() ?? "—")</td>
                        <td><span class="pill info">@(d.ReasonCode ?? "—")</span></td>
                        <td class="dim">@(d.CauseCode ?? "—")</td>
                        <td class="dim">@(d.Comment ?? "—")</td>
                        <td class="dim">@(d.WoId?.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.MntRepository.DowntimeRow> _allRows = new();
    List<AMES.Data.Repositories.MntRepository.DowntimeRow> _rows    = new();
    int    _totMin, _avgMin, _open;
    int    _daysBack = 7;
    string _fLine    = "";

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Mnt.ListDowntime(_daysBack); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = string.IsNullOrWhiteSpace(_fLine)
            ? _allRows
            : _allRows.Where(r => (r.LineId ?? "").Contains(_fLine, StringComparison.OrdinalIgnoreCase)).ToList();
        _totMin = _rows.Sum(r => r.DurationMin ?? 0);
        _avgMin = _rows.Count > 0 ? _totMin / _rows.Count : 0;
        _open   = _rows.Count(r => r.EndTs is null);
    }
}
