    async Task SaveIssue()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipId))  { _modalErr = L["MNT.WorkOrder.Err.EquipRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.WoType))   { _modalErr = L["MNT.WorkOrder.Err.TypeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.Priority)) { _modalErr = L["MNT.WorkOrder.Err.PriorityRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.Desc))     { _modalErr = L["MNT.WorkOrder.Err.DescRequired"]; return; }
        _busy = true;
        try
        {
            var (id, no, st) = Mnt.IssueWorkOrder(_f.WoType, _f.EquipId, _f.Priority, _f.Desc.Trim(), NE(_f.TechId), _actor);
            Audit.Created("MNT-007", "MNT_WorkOrder", no, new { WoNumber = no, _f.WoType, _f.EquipId, _f.Priority, Description = _f.Desc.Trim(), AssignedTechId = NE(_f.TechId), Status = st, SourceType = "MANUAL" });
            ShowMsg(string.Format(L["MNT.WorkOrder.Ok.Issued"].Value, no, StatusLabel(st)), false);
            await AfterChange(id);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

