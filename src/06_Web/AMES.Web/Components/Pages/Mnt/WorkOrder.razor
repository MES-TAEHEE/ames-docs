                        <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.RootCause"]" class="ames-rz-modal-label" Component="CompleteTextBoxRootCause" />
                        <RadzenTextBox Name="CompleteTextBoxRootCause" @bind-Value="_f.RootCause" MaxLength="200" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                    </RadzenStack>
                }

                <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["MNT.WorkOrder.Lbl.Action"]} *")' Component="CompleteTextAreaAction" Style="margin-bottom:6px;" />
                    <RadzenTextArea Name="CompleteTextAreaAction" @bind-Value="_f.Action" MaxLength="500" Rows="3" class="ames-rz-input" Style="width:100%;" />
