    // 종료 메시지: WO 종료 + 같이 닫힌 고장 · 건너뛴 PM 회차 · 발행된 다음 WO
    string CloseMsg(MntRepository.WoCloseOutcome o)
    {
        var parts = new List<string> { string.Format(L["MNT.WorkOrder.Ok.Closed"].Value, o.WoNumber) };
        if (o.FailureNumber is not null) parts.Add(string.Format(L["MNT.WorkOrder.Ok.FailureClosed"].Value, o.FailureNumber));
        if (o.PmPlanNumber  is not null) parts.Add(o.PmNextDue is { } nd
            ? string.Format(L["MNT.WorkOrder.Ok.PmSkipped"].Value, o.PmPlanNumber, nd.ToString(DateFmt.Date))
            : string.Format(L["MNT.WorkOrder.Ok.PmSkippedNoDate"].Value, o.PmPlanNumber));
        if (o.NextWoNumber  is not null) parts.Add(string.Format(L["MNT.WorkOrder.Ok.NextWo"].Value, o.NextWoNumber));
        return string.Join(" · ", parts);
    }

    void OpenComplete(MntRepository.MwoRow? r)
    {
        if (r is null || !_canApprove) return;
        _sel = r; _modalErr = "";
        LoadReleases(r);
        _f = new()
        {
            Result = MwoChecklistRules.DefaultResult(TaskPending, TaskFailed), CompletedAt = DbClock.Now, TechId = r.AssignedTechId ?? "",
            // 착수 시각이 있으면 소요 시간 기본값 = 착수 → 지금
            LaborMinutes = r.StartedAt is { } st && st < DbClock.Now ? (int)Math.Round((DbClock.Now - st).TotalMinutes) : null,
        };
        _modal = "complete";
    }

    async Task SaveComplete()
    {
        if (!_canApprove) return;
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.Result))     { _modalErr = L["MNT.WorkOrder.Err.ResultRequired"]; return; }
        if (_f.CompletedAt is null)                   { _modalErr = L["MNT.WorkOrder.Err.CompletedRequired"]; return; }
        if (_sel.IssuedAt is { } iss && _f.CompletedAt < iss) { _modalErr = L["MNT.WorkOrder.Err.CompletedBefore"]; return; }
        if (_f.LaborMinutes is < 0)                   { _modalErr = L["MNT.WorkOrder.Err.LaborInvalid"]; return; }
        if (string.IsNullOrWhiteSpace(_f.Action))     { _modalErr = L["MNT.WorkOrder.Err.ActionRequired"]; return; }
        if (!MwoChecklistRules.Allows(_f.Result, TaskPending, TaskFailed)) { _modalErr = string.Format(L["MNT.WorkOrder.Err.ChecklistIncomplete"].Value, TaskPending, TaskFailed); return; }
        if (_sel.PmNeedsNextDue && _f.PmNextDue is null) { _modalErr = L["MNT.WorkOrder.Err.PmNextDueRequired"]; return; }
        if (_sel.PmNeedsNextDue && !PmRules.ValidManualNextDue(_f.PmNextDue, _f.CompletedAt.Value)) { _modalErr = L["MNT.WorkOrder.Err.PmNextDueInvalid"]; return; }

        _busy = true;
        try
        {
            var o = Mnt.CompleteWorkOrder(_sel.WorkOrderId, _f.Result, _f.Action.Trim(), NE(_f.RootCause), _f.LaborMinutes,
                _f.CompletedAt.Value, NE(_f.TechId), _actor, _sel.PmNeedsNextDue ? _f.PmNextDue : null);
            Audit.Log("MNT-007", "COMPLETE", "MNT_WorkOrder", o.WoNumber, _sel, new { Status = MwoStatusCodes.Completed, Form = _f, Outcome = o });
            ShowMsg(CompleteMsg(o), false);
            await AfterChange(_sel.WorkOrderId);
        }
        catch (MntRepository.ChecklistIncompleteException cx) { _modalErr = string.Format(L["MNT.WorkOrder.Err.ChecklistIncomplete"].Value, cx.Pending, cx.Failed); }
        catch (MntRepository.PmNextDueRequiredException nx) { _modalErr = L[nx.Invalid ? "MNT.WorkOrder.Err.PmNextDueInvalid" : "MNT.WorkOrder.Err.PmNextDueRequired"]; }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    // 완료 메시지: WO 완료 + 역방향으로 닫힌 고장 · 갱신된 PM · 발행된 다음 WO
    string CompleteMsg(MntRepository.WoCompleteOutcome o)
    {
        var parts = new List<string> { string.Format(L["MNT.WorkOrder.Ok.Completed"].Value, o.WoNumber) };
        if (o.FailureNumber is not null) parts.Add(o.FollowUpWoNumber is { } fw
            ? string.Format(L["MNT.WorkOrder.Ok.FailureFollowUp"].Value, o.FailureNumber, fw)
            : string.Format(L["MNT.WorkOrder.Ok.FailureResolved"].Value, o.FailureNumber));
        else if (o.FollowUpWoNumber is { } cw) parts.Add(string.Format(L["MNT.WorkOrder.Ok.CheckFollowUp"].Value, cw));
        if (o.PmPlanNumber  is not null) parts.Add(o.PmNextDue is { } nd
            ? string.Format(L["MNT.WorkOrder.Ok.PmAdvanced"].Value, o.PmPlanNumber, nd.ToString(DateFmt.Date))
            : string.Format(L["MNT.WorkOrder.Ok.PmDone"].Value, o.PmPlanNumber));
        if (o.NextWoNumber  is not null) parts.Add(string.Format(L["MNT.WorkOrder.Ok.NextWo"].Value, o.NextWoNumber));
        return string.Join(" · ", parts);
    }

    // ── 사용 부품 = PDA 가 이 작업지시로 출고한 부품(취소분 제외) — 상세·완료 창에서 읽기만 ──
    List<MntRepository.PartReleaseRow> _woReleases = new();

    string ReleasesText() => _woReleases.Count == 0
        ? L["MNT.WorkOrder.Lbl.PartsNone"].Value
        : MwoPartsUsed.Describe(MwoPartsUsed.Merge(_woReleases.Select(r => r.ToLine())));

    // 저장 뒤 목록을 다시 읽고 같은 WO 의 상세를 다시 연다(갱신된 상태·시각이 바로 보이게)
    async Task AfterChange(int woId)
    {
        Reload();
        var again = _allRows.FirstOrDefault(r => r.WorkOrderId == woId);
        if (again is null) try { again = Mnt.FindWorkOrder(woId); } catch { }
        if (again is not null) OpenDetail(again); else CloseModal();
        await InvokeAsync(StateHasChanged);
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    class FormModel
    {
        public string    TechId       { get; set; } = "";
        public string    Result       { get; set; } = "";
        public DateTime? CompletedAt  { get; set; }
        public int?      LaborMinutes { get; set; }
        public string    RootCause    { get; set; } = "";
        public string    Action       { get; set; } = "";
        public string    EquipId      { get; set; } = "";   // 수동 발행
        public string    WoType       { get; set; } = "";
        public string    Priority     { get; set; } = "";
        public string    Desc         { get; set; } = "";
        public DateTime? PmNextDue    { get; set; }   // 기간 주기가 아닌 PM 의 다음 예정일(완료 때 입력)
    }

    // 현재 조회 결과(필터 적용분)를 .xlsx 로 내려받는다 — 화면 컬럼 순서 그대로
    async Task ExportXlsx()
    {
        if (_rows.Count == 0) { ShowMsg(L["MNT.WorkOrder.Err.NoExport"], true); return; }

        var headers = new[]
        {
            L["Col.MwoNo"].Value, L["Col.Type"].Value, L["Col.EquipId"].Value, L["Col.EquipName"].Value,
            L["Col.Priority"].Value, L["Col.Source"].Value, L["Col.AssignedTech"].Value, L["Col.Status"].Value,
            L["Col.IssuedDate"].Value, L["Col.StartedDate"].Value, L["Col.CompletedDate"].Value,
            L["Col.Duration"].Value, L["Col.Tasks"].Value,
        };
        var data = _rows.Select(r => (IReadOnlyList<object?>)new object?[]
        {
            WoNo(r), TypeLabel(r.WoType), r.EquipId, EquipName(r.EquipId),
            r.Priority, SourceLabel(r.SourceType), r.AssignedTechId is null ? null : TechText(r.AssignedTechId), StatusLabel(r.Status),
            r.IssuedAt?.ToString(DateFmt.DateTime), r.StartedAt?.ToString(DateFmt.DateTime), r.CompletedAt?.ToString(DateFmt.DateTime),
            r.LaborMinutes, $"{r.TaskDone} / {r.TaskCount}",
        });

        var bytes = AMES.Web.Services.XlsxWriter.Build(L["MNT.WorkOrder.Title"].Value, headers, data);
        var name  = $"MaintWorkOrder_{DbClock.Now:yyyyMMdd_HHmmss}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["MNT.WorkOrder.Ok.Exported"].Value, _rows.Count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(6000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    // ── 표시 헬퍼 ─────────────────────────────────────────────────────
    static string WoNo(MntRepository.MwoRow r) => r.WoNumber ?? $"MWO#{r.WorkOrderId}";

    string EquipName(string? id) =>
        id is null ? "—" : _equipList.FirstOrDefault(e => e.EquipID == id)?.EquipName is { Length: > 0 } n ? n : "—";
    string EquipText(string? id) =>
        id is null ? "" : EquipName(id) is var n && n != "—" ? $"[{id}] {n}" : $"[{id}]";
    // 담당자 = AspNetUsers.Id → "이름 (사번)" (행위자 표시 규칙). 사전에 없는 값(구 데이터)은 그대로
    string TechText(string? id) => string.IsNullOrEmpty(id) ? "—" : Actors.Display(id);

    static bool IsOpen(string? s)   => MwoStatusRules.IsNotStarted(s);
    static bool IsProg(string? s)   => s == MwoStatusCodes.InProgress;
    static bool IsDone(string? s)   => MwoStatusRules.IsEnded(s);
    static bool IsClosed(string? s) => s == MwoStatusCodes.Closed;
    // 고장·안돈 원천이면 완료 모달에 근본 원인 칸을 보인다
    static bool HasFailureSource(MntRepository.MwoRow r) => r.SourceType is "FAILURE" or "ANDON" || r.WoType == MwoTypeCodes.Cm;

    // 상태 라벨은 MNT_STATUS 공통코드 LocalName, 미등록 코드는 원문
    string StatusLabel(string? s) =>
        s is null ? "—" : _statusItems.FirstOrDefault(c => c.CodeValue == s) is { } c ? MasterDataRepository.LocalName(c) : s;
    // 목록·상세 상태 — 「예정」(계산값)이면 상태 코드 대신 예정으로 보인다
    string RowStatusLabel(MntRepository.MwoRow r) => r.Planned ? L["MNT.WorkOrder.Status.Planned"].Value : StatusLabel(r.Status);
    static string RowStCls(MntRepository.MwoRow r) => r.Planned ? "info" : StCls(r.Status);
    string? PlannedTip(MntRepository.MwoRow r) => r.Planned && r.PmDueDate is { } d
        ? string.Format(L["MNT.WorkOrder.Hint.Planned"].Value, d.ToString(DateFmt.Date), _leadDays, StatusLabel(r.Status)) : null;
    string PmClassLabel(string? c) =>
        c is null ? "—" : _pmClasses.FirstOrDefault(x => x.CodeValue == c) is { } i ? MasterDataRepository.LocalName(i) : c;

    static string StCls(string? s) => s switch
    {
        MwoStatusCodes.Issued     => "bad",
        MwoStatusCodes.Assigned   => "orange",
        MwoStatusCodes.InProgress => "warn",
        MwoStatusCodes.Completed  => "ok",
        _                         => "mute",   // CLOSED(종료)·미등록
    };

    // 유형 라벨은 MWO_TYPE 공통코드 LocalName, 미등록 코드는 원문
    string TypeLabel(string? t) =>
        t is null ? "—" : _typeItems.FirstOrDefault(c => c.CodeValue == t) is { } c ? MasterDataRepository.LocalName(c) : t;
    static string TypeCls(string? t) => t switch { MwoTypeCodes.Pm => "info", MwoTypeCodes.Cm => "orange", MwoTypeCodes.PdM => "ok", _ => "mute" };

    string ResultLabel(string? c) =>
        c is null ? "—" : _resultItems.FirstOrDefault(x => x.CodeValue == c) is { } i ? MasterDataRepository.LocalName(i) : c;
    static string ResultCls(string? c) => c switch { MwoResultCodes.Ok => "ok", MwoResultCodes.Partial => "warn", MwoResultCodes.FollowUp => "bad", _ => "mute" };

    // PartsUsedJSON → "부품 × 수량"(옛 자유 입력은 그대로) — 규칙은 MwoPartsUsed
    static string PartsText(string? json) => MwoPartsUsed.Describe(json);

    string SourceLabel(string? s) => s switch
    {
        null      => "—",
        "PM"      => L["MNT.WorkOrder.Src.PM"],
        "FAILURE" => L["MNT.WorkOrder.Src.Failure"],
        "ANDON"   => L["MNT.WorkOrder.Src.Andon"],
        "MANUAL"  => L["MNT.WorkOrder.Src.Manual"],
        MntRepository.CheckFollowUpSource => L["MNT.WorkOrder.Src.Check"],
        _         => s,
    };

    static string PrCls(string? p) => p switch { "URGENT" or "HIGH" => "bad", "MED" => "warn", "LOW" => "info", _ => "mute" };

    // MNT-004 금형 소진율과 같은 막대 구조 — 점검 항목 완료율
    static MarkupString Bar(decimal v)
    {
        var w   = Math.Min(100m, Math.Max(0m, v)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        var cls = v >= 100m ? "ok" : v > 0m ? "warn" : "crit";
        return new MarkupString(
            $"<div class=\"mnt-mold-bar\"><div class=\"mnt-mold-track\"><i class=\"mnt-mold-fill-{cls}\" style=\"width:{w}%\"></i></div>" +
            $"<span class=\"mnt-mold-bar-val\">{v:F0}%</span></div>");
    }
}
