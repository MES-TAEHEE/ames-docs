                        <span class="dim" style="flex:2;font-size:var(--ames-fs-hint);">@L["MNT.WorkOrder.Hint.PmNextDue"]</span>
                    </RadzenStack>
                }
                @if (_f.Result is MwoResultCodes.Partial or MwoResultCodes.FollowUp && HasFailureSource(_sel))
                {
                    <div class="pill warn" style="white-space:normal;">@L["MNT.WorkOrder.Hint.FollowUp"]</div>
                }

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.Labor"]" class="ames-rz-modal-label" Component="CompleteNumericLabor" />
                    <RadzenNumeric TValue="int?" Name="CompleteNumericLabor" @bind-Value="_f.LaborMinutes" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.Tech"]" class="ames-rz-modal-label" Component="CompleteDropDownTech" />
                    <RadzenDropDown AllowFiltering="true" Name="CompleteDropDownTech" @bind-Value="_f.TechId" Data="@TechOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.None"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
