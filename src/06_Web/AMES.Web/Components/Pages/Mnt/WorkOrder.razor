                @* 사용 부품 — 웹은 입력·차감하지 않는다. PDA 예비품 출고(SP-07)가 이 작업지시로 출고한 부품을 완료 때 기록한다(10-15 (b)) *@
                <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="width:100%;">
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.PartsPda"]" />
                    <div class="dim" style="font-size:var(--ames-fs-hint);">@L["MNT.WorkOrder.Hint.PartsPda"]</div>
                    <RadzenTextBox Value="@ReleasesText()" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenStack>
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["MNT.WorkOrder.Btn.Complete"])" Click="@SaveComplete" Disabled="@_busy" Icon="task_alt" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@(() => OpenDetail(_sel))" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

