@page "/mnt/work-order"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Contracts.Dto
@using AMES.Data.Repositories
@using AMES.Data.Services
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MntRepository Mnt
@inject AuditLogger Audit
@inject MasterDataRepository MD
@inject SysRepository Sys
@inject ActorNames Actors
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-007 @L["MNT.WorkOrder.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MNT-007" TitleKey="MNT.WorkOrder.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allRows.Count</div>
            <div class="ames-kpi-s">@string.Format(L["MNT.WorkOrder.Kpi.TotalSub"].Value, _topN)</div>
        </div>
    </div>
    <div class="ames-kpi @(OpenCount > 0 ? "bad" : "")">
        <div class="ames-kpi-l">@L["MNT.WorkOrder.Kpi.Open"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@OpenCount</div>
            <div class="ames-kpi-s">@(PlannedCount > 0 ? string.Format(L["MNT.WorkOrder.Kpi.OpenSubPlanned"].Value, PlannedCount) : "ISSUED · ASSIGNED")</div>
        </div>
    </div>
    <div class="ames-kpi @(UnassignedCount > 0 ? "warn" : "")">
        <div class="ames-kpi-l">@L["MNT.WorkOrder.Kpi.Unassigned"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@UnassignedCount</div>
            <div class="ames-kpi-s">@L["MNT.WorkOrder.Kpi.UnassignedSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(ProgCount > 0 ? "warn" : "")">
        <div class="ames-kpi-l">@L["MNT.WorkOrder.Kpi.Prog"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@ProgCount</div>
            <div class="ames-kpi-s">IN_PROGRESS</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["MNT.WorkOrder.Kpi.Done"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@DoneCount</div>
            <div class="ames-kpi-s">COMPLETED · CLOSED</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MNT.WorkOrder.Kpi.Labor"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allRows.Sum(r => r.LaborMinutes ?? 0).ToString("N0")</div>
            <div class="ames-kpi-s">@L["MNT.WorkOrder.Kpi.LaborSub"]</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.WorkOrder.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MNT.WorkOrder.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:220px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fType" Data="@TypeFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" />
            <RadzenLabel Text="@L["Col.Priority"]" Component="DropDownPriority" />
            <RadzenDropDown Name="DropDownPriority" @bind-Value="_fPriority" Data="@PriorityFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
            <RadzenLabel Text="@L["Lbl.Recent"]" Component="DropDownTopN" />
            <RadzenDropDown Name="DropDownTopN" @bind-Value="_topN" Data="@TopNOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Search" class="ames-rz-btn" />
            <RadzenButton Text="@L["MNT.WorkOrder.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@ExportXlsx" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["MNT.WorkOrder.Btn.Issue"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenIssue" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>
    <div class="dim" style="font-size:var(--ames-fs-hint);padding:0 0 6px;">@L["MNT.WorkOrder.Hint.Detail"]</div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MntRepository.MwoRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MNT.WorkOrder.Empty"]" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Title="@L["Col.RowNo"]" Width="60px" MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                <Template Context="rn"><span class="dim">@GridRowNo.Of(_pgGrid, rn)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="WoNumber" Title="@L["Col.MwoNo"]" TextAlign="TextAlign.Center" Width="150px">
                <Template Context="r"><span class="code">@WoNo(r)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="WoType" Title="@L["Col.Type"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="pill @TypeCls(r.WoType)">@TypeLabel(r.WoType)</span>@if (PmRules.IsMaint(r.PmClass)) { <span class="pill mute" style="margin-left:4px;">@PmClassLabel(r.PmClass)</span> }</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="EquipId" Title="@L["Col.EquipId"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="code">@(r.EquipId ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Title="@L["Col.EquipName"]">
                <Template Context="r"><span style="white-space:nowrap;">@EquipName(r.EquipId)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="Priority" Title="@L["Col.Priority"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="pill @PrCls(r.Priority)">@(r.Priority ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="SourceType" Title="@L["Col.Source"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="dim">@SourceLabel(r.SourceType)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="AssignedTechId" Title="@L["Col.AssignedTech"]" TextAlign="TextAlign.Center" Width="150px">
                <Template Context="r"><span class="@(r.AssignedTechId is null ? "dim" : "")" style="white-space:nowrap;">@TechText(r.AssignedTechId)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="130px">
                <Template Context="r"><span class="pill @RowStCls(r)" title="@PlannedTip(r)">@RowStatusLabel(r)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="IssuedAt" Title="@L["Col.IssuedDate"]" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="r"><span class="dim">@(r.IssuedAt?.ToString(DateFmt.DateTime) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="StartedAt" Title="@L["Col.StartedDate"]" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="r"><span class="dim">@(r.StartedAt?.ToString(DateFmt.DateTime) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="CompletedAt" Title="@L["Col.CompletedDate"]" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="r"><span class="dim">@(r.CompletedAt?.ToString(DateFmt.DateTime) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="LaborMinutes" Title="@L["Col.Duration"]" TextAlign="TextAlign.Right" Width="110px">
                <Template Context="r">@(r.LaborMinutes?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.MwoRow" Property="TaskDone" Title="@L["Col.Tasks"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r"><span class="@(r.TaskCount == 0 ? "dim" : "")">@r.TaskDone / @r.TaskCount</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Detail Modal (읽기 + 배정·착수·완료 진입) ────────────────────── *@
@if (_modal == "detail" && _sel is not null)
{
    var res = MntRepository.ParseResult(_sel.ResultJson);
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MNT.WorkOrder.Title"] <span class="dim" style="font-weight:400;font-size:.9em;">@WoNo(_sel)</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.Equip"]" class="ames-rz-modal-label" Component="DetailTextBoxEquip" />
                <RadzenTextBox Name="DetailTextBoxEquip" Value="@EquipText(_sel.EquipId)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Type"]" />
                    <div style="padding-top:4px;"><span class="pill @TypeCls(_sel.WoType)">@TypeLabel(_sel.WoType)</span></div>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Priority"]" />
                    <div style="padding-top:4px;"><span class="pill @PrCls(_sel.Priority)">@(_sel.Priority ?? "—")</span></div>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <div style="padding-top:4px;"><span class="pill @RowStCls(_sel)" title="@PlannedTip(_sel)">@RowStatusLabel(_sel)</span></div>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Source"]" />
                    <RadzenTextBox Value="@SourceLabel(_sel.SourceType)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.SourceRef"]" />
                    <RadzenTextBox Value="@(_sel.SourceRefId ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.AssignedTech"]" />
                    <RadzenTextBox Value="@(_sel.AssignedTechId is null ? "" : TechText(_sel.AssignedTechId))" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @if (_sel.PmClass is not null)
            {
                <RadzenRow Gap="8px" Style="margin-top:6px;">
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="@L["MNT.PmSchedule.Col.Class"]" />
                        <div style="padding-top:4px;"><span class="pill @(PmRules.IsMaint(_sel.PmClass) ? "mute" : "info")">@PmClassLabel(_sel.PmClass)</span></div>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="@L["Col.NextDue"]" />
                        <RadzenTextBox Value="@(_sel.PmDueDate?.ToString(DateFmt.Date) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>
            }

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.IssuedDate"]" />
                    <RadzenTextBox Value="@(_sel.IssuedAt?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.StartedDate"]" />
                    <RadzenTextBox Value="@(_sel.StartedAt?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    @if (IsClosed(_sel.Status))
                    {
                        <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.ClosedAt"]" />
                        <RadzenTextBox Value="@(_sel.ClosedAt?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    }
                    else
                    {
                        <RadzenLabel Text="@L["Col.CompletedDate"]" />
                        <RadzenTextBox Value="@(_sel.CompletedAt?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    }
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Duration"]" />
                    <RadzenTextBox Value="@(_sel.LaborMinutes?.ToString("N0") ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Tasks"]" />
                    <RadzenTextBox Value="@($"{_sel.TaskDone} / {_sel.TaskCount}")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.Progress"]" />
                    <div style="padding-top:6px;">@(_sel.TaskCount > 0 ? Bar(100m * _sel.TaskDone / _sel.TaskCount) : Dash)</div>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="margin-top:6px;">
                <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.Desc"]" />
                <RadzenTextArea Value="@(_sel.ActionDesc ?? "")" Disabled="true" Rows="2" class="ames-rz-input" Style="width:100%;" />
            </RadzenStack>

            @* 점검 항목 — PM 발행 때 템플릿(MD-027) 단계를 복사한 것. 진행 중이고 수정 권한이면 항목마다 결과·메모를 기록한다 *@
            @if (_woTasks.Count > 0)
            {
                var canCheck = _canEdit && _sel.Status == MwoStatusCodes.InProgress;
                <div class="mnt-chk">
                    <div class="mnt-chk-h">
                        <span>@L["MNT.WorkOrder.Chk.Title"] <span class="dim">@_woTasks.Count(t => MntResultCodes.IsChecked(t.Result)) / @_woTasks.Count</span></span>
                        @if (!canCheck)
                        {
                            <span class="dim" style="font-size:var(--ames-fs-hint);">@L[_canEdit && !IsDone(_sel.Status) ? "MNT.WorkOrder.Chk.HintStart" : "MNT.WorkOrder.Chk.ReadOnly"]</span>
                        }
                    </div>
                    @foreach (var t in _woTasks)
                    {
                        var task = t;
                        <div class="mnt-chk-row">
                            <div class="mnt-chk-top">
                                <span class="code">@(task.TaskSeq?.ToString() ?? "—")</span>
                                <span class="mnt-chk-name">@(task.TaskName ?? "—")</span>
                                @if (canCheck)
                                {
                                    <RadzenDropDown TValue="string" Value="@(task.Result ?? MntResultCodes.Pending)" ValueChanged="@(v => SaveTaskResult(task, v, task.Note))" Data="@ChkResultOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
                                }
                                else
                                {
                                    <span class="pill @ChkCls(task.Result)">@ChkLabel(task.Result)</span>
                                }
                            </div>
                            <div class="mnt-chk-sub dim">
                                @if (!string.IsNullOrEmpty(task.AcceptanceCriteria)) { <span>@L["Col.PassCriteria"]: @task.AcceptanceCriteria</span> }
                                @if (!string.IsNullOrEmpty(task.RequiredSparePartNo)) { <span>@L["Col.RequiredPart"]: @(task.PartNo is null ? task.RequiredSparePartNo : $"[{task.PartNo}] {task.PartName}") × @task.RequiredQty</span> }
                                @if (task.StepDurationMin is int dm) { <span>@string.Format(L["MNT.WorkOrder.Chk.Minutes"].Value, dm)</span> }
                                @if (task.CompletedAt is DateTime ca) { <span>@Actors.Display(task.CompletedBy) · @ca.ToString(DateFmt.DateTime)</span> }
                            </div>
                            @if (canCheck)
                            {
                                <RadzenTextBox Value="@(task.Note ?? "")" Change="@(v => SaveTaskResult(task, task.Result ?? MntResultCodes.Pending, v))" MaxLength="500" Placeholder="@L["MNT.WorkOrder.Chk.PhNote"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;margin-top:4px;" />
                            }
                            else if (!string.IsNullOrEmpty(task.Note))
                            {
                                <div class="mnt-chk-sub">@task.Note</div>
                            }
                        </div>
                    }
                </div>
            }

            @if (IsClosed(_sel.Status))
            {
                @* 종료 — 결과 JSON 의 Action 이 종료 사유(MntRepository.CloseWorkOrder) *@
                <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="margin-top:6px;">
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.CloseReason"]" />
                    <RadzenTextArea Value="@(res?.Action ?? "")" Disabled="true" Rows="2" class="ames-rz-input" Style="width:100%;" />
                </RadzenStack>
            }
            else if (res is not null || !string.IsNullOrEmpty(_sel.PartsUsedJson))
            {
                <RadzenRow Gap="8px" Style="margin-top:6px;">
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.Result"]" />
                        <div style="padding-top:4px;"><span class="pill @ResultCls(res?.Result)">@ResultLabel(res?.Result)</span></div>
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.RootCause"]" />
                        <RadzenTextBox Value="@(res?.RootCause ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="margin-top:6px;">
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.Action"]" />
                    <RadzenTextArea Value="@(res?.Action ?? "")" Disabled="true" Rows="2" class="ames-rz-input" Style="width:100%;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="margin-top:6px;">
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.Parts"]" />
                    <RadzenTextBox Value="@PartsText(_sel.PartsUsedJson)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenStack>
            }

            @if (!IsDone(_sel.Status) && _woReleases.Count > 0)
            {
                @* 진행 중 작업지시에 PDA 로 이미 출고된 부품 — 완료·종료 때 사용 부품으로 기록된다 *@
                <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="margin-top:6px;">
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.PartsPda"]" />
                    <RadzenTextBox Value="@ReleasesText()" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenStack>
            }

            @* 연결된 고장의 대응 이력(고장 등록 → 보전 도착·ACK → 수리 완료) — 고장 번호를 누르면 MNT-002 상세 *@
            @foreach (var f in _woFailures)
            {
                @* 부분·후속 완료로 후속 작업지시에 넘어간 고장 — 이 작업지시의 조치 이력으로 찾았다(MNT_FailureAction.WorkOrderID) *@
                @if (f.WorkOrderId is int curWo && curWo != _sel.WorkOrderId)
                {
                    var next = _allRows.FirstOrDefault(w => w.WorkOrderId == curWo);
                    var txt  = L["MNT.WorkOrder.Hint.FailureMoved"].Value.Split("{0}");
                    <div class="dim" style="margin-top:8px;">
                        @txt[0]@if (next is not null)
                        {
                            <a href="javascript:void(0)" @onclick="@(() => OpenDetail(next))">@(f.WoNumber ?? next.WoNumber)</a>
                        }
                        else
                        {
                            <b>@(f.WoNumber ?? $"#{curWo}")</b>
                        }@(txt.Length > 1 ? txt[1] : "")
                    </div>
                }
                <FailureTimelinePanel @key="f.FailureId" Failure="f" Caption="@(f.FailureNumber ?? $"F#{f.FailureId}")" Href="@(_canOpenFailure ? $"/mnt/failure?id={f.FailureId}" : null)" />
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                @if (_canEdit && MwoStatusRules.CanAssign(_sel.Status))
                {
                    <RadzenButton Text="@L["MNT.WorkOrder.Btn.Assign"]" Icon="person_add" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => OpenAssign(_sel))" class="ames-rz-btn" />
                }
                @if (_canEdit && MwoStatusRules.CanStart(_sel.Status))
                {
