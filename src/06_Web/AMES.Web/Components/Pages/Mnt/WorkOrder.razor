@page "/mnt/work-order"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MntRepository Mnt

<PageTitle>MNT-07 Maintenance WO · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MNT-07</div>
    <div class="ames-page-t">Maintenance Work Orders</div>
    <div class="ames-page-sub">정비 작업지시 — 진행/완료</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi bad"><div class="ames-kpi-l">OPEN</div>
        <div class="ames-kpi-v">@_open</div><div class="ames-kpi-s">new / issued</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">IN PROGRESS</div>
        <div class="ames-kpi-v">@_prog</div><div class="ames-kpi-s">started</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">COMPLETED</div>
        <div class="ames-kpi-v">@_done</div><div class="ames-kpi-s">closed</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">LABOR (min)</div>
        <div class="ames-kpi-v">@_lab.ToString("N0")</div><div class="ames-kpi-s">total recorded</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h">MWO list</div>
    <table class="ames-table">
        <thead>
            <tr>
                <th>MWO #</th><th>Type</th><th>Equip</th><th>Priority</th>
                <th>Source</th><th>Status</th>
                <th>Issued</th><th>Started</th><th>Completed</th>
                <th class="num">Labor</th><th class="num">Tasks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in _rows)
            {
                <tr>
                    <td class="code">@(w.WoNumber ?? $"MWO#{w.WorkOrderId}")</td>
                    <td>@(w.WoType ?? "—")</td>
                    <td>@(w.EquipId ?? "—")</td>
                    <td><span class="pill @PrClass(w.Priority)">@(w.Priority ?? "—")</span></td>
                    <td class="dim">@(w.SourceType ?? "—")</td>
                    <td><span class="pill @StClass(w.Status)">@(w.Status ?? "—")</span></td>
                    <td class="dim">@(w.IssuedAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                    <td class="dim">@(w.StartedAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                    <td class="dim">@(w.CompletedAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                    <td class="num">@(w.LaborMinutes?.ToString() ?? "—")</td>
                    <td class="num">@w.TaskDone / @w.TaskCount</td>
                </tr>
            }
        </tbody>
    </table>
    @if (_rows.Count == 0) { <div class="ames-empty">No maintenance work orders.</div> }
</div>

@code {
    List<AMES.Data.Repositories.MntRepository.MwoRow> _rows = new();
    int _open, _prog, _done, _lab;

    protected override void OnInitialized()
    {
        try { _rows = Mnt.ListWorkOrders(); } catch { }
        _open = _rows.Count(r => r.Status is "OPEN" or "ISSUED");
        _prog = _rows.Count(r => r.Status == "IN_PROGRESS");
        _done = _rows.Count(r => r.Status is "COMPLETED" or "CLOSED");
        _lab  = _rows.Sum(r => r.LaborMinutes ?? 0);
    }
    static string PrClass(string? p) => p switch
    { "URGENT" or "HIGH" => "bad", "MED" => "warn", "LOW" => "info", _ => "info" };
    static string StClass(string? s) => s switch
    { "OPEN" or "ISSUED"        => "bad",
      "IN_PROGRESS"             => "warn",
      "COMPLETED" or "CLOSED"   => "ok", _ => "info" };
}
