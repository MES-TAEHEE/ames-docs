@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    bool _showPagerSummary = true;
    int  _pageRows = 25;   // 고정 페이저: 본문 높이 = 헤더 + 페이지 행 수 × 행 높이(.ames-grid-fixed)
    List<MntRepository.MwoRow>              _allRows     = new();
    List<MntRepository.MwoRow>              _rows        = new();
    List<MasterDataRepository.EquipmentRow> _equipList   = new();
    List<MasterDataRepository.CodeItemRow>  _typeItems   = new();   // 공통코드 MWO_TYPE (PM/CM/PdM)
    List<MasterDataRepository.CodeItemRow>  _resultItems = new();   // 공통코드 MWO_RESULT (OK/PARTIAL/FOLLOWUP)
    List<MasterDataRepository.CodeItemRow>  _statusItems = new();   // 공통코드 MNT_STATUS (ISSUED/ASSIGNED/IN_PROGRESS/COMPLETED/CLOSED)
    List<SysRepository.UserRow>             _users       = new();   // 담당자 후보 = 웹 사용자 (PM 일정의 AssignedTechID 와 같은 기준)
    MntRepository.MwoRow? _sel;

    string  _fSearch = "";
    string? _fStatus, _fType, _fPriority;
    int     _topN = 100;
    string  _modal = "", _msg = "", _modalErr = "";
    bool    _bgMouseDownOnSelf, _isErr, _busy, _canEdit, _canApprove;   // 완료는 승인 권한(A) — 배정·착수는 수정 권한(E)
    string  _actor = "system";
    FormModel _f = new();

    // 우선순위는 공통코드 그룹이 없어 발행 코드가 쓰는 값을 정본으로 두고, 데이터에만 있는 값을 뒤에 붙인다
    static readonly string[] PriorityCodes = { "URGENT", "HIGH", "MED", "LOW" };
    static readonly int[]    TopNs         = { 50, 100, 200, 500 };
    static readonly MarkupString Dash = new("<span class=\"dim\">—</span>");

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; public bool Disabled { get; set; } }
    public class TopNItem     { public string Text { get; set; } = ""; public int Value { get; set; } }

    // 상태 콤보: MNT_STATUS 공통코드 ∪ 데이터에만 있는 값
    // 「예정」은 상태 코드가 아니라 계산값 — 기본 목록에서는 빠지고 이 항목을 고르면 그것만 보인다
    const string PlannedFilter = "*PLANNED";
    IEnumerable<DropDownItem> StatusFilterOptions   => WithDataValues(_statusItems.Where(c => c.UseFlag).Select(c => c.CodeValue ?? "").ToArray(), _allRows.Select(r => r.Status), StatusLabel)
        .Append(new DropDownItem { Value = PlannedFilter, Text = L["MNT.WorkOrder.Status.Planned"].Value });
    IEnumerable<DropDownItem> TypeOptions =>
        _typeItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    IEnumerable<DropDownItem> PriorityOptions => PriorityCodes.Select(p => new DropDownItem { Value = p, Text = p });
    IEnumerable<DropDownItem> EquipOptions => _equipList.Select(e => new DropDownItem { Value = e.EquipID, Text = string.IsNullOrEmpty(e.EquipName) ? $"[{e.EquipID}]" : $"[{e.EquipID}] {e.EquipName}" });
    // 유형 콤보: MWO_TYPE 공통코드 ∪ 데이터에만 있는 값(코드 미등록 값도 걸러 볼 수 있게)
    IEnumerable<DropDownItem> TypeFilterOptions =>
        _typeItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" })
        .Concat(_allRows.Select(r => r.WoType).Where(t => t is { Length: > 0 } && !_typeItems.Any(c => c.CodeValue == t)).Distinct().Select(t => new DropDownItem { Value = t!, Text = $"[{t}]" }));
    IEnumerable<DropDownItem> PriorityFilterOptions => WithDataValues(PriorityCodes, _allRows.Select(r => r.Priority), p => p ?? "");
    IEnumerable<TopNItem>     TopNOptions           => TopNs.Select(n => new TopNItem { Value = n, Text = $"{n}{L["Lbl.Items"]}" });
    // 미점검·불합격이 있으면 정상 완료는 고를 수 없다(MwoChecklistRules)
    IEnumerable<DropDownItem> ResultOptions =>
        _resultItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}",
            Disabled = !MwoChecklistRules.Allows(c.CodeValue, TaskPending, TaskFailed) });
    int TaskPending => _woTasks.Count(t => !MntResultCodes.IsChecked(t.Result));
    int TaskFailed  => _woTasks.Count(t => t.Result == MntResultCodes.Fail);
    // 담당자 후보 = 부서가 보전(MAINTENANCE)인 등록 계정(MntTechnicians) — 이미 저장된 담당자는 수정 창에서 빈칸이 되지 않게 남긴다
    IEnumerable<DropDownItem> TechOptions => _users.Where(u => (u.IsApproved && MntTechnicians.IsCandidate(u.Department) || u.UserId == _f.TechId) && (!string.IsNullOrEmpty(u.EmployeeName) || !string.IsNullOrEmpty(u.UserName)))
        .Select(u => new DropDownItem { Value = u.UserId, Text = string.IsNullOrEmpty(u.EmployeeNo) ? (u.EmployeeName ?? u.UserName ?? u.UserId) : $"[{u.EmployeeNo}] {u.EmployeeName ?? u.UserName}" });   // 콤보 = [사번] 이름 (PM 보드와 같은 형식)

    static IEnumerable<DropDownItem> WithDataValues(string[] codes, IEnumerable<string?> data, Func<string?, string> label) =>
        codes.Concat(data.Where(v => v is { Length: > 0 } && !codes.Contains(v)).Distinct()!)
             .Select(c => new DropDownItem { Value = c!, Text = $"[{c}] {label(c)}" });

    // 「예정」 PM 작업지시(PmRules — 예정일까지 N일보다 많이 남음)는 미착수·미배정에서 빼고 따로 센다
    int OpenCount       => _allRows.Count(r => IsOpen(r.Status) && !r.Planned);
    int PlannedCount    => _allRows.Count(r => r.Planned);
    int ProgCount       => _allRows.Count(r => IsProg(r.Status));
    int DoneCount       => _allRows.Count(r => IsDone(r.Status));
    int UnassignedCount => _allRows.Count(r => !IsDone(r.Status) && !r.Planned && string.IsNullOrEmpty(r.AssignedTechId));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = AMES.Web.Services.ActorCode.Of(auth.User, "system");
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("mnt/work-order");
        _canApprove = PermSvc.CanApprove("mnt/work-order");
        _canOpenFailure = PermSvc.IsVisible("mnt/failure");

        try { _equipList   = MD.ListEquipments(); } catch { }
        try { _typeItems   = MD.ListCodeItems(MwoTypeCodes.Group); } catch { }
        try { _resultItems = MD.ListCodeItems(MwoResultCodes.Group); } catch { }
        try { _statusItems = MD.ListCodeItems(MwoStatusCodes.Group); } catch { }
        try { _chkItems    = MD.ListCodeItems(MntResultCodes.Group); } catch { }
        try { _pmClasses   = MD.ListCodeItems("PM_CLASS"); } catch { }
        try { _leadDays    = Mnt.ReadPmLeadDays(); } catch { }
        try { _users       = Sys.ListUsers(500); } catch { }
        Reload();

        // MNT-005·010 「PM 완료」 → ?id=작업지시&complete=1 — 목록(최근 N건) 밖이면 한 건을 따로 읽는다
        if (QId is int qid)
        {
            MntRepository.MwoRow? row = _allRows.FirstOrDefault(r => r.WorkOrderId == qid);
            if (row is null) try { row = Mnt.FindWorkOrder(qid); } catch { }
            if (row is not null)
            {
                OpenDetail(row);
                if (QComplete == 1 && _canApprove && MwoStatusRules.CanComplete(row.Status)) OpenComplete(row);
            }
        }
    }

