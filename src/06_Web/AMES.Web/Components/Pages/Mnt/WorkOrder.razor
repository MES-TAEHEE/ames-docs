@* ── 완료 모달 — 완료 시 고장 RESOLVED · PM 실시일/예정일 갱신 · 실행 이력 (MntRepository.CompleteWorkOrder) ── *@
@if (_modal == "complete" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MNT.WorkOrder.Modal.Complete"] <span class="dim" style="font-weight:400;font-size:.9em;margin-left:6px;">@WoNo(_sel) · @EquipText(_sel.EquipId)</span></div>
            <div class="dim" style="font-size:var(--ames-fs-hint);">@L["MNT.WorkOrder.Hint.Complete"]</div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["MNT.WorkOrder.Lbl.Result"]} *")' class="ames-rz-modal-label" Component="CompleteDropDownResult" />
                    <RadzenDropDown Name="CompleteDropDownResult" @bind-Value="_f.Result" Data="@ResultOptions" TextProperty="Text" ValueProperty="Value" DisabledProperty="Disabled" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    <RadzenLabel Text='@($"{L["MNT.WorkOrder.Lbl.CompletedAt"]} *")' class="ames-rz-modal-label" Component="CompleteDateAt" />
                    <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" Name="CompleteDateAt" @bind-Value="_f.CompletedAt" ShowTime="true" ShowTimeOkButton="false" HourFormat="24" DateFormat="@DateFmt.DateTime" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
                @* 미점검·불합격이 있으면 정상 완료는 막고(MwoChecklistRules), 불합격은 부분·후속 완료 때 CM 후속 작업지시로 넘어간다 *@
                @if (TaskPending + TaskFailed > 0)
                {
                    <div class="pill warn" style="white-space:normal;">@string.Format(L["MNT.WorkOrder.Chk.WarnComplete"].Value, TaskPending, TaskFailed)</div>
