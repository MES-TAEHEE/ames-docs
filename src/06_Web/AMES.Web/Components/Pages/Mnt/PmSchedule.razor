@page "/mnt/pm-schedule"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MntRepository Mnt
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-05 @L["MNT.PmSchedule.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MNT-05</div>
    <div class="ames-page-t">@L["MNT.PmSchedule.Title"]</div>
    <div class="ames-page-sub">@L["MNT.PmSchedule.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi bad"><div class="ames-kpi-l">OVERDUE</div>
        <div class="ames-kpi-v">@_over</div><div class="ames-kpi-s">due date passed</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">DUE ≤ 3D</div>
        <div class="ames-kpi-v">@_dueSoon</div><div class="ames-kpi-s">urgent</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">DUE ≤ 7D</div>
        <div class="ames-kpi-v">@_dueWeek</div><div class="ames-kpi-s">this week</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">SCHEDULED</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">total in window</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.PmSchedule.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Future"]</label>
            <select class="ames-input" style="width:70px;padding:4px 8px;" @bind="_daysAhead">
                <option value="7">7@L["Lbl.Days"]</option>
                <option value="14">14@L["Lbl.Days"]</option>
                <option value="30">30@L["Lbl.Days"]</option>
                <option value="60">60@L["Lbl.Days"]</option>
                <option value="90">90@L["Lbl.Days"]</option>
            </select>
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Past"]</label>
            <select class="ames-input" style="width:70px;padding:4px 8px;" @bind="_daysBack">
                <option value="0">0@L["Lbl.Days"]</option>
                <option value="7">7@L["Lbl.Days"]</option>
                <option value="14">14@L["Lbl.Days"]</option>
                <option value="30">30@L["Lbl.Days"]</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MNT.PmSchedule.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>PM #</th><th>Equip</th><th>Type</th>
                    <th>Basis</th><th class="num">Cycle</th>
                    <th>Last PM</th><th>Next due</th><th class="num">Days</th>
                    <th>Status</th><th>Active MWO</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _rows)
                {
                    <tr>
                        <td class="code">@(p.PmPlanNumber ?? $"PM#{p.PmScheduleId}")</td>
                        <td>@(p.EquipId ?? "—")</td>
                        <td>@(p.PmType ?? "—")</td>
                        <td class="dim">@(p.CycleBasis ?? "—")</td>
                        <td class="num">@(p.CycleValue?.ToString() ?? "—")</td>
                        <td class="dim">@(p.LastPmDate?.ToString("MM-dd") ?? "—")</td>
                        <td class="dim">@(p.NextDueDate?.ToString("MM-dd") ?? "—")</td>
                        <td class="num"><span class="pill @StClass(p.Status)">@p.DaysToDue</span></td>
                        <td><span class="pill @StClass(p.Status)">@(p.Status ?? "—")</span></td>
                        <td class="dim">@(p.ActiveWoId?.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.MntRepository.PmRow> _rows = new();
    int _over, _dueSoon, _dueWeek;
    int _daysAhead = 30, _daysBack = 7;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _rows = Mnt.ListPmSchedule(_daysAhead, _daysBack); } catch { _rows = new(); }
        _over    = _rows.Count(r => r.DaysToDue < 0);
        _dueSoon = _rows.Count(r => r.DaysToDue >= 0 && r.DaysToDue <= 3);
        _dueWeek = _rows.Count(r => r.DaysToDue >= 0 && r.DaysToDue <= 7);
    }

    static string StClass(string? s) => s switch
    { "OVERDUE" => "bad", "DUE" => "warn", "OK" => "ok", _ => "info" };
}
