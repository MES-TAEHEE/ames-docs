@page "/mnt/oee-analysis"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MntRepository Mnt
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-003 @L["MNT.OeeAnalysis.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MNT-003" TitleKey="MNT.OeeAnalysis.Title" />

<div class="ames-kpis">
    <div class="ames-kpi @KpiClass(_avgOee, 75, 85)">
        <div class="ames-kpi-l">AVG OEE</div>
        <div class="ames-kpi-v">@_avgOee.ToString("0.0")%</div>
        <div class="ames-kpi-s">@_daysBack d, all equip</div>
    </div>
    <div class="ames-kpi @KpiClass(_avgAvail, 80, 90)">
        <div class="ames-kpi-l">AVAILABILITY</div>
        <div class="ames-kpi-v">@_avgAvail.ToString("0.0")%</div>
        <div class="ames-kpi-s">A</div>
    </div>
    <div class="ames-kpi @KpiClass(_avgPerf, 80, 90)">
        <div class="ames-kpi-l">PERFORMANCE</div>
        <div class="ames-kpi-v">@_avgPerf.ToString("0.0")%</div>
        <div class="ames-kpi-s">P</div>
    </div>
    <div class="ames-kpi @KpiClass(_avgQual, 95, 99)">
        <div class="ames-kpi-l">QUALITY</div>
        <div class="ames-kpi-v">@_avgQual.ToString("0.0")%</div>
        <div class="ames-kpi-s">Q</div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.OeeAnalysis.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:120px;padding:4px 8px;"
                   placeholder="@L["MNT.OeeAnalysis.Ph.Equip"]" @bind="_fEquip" autocomplete="off" />
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Period"]</label>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_daysBack">
                <option value="7">7@(L["Lbl.Days"])</option>
                <option value="14">14@(L["Lbl.Days"])</option>
                <option value="30">30@(L["Lbl.Days"])</option>
                <option value="60">60@(L["Lbl.Days"])</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>
</div>

@foreach (var eq in _rows.GroupBy(r => r.EquipId).OrderBy(g => g.Key).Skip(_page * _pageSize).Take(_pageSize))
{
    <div class="ames-card">
        <div class="ames-card-h">▼ @eq.Key  ·  @eq.Count() rows  ·  avg OEE @(eq.Average(x => x.Oee ?? 0m).ToString("0.0"))%</div>
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.Date"]</th><th>@L["Col.Shift"]</th><th>@L["Col.Line"]</th>
                    <th class="num">@L["Col.Plan"]</th><th class="num">@L["Col.MinDT"]</th>
                    <th class="num">@L["Col.Availability"]</th><th class="num">@L["Col.Performance"]</th><th class="num">@L["Col.Quality"]</th><th class="num">@L["Col.OEE"]</th>
                    <th class="num">@L["Col.Good"]</th><th class="num">@L["Col.Total"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in eq.OrderByDescending(x => x.AggDate).ThenBy(x => x.ShiftCode))
                {
                    <tr>
                        <td class="dim">@(r.AggDate?.ToString("MM-dd") ?? "—")</td>
                        <td class="code">@(r.ShiftCode ?? "—")</td>
                        <td class="dim">@(r.LineId ?? "—")</td>
                        <td class="num">@(r.PlannedTimeMin?.ToString() ?? "—")</td>
                        <td class="num">@(r.DowntimeMin?.ToString() ?? "—")</td>
                        <td class="num">@(r.Availability?.ToString("0.0") ?? "—")</td>
                        <td class="num">@(r.Performance?.ToString("0.0") ?? "—")</td>
                        <td class="num">@(r.Quality?.ToString("0.0") ?? "—")</td>
                        <td class="num">@(r.Oee?.ToString("0.0") ?? "—")</td>
                        <td class="num">@(r.GoodQty?.ToString("0") ?? "—")</td>
                        <td class="num">@(r.TotalQty?.ToString("0") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_rows.Count > 0)
{
    <Pager Page="_page" Total="_rows.GroupBy(r => r.EquipId).Count()" PageSize="_pageSize" OnPageChange="p => _page = p" />
}
@if (_rows.Count == 0)
{
    <div class="ames-card"><div class="ames-empty">@L["MNT.OeeAnalysis.Empty"]</div></div>
}

@code {
    List<AMES.Data.Repositories.MntRepository.OeeRow> _allRows = new();
    List<AMES.Data.Repositories.MntRepository.OeeRow> _rows    = new();
    int _page = 0;
    const int _pageSize = 20;
    decimal _avgOee, _avgAvail, _avgPerf, _avgQual;
    int     _daysBack = 14;
    string  _fEquip   = "";

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Mnt.ListOee(_daysBack); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _page = 0;
        _rows = string.IsNullOrWhiteSpace(_fEquip)
            ? _allRows
            : _allRows.Where(r => (r.EquipId ?? "").Contains(_fEquip, StringComparison.OrdinalIgnoreCase)).ToList();
        if (_rows.Count > 0)
        {
            _avgOee   = _rows.Average(r => r.Oee          ?? 0m);
            _avgAvail = _rows.Average(r => r.Availability ?? 0m);
            _avgPerf  = _rows.Average(r => r.Performance  ?? 0m);
            _avgQual  = _rows.Average(r => r.Quality      ?? 0m);
        }
        else { _avgOee = _avgAvail = _avgPerf = _avgQual = 0m; }
    }

    static string KpiClass(decimal v, decimal warn, decimal ok)
        => v >= ok ? "ok" : v >= warn ? "warn" : "bad";
}
