@page "/mnt/equipment-card"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using Radzen

@attribute [Authorize]

@inject MntRepository Mnt
@inject MasterDataRepository MD
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-001 @L["MNT.EquipmentCard.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MNT-001" TitleKey="MNT.EquipmentCard.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@StatusLabel("RUN")</div>
        <div class="ames-kpi-v">@_allRows.Count(r => IsRun(r.Status))</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@StatusLabel("IDLE")</div>
        <div class="ames-kpi-v">@_allRows.Count(r => IsIdle(r.Status))</div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">@StatusLabel("DOWN")</div>
        <div class="ames-kpi-v">@_allRows.Count(r => IsDown(r.Status))</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MNT.EquipmentCard.Kpi.AvgOee"]</div>
        <div class="ames-kpi-v">@(AvgOee is { } a ? $"{a:0.0}%" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.EquipmentCard.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MNT.EquipmentCard.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Line"]" Component="DropDownLine" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownLine" @bind-Value="_fLine" Data="@LineFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:280px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fType" Data="@EquipTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            <RadzenButton Text="@L["MNT.EquipmentCard.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ExportXlsx" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MntRepository.EquipCardRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MNT.EquipmentCard.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="EquipId" Title="@L["Col.EquipId"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="code">@r.EquipId</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="EquipName" Title="@L["Col.EquipName"]">
                <Template Context="r">@(r.EquipName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="EquipType" Title="@L["Col.EquipType"]" Width="100px">
                <Template Context="r"><span class="pill">@(r.EquipType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="LineId" Title="@L["Col.Line"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="dim">@(r.LineId ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="MakerModel" Title="@L["Col.MakerModel"]" Width="150px">
                <Template Context="r"><span class="dim">@(r.MakerModel ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r"><span class="pill @StatusCls(r.Status)">@StatusLabel(r.Status)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="TodayOee" Title="@L["Col.OEE"]" TextAlign="TextAlign.Right" Width="80px">
                <Template Context="r">@(r.TodayOee?.ToString("0.0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="RuntimeHours" Title="@L["Col.Runtime"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@(r.RuntimeHours?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="CycleCount" Title="@L["Col.Cycles"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@(r.CycleCount?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="NextPmDate" Title="@L["Col.NextPm"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="@(IsPmOverdue(r.NextPmDate) ? "" : "dim")" style="@(IsPmOverdue(r.NextPmDate) ? "color:#f87171;" : "")">@(r.NextPmDate?.ToString(DateFmt.Date) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="OpenWoId" Title="@L["Col.OpenWo"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r">
                    @if (r.OpenWoId is { } wo) { <span class="pill orange">@wo</span> } else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.EquipCardRow" Property="PlcConnTs" Title="@L["Col.PlcConn"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="dim">@(r.PlcConnTs?.ToString("MM-dd HH:mm") ?? "—")</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Detail Modal (읽기 전용 설비 카드) ───────────────────────────── *@
@if (_modal == "detail" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MNT.EquipmentCard.Title"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.EquipId</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.EquipName"]" class="ames-rz-modal-label" Component="DetailTextBoxEquipName" />
                <RadzenTextBox Name="DetailTextBoxEquipName" Value="@(_sel.EquipName ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.EquipType"]" />
                    <RadzenTextBox Value="@(_sel.EquipType ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Line"]" />
                    <RadzenTextBox Value="@LineText(_sel.LineId)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.MakerModel"]" />
                    <RadzenTextBox Value="@(_sel.MakerModel ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InstallDate"]" />
                    <RadzenTextBox Value="@(_sel.InstallDate?.ToString(DateFmt.Date) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <div style="padding-top:4px;"><span class="pill @StatusCls(_sel.Status)">@StatusLabel(_sel.Status)</span></div>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.OEE"]" />
                    <RadzenTextBox Value="@(_sel.TodayOee is { } o ? $"{o:0.0} %" : "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Runtime"]" />
                    <RadzenTextBox Value="@(_sel.RuntimeHours?.ToString("N0") ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Cycles"]" />
                    <RadzenTextBox Value="@(_sel.CycleCount?.ToString("N0") ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.NextPm"]" />
                    <RadzenTextBox Value="@(_sel.NextPmDate?.ToString(DateFmt.Date) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="@(IsPmOverdue(_sel.NextPmDate) ? "width:100%;color:#f87171;" : "width:100%;")" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.OpenWo"]" />
                    <RadzenTextBox Value="@(_sel.OpenWoId?.ToString() ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.MoldId"]" />
                    <RadzenTextBox Value="@(_sel.MountedMoldId ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.PlcConn"]" />
                    <RadzenTextBox Value="@(_sel.PlcConnTs?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@L["Btn.Close"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MntRepository.EquipCardRow>        _allRows     = new();
    List<MntRepository.EquipCardRow>        _rows        = new();
    List<MasterDataRepository.LineRow>      _lineList    = new();
    List<MasterDataRepository.CodeItemRow>  _equipStatus = new();
    MntRepository.EquipCardRow? _sel;

    string _fSearch = "";
    string? _fLine, _fType, _fStatus;
    string _modal = "", _msg = "";
    bool _bgMouseDownOnSelf, _isErr;

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> LineFilterOptions => _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = MasterDataRepository.LocalName(l.LineName, l.LineNameEn) is { Length: > 0 } nm ? $"[{l.LineID}] {nm}" : $"[{l.LineID}]" });
    IEnumerable<DropDownItem> EquipTypeOptions => _allRows.Select(r => r.EquipType).Where(x => x != null).Distinct().OrderBy(x => x).Select(t => new DropDownItem { Value = t!, Text = t! });
    IEnumerable<DropDownItem> StatusFilterOptions => _equipStatus.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });

    // 상태 라벨: EQUIP_STATUS 공통코드 LocalName (다국어), 미등록 코드는 원문 표시
    string StatusLabel(string? code) =>
        code is null ? "—" : _equipStatus.FirstOrDefault(s => s.CodeValue == code) is { } c ? MasterDataRepository.LocalName(c) : code;

    decimal? AvgOee
    {
        get
        {
            var v = _allRows.Where(r => r.TodayOee.HasValue).Select(r => r.TodayOee!.Value).ToList();
            return v.Count > 0 ? v.Average() : null;
        }
    }

    protected override void OnInitialized()
    {
        try { _lineList    = MD.ListLines();                   } catch { }
        try { _equipStatus = MD.ListCodeItems("EQUIP_STATUS"); } catch { }
        Reload();
    }

    RadzenDataGrid<MntRepository.EquipCardRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload()
    {
        try { _allRows = Mnt.ListEquipment(); }
        catch (Exception ex) { _allRows = new(); ShowMsg(ex.Message, true); }
        ApplyFilter();
    }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.EquipId.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EquipName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineId    == _fLine) &&
        (string.IsNullOrEmpty(_fType)   || r.EquipType == _fType) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status    == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MntRepository.EquipCardRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MntRepository.EquipCardRow> args)
    {
        if (args.Data is not null) OpenDetail(args.Data);
    }

    void OpenDetail(MntRepository.EquipCardRow r) { _sel = r; _modal = "detail"; }

    void CloseModal() { _modal = ""; _sel = null; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    // 현재 조회 결과(필터 적용분)를 .xlsx 로 내려받는다 — 화면 컬럼 순서 그대로
    async Task ExportXlsx()
    {
        if (_rows.Count == 0) { ShowMsg(L["MNT.EquipmentCard.Err.NoExport"], true); return; }

        var headers = new[]
        {
            L["Col.EquipId"].Value, L["Col.EquipName"].Value, L["Col.EquipType"].Value, L["Col.Line"].Value,
            L["Col.MakerModel"].Value, L["Col.InstallDate"].Value, L["Col.Status"].Value, L["Col.OEE"].Value,
            L["Col.Runtime"].Value, L["Col.Cycles"].Value, L["Col.NextPm"].Value, L["Col.OpenWo"].Value,
            L["Col.MoldId"].Value, L["Col.PlcConn"].Value,
        };
        var data = _rows.Select(r => (IReadOnlyList<object?>)new object?[]
        {
            r.EquipId, r.EquipName, r.EquipType, LineText(r.LineId),
            r.MakerModel, r.InstallDate?.ToString(DateFmt.Date), StatusLabel(r.Status), r.TodayOee,
            r.RuntimeHours, r.CycleCount, r.NextPmDate?.ToString(DateFmt.Date), r.OpenWoId,
            r.MountedMoldId, r.PlcConnTs?.ToString(DateFmt.DateTime),
        });

        var bytes = AMES.Web.Services.XlsxWriter.Build(L["MNT.EquipmentCard.Title"].Value, headers, data);
        var name  = $"EquipmentCard_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["MNT.EquipmentCard.Ok.Exported"].Value, _rows.Count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    string LineText(string? id) =>
        id is null ? "" : _lineList.FirstOrDefault(l => l.LineID == id) is { } l && MasterDataRepository.LocalName(l.LineName, l.LineNameEn) is { Length: > 0 } nm ? $"[{id}] {nm}" : $"[{id}]";

    // MNT_EquipmentStatus 는 라이브 상태라 EQUIP_STATUS 외 값(RUNNING/SETUP/FAULT 등)이 올 수 있어 동의어를 함께 본다
    static bool IsRun(string? s)  => s is "RUN" or "RUNNING" or "OPERATING";
    static bool IsIdle(string? s) => s is "IDLE" or "SETUP" or "READY";
    static bool IsDown(string? s) => s is "DOWN" or "STOP" or "FAULT";

    static string StatusCls(string? s) =>
        IsRun(s) ? "ok" : IsDown(s) ? "bad" : s == "PM" ? "orange" : IsIdle(s) ? "mute" : "mute";

    static bool IsPmOverdue(DateTime? d) => d is { } dt && dt.Date < DateTime.Today;
}
