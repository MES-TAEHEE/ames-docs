@page "/mnt/equipment-card"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MntRepository Mnt
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-001 @L["MNT.EquipmentCard.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MNT-001" TitleKey="MNT.EquipmentCard.Title" />

<div class="ames-kpis">
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">RUNNING</div>
        <div class="ames-kpi-v">@_running</div>
        <div class="ames-kpi-s">live RUN state</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">IDLE / SETUP</div>
        <div class="ames-kpi-v">@_idle</div>
        <div class="ames-kpi-s">stopped, no failure</div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">DOWN</div>
        <div class="ames-kpi-v">@_down</div>
        <div class="ames-kpi-s">failure / fault</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">AVG OEE</div>
        <div class="ames-kpi-v">@_avgOee.ToString("0.0")%</div>
        <div class="ames-kpi-s">today, all equip</div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.EquipmentCard.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:220px;padding:4px 8px;"
                   placeholder="@L["MNT.EquipmentCard.Ph.Search"]"
                   @bind="_fSearch" @bind:event="oninput" @bind:after="ApplyFilter"
                   autocomplete="off" />
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MNT.EquipmentCard.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.Equip"]</th><th>@L["Col.EquipName"]</th><th>@L["Col.Line"]</th><th>@L["Col.EquipType"]</th>
                    <th>@L["Col.Status"]</th><th class="num">@L["Col.OEE"]</th><th class="num">@L["Col.Runtime"]</th>
                    <th class="num">@L["Col.Cycles"]</th><th>@L["Col.NextPm"]</th><th>@L["Col.OpenWo"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr>
                        <td class="code">@e.EquipId</td>
                        <td>@(e.EquipName ?? "—")</td>
                        <td class="dim">@(e.LineId ?? "—")</td>
                        <td class="dim">@(e.EquipType ?? "—")</td>
                        <td><span class="pill @StatusClass(e.Status)">@(e.Status ?? "—")</span></td>
                        <td class="num">@(e.TodayOee?.ToString("0.0") ?? "—")</td>
                        <td class="num">@(e.RuntimeHours?.ToString("0") ?? "—")</td>
                        <td class="num">@(e.CycleCount?.ToString("N0") ?? "—")</td>
                        <td class="dim">@(e.NextPmDate?.ToString("MM-dd") ?? "—")</td>
                        <td class="dim">@(e.OpenWoId?.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.MntRepository.EquipCardRow> _allRows = new();
    List<AMES.Data.Repositories.MntRepository.EquipCardRow> _rows    = new();
    int     _page = 0;
    const int _pageSize = 20;
    int     _running, _idle, _down;
    decimal _avgOee;
    string  _fSearch = "";

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Mnt.ListEquipment(); }
        catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _page = 0;
        _rows = string.IsNullOrWhiteSpace(_fSearch)
            ? _allRows
            : _allRows.Where(r =>
                (r.LineId   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.EquipName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        _running = _rows.Count(r => r.Status is "RUN" or "RUNNING" or "OPERATING");
        _idle    = _rows.Count(r => r.Status is "IDLE" or "SETUP" or "READY");
        _down    = _rows.Count(r => r.Status is "DOWN" or "STOP" or "FAULT");
        var withOee = _rows.Where(r => r.TodayOee.HasValue).Select(r => r.TodayOee!.Value).ToList();
        _avgOee = withOee.Count > 0 ? withOee.Average() : 0m;
    }

    static string StatusClass(string? s) => s switch
    {
        "RUN" or "RUNNING" or "OPERATING" => "ok",
        "DOWN" or "STOP" or "FAULT"       => "bad",
        "IDLE" or "SETUP" or "READY"      => "warn",
        _                                  => "info"
    };
}
