@page "/mnt/dashboard"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MntRepository Mnt
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-009 @L["MNT.Dashboard.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MNT-009</div>
    <div class="ames-page-t">@L["MNT.Dashboard.Title"]</div>
    <div class="ames-page-sub">@L["MNT.Dashboard.Sub"]</div>
</div>

<div style="display:flex;justify-content:flex-end;margin-bottom:8px;">
    <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
</div>

<div class="ames-kpis">
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">RUNNING</div>
        <div class="ames-kpi-v">@_k.EquipRun</div>
        <div class="ames-kpi-s">of @_k.EquipTotal equip total</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">IDLE</div>
        <div class="ames-kpi-v">@_k.EquipIdle</div>
        <div class="ames-kpi-s">setup / ready</div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">DOWN</div>
        <div class="ames-kpi-v">@_k.EquipDown</div>
        <div class="ames-kpi-s">failure / fault</div>
    </div>
    <div class="ames-kpi @(_k.AvgOeeToday >= 85 ? "ok" : _k.AvgOeeToday >= 75 ? "warn" : "bad")">
        <div class="ames-kpi-l">AVG OEE TODAY</div>
        <div class="ames-kpi-v">@_k.AvgOeeToday.ToString("0.0")%</div>
        <div class="ames-kpi-s">all equip, today</div>
    </div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">OPEN FAILURES</div>
        <div class="ames-kpi-v">@_k.OpenFailures</div>
        <div class="ames-kpi-s">awaiting response</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">OPEN MWO</div>
        <div class="ames-kpi-v">@_k.OpenWos</div>
        <div class="ames-kpi-s">work orders in flight</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">PM DUE 7D</div>
        <div class="ames-kpi-v">@_k.PmDueIn7d</div>
        <div class="ames-kpi-s">preventive maint.</div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">LOW STOCK</div>
        <div class="ames-kpi-v">@_k.LowStockParts</div>
        <div class="ames-kpi-s">parts ≤ reorder pt.</div>
    </div>
</div>

<div class="ames-tiles">
    <a class="ames-tile mnt" href="mnt/equipment-card">
        <div class="ames-tile-ic">🏭</div>
        <div class="ames-tile-h">EQUIPMENT</div>
        <div class="ames-tile-sub">@_k.EquipTotal units · @_k.EquipRun running</div>
    </a>
    <a class="ames-tile mnt" href="mnt/failure">
        <div class="ames-tile-ic">🚨</div>
        <div class="ames-tile-h">FAILURES</div>
        <div class="ames-tile-sub">@_k.OpenFailures open · register</div>
    </a>
    <a class="ames-tile mnt" href="mnt/work-order">
        <div class="ames-tile-ic">🔧</div>
        <div class="ames-tile-h">MWO</div>
        <div class="ames-tile-sub">@_k.OpenWos open · maintenance work orders</div>
    </a>
    <a class="ames-tile mnt" href="mnt/pm-schedule">
        <div class="ames-tile-ic">📅</div>
        <div class="ames-tile-h">PM SCHEDULE</div>
        <div class="ames-tile-sub">@_k.PmDueIn7d due in 7 days</div>
    </a>
    <a class="ames-tile mnt" href="mnt/spare-parts">
        <div class="ames-tile-ic">📦</div>
        <div class="ames-tile-h">SPARE PARTS</div>
        <div class="ames-tile-sub">@_k.LowStockParts below reorder point</div>
    </a>
    <a class="ames-tile mnt" href="mnt/oee-analysis">
        <div class="ames-tile-ic">📊</div>
        <div class="ames-tile-h">OEE ANALYSIS</div>
        <div class="ames-tile-sub">avg @_k.AvgOeeToday.ToString("0.0")% today</div>
    </a>
    <a class="ames-tile mnt" href="mnt/downtime">
        <div class="ames-tile-ic">⏱️</div>
        <div class="ames-tile-h">DOWNTIME</div>
        <div class="ames-tile-sub">@_k.DowntimeMin24h min lost in last 24h</div>
    </a>
    <a class="ames-tile mnt" href="mnt/mold">
        <div class="ames-tile-ic">🧊</div>
        <div class="ames-tile-h">MOLD</div>
        <div class="ames-tile-sub">shot counters · refurbish thresholds</div>
    </a>
</div>

@code {
    AMES.Data.Repositories.MntRepository.DashboardKpi _k =
        new(0, 0, 0, 0, 0, 0, 0, 0, 0m, 0);

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _k = Mnt.GetDashboardKpis(); } catch { }
    }
}
