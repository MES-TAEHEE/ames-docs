@page "/mnt/failure"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MntRepository Mnt
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-002 @L["MNT.Failure.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MNT-002" TitleKey="MNT.Failure.Title" />

<div class="ames-kpis">
    <div class="ames-kpi bad"><div class="ames-kpi-l">OPEN</div>
        <div class="ames-kpi-v">@_open</div><div class="ames-kpi-s">@L["MNT.Failure.Kpi.Open"]</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">IN PROGRESS</div>
        <div class="ames-kpi-v">@_prog</div><div class="ames-kpi-s">@L["MNT.Failure.Kpi.Prog"]</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">RESOLVED</div>
        <div class="ames-kpi-v">@_res</div><div class="ames-kpi-s">@L["MNT.Failure.Kpi.Res"]</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">URGENT</div>
        <div class="ames-kpi-v">@_urg</div><div class="ames-kpi-s">@L["MNT.Failure.Kpi.Urg"]</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.Failure.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <select class="ames-input" style="width:110px;" @bind="_statusFilter">
                <option value="">@L["Filter.All"]</option>
                <option value="OPEN">OPEN</option>
                <option value="IN_PROGRESS">@L["MNT.Failure.InProgress"]</option>
                <option value="RESOLVED">@L["MNT.Failure.Resolved"]</option>
            </select>
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Recent"]</label>
            <select class="ames-input" style="width:110px;" @bind="_topN">
                <option value="50">50@(L["Lbl.Items"])</option>
                <option value="100">100@(L["Lbl.Items"])</option>
                <option value="200">200@(L["Lbl.Items"])</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MNT.Failure.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.FailNo"]</th><th>@L["Col.Equip"]</th><th>@L["Col.Type"]</th><th>@L["Col.Symptom"]</th>
                    <th>@L["Col.Priority"]</th><th>@L["Col.Source"]</th><th>@L["Col.Status"]</th>
                    <th>@L["Col.Reported"]</th><th>@L["Col.Resolved"]</th><th>@L["Col.MwoNo"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr>
                        <td class="code">@(f.FailureNumber ?? $"F#{f.FailureId}")</td>
                        <td>@(f.EquipId ?? "—")</td>
                        <td class="dim">@(f.FailureType ?? "—")</td>
                        <td>@(f.Symptom ?? "—")</td>
                        <td><span class="pill @UrgencyClass(f.Urgency)">@(f.Urgency ?? "—")</span></td>
                        <td class="dim">@(f.Source ?? "—")</td>
                        <td><span class="pill @StatusClass(f.Status)">@(f.Status ?? "—")</span></td>
                        <td class="dim">@(f.ReportedAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                        <td class="dim">@(f.ResolvedAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                        <td class="dim">@(f.WorkOrderId?.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.MntRepository.FailureRow> _rows = new();
    int _page = 0;
    const int _pageSize = 20;
    int    _open, _prog, _res, _urg;
    int    _topN = 100;
    string _statusFilter = "";

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        _page = 0;
        try { _rows = Mnt.ListFailures(_topN, string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter); }
        catch { _rows = new(); }
        _open = _rows.Count(r => r.Status is "OPEN" or "REGISTERED");
        _prog = _rows.Count(r => r.Status == "IN_PROGRESS");
        _res  = _rows.Count(r => r.Status is "RESOLVED" or "CLOSED");
        _urg  = _rows.Count(r => r.Urgency is "URGENT" or "HIGH");
    }

    static string UrgencyClass(string? u) => u switch
    { "URGENT" or "HIGH" => "bad", "MED" => "warn", "LOW" => "info", _ => "info" };
    static string StatusClass(string? s) => s switch
    { "OPEN" or "REGISTERED" => "bad",
      "IN_PROGRESS"          => "warn",
      "RESOLVED" or "CLOSED" => "ok", _ => "info" };
}
