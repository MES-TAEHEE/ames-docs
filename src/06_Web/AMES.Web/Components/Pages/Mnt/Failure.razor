@page "/mnt/failure"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MntRepository Mnt
@inject MasterDataRepository MD
@inject SysRepository Sys
@inject WorkerRepository Workers
@inject ActorNames Actors
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>MNT-002 @L["MNT.Failure.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MNT-002" TitleKey="MNT.Failure.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allRows.Count</div>
            <div class="ames-kpi-s">@string.Format(L["MNT.Failure.Lbl.Range"].Value, _fFrom.ToString(DateFmt.Date), _fTo.ToString(DateFmt.Date))</div>
        </div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">@L["MNT.Failure.Kpi.Open"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => IsOpen(r.Status))</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MNT.Failure.Kpi.Prog"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => IsProg(r.Status))</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["MNT.Failure.Kpi.Res"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => IsRes(r.Status))</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MNT.Failure.Kpi.Urg"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => IsCritical(r.Severity) && !IsRes(r.Status))</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MNT.Failure.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MNT.Failure.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:240px;" />
            <RadzenLabel Text="@L["Lbl.Period"]" Component="DatePickerFrom" />
            <RadzenDatePicker TValue="DateTime" Name="DatePickerFrom" @bind-Value="_fFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <span class="dim">~</span>
            <RadzenDatePicker TValue="DateTime" Name="DatePickerTo" @bind-Value="_fTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.Severity"]" Component="DropDownSeverity" />
            <RadzenDropDown Name="DropDownSeverity" @bind-Value="_fSeverity" Data="@SeverityFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Search" class="ames-rz-btn" />
            <RadzenButton Text="@L["MNT.Failure.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@ExportXlsx" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MntRepository.FailureRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MNT.Failure.Empty"]" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Title="@L["Col.RowNo"]" Width="60px" MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                <Template Context="rn"><span class="dim">@GridRowNo.Of(_pgGrid, rn)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="FailureNumber" Title="@L["Col.FailNo"]" TextAlign="TextAlign.Center" Width="140px">
                <Template Context="r"><span class="code">@FailNo(r)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="EquipId" Title="@L["Col.EquipId"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="code">@(r.EquipId ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="EquipName" Title="@L["Col.EquipName"]">
                <Template Context="r">@(r.EquipName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="FailureType" Title="@L["Col.Type"]" TextAlign="TextAlign.Center" Width="180px">
                <Template Context="r"><span class="pill">@TypeName(r.FailureType)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="Symptom" Title="@L["Col.Symptom"]">
                <Template Context="r"><span style="white-space:nowrap;">@(r.Symptom ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="Severity" Title="@L["Col.Severity"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="pill @SeverityCls(r.Severity)">@SeverityLabel(r.Severity)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="Source" Title="@L["Col.Source"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="dim">@SourceName(r.Source)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="pill @StatusCls(r.Status)">@StatusLabel(r.Status)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="ReportedAt" Title="@L["Col.Reported"]" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="r"><span class="dim">@(r.ReportedAt?.ToString(DateFmt.DateTime) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="ResolvedAt" Title="@L["Col.Resolved"]" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="r"><span class="dim">@(r.ResolvedAt?.ToString(DateFmt.DateTime) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MntRepository.FailureRow" Property="WoNumber" Title="@L["Col.MwoNo"]" TextAlign="TextAlign.Center" Width="150px">
                <Template Context="r">
                    @if (r.WorkOrderId is { } wo) { <span class="pill @WoCls(r.WoStatus)">@(r.WoNumber ?? $"#{wo}")</span> } else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Detail Modal (읽기 전용) ─────────────────────────────────────── *@
@if (_modal == "detail" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MNT.Failure.Title"] <span class="dim" style="font-weight:400;font-size:.9em;">@FailNo(_sel)</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.Equip"]" class="ames-rz-modal-label" Component="DetailTextBoxEquip" />
                <RadzenTextBox Name="DetailTextBoxEquip" Value="@EquipText(_sel)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Line"]" />
                    <RadzenTextBox Value="@LineText(_sel.LineId)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Type"]" />
                    <RadzenTextBox Value="@TypeName(_sel.FailureType)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Severity"]" />
                    <div style="padding-top:4px;"><span class="pill @SeverityCls(_sel.Severity)">@SeverityLabel(_sel.Severity)</span></div>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <div style="padding-top:4px;"><span class="pill @StatusCls(_sel.Status)">@StatusLabel(_sel.Status)</span></div>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Reported"]" />
                    <RadzenTextBox Value="@(_sel.ReportedAt?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Resolved"]" />
                    <RadzenTextBox Value="@(_sel.ResolvedAt?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Source"]" />
                    <RadzenTextBox Value="@SourceName(_sel.Source)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ReportedBy"]" />
                    <RadzenTextBox Value="@UserText(_sel.ReportedBy)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["Col.MwoNo"]" />
                    <RadzenTextBox Value="@(_sel.WorkOrderId is { } wo ? $"{_sel.WoNumber ?? $"#{wo}"} · {_sel.WoStatus ?? ""}" : "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MNT.Failure.Col.AndonRef"]" />
                    <RadzenTextBox Value="@(_sel.AndonRefId ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MNT.Failure.Col.Downtime"]" />
                    <RadzenTextBox Value="@(_sel.DowntimeId?.ToString() ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.Symptom"]" />
                <RadzenTextArea Value="@(_sel.Symptom ?? "")" Disabled="true" Rows="3" class="ames-rz-input" Style="width:100%;" />
            </RadzenStack>

            <FailureTimelinePanel Failure="_sel" />

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                @* 수리 완료(고장 종료 + 보전 WO 완료)는 승인 권한(A) — 등록·수정·삭제는 수정 권한(E) *@
                @if (_canApprove && !IsRes(_sel.Status))
                {
                    <RadzenButton Text="@L["MNT.Failure.Btn.Resolve"]" Icon="task_alt" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => OpenResolve(_sel))" class="ames-rz-btn" />
                }
                @if (_canEdit)
                {
                    <RadzenButton Text="@L["Btn.Edit"]" Icon="edit" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => OpenEdit(_sel))" class="ames-rz-btn" />
                }
                <RadzenButton Text="@L["Btn.Close"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 수리 완료 모달 — 고장 RESOLVED + 조치 이력, 열린 작업지시가 있으면 함께 완료 (MntRepository.ResolveFailure) ── *@
@if (_modal == "resolve" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MNT.Failure.Modal.Resolve"] <span class="dim" style="font-weight:400;font-size:.9em;margin-left:6px;">@FailNo(_sel) · @EquipText(_sel)</span></div>
            <div class="dim" style="font-size:var(--ames-fs-hint);">@L["MNT.Failure.Hint.Resolve"]</div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["MNT.WorkOrder.Lbl.CompletedAt"]} *")' class="ames-rz-modal-label" Component="ResolveDateAt" />
                    <RadzenDatePicker TValue="DateTime?" Name="ResolveDateAt" @bind-Value="_r.ResolvedAt" ShowTime="true" ShowTimeOkButton="false" HourFormat="24" DateFormat="@DateFmt.DateTime" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    <RadzenLabel Text="@L["MNT.WorkOrder.Lbl.Labor"]" class="ames-rz-modal-label" Component="ResolveNumericLabor" />
                    <RadzenNumeric TValue="int?" Name="ResolveNumericLabor" @bind-Value="_r.LaborMinutes" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["MNT.WorkOrder.Lbl.RootCause"]} *")' class="ames-rz-modal-label" Component="ResolveTextBoxRootCause" />
                    <RadzenTextBox Name="ResolveTextBoxRootCause" @bind-Value="_r.RootCause" MaxLength="200" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["MNT.WorkOrder.Lbl.Action"]} *")' Component="ResolveTextAreaAction" Style="margin-bottom:6px;" />
                    <RadzenTextArea Name="ResolveTextAreaAction" @bind-Value="_r.Action" MaxLength="500" Rows="3" class="ames-rz-input" Style="width:100%;" />
                </RadzenStack>
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["MNT.Failure.Btn.Resolve"])" Click="@SaveResolve" Disabled="@_busy" Icon="task_alt" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@(() => OpenDetail(_sel))" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 등록 / 수정 모달 (MD·SYS 등록 모달 패턴) — 등록 시 CM 작업지시 동시 발행 ── *@
@if (_modal is "create" or "edit")
{
    var editing = _modal == "edit";
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">
                @L["MNT.Failure.Title"] — @(editing ? L["Modal.Edit"] : L["Modal.Create"])
                @if (editing) { <span class="dim" style="font-weight:400;font-size:.9em;margin-left:6px;">@_f.FailNo</span> }
            </div>
            <div class="dim" style="font-size:var(--ames-fs-hint);">@L["MNT.Failure.Hint.Wo"]</div>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" Style="width:100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["MNT.Failure.Lbl.FailNo"]" class="ames-rz-modal-label" Component="FailTextBoxNo" />
                    <RadzenTextBox Name="FailTextBoxNo" @bind-Value="_f.FailNo" MaxLength="24" Placeholder="@L["MNT.Failure.Ph.FailNo"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["Col.Equip"]} *")' class="ames-rz-modal-label" Component="FailDropDownEquip" />
                    <RadzenDropDown AllowFiltering="true" Name="FailDropDownEquip" @bind-Value="_f.EquipId" Data="@EquipOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["Col.Type"]} *")' class="ames-rz-modal-label" Component="FailDropDownType" />
                    <RadzenDropDown Name="FailDropDownType" @bind-Value="_f.FailureType" Data="@CodeOptions(_typeItems)" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    <RadzenLabel Text='@($"{L["Col.Severity"]} *")' class="ames-rz-modal-label" Component="FailDropDownSeverity" />
                    <RadzenDropDown Name="FailDropDownSeverity" @bind-Value="_f.Severity" Data="@CodeOptions(_sevItems)" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.Source"]" class="ames-rz-modal-label" Component="FailDropDownSource" />
                    <RadzenDropDown Name="FailDropDownSource" @bind-Value="_f.Source" Data="@CodeOptions(_sourceItems)" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    @if (editing)
                    {
                        @* 상태·해결일시는 수리 완료(MNT-002)·작업지시 완료(MNT-007)·안돈 종료로만 바뀐다 — 여기서는 보기만 *@
                        <RadzenLabel Text="@L["Col.Status"]" class="ames-rz-modal-label" />
                        <div style="flex:1;" title="@L["MNT.Failure.Hint.StatusFixed"]"><span class="pill @StatusCls(_f.Status)">@StatusLabel(_f.Status)</span></div>
                    }
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["MNT.Failure.Lbl.ReportedAt"]} *")' class="ames-rz-modal-label" Component="FailDateReported" />
                    <RadzenDatePicker TValue="DateTime?" Name="FailDateReported" @bind-Value="_f.ReportedAt" ShowTime="true" ShowTimeOkButton="false" HourFormat="24" DateFormat="@DateFmt.DateTime" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    @if (editing)
                    {
                        <RadzenLabel Text="@L["MNT.Failure.Lbl.ResolvedAt"]" class="ames-rz-modal-label" />
                        <RadzenTextBox Value="@(_f.ResolvedAt?.ToString(DateFmt.DateTime) ?? "—")" Disabled="true" title="@L["MNT.Failure.Hint.StatusFixed"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                    }
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%;">
                    <RadzenLabel Text="@L["Col.ReportedBy"]" class="ames-rz-modal-label" Component="FailDropDownReporter" />
                    <RadzenDropDown AllowFiltering="true" Name="FailDropDownReporter" @bind-Value="_f.ReportedBy" Data="@UserOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.None"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="width:100%;">
                    <RadzenLabel Text='@($"{L["Col.Symptom"]} *")' Component="FailTextAreaSymptom" Style="margin-bottom:6px;" />
                    <RadzenTextArea Name="FailTextAreaSymptom" @bind-Value="_f.Symptom" MaxLength="500" Rows="3" class="ames-rz-input" Style="width:100%;" />
                </RadzenStack>

                @if (!editing && _canApprove)
                {
                    @* 이미 끝난 고장을 뒤늦게 입력할 때 — 등록(작업지시 발행) 직후 수리 완료 창을 이어서 연다 *@
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenCheckBox TValue="bool" @bind-Value="_f.ResolveAfterCreate" Name="FailChkResolveNow" />
                        <RadzenLabel Text="@L["MNT.Failure.Lbl.ResolveNow"]" Component="FailChkResolveNow" style="cursor:pointer;" />
                    </RadzenStack>
                }
            </RadzenStack>

            @if (editing && _confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : (editing ? L["Btn.Save"] : L["Btn.Create"]))" Click="@Save" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                @if (editing)
                {
                    <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                }
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    bool _showPagerSummary = true;
    int  _pageRows = 25;   // 고정 페이저: 본문 높이 = 헤더 + 페이지 행 수 × 행 높이(.ames-grid-fixed)
    List<MntRepository.FailureRow>            _allRows   = new();
    List<MntRepository.FailureRow>            _rows      = new();
    MntRepository.FailureRow? _sel;

    string   _fSearch = "";
    DateTime _fFrom = DbClock.Today.AddDays(-30), _fTo = DbClock.Today;
    string?  _fStatus, _fSeverity;
    string   _modal = "", _msg = "", _modalErr = "";
    bool     _bgMouseDownOnSelf, _isErr, _busy, _confirmDelete, _canEdit, _canApprove;
    string   _actor = "system", _defaultReporter = "";
    int?     _editId;
    FormModel _f = new();

    static readonly string[] StatusCodes  = { "OPEN", "IN_PROGRESS", "RESOLVED" };
    List<MasterDataRepository.CodeItemRow>  _sevItems    = new();   // 심각도 = 공통코드 DEFECT_SEVERITY
    List<MasterDataRepository.CodeItemRow>  _typeItems   = new();   // 공통코드 FAILURE_TYPE
    List<MasterDataRepository.CodeItemRow>  _sourceItems = new();   // 공통코드 FAILURE_SOURCE
    List<MasterDataRepository.EquipmentRow> _equipList   = new();
    List<SysRepository.UserRow>             _users       = new();
    List<WorkerRepository.WorkerRow>        _workers     = new();
    List<MasterDataRepository.LineRow>      _lineList    = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> StatusFilterOptions  => StatusCodes.Select(s => new DropDownItem { Value = s, Text = $"[{s}] {StatusLabel(s)}" });
    IEnumerable<DropDownItem> SeverityFilterOptions => CodeOptions(_sevItems);
    IEnumerable<DropDownItem> CodeOptions(List<MasterDataRepository.CodeItemRow> items) =>
        items.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    IEnumerable<DropDownItem> EquipOptions => _equipList.Select(e => new DropDownItem { Value = e.EquipID, Text = string.IsNullOrEmpty(e.EquipName) ? $"[{e.EquipID}]" : $"[{e.EquipID}] {e.EquipName}" });
    // 프로필이 없는(SYS-001 에 등록되지 않은) 계정은 고르지 못하게 뺀다 — 이미 저장된 값은 수정 창에서 빈칸이 되지 않게 남긴다
    // 보고자 = 사번(10-10 사용자 결정) — POP 안돈이 배지 사번(웹 계정·현장 작업자)을 넣는 것과 같은 기준.
    // 후보 = 사번 있는 웹 계정(프로필 있음) + 활성 현장 작업자(MD_Worker). 사번은 두 테이블을 합쳐 유일하다.
    // 저장된 값이 후보에 없으면(비활성 작업자 등) 그 값도 남겨 수정 창에서 빈칸이 되지 않게 한다
    IEnumerable<DropDownItem> UserOptions
    {
        get
        {
            var list = _users.Where(u => u.IsApproved && !string.IsNullOrWhiteSpace(u.EmployeeNo))
                             .Select(u => new DropDownItem { Value = u.EmployeeNo!, Text = $"[{u.EmployeeNo}] {u.EmployeeName ?? u.UserName}" })
                             .Concat(_workers.Where(w => w.ActiveFlag)
                             .Select(w => new DropDownItem { Value = w.EmployeeNo, Text = $"[{w.EmployeeNo}] {w.EmployeeName}" }))
                             .OrderBy(o => o.Value, StringComparer.OrdinalIgnoreCase).ToList();
            if (!string.IsNullOrEmpty(_f.ReportedBy) && !list.Any(o => string.Equals(o.Value, _f.ReportedBy, StringComparison.OrdinalIgnoreCase)))
                list.Insert(0, new DropDownItem { Value = _f.ReportedBy, Text = Actors.Display(_f.ReportedBy) });
            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = AMES.Web.Services.ActorCode.Of(auth.User, "system");
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("mnt/failure");
        _canApprove = PermSvc.CanApprove("mnt/failure");

        try { _sevItems    = MD.ListCodeItems("DEFECT_SEVERITY"); } catch { }
        try { _typeItems   = MD.ListCodeItems("FAILURE_TYPE");    } catch { }
        try { _sourceItems = MD.ListCodeItems("FAILURE_SOURCE");  } catch { }
        try { _equipList   = MD.ListEquipments(); } catch { }
        try { _users       = Sys.ListUsers(500); } catch { }
        try { _workers     = Workers.ListAll(); } catch { }
        try { _lineList    = MD.ListLines(); } catch { }
        // 보고자 기본값 = 로그인한 사람의 사번(행위자 코드). 사번이 없는 계정(행위자 코드가 이메일 앞부분)은 후보에 없으므로 빈칸
        _defaultReporter = UserOptions.FirstOrDefault(o => string.Equals(o.Value, _actor, StringComparison.OrdinalIgnoreCase))?.Value ?? "";

        // 기본 기간: 최근 30일. 그 안에 데이터가 없으면 마지막 발생일 기준으로 30일을 잡는다
        try
        {
            var (_, mx) = Mnt.FailureDateExtent();
            if (mx is { } m && m.Date < _fFrom) { _fTo = m.Date; _fFrom = _fTo.AddDays(-30); }
        }
        catch { }

        Reload();
    }

    RadzenDataGrid<MntRepository.FailureRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task Search()
    {
        _pgIndex = 0;
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null) await _pgGrid.GoToPage(0);
    }

    void Reload()
    {
        if (_fTo < _fFrom) (_fFrom, _fTo) = (_fTo, _fFrom);
        try { _allRows = Mnt.ListFailuresRange(_fFrom, _fTo); }
        catch (Exception ex) { _allRows = new(); ShowMsg(ex.Message, true); }
        ApplyFilter();
    }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            FailNo(r).Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EquipId   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            EquipDisplayName(r).Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.Symptom   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fStatus)  || NormStatus(r.Status) == _fStatus) &&
        (string.IsNullOrEmpty(_fSeverity) || r.Severity == _fSeverity)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    async Task OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }

    void RowRender(RowRenderEventArgs<MntRepository.FailureRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MntRepository.FailureRow> args)
    {
        if (args.Data is not null) OpenDetail(args.Data);
    }

    void OpenDetail(MntRepository.FailureRow? r) { if (r is null) return; _sel = r; _modal = "detail"; _modalErr = ""; }

    // 대시보드 고장 알림에서 ?id= 로 들어오면 그 고장이 보이게 기간을 맞추고 상세를 연다
    [SupplyParameterFromQuery(Name = "id")] public int? IdQuery { get; set; }
    int? _openedId;

    protected override void OnParametersSet()
    {
        if (IdQuery is not int id || id == _openedId) return;
        _openedId = id;
        MntRepository.FailureRow? hit;
        try { hit = Mnt.FindFailure(id); } catch (Exception ex) { ShowMsg(ex.Message, true); return; }
        if (hit is null) return;
        if (hit.ReportedAt is { } rep && (rep.Date < _fFrom || rep.Date > _fTo))
        {
            _fTo = rep.Date > _fTo ? rep.Date : _fTo;
            _fFrom = rep.Date < _fFrom ? rep.Date : _fFrom;
            Reload();
        }
        OpenDetail(hit);
    }

    void CloseModal() { _modal = ""; _sel = null; _editId = null; _modalErr = ""; _confirmDelete = false; }

    // ── 수리 완료 ────────────────────────────────────────────────────────
    ResolveModel _r = new();

    void OpenResolve(MntRepository.FailureRow? r)
    {
        if (r is null || !_canApprove) return;
        _sel = r; _modalErr = "";
        _r = new() { ResolvedAt = DbClock.Now };
        _modal = "resolve";
    }

    async Task SaveResolve()
    {
        // 수리 완료는 고장 종료 + 보전 WO 완료까지 쓰므로 버튼뿐 아니라 저장 처리에서도 승인 권한을 다시 본다
        if (_sel is null || !_canApprove) return;
        _modalErr = "";
        if (_r.ResolvedAt is null)                       { _modalErr = L["MNT.WorkOrder.Err.CompletedRequired"]; return; }
        if (_sel.ReportedAt is { } rep && _r.ResolvedAt < rep) { _modalErr = L["MNT.Failure.Err.ResolvedBefore"]; return; }
        if (_r.LaborMinutes is < 0)                      { _modalErr = L["MNT.WorkOrder.Err.LaborInvalid"]; return; }
        if (string.IsNullOrWhiteSpace(_r.RootCause))     { _modalErr = L["MNT.Failure.Err.RootCauseRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_r.Action))        { _modalErr = L["MNT.WorkOrder.Err.ActionRequired"]; return; }

        _busy = true;
        try
        {
            var (failNo, woNo) = Mnt.ResolveFailure(_sel.FailureId, _r.RootCause.Trim(), _r.Action.Trim(), _r.ResolvedAt.Value, _r.LaborMinutes, _actor);
            ShowMsg(woNo is null ? string.Format(L["MNT.Failure.Ok.Resolved"].Value, failNo)
                                 : string.Format(L["MNT.Failure.Ok.ResolvedWo"].Value, failNo, woNo), false);
            var id = _sel.FailureId;
            CloseModal(); Reload();
            // 갱신된 상태로 상세를 다시 연다
            var again = _allRows.FirstOrDefault(x => x.FailureId == id);
            if (again is not null) OpenDetail(again);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    class ResolveModel
    {
        public DateTime? ResolvedAt   { get; set; }
        public int?      LaborMinutes { get; set; }
        public string    RootCause    { get; set; } = "";
        public string    Action       { get; set; } = "";
    }

    static string WoCls(string? woStatus) => woStatus is "COMPLETED" or "CLOSED" ? "ok" : woStatus == "IN_PROGRESS" ? "warn" : "orange";

    // ── 등록 / 수정 / 삭제 ─────────────────────────────────────────────
    void OpenCreate()
    {
        if (!_canEdit) return;
        _f = new() { ReportedAt = DbClock.Now, Status = "OPEN", Source = "WEB", ReportedBy = _defaultReporter };
        _editId = null; _sel = null; _modalErr = ""; _confirmDelete = false;
        _modal = "create";
    }

    void OpenEdit(MntRepository.FailureRow? r)
    {
        if (r is null || !_canEdit) return;
        _f = new()
        {
            FailNo = r.FailureNumber ?? "", EquipId = r.EquipId ?? "", FailureType = r.FailureType ?? "",
            Symptom = r.Symptom ?? "", Severity = r.Severity ?? "", Source = r.Source ?? "",
            Status = NormStatus(r.Status) is { Length: > 0 } st ? st : "OPEN",
            ReportedAt = r.ReportedAt, ResolvedAt = r.ResolvedAt, ReportedBy = r.ReportedBy ?? "",
        };
        _editId = r.FailureId; _sel = null; _modalErr = ""; _confirmDelete = false;
        _modal = "edit";
    }

    async Task Save()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipId))      { _modalErr = L["MNT.Failure.Err.EquipRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.FailureType))  { _modalErr = L["MNT.Failure.Err.TypeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.Severity))     { _modalErr = L["MNT.Failure.Err.SeverityRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.Symptom))      { _modalErr = L["MNT.Failure.Err.SymptomRequired"]; return; }
        if (_f.ReportedAt is null)                      { _modalErr = L["MNT.Failure.Err.ReportedRequired"]; return; }
        // 해결일시는 고치지 않지만, 해결된 고장의 발생일시를 해결 뒤로 옮기는 것은 막는다
        if (_f.ResolvedAt is { } res && res < _f.ReportedAt) { _modalErr = L["MNT.Failure.Err.ResolvedBefore"]; return; }

        _busy = true;
        int? resolveNowId = null;
        try
        {
            var failNo = _f.FailNo.Trim();
            if (failNo.Length == 0) failNo = Mnt.NextFailureNumber(DbClock.Today);
            if (Mnt.FailureNumberExists(failNo, _editId)) { _modalErr = string.Format(L["MNT.Failure.Err.Duplicate"].Value, failNo); return; }
            if (_editId is int id)
            {
                Mnt.UpdateFailure(id, failNo, _f.EquipId, _f.FailureType, _f.Symptom.Trim(), _f.Severity,
                    NE(_f.Source), _f.ReportedAt.Value, NE(_f.ReportedBy), _actor);
                ShowMsg(string.Format(L["MNT.Failure.Ok.Updated"].Value, failNo), false);
            }
            else
            {
                var (newId, woNo) = Mnt.InsertFailure(failNo, _f.EquipId, _f.FailureType, _f.Symptom.Trim(), _f.Severity,
                    NE(_f.Source), _f.ReportedAt.Value, NE(_f.ReportedBy), _actor);
                ShowMsg(string.Format(L["MNT.Failure.Ok.CreatedWo"].Value, failNo, woNo), false);
                resolveNowId = _f.ResolveAfterCreate && _canApprove ? newId : null;
            }
            // 발생일이 조회 기간 밖이면 기간을 넓혀 결과가 바로 보이게
            var rep = _f.ReportedAt.Value.Date;
            if (rep < _fFrom) _fFrom = rep;
            if (rep > _fTo)   _fTo   = rep;
            CloseModal(); await Search();
            // 지름길: 방금 등록한 고장의 수리 완료 창을 바로 연다(원인·조치·작업시간을 받아 고장과 작업지시를 같이 닫는다)
            if (resolveNowId is int rid && _allRows.FirstOrDefault(x => x.FailureId == rid) is { } created)
                OpenResolve(created);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (!_canEdit) return;
        if (_editId is not int id) return;
        _busy = true;
        try
        {
            var failNo = _f.FailNo;
            Mnt.DeleteFailure(id);
            CloseModal(); await Search();
            ShowMsg(string.Format(L["MNT.Failure.Ok.Deleted"].Value, failNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    class FormModel
    {
        public string    FailNo      { get; set; } = "";
        public string    EquipId     { get; set; } = "";
        public string    FailureType { get; set; } = "";
        public string    Symptom     { get; set; } = "";
        public string    Severity    { get; set; } = "";
        public string    Source      { get; set; } = "";
        public string    Status      { get; set; } = "OPEN";   // 보기 전용 — 저장하지 않는다
        public bool      ResolveAfterCreate { get; set; }
        public DateTime? ReportedAt  { get; set; }
        public DateTime? ResolvedAt  { get; set; }
        public string    ReportedBy  { get; set; } = "";
    }

    // 공통코드 명칭 — 코드에 없는 값은 코드 그대로
    static string CodeName(List<MasterDataRepository.CodeItemRow> items, string? c) =>
        c is null ? "—" : items.FirstOrDefault(x => string.Equals(x.CodeValue, c, StringComparison.OrdinalIgnoreCase)) is { } i ? MasterDataRepository.LocalName(i) : c;
    string TypeName(string? c)   => CodeName(_typeItems, c);
    string SourceName(string? c) => CodeName(_sourceItems, c);
    // 신고자 = 사용자 ID·사번 → "이름 (사번)" (행위자 표시 규칙)
    string UserText(string? id) => Actors.Display(id);
    string LineText(string? id) =>
        string.IsNullOrEmpty(id) ? "" : _lineList.FirstOrDefault(l => l.LineID == id) is { } l && MasterDataRepository.LocalName(l.LineName, l.LineNameEn) is { Length: > 0 } nm ? $"[{id}] {nm}" : $"[{id}]";

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    // 현재 조회 결과(필터 적용분)를 .xlsx 로 내려받는다 — 화면 컬럼 순서 그대로
    async Task ExportXlsx()
    {
        if (_rows.Count == 0) { ShowMsg(L["MNT.Failure.Err.NoExport"], true); return; }

        var headers = new[]
        {
            L["Col.FailNo"].Value, L["Col.EquipId"].Value, L["Col.EquipName"].Value, L["Col.Line"].Value,
            L["Col.Type"].Value, L["Col.Symptom"].Value, L["Col.Severity"].Value, L["Col.Source"].Value,
            L["Col.Status"].Value, L["Col.Reported"].Value, L["Col.Resolved"].Value, L["Col.ReportedBy"].Value,
            L["Col.MwoNo"].Value, L["MNT.Failure.Col.AndonRef"].Value, L["MNT.Failure.Col.Downtime"].Value,
        };
        var data = _rows.Select(r => (IReadOnlyList<object?>)new object?[]
        {
            FailNo(r), r.EquipId, r.EquipName, r.LineId,
            TypeName(r.FailureType), r.Symptom, SeverityLabel(r.Severity), SourceName(r.Source),
            StatusLabel(r.Status), r.ReportedAt?.ToString(DateFmt.DateTime), r.ResolvedAt?.ToString(DateFmt.DateTime), UserText(r.ReportedBy),
            r.WoNumber ?? r.WorkOrderId?.ToString(), r.AndonRefId, r.DowntimeId,
        });

        var bytes = AMES.Web.Services.XlsxWriter.Build(L["MNT.Failure.Title"].Value, headers, data);
        var name  = $"Failure_{DbClock.Now:yyyyMMdd_HHmmss}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["MNT.Failure.Ok.Exported"].Value, _rows.Count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string FailNo(MntRepository.FailureRow r) => r.FailureNumber ?? $"F#{r.FailureId}";

    // 설비명은 현재 언어 기준 표시명으로 검색한다. MD_Equipment 에 영문 명칭 컬럼이 없어 지금은 EquipName 하나로 해석되며,
    // 컬럼이 생기면 FailureRow 에 EquipNameEn 을 실어 LocalName(ko, en) 으로 바꾸면 된다.
    static string EquipDisplayName(MntRepository.FailureRow r) => MasterDataRepository.LocalName(r.EquipName, null);

    string EquipText(MntRepository.FailureRow r) =>
        r.EquipId is null ? "" : EquipDisplayName(r) is { Length: > 0 } nm ? $"[{r.EquipId}] {nm}" : $"[{r.EquipId}]";

    // MNT_FailureRegister 상태·우선순위는 공통코드 그룹이 없어 고정 어휘로 표시한다 (REGISTERED/CLOSED 는 동의어)
    static bool IsOpen(string? s)   => s is "OPEN" or "REGISTERED";
    static bool IsProg(string? s)   => s == "IN_PROGRESS";
    static bool IsRes(string? s)    => s is "RESOLVED" or "CLOSED";
    static bool IsCritical(string? u) => u is "CRITICAL";

    static string NormStatus(string? s) => IsOpen(s) ? "OPEN" : IsRes(s) ? "RESOLVED" : s ?? "";

    string StatusLabel(string? s) =>
        s is null ? "—" : IsOpen(s) ? L["MNT.Failure.Open"] : IsProg(s) ? L["MNT.Failure.InProgress"] : IsRes(s) ? L["MNT.Failure.Resolved"] : s;

    // 공통코드에 없는 값(구 URGENT/HIGH/MED/LOW 데이터)은 코드 그대로 보여 준다
    string SeverityLabel(string? u) =>
        u is null ? "—" : _sevItems.FirstOrDefault(c => string.Equals(c.CodeValue, u, StringComparison.OrdinalIgnoreCase)) is { } c ? MasterDataRepository.LocalName(c) : u;

    static string StatusCls(string? s) => IsOpen(s) ? "bad" : IsProg(s) ? "orange" : IsRes(s) ? "ok" : "mute";

    static string SeverityCls(string? u) => u switch
    { "CRITICAL" => "bad", "MAJOR" => "orange", "MINOR" => "info", _ => "mute" };
}
