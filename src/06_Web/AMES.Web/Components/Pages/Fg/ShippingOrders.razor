@page "/fg/shipping-orders"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using AMES.Contracts.Dto
@inject FinishedGoodsRepository Fg
@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject NavigationManager Nav
@inject UomFormat UomFmt
@inject IStringLocalizer<SharedResources> L

<PageTitle>FG-02 @L["FG.ShipOrders.Title"] · AMES</PageTitle>
<AmesPageHeader Code="FG-02" TitleKey="FG.ShipOrders.Title" />
<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["FG.ShipOrders.Kpi.Orders"]</div><div class="ames-kpi-v">@VisibleOrders.Count()</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["FG.ShipOrders.Kpi.Open"]</div><div class="ames-kpi-v">@VisibleOrders.Count(x=>x.Status=="Open")</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["FG.ShipOrders.Kpi.DcrAssigned"]</div><div class="ames-kpi-v">@VisibleOrders.Count(x=>x.DeliveryId is not null)</div></div>
</div>
<section class="ames-card shipping-orders-page">
    <div class="ames-card-h master-list-toolbar">
        <span>▼ @L["FG.ShipOrders.List"] · @VisibleOrders.Count()</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" @bind-Value="_from" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <span>–</span><RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" @bind-Value="_to" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
                <RadzenCheckBox TValue="bool" Value="@_includeShipped" Change="@(value=>SetIncludeShipped(value))" Name="includeShipped" />
                <RadzenLabel Component="includeShipped" Text="@L["FG.ShipOrders.IncludeShipped"]" />
            </RadzenStack>
            <RadzenButton Text="@L["Btn.Refresh"]" Icon="refresh" Click="Reload" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            @if(_canEdit)
            {
                <RadzenButton Text="@L["FG.ShipOrders.Btn.CreateOrder"]" Icon="add" Click="OpenCreate" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["FG.ShipOrders.Btn.CreateDcr"]" Icon="local_shipping" Disabled="@(_selected.Count==0)" Click="@(()=>_deliveryModal=true)" Size="ButtonSize.Small" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>
    @if(!string.IsNullOrEmpty(_message)){<RadzenAlert AlertStyle="AlertStyle.Info">@_message</RadzenAlert>}
    <RadzenDataGrid @ref="_grid" TItem="ShippingOrderDto" Data="@VisibleOrders" AllowPaging="true" PageSize="25" AllowSorting="true" PagerHorizontalAlign="HorizontalAlign.Center" PageSizeOptions="_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" PageSizeChanged="@(s=>_pageRows=s)" Style="@($"--ames-page-rows:{_pageRows}")" class="ames-rz-grid ames-grid-fixed">
        <Template Context="order">
            <ShipmentOrderLines Lines="order.Lines" />
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="ShippingOrderDto" Title="" Width="45px" MinWidth="45px" Sortable="false"><Template Context="r"><RadzenCheckBox TValue="bool" Value="@_selected.Contains(r.OrderId)" Change="@(v=>Select(r.OrderId,v))" Disabled="@(r.DeliveryId is not null || r.Status!="Open" || !_canEdit)" /></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="OrderNo" Title="@L["FG.ShipOrders.Col.OrderNo"]" />
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="CustomerId" Title="@L["Col.Customer"]" />
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="ShipDate" Title="@L["Col.ShipDate"]" FormatString="@DateFmt.Fmt(DateFmt.Date)" />
            <RadzenDataGridColumn TItem="ShippingOrderDto" Title="@L["FG.ShipOrders.Col.PartQty"]"><Template Context="r">
                @r.Lines.Select(x=>x.PartNo).Distinct().Count() <span class="dim">@L["FG.Ship.Lbl.Parts"] · @string.Join(" · ",r.Lines.GroupBy(x=>x.Unit).Select(g=>UomFmt.QtyUnit(g.Sum(x=>x.Qty),g.Key)))</span>
            </Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="Status" Title="@L["Col.Status"]" />
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="DeliveryNo" Title="@L["FG.ShipOrders.Col.Dcr"]"><Template Context="r">
                @if(r.DeliveryNo is not null){<RadzenButton Text="@r.DeliveryNo" Click="@(()=>PrintDelivery(r.DeliveryNo))" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />}
                else{<span>@L["FG.ShipOrders.Lbl.NotAssigned"]</span>}
            </Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShippingOrderDto" Title="@L["Btn.Print"]" Width="110px" MinWidth="110px"><Template Context="r"><RadzenButton Text="@L["Btn.Print"]" Icon="print" Click="@(()=>PrintOrder(r))" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" /></Template></RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</section>
@if(_creating && _canEdit)
{
    <div class="ames-modal-bg" data-no-busy @onclick="CloseCreate"><div class="ames-modal ames-modal-fullwide" role="dialog" aria-modal="true" aria-label="@L["FG.ShipOrders.Title.Create"]" @onclick:stopPropagation>
        <div class="ames-modal-h">@L["FG.ShipOrders.Title.Create"]</div>
        <ShipmentOrderCreate Saved="Created" Closed="CloseCreate" BusyChanged="@(busy=>_createBusy=busy)" />
    </div></div>
}
@if(_createdNumbers.Count>0)
{
    <div class="ames-modal-bg" data-no-busy @onclick="CloseCreated"><div class="ames-modal ames-modal-fullwide" role="dialog" aria-modal="true" aria-label="@L["FG.ShipOrders.Title.Created"]" @onclick:stopPropagation>
        <div class="ames-modal-h">@L["FG.ShipOrders.Title.Created"] · @_createdNumbers.Count</div>
        <div class="created-order-list">
            <p>@string.Join(", ",_createdNumbers) · @_createdShipDate.ToString(DateFmt.Date)</p>
            @if(!string.IsNullOrEmpty(_createdError)){<RadzenAlert AlertStyle="AlertStyle.Warning">@_createdError</RadzenAlert>}
            @foreach(var order in _createdOrders)
            {
                <section class="ames-card">
                    <div class="ames-card-h">@order.OrderNo · @order.CustomerId · @order.ShipDate.ToString(DateFmt.Date)</div>
                    <ShipmentOrderLines Lines="order.Lines" />
                </section>
            }
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
            <span class="dim">@L["FG.ShipOrders.Hint.CreateDcr"]</span>
            <RadzenButton Text="@L["Btn.Close"]" Icon="close" Click="CloseCreated" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
        </RadzenStack>
    </div></div>
}
@if(_deliveryModal)
{
    <div class="ames-modal-bg" @onclick="@(()=>_deliveryModal=false)"><div class="ames-modal" @onclick:stopPropagation>
        <div class="ames-modal-h">@L["FG.ShipOrders.Btn.CreateDcr"]</div>
        <p>@L["FG.ShipOrders.Hint.DcrSelectedFmt",_selected.Count]</p>
        @if(!string.IsNullOrEmpty(_deliveryError)){<RadzenAlert AlertStyle="AlertStyle.Danger">@_deliveryError</RadzenAlert>}
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer"><RadzenButton Text="@L["FG.ShipOrders.Btn.CreateDcr"]" Icon="save" Click="CreateDelivery" Disabled="_busy" Size="ButtonSize.Small" class="ames-rz-btn" /><RadzenButton Text="@L["Btn.Close"]" Icon="close" Click="@(()=>_deliveryModal=false)" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" /></RadzenStack>
    </div></div>
}
@if(_printOrders.Count>0)
{
    <ShippingOrderPrintPreview Orders="_printOrders" Delivery="_printDelivery" Closed="ClosePrint" />
}
@code {
    bool _includeShipped=true;
    RadzenDataGrid<ShippingOrderDto>? _grid;
    IEnumerable<ShippingOrderDto> VisibleOrders => _orders.Where(order=>_includeShipped || !string.Equals(order.Status,"Shipped",StringComparison.OrdinalIgnoreCase));
    async Task SetIncludeShipped(bool value){_includeShipped=value;_selected.Clear();if(_grid is not null)await _grid.FirstPage(true);}
    List<ShippingOrderDto> _orders=[],_printOrders=[];HashSet<int> _selected=[];
    List<ShippingOrderDto> _createdOrders=[];
    List<string> _createdNumbers=[];
    DateTime _createdShipDate;
    string _createdError="";
    ShippingDeliveryDto? _printDelivery;
    readonly IEnumerable<int> _pageSizeOptions=[25,50,100];int _pageRows=25;
    DateTime? _from=DbClock.Today.AddMonths(-1),_to=DbClock.Today.AddMonths(1);
    bool _canEdit,_canPlan,_creating,_createBusy,_deliveryModal,_busy,_allowed;
    string _actor="",_message="",_deliveryError="";
    protected override async Task OnInitializedAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);_allowed=PermSvc.CanOpen("fg/shipping-orders");
        if(!_allowed){Nav.NavigateTo("/unauthorized");return;}
        _canEdit=PermSvc.CanEdit("fg/shipping-orders");_canPlan=PermSvc.CanOpen("fg/shipment-plan");_actor=ActorCode.Of((await AuthPrvd.GetAuthenticationStateAsync()).User);await Reload();
    }
    void OpenCreate(){if(_canEdit)_creating=true;}
    void CloseCreate(){if(!_createBusy)_creating=false;}
    async Task Reload(){if(!_allowed)return;if(_from>_to){_message=L["Err.DateRange"].Value;return;}try{_orders=await Task.Run(()=>Fg.ListShippingOrders(_from,_to));_selected.Clear();}catch(Exception ex){_message=ex.Message;}}
    void Select(int id,bool value){if(value)_selected.Add(id);else _selected.Remove(id);}
    async Task Created(ShipmentOrderCreate.CreatedOrders result)
    {
        _creating=false;
        _createdNumbers=result.Numbers;_createdShipDate=result.ShipDate;_createdOrders=[];_createdError="";
        try
        {
            var saved=await Task.Run(()=>Fg.ListShippingOrders(result.ShipDate,result.ShipDate));
            _createdOrders=saved.Where(o=>result.Numbers.Contains(o.OrderNo)).ToList();
            if(_createdOrders.Count!=result.Numbers.Count)_createdError=L["FG.ShipOrders.Err.CreatedPartial"].Value;
        }
        catch{_createdError=L["FG.ShipOrders.Err.CreatedNoDetail"].Value;}
        await Reload();
    }
    void CloseCreated(){_createdNumbers=[];_createdOrders=[];_createdError="";}
    async Task CreateDelivery()
    {
        await PermSvc.EnsureAsync(AuthPrvd);if(!PermSvc.CanEdit("fg/shipping-orders")||_busy)return;_busy=true;_deliveryError="";
        try
        {
            var ids=_selected.ToList();var shipDate=_orders.First(o=>ids.Contains(o.OrderId)).ShipDate;
            var no=await Task.Run(()=>Fg.CreateShippingDelivery(ids,null,_actor));
            _deliveryModal=false;_message=L["FG.ShipOrders.Ok.DcrCreatedFmt",no].Value;
            if(_canPlan)
            {
                var date=shipDate.ToString("yyyy-MM-dd",System.Globalization.CultureInfo.InvariantCulture);
                Nav.NavigateTo($"/fg/shipment-plan?from={date}&to={date}&dcr={Uri.EscapeDataString(no)}");
            }
            else await Reload();
        }
        catch(Exception ex){_deliveryError=ex.Message;}finally{_busy=false;}
    }
    void PrintOrder(ShippingOrderDto row){_printDelivery=null;_printOrders=[row];}
    async Task PrintDelivery(string number){try{_printDelivery=await Task.Run(()=>Fg.GetShippingDelivery(number));_printOrders=_orders.Where(x=>x.DeliveryId==_printDelivery.DeliveryId).ToList();}catch(Exception ex){_message=ex.Message;}}
    void ClosePrint(){_printOrders=[];_printDelivery=null;}
}
