@page "/fg/shipments"
@rendermode AmesRender.Server
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using AMES.Data.Repositories
@using Radzen
@inject IStringLocalizer<SharedResources> L
@inject UomFormat UomFmt
@inject ILogger<Shipments> Logger
@inject FinishedGoodsRepository Fg

<PageTitle>@L["FG.Shipments.Title"]</PageTitle>
<AmesPageHeader Code="FG-04" TitleKey="FG.Shipments.Title" />
<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.Shipments"]</div><div class="ames-kpi-v">@_rows.Select(x=>x.Shipment.Key).Distinct().Count()</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["Shipment.Customers"]</div><div class="ames-kpi-v">@_rows.Select(x=>x.Shipment.CustomerId).Distinct().Count()</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["Shipment.Lots"]</div><div class="ames-kpi-v">@_rows.Sum(x=>x.LotCount)</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["Col.Quantity"]</div><div class="ames-kpi-v">@UomFmt.Qty(_rows.Sum(x=>x.Qty),null)</div></div>
</div>
@if (!string.IsNullOrWhiteSpace(_message)) { <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_message</RadzenAlert> }
<section class="ames-card shipments-page inventory-history-list" data-no-busy>
    <div class="ames-card-h master-list-toolbar">
        <span>▼ @L["FG.Shipments.Title"] · @_rows.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox Immediate="true" @bind-Value="_search" Placeholder='@L["FG.Shipments.Ph.SearchLot"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:250px;" @onkeydown='async e=>{if(e.Key=="Enter")await Reload();}' />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" @bind-Value="_from" DateFormat="@DateFmt.Date" Placeholder='@L["Col.From"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" @bind-Value="_to" DateFormat="@DateFmt.Date" Placeholder='@L["Col.To"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="Reload" class="ames-rz-btn" />
            <RadzenButton Text="@L["Btn.Refresh"].Value" Icon="refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="Reload" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <RadzenDataGrid TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Data="@_rows" IsLoading="_loading" AllowPaging="true" PageSize="25"
                    PageSizeOptions="@_pageSizeOptions" PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]"
                    PageSizeChanged="@(s=>_pageRows=s)" Style="@($"--ames-page-rows:{_pageRows}")" AllowSorting="true" Class="ames-rz-grid ames-grid-fixed shipment-list-grid" EmptyText='@L["FG.Shipments.Empty"]'>
        <Columns>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="Shipment.ReferenceNo" Title='@L["FG.Shipments.Col.DcrDn"]' Width="220px" MinWidth="220px"><Template Context="row"><span class="code">@row.Shipment.ReferenceNo</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="PalletNo" Title='@L["Shipment.PalletNo"]' Width="220px" MinWidth="220px"><Template Context="row">@(row.PalletNo??"—")</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="PartNo" Title='@L["Col.PartNo"]' Width="190px" MinWidth="190px">
                <Template Context="row"><RadzenButton Text='@(row.PartNo??"—")' Click="@(()=>OpenLots(row))" Disabled="@(row.LotCount==0)" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" class="ames-rz-btn" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="PartName" Title='@L["Col.PartName"]' Width="300px" MinWidth="220px"><Template Context="row"><span class="shipment-part-name" title="@row.PartName">@(row.PartName is {Length:>50} name ? name[..50]+"…" : row.PartName??"—")</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="Qty" Title='@L["Col.Quantity"]' Width="120px" MinWidth="120px" TextAlign="TextAlign.Right"><Template Context="row">@UomFmt.QtyUnit(row.Qty,row.Unit)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="LotCount" Title='@L["Shipment.Lots"]' Width="80px" MinWidth="80px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="Shipment.ShippedAt" Title='@L["FG.Shipments.Col.ShippedAt"]' Width="180px" MinWidth="180px"><Template Context="row">@row.Shipment.ShippedAt.ToString(DateFmt.DateTime)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="Shipment.CustomerId" Title='@L["Col.Customer"]' Width="190px" MinWidth="190px"><Template Context="row">@row.Shipment.CustomerId<div class="dim">@row.Shipment.CustomerName</div></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentHistoryPartRow" Property="Shipment.ShippedBy" Title='@L["Shipment.ShippedBy"]' Width="130px" MinWidth="130px" />
        </Columns>
    </RadzenDataGrid>
</section>
@if (_lotPart is {} part)
{
    <div class="ames-modal-bg" @onclick="CloseLots">
        <div class="ames-modal shipment-lots-modal" role="dialog" aria-modal="true" aria-labelledby="shipment-lots-title" @onclick:stopPropagation="true" @onkeydown="@(e=>{if(e.Key=="Escape")CloseLots();})">
            <div class="ames-modal-h" id="shipment-lots-title">@L["Shipment.DetailsFmt",_lotReference]</div>
            <div>@(part.PalletNo??"—") · @part.PartNo · @part.PartName</div>
            @if (!string.IsNullOrWhiteSpace(_lotError)) { <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_lotError</RadzenAlert> }
            <RadzenDataGrid TItem="FinishedGoodsRepository.ShipmentItemRow" Data="_lots" IsLoading="_lotsLoading" AllowPaging="true" PageSize="25" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]"
                            Class="ames-rz-grid" Style="max-height:50vh;" EmptyText='@L["Grid.Empty"]'>
                <Columns>
                    <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentItemRow" Property="LotNo" Title='@L["Col.LotNo"]' />
                    <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentItemRow" Property="LocationNo" Title='@L["Shipment.FromLocation"]' />
                    <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentItemRow" Property="Qty" Title='@L["Col.Quantity"]' TextAlign="TextAlign.Right"><Template Context="lot">@UomFmt.QtyUnit(lot.Qty,lot.Unit)</Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            <div class="ames-modal-footer"><RadzenButton Text="@L["Btn.Close"].Value" Icon="close" Click="CloseLots" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" /></div>
        </div>
    </div>
}
@code {
    private FinishedGoodsRepository.ShipmentPalletPartRow? _lotPart;
    private List<FinishedGoodsRepository.ShipmentItemRow> _lots=[];
    private string _lotReference="",_lotError="";
    private bool _lotsLoading;
    private int _lotRequest;
    private async Task OpenLots(FinishedGoodsRepository.ShipmentHistoryPartRow row)
    {
        var shipment=row.Shipment;
        var part=new FinishedGoodsRepository.ShipmentPalletPartRow(row.PalletNo,row.PartNo,row.PartName,row.Qty,row.Unit);
        var request=++_lotRequest;
        _lotPart=part;_lotReference=shipment.ReferenceNo;_lots=[];_lotError="";_lotsLoading=true;
        try
        {
            var lots=await Task.Run(()=>Fg.ListShipmentHistoryLots(shipment.DeliveryId,shipment.ShipmentId,part.PalletNo,part.PartNo));
            if(request==_lotRequest)_lots=lots;
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Shipment LOT details load failed");
            if(request==_lotRequest)_lotError=L["Shipment.DetailsError"];
        }
        finally { if(request==_lotRequest)_lotsLoading=false; }
    }
    private void CloseLots() { ++_lotRequest;_lotPart=null;_lots=[];_lotsLoading=false; }
    private List<FinishedGoodsRepository.ShipmentHistoryPartRow> _rows=[];
    private bool _loading;
    private readonly IEnumerable<int> _pageSizeOptions=[25,50,100];
    private int _pageRows=25;
    private string _search="",_message="";
    private DateTime? _from=DbClock.Today.AddMonths(-1),_to=DbClock.Today.AddMonths(1);
    protected override async Task OnInitializedAsync()=>await Reload();
    private async Task Reload()
    {
        if(_loading)return;
        if(_from>_to) { _message=L["Err.DateRange"]; return; }
        _loading=true;
        try { _rows=await Task.Run(()=>Fg.ListShipmentHistoryRows(_search,_from,_to)); _message=""; }
        catch(Exception ex) { Logger.LogError(ex,"Shipments load failed");_rows=[]; _message=L["Shipment.LoadError"]; }
        finally{_loading=false;}
    }
}
