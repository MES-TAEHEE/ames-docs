@page "/fg/shipments"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using AMES.Data.Repositories
@using Radzen
@inject IStringLocalizer<SharedResources> L
@inject UomFormat UomFmt
@inject ILogger<Shipments> Logger
@inject FinishedGoodsRepository Fg

<PageTitle>@L["FG.Shipments.Title"]</PageTitle>
<AmesPageHeader Code="FG-04" TitleKey="FG.Shipments.Title" />
<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.Shipments"]</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["Shipment.Customers"]</div><div class="ames-kpi-v">@_rows.Select(x=>x.CustomerId).Distinct().Count()</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["Shipment.Lots"]</div><div class="ames-kpi-v">@_rows.Sum(x=>x.ItemCount)</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["Col.Quantity"]</div><div class="ames-kpi-v">@UomFmt.Qty(_rows.Sum(x=>x.Qty),null)</div></div>
</div>
@if (!string.IsNullOrWhiteSpace(_message)) { <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_message</RadzenAlert> }
<section class="ames-card shipments-page">
    <div class="ames-card-h master-list-toolbar">
        <span>▼ @L["FG.Shipments.Title"] · @_rows.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Placeholder='@L["FG.Shipments.Ph.SearchLot"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:250px" />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" @bind-Value="_from" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <span>–</span>
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" TValue="DateTime?" @bind-Value="_to" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="Reload" class="ames-rz-btn" />
            <RadzenButton Text="@L["Btn.Reset"].Value" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="Clear" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <RadzenDataGrid TItem="FinishedGoodsRepository.ShipmentRow" Data="@_rows" AllowPaging="true" PageSize="25"
                    PageSizeOptions="@_pageSizeOptions" PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]"
                    PageSizeChanged="@(s=>_pageRows=s)" Style="@($"--ames-page-rows:{_pageRows}")" AllowSorting="true" RowRender="RenderShipment" RowExpand="LoadChildren" Class="ames-rz-grid ames-grid-fixed shipment-list-grid" EmptyText='@L["FG.Shipments.Empty"]'>
        <Template Context="shipment">
            @if (_children.TryGetValue(shipment.ShipmentId, out var children))
            {
                <div class="shipment-items" role="region" aria-label='@L["Shipment.DetailsFmt",shipment.ShipmentId]' tabindex="0">
                    <RadzenDataGrid TItem="FinishedGoodsRepository.ShipmentItemRow" Data="children" AllowPaging="false" AllowSorting="true" Density="Density.Compact" Class="ames-rz-grid shipment-items-grid" EmptyText='@L["Grid.Empty"]'>
                        <Columns>
                            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentItemRow" Property="LotNo" Title='@L["Col.LotNo"]' />
                            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentItemRow" Property="PartNo" Title='@L["Col.PartNo"]' />
                            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentItemRow" Property="PartName" Title='@L["Col.PartName"]' />
                            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentItemRow" Property="Qty" Title='@L["Col.Quantity"]' TextAlign="TextAlign.Right"><Template Context="item">@UomFmt.QtyUnit(item.Qty,item.Unit)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentItemRow" Property="LocationNo" Title='@L["Shipment.FromLocation"]' />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="ShipmentId" Title='@L["Shipment.Id"]' Width="110px" MinWidth="110px" />
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="ShippedAt" Title='@L["FG.Shipments.Col.ShippedAt"]' Width="180px" MinWidth="180px"><Template Context="r">@r.ShippedAt.ToString(DateFmt.DateTime)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="LotNo" Title='@L["Col.LotNo"]' />
            <RadzenDataGridColumn Width="110px" MinWidth="110px" TItem="FinishedGoodsRepository.ShipmentRow" Property="PalletNo" Title='@L["Shipment.PalletNo"]' />
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="PartNo" Title='@L["Col.PartNo"]'><Template Context="r">@r.PartNo<div class="dim">@r.PartName</div></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="UnitType" Title='@L["Shipment.UnitType"]' Width="130px" MinWidth="130px" />
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="CustomerId" Title='@L["Col.Customer"]'><Template Context="r">@r.CustomerId<div class="dim">@r.CustomerName</div></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="ItemCount" Title='@L["Shipment.Lots"]' Width="80px" MinWidth="80px" />
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="Qty" Title='@L["Col.Quantity"]' Width="100px" MinWidth="100px"><Template Context="r">@UomFmt.Qty(r.Qty,null)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="ShippedBy" Title='@L["Shipment.ShippedBy"]' Width="130px" MinWidth="130px" />
        </Columns>
    </RadzenDataGrid>
</section>
@code {
    private List<FinishedGoodsRepository.ShipmentRow> _rows=[];
    private readonly Dictionary<int,List<FinishedGoodsRepository.ShipmentItemRow>> _children = [];
    private void RenderShipment(RowRenderEventArgs<FinishedGoodsRepository.ShipmentRow> args) => args.Expandable=args.Data?.HasChildren==true;
    private async Task LoadChildren(FinishedGoodsRepository.ShipmentRow row)
    {
        try { _children[row.ShipmentId]=await Task.Run(()=>Fg.ListShipmentItems(row.ShipmentId)); }
        catch(Exception ex) { Logger.LogError(ex,"Shipment details load failed");_message=L["Shipment.DetailsError"]; }
    }
    private readonly IEnumerable<int> _pageSizeOptions=[25,50,100];
    private int _pageRows=25;
    private string _search="",_message="";
    private DateTime? _from=DbClock.Today.AddMonths(-1),_to=DbClock.Today.AddMonths(1);
    protected override async Task OnInitializedAsync()=>await Reload();
    private async Task Reload()
    {
        if(_from>_to) { _message=L["Err.DateRange"]; return; }
        try { _rows=await Task.Run(()=>Fg.ListShipments(_search,_from,_to)); _children.Clear(); _message=""; }
        catch(Exception ex) { Logger.LogError(ex,"Shipments load failed");_rows=[]; _message=L["Shipment.LoadError"]; }
    }
    private async Task Clear() { _search=""; _from=DbClock.Today.AddMonths(-1); _to=DbClock.Today.AddMonths(1); await Reload(); }
}
