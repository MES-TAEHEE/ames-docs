@page "/fg/shipments"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using AMES.Data.Repositories
@using Radzen
@inject IStringLocalizer<SharedResources> L
@inject FinishedGoodsRepository Fg

<PageTitle>FG-03 @L["FG.Shipments.Title"] · AMES</PageTitle>
<AmesPageHeader Code="FG-03" TitleKey="FG.Shipments.Title" />

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">OUTBOUND LOTS</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">PART TYPES</div><div class="ames-kpi-v">@_rows.Select(x => x.PartNo).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Count()</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">TOTAL QTY</div><div class="ames-kpi-v">@_rows.Sum(x => x.Qty).ToString("N0")</div></div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_message</RadzenAlert>
}

<section class="ames-card inventory-summary-panel">
    <div class="ames-card-h master-list-toolbar">
        <span>▼ ACTUAL SHIPMENTS · @_rows.Count item(s)</span>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Placeholder="Search barcode, LOT, part or operator"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:280px;"
                           @onkeydown='e => { if (e.Key == "Enter") Reload(); }' />
            <RadzenDatePicker @bind-Value="_from" DateFormat="yyyy-MM-dd" Placeholder="@L["Col.From"].Value"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenDatePicker @bind-Value="_to" DateFormat="yyyy-MM-dd" Placeholder="@L["Col.To"].Value"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base"
                          Size="ButtonSize.Small" Click="Reload" class="ames-rz-btn" />
            <RadzenButton Text="@L["Btn.Reset"].Value" Icon="close" ButtonStyle="ButtonStyle.Base"
                          Size="ButtonSize.Small" Click="Clear" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="FinishedGoodsRepository.ShipmentRow" Data="@_rows" AllowPaging="true" PageSize="25"
                    PageSizeOptions="@_pageSizeOptions" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    ShowPagingSummary="true" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]"
                    EmptyText="No actual outbound history found." PageSizeChanged="@(s => _pageRows = s)"
                    Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="ShippedAt" Title="SHIPPED AT" Width="165px">
                <Template Context="r">@r.ShippedAt.ToString("yyyy-MM-dd HH:mm:ss")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="OutboundBarcode" Title="OUTBOUND BARCODE">
                <Template Context="r"><span class="code">@r.OutboundBarcode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="UnitType" Title="UNIT TYPE" Width="105px" TextAlign="TextAlign.Center">
                <Template Context="r"><span class="pill info">@r.UnitType</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="LotNo" Title="LOT NO">
                <Template Context="r"><span class="code">@r.LotNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="PartNo" Title="PART NO / NAME">
                <Template Context="r"><strong>@Text(r.PartNo)</strong><br /><small>@Text(r.PartName)</small></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="LocationNo" Title="LOCATION" Width="130px" />
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="Qty" Title="QTY" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@r.Qty.ToString("N0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="OperatorId" Title="OPERATOR" Width="130px" />
            <RadzenDataGridColumn TItem="FinishedGoodsRepository.ShipmentRow" Property="Status" Title="STATUS" Width="100px" TextAlign="TextAlign.Center">
                <Template Context="r"><span class="pill ok">@r.Status</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</section>

@code {
    private List<FinishedGoodsRepository.ShipmentRow> _rows = [];
    private readonly IEnumerable<int> _pageSizeOptions = [25, 50, 100];
    private int _pageRows = 25;
    private string _search = "", _message = "";
    private DateTime? _from = DbClock.Today.AddMonths(-6), _to = DbClock.Today;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        if (_from > _to) { _message = L["Err.DateRange"]; return; }
        try { _rows = Fg.ListShipments(_search, _from, _to); _message = ""; }
        catch (Exception ex) { _rows = []; _message = ex.Message; }
    }

    private void Clear()
    {
        _search = ""; _from = DbClock.Today.AddMonths(-6); _to = DbClock.Today;
        Reload();
    }

    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
}
