@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using AMES.Contracts.Dto
@inject FinishedGoodsRepository Fg
@inject UomFormat UomFmt
@inject PermissionService PermSvc
@inject AuthenticationStateProvider AuthPrvd
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@inject ILogger<ShipmentPlan> Logger
@inject DialogService Dialog
@inject AMES.Web.Services.AuditLogger Audit

@if (!Embedded)
{
    <PageTitle>FG-02 @L["FG.ShipPlan.Title"] · AMES</PageTitle>
    <AmesPageHeader Code="FG-02" TitleKey="FG.ShipPlan.Title" />
}
<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["FG.ShipPlan.Kpi.Dcrs"]</div><div class="ames-kpi-v">@_view.Count</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["Shipment.Customers"]</div><div class="ames-kpi-v">@_view.Select(x=>x.CustomerId).Distinct().Count()</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["FG.Ship.Lbl.EstPallets"]</div><div class="ames-kpi-v">@(_draft?.AutoPallets ?? 0)</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["FG.ShipPlan.Kpi.EstTrailers"]</div><div class="ames-kpi-v">@(_draft?.Trailers.Count(x=>x.Pallets.Count>0) ?? 0)</div></div>
</div>
@if (!string.IsNullOrEmpty(_error)) { <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@_error</RadzenAlert> }
<section class="ames-card shipment-plan-orders inventory-history-list" data-no-busy>
    <div class="ames-card-h master-list-toolbar">
        <span>▼ @L["FG.ShipPlan.List"] · @_view.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            <AmesSearchBox @bind-Value="_search" Placeholder='@L["FG.ShipPlan.Ph.Search"]' Search="Filter" />
                <RadzenDropDown TValue="string" Data="_customers" @bind-Value="_customer" @bind-Value:after="Filter" Disabled="_loading"
                AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder="@L["FG.ShipPlan.Ph.Customer"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:190px;" />
            <RadzenDatePicker Name="ShipDateFrom" TValue="DateTime?" @bind-Value="_shipFrom" @bind-Value:after="Load" Disabled="_loading"
                NavigationMode="DatePickerNavigationMode.DropDown" DateFormat="@DateFmt.Date" Placeholder='@L["Col.From"]' AllowClear="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenDatePicker TValue="DateTime?" @bind-Value="_shipTo" @bind-Value:after="Load" Disabled="_loading"
                NavigationMode="DatePickerNavigationMode.DropDown" DateFormat="@DateFmt.Date" Placeholder='@L["Col.To"]' AllowClear="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />

            <RadzenButton Text="@L["Btn.Refresh"]" Icon="refresh" Click="Load" Disabled="_loading" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            <RadzenButton Text="@L["FG.ShipPlan.Btn.TrailerPreview"]" Icon="local_shipping" Click="OpenTrailerPreview" Disabled="@(_loading || _draft is null)" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <RadzenDataGrid AllowColumnResize="true" TItem="ShipmentPlanRows.Delivery" Data="_view" IsLoading="_loading" AllowPaging="true" PageSize="25" AllowSorting="true" Density="Density.Compact" RowClick="OpenDeliveryDetails" RowRender="DeliveryRowRender"
                    PagerHorizontalAlign="HorizontalAlign.Center" PageSizeOptions="_pageSizeOptions" ShowPagingSummary="true"
                    PagingSummaryFormat='@L["Pager.Summary"]' PageSizeText='@L["Pager.PageSize"]'
                    PageSizeChanged="@(s=>_pageRows=s)" Style="@($"--ames-page-rows:{_pageRows}")"
                    EmptyText="@L["FG.ShipPlan.Empty"]" class="ames-rz-grid ames-grid-fixed">
        <Columns>
            <RadzenDataGridColumn Width="230px" MinWidth="200px" TItem="ShipmentPlanRows.Delivery" Property="DeliveryNo" Title="@L["FG.ShipPlan.Col.DcrNo"]"><Template Context="delivery">
                <span @onclick:stopPropagation="true"><RadzenButton Text="@delivery.DeliveryNo" Click="@(()=>_detailDelivery=delivery)" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" class="ames-rz-btn operational-code-link" /></span>
            </Template></RadzenDataGridColumn>
            <RadzenDataGridColumn Width="160px" MinWidth="120px" TItem="ShipmentPlanRows.Delivery" Property="CustomerId" Title="@L["Col.Customer"]"><Template Context="delivery"><span class="code">@delivery.CustomerId</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn Width="150px" MinWidth="120px" TItem="ShipmentPlanRows.Delivery" Property="ShipDate" Title="@L["Col.ShipDate"]"><Template Context="delivery"><span class="@(delivery.ShipDate.Date<DbClock.Today ? "operational-overdue" : null)">@delivery.ShipDate.ToString(DateFmt.Date)</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn Width="100px" MinWidth="90px" TItem="ShipmentPlanRows.Delivery" Property="OrderCount" TextAlign="TextAlign.Right" Title="@L["FG.ShipPlan.Col.Orders"]" />
            <RadzenDataGridColumn Width="100px" MinWidth="90px" TItem="ShipmentPlanRows.Delivery" Property="PartCount" TextAlign="TextAlign.Right" Title="@L["FG.Ship.Lbl.Parts"]" />
            <RadzenDataGridColumn Width="180px" MinWidth="170px" TItem="ShipmentPlanRows.Delivery" TextAlign="TextAlign.Right" Title="@L["FG.Ship.Col.ShipQty"]" Sortable="false"><Template Context="delivery"><strong class="operational-quantity">@DeliveryQuantity(delivery)</strong></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn Width="120px" MinWidth="110px" TItem="ShipmentPlanRows.Delivery" Property="Status" TextAlign="TextAlign.Center" Title="@L["Col.Status"]"><Template Context="delivery"><span class="pill @(delivery.Status=="Loading" ? "info" : "warn")">@delivery.Status</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShipmentPlanRows.Delivery" Title="@L["Btn.Print"]" Width="110px" MinWidth="100px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="delivery"><span @onclick:stopPropagation="true"><RadzenButton Text="@L["Btn.Print"]" Icon="print" Click="@(()=>PrintDelivery(delivery))" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" /></span></Template></RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</section>
@if(_detailDelivery is not null)
{
    <div class="ames-modal-bg" data-no-busy @onclick="CloseDeliveryDetails"><div class="ames-modal ames-modal-wide" role="dialog" aria-modal="true" aria-label="@_detailDelivery.DeliveryNo" @onclick:stopPropagation>
        <div class="ames-modal-h">@_detailDelivery.DeliveryNo</div>
        <ShippingDeliveryOrderSummary Orders="_detailDelivery.Orders" ShipDate="_detailDelivery.ShipDate" />
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
            @if(_canEdit && _detailDelivery.Status=="Open")
            {
                <RadzenTextBox @bind-Value="_releaseReason" MaxLength="200" Placeholder='@L["FG.ShipPlan.Release.Reason"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:260px;" />
                <RadzenButton Text="@L["FG.ShipPlan.Release.Btn"]" Icon="link_off" Click="ReleaseDelivery" Disabled="_loading" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
            }
            <RadzenButton Text="@L["Btn.Print"]" Icon="print" Click="PrintDeliveryDetails" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            <RadzenButton Text="@L["Btn.Close"]" Icon="close" Click="CloseDeliveryDetails" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
        </RadzenStack>
    </div></div>
}
@if(_printDelivery is not null)
{
    <ShippingOrderPrintPreview Orders="_printOrders" Delivery="_printDelivery" Closed="ClosePrint" />
}
@code {
    [Parameter] public bool Embedded { get; set; }
    [SupplyParameterFromQuery(Name="from")] public DateTime? From {get;set;}
    [SupplyParameterFromQuery(Name="to")] public DateTime? To {get;set;}
    [SupplyParameterFromQuery(Name="dcr")] public string? Dcr {get;set;}
    List<ShipmentPlanRows.Delivery> _deliveries=[],_view=[];
    List<ShippingOrderDto> _printOrders=[];
    ShippingDeliveryDto? _printDelivery;
    ShipmentPlanRows.Delivery? _detailDelivery;
    List<string> _customers=[];
    readonly IEnumerable<int> _pageSizeOptions=[25,50,100];
    int _pageRows=25;
    TrailerLoadDraft? _draft;
    string _error="",_search="";
    string? _customer;
    DateTime? _shipFrom,_shipTo;
    bool _allowed,_loading,_canEdit;string _releaseReason="";
    void OpenDeliveryDetails(DataGridRowMouseEventArgs<ShipmentPlanRows.Delivery> args)=>_detailDelivery=args.Data;
    void DeliveryRowRender(RowRenderEventArgs<ShipmentPlanRows.Delivery> args)=>args.Attributes["class"]="ames-row-link";
    void CloseDeliveryDetails(){_detailDelivery=null;_releaseReason="";}
    async Task ReleaseDelivery()
    {
        if(_detailDelivery is null||_loading||!_canEdit)return;
        if(string.IsNullOrWhiteSpace(_releaseReason)){_error=L["FG.ShipPlan.Release.Required"].Value;return;}
        var d=_detailDelivery;var reason=_releaseReason.Trim();
        try
        {
            var actor=ActorCode.Of((await AuthPrvd.GetAuthenticationStateAsync()).User);
            await Task.Run(()=>Fg.ReleaseShippingDelivery(d.DeliveryId,actor));
            Audit.Log("FG-03","RELEASE","FG_Delivery",d.DeliveryNo,new{d.Status,Orders=d.Orders.Select(o=>o.OrderNo)},new{Status="Cancelled",Reason=reason},note:reason);
            CloseDeliveryDetails();
            await Load();
            _error="";
        }
        catch(Exception ex){Logger.LogWarning(ex,"DCR release failed");_error=ex.Message;}
    }
    async Task PrintDeliveryDetails()
    {
        if(_detailDelivery is null)return;
        await PrintDelivery(_detailDelivery);
        if(_printDelivery is not null)CloseDeliveryDetails();
    }
    async Task OpenTrailerPreview()
    {
        if(_draft is null || _shipFrom is null || _shipTo is null || _loading)return;
        await Dialog.OpenAsync<ShipmentTrailerDialog>(L["FG.Trailer.Title"].Value,new()
        {
            [nameof(ShipmentTrailerDialog.Plan)]=_draft,
            [nameof(ShipmentTrailerDialog.ShipFrom)]=_shipFrom.Value,
            [nameof(ShipmentTrailerDialog.ShipTo)]=_shipTo.Value
        },new DialogOptions{Width="96vw",Height="90vh",Resizable=true,CloseDialogOnOverlayClick=true});
    }
    protected override async Task OnParametersSetAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        _allowed=PermSvc.CanOpen("fg/shipment-plan");
        _canEdit=PermSvc.CanEdit("fg/shipping-orders");
        if(!_allowed){Nav.NavigateTo("/unauthorized",replace:true);return;}
        _shipFrom=From?.Date??DbClock.Today.AddMonths(-1);
        _shipTo=To?.Date??DbClock.Today.AddMonths(1);
        _search=Dcr??"";
        await Load();
    }
    async Task Load()
    {
        if(!_allowed||_loading)return;
        _error="";_draft=null;
        if(_shipFrom is null||_shipTo is null||_shipFrom>_shipTo)
        { _deliveries=[];_view=[];_customers=[];_error=L["FG.ShipPlan.Err.DateRange"].Value;return; }
        _loading=true;
        var from=_shipFrom;var to=_shipTo;
        try
        {
            _deliveries=ShipmentPlanRows.FromOrders(await Task.Run(()=>Fg.ListShippingOrders(from,to,onlyOpen:true,byDeliveryDate:true)));
            _customers=_deliveries.Select(x=>x.CustomerId).Distinct().Order().ToList();
            if(_customer is not null&&!_customers.Contains(_customer))_customer=null;
            Filter();
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Shipment plan DCRs load failed");
            _deliveries=[];_view=[];_customers=[];_draft=null;
            _error=L["FG.ShipPlan.Err.Load"].Value;
        }
        finally{_loading=false;}
    }
    void Filter()
    {
        _view=_deliveries.Where(o=>(string.IsNullOrEmpty(_customer)||o.CustomerId==_customer)
            &&(string.IsNullOrWhiteSpace(_search)||o.DeliveryNo.Contains(_search,StringComparison.OrdinalIgnoreCase)
                ||o.CustomerId.Contains(_search,StringComparison.OrdinalIgnoreCase)
                ||o.Orders.Any(order=>order.OrderNo.Contains(_search,StringComparison.OrdinalIgnoreCase))
                ||o.Lines.Any(l=>l.PartNo.Contains(_search,StringComparison.OrdinalIgnoreCase)
                    ||(l.PartName?.Contains(_search,StringComparison.OrdinalIgnoreCase)??false)
                    ||l.SoNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)))).ToList();
        _draft=null;_error="";
        if(_view.Count==0)return;
        var draft=new TrailerLoadDraft();
        if(draft.Build(TrailerLoadDraft.FromOrders(_view.SelectMany(d=>d.Orders)),out _error))_draft=draft;
    }
    string DeliveryQuantity(ShipmentPlanRows.Delivery delivery)=>string.Join(" · ",delivery.Lines.GroupBy(l=>l.Unit)
        .Select(g=>UomFmt.QtyUnit(g.Sum(l=>l.Qty),g.Key)));
    async Task PrintDelivery(ShipmentPlanRows.Delivery delivery)
    {
        _error="";_printOrders=[];_printDelivery=null;
        try{var document=await Task.Run(()=>Fg.GetShippingDeliveryForPrint(delivery.DeliveryNo));_printOrders=delivery.Orders;_printDelivery=document;}
        catch(InvalidOperationException ex){Logger.LogWarning(ex,"DCR {DeliveryNo} print document unavailable",delivery.DeliveryNo);_error=ex.Message;}
        catch(Exception ex){Logger.LogError(ex,"DCR {DeliveryNo} print load failed",delivery.DeliveryNo);_error=L["FG.ShipPlan.Err.PrintLoad"].Value;}
    }
    void ClosePrint(){_printDelivery=null;_printOrders=[];}
}
