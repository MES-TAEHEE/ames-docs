@page "/fg/shipment-plan"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>FG-02 Shipment Plan - AMES</PageTitle>
<AmesPageHeader Code="FG-02" Title="Shipment Plan" />

<div class="ames-page-fill shipment-plan-page">
    <section class="today-strip">
        <div>
            <span>SHIPMENT DATE</span>
            <input class="plan-date-input" type="date" value="@_planDate.ToString("yyyy-MM-dd")" @onchange="ChangeDate" />
        </div>
        <div class="truck-total">
            <strong>@CurrentTrucks.Count</strong>
            <span>TRUCKS REQUIRED</span>
        </div>
    </section>

    <section class="ames-card truck-section">
        <div class="ames-card-h section-title">
            <span>TRUCKS</span>
            <small>Select a truck to view its pallet load list</small>
        </div>
        @if (CurrentTrucks.Count == 0)
        {
            <div class="empty-plan">No shipment plan for the selected date.</div>
        }
        else
        {
            <div class="truck-grid">
                @foreach (var truck in CurrentTrucks)
                {
                    <button type="button" class="truck-card @(ReferenceEquals(truck, _selectedTruck) ? "selected" : null)"
                            @onclick="() => _selectedTruck = truck">
                        <div class="truck-card-head">
                            <strong>@truck.No</strong>
                            <span>@truck.Destination</span>
                        </div>
                        <div class="truck-project">@truck.Project</div>
                        <div class="load-track"><i style="width:@truck.Percent%"></i></div>
                        <div class="truck-card-foot">
                            <span>@truck.Lines.Count ITEM(S)</span>
                            <strong>@truck.LoadUnits / @truck.Capacity @truck.LoadLabel</strong>
                        </div>
                    </button>
                }
            </div>
        }
    </section>

    @if (_selectedTruck is not null)
    {
        <section class="ames-card load-list-card">
            <div class="ames-card-h selected-truck-header">
                <div>
                    <span>@_selectedTruck.No LOAD LIST</span>
                    <small>@_selectedTruck.Destination · @_selectedTruck.Project</small>
                </div>
                <strong>@_selectedTruck.LoadUnits @(_selectedTruck.LoadUnits == 1 ? "PALLET" : "PALLETS / TOTES")</strong>
            </div>
            <div class="table-scroll">
                <table class="load-table">
                    <thead>
                        <tr>
                            <th>PO NO</th>
                            <th>CUSTOMER</th>
                            <th>P/J</th>
                            <th>PART NO</th>
                            <th>ITEM</th>
                            <th class="number">TOTAL QTY</th>
                            <th class="number">QTY / UNIT</th>
                            <th class="number">REQUIRED</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _selectedTruck.Lines)
                        {
                            <tr>
                                <td><span class="code">@line.PoNo</span></td>
                                <td><strong>@_selectedTruck.Destination</strong></td>
                                <td><span class="project-chip">@line.Project</span></td>
                                <td><span class="code">@line.PartNo</span></td>
                                <td><strong>@line.Item</strong></td>
                                <td class="number">@line.Qty.ToString("N0")</td>
                                <td class="number">@line.QtyPerLoadUnit.ToString("N0")</td>
                                <td class="number"><strong>@line.LoadUnits @line.LoadType</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5">TOTAL</td>
                            <td class="number">@_selectedTruck.Lines.Sum(x => x.Qty).ToString("N0")</td>
                            <td></td>
                            <td class="number">@_selectedTruck.LoadUnits</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="pallet-section">
                <div class="pallet-section-title">
                    <span>TOTAL PALLET LOAD BREAKDOWN</span>
                    <small>각 팔렛에 적재할 품목과 수량</small>
                </div>
                <div class="pallet-grid">
                    @foreach (var pallet in PalletBreakdown(_selectedTruck))
                    {
                        <div class="pallet-row">
                            <div>
                                <strong>@pallet.Label</strong>
                                <span>@pallet.PartNo</span>
                            </div>
                            <p>@pallet.Item</p>
                            <b>@pallet.Qty.ToString("N0") EA</b>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

@code {
    sealed record LoadLine(string PoNo, string Project, string PartNo, string Item, int Qty,
        int QtyPerLoadUnit, int LoadUnits, string LoadType = "PALLET");

    sealed record TruckPlan(string No, string Destination, string Project, int Capacity, List<LoadLine> Lines)
    {
        public int LoadUnits => Lines.Sum(x => x.LoadUnits);
        public int Percent => Math.Min(100, LoadUnits * 100 / Capacity);
        public string LoadLabel => Lines.All(x => x.LoadType == "PALLET") ? "PALLETS" : "LOAD UNITS";
    }

    sealed record DayPlan(DateTime Date, List<TruckPlan> Trucks);
    sealed record PalletRow(string Label, string PartNo, string Item, int Qty);

    readonly List<DayPlan> _plans =
    [
        new(DateTime.Today,
        [
            new("TRUCK 01", "SEga", "LO2", 18,
            [
                new("PO-SEGA-260901", "LO2", "81710-PI010NNB", "RR U/TRIM_NON CURTAIN L/RH", 880, 55, 16)
            ]),
            new("TRUCK 02", "SEga", "LO2", 18,
            [
                new("PO-SEGA-260901", "LO2", "81720-PI010NNB", "RR U/TRIM_CURTAIN L/RH", 605, 55, 11),
                new("PO-SEGA-260901", "LO2", "81730-PI010NNB", "RR UPR GARNISH L/RH", 544, 272, 2)
            ]),
            new("TRUCK 03", "SEga", "NQ5a", 18,
            [
                new("PO-SEGA-260902", "NQ5a", "85710-NQ500NNB", "FRT U/TRIM L/RH", 630, 70, 9)
            ]),
            new("TRUCK 04", "SEau", "NX5a", 18,
            [
                new("PO-SEAU-260117", "NX5a", "84610-NX500NNB", "CONSOL D/SIDE", 504, 28, 18)
            ])
        ]),
        new(DateTime.Today.AddDays(1),
        [
            new("TRUCK 01", "SEsv", "MEa", 18,
            [
                new("PO-SESV-260301", "MEa", "85710-ME000NNB", "FRT U/TRIM L/RH", 448, 56, 8),
                new("PO-SESV-260301", "MEa", "81710-ME000NNB", "RR U/TRIM_NON CURTAIN L/RH", 480, 60, 8)
            ]),
            new("TRUCK 02", "SEsv", "MEa", 18,
            [
                new("PO-SESV-260302", "MEa", "81720-ME000NNB", "RR U/TRIM_CURTAIN L/RH", 360, 60, 6),
                new("PO-SESV-260302", "MEa", "96310-ME000NNB", "FRT DR SPKR L/RH", 840, 84, 10)
            ])
        ]),
        new(DateTime.Today.AddDays(2),
        [
            new("TRUCK 01", "SEsv", "NEa", 18,
            [
                new("PO-SESV-260401", "NEa", "85710-NE000NNB", "FRT U/TRIM L/RH", 256, 32, 8),
                new("PO-SESV-260401", "NEa", "81710-NE000NNB", "RR U/TRIM_NON CURTAIN L/RH", 240, 30, 8)
            ])
        ])
    ];

    DateTime _planDate = DateTime.Today;
    TruckPlan? _selectedTruck;
    List<TruckPlan> CurrentTrucks => _plans.FirstOrDefault(x => x.Date.Date == _planDate.Date)?.Trucks ?? [];

    protected override void OnInitialized() => SelectFirstTruck();

    void ChangeDate(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
            _planDate = date.Date;
        SelectFirstTruck();
    }

    void SelectFirstTruck() => _selectedTruck = CurrentTrucks.FirstOrDefault();

    static IEnumerable<PalletRow> PalletBreakdown(TruckPlan truck)
    {
        var palletNo = 1;
        foreach (var line in truck.Lines)
        {
            for (var i = 0; i < line.LoadUnits; i++)
            {
                var qty = Math.Min(line.QtyPerLoadUnit, line.Qty - (i * line.QtyPerLoadUnit));
                yield return new PalletRow($"{line.LoadType} {palletNo++:00}", line.PartNo, line.Item, qty);
            }
        }
    }
}
