@page "/fg/shipment-plan"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using AMES.Contracts.Dto
@inject FinishedGoodsRepository Fg
@inject UomFormat UomFmt
@inject PermissionService PermSvc
@inject AuthenticationStateProvider AuthPrvd
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@inject ILogger<ShipmentPlan> Logger
@inject DialogService Dialog

<PageTitle>FG-03 Shipment Plan · AMES</PageTitle>
<AmesPageHeader Code="FG-03" Title="Shipment Plan" />
<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">Shipment orders</div><div class="ames-kpi-v">@_view.Count</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">Customers</div><div class="ames-kpi-v">@_view.Select(x=>x.CustomerId).Distinct().Count()</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">Estimated pallets</div><div class="ames-kpi-v">@(_draft?.AutoPallets ?? 0)</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">Estimated trailers</div><div class="ames-kpi-v">@(_draft?.Trailers.Count(x=>x.Pallets.Count>0) ?? 0)</div></div>
</div>
@if (!string.IsNullOrEmpty(_error)) { <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@_error</RadzenAlert> }
<section class="ames-card shipment-plan-orders" data-no-busy>
    <div class="ames-card-h master-list-toolbar">
        <span>▼ SHIPMENT ORDERS · @_view.Count</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            <RadzenLabel Text="Ship date" Component="ShipDateFrom" />
            <RadzenDatePicker Name="ShipDateFrom" TValue="DateTime?" @bind-Value="_shipFrom" @bind-Value:after="Load" Disabled="_loading"
                NavigationMode="DatePickerNavigationMode.DropDown" DateFormat="@DateFmt.Date" AllowClear="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <span>–</span>
            <RadzenDatePicker TValue="DateTime?" @bind-Value="_shipTo" @bind-Value:after="Load" Disabled="_loading"
                NavigationMode="DatePickerNavigationMode.DropDown" DateFormat="@DateFmt.Date" AllowClear="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <RadzenDropDown TValue="string" Data="_customers" @bind-Value="_customer" @bind-Value:after="Filter" Disabled="_loading"
                AllowClear="true" AllowFiltering="true" Placeholder="All customers" InputSize="InputSize.Small" class="ames-rz-input" Style="width:170px" />
            <RadzenTextBox @bind-Value="_search" @bind-Value:after="Filter" Disabled="_loading" Placeholder="Order / SO / Part" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenButton Text="Refresh" Icon="refresh" Click="Load" Disabled="_loading" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            <RadzenButton Text="Trailer Preview" Icon="local_shipping" Click="OpenTrailerPreview" Disabled="@(_loading || _draft is null)" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <RadzenDataGrid TItem="ShippingOrderDto" Data="_view" AllowPaging="true" PageSize="25" AllowSorting="true"
                    PagerHorizontalAlign="HorizontalAlign.Center" PageSizeOptions="_pageSizeOptions" ShowPagingSummary="true"
                    PagingSummaryFormat='@L["Pager.Summary"]' PageSizeText='@L["Pager.PageSize"]'
                    PageSizeChanged="@(s=>_pageRows=s)" Style="@($"--ames-page-rows:{_pageRows}")"
                    EmptyText="No open shipment orders in this date range. Create a Shipment Order first." class="ames-rz-grid ames-grid-fixed">
        <Template Context="order"><ShipmentOrderLines Lines="order.Lines" /></Template>
        <Columns>
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="OrderNo" Title="ORDER NO" />
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="CustomerId" Title="CUSTOMER" />
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="ShipDate" Title="SHIP DATE" FormatString="@DateFmt.Fmt(DateFmt.Date)" />
            <RadzenDataGridColumn TItem="ShippingOrderDto" Title="PARTS / SHIP QTY"><Template Context="order">
                @order.Lines.Select(x=>x.PartNo).Distinct().Count() parts · @OrderQuantity(order)
            </Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="Status" Title="STATUS" />
            <RadzenDataGridColumn TItem="ShippingOrderDto" Property="DeliveryNo" Title="DCR / TRAILER" />
        </Columns>
    </RadzenDataGrid>
</section>
@code {
    [SupplyParameterFromQuery(Name="from")] public DateTime? From {get;set;}
    [SupplyParameterFromQuery(Name="to")] public DateTime? To {get;set;}
    List<ShippingOrderDto> _orders=[],_view=[];
    List<string> _customers=[];
    readonly IEnumerable<int> _pageSizeOptions=[25,50,100];
    int _pageRows=25;
    TrailerLoadDraft? _draft;
    string _error="",_search="";
    string? _customer;
    DateTime? _shipFrom,_shipTo;
    bool _allowed,_loading;
    async Task OpenTrailerPreview()
    {
        if(_draft is null || _shipFrom is null || _shipTo is null || _loading)return;
        await Dialog.OpenAsync<ShipmentTrailerDialog>("Trailer Load Preview",new()
        {
            [nameof(ShipmentTrailerDialog.Plan)]=_draft,
            [nameof(ShipmentTrailerDialog.ShipFrom)]=_shipFrom.Value,
            [nameof(ShipmentTrailerDialog.ShipTo)]=_shipTo.Value
        },new DialogOptions{Width="96vw",Height="90vh",Resizable=true,Draggable=true,CloseDialogOnOverlayClick=true});
    }
    protected override async Task OnParametersSetAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        _allowed=PermSvc.CanOpen("fg/shipment-plan");
        if(!_allowed){Nav.NavigateTo("/unauthorized",replace:true);return;}
        _shipFrom=From?.Date??DbClock.Today;
        _shipTo=To?.Date??DbClock.Today.AddDays(6);
        await Load();
    }
    async Task Load()
    {
        if(!_allowed||_loading)return;
        _error="";_draft=null;
        if(_shipFrom is null||_shipTo is null||_shipFrom>_shipTo)
        { _orders=[];_view=[];_customers=[];_error="Select a valid ship-date range.";return; }
        _loading=true;
        var from=_shipFrom;var to=_shipTo;
        try
        {
            _orders=await Task.Run(()=>Fg.ListShippingOrders(from,to,onlyOpen:true));
            _customers=_orders.Select(x=>x.CustomerId).Distinct().Order().ToList();
            if(_customer is not null&&!_customers.Contains(_customer))_customer=null;
            Filter();
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Shipment plan orders load failed");
            _orders=[];_view=[];_customers=[];_draft=null;
            _error="Unable to load saved shipment orders. Check the connection and click Refresh.";
        }
        finally{_loading=false;}
    }
    void Filter()
    {
        _view=_orders.Where(o=>(string.IsNullOrEmpty(_customer)||o.CustomerId==_customer)
            &&(string.IsNullOrWhiteSpace(_search)||o.OrderNo.Contains(_search,StringComparison.OrdinalIgnoreCase)
                ||o.CustomerId.Contains(_search,StringComparison.OrdinalIgnoreCase)
                ||(o.DeliveryNo?.Contains(_search,StringComparison.OrdinalIgnoreCase)??false)
                ||o.Lines.Any(l=>l.PartNo.Contains(_search,StringComparison.OrdinalIgnoreCase)
                    ||(l.PartName?.Contains(_search,StringComparison.OrdinalIgnoreCase)??false)
                    ||l.SoNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)))).ToList();
        _draft=null;_error="";
        if(_view.Count==0)return;
        var draft=new TrailerLoadDraft();
        if(draft.Build(TrailerLoadDraft.FromOrders(_view),out _error))_draft=draft;
    }
    string OrderQuantity(ShippingOrderDto order)=>string.Join(" · ",order.Lines.GroupBy(l=>l.Unit)
        .Select(g=>UomFmt.QtyUnit(g.Sum(l=>l.Qty),g.Key)));
}
