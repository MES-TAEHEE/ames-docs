@page "/fg/shipment-plan"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using AMES.Contracts.Dto
@inject FinishedGoodsRepository Fg
@inject UomFormat UomFmt
@inject PermissionService PermSvc
@inject AuthenticationStateProvider AuthPrvd
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@inject ILogger<ShipmentPlan> Logger
@inject DialogService Dialog

<PageTitle>FG-03 @L["FG.ShipPlan.Title"] · AMES</PageTitle>
<AmesPageHeader Code="FG-03" TitleKey="FG.ShipPlan.Title" />
<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["FG.ShipPlan.Kpi.Dcrs"]</div><div class="ames-kpi-v">@_view.Count</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["Shipment.Customers"]</div><div class="ames-kpi-v">@_view.Select(x=>x.CustomerId).Distinct().Count()</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["FG.Ship.Lbl.EstPallets"]</div><div class="ames-kpi-v">@(_draft?.AutoPallets ?? 0)</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["FG.ShipPlan.Kpi.EstTrailers"]</div><div class="ames-kpi-v">@(_draft?.Trailers.Count(x=>x.Pallets.Count>0) ?? 0)</div></div>
</div>
@if (!string.IsNullOrEmpty(_error)) { <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@_error</RadzenAlert> }
<section class="ames-card shipment-plan-orders" data-no-busy>
    <div class="ames-card-h master-list-toolbar">
        <span>▼ @L["FG.ShipPlan.List"] · @_view.Count</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
            <RadzenLabel Text="@L["Col.ShipDate"]" Component="ShipDateFrom" />
            <RadzenDatePicker Name="ShipDateFrom" TValue="DateTime?" @bind-Value="_shipFrom" @bind-Value:after="Load" Disabled="_loading"
                NavigationMode="DatePickerNavigationMode.DropDown" DateFormat="@DateFmt.Date" AllowClear="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <span>–</span>
            <RadzenDatePicker TValue="DateTime?" @bind-Value="_shipTo" @bind-Value:after="Load" Disabled="_loading"
                NavigationMode="DatePickerNavigationMode.DropDown" DateFormat="@DateFmt.Date" AllowClear="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <RadzenDropDown TValue="string" Data="_customers" @bind-Value="_customer" @bind-Value:after="Filter" Disabled="_loading"
                AllowClear="true" AllowFiltering="true" Placeholder="@L["FG.ShipPlan.Ph.Customer"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:170px" />
            <RadzenTextBox @bind-Value="_search" @bind-Value:after="Filter" Disabled="_loading" Placeholder="@L["FG.ShipPlan.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenButton Text="@L["Btn.Refresh"]" Icon="refresh" Click="Load" Disabled="_loading" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            <RadzenButton Text="@L["FG.ShipPlan.Btn.TrailerPreview"]" Icon="local_shipping" Click="OpenTrailerPreview" Disabled="@(_loading || _draft is null)" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <RadzenDataGrid TItem="ShipmentPlanRows.Delivery" Data="_view" AllowPaging="true" PageSize="25" AllowSorting="true"
                    PagerHorizontalAlign="HorizontalAlign.Center" PageSizeOptions="_pageSizeOptions" ShowPagingSummary="true"
                    PagingSummaryFormat='@L["Pager.Summary"]' PageSizeText='@L["Pager.PageSize"]'
                    PageSizeChanged="@(s=>_pageRows=s)" Style="@($"--ames-page-rows:{_pageRows}")"
                    EmptyText="@L["FG.ShipPlan.Empty"]" class="ames-rz-grid ames-grid-fixed">
        <Template Context="delivery">
            <div class="shipment-plan-details">
                @foreach(var order in delivery.Orders)
                {
                    <section class="ames-card"><div class="ames-card-h">@order.OrderNo</div><ShipmentOrderLines Lines="order.Lines" /></section>
                }
            </div>
        </Template>
        <Columns>
            <RadzenDataGridColumn Width="160px" MinWidth="160px" TItem="ShipmentPlanRows.Delivery" Property="DeliveryNo" Title="@L["FG.ShipPlan.Col.DcrNo"]" />
            <RadzenDataGridColumn Width="100px" MinWidth="100px" TItem="ShipmentPlanRows.Delivery" Property="CustomerId" Title="@L["Col.Customer"]" />
            <RadzenDataGridColumn Width="140px" MinWidth="140px" TItem="ShipmentPlanRows.Delivery" Property="ShipDate" Title="@L["Col.ShipDate"]" FormatString="@DateFmt.Fmt(DateFmt.Date)" />
            <RadzenDataGridColumn Width="90px" MinWidth="90px" TItem="ShipmentPlanRows.Delivery" Title="@L["FG.ShipPlan.Col.Orders"]"><Template Context="delivery">@delivery.Orders.Count</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn MinWidth="190px" TItem="ShipmentPlanRows.Delivery" Title="@L["FG.ShipPlan.Col.PartsQty"]"><Template Context="delivery">
                @delivery.Lines.Select(x=>x.PartNo).Distinct().Count() @L["FG.Ship.Lbl.Parts"] · @DeliveryQuantity(delivery)
            </Template></RadzenDataGridColumn>
            <RadzenDataGridColumn Width="80px" MinWidth="80px" TItem="ShipmentPlanRows.Delivery" Property="Status" Title="@L["Col.Status"]" />
            <RadzenDataGridColumn TItem="ShipmentPlanRows.Delivery" Title="@L["Btn.Print"]" Width="110px" MinWidth="110px"><Template Context="delivery"><RadzenButton Text="@L["Btn.Print"]" Icon="print" Click="@(()=>PrintDelivery(delivery))" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" /></Template></RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</section>
@if(_printDelivery is not null)
{
    <ShippingOrderPrintPreview Orders="_printOrders" Delivery="_printDelivery" Closed="ClosePrint" />
}
@code {
    [SupplyParameterFromQuery(Name="from")] public DateTime? From {get;set;}
    [SupplyParameterFromQuery(Name="to")] public DateTime? To {get;set;}
    [SupplyParameterFromQuery(Name="dcr")] public string? Dcr {get;set;}
    List<ShipmentPlanRows.Delivery> _deliveries=[],_view=[];
    List<ShippingOrderDto> _printOrders=[];
    ShippingDeliveryDto? _printDelivery;
    List<string> _customers=[];
    readonly IEnumerable<int> _pageSizeOptions=[25,50,100];
    int _pageRows=25;
    TrailerLoadDraft? _draft;
    string _error="",_search="";
    string? _customer;
    DateTime? _shipFrom,_shipTo;
    bool _allowed,_loading;
    async Task OpenTrailerPreview()
    {
        if(_draft is null || _shipFrom is null || _shipTo is null || _loading)return;
        await Dialog.OpenAsync<ShipmentTrailerDialog>(L["FG.Trailer.Title"].Value,new()
        {
            [nameof(ShipmentTrailerDialog.Plan)]=_draft,
            [nameof(ShipmentTrailerDialog.ShipFrom)]=_shipFrom.Value,
            [nameof(ShipmentTrailerDialog.ShipTo)]=_shipTo.Value
        },new DialogOptions{Width="96vw",Height="90vh",Resizable=true,Draggable=true,CloseDialogOnOverlayClick=true});
    }
    protected override async Task OnParametersSetAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        _allowed=PermSvc.CanOpen("fg/shipment-plan");
        if(!_allowed){Nav.NavigateTo("/unauthorized",replace:true);return;}
        _shipFrom=From?.Date??DbClock.Today.AddMonths(-1);
        _shipTo=To?.Date??DbClock.Today.AddMonths(1);
        _search=Dcr??"";
        await Load();
    }
    async Task Load()
    {
        if(!_allowed||_loading)return;
        _error="";_draft=null;
        if(_shipFrom is null||_shipTo is null||_shipFrom>_shipTo)
        { _deliveries=[];_view=[];_customers=[];_error=L["FG.ShipPlan.Err.DateRange"].Value;return; }
        _loading=true;
        var from=_shipFrom;var to=_shipTo;
        try
        {
            _deliveries=ShipmentPlanRows.FromOrders(await Task.Run(()=>Fg.ListShippingOrders(from,to,onlyOpen:true)));
            _customers=_deliveries.Select(x=>x.CustomerId).Distinct().Order().ToList();
            if(_customer is not null&&!_customers.Contains(_customer))_customer=null;
            Filter();
        }
        catch(Exception ex)
        {
            Logger.LogError(ex,"Shipment plan DCRs load failed");
            _deliveries=[];_view=[];_customers=[];_draft=null;
            _error=L["FG.ShipPlan.Err.Load"].Value;
        }
        finally{_loading=false;}
    }
    void Filter()
    {
        _view=_deliveries.Where(o=>(string.IsNullOrEmpty(_customer)||o.CustomerId==_customer)
            &&(string.IsNullOrWhiteSpace(_search)||o.DeliveryNo.Contains(_search,StringComparison.OrdinalIgnoreCase)
                ||o.CustomerId.Contains(_search,StringComparison.OrdinalIgnoreCase)
                ||o.Orders.Any(order=>order.OrderNo.Contains(_search,StringComparison.OrdinalIgnoreCase))
                ||o.Lines.Any(l=>l.PartNo.Contains(_search,StringComparison.OrdinalIgnoreCase)
                    ||(l.PartName?.Contains(_search,StringComparison.OrdinalIgnoreCase)??false)
                    ||l.SoNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)))).ToList();
        _draft=null;_error="";
        if(_view.Count==0)return;
        var draft=new TrailerLoadDraft();
        if(draft.Build(TrailerLoadDraft.FromOrders(_view.SelectMany(d=>d.Orders)),out _error))_draft=draft;
    }
    string DeliveryQuantity(ShipmentPlanRows.Delivery delivery)=>string.Join(" · ",delivery.Lines.GroupBy(l=>l.Unit)
        .Select(g=>UomFmt.QtyUnit(g.Sum(l=>l.Qty),g.Key)));
    async Task PrintDelivery(ShipmentPlanRows.Delivery delivery)
    {
        try{_printOrders=delivery.Orders;_printDelivery=await Task.Run(()=>Fg.GetShippingDelivery(delivery.DeliveryNo));}
        catch(Exception ex){Logger.LogError(ex,"DCR print load failed");_error=L["FG.ShipPlan.Err.PrintLoad"].Value;}
    }
    void ClosePrint(){_printDelivery=null;_printOrders=[];}
}
