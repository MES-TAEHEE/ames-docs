@page "/fg/inventory"
@inject IStringLocalizer<SharedResources> L
@inject AMES.Data.Repositories.WarehouseRepository InventoryRepo
@inject MasterDataRepository MD
@inject ScmRepository SCM
@rendermode AmesRender.Server
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>FG-01 @L["FG.Inventory.Title"] · AMES</PageTitle>
<AmesPageHeader Code="FG-01" TitleKey="FG.Inventory.Title" />

<AmesTabs>
<AmesTab Title="@L["FG.Inventory.Title"]">
@if (!string.IsNullOrWhiteSpace(_error))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_error</RadzenAlert>
}
else
{
    <InventoryLookup Inventory="_inventory" ItemVendors="_itemVendors" ItemCodes="_itemCodes" SearchId="fg-inventory-search" FinishedGoodsOnly="true" InventoryChanged="ReloadInventory" />
}
</AmesTab>
<AmesTab Title="@L["FG.FactoryMap.Title"]">
    <FactoryLayoutMap />
</AmesTab>
</AmesTabs>

@code {
    private List<LocationMapStock> _inventory = [];
    private string? _error;
    private List<ScmRepository.ItemVendorRow> _itemVendors = [];
    private List<MasterDataRepository.CodeItemRow> _itemCodes = [];

    protected override void OnInitialized() => ReloadInventory();
    private void ReloadInventory()
    {
        try
        {
            _error = null;
            var stock = InventoryRepo.ListUnifiedInventory(finishedGoods: true, includeFinishedGoods: true)
                .Select(x => new LocationMapStock(
                    x.LocationNo, x.PartNo, x.PartName, x.LotNo, x.Qty, x.Unit,
                    x.WarehouseCode, x.WarehouseName, x.AreaCode, x.AreaName, InspectionQty:x.InspectionQty,
                    ReceivedAt:x.ReceivedAt, VendorCode:x.VendorCode))
                .ToList();
            _inventory = InventorySearchRows.FromMaster(MD.ListItems().Where(x => InventorySearchRows.IsSemiFinished(x.ItemType)), stock);
            _itemVendors = SCM.ListItemVendors();
            _itemCodes = MD.ListCodeItems("ITEM_TYPE").Concat(MD.ListCodeItems("ITEM_CATEGORY")).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
