@page "/fg/inventory"
@inject IStringLocalizer<SharedResources> L
@inject AMES.Data.Repositories.WarehouseRepository InventoryRepo
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["WH.Inventory.Title"] · AMES</PageTitle>
<AmesPageHeader Code="FG-001" TitleKey="WH.Inventory.Title" />

@if (!string.IsNullOrWhiteSpace(_error))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_error</RadzenAlert>
}
else
{
    <InventoryLookup Inventory="_inventory" SearchId="fg-inventory-search" />
}

@code {
    private List<LocationMapStock> _inventory = [];
    private string? _error;

    protected override void OnInitialized()
    {
        try
        {
            _inventory = InventoryRepo.ListUnifiedInventory(finishedGoods: true)
                .Select(x => new LocationMapStock(
                    x.LocationNo, x.PartNo, x.PartName, x.LotNo, x.Qty, x.Unit,
                    x.WarehouseCode, x.WarehouseName, x.AreaCode, x.AreaName))
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
