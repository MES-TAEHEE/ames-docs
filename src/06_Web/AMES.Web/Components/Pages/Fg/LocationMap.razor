@page "/fg/location-map"
@inject IStringLocalizer<SharedResources> L
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Data.Repositories.WarehouseRepository Warehouse
@inject AuthenticationStateProvider AuthPrvd
@inject AMES.Web.Services.PermissionService PermSvc
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["WH.LocMap.Title"] · AMES</PageTitle>
<AmesPageHeader Code="FG-05" TitleKey="WH.LocMap.Title" />

@if (_loading)
{
    <div class="ames-card"><LocationMapLoading /></div>
}
else if (_error is not null) { <RadzenAlert AlertStyle="Radzen.AlertStyle.Danger">@_error</RadzenAlert> }
else { <LocationMapExplorer Locations="_locations" Inventory="_inventory" Areas="_areas" OnRefresh="Reload" CanEdit="_canEdit" CanAddHierarchy="false" SearchId="fg-location-search" /> }

@code {
    private List<LocationMapCell> _locations = [];
    private List<LocationMapStock> _inventory = [];
    private List<LocationMapArea> _areas = [];
    private string? _error;
    private bool _canEdit;
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await PermSvc.EnsureAsync(AuthPrvd);
            _canEdit = PermSvc.CanEdit("md/fd/location");
            await Reload();
        }
        catch (Exception ex) { _error = $"Unable to load Location Map: {ex.Message}"; }
        finally { _loading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task Reload()
    {
        try
        {
            (_areas, _locations, _inventory) = await Task.Run(() => LocationMapDatabase.Load(MD, Warehouse, finishedGoods: true));
            _error = null;
        }
        catch (Exception ex) { _error = $"Unable to load Location Map: {ex.Message}"; }
    }
}
