@page "/fg/location-map"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Location Map - AMES</PageTitle>
<AmesPageHeader Code="FG-02" Title="Location Map" />

<LocationMapExplorer Locations="_locations" Inventory="_inventory" OnRefresh="Reload" SearchId="fg-location-search" />

@code {
    private List<LocationMapCell> _locations = [];
    private List<LocationMapStock> _inventory = [];

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        (_locations, _inventory) = LocationMapDemoData.Create("STOCK", "Stock Area");
    }
}
