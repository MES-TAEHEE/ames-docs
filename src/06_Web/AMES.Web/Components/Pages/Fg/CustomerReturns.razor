@page "/fg/customer-returns"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.FinishedGoodsRepository Fg
@using Radzen

<PageTitle>FG-103 Customer Returns - AMES</PageTitle>
<AmesPageHeader Code="FG-03" Title="Customer Returns" />

<div class="ames-kpis compact">
    <div class="ames-kpi"><div class="ames-kpi-l">Returns</div><div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">current result</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">Open</div><div class="ames-kpi-v">@CountStatus("OPEN")</div><div class="ames-kpi-s">awaiting review</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">Inspecting</div><div class="ames-kpi-v">@CountStatus("INSPECTING")</div><div class="ames-kpi-s">under inspection</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">Closed</div><div class="ames-kpi-v">@CountStatus("CLOSED")</div><div class="ames-kpi-s">completed returns</div></div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_message</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h fg-web-toolbar">
        <div><span>CUSTOMER RETURN HISTORY</span><div class="dim">Returned finished goods with original shipment, reason, and receiving history.</div></div>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Placeholder="Search return, RMA, item, or customer" InputSize="InputSize.Small" class="ames-rz-input" Style="width:245px;" AutoComplete="false" @onkeydown='e => { if (e.Key == "Enter") Reload(); }' />
            <RadzenDropDown @bind-Value="_status" Data="@StatusOptions" AllowClear="true" Placeholder="Status" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenDatePicker @bind-Value="_from" DateFormat="yyyy-MM-dd" Placeholder="From" InputSize="InputSize.Small" class="ames-rz-input" Style="width:145px;" />
            <RadzenDatePicker @bind-Value="_to" DateFormat="yyyy-MM-dd" Placeholder="To" InputSize="InputSize.Small" class="ames-rz-input" Style="width:145px;" />
            <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="Reload" class="ames-rz-btn" />
            <RadzenButton Text="Clear" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ClearFilters" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow"
                    Data="@_rows" AllowPaging="true" PageSize="20" PageSizeOptions="@(new[] { 20, 50, 100 })"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true" AllowSorting="true"
                    RowSelect="OpenDetail" SelectionMode="DataGridSelectionMode.Single"
                    EmptyText="No customer return history found." Class="ames-rz-grid fg-return-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="ReceivedAt" Title="Received" Width="145px"><Template Context="r">@(r.ReceivedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="ReturnNumber" Title="Return No" Width="150px"><Template Context="r"><span class="code">@r.ReturnNumber</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="CustomerCode" Title="Customer" Width="115px" />
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="ShipmentOrderNumber" Title="Original Shipment" Width="165px"><Template Context="r">@(r.ShipmentOrderNumber ?? "-")</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="ItemNo" Title="Item No" Width="140px"><Template Context="r"><span class="code">@(r.ItemNo ?? "-")</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="Qty" Title="Qty" Width="90px" TextAlign="TextAlign.Right"><Template Context="r">@r.Qty.ToString("N0")</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="ReturnReason" Title="Reason" Width="160px"><Template Context="r">@(r.ReturnReason ?? "-")</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="Status" Title="Status" Width="115px" TextAlign="TextAlign.Center"><Template Context="r"><span class="pill @StatusClass(r.Status)">@(r.Status ?? "OPEN")</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Property="ReceivedBy" Title="Received By" Width="135px" />
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow" Title="Detail" Width="80px" Sortable="false" TextAlign="TextAlign.Center"><Template Context="r"><RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenDetail(r))" title="View details" class="ames-rz-btn" /></Template></RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_detail is not null)
{
    <div class="ames-modal-bg" @onclick="CloseDetail">
        <div class="ames-modal fg-return-modal" @onclick:stopPropagation>
            <div class="ames-modal-h">Return Detail - @_detail.ReturnNumber</div>
            <div class="fg-return-detail-grid">
                <div><span>RMA No</span><strong>@(_detail.RmaNo ?? "-")</strong></div>
                <div><span>Status</span><strong><span class="pill @StatusClass(_detail.Status)">@(_detail.Status ?? "OPEN")</span></strong></div>
                <div><span>Customer</span><strong>@(_detail.CustomerCode ?? "-")</strong></div>
                <div><span>Received</span><strong>@(_detail.ReceivedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</strong></div>
                <div><span>Original Shipment</span><strong>@(_detail.ShipmentOrderNumber ?? "-")</strong></div>
                <div><span>Customer PO</span><strong>@(_detail.CustomerPo ?? "-")</strong></div>
                <div><span>Item No</span><strong>@(_detail.ItemNo ?? "-")</strong></div>
                <div><span>Quantity</span><strong>@_detail.Qty.ToString("N0")</strong></div>
                <div><span>Return Reason</span><strong>@(_detail.ReturnReason ?? "-")</strong></div>
                <div><span>Received By</span><strong>@(_detail.ReceivedBy ?? "-")</strong></div>
                <div><span>CAPA Triggered</span><strong>@(_detail.CapaTriggered ? "Yes" : "No")</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_detail.ItemsJson))
            {
                <div class="fg-return-json"><span>RETURNED ITEMS</span><pre>@_detail.ItemsJson</pre></div>
            }
            <div class="ames-modal-footer"><span style="flex:1;"></span><RadzenButton Text="Close" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="CloseDetail" class="ames-rz-btn" /></div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow> _rows = new();
    AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow? _detail;
    string _search = "", _message = "";
    string? _status;
    DateTime? _from = DateTime.Today.AddMonths(-1), _to = DateTime.Today;
    string[] StatusOptions = ["Open", "Inspecting", "Closed", "Rejected", "Received"];

    protected override void OnInitialized() => Reload();
    void Reload()
    {
        if (_from.HasValue && _to.HasValue && _from.Value.Date > _to.Value.Date) { _message = "From date cannot be later than To date."; return; }
        try { _rows = Fg.ListReturns(_search, _status, _from, _to); _message = ""; }
        catch (Exception ex) { _rows = new(); _message = ex.Message; }
    }
    void ClearFilters() { _search = ""; _status = null; _from = DateTime.Today.AddMonths(-1); _to = DateTime.Today; Reload(); }
    int CountStatus(string status) => _rows.Count(x => string.Equals(x.Status, status, StringComparison.OrdinalIgnoreCase));
    void OpenDetail(AMES.Data.Repositories.FinishedGoodsRepository.ReturnRow row) => _detail = row;
    void CloseDetail() => _detail = null;
    static string StatusClass(string? status) => status?.ToUpperInvariant() switch { "CLOSED" or "RECEIVED" => "ok", "OPEN" or "INSPECTING" => "warn", "REJECTED" => "bad", _ => "mute" };
}
