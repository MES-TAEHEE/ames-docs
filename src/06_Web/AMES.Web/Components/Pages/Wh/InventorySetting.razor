@page "/wh/inventory-setting"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@inject AuthenticationStateProvider AuthPrvd
@using AMES.Data.Repositories
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Radzen

<PageTitle>WH-005 Inventory Setting - AMES</PageTitle>
<AmesPageHeader Code="WH-005" Title="Inventory Setting" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">Items</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
        <div class="ames-kpi-s">active materials</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">Below Min</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "BELOW_MIN")</div>
        <div class="ames-kpi-s">under minimum quantity</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">Over Max</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "OVER_MAX")</div>
        <div class="ames-kpi-s">above maximum quantity</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">Normal</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "NORMAL")</div>
        <div class="ames-kpi-s">within min/max range</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">Inventory Setting - @_rows.Count items@(_rows.Count < _allRows.Count ? $" / {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Placeholder="Part No, name, category, car"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:240px;" AutoComplete="false"
                           @onkeydown="HandleSearchKeyDown" />
            <RadzenDropDown @bind-Value="_statusFilter" Data="@_statusOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="All Status"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:170px;" />
            <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="Clear" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ClearFilters" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="WarehouseRepository.InventorySettingRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="15"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    EmptyText="No inventory settings found."
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="Status" Title="Status" Width="145px">
                <Template Context="r">
                    <span class="wh-setting-status" style="@StatusStyle(r.StatusColor)">
                        @StatusText(r.Status)
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="ItemNo" Title="Part No" Width="145px">
                <Template Context="r"><span class="code">@r.ItemNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="ItemName" Title="Material">
                <Template Context="r">@(r.ItemName ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="CurrentQty" Title="On Hand" Width="115px" TextAlign="TextAlign.Right">
                <Template Context="r">@QtyText(r.CurrentQty, r.DefaultUom)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="MinQty" Title="Min" Width="105px" TextAlign="TextAlign.Right">
                <Template Context="r">@QtyText(r.MinQty, r.DefaultUom)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="MaxQty" Title="Max" Width="105px" TextAlign="TextAlign.Right">
                <Template Context="r">@QtyText(r.MaxQty, r.DefaultUom)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="ShortageQty" Title="Shortage" Width="120px" TextAlign="TextAlign.Right">
                <Template Context="r">
                    <span class="@(r.ShortageQty > 0 ? "wh-shortage-text" : "dim")">@QtyText(r.ShortageQty, r.DefaultUom)</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="LocationCount" Title="Loc" Width="70px" TextAlign="TextAlign.Right" />
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Property="LotCount" Title="Lots" Width="75px" TextAlign="TextAlign.Right" />
            <RadzenDataGridColumn TItem="WarehouseRepository.InventorySettingRow" Title="Setting" Width="82px" Sortable="false" TextAlign="TextAlign.Center">
                <Template Context="r">
                    <div class="wh-setting-cell">
                        <RadzenButton Icon="settings" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(() => OpenEdit(r))" class="ames-rz-btn wh-setting-btn" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modalOpen && _selected is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal wh-setting-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h wh-setting-modal-title">
                <span>Inventory Setting</span>
                <strong>@_selected.ItemNo</strong>
            </div>

            <div class="wh-form-grid wh-setting-form">
                <div>
                    <RadzenLabel Text="Min Qty" />
                    <RadzenNumeric TValue="decimal" @bind-Value="_form.MinQty" Min="0" Step="1"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Max Qty" />
                    <RadzenNumeric TValue="decimal" @bind-Value="_form.MaxQty" Min="0" Step="1"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? "Saving" : "Save")" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<WarehouseRepository.InventorySettingRow> _allRows = new();
    List<WarehouseRepository.InventorySettingRow> _rows = new();
    WarehouseRepository.InventorySettingRow? _selected;

    readonly IEnumerable<int> _pageSizeOptions = new[] { 15, 30, 50, 100 };
    readonly List<DropDownItem> _statusOptions = new()
    {
        new() { Text = "Below Min", Value = "BELOW_MIN" },
        new() { Text = "Over Max", Value = "OVER_MAX" },
        new() { Text = "Normal", Value = "NORMAL" },
    };

    string _search = "";
    string? _statusFilter;
    string _msg = "";
    string _modalErr = "";
    string _actor = "web";
    bool _isErr;
    bool _busy;
    bool _modalOpen;
    bool _bgMouseDownOnSelf;
    FormModel _form = new();

    public class DropDownItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "web";
        Reload();
    }

    void Reload()
    {
        try
        {
            _allRows = Wh.ListInventorySettings(_search, null);
            _rows = string.IsNullOrWhiteSpace(_statusFilter)
                ? _allRows
                : Wh.ListInventorySettings(_search, _statusFilter);
            _msg = "";
        }
        catch (Exception ex)
        {
            _allRows = new();
            _rows = new();
            ShowMsg(ex.Message, true);
        }
    }

    void ClearFilters()
    {
        _search = "";
        _statusFilter = null;
        Reload();
    }

    void OpenEdit(WarehouseRepository.InventorySettingRow row)
    {
        _selected = row;
        _form = new()
        {
            MinQty = row.MinQty,
            MaxQty = row.MaxQty,
        };
        _modalErr = "";
        _modalOpen = true;
    }

    void SaveEdit()
    {
        if (_selected is null) return;

        _modalErr = "";
        if (_form.MaxQty > 0 && _form.MinQty > _form.MaxQty)
        {
            _modalErr = "Min Qty cannot be greater than Max Qty.";
            return;
        }

        _busy = true;
        try
        {
            Wh.SaveInventorySetting(_selected.ItemNo, _form.MinQty, _form.MaxQty, _actor);
            CloseModal();
            Reload();
            ShowMsg("Inventory setting saved.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void CloseModal()
    {
        _modalOpen = false;
        _modalErr = "";
        _selected = null;
    }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick()
    {
        if (_bgMouseDownOnSelf) CloseModal();
        _bgMouseDownOnSelf = false;
    }

    void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Reload();
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg;
        _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            _msg = "";
            InvokeAsync(StateHasChanged);
        });
    }

    static string QtyText(decimal qty, string? unit) =>
        $"{qty:N0}{(string.IsNullOrWhiteSpace(unit) ? "" : $" {unit}")}";

    static string StatusText(string status) => status switch
    {
        "BELOW_MIN" => "Below Min",
        "OVER_MAX" => "Over Max",
        _ => "Normal",
    };

    static string StatusStyle(string color) =>
        $"background:{color};border-color:{color};color:#fff;";

    class FormModel
    {
        public decimal MinQty { get; set; }
        public decimal MaxQty { get; set; }
    }
}
