@page "/wh/log-history"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@using Radzen

<PageTitle>WH-004 Inventory History · AMES</PageTitle>
<AmesPageHeader Code="WH-004" Title="Inventory History" />

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">Events</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">Inbound</div><div class="ames-kpi-v">@CountEvent("INBOUND")</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">Outbound</div><div class="ames-kpi-v">@CountEvent("OUTBOUND")</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">Adjustments</div><div class="ames-kpi-v">@CountEvent("ADJUSTMENT")</div></div>
</div>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h master-list-toolbar">
        <span>▼ Inventory Activity · @_rows.Count item(s)</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Placeholder="Search"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:210px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") Reload(); }' />
            <RadzenDropDown @bind-Value="_operationType" Data="@_operationOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="Activity Type"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
            <RadzenDatePicker @bind-Value="_from" DateFormat="yyyy-MM-dd" Placeholder="From"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenDatePicker @bind-Value="_to" DateFormat="yyyy-MM-dd" Placeholder="To"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="Clear" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ClearFilters" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="25"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    EmptyText="No inventory activity found."
                    PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")"
                    Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EventTime" Title="Time" Width="170px">
                <Template Context="r">@(r.EventTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EventType" Title="Type" Width="155px">
                <Template Context="r"><span class="pill @EventClass(r)">@DisplayEvent(r)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="LotNo" Title="LOT / Part" Width="245px">
                <Template Context="r">
                    <div class="code">@(r.LotNo ?? "-")</div>
                    <div class="dim">@(r.PartNo ?? "-")</div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="Message" Title="Details">
                <Template Context="r">
                    <div>@(r.Message ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(RefText(r)))
                    {
                        <div class="dim">@RefText(r)</div>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EmployeeNo" Title="Worker" Width="145px">
                <Template Context="r">
                    <div class="code">@(r.EmployeeNo ?? r.WorkerId ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(r.EmployeeName))
                    {
                        <div class="dim">@r.EmployeeName</div>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    List<AMES.Data.Repositories.WarehouseRepository.OperationLogRow> _rows = new();
    readonly IEnumerable<int> _pageSizeOptions = new[] { 25, 50, 100 };
    int _pageRows = 25;
    readonly List<DropDownItem> _operationOptions = new()
    {
        new() { Text = "Inbound", Value = "INBOUND" },
        new() { Text = "Outbound", Value = "OUTBOUND" },
        new() { Text = "Relocation", Value = "RELOCATION" },
        new() { Text = "Status Change", Value = "STATUS" },
        new() { Text = "Inventory Adjustment", Value = "ADJUSTMENT" },
    };

    string _search = "";
    string? _operationType;
    DateTime? _from = DbClock.Today.AddDays(-90);
    DateTime? _to = DbClock.Today;
    string _msg = "";

    public class DropDownItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try
        {
            _rows = Wh.ListOperationLogs(_search, _operationType, _from?.Date, _to?.Date);
            _msg = "";
        }
        catch (Exception ex)
        {
            _rows = new();
            _msg = ex.Message;
        }
    }

    void ClearFilters()
    {
        _search = "";
        _operationType = null;
        _from = DbClock.Today.AddDays(-90);
        _to = DbClock.Today;
        Reload();
    }

    int CountEvent(string type) => _rows.Count(row => type switch
    {
        "INBOUND" => DisplayEvent(row) is "Inbound" or "Received" or "Stored" or "Return Received",
        "OUTBOUND" => DisplayEvent(row) is "Outbound" or "Released",
        "ADJUSTMENT" => DisplayEvent(row) == "Inventory Adjustment",
        _ => false,
    });

    static string EventClass(AMES.Data.Repositories.WarehouseRepository.OperationLogRow row)
    {
        var upper = row.EventType.ToUpperInvariant();
        if (upper == "STATUS_CHANGE")
        {
            var status = ChangedStatus(row.Message);
            if (status is "STORED" or "RECEIVED" or "RETURN_RECEIVED" or "RELEASE_CANCELLED") return "ok";
            if (status is "DEFECTIVE" or "DISPOSED" or "RECEIPT_CANCELLED") return "bad";
            if (status == "RELEASED") return "warn";
        }
        if (upper.Contains("RECEIVE")) return "ok";
        if (upper.Contains("RELEASE")) return "warn";
        if (upper.Contains("ADJUST")) return "bad";
        if (upper.Contains("LOCATION")) return "ok";
        return "ghost";
    }

    static string DisplayEvent(AMES.Data.Repositories.WarehouseRepository.OperationLogRow row)
    {
        if (row.EventType.Equals("STATUS_CHANGE", StringComparison.OrdinalIgnoreCase))
            return StatusLabel(ChangedStatus(row.Message));

        return row.EventType.ToUpperInvariant() switch
        {
            "RECEIVE" => "Inbound",
            "CANCEL_RECEIPT" => "Cancel Inbound",
            "RELEASE_PICK" => "Outbound",
            "ADJUST_SAVE" => "Inventory Adjustment",
            "MOVE_LOCATION" => "Relocation",
            _ => row.EventType,
        };
    }

    static string ChangedStatus(string? message)
    {
        if (string.IsNullOrWhiteSpace(message)) return "";
        var separator = message.LastIndexOf("->", StringComparison.Ordinal);
        return (separator >= 0 ? message[(separator + 2)..] : message).Trim().ToUpperInvariant();
    }

    static string StatusLabel(string status) => status switch
    {
        "CREATED" => "Created",
        "RECEIVED" => "Received",
        "STORED" => "Stored",
        "RELEASED" => "Released",
        "RECEIPT_CANCELLED" => "Inbound Cancelled",
        "RELEASE_CANCELLED" => "Release Cancelled",
        "RETURN_RECEIVED" => "Return Received",
        "DEFECTIVE" => "Defective",
        "DISPOSED" => "Disposed",
        _ => string.IsNullOrWhiteSpace(status) ? "Status Changed" : status.Replace('_', ' '),
    };

    static string RefText(AMES.Data.Repositories.WarehouseRepository.OperationLogRow row)
    {
        if (string.IsNullOrWhiteSpace(row.RefDocType) && string.IsNullOrWhiteSpace(row.RefDocNo))
            return "";

        return $"{row.RefDocType ?? "-"} {row.RefDocNo ?? "-"}";
    }
}
