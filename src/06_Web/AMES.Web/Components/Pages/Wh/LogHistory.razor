@page "/wh/log-history"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@using Radzen

<PageTitle>WH-004 Log History · AMES</PageTitle>
<AmesPageHeader Code="WH-004" Title="Log History" />

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ Warehouse Log History</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Placeholder="Worker, Scan, Lot, Part, Location"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:260px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") Reload(); }' />
            <RadzenDropDown @bind-Value="_operationType" Data="@_operationOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="Operation Type"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:165px;" />
            <RadzenDatePicker @bind-Value="_from" DateFormat="yyyy-MM-dd" Placeholder="From"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:135px;" />
            <RadzenDatePicker @bind-Value="_to" DateFormat="yyyy-MM-dd" Placeholder="To"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:135px;" />
            <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="Clear" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ClearFilters" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="20"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    EmptyText="No logs found."
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EventTime" Title="Time" Width="170px">
                <Template Context="r">@(r.EventTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EventType" Title="Event" Width="145px">
                <Template Context="r"><span class="pill @EventClass(r.EventType)">@DisplayEvent(r.EventType)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="Result" Title="Result" Width="95px" TextAlign="TextAlign.Center">
                <Template Context="r"><span class="pill @ResultClass(r.Result)">@r.Result</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EmployeeNo" Title="Worker" Width="130px">
                <Template Context="r">
                    <div class="code">@(r.EmployeeNo ?? r.WorkerId ?? "-")</div>
                    <div class="dim">@(r.EmployeeName ?? "-")</div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="TerminalId" Title="Terminal" Width="115px">
                <Template Context="r"><span class="dim">@(r.TerminalId ?? "-")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="ScreenCode" Title="Screen" Width="95px">
                <Template Context="r"><span class="pill ghost">@(r.ScreenCode ?? "-")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="ScanValue" Title="Scan" Width="175px">
                <Template Context="r">
                    <div class="code">@(r.ScanValue ?? "-")</div>
                    <div class="dim">@(r.ScanType ?? "-")</div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="LotNo" Title="Lot / Part / Location">
                <Template Context="r">
                    <div class="code">@(r.LotNo ?? "-")</div>
                    <div class="dim">@($"{r.PartNo ?? "-"} · {r.LocationId ?? "-"}")</div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="Qty" Title="Qty" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.Qty?.ToString("N3") ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="Message" Title="Message">
                <Template Context="r">
                    <div>@(r.Message ?? "-")</div>
                    <div class="dim">@(RefText(r))</div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="ClientIp" Title="IP" Width="120px">
                <Template Context="r"><span class="dim">@(r.ClientIp ?? "-")</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    List<AMES.Data.Repositories.WarehouseRepository.OperationLogRow> _rows = new();
    readonly IEnumerable<int> _pageSizeOptions = new[] { 20, 50, 100, 200 };
    readonly List<DropDownItem> _operationOptions = new()
    {
        new() { Text = "Scan", Value = "SCAN" },
        new() { Text = "Inbound", Value = "INBOUND" },
        new() { Text = "Release", Value = "RELEASE" },
        new() { Text = "Adjust", Value = "ADJUST" },
        new() { Text = "Location", Value = "LOCATION" },
    };

    string _search = "";
    string? _operationType;
    DateTime? _from = DateTime.Today.AddDays(-7);
    DateTime? _to = DateTime.Today;
    string _msg = "";

    public class DropDownItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try
        {
            _rows = Wh.ListOperationLogs(_search, _operationType, _from?.Date, _to?.Date);
            _msg = "";
        }
        catch (Exception ex)
        {
            _rows = new();
            _msg = ex.Message;
        }
    }

    void ClearFilters()
    {
        _search = "";
        _operationType = null;
        _from = DateTime.Today.AddDays(-7);
        _to = DateTime.Today;
        Reload();
    }

    static string EventClass(string type)
    {
        var upper = type.ToUpperInvariant();
        if (upper.Contains("SCAN")) return "warn";
        if (upper.Contains("RECEIVE")) return "ok";
        if (upper.Contains("PICK")) return "warn";
        if (upper.Contains("ADJUST")) return "bad";
        if (upper.Contains("LOCATION")) return "ok";
        return "ghost";
    }

    static string DisplayEvent(string type) => type.ToUpperInvariant() switch
    {
        "SCAN_LOT" => "Scan Lot",
        "SCAN_LOCATION" => "Scan Location",
        "SCAN_STOCK" => "Scan Stock",
        "SCAN_PICK_SLIP" => "Scan Pick Slip",
        "SCAN_RELEASE_LOT" => "Scan Release Lot",
        "RECEIVE" => "Inbound",
        "CANCEL_RECEIPT" => "Cancel Inbound",
        "RELEASE_PICK" => "Release",
        "ADJUST_SAVE" => "Adjust",
        "MOVE_LOCATION" => "Location",
        "LOCATION_MASTER_CREATE" => "Location Master Create",
        "LOCATION_MASTER_UPDATE" => "Location Master Update",
        "LOCATION_MASTER_DELETE" => "Location Master Delete",
        _ => type,
    };

    static string ResultClass(string result) => result.ToUpperInvariant() switch
    {
        "SUCCESS" => "ok",
        "FAIL" => "bad",
        _ => "ghost",
    };

    static string RefText(AMES.Data.Repositories.WarehouseRepository.OperationLogRow row)
    {
        if (string.IsNullOrWhiteSpace(row.RefDocType) && string.IsNullOrWhiteSpace(row.RefDocNo))
            return "-";

        return $"{row.RefDocType ?? "-"} {row.RefDocNo ?? "-"}";
    }
}
