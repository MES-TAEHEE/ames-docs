@page "/wh/log-history"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>WH-004 @L["WH.LogHistory.Title"] · AMES</PageTitle>
<AmesPageHeader Code="WH-004" TitleKey="WH.LogHistory.Title" />

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["WH.LogHistory.Kpi.Events"]</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["WH.LogHistory.Kpi.Inbound"]</div><div class="ames-kpi-v">@CountEvent("INBOUND")</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["WH.LogHistory.Kpi.Outbound"]</div><div class="ames-kpi-v">@CountEvent("OUTBOUND")</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["WH.LogHistory.Kpi.Adjustments"]</div><div class="ames-kpi-v">@CountEvent("ADJUSTMENT")</div></div>
</div>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h master-list-toolbar">
        <span>▼ @L["WH.LogHistory.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Placeholder="@L["WH.LogHistory.Ph.Search"].Value"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:250px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") Reload(); }' />
            <RadzenDropDown @bind-Value="_operationType" Data="@OperationOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["WH.LogHistory.Ph.ActivityType"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:170px;" />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_from" DateFormat="@DateFmt.Date" Placeholder="@L["Col.From"].Value"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_to" DateFormat="@DateFmt.Date" Placeholder="@L["Col.To"].Value"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="@L["Btn.Reset"].Value" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ClearFilters" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="25"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]"
                    AllowSorting="true"
                    EmptyText="@L["WH.LogHistory.Empty"].Value"
                    PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")"
                    Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EventTime" Title="@L["Col.Time"].Value" Width="170px" MinWidth="170px">
                <Template Context="r">@(r.EventTime?.ToString(DateFmt.DateTimeSec) ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EventType" Title="@L["Col.Type"].Value" Width="155px" MinWidth="155px">
                <Template Context="r"><span class="pill @EventClass(r)">@L[DisplayEvent(r)]</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="LotNo" Title="@L["WH.LogHistory.Col.LotPart"].Value" Width="245px" MinWidth="245px">
                <Template Context="r">
                    <div class="code">@(r.LotNo ?? "-")</div>
                    <div class="dim">@(r.PartNo ?? "-")</div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="Message" Title="@L["Col.Details"].Value">
                <Template Context="r">
                    <div>@(r.Message ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(RefText(r)))
                    {
                        <div class="dim">@RefText(r)</div>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.OperationLogRow" Property="EmployeeNo" Title="@L["Col.Worker"].Value" Width="145px" MinWidth="145px">
                <Template Context="r">
                    <div class="code">@(r.EmployeeNo ?? r.WorkerId ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(r.EmployeeName))
                    {
                        <div class="dim">@r.EmployeeName</div>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    List<AMES.Data.Repositories.WarehouseRepository.OperationLogRow> _rows = new();
    readonly IEnumerable<int> _pageSizeOptions = new[] { 25, 50, 100 };
    int _pageRows = 25;
    List<DropDownItem> OperationOptions =>
    [
        new() { Text = L["WH.LogHistory.Lbl.Inbound"].Value, Value = "INBOUND" },
        new() { Text = L["WH.LogHistory.Lbl.Outbound"].Value, Value = "OUTBOUND" },
        new() { Text = L["WH.LogHistory.Lbl.Relocation"].Value, Value = "RELOCATION" },
        new() { Text = L["WH.LogHistory.Lbl.StatusChange"].Value, Value = "STATUS" },
        new() { Text = L["WH.LogHistory.Lbl.Adjustment"].Value, Value = "ADJUSTMENT" },
    ];

    string _search = "";
    string? _operationType;
    DateTime? _from = DbClock.Today.AddMonths(-1);
    DateTime? _to = DbClock.Today.AddMonths(1);
    string _msg = "";

    public class DropDownItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try
        {
            _rows = Wh.ListOperationLogs(_search, _operationType, _from?.Date, _to?.Date);
            _msg = "";
        }
        catch (Exception ex)
        {
            _rows = new();
            _msg = ex.Message;
        }
    }

    void ClearFilters()
    {
        _search = "";
        _operationType = null;
        _from = DbClock.Today.AddMonths(-1);
        _to = DbClock.Today.AddMonths(1);
        Reload();
    }

    int CountEvent(string type) => CountEvents(_rows, type);

    static string RefText(AMES.Data.Repositories.WarehouseRepository.OperationLogRow row)
    {
        if (string.IsNullOrWhiteSpace(row.SourceType) && row.SourceId is null)
            return "";

        return $"{row.SourceType ?? "-"} {row.SourceId?.ToString() ?? "-"}";
    }
}
