@page "/wh/location-map"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@inject IJSRuntime JS
@using System.Globalization
@using AMES.Data.Repositories
@using Microsoft.JSInterop
@using Radzen
@implements IAsyncDisposable

<PageTitle>WH-003 Location Map - AMES</PageTitle>
<AmesPageHeader Code="WH-003" Title="Location Map" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">Step</div>
        <div class="ames-kpi-v">@StepNo</div>
        <div class="ames-kpi-s">@StepTitle</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">Warehouses</div>
        <div class="ames-kpi-v">@_warehouses.Count(w => w.UseYn)</div>
        <div class="ames-kpi-s">WH master</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">Placed</div>
        <div class="ames-kpi-v">@PlacedCount</div>
        <div class="ames-kpi-s">@PlacedLabel</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">Level</div>
        <div class="ames-kpi-v">@DisplayLevel(_levelCode)</div>
        <div class="ames-kpi-s">grid floor</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="@_msgStyle" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h wh-map-toolbar">
        <div>
            <span>@StepTitle</span>
            <div class="dim">@StepDescription</div>
        </div>

        @if (_stage == MapStage.Warehouse)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Add WH" Icon="warehouse" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                              Click="@OpenWarehousePicker" Disabled="@(!CanAddWarehouse)" class="ames-rz-btn" />
                <RadzenButton Text="@(_editMode ? "Done" : "Edit")" Icon="@(_editMode ? "done" : "edit")"
                              ButtonStyle="@(_editMode ? ButtonStyle.Success : ButtonStyle.Warning)" Size="ButtonSize.Small"
                              Click="@ToggleEdit" class="ames-rz-btn" />
                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ReloadAll" class="ames-rz-btn" />
            </RadzenStack>
        }
        else if (_stage == MapStage.Area)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Back" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@BackToWarehouses" class="ames-rz-btn" />
                <RadzenButton Text="Add Area" Icon="add_location_alt" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                              Click="@OpenAreaPicker" Disabled="@(!CanAddArea)" class="ames-rz-btn" />
                <RadzenButton Text="@(_editMode ? "Done" : "Edit")" Icon="@(_editMode ? "done" : "edit")"
                              ButtonStyle="@(_editMode ? ButtonStyle.Success : ButtonStyle.Warning)" Size="ButtonSize.Small"
                              Click="@ToggleEdit" class="ames-rz-btn" />
            </RadzenStack>
        }
        else if (_stage == MapStage.Zone)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Back" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@BackToArea" class="ames-rz-btn" />
                <RadzenButton Text="Add Zone" Icon="add_location_alt" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                              Click="@OpenZonePicker" Disabled="@(!CanAddZone)" class="ames-rz-btn" />
                <RadzenButton Text="@(_editMode ? "Done" : "Edit")" Icon="@(_editMode ? "done" : "edit")"
                              ButtonStyle="@(_editMode ? ButtonStyle.Success : ButtonStyle.Warning)" Size="ButtonSize.Small"
                              Click="@ToggleEdit" class="ames-rz-btn" />
            </RadzenStack>
        }
        else
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Back" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@BackToZone" class="ames-rz-btn" />
                <RadzenDropDown @bind-Value="_levelCode"
                                Data="@LevelOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                Placeholder="Level"
                                Change="@(_ => LoadZoneState())"
                                InputSize="InputSize.Small"
                                class="ames-rz-input"
                                Style="width:160px;" />
                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@LoadZoneState" class="ames-rz-btn" />
            </RadzenStack>
        }
    </div>

    <div class="wh-map-breadcrumb">
        <button type="button" class="@BreadcrumbClass(MapStage.Warehouse)" @onclick="@BackToWarehouses">WH</button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(MapStage.Area)" disabled="@string.IsNullOrWhiteSpace(_selectedWhCode)" @onclick="@BackToArea">
            @(_selectedWhCode ?? "Area")
        </button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(MapStage.Zone)" disabled="@string.IsNullOrWhiteSpace(_selectedAreaCode)" @onclick="@BackToZone">
            @(_selectedAreaCode ?? "Zone")
        </button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(MapStage.Grid)" disabled="@(_stage != MapStage.Grid)">
            @(_selectedZoneCode ?? "Location")
        </button>
    </div>

        <div class="wh-map-legend">
            <span><i class="empty"></i> Empty</span>
            <span><i class="stocked"></i> Stocked</span>
            <span><i class="mixed"></i> Mixed</span>
            <span><i class="selected"></i> Selected</span>
        </div>

        <div id="wh-location-map-plan"
             class="@MapPlanClass"
             style="@MapCanvasStyle()"
             aria-label="@StepTitle">
            @if (_stage != MapStage.Grid)
            {
                <div class="wh-factory-label wh-factory-label-receiving">Receiving</div>
                <div class="wh-factory-label wh-factory-label-production">@(_stage == MapStage.Warehouse ? "Production" : SelectedStageLabel)</div>
                <div class="wh-factory-label wh-factory-label-shipping">Shipping</div>
            }

            @if (_stage == MapStage.Warehouse)
            {
                var warehouseViews = WarehouseViews().ToList();
                if (warehouseViews.Count == 0)
                {
                    <div class="wh-map-empty-state">
                        <strong>No Warehouses Placed</strong>
                        <span>Select a Warehouse Master item and press Add WH.</span>
                    </div>
                }
                else
                {
                    @foreach (var view in warehouseViews)
                    {
                        <div @key="view.Warehouse.WhCode"
                             role="button"
                             tabindex="0"
                             class="wh-area-block wh-factory-area-card @(IsSelectedWarehouse(view.Warehouse.WhCode) ? "selected" : "")"
                             data-area-code="@view.Warehouse.WhCode"
                             style="@PlacementStyle(view.Layout)"
                             @onclick="() => SelectWarehouse(view.Warehouse.WhCode)">
                            @if (_editMode)
                            {
                                <button type="button"
                                        class="wh-map-delete-btn"
                                        title="Remove warehouse"
                                        @onclick="() => RemoveWarehouseFromDraft(view.Warehouse.WhCode)"
                                        @onclick:stopPropagation="true">x</button>
                            }
                            <span class="wh-area-code">@view.Warehouse.WhCode</span>
                            <span class="wh-area-name">@(view.Warehouse.WhName ?? "Warehouse")</span>
                            <span class="wh-area-resize-handle" title="Resize warehouse" @onclick:stopPropagation="true"></span>
                        </div>
                    }
                }
            }
            else if (_stage == MapStage.Area)
            {
                var areaViews = FactoryAreaViews().ToList();
                if (areaViews.Count == 0)
                {
                    <div class="wh-map-empty-state">
                        <strong>No Areas Placed</strong>
                        <span>Select an Area Master item and press Add Area.</span>
                    </div>
                }
                else
                {
                    @foreach (var view in areaViews)
                    {
                        <div @key="view.Area.AreaCode"
                             role="button"
                             tabindex="0"
                             class="wh-area-block wh-factory-area-card @(IsSelectedArea(view.Area.AreaCode) ? "selected" : "")"
                             data-area-code="@view.Area.AreaCode"
                             style="@PlacementStyle(view.Layout)"
                             @onclick="() => SelectFactoryArea(view.Area.AreaCode)">
                            @if (_editMode)
                            {
                                <button type="button"
                                        class="wh-map-delete-btn"
                                        title="Remove area"
                                        @onclick="() => RemoveAreaFromDraft(view.Area.AreaCode)"
                                        @onclick:stopPropagation="true">x</button>
                            }
                            <span class="wh-area-code">@view.Area.AreaCode</span>
                            <span class="wh-area-name">@(view.Area.AreaName ?? "Area")</span>
                            <span class="wh-area-resize-handle" title="Resize area" @onclick:stopPropagation="true"></span>
                        </div>
                    }
                }
            }
            else if (_stage == MapStage.Zone)
            {
                var zoneViews = ZoneViews().ToList();
                if (zoneViews.Count == 0)
                {
                    <div class="wh-map-empty-state">
                        <strong>No Zones Placed</strong>
                        <span>Select a Zone Master item and press Add Zone.</span>
                    </div>
                }
                else
                {
                    @foreach (var view in zoneViews)
                    {
                        <div @key="view.Zone.SectionCode"
                             role="button"
                             tabindex="0"
                             class="wh-area-block wh-factory-area-card @(IsSelectedZone(view.Zone.SectionCode) ? "selected" : "")"
                             data-area-code="@view.Zone.SectionCode"
                             style="@PlacementStyle(view.Layout)"
                             @onclick="() => SelectZone(view.Zone.SectionCode)">
                            @if (_editMode)
                            {
                                <button type="button"
                                        class="wh-map-delete-btn"
                                        title="Remove zone"
                                        @onclick="() => RemoveZonePlacement(view.Zone.SectionCode)"
                                        @onclick:stopPropagation="true">x</button>
                            }
                            <span class="wh-area-code">@view.Zone.SectionCode</span>
                            <span class="wh-area-name">@(view.Zone.SectionName ?? "Zone")</span>
                            <span class="wh-area-resize-handle" title="Resize zone" @onclick:stopPropagation="true"></span>
                        </div>
                    }
                }
            }
            else
            {
                <div class="wh-location-grid-stage">
                    <div class="wh-location-grid-head">
                        <div>
                            <strong>@SelectedZoneLabel</strong>
                            <span>Level @DisplayLevel(_levelCode) - X/Y Location Grid</span>
                        </div>
                        <span>@_rows.Count locations</span>
                    </div>
                    @RenderGrid()
                </div>
            }

            @if (_stage != MapStage.Grid)
            {
                <span class="wh-map-resize-handle" title="Resize map"></span>
            }
        </div>
</div>

@if (_warehousePickerOpen)
{
    <div class="wh-map-picker-backdrop" @onclick="CloseWarehousePicker">
        <div class="wh-map-picker" @onclick:stopPropagation="true">
            <div class="wh-map-picker-head">
                <div>
                    <strong>Select WH</strong>
                    <span>Choose one Warehouse Master item to place on the map.</span>
                </div>
                <button type="button" class="wh-map-picker-close" @onclick="CloseWarehousePicker">x</button>
            </div>

            <div class="wh-map-picker-list">
                @foreach (var wh in AvailableWarehouses)
                {
                    <button type="button" class="wh-map-picker-item" @onclick="() => AddWarehouse(wh.WhCode)">
                        <strong>@wh.WhCode</strong>
                        <span>@(wh.WhName ?? wh.WhCode)</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_areaPickerOpen)
{
    <div class="wh-map-picker-backdrop" @onclick="CloseAreaPicker">
        <div class="wh-map-picker" @onclick:stopPropagation="true">
            <div class="wh-map-picker-head">
                <div>
                    <strong>Select Area</strong>
                    <span>Choose one Area Master item to place on the map.</span>
                </div>
                <button type="button" class="wh-map-picker-close" @onclick="CloseAreaPicker">x</button>
            </div>

            <div class="wh-map-picker-list">
                @foreach (var area in AvailableAreas)
                {
                    <button type="button" class="wh-map-picker-item" @onclick="() => AddArea(area.AreaCode)">
                        <strong>@area.AreaCode</strong>
                        <span>@(area.AreaName ?? area.AreaCode)</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_zonePickerOpen)
{
    <div class="wh-map-picker-backdrop" @onclick="CloseZonePicker">
        <div class="wh-map-picker" @onclick:stopPropagation="true">
            <div class="wh-map-picker-head">
                <div>
                    <strong>Select Zone</strong>
                    <span>Choose one Zone Master item to place inside @SelectedAreaLabel.</span>
                </div>
                <button type="button" class="wh-map-picker-close" @onclick="CloseZonePicker">x</button>
            </div>

            <div class="wh-map-picker-list">
                @foreach (var zone in AvailableZones)
                {
                    <button type="button" class="wh-map-picker-item" @onclick="() => AddZone(zone.SectionCode)">
                        <strong>@zone.SectionCode</strong>
                        <span>@(zone.SectionName ?? zone.SectionCode)</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    enum MapStage { Warehouse, Area, Zone, Grid }

    const decimal DefaultMapWidthPx = 920m;
    const decimal DefaultMapHeightPx = 560m;
    const decimal DefaultAreaWidthPct = 28m;
    const decimal DefaultAreaHeightPct = 22m;
    List<WarehouseRepository.WarehouseMasterRow> _warehouses = new();
    List<WarehouseRepository.WarehouseAreaRow> _areas = new();
    List<WarehouseRepository.WarehouseSectionRow> _zones = new();
    List<WarehouseRepository.LocationMapRow> _allRows = new();
    List<WarehouseRepository.LocationMapRow> _rows = new();
    List<WarehouseRepository.LocationAreaLayoutRow> _warehouseLayouts = new();
    List<WarehouseRepository.LocationAreaLayoutRow> _areaLayouts = new();
    List<WarehouseRepository.LocationAreaLayoutRow> _zoneLayouts = new();
    List<WarehouseRepository.LocationAreaLayoutRow> _editOriginalWarehouseLayouts = new();
    List<WarehouseRepository.LocationAreaLayoutRow> _editOriginalAreaLayouts = new();
    List<WarehouseRepository.LocationAreaLayoutRow> _editOriginalZoneLayouts = new();
    WarehouseRepository.LocationMapRow? _selectedLocation;
    string? _selectedWhCode;
    string? _selectedWarehouseCode;
    string? _selectedAreaCode;
    string? _selectedFactoryAreaCode;
    string? _selectedZoneCode;
    string? _levelCode;
    string _msg = "";
    AlertStyle _msgStyle = AlertStyle.Danger;
    bool _mapJsReady;
    bool _mapJsInitPending = true;
    bool _editMode;
    bool _warehousePickerOpen;
    bool _areaPickerOpen;
    bool _zonePickerOpen;
    MapStage? _editStage;
    decimal _mapWidthPx = DefaultMapWidthPx;
    decimal _mapHeightPx = DefaultMapHeightPx;
    decimal _editOriginalMapWidthPx;
    decimal _editOriginalMapHeightPx;
    MapStage _stage = MapStage.Warehouse;
    DotNetObjectReference<LocationMap>? _mapRef;

    public class DropDownItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    sealed record WarehouseView(
        WarehouseRepository.WarehouseMasterRow Warehouse,
        WarehouseRepository.LocationAreaLayoutRow Layout);

    sealed record FactoryAreaView(
        WarehouseRepository.WarehouseAreaRow Area,
        WarehouseRepository.LocationAreaLayoutRow Layout);

    sealed record ZoneView(
        WarehouseRepository.WarehouseSectionRow Zone,
        WarehouseRepository.LocationAreaLayoutRow Layout);

    int StepNo => _stage switch
    {
        MapStage.Warehouse => 1,
        MapStage.Area => 2,
        MapStage.Zone => 3,
        _ => 4
    };

    string StepTitle => _stage switch
    {
        MapStage.Warehouse => "WH Layout",
        MapStage.Area => $"{SelectedWarehouseLabel} Area Layout",
        MapStage.Zone => $"{SelectedAreaLabel} Zone Layout",
        _ => $"{SelectedZoneLabel} Location Grid"
    };

    string StepDescription => _stage switch
    {
        MapStage.Warehouse => _editMode ? "Edit warehouse positions, then press Done." : "Click a warehouse to manage areas inside it.",
        MapStage.Area => _editMode ? "Edit area positions inside the selected warehouse." : "Click an area to manage zones inside it.",
        MapStage.Zone => _editMode ? "Edit zone positions inside the selected area." : "Click a zone to manage locations inside it.",
        _ => "Select a level to view locations by X/Y coordinates."
    };

    int PlacedCount => _stage switch
    {
        MapStage.Warehouse => _warehouseLayouts.Count,
        MapStage.Area => _areaLayouts.Count,
        MapStage.Zone => _zoneLayouts.Count,
        _ => _rows.Count
    };

    string PlacedLabel => _stage switch
    {
        MapStage.Warehouse => "warehouses on map",
        MapStage.Area => "areas in WH",
        MapStage.Zone => "zones in area",
        _ => "locations on level"
    };

    string MapPlanClass => $"wh-factory-plan wh-location-placement-plan {(_stage == MapStage.Grid ? "wh-location-grid-plan" : "")} {(_editMode && _stage != MapStage.Grid ? "wh-map-editable" : "wh-map-readonly")}";

    WarehouseRepository.WarehouseMasterRow? SelectedWarehouse =>
        _warehouses.FirstOrDefault(w => string.Equals(w.WhCode, _selectedWhCode, StringComparison.OrdinalIgnoreCase));

    string SelectedWarehouseLabel =>
        SelectedWarehouse is { } wh
            ? $"{wh.WhCode} - {wh.WhName ?? "Warehouse"}"
            : "WH";

    string SelectedStageLabel => _stage switch
    {
        MapStage.Area => SelectedWarehouseLabel,
        MapStage.Zone => SelectedAreaLabel,
        MapStage.Grid => SelectedZoneLabel,
        _ => "Production"
    };

    string SelectedAreaLabel =>
        _areas.FirstOrDefault(a => string.Equals(a.AreaCode, _selectedAreaCode, StringComparison.OrdinalIgnoreCase)) is { } area
            ? $"{area.AreaCode} - {area.AreaName ?? "Area"}"
            : "Area";

    string SelectedZoneLabel =>
        _zones.FirstOrDefault(z => string.Equals(z.SectionCode, _selectedZoneCode, StringComparison.OrdinalIgnoreCase)) is { } zone
            ? $"{zone.SectionCode} - {zone.SectionName ?? "Zone"}"
            : "Zone";

    IEnumerable<WarehouseRepository.WarehouseAreaRow> AvailableAreas =>
        _areas
            .Where(a => a.UseYn && !_areaLayouts.Any(l => string.Equals(l.AreaCode, a.AreaCode, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(a => a.AreaCode);

    IEnumerable<DropDownItem> AvailableAreaOptions =>
        AvailableAreas
            .Select(a => new DropDownItem { Value = a.AreaCode, Text = $"{a.AreaCode} - {a.AreaName ?? a.AreaCode}" });

    bool CanAddArea => AvailableAreas.Any();

    IEnumerable<WarehouseRepository.WarehouseMasterRow> AvailableWarehouses =>
        _warehouses
            .Where(w => w.UseYn && !_warehouseLayouts.Any(l => string.Equals(l.AreaCode, w.WhCode, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(w => w.WhCode);

    bool CanAddWarehouse => AvailableWarehouses.Any();

    IEnumerable<WarehouseRepository.WarehouseSectionRow> AvailableZones =>
        _zones
            .Where(z => z.UseYn && !_zoneLayouts.Any(l => string.Equals(l.AreaCode, z.SectionCode, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(z => z.SectionCode);

    bool CanAddZone => AvailableZones.Any();

    IEnumerable<DropDownItem> LevelOptions =>
        ZoneRows()
            .Select(r => r.RackZ)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(LevelSortKey)
            .ThenBy(v => v)
            .Select(v => new DropDownItem { Value = v!, Text = $"Level {v}" });

    protected override void OnInitialized() => ReloadAll();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _mapRef = DotNetObjectReference.Create(this);

        if (_mapJsInitPending && _mapRef is not null)
        {
            await JS.InvokeVoidAsync("whLocationMap.init", _mapRef, "wh-location-map-plan");
            _mapJsReady = true;
            _mapJsInitPending = false;
        }
    }

    void ReloadAll()
    {
        try
        {
            CancelEdit();
            _warehouses = Wh.ListWarehouses(null, false);
            _warehouseLayouts = Wh.ListWarehouseMapPlacements();
            _areas = string.IsNullOrWhiteSpace(_selectedWhCode) ? new() : Wh.ListWarehouseAreas(null, false, _selectedWhCode);
            _allRows = string.IsNullOrWhiteSpace(_selectedWhCode) ? new() : Wh.ListLocationMap(whCode: _selectedWhCode);
            _areaLayouts = string.IsNullOrWhiteSpace(_selectedWhCode) ? new() : Wh.ListLocationAreaLayouts(_selectedWhCode);
            LoadAreaState();
            _warehousePickerOpen = false;
            _areaPickerOpen = false;
            _zonePickerOpen = false;
            _mapJsInitPending = true;
            _msg = "";
        }
        catch (Exception ex)
        {
            _warehouses = new();
            _areas = new();
            _allRows = new();
            _rows = new();
            _warehouseLayouts = new();
            _areaLayouts = new();
            _zoneLayouts = new();
            _msgStyle = AlertStyle.Danger;
            _msg = ex.Message;
        }
    }

    void LoadAreaState()
    {
        if (string.IsNullOrWhiteSpace(_selectedWhCode))
        {
            _areas = new();
            _zones = new();
            _rows = new();
            _areaLayouts = new();
            _zoneLayouts = new();
            return;
        }

        _areas = Wh.ListWarehouseAreas(null, false, _selectedWhCode);
        _allRows = Wh.ListLocationMap(whCode: _selectedWhCode);
        _areaLayouts = Wh.ListLocationAreaLayouts(_selectedWhCode);

        if (string.IsNullOrWhiteSpace(_selectedAreaCode))
        {
            _zones = new();
            _rows = new();
            _zoneLayouts = new();
            return;
        }

        _zones = Wh.ListWarehouseSections(_selectedAreaCode, null, false, _selectedWhCode);
        _zoneLayouts = Wh.ListZoneMapPlacements(_selectedAreaCode, _selectedWhCode);
        if (!string.IsNullOrWhiteSpace(_selectedZoneCode))
            LoadZoneState();
    }

    void LoadZoneState()
    {
        if (string.IsNullOrWhiteSpace(_selectedAreaCode) || string.IsNullOrWhiteSpace(_selectedZoneCode))
        {
            _rows = new();
            return;
        }

        SetDefaultLevel();
        _rows = Wh.ListLocationMap(_selectedAreaCode, _levelCode, _selectedZoneCode, _selectedWhCode);
    }

    List<WarehouseRepository.LocationMapRow> AreaRows()
    {
        if (string.IsNullOrWhiteSpace(_selectedAreaCode)) return new();
        return _allRows
            .Where(r => string.Equals(r.AreaCode, _selectedAreaCode, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    List<WarehouseRepository.LocationMapRow> ZoneRows()
    {
        if (string.IsNullOrWhiteSpace(_selectedAreaCode) || string.IsNullOrWhiteSpace(_selectedZoneCode)) return new();
        return _allRows
            .Where(r => string.Equals(r.AreaCode, _selectedAreaCode, StringComparison.OrdinalIgnoreCase)
                     && string.Equals(r.ZoneName, _selectedZoneCode, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    void SetDefaultLevel(string? preferredLevel = null)
    {
        var levels = ZoneRows()
            .Select(r => r.RackZ)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(LevelSortKey)
            .ThenBy(v => v)
            .ToList();

        if (!string.IsNullOrWhiteSpace(preferredLevel) && levels.Contains(preferredLevel))
        {
            _levelCode = preferredLevel;
            return;
        }

        if (levels.Count > 0 && (string.IsNullOrWhiteSpace(_levelCode) || !levels.Contains(_levelCode)))
            _levelCode = levels[0];
    }

    void ToggleEdit()
    {
        if (_editMode)
        {
            CommitEdit();
            return;
        }

        BeginEdit();
    }

    void BeginEdit()
    {
        if (_editMode) return;
        if (_stage == MapStage.Grid) return;

        _editMode = true;
        _editStage = _stage;
        _editOriginalWarehouseLayouts = CloneLayouts(_warehouseLayouts);
        _editOriginalAreaLayouts = CloneLayouts(_areaLayouts);
        _editOriginalZoneLayouts = CloneLayouts(_zoneLayouts);
        _editOriginalMapWidthPx = _mapWidthPx;
        _editOriginalMapHeightPx = _mapHeightPx;
        _mapJsInitPending = true;
    }

    void CommitEdit()
    {
        try
        {
            if (_editStage == MapStage.Warehouse)
                SyncWarehouseLayouts(_editOriginalWarehouseLayouts, _warehouseLayouts);
            else if (_editStage == MapStage.Area)
                SyncFactoryLayouts(_editOriginalAreaLayouts, _areaLayouts);
            else if (_editStage == MapStage.Zone)
                SyncZoneLayouts(_editOriginalZoneLayouts, _zoneLayouts);
            ClearEditSnapshot();
            _editMode = false;
            _mapJsInitPending = true;
            _msg = "";
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    void CancelEdit()
    {
        if (!_editMode) return;

        if (_editStage == MapStage.Warehouse)
        {
            _warehouseLayouts = CloneLayouts(_editOriginalWarehouseLayouts);
            if (!string.IsNullOrWhiteSpace(_selectedWarehouseCode)
                && !_warehouseLayouts.Any(l => string.Equals(l.AreaCode, _selectedWarehouseCode, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedWarehouseCode = null;
            }
        }
        else if (_editStage == MapStage.Area)
        {
            _areaLayouts = CloneLayouts(_editOriginalAreaLayouts);
            if (!string.IsNullOrWhiteSpace(_selectedFactoryAreaCode)
                && !_areaLayouts.Any(l => string.Equals(l.AreaCode, _selectedFactoryAreaCode, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedFactoryAreaCode = null;
            }
        }
        else if (_editStage == MapStage.Zone)
        {
            _zoneLayouts = CloneLayouts(_editOriginalZoneLayouts);
            if (!string.IsNullOrWhiteSpace(_selectedZoneCode)
                && !_zoneLayouts.Any(l => string.Equals(l.AreaCode, _selectedZoneCode, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedZoneCode = null;
            }
        }
        _mapWidthPx = _editOriginalMapWidthPx;
        _mapHeightPx = _editOriginalMapHeightPx;
        ClearEditSnapshot();
        _editMode = false;
        _warehousePickerOpen = false;
        _areaPickerOpen = false;
        _mapJsInitPending = true;
    }

    void ClearEditSnapshot()
    {
        _editOriginalWarehouseLayouts = new();
        _editOriginalAreaLayouts = new();
        _editOriginalZoneLayouts = new();
        _editStage = null;
    }

