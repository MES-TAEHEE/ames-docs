@page "/wh/location-map"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@using Radzen

<PageTitle>WH-003 Location Map · AMES</PageTitle>
<AmesPageHeader Code="WH-003" Title="Location Map" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">Locations</div>
        <div class="ames-kpi-v">@_rows.Count</div>
        <div class="ames-kpi-s">current view</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">Stocked</div>
        <div class="ames-kpi-v">@_rows.Count(r => r.TotalQty > 0)</div>
        <div class="ames-kpi-s">occupied bins</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">Empty</div>
        <div class="ames-kpi-v">@_rows.Count(r => r.TotalQty == 0)</div>
        <div class="ames-kpi-s">available bins</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">Mixed</div>
        <div class="ames-kpi-v">@_rows.Count(r => r.Status == "Mixed")</div>
        <div class="ames-kpi-s">multiple parts</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ Warehouse Location Map</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Area" />
            <RadzenDropDown @bind-Value="_areaCode" Data="@AreaOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="All Areas" Change="@(_ => Reload())"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:190px;" />
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <div class="wh-map-legend">
        <span><i class="empty"></i> Empty</span>
        <span><i class="stocked"></i> Stocked</span>
        <span><i class="mixed"></i> Mixed</span>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">No locations found.</div>
    }
    else
    {
        @foreach (var area in _rows.GroupBy(r => new { r.AreaCode, r.AreaName }).OrderBy(g => g.Key.AreaCode))
        {
            <div class="wh-map-area">
                <div class="wh-map-area-h">
                    <div>
                        <strong>@(area.Key.AreaCode ?? "No Area")</strong>
                        <span class="dim">@(area.Key.AreaName ?? "")</span>
                    </div>
                    <span class="pill info">@area.Count() locations</span>
                </div>
                <div class="wh-map-grid">
                    @foreach (var loc in area)
                    {
                        <button type="button" class="wh-map-cell @StatusClass(loc.Status)" @onclick="() => _selected = loc">
                            <span class="wh-map-cell-code">@loc.LocationNo</span>
                            <span class="wh-map-cell-rack">@RackText(loc)</span>
                            <span class="wh-map-cell-qty">@loc.TotalQty.ToString("N0")</span>
                        </button>
                    }
                </div>
            </div>
        }
    }
</div>

@if (_selected is not null)
{
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
            <span>Selected Location</span>
            <button class="ames-btn" @onclick="() => _selected = null">Close</button>
        </div>
        <div class="wh-detail-grid">
            <div><span>Location</span><strong>@_selected.LocationNo</strong></div>
            <div><span>Name</span><strong>@(_selected.LocationName ?? "-")</strong></div>
            <div><span>Area</span><strong>@(_selected.AreaCode ?? "-")</strong></div>
            <div><span>Zone</span><strong>@(_selected.ZoneCode ?? "-")</strong></div>
            <div><span>Rack</span><strong>@RackText(_selected)</strong></div>
            <div><span>Qty</span><strong>@_selected.TotalQty.ToString("N0")</strong></div>
            <div><span>Lots</span><strong>@_selected.LotCount</strong></div>
            <div><span>Parts</span><strong>@_selected.PartCount</strong></div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.WarehouseRepository.LocationMapRow> _allRows = new();
    List<AMES.Data.Repositories.WarehouseRepository.LocationMapRow> _rows = new();
    AMES.Data.Repositories.WarehouseRepository.LocationMapRow? _selected;
    string? _areaCode;
    string _msg = "";

    public class DropDownItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    IEnumerable<DropDownItem> AreaOptions =>
        _allRows
            .Where(r => !string.IsNullOrWhiteSpace(r.AreaCode))
            .GroupBy(r => r.AreaCode)
            .OrderBy(g => g.Key)
            .Select(g => new DropDownItem
            {
                Value = g.Key!,
                Text = $"{g.Key} - {g.First().AreaName ?? "Area"}",
            });

    protected override void OnInitialized() => ReloadAll();

    void ReloadAll()
    {
        try
        {
            _allRows = Wh.ListLocationMap();
            _rows = string.IsNullOrWhiteSpace(_areaCode)
                ? _allRows
                : _allRows.Where(r => r.AreaCode == _areaCode).ToList();
        }
        catch (Exception ex)
        {
            _allRows = new();
            _rows = new();
            _msg = ex.Message;
        }
    }

    void Reload()
    {
        try
        {
            _rows = Wh.ListLocationMap(_areaCode);
            _msg = "";
        }
        catch (Exception ex)
        {
            _rows = new();
            _msg = ex.Message;
        }
    }

    static string StatusClass(string status) => status switch
    {
        "Stocked" => "stocked",
        "Mixed" => "mixed",
        _ => "empty",
    };

    static string RackText(AMES.Data.Repositories.WarehouseRepository.LocationMapRow row) =>
        string.Join("-", new[] { row.RackX, row.RackY, row.RackZ }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
