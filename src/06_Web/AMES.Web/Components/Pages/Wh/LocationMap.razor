@page "/wh/location-map"
@inject IStringLocalizer<SharedResources> L
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Data.Repositories.WarehouseRepository Warehouse
@inject AuthenticationStateProvider AuthPrvd
@inject AMES.Web.Services.PermissionService PermSvc
@inject PersistentComponentState PageState
@implements IDisposable
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["WH.LocMap.Title"] · AMES</PageTitle>
<AmesPageHeader Code="WH-02" TitleKey="WH.LocMap.Title" />

@if (_loading)
{
    <div class="ames-card"><LocationMapLoading /></div>
}
else if (_error is not null) { <RadzenAlert AlertStyle="Radzen.AlertStyle.Danger">@_error</RadzenAlert> }
else { <LocationMapExplorer Locations="_locations" Inventory="_inventory" Areas="_areas" OnRefresh="Reload" CanEdit="_canEdit" SearchId="warehouse-location-search" /> }

@code {
    private List<LocationMapCell> _locations = [];
    private List<LocationMapStock> _inventory = [];
    private List<LocationMapArea> _areas = [];
    private string? _error;
    private bool _canEdit;
    private bool _loading = true;
    // 첫 응답(프리렌더)에 데이터를 넣어 보낸다 — 실시간 연결을 기다린 뒤 읽으면 그동안 로딩 표시만 보인다.
    // 프리렌더에서 읽은 결과는 연결된 뒤 그대로 넘겨받아 다시 읽지 않는다(화면 깜박임·이중 조회 방지).
    private const string StateKey = "wh-location-map";
    private sealed record MapState(List<LocationMapArea> Areas, List<LocationMapCell> Locations, List<LocationMapStock> Inventory, bool CanEdit);
    private PersistingComponentStateSubscription _persist;

    protected override async Task OnInitializedAsync()
    {
        _persist = PageState.RegisterOnPersisting(() =>
        {
            if (!_loading && _error is null) PageState.PersistAsJson(StateKey, new MapState(_areas, _locations, _inventory, _canEdit));
            return Task.CompletedTask;
        });
        var restored = PageState.TryTakeFromJson<MapState>(StateKey, out var state) && state is not null;
        if (restored)
        {
            (_areas, _locations, _inventory, _canEdit) = (state!.Areas, state.Locations, state.Inventory, state.CanEdit);
            _loading = false;
        }
        try
        {
            await PermSvc.EnsureAsync(AuthPrvd);
            _canEdit = PermSvc.CanEdit("md/fd/location");
            if (!restored) await Reload();
        }
        catch (Exception ex) { if (!restored) _error = $"Unable to load Location Map: {ex.Message}"; }
        finally { _loading = false; }
    }

    public void Dispose() => _persist.Dispose();

    private async Task Reload()
    {
        try
        {
            (_areas, _locations, _inventory) = await Task.Run(() => LocationMapDatabase.Load(MD, Warehouse, finishedGoods: false));
            _error = null;
        }
        catch (Exception ex) { _error = $"Unable to load Location Map: {ex.Message}"; }
    }

}
