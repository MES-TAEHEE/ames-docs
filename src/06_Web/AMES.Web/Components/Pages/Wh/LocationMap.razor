    void AddWarehouse(string whCode)
    {
        if (string.IsNullOrWhiteSpace(whCode)) return;

        whCode = whCode.Trim();
        if (_warehouseLayouts.Any(l => string.Equals(l.AreaCode, whCode, StringComparison.OrdinalIgnoreCase)))
        {
            ShowWarning("WH is already placed on the map.");
            return;
        }

        try
        {
            if (!_editMode)
                BeginEdit();

            var index = _warehouseLayouts.Count;
            var xPct = Clamp(4m + (index % 3) * 31m, 0m, 100m - DefaultAreaWidthPct);
            var yPct = Clamp(8m + (index / 3) * 28m, 0m, 100m - DefaultAreaHeightPct);
            var wh = _warehouses.FirstOrDefault(w => string.Equals(w.WhCode, whCode, StringComparison.OrdinalIgnoreCase));
            _warehouseLayouts.Add(new WarehouseRepository.LocationAreaLayoutRow(
                whCode,
                wh?.WhName,
                xPct,
                yPct,
                DefaultAreaWidthPct,
                DefaultAreaHeightPct));
            _selectedWarehouseCode = whCode;
            _warehousePickerOpen = false;
            _mapJsInitPending = true;
            _msg = "";
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    void AddArea(string areaCode)
    {
        if (string.IsNullOrWhiteSpace(_selectedWhCode) || string.IsNullOrWhiteSpace(areaCode)) return;

        areaCode = areaCode.Trim();
        if (_areaLayouts.Any(l => string.Equals(l.AreaCode, areaCode, StringComparison.OrdinalIgnoreCase)))
        {
            ShowWarning("Area is already placed in this WH.");
            return;
        }

        try
        {
            if (!_editMode)
                BeginEdit();

            var index = _areaLayouts.Count;
            var xPct = Clamp(4m + (index % 3) * 31m, 0m, 100m - DefaultAreaWidthPct);
            var yPct = Clamp(8m + (index / 3) * 28m, 0m, 100m - DefaultAreaHeightPct);
            var area = _areas.FirstOrDefault(a => string.Equals(a.AreaCode, areaCode, StringComparison.OrdinalIgnoreCase));
            _areaLayouts.Add(new WarehouseRepository.LocationAreaLayoutRow(
                areaCode,
                area?.AreaName,
                xPct,
                yPct,
                DefaultAreaWidthPct,
                DefaultAreaHeightPct));
            _selectedFactoryAreaCode = areaCode;
            _areaPickerOpen = false;
            _mapJsInitPending = true;
            _msg = "";
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    void AddZone(string zoneCode)
    {
        if (string.IsNullOrWhiteSpace(_selectedAreaCode) || string.IsNullOrWhiteSpace(zoneCode)) return;

        zoneCode = zoneCode.Trim();
        if (_zoneLayouts.Any(l => string.Equals(l.AreaCode, zoneCode, StringComparison.OrdinalIgnoreCase)))
        {
            ShowWarning("Zone is already placed in this area.");
            return;
        }

        try
        {
            if (!_editMode)
                BeginEdit();

            var index = _zoneLayouts.Count;
            var xPct = Clamp(4m + (index % 3) * 31m, 0m, 100m - DefaultAreaWidthPct);
            var yPct = Clamp(8m + (index / 3) * 28m, 0m, 100m - DefaultAreaHeightPct);
            var zone = _zones.FirstOrDefault(z => string.Equals(z.SectionCode, zoneCode, StringComparison.OrdinalIgnoreCase));
            _zoneLayouts.Add(new WarehouseRepository.LocationAreaLayoutRow(
                zoneCode,
                zone?.SectionName,
                xPct,
                yPct,
                DefaultAreaWidthPct,
                DefaultAreaHeightPct));
            _selectedZoneCode = zoneCode;
            _zonePickerOpen = false;
            _mapJsInitPending = true;
