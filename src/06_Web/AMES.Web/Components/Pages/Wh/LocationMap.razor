    void RemoveWarehouseFromDraft(string whCode)
    {
        if (string.IsNullOrWhiteSpace(whCode)) return;
        try
        {
            Wh.DeleteWarehouseMapPlacement(whCode);
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
            return;
        }

        _warehouseLayouts = _warehouseLayouts
            .Where(l => !string.Equals(l.AreaCode, whCode, StringComparison.OrdinalIgnoreCase))
            .ToList();
        _editOriginalWarehouseLayouts = _editOriginalWarehouseLayouts
            .Where(l => !string.Equals(l.AreaCode, whCode, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (string.Equals(_selectedWarehouseCode, whCode, StringComparison.OrdinalIgnoreCase))
            _selectedWarehouseCode = null;

        _msg = "";
    }

    void RemoveAreaFromDraft(string areaCode)
    {
        if (string.IsNullOrWhiteSpace(areaCode)) return;
        try
        {
            Wh.DeleteFactoryAreaPlacement(_selectedWhCode ?? "", areaCode);
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
            return;
        }

        _areaLayouts = _areaLayouts
            .Where(l => !string.Equals(l.AreaCode, areaCode, StringComparison.OrdinalIgnoreCase))
            .ToList();
        _editOriginalAreaLayouts = _editOriginalAreaLayouts
            .Where(l => !string.Equals(l.AreaCode, areaCode, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (string.Equals(_selectedFactoryAreaCode, areaCode, StringComparison.OrdinalIgnoreCase))
            _selectedFactoryAreaCode = null;

        _msg = "";
    }

    void RemoveZonePlacement(string zoneCode)
    {
        if (string.IsNullOrWhiteSpace(_selectedWhCode) || string.IsNullOrWhiteSpace(_selectedAreaCode) || string.IsNullOrWhiteSpace(zoneCode)) return;
        try
        {
            Wh.DeleteZoneMapPlacement(_selectedWhCode, _selectedAreaCode, zoneCode);
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
            return;
        }

        _zoneLayouts = _zoneLayouts
            .Where(l => !string.Equals(l.AreaCode, zoneCode, StringComparison.OrdinalIgnoreCase))
            .ToList();
        _editOriginalZoneLayouts = _editOriginalZoneLayouts
            .Where(l => !string.Equals(l.AreaCode, zoneCode, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (string.Equals(_selectedZoneCode, zoneCode, StringComparison.OrdinalIgnoreCase))
            _selectedZoneCode = null;

        _msg = "";
    }

    [JSInvokable]
    public Task OnAreaSelectedFromMap(string code)
    {
        if (_stage == MapStage.Warehouse)
            SelectWarehouse(code);
        else if (_stage == MapStage.Area)
            SelectFactoryArea(code);
        else if (_stage == MapStage.Zone)
            SelectZone(code);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnAreaLayoutChanged(string code, double xPct, double yPct, double wPct, double hPct)
    {
        try
        {
            if (_stage == MapStage.Warehouse)
            {
                var whName = _warehouses.FirstOrDefault(w => string.Equals(w.WhCode, code, StringComparison.OrdinalIgnoreCase))?.WhName;
                _warehouseLayouts = UpsertLayout(_warehouseLayouts, code, whName, (decimal)xPct, (decimal)yPct, (decimal)wPct, (decimal)hPct);
                _selectedWarehouseCode = code;
            }
            else if (_stage == MapStage.Area)
            {
                var areaName = _areas.FirstOrDefault(a => string.Equals(a.AreaCode, code, StringComparison.OrdinalIgnoreCase))?.AreaName;
                _areaLayouts = UpsertLayout(_areaLayouts, code, areaName, (decimal)xPct, (decimal)yPct, (decimal)wPct, (decimal)hPct);
                _selectedFactoryAreaCode = code;
            }
            else if (_stage == MapStage.Zone)
            {
                var zoneName = _zones.FirstOrDefault(z => string.Equals(z.SectionCode, code, StringComparison.OrdinalIgnoreCase))?.SectionName;
                _zoneLayouts = UpsertLayout(_zoneLayouts, code, zoneName, (decimal)xPct, (decimal)yPct, (decimal)wPct, (decimal)hPct);
                _selectedZoneCode = code;
            }
            _msg = "";
        }
        catch (Exception ex) { ShowError(ex.Message); }

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnMapCanvasChanged(double widthPx, double heightPx)
    {
        _mapWidthPx = Math.Max(420m, (decimal)widthPx);
        _mapHeightPx = Math.Max(320m, (decimal)heightPx);
        return InvokeAsync(StateHasChanged);
    }

    void SyncWarehouseLayouts(
        List<WarehouseRepository.LocationAreaLayoutRow> original,
        List<WarehouseRepository.LocationAreaLayoutRow> current)
    {
        foreach (var removed in original.Where(o => !current.Any(c => SameCode(c.AreaCode, o.AreaCode))))
            Wh.DeleteWarehouseMapPlacement(removed.AreaCode);

        foreach (var layout in current)
            Wh.SaveWarehouseMapPlacement(layout.AreaCode, layout.XPct, layout.YPct, layout.WPct, layout.HPct);

        _warehouseLayouts = Wh.ListWarehouseMapPlacements();
    }

    void SyncFactoryLayouts(
        List<WarehouseRepository.LocationAreaLayoutRow> original,
        List<WarehouseRepository.LocationAreaLayoutRow> current)
    {
        if (string.IsNullOrWhiteSpace(_selectedWhCode))
            return;

        foreach (var removed in original.Where(o => !current.Any(c => SameCode(c.AreaCode, o.AreaCode))))
            Wh.DeleteFactoryAreaPlacement(_selectedWhCode, removed.AreaCode);

        foreach (var layout in current)
            Wh.SaveFactoryAreaLayout(_selectedWhCode, layout.AreaCode, layout.XPct, layout.YPct, layout.WPct, layout.HPct);

        _areaLayouts = Wh.ListLocationAreaLayouts(_selectedWhCode);
    }

    void SyncZoneLayouts(
        List<WarehouseRepository.LocationAreaLayoutRow> original,
        List<WarehouseRepository.LocationAreaLayoutRow> current)
    {
        if (string.IsNullOrWhiteSpace(_selectedWhCode) || string.IsNullOrWhiteSpace(_selectedAreaCode))
            return;

        foreach (var removed in original.Where(o => !current.Any(c => SameCode(c.AreaCode, o.AreaCode))))
            Wh.DeleteZoneMapPlacement(_selectedWhCode, _selectedAreaCode, removed.AreaCode);

        foreach (var layout in current)
            Wh.SaveZoneMapPlacement(_selectedWhCode, _selectedAreaCode, layout.AreaCode, layout.XPct, layout.YPct, layout.WPct, layout.HPct);

        _zoneLayouts = Wh.ListZoneMapPlacements(_selectedAreaCode, _selectedWhCode);
    }

    static List<WarehouseRepository.LocationAreaLayoutRow> CloneLayouts(IEnumerable<WarehouseRepository.LocationAreaLayoutRow> rows) =>
        rows.Select(r => r with { }).ToList();

    static List<WarehouseRepository.LocationAreaLayoutRow> UpsertLayout(
        List<WarehouseRepository.LocationAreaLayoutRow> layouts,
        string code,
        string? name,
        decimal xPct,
        decimal yPct,
        decimal wPct,
        decimal hPct)
    {
        var next = CloneLayouts(layouts);
        var index = next.FindIndex(l => SameCode(l.AreaCode, code));
        var row = new WarehouseRepository.LocationAreaLayoutRow(code, name, xPct, yPct, wPct, hPct);
        if (index >= 0)
            next[index] = row;
        else
            next.Add(row);

        return next;
    }

    static bool SameCode(string? left, string? right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    IEnumerable<WarehouseView> WarehouseViews()
    {
        var warehouseByCode = _warehouses.ToDictionary(w => w.WhCode, StringComparer.OrdinalIgnoreCase);
        foreach (var layout in _warehouseLayouts)
        {
            if (warehouseByCode.TryGetValue(layout.AreaCode, out var wh))
                yield return new WarehouseView(wh, layout);
        }
    }

    IEnumerable<FactoryAreaView> FactoryAreaViews()
    {
        var areaByCode = _areas.ToDictionary(a => a.AreaCode, StringComparer.OrdinalIgnoreCase);
        foreach (var layout in _areaLayouts)
        {
            if (areaByCode.TryGetValue(layout.AreaCode, out var area))
                yield return new FactoryAreaView(area, layout);
        }
    }

    IEnumerable<ZoneView> ZoneViews()
    {
        var zoneByCode = _zones.ToDictionary(z => z.SectionCode, StringComparer.OrdinalIgnoreCase);
        foreach (var layout in _zoneLayouts)
        {
            if (zoneByCode.TryGetValue(layout.AreaCode, out var zone))
                yield return new ZoneView(zone, layout);
        }
    }

    RenderFragment RenderGrid() => __builder =>
    {
        var areaLocations = _rows
            .OrderBy(r => ToNumberOrMax(r.RackY))
            .ThenBy(r => r.RackY)
            .ThenBy(r => ToNumberOrMax(r.RackX))
            .ThenBy(r => r.RackX)
            .ThenBy(r => r.LocationNo)
            .ToList();
        var locationColumns = LocationColumns(areaLocations);
        var locationRows = LocationRows(areaLocations);

        if (areaLocations.Count == 0)
        {
            <div class="ames-empty">No locations on this level.</div>
        }
        else
        {
            <div class="wh-location-coordinate-scroll">
                <div class="wh-location-coordinate-map" style="@LocationGridStyle(locationColumns.Count)">
                    <div class="wh-grid-corner">Y / X</div>
                    @foreach (var column in locationColumns)
                    {
                        <div class="wh-grid-axis wh-grid-col">@column</div>
                    }

                    @foreach (var row in locationRows)
                    {
                        <div class="wh-grid-axis wh-grid-row">@row</div>
                        @foreach (var column in locationColumns)
                        {
                            var cells = LocationCells(areaLocations, column, row);
                            <div class="wh-grid-slot @(cells.Count == 0 ? "empty" : "")">
                                @if (cells.Count == 0)
                                {
                                    <span class="wh-grid-empty">-</span>
                                }
                                else
                                {
                                    @foreach (var loc in cells)
                                    {
                                        <button type="button" class="wh-location-bin @StatusClass(loc.Status)" @onclick="() => _selectedLocation = loc">
                                            <span class="wh-location-bin-code">@loc.LocationNo</span>
                                            <span class="wh-location-bin-zone">@((loc.ZoneCode ?? loc.ZoneName) ?? "-")</span>
                                            <span class="wh-location-bin-qty">@loc.TotalQty.ToString("N0")</span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    };

    bool IsSelectedArea(string areaCode) =>
        string.Equals(_selectedFactoryAreaCode, areaCode, StringComparison.OrdinalIgnoreCase);

    bool IsSelectedWarehouse(string whCode) =>
        string.Equals(_selectedWarehouseCode, whCode, StringComparison.OrdinalIgnoreCase);

    bool IsSelectedZone(string zoneCode) =>
        string.Equals(_selectedZoneCode, zoneCode, StringComparison.OrdinalIgnoreCase);

    string BreadcrumbClass(MapStage stage) => _stage == stage ? "on" : "";

    void ShowWarning(string message)
    {
        _msgStyle = AlertStyle.Warning;
        _msg = message;
    }

    void ShowError(string message)
    {
        _msgStyle = AlertStyle.Danger;
        _msg = message;
    }

    static List<string> LocationColumns(List<WarehouseRepository.LocationMapRow> rows) =>
        rows.Select(r => AxisText(r.RackX))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(ToNumberOrMax)
            .ThenBy(v => v)
            .ToList();

    static List<string> LocationRows(List<WarehouseRepository.LocationMapRow> rows) =>
        rows.Select(r => AxisText(r.RackY))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(ToNumberOrMax)
            .ThenBy(v => v)
            .ToList();

    static List<WarehouseRepository.LocationMapRow> LocationCells(
        List<WarehouseRepository.LocationMapRow> rows,
        string rackX,
        string rackY) =>
        rows.Where(r => string.Equals(AxisText(r.RackX), rackX, StringComparison.OrdinalIgnoreCase)
                     && string.Equals(AxisText(r.RackY), rackY, StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => r.ZoneCode)
            .ThenBy(r => r.LocationNo)
            .ToList();

    static string StatusClass(string status) => status switch
    {
        "Stocked" => "stocked",
        "Mixed" => "mixed",
        _ => "empty",
    };

    static string DisplayLevel(string? level) =>
        string.IsNullOrWhiteSpace(level) ? "-" : level;

    string MapCanvasStyle() =>
        _stage == MapStage.Grid
            ? ""
            : $"width:{Px(_mapWidthPx)}px;height:{Px(_mapHeightPx)}px;";

    static string PlacementStyle(WarehouseRepository.LocationAreaLayoutRow row) =>
        $"left:{Pct(row.XPct)}%;top:{Pct(row.YPct)}%;width:{Pct(row.WPct)}%;height:{Pct(row.HPct)}%;";

    static string LocationGridStyle(int columnCount) =>
        $"--wh-cols:{Math.Max(1, columnCount)};min-width:{72 + Math.Max(1, columnCount) * 156}px;";

    static string AxisText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    static string Pct(decimal value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    static string Px(decimal value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    static int ToNumberOrMax(string? value) =>
        int.TryParse(value, out var number) ? number : int.MaxValue;

    static int LevelSortKey(string? value) =>
        int.TryParse(value, out var number) ? number : int.MaxValue;

    static decimal Clamp(decimal value, decimal min, decimal max) =>
        Math.Max(min, Math.Min(max, value));

    public async ValueTask DisposeAsync()
    {
        if (_mapJsReady)
        {
            try { await JS.InvokeVoidAsync("whLocationMap.destroy"); }
            catch { }
        }

        _mapRef?.Dispose();
    }
