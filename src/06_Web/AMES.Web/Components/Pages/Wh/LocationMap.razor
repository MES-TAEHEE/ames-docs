@page "/wh/location-map"
@inject IStringLocalizer<SharedResources> L
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["WH.LocMap.Title"] · AMES</PageTitle>
<AmesPageHeader Code="WH-003" TitleKey="WH.LocMap.Title" />

<LocationMapExplorer Locations="_locations" Inventory="_inventory" OnRefresh="Reload" SearchId="warehouse-location-search" />

@code {
    private List<LocationMapCell> _locations = [];
    private List<LocationMapStock> _inventory = [];

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        var material = LocationMapDemoData.Create("MATERIAL", "Material Area");
        var shipping = LocationMapDemoData.Create("SHIPPING", "Shipping Area", "SHIP-");
        _locations = [.. material.Locations, .. shipping.Locations];
        _inventory = [.. material.Inventory, .. shipping.Inventory];
    }
}
