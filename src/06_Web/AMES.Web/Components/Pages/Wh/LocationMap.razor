@page "/wh/location-map"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@using AMES.Data.Repositories
@using Radzen

<PageTitle>Location Search - AMES</PageTitle>
<AmesPageHeader Code="WH-003" Title="Location Search" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">Warehouse</div>
        <div class="ames-kpi-v">@_warehouses.Count(w => w.UseYn)</div>
        <div class="ames-kpi-s">active master records</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">Area</div>
        <div class="ames-kpi-v">@_areas.Count(a => a.UseYn)</div>
        <div class="ames-kpi-s">in selected warehouse</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">Locations</div>
        <div class="ames-kpi-v">@LocationCount</div>
        <div class="ames-kpi-s">in current view</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">On Hand</div>
        <div class="ames-kpi-v">@OnHandQty.ToString("N0")</div>
        <div class="ames-kpi-s">in current view</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="@_msgStyle" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h wh-location-directory-toolbar">
        <div>
            <span>@StageTitle</span>
            <div class="dim">@StageDescription</div>
        </div>

        <div class="wh-map-search">
            <RadzenTextBox @bind-Value="_mapSearch"
                           @bind-Value:after="RefreshLocationSearch"
                           Immediate="true"
                           Placeholder="Search part, name, or location"
                           InputSize="InputSize.Small"
                           class="ames-rz-input wh-map-search-input" />
            <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Click="SearchLocations" title="Search inventory location" class="ames-rz-btn" />
            @if (!string.IsNullOrWhiteSpace(_mapSearch))
            {
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="ClearLocationSearch" title="Clear search" class="ames-rz-btn" />
            }
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            @if (_stage != DirectoryStage.Warehouse)
            {
                <RadzenButton Text="Back" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="Back" class="ames-rz-btn" />
            }
            @if (_stage == DirectoryStage.Location)
            {
                <RadzenDropDown @bind-Value="_levelCode"
                                Data="@LevelOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                Placeholder="Level"
                                Change="@(_ => LoadLocations())"
                                InputSize="InputSize.Small"
                                class="ames-rz-input"
                                Style="width:150px;" />
            }
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Click="ReloadAll" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <div class="wh-map-breadcrumb">
        <button type="button" class="@BreadcrumbClass(DirectoryStage.Warehouse)" @onclick="BackToWarehouse">Warehouse</button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(DirectoryStage.Area)" disabled="@string.IsNullOrWhiteSpace(_selectedWhCode)" @onclick="BackToArea">
            @(_selectedWhCode ?? "Area")
        </button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(DirectoryStage.Zone)" disabled="@string.IsNullOrWhiteSpace(_selectedAreaCode)" @onclick="BackToZone">
            @(_selectedAreaCode ?? "Zone")
        </button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(DirectoryStage.Location)" disabled="@string.IsNullOrWhiteSpace(_selectedZoneCode)">
            @(_selectedZoneCode ?? "Location")
        </button>
    </div>

    <div class="wh-location-directory-workspace">
        <section class="wh-location-directory" aria-label="Location hierarchy">
            <div class="wh-location-directory-head">
                <div>
                    <span>@CardLabel</span>
                    <strong>@CardTitle</strong>
                </div>
                <span>@CardCountText</span>
            </div>

            @if (_stage == DirectoryStage.Warehouse)
            {
                <div class="wh-location-directory-grid">
                    @foreach (var warehouse in _warehouses.Where(w => w.UseYn).OrderBy(w => w.WhCode))
                    {
                        <button type="button" class="wh-location-directory-card" @onclick="() => SelectWarehouse(warehouse.WhCode)">
                            <span class="wh-location-directory-code">@warehouse.WhCode</span>
                            <strong>@(warehouse.WhName ?? "Warehouse")</strong>
                            <span class="wh-location-directory-summary">@warehouse.AreaCount areas · @warehouse.LocationCount locations</span>
                            <span class="wh-location-directory-qty">@warehouse.TotalQty.ToString("N0") on hand</span>
                            <RadzenIcon Icon="arrow_forward" class="wh-location-directory-arrow" />
                        </button>
                    }
                </div>
            }
            else if (_stage == DirectoryStage.Area)
            {
                <div class="wh-location-directory-grid">
                    @foreach (var area in _areas.Where(a => a.UseYn).OrderBy(a => a.AreaCode))
                    {
                        <button type="button" class="wh-location-directory-card" @onclick="() => SelectArea(area.AreaCode)">
                            <span class="wh-location-directory-code">@area.AreaCode</span>
                            <strong>@(area.AreaName ?? "Area")</strong>
                            <span class="wh-location-directory-summary">@ZoneCount(area.AreaCode) zones · @area.LocationCount locations</span>
                            <span class="wh-location-directory-qty">@area.TotalQty.ToString("N0") on hand</span>
                            <RadzenIcon Icon="arrow_forward" class="wh-location-directory-arrow" />
                        </button>
                    }
                </div>
            }
            else if (_stage == DirectoryStage.Zone)
            {
                <div class="wh-location-directory-grid">
                    @foreach (var zone in ZoneCards)
                    {
                        <button type="button" class="wh-location-directory-card" @onclick="() => SelectZone(zone.Code)">
                            <span class="wh-location-directory-code">@zone.Code</span>
                            <strong>@zone.Name</strong>
                            <span class="wh-location-directory-summary">@zone.LevelCount levels · @zone.LocationCount locations</span>
                            <span class="wh-location-directory-qty">@zone.TotalQty.ToString("N0") on hand</span>
                            <RadzenIcon Icon="arrow_forward" class="wh-location-directory-arrow" />
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="wh-location-grid-stage">
                    <div class="wh-location-grid-head">
                        <div>
                            <strong>@SelectedZoneLabel</strong>
                            <span>Level @Display(_levelCode) · X/Y Location Grid</span>
                        </div>
                        <span>@_rows.Count locations</span>
                    </div>
                    @RenderLocationGrid()
                </div>
            }

            @if (CurrentCardCount == 0)
            {
                <div class="ames-empty">No @CardLabel.ToLowerInvariant() records found.</div>
            }
        </section>

        <aside class="wh-map-stock-panel" aria-label="Inventory in view">
            <div class="wh-map-stock-head">
                <div>
                    <span>Inventory in View</span>
                    <strong>@InventoryScopeLabel</strong>
                </div>
                <span class="wh-map-stock-count">@VisibleInventoryRows.Count rows</span>
            </div>

            @if (VisibleInventoryRows.Count == 0)
            {
                <div class="wh-map-stock-empty">
                    <strong>No stock found</strong>
                    <span>@(string.IsNullOrWhiteSpace(_mapSearch) ? "No on-hand inventory in this view." : "Try a different part, name, or location.")</span>
                </div>
            }
            else
            {
                <div class="wh-map-stock-list">
                    @foreach (var item in VisibleInventoryRows)
                    {
                        <button type="button"
                                class="wh-map-stock-item @(IsHighlightedLocation(item.LocationNo) ? "highlighted" : "")"
                                @onclick="() => GoToInventoryLocation(item)">
                            <span class="wh-map-stock-part">@item.PartNo</span>
                            <span class="wh-map-stock-name">@(item.PartName ?? item.PartNo)</span>
                            <span class="wh-map-stock-meta">
                                <b>@item.LocationNo</b>
                                <span>@item.Qty.ToString("N0") @(item.Uom ?? "EA")</span>
                            </span>
                        </button>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@code {
    enum DirectoryStage { Warehouse, Area, Zone, Location }

    sealed record DropDownItem(string Text, string Value);
    sealed record ZoneCard(string Code, string Name, int LevelCount, int LocationCount, decimal TotalQty);

    List<WarehouseRepository.WarehouseMasterRow> _warehouses = new();
    List<WarehouseRepository.WarehouseAreaRow> _areas = new();
    List<WarehouseRepository.LocationMapRow> _allRows = new();
    List<WarehouseRepository.LocationMapRow> _rows = new();
    List<WarehouseRepository.LocationInventoryRow> _scopeInventoryRows = new();
    List<WarehouseRepository.LocationInventoryRow> _searchInventoryRows = new();
    string? _selectedWhCode;
    string? _selectedAreaCode;
    string? _selectedZoneCode;
    string? _levelCode;
    string _mapSearch = "";
    string? _highlightedLocationNo;
    string _msg = "";
    AlertStyle _msgStyle = AlertStyle.Danger;
    DirectoryStage _stage = DirectoryStage.Warehouse;

    string StageTitle => _stage switch
    {
        DirectoryStage.Warehouse => "Warehouse Directory",
        DirectoryStage.Area => $"{SelectedWarehouseLabel} Areas",
        DirectoryStage.Zone => $"{SelectedAreaLabel} Zones",
        _ => $"{SelectedZoneLabel} Locations"
    };

    string StageDescription => _stage switch
    {
        DirectoryStage.Warehouse => "Select a warehouse to browse its areas.",
        DirectoryStage.Area => "Select an area to browse its zones.",
        DirectoryStage.Zone => "Select a zone to browse its storage locations.",
        _ => "Select a level, then review locations and current inventory."
    };

    string CardLabel => _stage switch
    {
        DirectoryStage.Warehouse => "Warehouse",
        DirectoryStage.Area => "Area",
        DirectoryStage.Zone => "Zone",
        _ => "Location"
    };

    string CardTitle => _stage switch
    {
        DirectoryStage.Warehouse => "Choose a warehouse",
        DirectoryStage.Area => SelectedWarehouseLabel,
        DirectoryStage.Zone => SelectedAreaLabel,
        _ => $"{SelectedZoneLabel} · Level {Display(_levelCode)}"
    };

    int CurrentCardCount => _stage switch
    {
        DirectoryStage.Warehouse => _warehouses.Count(w => w.UseYn),
        DirectoryStage.Area => _areas.Count(a => a.UseYn),
        DirectoryStage.Zone => ZoneCards.Count,
        _ => _rows.Count
    };

    string CardCountText => $"{CurrentCardCount} {CardLabel.ToLowerInvariant()}{(CurrentCardCount == 1 ? "" : "s")}";
    int LocationCount => _stage == DirectoryStage.Location ? _rows.Count : _allRows.Count;
    decimal OnHandQty => _stage == DirectoryStage.Location ? _rows.Sum(r => r.TotalQty) : _allRows.Sum(r => r.TotalQty);

    string SelectedWarehouseLabel =>
        _warehouses.FirstOrDefault(w => string.Equals(w.WhCode, _selectedWhCode, StringComparison.OrdinalIgnoreCase)) is { } warehouse
            ? $"{warehouse.WhCode} - {warehouse.WhName ?? "Warehouse"}"
            : "Warehouse";

    string SelectedAreaLabel =>
        _areas.FirstOrDefault(a => string.Equals(a.AreaCode, _selectedAreaCode, StringComparison.OrdinalIgnoreCase)) is { } area
            ? $"{area.AreaCode} - {area.AreaName ?? "Area"}"
            : "Area";

    string SelectedZoneLabel =>
        string.IsNullOrWhiteSpace(_selectedZoneCode) ? "Zone" : _selectedZoneCode;

    List<ZoneCard> ZoneCards => _allRows
        .Where(r => string.Equals(r.AreaCode, _selectedAreaCode, StringComparison.OrdinalIgnoreCase))
        .GroupBy(r => string.IsNullOrWhiteSpace(r.ZoneName) ? "DEFAULT" : r.ZoneName.Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(g => new ZoneCard(
            g.Key,
            g.Key,
            g.Select(r => r.RackZ).Where(v => !string.IsNullOrWhiteSpace(v)).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
            g.Count(),
            g.Sum(r => r.TotalQty)))
        .OrderBy(z => z.Code)
        .ToList();

    IEnumerable<DropDownItem> LevelOptions => ZoneRows()
        .Select(r => r.RackZ)
        .Where(v => !string.IsNullOrWhiteSpace(v))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(LevelSortKey)
        .ThenBy(v => v)
        .Select(v => new DropDownItem($"Level {v}", v!));

    IReadOnlyList<WarehouseRepository.LocationInventoryRow> VisibleInventoryRows =>
        string.IsNullOrWhiteSpace(_mapSearch) ? _scopeInventoryRows : _searchInventoryRows;

    string InventoryScopeLabel => !string.IsNullOrWhiteSpace(_mapSearch)
        ? $"Search: {_mapSearch.Trim()}"
        : _stage switch
        {
            DirectoryStage.Warehouse => "All warehouses",
            DirectoryStage.Area => SelectedWarehouseLabel,
            DirectoryStage.Zone => SelectedAreaLabel,
            _ => $"{SelectedZoneLabel} · Level {Display(_levelCode)}"
        };

    protected override void OnInitialized() => ReloadAll();

    void ReloadAll()
    {
        try
        {
            _warehouses = Wh.ListWarehouses(null, false);
            if (string.IsNullOrWhiteSpace(_selectedWhCode)
                || !_warehouses.Any(w => string.Equals(w.WhCode, _selectedWhCode, StringComparison.OrdinalIgnoreCase)))
            {
                BackToWarehouse();
                return;
            }

            LoadWarehouseData();
            if (_stage is DirectoryStage.Zone or DirectoryStage.Location)
            {
                if (string.IsNullOrWhiteSpace(_selectedAreaCode)
                    || !_areas.Any(a => string.Equals(a.AreaCode, _selectedAreaCode, StringComparison.OrdinalIgnoreCase)))
                {
                    _stage = DirectoryStage.Area;
                    _selectedAreaCode = null;
                    _selectedZoneCode = null;
                }
            }

            if (_stage == DirectoryStage.Location)
                LoadLocations();
            else
                LoadScopeInventory();

            _msg = "";
        }
        catch (Exception ex)
        {
            _warehouses = new();
            _areas = new();
            _allRows = new();
            _rows = new();
            _scopeInventoryRows = new();
            _searchInventoryRows = new();
            ShowError(ex.Message);
        }
    }

    void LoadWarehouseData()
    {
        if (string.IsNullOrWhiteSpace(_selectedWhCode))
        {
            _areas = new();
            _allRows = new();
            return;
        }

        _areas = Wh.ListWarehouseAreas(null, false, _selectedWhCode);
        _allRows = Wh.ListLocationMap(whCode: _selectedWhCode);
    }

    void LoadLocations()
    {
        if (string.IsNullOrWhiteSpace(_selectedWhCode)
            || string.IsNullOrWhiteSpace(_selectedAreaCode)
            || string.IsNullOrWhiteSpace(_selectedZoneCode))
        {
            _rows = new();
            LoadScopeInventory();
            return;
        }

        SetDefaultLevel();
        _rows = Wh.ListLocationMap(_selectedAreaCode, _levelCode, _selectedZoneCode, _selectedWhCode);
        LoadScopeInventory();
    }

    void LoadScopeInventory()
    {
        _scopeInventoryRows = _stage switch
        {
            DirectoryStage.Warehouse => Wh.ListLocationInventory(),
            DirectoryStage.Area => Wh.ListLocationInventory(whCode: _selectedWhCode),
            DirectoryStage.Zone => Wh.ListLocationInventory(whCode: _selectedWhCode, areaCode: _selectedAreaCode),
            _ => Wh.ListLocationInventory(
                whCode: _selectedWhCode,
                areaCode: _selectedAreaCode,
                zoneCode: _selectedZoneCode,
                rackZ: _levelCode)
        };

        if (string.IsNullOrWhiteSpace(_mapSearch))
            _searchInventoryRows = new();
    }

    void SelectWarehouse(string whCode)
    {
        _selectedWhCode = whCode;
        _selectedAreaCode = null;
        _selectedZoneCode = null;
        _levelCode = null;
        _highlightedLocationNo = null;
        _stage = DirectoryStage.Area;
        LoadWarehouseData();
        LoadScopeInventory();
    }

    void SelectArea(string areaCode)
    {
        _selectedAreaCode = areaCode;
        _selectedZoneCode = null;
        _levelCode = null;
        _highlightedLocationNo = null;
        _stage = DirectoryStage.Zone;
        LoadScopeInventory();
    }

    void SelectZone(string zoneCode)
    {
        _selectedZoneCode = zoneCode;
        _levelCode = null;
        _highlightedLocationNo = null;
        _stage = DirectoryStage.Location;
        LoadLocations();
    }

    void SelectLocation(string locationNo) => _highlightedLocationNo = locationNo;

    void Back()
    {
        if (_stage == DirectoryStage.Location) BackToZone();
        else if (_stage == DirectoryStage.Zone) BackToArea();
        else BackToWarehouse();
    }

    void BackToWarehouse()
    {
        _stage = DirectoryStage.Warehouse;
        _selectedWhCode = null;
        _selectedAreaCode = null;
        _selectedZoneCode = null;
        _levelCode = null;
        _highlightedLocationNo = null;
        _areas = new();
        _allRows = new();
        _rows = new();
        LoadScopeInventory();
    }

    void BackToArea()
    {
        if (string.IsNullOrWhiteSpace(_selectedWhCode))
        {
            BackToWarehouse();
            return;
        }

        _stage = DirectoryStage.Area;
        _selectedAreaCode = null;
        _selectedZoneCode = null;
        _levelCode = null;
        _highlightedLocationNo = null;
        _rows = new();
        LoadScopeInventory();
    }

    void BackToZone()
    {
        if (string.IsNullOrWhiteSpace(_selectedAreaCode))
        {
            BackToArea();
            return;
        }

        _stage = DirectoryStage.Zone;
        _selectedZoneCode = null;
        _levelCode = null;
        _highlightedLocationNo = null;
        _rows = new();
        LoadScopeInventory();
    }

    void SearchLocations()
    {
        _mapSearch = _mapSearch?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(_mapSearch))
        {
            LoadScopeInventory();
            return;
        }

        RefreshLocationSearch();
        if (_searchInventoryRows.Count == 0)
        {
            ShowWarning("No inventory location matches this search.");
            return;
        }

        var exactLocation = _searchInventoryRows.FirstOrDefault(r =>
            string.Equals(r.LocationNo, _mapSearch, StringComparison.OrdinalIgnoreCase));
        GoToInventoryLocation(exactLocation ?? _searchInventoryRows[0]);
        _msg = "";
    }

    void RefreshLocationSearch()
    {
        _mapSearch = _mapSearch?.Trim() ?? "";
        _highlightedLocationNo = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_mapSearch))
            {
                _searchInventoryRows = new();
                LoadScopeInventory();
                _msg = "";
                return;
            }

            _searchInventoryRows = Wh.ListLocationInventory(search: _mapSearch);
            _msg = "";
        }
        catch (Exception ex)
        {
            _searchInventoryRows = new();
            ShowError(ex.Message);
        }
    }

    void ClearLocationSearch()
    {
        _mapSearch = "";
        _searchInventoryRows = new();
        _highlightedLocationNo = null;
        LoadScopeInventory();
        _msg = "";
    }

    void GoToInventoryLocation(WarehouseRepository.LocationInventoryRow item)
    {
        if (string.IsNullOrWhiteSpace(item.WhCode)
            || string.IsNullOrWhiteSpace(item.AreaCode)
            || string.IsNullOrWhiteSpace(item.ZoneCode)
            || string.IsNullOrWhiteSpace(item.RackZ))
        {
            ShowWarning("This inventory row does not have a complete location hierarchy.");
            return;
        }

        _selectedWhCode = item.WhCode;
        _selectedAreaCode = item.AreaCode;
        _selectedZoneCode = item.ZoneCode;
        _levelCode = item.RackZ;
        _stage = DirectoryStage.Location;
        LoadWarehouseData();
        LoadLocations();
        _highlightedLocationNo = item.LocationNo;
    }

    int ZoneCount(string areaCode) => _allRows
        .Where(r => string.Equals(r.AreaCode, areaCode, StringComparison.OrdinalIgnoreCase))
        .Select(r => string.IsNullOrWhiteSpace(r.ZoneName) ? "DEFAULT" : r.ZoneName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    List<WarehouseRepository.LocationMapRow> ZoneRows() => _allRows
        .Where(r => string.Equals(r.AreaCode, _selectedAreaCode, StringComparison.OrdinalIgnoreCase)
                 && string.Equals(string.IsNullOrWhiteSpace(r.ZoneName) ? "DEFAULT" : r.ZoneName, _selectedZoneCode, StringComparison.OrdinalIgnoreCase))
        .ToList();

    void SetDefaultLevel()
    {
        var levels = ZoneRows()
            .Select(r => r.RackZ)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(LevelSortKey)
            .ThenBy(v => v)
            .ToList();

        if (levels.Count > 0 && (string.IsNullOrWhiteSpace(_levelCode) || !levels.Contains(_levelCode)))
            _levelCode = levels[0];
    }

    RenderFragment RenderLocationGrid() => __builder =>
    {
        var locations = _rows
            .OrderBy(r => ToNumberOrMax(r.RackY))
            .ThenBy(r => r.RackY)
            .ThenBy(r => ToNumberOrMax(r.RackX))
            .ThenBy(r => r.RackX)
            .ThenBy(r => r.LocationNo)
            .ToList();
        var columns = locations
            .Select(r => AxisText(r.RackX))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(ToNumberOrMax)
            .ThenBy(value => value)
            .ToList();
        var rows = locations
            .Select(r => AxisText(r.RackY))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(ToNumberOrMax)
            .ThenBy(value => value)
            .ToList();

        if (locations.Count == 0)
        {
            <div class="ames-empty">No locations on this level.</div>
        }
        else
        {
            <div class="wh-location-coordinate-scroll">
                <div class="wh-location-coordinate-map" style="@LocationGridStyle(columns.Count)">
                    <div class="wh-grid-corner">Y / X</div>
                    @foreach (var column in columns)
                    {
                        <div class="wh-grid-axis wh-grid-col">@column</div>
                    }

                    @foreach (var row in rows)
                    {
                        <div class="wh-grid-axis wh-grid-row">@row</div>
                        @foreach (var column in columns)
                        {
                            var cells = locations
                                .Where(location => string.Equals(AxisText(location.RackX), column, StringComparison.OrdinalIgnoreCase)
                                                && string.Equals(AxisText(location.RackY), row, StringComparison.OrdinalIgnoreCase))
                                .OrderBy(location => location.LocationNo)
                                .ToList();
                            <div class="wh-grid-slot @(cells.Count == 0 ? "empty" : "")">
                                @if (cells.Count == 0)
                                {
                                    <span class="wh-grid-empty">-</span>
                                }
                                else
                                {
                                    @foreach (var location in cells)
                                    {
                                        <button type="button"
                                                class="wh-location-bin @StatusClass(location.Status) @(IsHighlightedLocation(location.LocationNo) ? "highlighted" : "")"
                                                data-location-no="@location.LocationNo"
                                                @onclick="() => SelectLocation(location.LocationNo)">
                                            <span class="wh-location-bin-code">@location.LocationNo</span>
                                            <span class="wh-location-bin-zone">@((location.ZoneCode ?? location.ZoneName) ?? "-")</span>
                                            <span class="wh-location-bin-qty">@location.TotalQty.ToString("N0")</span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    };

    bool IsHighlightedLocation(string locationNo) =>
        string.Equals(_highlightedLocationNo, locationNo, StringComparison.OrdinalIgnoreCase);

    string BreadcrumbClass(DirectoryStage stage) => _stage == stage ? "on" : "";

    void ShowWarning(string message)
    {
        _msgStyle = AlertStyle.Warning;
        _msg = message;
    }

    void ShowError(string message)
    {
        _msgStyle = AlertStyle.Danger;
        _msg = message;
    }

    static string StatusClass(string status) => status switch
    {
        "Stocked" => "stocked",
        "Mixed" => "mixed",
        _ => "empty",
    };

    static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    static string AxisText(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    static string LocationGridStyle(int columnCount) => $"--wh-cols:{Math.Max(1, columnCount)};min-width:{72 + Math.Max(1, columnCount) * 156}px;";
    static int ToNumberOrMax(string? value) => int.TryParse(value, out var number) ? number : int.MaxValue;
    static int LevelSortKey(string? value) => int.TryParse(value, out var number) ? number : int.MaxValue;
}
