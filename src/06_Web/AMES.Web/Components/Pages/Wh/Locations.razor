    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        _currentUserId =
            user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ??
            user.Identity?.Name ??
            "web";
        _currentUserName =
            user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ??
            user.Identity?.Name ??
            _currentUserId;
        _canModifyLocationMaster = IsAdministratorUser(user, _currentUserId);

        ReloadStage();
    }

    void ReloadStage()
    {
        try
        {
            if (_stage == MasterStage.Warehouse)
            {
                _warehouses = Wh.ListWarehouses(_search, false);
                _areas = new();
                _sections = new();
                _locations = new();
            }
            else if (_stage == MasterStage.Area)
            {
                _areas = Wh.ListWarehouseAreas(_search, false, _selectedWhCode);
                _sections = new();
                _locations = new();
            }
            else if (_stage == MasterStage.Section)
            {
                _sections = Wh.ListWarehouseSections(_selectedAreaCode, _search, false, _selectedWhCode);
                _locations = new();
            }
            else
            {
                _locations = Wh.ListLocations(_search, false, _selectedAreaCode, _selectedSectionCode, _selectedWhCode);
            }
        }
        catch (Exception ex)
        {
            ShowMsg(ex.Message, true);
        }
    }

