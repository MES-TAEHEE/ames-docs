    bool RequireAdministrator()
    {
        if (_canModifyLocationMaster)
            return true;

        ShowMsg("Administrator role is required to change Location Master.", true);
        return false;
    }

    static bool IsAdministratorUser(System.Security.Claims.ClaimsPrincipal user, string currentUserId)
    {
        static bool Same(string? value, string expected) =>
            string.Equals(value?.Trim(), expected, StringComparison.OrdinalIgnoreCase);

        var roleClaims = user.Claims
            .Where(c =>
                Same(c.Type, System.Security.Claims.ClaimTypes.Role) ||
                Same(c.Type, "role") ||
                Same(c.Type, "roles"))
            .Select(c => c.Value);

        if (roleClaims.Any(r =>
            Same(r, "Admin") ||
            Same(r, "Administrator") ||
            Same(r, "Administrators")))
        {
            return true;
        }

        return Same(currentUserId, "admin@ames.local") ||
               Same(user.Identity?.Name, "admin@ames.local") ||
               Same(user.Identity?.Name, "admin") ||
               Same(user.Identity?.Name, "administrator");
    }

    long LogLocationMaster(string action, string refDocType, string refDocNo, string? locationId, string message)
    {
        return Wh.WriteWebOperationLog(
            $"LOCATION_MASTER_{action.ToUpperInvariant()}",
            "WH-001",
            _currentUserId,
            _currentUserName,
            message,
            refDocType,
            refDocNo,
            locationId);
    }

    static string? NE(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    static bool SameText(string? left, string? right) =>
        string.Equals(NE(left), NE(right), StringComparison.OrdinalIgnoreCase);

    string? BuildLocationCode()
    {
        var whCode = NormalizeLocationPart(_locationForm.WhCode);
        var rackX = NormalizeRackAxis(_locationForm.RackX);
        var rackY = NormalizeRackAxis(_locationForm.RackY);
        var rackZ = NormalizeLocationPart(_locationForm.RackZ);

        if (string.IsNullOrWhiteSpace(whCode)
            || string.IsNullOrWhiteSpace(rackX)
            || string.IsNullOrWhiteSpace(rackY)
            || string.IsNullOrWhiteSpace(rackZ))
        {
            return null;
        }

        return $"{whCode}{rackX}{rackY}{rackZ}";
    }

    static string NormalizeLocationPart(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Trim().Replace("-", "").Replace(" ", "").ToUpperInvariant();

    static string NormalizeRackAxis(string? value)
    {
        var normalized = NormalizeLocationPart(value);
        return normalized.Length == 1 && normalized.All(char.IsDigit)
            ? normalized.PadLeft(2, '0')
            : normalized;
    }

