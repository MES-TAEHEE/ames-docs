@page "/wh/locations"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@inject AuthenticationStateProvider AuthProvider
@using Radzen

<PageTitle>WH-001 Location Master · AMES</PageTitle>
<AmesPageHeader Code="WH-001" Title="Location Master" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">Step</div>
        <div class="ames-kpi-v">@StepNo</div>
        <div class="ames-kpi-s">@StepTitle</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">Warehouses</div>
        <div class="ames-kpi-v">@_warehouses.Count</div>
        <div class="ames-kpi-s">warehouse master</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">Areas</div>
        <div class="ames-kpi-v">@_areas.Count</div>
        <div class="ames-kpi-s">selected WH</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">Zones</div>
        <div class="ames-kpi-v">@_sections.Count</div>
        <div class="ames-kpi-s">selected area</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">Locations</div>
        <div class="ames-kpi-v">@_locations.Count</div>
        <div class="ames-kpi-s">selected zone</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

@if (!_canModifyLocationMaster)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
        Location Master changes are available to Administrator users only.
    </RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h wh-master-toolbar">
        <div>
            <span>@StepTitle</span>
            <div class="dim">@StepDescription</div>
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            @if (_stage == MasterStage.Warehouse)
            {
                <RadzenTextBox @bind-Value="_search" Placeholder="Search" InputSize="InputSize.Small" class="ames-rz-input" Style="width:180px;" AutoComplete="false" @onkeydown='e => { if (e.Key == "Enter") ReloadStage(); }' />
                <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ReloadStage" class="ames-rz-btn" />
                @if (_canModifyLocationMaster)
                {
                    <RadzenButton Text="Create WH" Icon="warehouse" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenWarehouseCreate" class="ames-rz-btn" />
                }
            }
            else if (_stage == MasterStage.Area)
            {
                <RadzenButton Text="Back" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@BackToWarehouses" class="ames-rz-btn" />
                <RadzenTextBox @bind-Value="_search" Placeholder="Search" InputSize="InputSize.Small" class="ames-rz-input" Style="width:180px;" AutoComplete="false" @onkeydown='e => { if (e.Key == "Enter") ReloadStage(); }' />
                <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ReloadStage" class="ames-rz-btn" />
                @if (_canModifyLocationMaster)
                {
                    <RadzenButton Text="Create Area" Icon="add_business" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenAreaCreate" class="ames-rz-btn" />
                }
            }
            else if (_stage == MasterStage.Section)
            {
                <RadzenButton Text="Back" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@BackToAreas" class="ames-rz-btn" />
                <RadzenTextBox @bind-Value="_search" Placeholder="Search" InputSize="InputSize.Small" class="ames-rz-input" Style="width:180px;" AutoComplete="false" @onkeydown='e => { if (e.Key == "Enter") ReloadStage(); }' />
                <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ReloadStage" class="ames-rz-btn" />
                @if (_canModifyLocationMaster)
                {
                    <RadzenButton Text="Create Zone" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenSectionCreate" class="ames-rz-btn" />
                }
            }
            else
            {
                <WarehouseLocationStageToolbar Search="@_search"
                                               SearchChanged="@SetSearch"
                                               Back="@BackToSections"
                                               SearchRequested="@ReloadStage"
                                               CreateRequested="@OpenLocationCreate"
                                               CanCreate="@_canModifyLocationMaster"
                                               Locations="@_locations"
                                               Warehouse="@SelectedWarehouseTitle"
                                               Area="@SelectedAreaTitle"
                                               Zone="@SelectedSectionTitle" />
            }
        </RadzenStack>
    </div>

    <div class="wh-map-breadcrumb">
        <button type="button" class="@BreadcrumbClass(MasterStage.Warehouse)" @onclick="@BackToWarehouses">WH</button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(MasterStage.Area)" disabled="@string.IsNullOrWhiteSpace(_selectedWhCode)" @onclick="@BackToAreas">
            @(_selectedWhCode ?? "Area")
        </button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(MasterStage.Section)" disabled="@string.IsNullOrWhiteSpace(_selectedAreaCode)" @onclick="@BackToSections">
            @(_selectedAreaCode ?? "Zone")
        </button>
        <span>/</span>
        <button type="button" class="@BreadcrumbClass(MasterStage.Location)" disabled="@(_stage != MasterStage.Location)">
            @(_selectedSectionCode ?? "Location")
        </button>
    </div>

    @if (_stage == MasterStage.Warehouse)
    {
        <RadzenDataGrid TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseMasterRow"
                        Data="@_warehouses"
                        AllowPaging="true" PageSize="12"
                        AllowSorting="true"
                        RowClick="@(args => { if (args.Data is not null) OpenWarehouse(args.Data); })"
                        EmptyText="No warehouses found."
                        Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseMasterRow" Property="WhCode" Title="WH Code" Width="160px">
                    <Template Context="r"><span class="code">@r.WhCode</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseMasterRow" Property="WhName" Title="WH Name">
                    <Template Context="r">@(r.WhName ?? "-")</Template>
                </RadzenDataGridColumn>
                @if (_canModifyLocationMaster)
                {
                    <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseMasterRow" Title="Setting" Width="105px" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="r">
                            <RadzenButton Icon="settings" Text="" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenWarehouseEdit(r))" @onclick:stopPropagation="true" class="ames-rz-btn" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
    else if (_stage == MasterStage.Area)
    {
        <div class="wh-master-context">
            <span>WH</span><strong>@SelectedWarehouseTitle</strong>
        </div>
        <RadzenDataGrid TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseAreaRow"
                        Data="@_areas"
                        AllowPaging="true" PageSize="12"
                        AllowSorting="true"
                        RowClick="@(args => { if (args.Data is not null) OpenArea(args.Data); })"
                        EmptyText="No areas found."
                        Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseAreaRow" Property="AreaCode" Title="Area Code" Width="160px">
                    <Template Context="r"><span class="code">@r.AreaCode</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseAreaRow" Property="AreaName" Title="Area Name">
                    <Template Context="r">@(r.AreaName ?? "-")</Template>
                </RadzenDataGridColumn>
                @if (_canModifyLocationMaster)
                {
                    <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseAreaRow" Title="Setting" Width="105px" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="r">
                            <RadzenButton Icon="settings" Text="" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenAreaEdit(r))" @onclick:stopPropagation="true" class="ames-rz-btn" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
    else if (_stage == MasterStage.Section)
    {
        <div class="wh-master-context">
            <span>WH</span><strong>@SelectedWarehouseTitle</strong>
            <span>Area</span><strong>@SelectedAreaTitle</strong>
        </div>
        <RadzenDataGrid TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseSectionRow"
                        Data="@_sections"
                        AllowPaging="true" PageSize="12"
                        AllowSorting="true"
                        RowClick="@(args => { if (args.Data is not null) OpenSection(args.Data); })"
                        EmptyText="No zones found."
                        Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseSectionRow" Property="SectionCode" Title="Zone Code" Width="160px">
                    <Template Context="r"><span class="code">@r.SectionCode</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseSectionRow" Property="SectionName" Title="Zone Name">
                    <Template Context="r">@(r.SectionName ?? "-")</Template>
                </RadzenDataGridColumn>
                @if (_canModifyLocationMaster)
                {
                    <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseSectionRow" Title="Setting" Width="105px" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="r">
                            <RadzenButton Icon="settings" Text="" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenSectionEdit(r))" @onclick:stopPropagation="true" class="ames-rz-btn" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
    else
    {
        <div class="wh-master-context">
            <span>WH</span><strong>@SelectedWarehouseTitle</strong>
            <span>Area</span><strong>@SelectedAreaTitle</strong>
            <span>Zone</span><strong>@SelectedSectionTitle</strong>
        </div>
        <RadzenDataGrid TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseLocationRow"
                        Data="@_locations"
                        AllowPaging="true" PageSize="15"
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        ShowPagingSummary="true"
                        AllowSorting="true"
                        RowClick="@(args => { if (_canModifyLocationMaster && args.Data is not null) OpenLocationEdit(args.Data); })"
                        EmptyText="No locations found."
                        Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseLocationRow" Property="LocationNo" Title="Location Code" Width="180px">
                    <Template Context="r"><span class="code">@r.LocationNo</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseLocationRow" Property="LocationName" Title="Location Name">
                    <Template Context="r">@(r.LocationName ?? "-")</Template>
                </RadzenDataGridColumn>
                @if (_canModifyLocationMaster)
                {
                    <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.WarehouseLocationRow" Title="Setting" Width="105px" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="r">
                            <RadzenButton Icon="settings" Text="" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenLocationEdit(r))" @onclick:stopPropagation="true" class="ames-rz-btn" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
</div>

@if (_warehouseModal == "create" || (_warehouseModal == "edit" && _selectedWarehouse is not null))
{
    <div class="ames-modal-bg" @onclick="CloseWarehouseModal">
        <div class="ames-modal wh-master-modal" @onclick:stopPropagation>
            <div class="ames-modal-h">@(_warehouseModal == "create" ? "Create Warehouse" : $"Edit Warehouse - {_selectedWarehouse!.WhCode}")</div>
            <div class="wh-master-form">
                <div>
                    <RadzenLabel Text="WH Code" />
                    <RadzenTextBox @bind-Value="_warehouseForm.WhCode" Disabled="@(_warehouseModal == "edit")" Placeholder="B" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="WH Name" />
                    <RadzenTextBox @bind-Value="_warehouseForm.WhName" Placeholder="Wiley W/H" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <label class="wh-check">
                    <RadzenCheckBox TValue="bool" @bind-Value="_warehouseForm.UseYn" />
                    <span>Active</span>
                </label>
            </div>
            @RenderModalError(_warehouseModalErr)
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                @if (_warehouseModal == "create")
                {
                    <RadzenButton Text="Create" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveWarehouseCreate" Disabled="@_busy" class="ames-rz-btn" />
                }
                else
                {
                    <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveWarehouseEdit" Disabled="@_busy" class="ames-rz-btn" />
                    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveWarehouseDelete" Disabled="@_busy" class="ames-rz-btn" />
                }
                <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseWarehouseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_areaModal == "create" || (_areaModal == "edit" && _selectedArea is not null))
{
    <div class="ames-modal-bg" @onclick="CloseAreaModal">
        <div class="ames-modal wh-master-modal" @onclick:stopPropagation>
            <div class="ames-modal-h">@(_areaModal == "create" ? "Create Area" : $"Edit Area - {_selectedArea!.AreaCode}")</div>
            <div class="wh-master-form">
                <div>
                    <RadzenLabel Text="WH" />
                    <RadzenTextBox Value="@SelectedWarehouseTitle" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Area Code" />
                    <RadzenTextBox @bind-Value="_areaForm.AreaCode" Disabled="@(_areaModal == "edit")" Placeholder="A1" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Area Name" />
                    <RadzenTextBox @bind-Value="_areaForm.AreaName" Placeholder="Raw Material Area" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <label class="wh-check">
                    <RadzenCheckBox TValue="bool" @bind-Value="_areaForm.UseYn" />
                    <span>Active</span>
                </label>
            </div>
            @RenderModalError(_areaModalErr)
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                @if (_areaModal == "create")
                {
                    <RadzenButton Text="Create" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveAreaCreate" Disabled="@_busy" class="ames-rz-btn" />
                }
                else
                {
                    <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveAreaEdit" Disabled="@_busy" class="ames-rz-btn" />
                    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveAreaDelete" Disabled="@_busy" class="ames-rz-btn" />
                }
                <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseAreaModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_sectionModal == "create" || (_sectionModal == "edit" && _selectedSection is not null))
{
    <div class="ames-modal-bg" @onclick="CloseSectionModal">
        <div class="ames-modal wh-master-modal" @onclick:stopPropagation>
            <div class="ames-modal-h">@(_sectionModal == "create" ? "Create Zone" : $"Edit Zone - {_selectedSection!.SectionCode}")</div>
            <div class="wh-master-form">
                <div>
                    <RadzenLabel Text="WH" />
                    <RadzenTextBox Value="@SelectedWarehouseTitle" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Area" />
                    <RadzenTextBox Value="@SelectedAreaTitle" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Zone Code" />
                    <RadzenTextBox @bind-Value="_sectionForm.SectionCode" Disabled="@(_sectionModal == "edit")" Placeholder="RACK-A" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Zone Name" />
                    <RadzenTextBox @bind-Value="_sectionForm.SectionName" Placeholder="Rack Area A" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <label class="wh-check">
                    <RadzenCheckBox TValue="bool" @bind-Value="_sectionForm.UseYn" />
                    <span>Active</span>
                </label>
            </div>
            @RenderModalError(_sectionModalErr)
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                @if (_sectionModal == "create")
                {
                    <RadzenButton Text="Create" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveSectionCreate" Disabled="@_busy" class="ames-rz-btn" />
                }
                else
                {
                    <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveSectionEdit" Disabled="@_busy" class="ames-rz-btn" />
                    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveSectionDelete" Disabled="@_busy" class="ames-rz-btn" />
                }
                <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseSectionModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_locationModal == "create" || (_locationModal == "edit" && _selectedLocation is not null))
{
    <div class="ames-modal-bg" @onclick="CloseLocationModal">
        <div class="ames-modal wh-master-modal" @onclick:stopPropagation>
            <div class="ames-modal-h">@(_locationModal == "create" ? "Create Location" : $"Edit Location - {_selectedLocation!.LocationNo}")</div>
            <div class="wh-master-form wh-master-form-compact">
                <div>
                    <RadzenLabel Text="WH" />
                    <RadzenTextBox Value="@SelectedWarehouseTitle" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Area" />
                    <RadzenTextBox Value="@SelectedAreaTitle" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Zone" />
                    <RadzenTextBox Value="@SelectedSectionTitle" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Location Code" />
                    <RadzenTextBox Value="@DisplayLocationCode" Disabled="true" Placeholder="WH + BANK + BAY + LEVEL" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Location Name" />
                    <RadzenTextBox @bind-Value="_locationForm.LocationName" Placeholder="Rack A 01" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="WH Code" />
                    <RadzenTextBox Value="@(_selectedWhCode ?? _locationForm.WhCode)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="BANK (X)" />
                    <RadzenTextBox @bind-Value="_locationForm.RackX" Disabled="@(_locationModal == "edit")" Placeholder="Z" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="BAY (Y)" />
                    <RadzenTextBox @bind-Value="_locationForm.RackY" Disabled="@(_locationModal == "edit")" Placeholder="02" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="LEVEL (Z)" />
                    <RadzenTextBox @bind-Value="_locationForm.RackZ" Disabled="@(_locationModal == "edit")" Placeholder="E" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <label class="wh-check">
                    <RadzenCheckBox TValue="bool" @bind-Value="_locationForm.UseYn" />
                    <span>Active</span>
                </label>
            </div>
            @RenderModalError(_locationModalErr)
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                @if (_locationModal == "create")
                {
                    <RadzenButton Text="Create" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveLocationCreate" Disabled="@_busy" class="ames-rz-btn" />
                }
                else
                {
                    <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveLocationEdit" Disabled="@_busy" class="ames-rz-btn" />
                    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveLocationDelete" Disabled="@_busy" class="ames-rz-btn" />
                }
                <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseLocationModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    enum MasterStage { Warehouse, Area, Section, Location }

    MasterStage _stage = MasterStage.Warehouse;
    List<AMES.Data.Repositories.WarehouseRepository.WarehouseMasterRow> _warehouses = new();
    List<AMES.Data.Repositories.WarehouseRepository.WarehouseAreaRow> _areas = new();
    List<AMES.Data.Repositories.WarehouseRepository.WarehouseSectionRow> _sections = new();
    List<AMES.Data.Repositories.WarehouseRepository.WarehouseLocationRow> _locations = new();
    AMES.Data.Repositories.WarehouseRepository.WarehouseMasterRow? _selectedWarehouse;
    AMES.Data.Repositories.WarehouseRepository.WarehouseAreaRow? _selectedArea;
    AMES.Data.Repositories.WarehouseRepository.WarehouseSectionRow? _selectedSection;
    AMES.Data.Repositories.WarehouseRepository.WarehouseLocationRow? _selectedLocation;

    string? _selectedWhCode;
    string? _selectedAreaCode;
    string? _selectedSectionCode;
    string _search = "";
    string _msg = "";
    bool _isErr;
    bool _busy;
    bool _canModifyLocationMaster;
    string _currentUserId = "web";
    string _currentUserName = "Web User";

    string _warehouseModal = "";
    string _warehouseModalErr = "";
    WarehouseFormModel _warehouseForm = new();

    string _areaModal = "";
    string _areaModalErr = "";
    AreaFormModel _areaForm = new();

    string _sectionModal = "";
    string _sectionModalErr = "";
    SectionFormModel _sectionForm = new();

    string _locationModal = "";
    string _locationModalErr = "";
    LocationFormModel _locationForm = new();

    int StepNo => _stage switch { MasterStage.Warehouse => 1, MasterStage.Area => 2, MasterStage.Section => 3, _ => 4 };
    string StepTitle => _stage switch
    {
        MasterStage.Warehouse => "WH List",
        MasterStage.Area => "Area List",
        MasterStage.Section => "Zone List",
        _ => "Location List"
    };
    string StepDescription => _stage switch
    {
        MasterStage.Warehouse => "Select a warehouse to manage its areas.",
        MasterStage.Area => "Select an area inside the warehouse.",
        MasterStage.Section => "Select a zone inside the area.",
        _ => "Manage location codes in the selected zone."
    };
    string SelectedWarehouseTitle => _selectedWarehouse is null
        ? (_selectedWhCode ?? "-")
        : $"{_selectedWarehouse.WhCode} - {_selectedWarehouse.WhName ?? _selectedWarehouse.WhCode}";
    string SelectedAreaTitle => _selectedArea is null ? "-" : $"{_selectedArea.AreaCode} - {_selectedArea.AreaName ?? _selectedArea.AreaCode}";
    string SelectedSectionTitle => _selectedSection is null ? "-" : $"{_selectedSection.SectionCode} - {_selectedSection.SectionName ?? _selectedSection.SectionCode}";
