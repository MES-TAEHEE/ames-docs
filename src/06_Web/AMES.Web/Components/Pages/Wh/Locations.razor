        SaveLocation(_selectedLocation.LocationNo, "UPDATE");
    }

    bool PrepareLocationForm()
    {
        _locationModalErr = "";

        _locationForm.WhCode = NormalizeLocationPart(_selectedWhCode ?? _locationForm.WhCode);
        _locationForm.RackX = NormalizeRackAxis(_locationForm.RackX);
        _locationForm.RackY = NormalizeRackAxis(_locationForm.RackY);
        _locationForm.RackZ = NormalizeLocationPart(_locationForm.RackZ);

        if (string.IsNullOrWhiteSpace(_locationForm.WhCode))
        {
            _locationModalErr = "WH Code is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_locationForm.RackX))
        {
            _locationModalErr = "BANK (X) is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_locationForm.RackY))
        {
            _locationModalErr = "BAY (Y) is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_locationForm.RackZ))
        {
            _locationModalErr = "LEVEL (Z) is required.";
            return false;
        }

        var locationNo = BuildLocationCode();
        if (string.IsNullOrWhiteSpace(locationNo))
        {
            _locationModalErr = "Location Code is required.";
            return false;
        }

        if (locationNo.Length > 20)
        {
            _locationModalErr = "Location Code must be 20 characters or less.";
            return false;
        }

        _locationForm.LocationNo = locationNo;
        return true;
    }

    bool ValidateLocationCoordinate(string locationNo)
    {
        var rackX = NE(_locationForm.RackX);
        var rackY = NE(_locationForm.RackY);
        var rackZ = NE(_locationForm.RackZ);

        if (string.IsNullOrWhiteSpace(rackX) || string.IsNullOrWhiteSpace(rackY) || string.IsNullOrWhiteSpace(rackZ))
            return true;

        var rows = Wh.ListLocations(null, false, _selectedAreaCode, _selectedSectionCode, _selectedWhCode);
        var duplicate = rows.FirstOrDefault(r =>
            !string.Equals(r.LocationNo, locationNo, StringComparison.OrdinalIgnoreCase)
            && SameText(r.RackX, rackX)
            && SameText(r.RackY, rackY)
            && SameText(r.RackZ, rackZ));

        if (duplicate is null)
            return true;

        _locationModalErr = $"Column/Row/Level already exists at {duplicate.LocationNo}.";
        return false;
    }

    void SaveLocation(string locationNo, string action)
    {
        if (string.IsNullOrWhiteSpace(_selectedAreaCode) || string.IsNullOrWhiteSpace(_selectedSectionCode)) return;
