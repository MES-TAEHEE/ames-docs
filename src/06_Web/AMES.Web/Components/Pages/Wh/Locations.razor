                NE(_locationForm.LocationName),
                NE(_selectedWhCode ?? _locationForm.WhCode),
                _selectedAreaCode,
                _selectedSectionCode,
                NE(_locationForm.RackX),
                NE(_locationForm.RackY),
                NE(_locationForm.RackZ),
                _locationForm.UseYn);
            var logId = LogLocationMaster(action, "LOCATION", locationNo, locationNo, $"Location {locationNo} saved.");
            CloseLocationModal();
            ReloadStage();
            ShowMsg($"Location {locationNo} saved. Log #{logId}.", false);
