@page "/wh/inventory"
@inject IStringLocalizer<SharedResources> L
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["WH.Inventory.Title"] · AMES</PageTitle>
<AmesPageHeader Code="WH-006" TitleKey="WH.Inventory.Title" />

<InventoryLookup Inventory="_inventory" SearchId="wh-inventory-search" />

@code {
    private readonly List<LocationMapStock> _inventory =
    [
        .. LocationMapDemoData.Create("MATERIAL", "Material Area").Inventory,
        .. LocationMapDemoData.Create("SHIPPING", "Shipping Area", "SHIP-").Inventory,
    ];
}
