@page "/wh/inventory"
@inject IStringLocalizer<SharedResources> L
@inject AMES.Data.Repositories.WarehouseRepository InventoryRepo
@inject MasterDataRepository MD
@inject ScmRepository SCM
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["WH.Inventory.Title"] · AMES</PageTitle>
<AmesPageHeader Code="WH-006" TitleKey="WH.Inventory.Title" />

@if (!string.IsNullOrWhiteSpace(_error))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_error</RadzenAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_requirementsWarning))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">@_requirementsWarning</RadzenAlert>
    }
    <InventoryLookup Inventory="_inventory" ProductionRequirements="_productionRequirements" ShowProductionRequirements="true" ItemVendors="_itemVendors" ItemCodes="_itemCodes" SearchId="wh-inventory-search" AllowLotDefect="true" InventoryChanged="ReloadInventory" />
}

@code {
    private List<LocationMapStock> _inventory = [];
    private string? _error;
    private string? _requirementsWarning;
    private IReadOnlyDictionary<string, decimal>? _productionRequirements;
    private List<ScmRepository.ItemVendorRow> _itemVendors = [];
    private List<MasterDataRepository.CodeItemRow> _itemCodes = [];

    protected override void OnInitialized() => ReloadInventory();

    private void ReloadInventory()
    {
        try
        {
            _error = null;
            var stock = InventoryRepo.ListUnifiedInventory(finishedGoods: false, includeFinishedGoods: true, includeDefects: true)
                .Select(x => new LocationMapStock(
                    x.LocationNo, x.PartNo, x.PartName, x.LotNo, x.Qty, x.Unit,
                    x.WarehouseCode, x.WarehouseName, x.AreaCode, x.AreaName, x.DefectQty, InspectionQty:x.InspectionQty))
                .ToList();
            _inventory = InventorySearchRows.FromMaster(MD.ListItems(), stock);
            _itemVendors = SCM.ListItemVendors();
            _itemCodes = MD.ListCodeItems("ITEM_TYPE").Concat(MD.ListCodeItems("ITEM_CATEGORY")).ToList();
            LoadRequirements();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void LoadRequirements()
    {
        _productionRequirements = null;
        _requirementsWarning = null;
        try
        {
            var result = InventoryRepo.GetRemainingMaterialRequirements();
            _productionRequirements = result.Materials.ToDictionary(x => x.ItemNo, x => x.Required, StringComparer.OrdinalIgnoreCase);
            if (result.SkippedNoBom.Count > 0)
                _requirementsWarning = L["WH.Inventory.RequirementsMissingBom", result.SkippedNoBom.Count];
        }
        catch
        {
            _requirementsWarning = L["WH.Inventory.RequirementsFailed"];
        }
    }
}
