    sealed record SamplePickLine(int Sequence, string PartNo, string PartName, int PickBoxes,
        string LotNo, string SourceLocation, string Destination);
    sealed class SampleRequirement(int sequence, string productionOrder, string pickingOrderNo, DateTime neededAt,
        string lineCode, string lineName, string status, List<SamplePickLine> lines)
    {
        public int Sequence { get; } = sequence;
        public string ProductionOrder { get; } = productionOrder;
        public string PickingOrderNo { get; } = pickingOrderNo;
        public DateTime NeededAt { get; } = neededAt;
        public string LineCode { get; } = lineCode;
        public string LineName { get; } = lineName;
        public string Status { get; set; } = status;
        public List<SamplePickLine> Lines { get; } = lines;
        public int MaterialCount => Lines.Select(x => x.PartNo).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        public int TotalBoxes => Lines.Sum(x => x.PickBoxes);
    }
    sealed class SampleSlip(string slipNo, DateTime requestDate, string lineCode, string lineName, string destination,
        string status, DateTime? printedAt, List<SamplePickLine> lines)
    {
        public string SlipNo { get; } = slipNo;
        public DateTime RequestDate { get; } = requestDate;
        public string LineCode { get; } = lineCode;
        public string LineName { get; } = lineName;
        public string Destination { get; } = destination;
        public string Status { get; set; } = status;
        public DateTime? PrintedAt { get; set; } = printedAt;
        public List<SamplePickLine> Lines { get; } = lines;
        public int MaterialCount => Lines.Select(x => x.PartNo).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        public int TotalBoxes => Lines.Sum(x => x.PickBoxes);
    }
