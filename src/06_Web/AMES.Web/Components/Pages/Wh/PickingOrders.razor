@page "/wh/picking-orders"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using static AMES.Data.Repositories.WarehouseRepository
@inject WarehouseRepository WH
@inject PermissionService Permissions
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>WH-002 Picking Orders · AMES</PageTitle>
<AmesPageHeader Code="WH-002" Title="Picking Orders" />

@if (_error.Length > 0) { <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert> }
<div class="auto-order-page">
    <section class="ames-card wh-pick-list">
        <div class="ames-card-h wh-pick-card-head">
            <span>LINE STOCK · SAFETY STOCK</span>
            <RadzenButton Text="Refresh" Icon="refresh" Click="Load" Size="ButtonSize.Small" class="ames-rz-btn" />
        </div>
        <small>Checked every 10 minutes by the API. Existing open orders are not duplicated.</small>
        <RadzenDataGrid TItem="LineStockRow" Data="_stock" AllowPaging="true" PageSize="10" AllowSorting="true" class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="LineStockRow" Property="LineCode" Title="LINE" Width="80px" />
                <RadzenDataGridColumn TItem="LineStockRow" Property="PartNo" Title="PART NO" Width="170px" />
                <RadzenDataGridColumn TItem="LineStockRow" Property="PartName" Title="PART NAME" />
                <RadzenDataGridColumn TItem="LineStockRow" Property="Qty" Title="LINE QTY (EA)" FormatString="{0:N0}" Width="125px" />
                <RadzenDataGridColumn TItem="LineStockRow" Property="SafetyStock" Title="SAFETY (EA)" FormatString="{0:N0}" Width="120px" />
                <RadzenDataGridColumn TItem="LineStockRow" Property="RequiredQty" Title="REQUIRED (EA)" FormatString="{0:N0}" Width="130px" />
                <RadzenDataGridColumn TItem="LineStockRow" Property="State" Title="STATUS" Width="210px" />
            </Columns>
        </RadzenDataGrid>
    </section>
    <section class="ames-card wh-pick-list">
        <div class="ames-card-h wh-pick-card-head">
            <span>PICKING ORDERS</span>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
                <RadzenTextBox @bind-Value="_search" Placeholder="Search" class="ames-rz-input" />
                <RadzenButton Text="Search" Icon="search" Click="Load" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
        <RadzenDataGrid TItem="PickingSlipHeaderRow" Data="_orders" RowSelect="SelectOrder"
            AllowPaging="true" PageSize="10" AllowSorting="true" class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="PickingSlipHeaderRow" Property="PickSlipNo" Title="PICKING ORDER" />
                <RadzenDataGridColumn TItem="PickingSlipHeaderRow" Property="ReqLocation" Title="LINE" Width="100px" />
                <RadzenDataGridColumn TItem="PickingSlipHeaderRow" Property="ReqDate" Title="DATE" Width="115px" />
                <RadzenDataGridColumn TItem="PickingSlipHeaderRow" Property="LineCount" Title="MATERIALS" Width="100px" />
                <RadzenDataGridColumn TItem="PickingSlipHeaderRow" Property="ReqBoxQty" Title="REQUEST QTY" Width="130px">
                    <Template Context="row">@row.ReqBoxQty.ToString("N0") @row.QuantityUnit</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PickingSlipHeaderRow" Property="PickedQty" Title="PICKED QTY" Width="125px">
                    <Template Context="row">@row.PickedQty.ToString("N0") @row.QuantityUnit</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PickingSlipHeaderRow" Property="Status" Title="STATUS" Width="100px" />
            </Columns>
        </RadzenDataGrid>
    </section>
</div>

@if (_selected is not null)
{
    <section class="ames-card slip-detail-card">
        <div class="ames-card-h wh-pick-card-head">
            <span>@_selected.PickSlipNo · LINE @_selected.ReqLocation</span>
            <RadzenButton Text="Print Barcode" Icon="print" Click="Print" Size="ButtonSize.Small" class="ames-rz-btn" />
        </div>
        <RadzenDataGrid TItem="PickingSlipLineRow" Data="_details" AllowPaging="false" class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="PickingSlipLineRow" Property="SeqNo" Title="NO" Width="60px" />
                <RadzenDataGridColumn TItem="PickingSlipLineRow" Property="PartNo" Title="PART NO" Width="190px" />
                <RadzenDataGridColumn TItem="PickingSlipLineRow" Property="PartName" Title="PART NAME" />
                <RadzenDataGridColumn TItem="PickingSlipLineRow" Property="ReqBoxQty" Title="REQUEST QTY" Width="130px">
                    <Template Context="row">@row.ReqBoxQty.ToString("N0") @row.QuantityUnit</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PickingSlipLineRow" Property="PickedBoxQty" Title="PICKED QTY" Width="125px">
                    <Template Context="row">@row.PickedBoxQty.ToString("N0") @row.QuantityUnit</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PickingSlipLineRow" Title="PICK FROM" Width="240px">
                    <Template Context="row"><span class="pick-source">@SourceText(row)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PickingSlipLineRow" Property="LineCode" Title="DESTINATION" Width="130px" />
            </Columns>
        </RadzenDataGrid>
    </section>
    <div class="wh-slip-print-area">
        <div class="wh-slip-paper">
            <div class="wh-slip-title">WAREHOUSE PICKING ORDER</div>
            <div class="wh-slip-head">
                <div class="wh-slip-meta">
                    <div>REQUEST DATE: @_selected.ReqDate</div>
                    <div>DESTINATION LINE: @_selected.ReqLocation</div>
                </div>
                <div class="wh-slip-barcode-box">
                    <Code128Barcode Value="@_selected.PickSlipNo" Height="60" CssClass="wh-slip-barcode" />
                    <div>@_selected.PickSlipNo</div>
                </div>
            </div>
            <table class="wh-slip-table">
                <colgroup>
                    <col class="slip-col-no" />
                    <col class="slip-col-part" />
                    <col class="slip-col-name" />
                    <col class="slip-col-qty" />
                    <col class="slip-col-lot" />
                    <col class="slip-col-location" />
                    <col class="slip-col-destination" />
                </colgroup>
                <thead><tr><th>NO</th><th>PART NO</th><th>PART NAME</th><th>QTY</th><th>LOT NO</th><th>PICK LOCATION</th><th>DESTINATION</th></tr></thead>
                <tbody>@foreach (var row in _printRows)
                {
                    <tr><td>@row.No</td><td>@row.PartNo</td><td>@row.PartName</td><td class="num">@row.Qty.ToString("N0") EA</td><td>@row.LotNo</td><td>@row.Location</td><td>@row.Destination</td></tr>
                }</tbody>
            </table>
        </div>
    </div>
}

@code {
    List<LineStockRow> _stock = [];
    List<PickingSlipHeaderRow> _orders = [];
    List<PickingSlipLineRow> _details = [];
    List<PickingSlipFifoLotRow> _sources = [];
    List<PrintRow> _printRows = [];
    PickingSlipHeaderRow? _selected;
    string _search = "", _error = "";
    bool _allowed;

    protected override async Task OnInitializedAsync()
    {
        await Permissions.EnsureAsync(Auth);
        _allowed = Permissions.CanOpen("wh/picking-orders");
        if (!_allowed) { Nav.NavigateTo("/unauthorized", replace: true); return; }
        Load();
    }
    void Load()
    {
        if (!_allowed) return;
        _error = "";
        _selected = null;
        _details = [];
        _sources = [];
        _printRows = [];
        try { _stock = WH.ListLineStock(); _orders = WH.ListPickingSlipHeaders(_search); }
        catch { _stock = []; _orders = []; _error = "Unable to load line stock or picking orders. Check the database connection."; }
    }
    void SelectOrder(PickingSlipHeaderRow row)
    {
        _error = "";
        _selected = null;
        try
        {
            _details = WH.ListPickingSlipLines(row.PickSlipNo);
            _sources = WH.ListPickingSlipFifoLots(row.PickSlipNo);
            _printRows = BuildPrintRows();
            _selected = row;
        }
        catch { _details = []; _sources = []; _error = "Unable to load picking order details."; }
    }
    List<PrintRow> BuildPrintRows()
    {
        var result = new List<PrintRow>();
        foreach (var detail in _details)
        {
            var lots = _sources.Where(x => string.Equals(x.PartNo, detail.PartNo, StringComparison.OrdinalIgnoreCase)).ToList();
            if (lots.Count == 0)
                result.Add(new(result.Count + 1, detail.PartNo, detail.PartName, 0, "-", "Stock shortage", detail.LineCode));
            else
                foreach (var lot in lots)
                    result.Add(new(result.Count + 1, detail.PartNo, detail.PartName,
                        lot.Qty, lot.LotNo, lot.LocationNo ?? "Location not assigned", detail.LineCode));
        }
        return result;
    }
    string SourceText(PickingSlipLineRow row)
    {
        var remaining = Math.Max(0, row.ReqBoxQty - row.PickedBoxQty);
        if (remaining == 0) return "Picked";
        var boxes = _sources.Where(x => string.Equals(x.PartNo, row.PartNo, StringComparison.OrdinalIgnoreCase)).ToList();
        var locations = boxes.GroupBy(x => string.IsNullOrWhiteSpace(x.LocationNo) ? "Location not assigned" : x.LocationNo.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => row.QuantityUnit == "EA" ? $"{g.Key} · {g.Sum(x => x.Qty):N0} EA" : $"{g.Key} · {g.Count():N0} BOX").ToList();
        var available = row.QuantityUnit == "EA" ? boxes.Sum(x => x.Qty) : boxes.Count;
        if (available < remaining) locations.Add($"Stock shortage · {remaining - available:N0} {row.QuantityUnit}");
        return string.Join("\n", locations);
    }
    async Task Print()
    {
        if (_selected is null) return;
        SelectOrder(_selected);
        if (_selected is null) return;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("window.print");
    }
    sealed record PrintRow(int No, string? PartNo, string? PartName, decimal Qty, string LotNo, string Location, string? Destination);
}
