@page "/wh/picking-orders"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IJSRuntime JS
@inject AMES.Data.Repositories.MasterDataRepository MD
@using Radzen

<PageTitle>WH-002 Picking Orders · AMES</PageTitle>
<AmesPageHeader Code="WH-002" Title="Picking Orders" />

@if (!string.IsNullOrWhiteSpace(_message))
{
    <RadzenAlert AlertStyle="@(_isError ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_message</RadzenAlert>
}

<div class="sample-banner">
    SAMPLE MODE · Review each line's current material requirement and create a Picking Order when ready.
</div>

<div class="auto-order-page">
    <section class="ames-card wh-pick-list">
        <div class="ames-card-h wh-pick-card-head">
            <span>CURRENT LINE MATERIAL REQUIREMENTS</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem">
                <RadzenDropDown @bind-Value="_lineCode"
                                Data="@_lineOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                Change="@(_ => RefreshAll())"
                                InputSize="InputSize.Small"
                                class="ames-rz-input"
                                Style="width:230px;" />
                <RadzenTextBox @bind-Value="_requirementSearch" Placeholder="Search"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;"
                               AutoComplete="false" @onkeydown='e => { if (e.Key == "Enter") FilterRequirements(); }' />
                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="@RefreshAll" class="ames-rz-btn" />
            </RadzenStack>
        </div>

        <RadzenDataGrid TItem="SampleRequirement" Data="@_visibleRequirements" RowSelect="@SelectRequirement"
                        AllowPaging="false" AllowSorting="true"
                        EmptyText="No current material requirements found." Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="SampleRequirement" Property="LineCode" Title="LINE" Width="110px">
                    <Template Context="r"><span class="code">@r.LineCode</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SampleRequirement" Property="ProductionOrder" Title="PRODUCTION ORDER" Width="180px">
                    <Template Context="r"><span class="code">@r.ProductionOrder</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SampleRequirement" Property="LineName" Title="LINE NAME" />
                <RadzenDataGridColumn TItem="SampleRequirement" Property="NeededAt" Title="NEEDED AT" Width="150px">
                    <Template Context="r">@r.NeededAt.ToString("MM-dd HH:mm")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SampleRequirement" Property="MaterialCount" Title="MATERIALS" Width="100px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="SampleRequirement" Property="TotalBoxes" Title="TOTAL BOX" Width="100px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="SampleRequirement" Property="Status" Title="STATUS" Width="105px" TextAlign="TextAlign.Center">
                    <Template Context="r"><span class="pill @StatusClass(r.Status)">@r.Status</span></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </section>

    @if (_selectedRequirement is not null)
    {
        <section class="ames-card requirement-review-card">
            <div class="ames-card-h wh-pick-card-head">
                <span>REQUIRED MATERIALS · @_selectedRequirement.LineCode · @_selectedRequirement.ProductionOrder</span>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem">
                    <RadzenButton Text="Create Picking Order" Icon="add_task" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                  Click="@CreateSelectedRequirement" Disabled="@(_selectedRequirement.Status != "Ready")" class="ames-rz-btn" />
                    <RadzenButton Text="Not Now" Icon="schedule" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                  Click="@DeferSelectedRequirement" class="ames-rz-btn" />
                </RadzenStack>
            </div>

            <RadzenDataGrid TItem="SamplePickLine" Data="@_selectedRequirement.Lines" AllowPaging="false" AllowSorting="true" Class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="SamplePickLine" Property="Sequence" Title="NO" Width="60px" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="SamplePickLine" Property="PartNo" Title="PART NO" Width="165px">
                        <Template Context="r"><span class="code">@r.PartNo</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SamplePickLine" Property="PartName" Title="PART NAME" />
                    <RadzenDataGridColumn TItem="SamplePickLine" Property="PickBoxes" Title="REQUIRED BOX" Width="115px" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="SamplePickLine" Property="LotNo" Title="LOT NO" Width="165px">
                        <Template Context="r"><span class="code">@r.LotNo</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SamplePickLine" Property="SourceLocation" Title="PICK LOCATION" Width="140px">
                        <Template Context="r"><span class="pill info">@r.SourceLocation</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SamplePickLine" Property="Destination" Title="DESTINATION" Width="150px" />
                </Columns>
            </RadzenDataGrid>
        </section>
    }

    <section class="ames-card wh-pick-list">
        <div class="ames-card-h wh-pick-card-head">
            <span>CREATED PICKING ORDERS</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem">
                <RadzenTextBox @bind-Value="_slipSearch" Placeholder="Search"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;"
                               AutoComplete="false" @onkeydown='e => { if (e.Key == "Enter") FilterSlips(); }' />
                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="@FilterSlips" class="ames-rz-btn" />
            </RadzenStack>
        </div>

        <RadzenDataGrid TItem="SampleSlip" Data="@_visibleSlips" RowSelect="@SelectSlip"
                        AllowPaging="true" PageSize="8" AllowSorting="true"
                        EmptyText="No Picking Orders found." Class="ames-rz-grid wh-pick-slip-grid">
            <Columns>
                <RadzenDataGridColumn TItem="SampleSlip" Property="SlipNo" Title="PICKING ORDER" Width="165px">
                    <Template Context="r"><span class="code">@r.SlipNo</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SampleSlip" Property="LineCode" Title="LINE" Width="90px">
                    <Template Context="r"><span class="code">@r.LineCode</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SampleSlip" Property="LineName" Title="LINE NAME" />
                <RadzenDataGridColumn TItem="SampleSlip" Property="MaterialCount" Title="MATERIALS" Width="100px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="SampleSlip" Property="TotalBoxes" Title="TOTAL BOX" Width="100px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="SampleSlip" Property="Status" Title="STATUS" Width="95px" TextAlign="TextAlign.Center">
                    <Template Context="r"><span class="pill @StatusClass(r.Status)">@r.Status</span></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </section>
</div>

@if (_selectedSlip is not null)
{
    <section class="ames-card slip-detail-card">
        <div class="ames-card-h wh-pick-card-head">
            <span>PICKING ORDER DETAIL · @_selectedSlip.SlipNo</span>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem">
                <RadzenButton Text="Print Barcode" Icon="print" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="@PrintSelectedAsync" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="Close Order" Icon="task_alt" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                              Click="@CloseSelected" Disabled="@(_selectedSlip.Status == "Closed")" class="ames-rz-btn" />
                <RadzenButton Text="Close Preview" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                              Click="@ClearSelection" class="ames-rz-btn" />
            </RadzenStack>
        </div>

        <RadzenDataGrid TItem="SamplePickLine" Data="@_selectedSlip.Lines" AllowPaging="false" AllowSorting="true" Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="SamplePickLine" Property="Sequence" Title="NO" Width="60px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="SamplePickLine" Property="PartNo" Title="PART NO" Width="150px">
                    <Template Context="r"><span class="code">@r.PartNo</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SamplePickLine" Property="PartName" Title="PART NAME" />
                <RadzenDataGridColumn TItem="SamplePickLine" Property="PickBoxes" Title="PICK BOX" Width="100px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="SamplePickLine" Property="LotNo" Title="LOT NO" Width="145px">
                    <Template Context="r"><span class="code">@r.LotNo</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SamplePickLine" Property="SourceLocation" Title="PICK LOCATION" Width="140px">
                    <Template Context="r"><span class="pill info">@r.SourceLocation</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SamplePickLine" Property="Destination" Title="DESTINATION" Width="150px" />
            </Columns>
        </RadzenDataGrid>
    </section>

    <div class="wh-slip-print-area">
        <div class="wh-slip-paper">
            <div class="wh-slip-title">WAREHOUSE PICKING ORDER</div>
            <div class="wh-slip-head">
                <div class="wh-slip-meta">
                    <div><span>REQUEST DATE :</span> @_selectedSlip.RequestDate.ToString("yyyy-MM-dd")</div>
                    <div><span>PRODUCTION LINE :</span> @_selectedSlip.LineCode · @_selectedSlip.LineName</div>
                    <div><span>DESTINATION :</span> @_selectedSlip.Destination</div>
                    <div><span>PRINT DATE :</span> @((_selectedSlip.PrintedAt ?? DbClock.Now).ToString("yyyy-MM-dd HH:mm:ss"))</div>
                </div>
                <div class="wh-slip-barcode-box">
                    <div>PICKING ORDER : @_selectedSlip.SlipNo</div>
                    @{
                        var barcode = BuildBarcode(_selectedSlip.SlipNo);
                    }
                    <svg class="wh-slip-barcode" viewBox="0 0 @barcode.Width 60" preserveAspectRatio="none" role="img" aria-label="Picking Order barcode">
                        @foreach (var bar in barcode.Bars)
                        {
                            <rect x="@bar.X" y="0" width="@bar.Width" height="60"></rect>
                        }
                    </svg>
                </div>
            </div>
            <table class="wh-slip-table">
                <thead>
                    <tr><th>NO</th><th>PART NO</th><th>PART NAME</th><th>PICK BOX</th><th>LOT NO</th><th>PICK LOCATION</th><th>DESTINATION</th></tr>
                </thead>
                <tbody>
                    @foreach (var line in _selectedSlip.Lines)
                    {
                        <tr>
                            <td>@line.Sequence</td><td>@line.PartNo</td><td>@line.PartName</td>
                            <td class="num">@line.PickBoxes</td><td>@line.LotNo</td><td>@line.SourceLocation</td><td>@line.Destination</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    readonly List<OptionItem> _lineOptions =
    [
        new("", "All Production Lines"),
        new("LINE-INJ-01", "LINE-INJ-01 - Injection Line 1 (1800T)"),
        new("LINE-IMG-01", "LINE-IMG-01 - Wrapping Line 1"),
        new("LINE-PNT-01", "LINE-PNT-01 - Painting Line 1")
    ];

    List<SampleRequirement> _allRequirements = [];
    List<SampleRequirement> _visibleRequirements = [];
    List<SampleSlip> _allSlips = [];
    List<SampleSlip> _visibleSlips = [];
    // 라인 표시 순서: 공정 순(사출 → 감싸기 → 도장 → 재작업) → 라인 ID
    Dictionary<string, int> _lineOrder = new(StringComparer.OrdinalIgnoreCase);
    SampleRequirement? _selectedRequirement;
    SampleSlip? _selectedSlip;
    string _lineCode = "";
    string _requirementSearch = "";
    string _slipSearch = "";
    string _message = "";
    bool _isError;
    bool _busy;

    protected override void OnInitialized()
    {
        try { _lineOrder = MD.LineProcessOrder(); } catch { }
        _allRequirements = BuildSampleRequirements();
        _allSlips = BuildSampleSlips();
        RefreshAll();
    }

    void RefreshAll()
    {
        FilterRequirements();
        FilterSlips();
    }

    void FilterRequirements()
    {
        _visibleRequirements = _allRequirements
            .Where(x => string.IsNullOrWhiteSpace(_lineCode) || x.LineCode == _lineCode)
            .Where(x => string.IsNullOrWhiteSpace(_requirementSearch) ||
                        x.ProductionOrder.Contains(_requirementSearch, StringComparison.OrdinalIgnoreCase) ||
                        x.LineCode.Contains(_requirementSearch, StringComparison.OrdinalIgnoreCase) ||
                        x.LineName.Contains(_requirementSearch, StringComparison.OrdinalIgnoreCase) ||
                        x.Lines.Any(line => line.PartNo.Contains(_requirementSearch, StringComparison.OrdinalIgnoreCase) ||
                                            line.PartName.Contains(_requirementSearch, StringComparison.OrdinalIgnoreCase)))
            .GroupBy(x => x.LineCode)
            .Select(group => group.OrderBy(x => x.Sequence).FirstOrDefault(x => x.Status != "Completed"))
            .Where(x => x is not null)
            .Cast<SampleRequirement>()
            .OrderBy(x => AMES.Data.Services.LineOrder.Rank(_lineOrder, x.LineCode)).ThenBy(x => x.LineCode)
            .ToList();
        if (_selectedRequirement is not null && !_visibleRequirements.Contains(_selectedRequirement)) _selectedRequirement = null;
    }

    void FilterSlips()
    {
        _visibleSlips = _allSlips
            .Where(x => string.IsNullOrWhiteSpace(_lineCode) || x.LineCode == _lineCode)
            .Where(x => string.IsNullOrWhiteSpace(_slipSearch) ||
                        x.SlipNo.Contains(_slipSearch, StringComparison.OrdinalIgnoreCase) ||
                        x.LineCode.Contains(_slipSearch, StringComparison.OrdinalIgnoreCase) ||
                        x.LineName.Contains(_slipSearch, StringComparison.OrdinalIgnoreCase) ||
                        x.Lines.Any(line => line.PartNo.Contains(_slipSearch, StringComparison.OrdinalIgnoreCase) ||
                                            line.PartName.Contains(_slipSearch, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(x => AMES.Data.Services.LineOrder.Rank(_lineOrder, x.LineCode)).ThenBy(x => x.LineCode)
            .ThenBy(x => x.SlipNo)
            .ToList();
        if (_selectedSlip is not null && !_visibleSlips.Contains(_selectedSlip)) _selectedSlip = null;
    }

    void SelectRequirement(SampleRequirement requirement)
    {
        _selectedRequirement = requirement;
        _selectedSlip = null;
    }

    void CreateSelectedRequirement()
    {
        if (_selectedRequirement is null || _selectedRequirement.Status != "Ready") return;

        var requirement = _selectedRequirement;
        var slip = new SampleSlip(
            requirement.PickingOrderNo,
            requirement.NeededAt.Date,
            requirement.LineCode,
            requirement.LineName,
            requirement.LineCode,
            "Open",
            null,
            requirement.Lines);
        requirement.Status = "Picking";
        _allSlips.Add(slip);
        _selectedRequirement = null;
        _selectedSlip = slip;
        RefreshAll();
        ShowMessage($"{slip.SlipNo} was created. The next production order will appear after this order is closed.", false);
    }

    void DeferSelectedRequirement()
    {
        if (_selectedRequirement is null) return;
        ShowMessage($"{_selectedRequirement.ProductionOrder} remains in the line queue.", false);
        _selectedRequirement = null;
    }

    void SelectSlip(SampleSlip slip)
    {
        _selectedSlip = slip;
        _selectedRequirement = null;
    }
    void ClearSelection() => _selectedSlip = null;

    void CloseSelected()
    {
        if (_selectedSlip is null) return;
        _selectedSlip.Status = "Closed";
        var requirement = _allRequirements.FirstOrDefault(x => x.PickingOrderNo == _selectedSlip.SlipNo);
        if (requirement is not null)
        {
            requirement.Status = "Completed";
            FilterRequirements();
            _selectedRequirement = _visibleRequirements.FirstOrDefault(x => x.LineCode == requirement.LineCode);
        }
        ShowMessage($"{_selectedSlip.SlipNo} was closed in sample mode.", false);
    }

    async Task PrintSelectedAsync()
    {
        if (_selectedSlip is null || _busy) return;
        _busy = true;
        _selectedSlip.PrintedAt = DbClock.Now;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);
        await JS.InvokeVoidAsync("window.print");
        _busy = false;
    }

    void ShowMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }

    static string StatusClass(string status) => status switch
    {
        "Ready" => "ok",
        "Picking" => "warn",
        "Open" => "ok",
        "Partial" => "warn",
        "Closed" => "mute",
        _ => "ghost"
    };

    static BarcodeImage BuildBarcode(string value)
    {
        var widths = new List<int>();
        foreach (var ch in value)
        {
            var seed = ch;
            for (var bit = 0; bit < 7; bit++) widths.Add(((seed >> bit) & 1) == 1 ? 3 : 1);
            widths.Add(1);
        }

        var bars = new List<BarcodeBar>();
        var x = 8;
        var black = true;
        foreach (var width in widths)
        {
            if (black) bars.Add(new BarcodeBar(x, width));
            x += width;
            black = !black;
        }
        return new BarcodeImage(bars, x + 8);
    }

