@page "/wh/transactions"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WarehouseRepository Wh
@using Radzen

<PageTitle>WH-004 Transaction Logs · AMES</PageTitle>
<AmesPageHeader Code="WH-004" Title="Transaction Logs" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">Logs</div>
        <div class="ames-kpi-v">@_rows.Count</div>
        <div class="ames-kpi-s">current result</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">Inbound</div>
        <div class="ames-kpi-v">@_rows.Count(r => IsType(r, "IN"))</div>
        <div class="ames-kpi-s">stock in</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">Outbound</div>
        <div class="ames-kpi-v">@_rows.Count(r => IsType(r, "OUT"))</div>
        <div class="ames-kpi-s">release pick</div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">Adjust</div>
        <div class="ames-kpi-v">@_rows.Count(r => IsType(r, "ADJ"))</div>
        <div class="ames-kpi-s">inventory changes</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ Warehouse Transactions · @_rows.Count items</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Placeholder="Scan Lot No or Part No"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:210px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") Reload(); }' />
            <RadzenDropDown @bind-Value="_txnType" Data="@_typeOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="All Types"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenDatePicker @bind-Value="_from" DateFormat="yyyy-MM-dd" Placeholder="From"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:135px;" />
            <RadzenDatePicker @bind-Value="_to" DateFormat="yyyy-MM-dd" Placeholder="To"
                              InputSize="InputSize.Small" class="ames-rz-input" Style="width:135px;" />
            <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="Clear" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ClearFilters" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="20"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    EmptyText="No transactions found."
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="TxnTs" Title="Time" Width="170px">
                <Template Context="r">@(r.TxnTs?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="TxnType" Title="Type" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="r"><span class="pill @TypeClass(r.TxnType)">@r.TxnType</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="LotNo" Title="Lot No" Width="150px">
                <Template Context="r"><span class="code">@(r.LotNo ?? "-")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="PartNo" Title="Part No">
                <Template Context="r"><span class="code">@(r.PartNo ?? "-")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="LocationNo" Title="Location" Width="130px">
                <Template Context="r"><span class="pill info">@(r.LocationNo ?? "-")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="Qty" Title="Qty" Width="105px" TextAlign="TextAlign.Right">
                <Template Context="r">@r.Qty.ToString("N3")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="WorkerId" Title="Worker" Width="120px">
                <Template Context="r"><span class="dim">@(r.WorkerId ?? "-")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="ReasonCode" Title="Reason" Width="120px">
                <Template Context="r"><span class="pill ghost">@(r.ReasonCode ?? "-")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="Source" Title="Source" Width="150px">
                <Template Context="r"><span class="dim">@r.Source</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.WarehouseRepository.TransactionLogRow" Property="Note" Title="Note">
                <Template Context="r">@(r.Note ?? "-")</Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    List<AMES.Data.Repositories.WarehouseRepository.TransactionLogRow> _rows = new();
    readonly IEnumerable<int> _pageSizeOptions = new[] { 20, 50, 100, 200 };
    readonly List<DropDownItem> _typeOptions = new()
    {
        new() { Text = "Inbound", Value = "IN" },
        new() { Text = "Outbound", Value = "OUT" },
        new() { Text = "Adjust", Value = "ADJ" },
        new() { Text = "Stock", Value = "STOCK" },
    };

    string _search = "";
    string? _txnType;
    DateTime? _from;
    DateTime? _to;
    string _msg = "";

    public class DropDownItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try
        {
            _rows = Wh.ListTransactions(_search, _txnType, _from?.Date, _to?.Date);
            _msg = "";
        }
        catch (Exception ex)
        {
            _rows = new();
            _msg = ex.Message;
        }
    }

    void ClearFilters()
    {
        _search = "";
        _txnType = null;
        _from = null;
        _to = null;
        Reload();
    }

    static bool IsType(AMES.Data.Repositories.WarehouseRepository.TransactionLogRow row, string type) =>
        row.TxnType.Equals(type, StringComparison.OrdinalIgnoreCase);

    static string TypeClass(string type) => type.ToUpperInvariant() switch
    {
        "IN" => "ok",
        "OUT" => "warn",
        "ADJ" => "bad",
        "STOCK" => "info",
        _ => "ghost",
    };
}
