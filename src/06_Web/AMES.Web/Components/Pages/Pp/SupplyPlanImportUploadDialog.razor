@inject AMES.Data.Repositories.PpRepository Pp
@inject AuthenticationStateProvider AuthPrvd
@inject DialogService Dialog
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS
@using AMES.Data.Services
@using AMES.Data.Services.Srm
@using AMES.Data.Services.Upload
@using AMES.Web.Services

<div style="display:flex;flex-direction:column;gap:6px;min-width:440px;">
    <label>① @L["Col.Customer"]</label>
    <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="Customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                    @bind-Value="_upCustomer" Change="@(_ => RefreshVendorCheck())" Disabled="_busy" AllowClear="true"
                    Placeholder="—" Style="width:100%" />

    <label>② @L["PP.SupplyPlanImport.Upload.File"]</label>
    <InputFile OnChange="OnFile" accept=".xls,.xlsx" disabled="@_busy" />
    <span class="dim" style="font-size:.8em;">@L["PP.SupplyPlanImport.Upload.Hint"]</span>
    <RadzenButton Text="@L["PP.Sample.Btn.PurchaseOrder"].Value" Icon="download" ButtonStyle="ButtonStyle.Secondary"
                  Size="ButtonSize.Small" class="ames-rz-btn" Style="align-self:flex-start;" Click="DownloadSample" />

    <label>③ @L["PP.SupplyPlanImport.Upload.ParseResult"]</label>
    <div style="border:1px solid var(--ames-bd-white-a12);border-radius:6px;padding:12px;font-size:.9em;min-height:56px;">
        @if (_preview is null)
        {
            <span class="dim">@L["PP.SupplyPlanImport.Upload.NoFile"]</span>
        }
        else
        {
            <div>✔ @string.Format(L["PP.SupplyPlanImport.Preview.Summary"].Value,
                _preview.Count, _distinctItems, _minOrderDate, _maxOrderDate)</div>
            @if (!string.IsNullOrEmpty(_vendor))
            {
                <div class="dim" style="margin-top:4px;">@string.Format(L["PP.SupplyPlanImport.Preview.Vendor"].Value, _vendor)</div>
            }
            @if (!string.IsNullOrEmpty(_vendorMsg))
            {
                <div style="margin-top:4px;color:@(_verdict == SrmVendorCheck.Verdict.Mismatch ? "var(--ames-tx-red-400)" : "var(--ames-tx-amber-400)");">@_vendorMsg</div>
            }
            @if (_negSkipped > 0)
            {
                <div style="color:var(--ames-tx-amber-400);margin-top:6px;">
                    ⚠ @string.Format(L["PP.SupplyPlanImport.Preview.NegSkipped"].Value, _negSkipped)
                </div>
            }
            @if (_unmatched.Count > 0)
            {
                <div style="color:var(--ames-tx-red-400);margin-top:6px;">
                    ⚠ @string.Format(L["PP.SupplyPlanImport.Preview.Unmatched"].Value, _unmatched.Count)<br />
                    <span class="dim" style="font-size:.85em;">@string.Join(", ", _unmatched.Take(5))@(_unmatched.Count > 5 ? " …" : "")</span>
                </div>
            }
            @if (_cancelCandidates.Count > 0)
            {
                <div style="margin-top:8px;">
                    <label style="display:flex;gap:6px;align-items:flex-start;">
                        <input type="checkbox" @bind="_cancelMissing" disabled="@_busy" />
                        <span>@string.Format(L["PP.Po.Cancel.Option"].Value, _cancelCandidates.Count)</span>
                    </label>
                    <span class="dim" style="font-size:.85em;">@string.Join(", ", _cancelCandidates.Take(5).Select(c => $"{c.SoNumber}-{c.SoLineNo}"))@(_cancelCandidates.Count > 5 ? " …" : "")</span>
                </div>
            }
        }
    </div>
    <UploadDiffView Diff="_diff" />
    @if (!string.IsNullOrEmpty(_modalErr))
    {
        <div class="ames-alert bad">@_modalErr</div>
    }

    <div class="ames-modal-footer">
        <RadzenButton Text="@L["Btn.Cancel"]" ButtonStyle="ButtonStyle.Light" Disabled="_busy"
                      Click="@(() => Dialog.Close(null))" />
        <RadzenButton Text="@(_busy ? L["Lbl.Loading"].Value : L["PP.SupplyPlanImport.Btn.RunUpload"].Value)"
                      Disabled="@(_busy || _preview is null || string.IsNullOrEmpty(_upCustomer) || _verdict == SrmVendorCheck.Verdict.Mismatch || !HasEffectiveChanges)"
                      Click="DoUpload" />
    </div>
</div>

@code {
    [Parameter] public List<MasterDataRepository.CustomerRow> Customers { get; set; } = new();

    const long MaxBytes = 10 * 1024 * 1024;

    string _upCustomer = "";
    string _modalErr   = "";
    bool   _busy;
    IReadOnlyList<PoListGrid.PoRow>? _preview;
    HashSet<string> _unmatched = new();
    int      _distinctItems;
    int      _negSkipped;
    string   _vendor = "";
    DateTime _minOrderDate, _maxOrderDate;
    string? _fileVendor;
    string   _vendorMsg = "";
    string   _fileName = "";
    SrmVendorCheck.Verdict _verdict = SrmVendorCheck.Verdict.NotConfigured;
    List<PpRepository.CancelCandidate> _cancelCandidates = new();
    bool _cancelMissing;
    UploadDiff? _diff;

    /// <summary>추가·변경이 있거나, 취소 옵션을 켠 채 파일에 없는 라인이 있을 때만 저장할 것이 있다.</summary>
    bool HasEffectiveChanges => _diff is not null && (_diff.Added + _diff.Changed > 0 || (_cancelMissing && _diff.Removed > 0));

    async Task OnFile(InputFileChangeEventArgs e)
    {
        _modalErr = ""; _preview = null; _unmatched = new(); _vendor = ""; _negSkipped = 0; _fileName = e.File.Name;
        _cancelCandidates = new(); _cancelMissing = false; _fileVendor = null; _vendorMsg = "";
        try
        {
            using var ms = new MemoryStream();
            await using (var s = e.File.OpenReadStream(MaxBytes))
                await s.CopyToAsync(ms);
            ms.Position = 0;
            var parsed = PoListParser.Parse(ms);

            // 발주수량 음수 행(반품 등)은 가져오기 대상에서 제외
            _negSkipped = parsed.Count(r => r.OrderQty < 0);
            var rows = parsed.Where(r => r.OrderQty >= 0).ToList();
            if (rows.Count == 0)
                throw new FormatException(L["PP.SupplyPlanImport.Err.AllNegative"].Value);

            var tooLong = rows.FirstOrDefault(r => r.ItemNo.Length > 20 || r.SoNumber.Length > 20);
            if (tooLong is not null)
                throw new FormatException(string.Format(L["PP.SupplyPlanImport.Err.ItemNoLen"].Value,
                    tooLong.SoNumber.Length > 20 ? tooLong.SoNumber : tooLong.ItemNo));

            var found  = Pp.ListExistingItemNos(rows.Select(r => r.ItemNo));
            _unmatched = rows.Where(r => !found.Contains(r.ItemNo)).Select(r => r.ItemNo).ToHashSet();

            _distinctItems = rows.Select(r => r.ItemNo).Distinct().Count();
            var v = rows.FirstOrDefault(r => !string.IsNullOrEmpty(r.VendorName) || !string.IsNullOrEmpty(r.VendorCode));
            _vendor = v is null ? "" : $"{v.VendorName} ({v.VendorCode})".Trim();
            _fileVendor = v?.VendorCode;
            var dates = rows.Where(r => r.OrderDate.HasValue).Select(r => r.OrderDate!.Value).ToList();
            _minOrderDate = dates.Count > 0 ? dates.Min() : default;
            _maxOrderDate = dates.Count > 0 ? dates.Max() : default;
            _preview = rows;
            RefreshVendorCheck();
            RefreshCancelCandidates();
        }
        catch (IOException)        { _modalErr = L["PP.SupplyPlanImport.Err.TooLarge"]; }
        catch (FormatException fx) { _modalErr = $"{L["PP.SupplyPlanImport.Err.Parse"]} — {fx.Message}"; }
        catch (Exception ex)       { _modalErr = ex.Message; }
    }

    /// <summary>파일 업체 코드 ↔ 고객 SRM 설정 VENDCD. 설정이 없으면 대조하지 않고 알린다.</summary>
    void RefreshVendorCheck()
    {
        _vendorMsg = "";
        _verdict = SrmVendorCheck.Verdict.NotConfigured;
        if (string.IsNullOrEmpty(_upCustomer) || _preview is null) return;
        var configured = SrmVendorCheck.ConfiguredVendors(Pp.ListCustomerSrmDescriptions(_upCustomer));
        _verdict = SrmVendorCheck.Judge(_fileVendor, configured);
        _vendorMsg = _verdict switch
        {
            SrmVendorCheck.Verdict.Match => string.Format(L["PP.Upload.Vendor.Match"].Value, _fileVendor),
            SrmVendorCheck.Verdict.Mismatch => string.Format(L["PP.Upload.Vendor.Mismatch"].Value, _fileVendor, string.Join(", ", configured)),
            _ => L["PP.Upload.Vendor.NotConfigured"].Value,
        };
        RefreshCancelCandidates();
        RefreshDiff();
    }

    /// <summary>기존 구매오더(같은 고객·납기 범위)와 파일을 비교한다.</summary>
    void RefreshDiff()
    {
        _diff = null;
        if (string.IsNullOrEmpty(_upCustomer) || _preview is null || _preview.Count == 0) return;
        var dues = _preview.Where(r => r.RequestedDeliveryDate.HasValue).Select(r => DateOnly.FromDateTime(r.RequestedDeliveryDate!.Value)).ToList();
        if (dues.Count == 0) return;
        var existing = Pp.ReadPoSnapshot(_upCustomer, dues.Min(), dues.Max());
        var incoming = _preview.GroupBy(r => UploadDiffRules.PoKey(r.SoNumber, r.SoLineNo), StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => UploadDiffRules.PoValue(g.First().ItemNo, g.Sum(x => x.OrderQty), g.First().RequestedDeliveryDate), StringComparer.Ordinal);
        _diff = UploadDiffRules.Compare(existing, incoming);
    }

    /// <summary>파일의 납기 범위 안에서 이 고객의 미출하 Open·Confirmed 라인 중 파일에 없는 것 = 취소 후보.</summary>
    void RefreshCancelCandidates()
    {
        _cancelCandidates = new();
        _cancelMissing = false;
        if (string.IsNullOrEmpty(_upCustomer) || _preview is null || _preview.Count == 0) return;
        var dues = _preview.Where(r => r.RequestedDeliveryDate.HasValue).Select(r => DateOnly.FromDateTime(r.RequestedDeliveryDate!.Value)).ToList();
        if (dues.Count == 0) return;
        var keys = _preview.Select(r => $"{r.SoNumber}|{r.SoLineNo}").ToHashSet(StringComparer.OrdinalIgnoreCase);
        _cancelCandidates = Pp.ListCancelCandidates(_upCustomer, dues.Min(), dues.Max())
            .Where(c => !keys.Contains($"{c.SoNumber}|{c.SoLineNo}")).ToList();
        _cancelMissing = _cancelCandidates.Count > 0;
    }

    async Task DoUpload()
    {
        if (_preview is null || string.IsNullOrEmpty(_upCustomer)) return;
        if (_verdict == SrmVendorCheck.Verdict.Mismatch) { _modalErr = _vendorMsg; return; }
        _busy = true;
        try
        {
            var auth  = await AuthPrvd.GetAuthenticationStateAsync();
            var actor = AMES.Web.Services.ActorCode.Of(auth.User, "system");
            var rows  = _preview.Select(r => new PpRepository.CustomerOrderImportRow(
                r.SoNumber, r.SoLineNo, r.ItemNo, r.OrderQty, r.ShippedQty,
                r.OrderDate, r.RequestedDeliveryDate)).ToList();

            var (ins, upd) = Pp.UpsertCustomerOrders(_upCustomer, rows, actor);
            int cancelled = 0;
            if (_cancelMissing && _cancelCandidates.Count > 0)
                cancelled = Pp.CancelOrders(_cancelCandidates.Select(c => c.SoId).ToList(), actor);
            var dues = rows.Where(r => r.RequestedDeliveryDate.HasValue).Select(r => DateOnly.FromDateTime(r.RequestedDeliveryDate!.Value)).ToList();
            var batch = "PO" + DbClock.Now.ToString("yyyyMMddHHmmssfff");
            Pp.InsertPoImportBatch(_upCustomer, batch, _fileName,
                dues.Count > 0 ? dues.Min() : null, dues.Count > 0 ? dues.Max() : null,
                rows.Count, rows.Select(r => r.ItemNo).Distinct().Count(), ins, upd, cancelled, actor);
            Dialog.Close(new Result(ins, upd, _upCustomer, _minOrderDate, _maxOrderDate, cancelled));
        }
        catch (Exception ex) { _modalErr = ex.Message; _busy = false; }
    }

    async Task DownloadSample()
    {
        var from = DateOnly.FromDateTime(DbClock.Today).AddDays(1);
        var bytes = SrmSamples.PurchaseOrders(DateOnly.FromDateTime(DbClock.Today), from, 14, SampleVendorFor(_upCustomer));
        await JS.InvokeVoidAsync("amesDownload", $"PurchaseOrder_Sample_{DbClock.Now:yyyyMMdd_HHmmss}.xlsx", Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    string SampleVendorFor(string customerId) =>
        string.IsNullOrEmpty(customerId) ? SrmSamples.SampleVendor
            : SrmVendorCheck.PickVendor(SrmVendorCheck.ConfiguredVendors(Pp.ListCustomerSrmDescriptions(customerId)), SrmSamples.SampleVendor);

    public record Result(int Ins, int Upd, string CustomerId, DateTime From, DateTime To, int Cancelled = 0);
}
