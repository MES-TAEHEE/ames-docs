@page "/pp/mrp"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.PpRepository Pp
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.Mrp.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">PP-005</div>
    <div class="ames-page-t">@L["PP.Mrp.Title"]</div>
    <div class="ames-page-sub">@L["PP.Mrp.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">RUNS</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">WOS LAST RUN</div><div class="ames-kpi-v">@(_rows.FirstOrDefault()?.WosConsidered ?? 0)</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">PRS LAST RUN</div><div class="ames-kpi-v">@(_rows.FirstOrDefault()?.PrsCreated ?? 0)</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">SHORTAGES</div><div class="ames-kpi-v">@(_rows.FirstOrDefault()?.ShortageCount ?? 0)</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h">▼ MRP RUNS</div>
    <p style="margin-bottom:14px;"><button class="ames-btn">▶ Run MRP Now</button></p>
    @if (_rows.Count == 0) { <div class="ames-empty">@L["PP.Mrp.Empty"]</div> }
    else
    {
        <table class="ames-table">
            <thead><tr><th>@L["Col.RunNo"]</th><th>@L["Col.RunAt"]</th><th>@L["Col.Horizon"]</th><th class="num">@L["Col.WOs"]</th><th class="num">@L["Col.PRs"]</th><th class="num">@L["Col.Shortages"]</th><th class="num">@L["Col.Duration"]</th><th>@L["Col.Status"]</th></tr></thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr>
                        <td class="code">@r.MrpRunId</td>
                        <td class="dim">@(r.RunAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                        <td class="dim">@(r.HorizonStart?.ToString("yyyy-MM-dd")) ~ @(r.HorizonEnd?.ToString("yyyy-MM-dd"))</td>
                        <td class="num">@r.WosConsidered</td>
                        <td class="num">@r.PrsCreated</td>
                        <td class="num">@r.ShortageCount</td>
                        <td class="num">@r.DurationMs ms</td>
                        <td>@r.Status</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.PpRepository.MrpRunRow> _rows = new();
    int _page = 0;
    const int _pageSize = 20;
    protected override void OnInitialized() { try { _rows = Pp.ListMrpRuns(); } catch { } }
}
