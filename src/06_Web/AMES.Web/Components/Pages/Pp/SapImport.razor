@page "/pp/sap-import"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.PpRepository Pp
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.SapImport.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">PP-002</div>
    <div class="ames-page-t">@L["PP.SapImport.Title"]</div>
    <div class="ames-page-sub">@L["PP.SapImport.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">IMPORTED</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">SHIPPED</div><div class="ames-kpi-v">@_rows.Count(r => r.Status == "Shipped")</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">OPEN</div><div class="ames-kpi-v">@_rows.Count(r => r.Status == "Open")</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">TOTAL QTY</div><div class="ames-kpi-v">@_rows.Sum(r => r.OrderQty).ToString("0")</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h">▼ SAP ORDERS</div>
    @if (_rows.Count == 0) { <div class="ames-empty">@L["PP.SapImport.Empty"]</div> }
    else
    {
        <table class="ames-table">
            <thead><tr><th>@L["Col.SoNo"]</th><th>@L["Col.Line"]</th><th>@L["Col.Customer"]</th><th>@L["Col.Item"]</th><th class="num">@L["Col.Order"]</th><th class="num">@L["Col.Ship"]</th><th>@L["Col.Requested"]</th><th>@L["Col.Promised"]</th><th>@L["Col.Status"]</th></tr></thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr>
                        <td class="code">@r.SoNumber</td>
                        <td class="dim">@r.SoLineNo</td>
                        <td>@r.CustomerId</td>
                        <td>@(r.ItemName ?? r.ItemNo)</td>
                        <td class="num">@r.OrderQty.ToString("0")</td>
                        <td class="num">@r.ShippedQty.ToString("0")</td>
                        <td class="dim">@(r.RequestedDeliveryDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="dim">@(r.PromisedDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@r.Status</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.PpRepository.SoRow> _rows = new();
    int _page = 0;
    const int _pageSize = 20;
    protected override void OnInitialized() { try { _rows = Pp.ListSapImports(); } catch { } }
}
