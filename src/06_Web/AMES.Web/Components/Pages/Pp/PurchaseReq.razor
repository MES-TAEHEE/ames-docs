@page "/pp/purchase-req"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using Radzen

@attribute [Authorize]

@inject PpRepository Pp
@inject MasterDataRepository MD
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>PP-006 @L["PP.PurchaseReq.Title"] · AMES</PageTitle>
<AmesPageHeader Code="PP-006" TitleKey="PP.PurchaseReq.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allRows.Count</div>
            <div class="ames-kpi-s">@string.Format(L["PP.PurchaseReq.Kpi.TotalSub"].Value, _topN)</div>
        </div>
    </div>
    <div class="ames-kpi @(PendingCount > 0 ? "warn" : "")">
        <div class="ames-kpi-l">@L["PP.PurchaseReq.Kpi.Pending"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@PendingCount</div>
            <div class="ames-kpi-s">Draft · Pending</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["PP.PurchaseReq.Kpi.Approved"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Approved")</div>
            <div class="ames-kpi-s">Approved</div>
        </div>
    </div>
    <div class="ames-kpi info">
        <div class="ames-kpi-l">@L["PP.PurchaseReq.Kpi.Sent"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_allRows.Count(IsSent)</div>
            <div class="ames-kpi-s">@L["PP.PurchaseReq.Kpi.SentSub"]</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.PurchaseReq.Title"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@(v => _fSearch = v ?? "")" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["PP.PurchaseReq.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:220px;" />
            <RadzenLabel Text="@L["Col.Vendor"]" Component="DropDownVendor" />
            <RadzenDropDown Name="DropDownVendor" @bind-Value="_fVendor" Data="@VendorFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" AllowFiltering="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.SapPo"]" Component="DropDownSap" />
            <RadzenDropDown Name="DropDownSap" @bind-Value="_fSap" Data="@SapFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenLabel Text="@L["Lbl.Recent"]" Component="DropDownTopN" />
            <RadzenDropDown Name="DropDownTopN" @bind-Value="_topN" Data="@TopNOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Search" class="ames-rz-btn" />
            <RadzenButton Text="@L["PP.PurchaseReq.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@ExportXlsx" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <div class="dim" style="font-size:10px;padding:0 0 6px;">@L["PP.PurchaseReq.Hint.Detail"]</div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="PpRepository.PrRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["PP.PurchaseReq.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="PrNumber" Title="@L["Col.PrNo"]" TextAlign="TextAlign.Center" Width="140px">
                <Template Context="r"><span class="code">@PrNo(r)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="ItemNo" Title="@L["Col.ItemNo"]" TextAlign="TextAlign.Center" Width="130px">
                <Template Context="r"><span class="code">@r.ItemNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="ItemName" Title="@L["Col.ItemName"]">
                <Template Context="r"><span style="white-space:nowrap;">@(r.ItemName ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="VendorId" Title="@L["Col.Vendor"]" Width="180px">
                <Template Context="r"><span style="white-space:nowrap;">@VendorText(r.VendorId)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="RequiredQty" Title="@L["Col.Qty"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r">@r.RequiredQty.ToString("N0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="RequiredDate" Title="@L["Col.Required"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="dim">@(r.RequiredDate?.ToString(DateFmt.Date) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Title="D-Day" TextAlign="TextAlign.Center" Width="80px" Sortable="false">
                <Template Context="r"><span class="pill @DdCls(r)">@DdText(r)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="pill @StCls(r.Status)">@(r.Status ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="WoNumber" Title="@L["Col.WoNo"]" TextAlign="TextAlign.Center" Width="140px">
                <Template Context="r"><span class="code dim">@(r.WoNumber ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PrRow" Property="SapPoNumber" Title="@L["Col.SapPo"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r">
                    @if (IsSent(r)) { <span class="pill info">@r.SapPoNumber</span> } else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Detail Modal (읽기 전용) ─────────────────────────────────────── *@
@if (_modal == "detail" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["PP.PurchaseReq.Title"] <span class="dim" style="font-weight:400;font-size:.9em;">@PrNo(_sel)</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.Item"]" class="ames-rz-modal-label" Component="DetailTextBoxItem" />
                <RadzenTextBox Name="DetailTextBoxItem" Value="@($"[{_sel.ItemNo}] {_sel.ItemName}".Trim())" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Vendor"]" />
                    <RadzenTextBox Value="@VendorText(_sel.VendorId)" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["Col.Qty"]" />
                    <RadzenTextBox Value="@_sel.RequiredQty.ToString("N0")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <div style="padding-top:4px;"><span class="pill @StCls(_sel.Status)">@(_sel.Status ?? "—")</span></div>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["Col.Required"]" />
                    <RadzenTextBox Value="@(_sel.RequiredDate?.ToString(DateFmt.Date) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="D-Day" />
                    <div style="padding-top:4px;"><span class="pill @DdCls(_sel)">@DdText(_sel)</span></div>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["Col.WoNo"]" />
                    <RadzenTextBox Value="@(_sel.WoNumber ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["Col.SapPo"]" />
                    <RadzenTextBox Value="@(_sel.SapPoNumber ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["PP.PurchaseReq.Col.CreatedBy"]" />
                    <RadzenTextBox Value="@(_sel.CreatedBy ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["PP.PurchaseReq.Col.CreatedAt"]" />
                    <RadzenTextBox Value="@(_sel.CreatedTs?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["PP.PurchaseReq.Col.ApprovedBy"]" />
                    <RadzenTextBox Value="@(_sel.ApprovedBy ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="@L["PP.PurchaseReq.Col.ApprovedAt"]" />
                    <RadzenTextBox Value="@(_sel.ApprovedAt?.ToString(DateFmt.DateTime) ?? "")" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@L["Btn.Close"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    bool _showPagerSummary = true;
    List<PpRepository.PrRow>               _allRows = new();
    List<PpRepository.PrRow>               _rows    = new();
    List<MasterDataRepository.VendorRow>   _vendors = new();
    PpRepository.PrRow? _sel;

    string  _fSearch = "";
    string? _fVendor, _fStatus, _fSap;
    int     _topN = 100;
    string  _modal = "", _msg = "";
    bool    _bgMouseDownOnSelf, _isErr;

    // PR 상태는 공통코드가 없어 고정 목록 ∪ 데이터값
    static readonly string[] StatusCodes = { "Draft", "Pending", "Approved", "Rejected" };
    static readonly int[]    TopNs       = { 50, 100, 200, 500 };

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    public class TopNItem     { public string Text { get; set; } = ""; public int Value { get; set; } }

    // 공급업체 콤보: 벤더 마스터 ∪ 데이터에만 있는 코드
    IEnumerable<DropDownItem> VendorFilterOptions =>
        _vendors.Select(v => new DropDownItem { Value = v.VendorID, Text = VendorText(v.VendorID) })
        .Concat(_allRows.Select(r => r.VendorId).Where(v => v is { Length: > 0 } && !_vendors.Any(x => x.VendorID == v)).Distinct().Select(v => new DropDownItem { Value = v!, Text = $"[{v}]" }));
    IEnumerable<DropDownItem> StatusFilterOptions =>
        StatusCodes.Concat(_allRows.Select(r => r.Status).Where(s => s is { Length: > 0 } && !StatusCodes.Contains(s)).Distinct()!)
                   .Select(s => new DropDownItem { Value = s!, Text = s! });
    IEnumerable<DropDownItem> SapFilterOptions => new[]
    {
        new DropDownItem { Value = "SENT",    Text = L["PP.PurchaseReq.Sap.Sent"] },
        new DropDownItem { Value = "NOTSENT", Text = L["PP.PurchaseReq.Sap.NotSent"] },
    };
    IEnumerable<TopNItem> TopNOptions => TopNs.Select(n => new TopNItem { Value = n, Text = $"{n}{L["Lbl.Items"]}" });

    int PendingCount => _allRows.Count(r => IsPending(r.Status));

    protected override void OnInitialized()
    {
        try { _vendors = MD.ListVendors(); } catch { }
        Reload();
    }

    RadzenDataGrid<PpRepository.PrRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task Search()
    {
        _pgIndex = 0;
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null) await _pgGrid.GoToPage(0);
    }

    void Reload()
    {
        try { _allRows = Pp.ListPurchaseRequests(_topN); }
        catch (Exception ex) { _allRows = new(); ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); }
        ApplyFilter();
    }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            PrNo(r).Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            r.ItemNo.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.WoNumber ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.SapPoNumber ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fVendor) || r.VendorId == _fVendor) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status   == _fStatus) &&
        (string.IsNullOrEmpty(_fSap)    || (_fSap == "SENT") == IsSent(r))
    ).ToList();
    }

    async Task OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Search(); }

    void RowRender(RowRenderEventArgs<PpRepository.PrRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<PpRepository.PrRow> args)
    {
        if (args.Data is not null) { _sel = args.Data; _modal = "detail"; }
    }

    void CloseModal() { _modal = ""; _sel = null; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    // 현재 조회 결과(필터 적용분)를 .xlsx 로 내려받는다 — 화면 컬럼 순서 그대로
    async Task ExportXlsx()
    {
        if (_rows.Count == 0) { ShowMsg(L["PP.PurchaseReq.Err.NoExport"], true); return; }

        var headers = new[]
        {
            L["Col.PrNo"].Value, L["Col.ItemNo"].Value, L["Col.ItemName"].Value, L["Col.Vendor"].Value,
            L["Col.Qty"].Value, L["Col.Required"].Value, "D-Day", L["Col.Status"].Value,
            L["Col.WoNo"].Value, L["Col.SapPo"].Value,
            L["PP.PurchaseReq.Col.CreatedBy"].Value, L["PP.PurchaseReq.Col.CreatedAt"].Value,
            L["PP.PurchaseReq.Col.ApprovedBy"].Value, L["PP.PurchaseReq.Col.ApprovedAt"].Value,
        };
        var data = _rows.Select(r => (IReadOnlyList<object?>)new object?[]
        {
            PrNo(r), r.ItemNo, r.ItemName, VendorText(r.VendorId),
            r.RequiredQty, r.RequiredDate?.ToString(DateFmt.Date), DdText(r), r.Status,
            r.WoNumber, r.SapPoNumber,
            r.CreatedBy, r.CreatedTs?.ToString(DateFmt.DateTime),
            r.ApprovedBy, r.ApprovedAt?.ToString(DateFmt.DateTime),
        });

        var bytes = AMES.Web.Services.XlsxWriter.Build(L["PP.PurchaseReq.Title"].Value, headers, data);
        var name  = $"PurchaseReq_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["PP.PurchaseReq.Ok.Exported"].Value, _rows.Count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    // ── 표시 헬퍼 ─────────────────────────────────────────────────────
    static string PrNo(PpRepository.PrRow r) => r.PrNumber ?? $"PR#{r.PrId}";

    string VendorText(string? id) =>
        id is null ? "—" : _vendors.FirstOrDefault(v => v.VendorID == id)?.VendorName is { Length: > 0 } n ? $"[{id}] {n}" : $"[{id}]";

    static bool IsPending(string? s) => s is "Draft" or "Pending";
    static bool IsSent(PpRepository.PrRow r) => !string.IsNullOrEmpty(r.SapPoNumber);

    static string StCls(string? s) => s switch
    {
        "Draft" or "Pending" => "warn",
        "Approved"           => "ok",
        "Rejected"           => "bad",
        _                    => "mute",
    };

    // D-Day 는 소요일 기준, 승인·전송이 끝난 건도 납품 기한 관리가 필요하므로 상태와 무관하게 보여준다
    static int? DaysToReq(PpRepository.PrRow r) => r.RequiredDate is { } d ? (d.Date - DateTime.Today).Days : null;
    static string DdCls(PpRepository.PrRow r)  => DaysToReq(r) is not int d ? "mute" : d < 0 ? "bad" : d <= 3 ? "warn" : "ok";
    static string DdText(PpRepository.PrRow r) => DaysToReq(r) is not int d ? "—" : d < 0 ? $"D+{-d}" : d == 0 ? "D-Day" : $"D-{d}";
}
