@page "/pp/plan-confirm"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.PpRepository Pp
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Web.Services.PermissionService PermSvc
@inject AuthenticationStateProvider AuthPrvd
@inject NavigationManager Nav
@inject DialogService Dialog
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.PlanConfirm.Title"] · AMES</PageTitle>

<AmesPageHeader Code="PP-003" TitleKey="PP.PlanConfirm.Title" />

<div class="ames-page-fill">
@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat" AllowClose="false">@_msg</RadzenAlert>
}

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">PLAN LINES</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">SELECTED</div><div class="ames-kpi-v">@_selected.Count</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">WO CREATED</div><div class="ames-kpi-v">@_woCreated</div></div>
    <div class="ames-kpi @(BlockedCount > 0 ? "bad" : "")"><div class="ames-kpi-l">BLOCKED</div><div class="ames-kpi-v">@BlockedCount</div></div>
</div>

<div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.PlanConfirm.Title"] · @_view.Count @L["Lbl.Items"]@(_view.Count < _rows.Count ? $" / {L["Lbl.TotalOf"]} {_rows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_fCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text='@($"{L["PP.PlanConfirm.Col.Due"]} {L["PP.Forecast.Fld.Period"]}")' />
            <RadzenDatePicker @bind-Value="_fFrom" DateFormat="MM/dd/yyyy" AllowClear="true"
                              Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker @bind-Value="_fTo" DateFormat="MM/dd/yyyy" AllowClear="true"
                              Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <RadzenLabel Text='@($"{L["Col.SoNo"]} / {L["Col.PartNo"]}")' />
            <RadzenTextBox @bind-Value="_fText" @bind-Value:after="ApplyFilters"
                           Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />

            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="Search" />
            <RadzenButton Text="@L["Btn.Reset"].Value" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn" Click="Reset" />
            @if (_canEdit)
            {
                <RadzenButton Text="@string.Format(L["PP.PlanConfirm.Btn.Batch"].Value, _selected.Count)"
                              Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" class="ames-rz-btn"
                              Disabled="@(_selected.Count == 0)" Click="OpenBatch" />
            }
        </RadzenStack>
    </div>

<div class="ames-grid-virtual">
@if (_rows.Count == 0)
{
    <div class="ames-empty">@L["PP.PlanConfirm.Empty"]</div>
}
else
{
    <RadzenDataGrid Data="_view" TItem="PpRepository.PlanLineRow" AllowVirtualization="true" Style="height:100%"
                    AllowSorting="true" AllowColumnResize="true" Density="Density.Compact"
                    class="ames-rz-grid">
        <Columns>
            @* 선택은 WO 일괄 생성에만 쓰이므로 E 권한이 없으면 열 자체를 내린다 *@
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Width="46px" Sortable="false" Visible="@_canEdit"
                                  Filterable="false" TextAlign="TextAlign.Center" Frozen="true">
                <HeaderTemplate>
                    <input type="checkbox" class="pc-ck" checked="@AllSelected"
                           @onchange="e => ToggleAll((bool)(e.Value ?? false))" />
                </HeaderTemplate>
                <Template Context="r">
                    <input type="checkbox" class="pc-ck" disabled="@r.Blocked"
                           checked="@_selected.Contains(r.SoId)"
                           @onchange="e => ToggleRow(r.SoId, (bool)(e.Value ?? false))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="SoNumber" Title="@L["Col.SoNo"].Value"
                                  Frozen="true" Width="150px">
                <Template Context="r">
                    <span class="code">@r.SoNumber</span>@if (r.SoLineNo is int ln) { <span class="dim">-@ln</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="CustomerId" Title="@L["Col.Customer"].Value" Width="120px" />
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="ItemNo" Title="@L["Col.PartNo"].Value" Width="240px">
                <Template Context="r">
                    <span class="code">@r.ItemNo</span>
                    @if (!r.ItemExists)
                    {
                        <span class="badge-bad">@L["PP.Forecast.Badge.Unregistered"]</span>
                    }
                    @if (!string.IsNullOrEmpty(r.ItemName)) { <span class="dim"> · @r.ItemName</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="OrderQty" Title="@L["Col.Order"].Value"
                                  TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@r.OrderQty.ToString("#,0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="IssuedQty" Title="@L["PP.PlanConfirm.Col.Issued"].Value"
                                  TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">
                    @if (r.IssuedQty > 0) { <span style="color:#fbbf24;">@r.IssuedQty.ToString("#,0")</span> } else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="FgOnHand" Title="@L["PP.PlanConfirm.Col.FgStock"].Value"
                                  TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r"><span style="color:#86efac;">@r.FgOnHand.ToString("#,0")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="NetReq" Title="@L["PP.PlanConfirm.Col.NetReq"].Value"
                                  TextAlign="TextAlign.Right" Width="110px">
                <Template Context="r">
                    <span style="font-weight:700;color:@(r.Blocked ? "#f87171" : "#93c5fd");">@r.NetReq.ToString("#,0")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="LineLoadPct" Title="@L["PP.PlanConfirm.Col.LineLoad"].Value"
                                  Filterable="false" Width="170px">
                <Template Context="r">
                    @if (r.LineLoadPct is int pct)
                    {
                        <span class="pc-bar"><i style="width:@(Math.Min(pct, 100))%;background:@LoadColor(pct);"></i></span>
                        <span class="code" style="margin-left:6px;">@pct%</span>
                        @if (!string.IsNullOrEmpty(r.LineId)) { <span class="dim" style="font-size:.85em;margin-left:4px;">@r.LineId</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Property="DueDate" Title="@L["PP.PlanConfirm.Col.Due"].Value" Width="120px">
                <Template Context="r">
                    @if (r.DueDate is DateTime d)
                    {
                        <span style="@(IsUrgent(d) ? "color:#f87171;font-weight:600;" : "")">@d.ToString("yyyy-MM-dd")</span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" Title="@L["Col.Status"].Value"
                                  Sortable="false" Filterable="false" Width="150px">
                <Template Context="r">
                    @if (r.Blocked)
                    {
                        <span class="pill bad">@L[r.NoRouting ? "PP.PlanConfirm.Status.NoRouting" : "PP.PlanConfirm.Status.Blocked"]</span>
                    }
                    else if (r.IssuedQty > 0)
                    {
                        <span class="pill warn" title="@($"{r.IssuedQty:#,0} / {r.OrderQty:#,0}")">@L["PP.PlanConfirm.Status.Partial"]</span>
                    }
                    else
                    {
                        <span class="pill info">@L["PP.PlanConfirm.Status.Pending"]</span>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
</div>
</div>
</div>

@code {
    List<MasterDataRepository.CustomerRow> _customers = new();

    string    _fCustomer = "";
    string    _fText     = "";
    DateTime? _fFrom;
    DateTime? _fTo;

    List<PpRepository.PlanLineRow> _rows = new();   // 조회 결과
    List<PpRepository.PlanLineRow> _view = new();   // 텍스트 필터 적용 표시용
    HashSet<int> _selected = new();
    int _woCreated;

    string _msg = "";
    bool   _isErr;

    int BlockedCount => _rows.Count(r => r.Blocked);
    IEnumerable<PpRepository.PlanLineRow> Selectable => _view.Where(r => !r.Blocked);
    bool AllSelected => Selectable.Any() && Selectable.All(r => _selected.Contains(r.SoId));

    // 권한 키(SYS_Screen.HRef) — R = 화면 조회, E = WO 일괄 생성
    const string Href = "pp/plan-confirm";
    bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        // 메뉴에서 숨겨도 주소를 직접 치면 열리므로 읽기 권한은 화면에서도 확인한다
        if (!PermSvc.IsVisible(Href)) { Nav.NavigateTo("/unauthorized", replace: true); return; }
        _canEdit = PermSvc.CanEdit(Href);

        try { _customers = MD.ListCustomers(); } catch { }
        Search();
    }

    void Search()
    {
        try   { _rows = Pp.ListPlanCandidates(_fCustomer ?? "", _fFrom, _fTo); }
        catch (Exception ex) { ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); _rows = new(); }
        _selected.RemoveWhere(id => _rows.All(r => r.SoId != id));
        ApplyFilters();
    }

    // SO 번호 / 품번·품명 부분일치 클라이언트 필터.
    void ApplyFilters()
    {
        _view = string.IsNullOrWhiteSpace(_fText)
            ? _rows
            : _rows.Where(r =>
                  (r.SoNumber?.Contains(_fText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                  r.ItemNo.Contains(_fText, StringComparison.OrdinalIgnoreCase) ||
                  (r.ItemName?.Contains(_fText, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();
    }

    void Reset()
    {
        _fCustomer = ""; _fText = ""; _fFrom = null; _fTo = null;
        Search();
    }

    void ToggleRow(int soId, bool on)
    {
        if (on) _selected.Add(soId); else _selected.Remove(soId);
    }

    void ToggleAll(bool on)
    {
        foreach (var r in Selectable)
            if (on) _selected.Add(r.SoId); else _selected.Remove(r.SoId);
    }

    static bool IsUrgent(DateTime d) => (d.Date - DbClock.Today).Days <= 14;

    // 라인 부하 색: >90 과부하(빨강) · 70~90 주의(주황) · <70 여유(초록)
    static string LoadColor(int p) => p > 90 ? "#f87171" : p >= 70 ? "#fbbf24" : "#4ade80";

    async Task OpenBatch()
    {
        if (!_canEdit) return;   // 버튼을 숨겨도 핸들러에서 한 번 더 막는다

        var lines = _rows.Where(r => _selected.Contains(r.SoId) && !r.Blocked).ToList();
        if (lines.Count == 0) { ShowMsg(L["PP.PlanConfirm.Err.NoneSelected"], true); return; }

        var result = await Dialog.OpenAsync<PlanConfirmBatchDialog>(
            L["PP.PlanConfirm.Dlg.Title"].Value,
            new Dictionary<string, object?> { ["Lines"] = lines },
            new DialogOptions { Width = "1000px" });

        if (result is PlanConfirmBatchDialog.Result r)
        {
            _woCreated += r.Created;
            _selected.Clear();
            var msg = string.Format(L["PP.PlanConfirm.Ok.Scheduled"].Value, r.Created, r.Late, r.Short);
            if (r.Rejected > 0) msg += " · " + string.Format(L["PP.PlanConfirm.Ok.Rejected"].Value, r.Rejected);
            ShowMsg(msg, r.Short > 0 || r.Rejected > 0);
            Search();
        }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
