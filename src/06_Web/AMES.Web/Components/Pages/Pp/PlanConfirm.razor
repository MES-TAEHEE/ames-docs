@page "/pp/plan-confirm"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.PpRepository Pp
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.PlanConfirm.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">PP-03</div>
    <div class="ames-page-t">@L["PP.PlanConfirm.Title"]</div>
    <div class="ames-page-sub">@L["PP.PlanConfirm.Sub"]</div>
</div>

<div class="ames-card">
    <div class="ames-card-h">▼ @L["PP.PlanConfirm.List"] (@_rows.Count)</div>
    @if (_rows.Count == 0) { <div class="ames-empty">@L["PP.PlanConfirm.Empty"]</div> }
    else
    {
        <table class="ames-table">
            <thead><tr><th>Code</th><th>Period</th><th>Status</th><th class="num">Lines</th><th class="num">Total Qty</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td class="code">@r.PlanCode</td>
                        <td>@(r.PlanPeriod?.ToString("yyyy-MM") ?? "—")</td>
                        <td>@r.Status</td>
                        <td class="num">@r.LineCount</td>
                        <td class="num">@r.TotalPlannedQty.ToString("0")</td>
                        <td>
                            @if (r.Status != "Confirmed")
                            {
                                <button class="ames-btn">✓ Confirm</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.PpRepository.SupplyPlanRow> _rows = new();
    protected override void OnInitialized() { try { _rows = Pp.ListSupplyPlans(); } catch { } }
}
