@page "/pp/plan-confirm"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.PpRepository Pp
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Web.Services.PermissionService PermSvc
@inject AuthenticationStateProvider AuthPrvd
@inject NavigationManager Nav
@inject DialogService Dialog
@inject AMES.Web.Services.AuditLogger Audit
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.PlanConfirm.Title"] · AMES</PageTitle>

<AmesPageHeader Code="PP-003" TitleKey="PP.PlanConfirm.Title" />

<div class="ames-page-fill">
@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat" AllowClose="false">@_msg</RadzenAlert>
}

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["PP.PlanConfirm.Kpi.PlanLines"]</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["PP.PlanConfirm.Kpi.Selected"]</div><div class="ames-kpi-v">@_selected.Count</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["PP.PlanConfirm.Kpi.WoCreated"]</div><div class="ames-kpi-v">@_woCreated</div></div>
    <div class="ames-kpi @(BlockedCount > 0 ? "bad" : "")"><div class="ames-kpi-l">@L["PP.PlanConfirm.Kpi.Blocked"]</div><div class="ames-kpi-v">@BlockedCount</div></div>
</div>

<div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.PlanConfirm.Title"] · @_view.Count @L["Lbl.Items"]@(_view.Count < _rows.Count ? $" / {L["Lbl.TotalOf"]} {_rows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_fCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text='@($"{L["PP.PlanConfirm.Col.Due"]} {L["PP.Forecast.Fld.Period"]}")' />
            <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn"
                          title="@L["Btn.PrevWeek"]" Click="() => ShiftWeek(-1)" />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_fFrom" DateFormat="@DateFmt.Date" AllowClear="true"
                              Change="@((DateTime? _) => Search())"
                              Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_fTo" DateFormat="@DateFmt.Date" AllowClear="true"
                              Change="@((DateTime? _) => Search())"
                              Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn"
                          title="@L["Btn.NextWeek"]" Click="() => ShiftWeek(1)" />
            <RadzenCheckBox TValue="bool" @bind-Value="_showIssued" Change="@((bool _) => Search())" Name="pcShowIssued" />
            <RadzenLabel Text="@L["PP.PlanConfirm.Lbl.ShowIssued"]" Component="pcShowIssued" Style="white-space:nowrap;margin-right:12px;" />
            <RadzenCheckBox TValue="bool" @bind-Value="_showHeld" Change="@((bool _) => Search())" Name="pcShowHeld" />
            <RadzenLabel Text="@string.Format(L["PP.PlanConfirm.Btn.ShowHeld"].Value, _heldCount)" Component="pcShowHeld" Style="white-space:nowrap;margin-right:12px;" />
            <RadzenLabel Text='@($"{L["Col.SoNo"]}/{L["Col.PartNo"]}")' />
            <RadzenTextBox @bind-Value="_fText" @bind-Value:after="ApplyFilters"
                           Placeholder="@L["PP.PlanConfirm.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />

            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="Search" />
            <RadzenButton Text="@L["Btn.Reset"].Value" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn" Click="Reset" />
            @if (_canEdit)
            {
                <span class="dim">|</span>
                <RadzenButton Text="@string.Format(L["PP.PlanConfirm.Btn.Hold"].Value, SelectedToHold)"
                              Icon="pause" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn"
                              Disabled="@(SelectedToHold == 0)" Click="HoldSelected" />
                <RadzenButton Text="@string.Format(L["PP.PlanConfirm.Btn.HoldRelease"].Value, SelectedHeld)"
                              Icon="play_circle" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn"
                              Disabled="@(SelectedHeld == 0)" Click="ReleaseSelected" />
                <RadzenButton Text="@string.Format(L["PP.PlanConfirm.Btn.Batch"].Value, SelectedToCreate)"
                              Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" class="ames-rz-btn"
                              Disabled="@(SelectedToCreate == 0)" Click="OpenBatch" />
            }
        </RadzenStack>
    </div>

<div class="dim" style="font-size:.85em;padding:4px 2px 6px;">@L["PP.PlanConfirm.Guide"]</div>
<div class="ames-grid-virtual">
@if (_rows.Count == 0)
{
    <div class="ames-empty">@L["PP.PlanConfirm.Empty"]</div>
}
else
{
    <RadzenDataGrid Data="_view" TItem="PpRepository.PlanLineRow" AllowVirtualization="true" Style="height:100%"
                    AllowSorting="true" EmptyText="@L["Grid.Empty"].Value" AllowColumnResize="true" Density="Density.Compact"
                    class="ames-rz-grid">
        <Columns>
            @* 선택은 WO 일괄 생성에만 쓰이므로 E 권한이 없으면 열 자체를 내린다 *@
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="46px" Width="46px" Sortable="false" Visible="@_canEdit"
                                  Filterable="false" TextAlign="TextAlign.Center" Frozen="true">
                <HeaderTemplate>
                    <input type="checkbox" class="pc-ck" checked="@AllSelected"
                           @onchange="e => ToggleAll((bool)(e.Value ?? false))" />
                </HeaderTemplate>
                <Template Context="r">
                    <input type="checkbox" class="pc-ck" disabled="@(!r.PlanHold && (r.Blocked || r.FullyIssued))"
                           checked="@_selected.Contains(r.SoId)"
                           @onchange="e => ToggleRow(r.SoId, (bool)(e.Value ?? false))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="150px" Property="SoNumber" Title="@L["Col.SoNo"].Value"
                                  Frozen="true" Width="150px">
                <Template Context="r">
                    <SoLink SoId="@r.SoId" SoNumber="@r.SoNumber" SoLineNo="@r.SoLineNo" ShowLine="true" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="120px" Property="CustomerId" Title="@L["Col.Customer"].Value" Width="120px" />
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="240px" Property="ItemNo" Title="@L["Col.PartNo"].Value" Width="240px">
                <Template Context="r">
                    <span class="code" data-item="@(r.ItemExists ? r.ItemNo : null)">@r.ItemNo</span>
                    @if (!r.ItemExists)
                    {
                        <span class="badge-bad">@L["PP.Forecast.Badge.Unregistered"]</span>
                    }
                    @if (!string.IsNullOrEmpty(r.ItemName)) { <span class="dim"> · @r.ItemName</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="100px" Property="OrderQty" Title="@L["Col.Order"].Value"
                                  TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@r.OrderQty.ToString("#,0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="100px" Property="IssuedQty" Title="@L["PP.PlanConfirm.Col.Issued"].Value"
                                  TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">
                    @if (r.IssuedQty > 0) { <span style="color:var(--ames-tx-amber-400);">@r.IssuedQty.ToString("#,0")</span> } else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="110px" Property="FgOnHand" Title="@L["PP.PlanConfirm.Col.FgStock"].Value"
                                  TextAlign="TextAlign.Right" Width="110px">
                <Template Context="r"><span style="color:var(--ames-tx-green-300);">@r.FgOnHand.ToString("#,0")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="110px" Property="NetReq" Title="@L["PP.PlanConfirm.Col.NetReq"].Value"
                                  TextAlign="TextAlign.Right" Width="110px">
                <Template Context="r">
                    <span style="font-weight:700;color:@(r.Blocked ? "var(--ames-tx-red-400)" : "var(--ames-tx-blue-300)");">@r.NetReq.ToString("#,0")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="170px" Property="LineLoadPct" Title="@L["PP.PlanConfirm.Col.LineLoad"].Value"
                                  Filterable="false" Width="170px">
                <Template Context="r">
                    @if (r.LineLoadPct is int pct)
                    {
                        <span class="pc-bar"><i style="width:@(Math.Min(pct, 100))%;background:@LoadColor(pct);"></i></span>
                        <span class="code" style="margin-left:6px;">@pct%</span>
                        @if (!string.IsNullOrEmpty(r.LineId)) { <span class="dim" style="font-size:.85em;margin-left:4px;">@r.LineId</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="120px" Property="DueDate" Title="@L["PP.PlanConfirm.Col.Due"].Value" Width="120px">
                <Template Context="r">
                    @if (r.DueDate is DateTime d)
                    {
                        <span style="@(IsUrgent(d) ? "color:var(--ames-tx-red-400);font-weight:600;" : "")">@d.ToString(DateFmt.Date)</span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.PlanLineRow" MinWidth="260px" Title="@L["Col.Status"].Value"
                                  Sortable="false" Filterable="false" Width="260px">
                <Template Context="r">
                    @if (r.PlanHold)
                    {
                        <span class="pill warn" title="@(r.PlanHoldReason ?? "")">@L["PP.PlanConfirm.Status.Held"]</span>
                        @if (!string.IsNullOrEmpty(r.PlanHoldReason)) { <span class="dim" style="font-size:.85em;"> · @r.PlanHoldReason</span> }
                    }
                    else if (r.FullyIssued)
                    {
                        <SoLink SoId="@r.SoId" SoNumber="@r.SoNumber" SoLineNo="@r.SoLineNo" Text="@L["PP.PlanConfirm.Status.Issued"].Value" PillClass="ok" />
                    }
                    else if (r.Blocked)
                    {
                        <span class="pill bad">@L[r.NoRouting ? "PP.PlanConfirm.Status.NoRouting" : "PP.PlanConfirm.Status.Blocked"]</span>
                    }
                    else if (r.IssuedQty > 0)
                    {
                        @if (_canEdit)
                        {
                            <a href="javascript:void(0)" class="pill warn wo-link" title="@PartialTip(r)" @onclick="() => CreateFor(r)" @onclick:stopPropagation="true">@L["PP.PlanConfirm.Status.Partial"]</a>
                        }
                        else { <span class="pill warn" title="@($"{r.IssuedQty:#,0} / {r.OrderQty:#,0}")">@L["PP.PlanConfirm.Status.Partial"]</span> }
                    }
                    else
                    {
                        @if (_canEdit)
                        {
                            <a href="javascript:void(0)" class="pill info wo-link" title="@L["PP.PlanConfirm.Tip.CreateWo"]" @onclick="() => CreateFor(r)" @onclick:stopPropagation="true">@L["PP.PlanConfirm.Status.Pending"]</a>
                        }
                        else { <span class="pill info">@L["PP.PlanConfirm.Status.Pending"]</span> }
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
</div>
</div>
</div>

@code {
    List<MasterDataRepository.CustomerRow> _customers = new();

    string    _fCustomer = "";
    string    _fText     = "";
    // 납기 기간 기본 = 오늘 앞뒤 1주
    DateTime? _fFrom = DbClock.Today.AddDays(-7);
    DateTime? _fTo   = DbClock.Today.AddDays(7);
    bool      _showIssued;
    bool      _showHeld;     // 검토 대기(보류) 보기
    int       _heldCount;    // 같은 고객·납기 조건의 보류 수주 수

    List<PpRepository.PlanLineRow> _rows = new();   // 조회 결과
    List<PpRepository.PlanLineRow> _view = new();   // 텍스트 필터 적용 표시용
    HashSet<int> _selected = new();
    int _woCreated;

    string _msg = "";
    bool   _isErr;

    int BlockedCount => _rows.Count(r => r.Blocked);
    // 보류한 수주는 보류를 풀기 위해, 그 밖은 WO 생성·보류를 위해 고를 수 있다(막힘·발행 완료 수주는 제외)
    IEnumerable<PpRepository.PlanLineRow> Selectable => _view.Where(r => r.PlanHold || (!r.Blocked && !r.FullyIssued));
    int SelectedToHold => _rows.Count(r => _selected.Contains(r.SoId) && !r.PlanHold);
    int SelectedHeld => _rows.Count(r => _selected.Contains(r.SoId) && r.PlanHold);
    int SelectedToCreate => _rows.Count(r => _selected.Contains(r.SoId) && !r.PlanHold && !r.Blocked && !r.FullyIssued);
    bool AllSelected => Selectable.Any() && Selectable.All(r => _selected.Contains(r.SoId));

    // 권한 키(SYS_Screen.HRef) — R = 화면 조회, E = WO 일괄 생성
    const string Href = "pp/plan-confirm";
    bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        // 메뉴에서 숨겨도 주소를 직접 치면 열리므로 읽기 권한은 화면에서도 확인한다
        if (!PermSvc.IsVisible(Href)) { Nav.NavigateTo("/unauthorized", replace: true); return; }
        _canEdit = PermSvc.CanEdit(Href);

        try { _customers = MD.ListCustomers(); } catch { }
        Search();
    }

    void Search()
    {
        try
        {
            _rows = Pp.ListPlanCandidates(_fCustomer ?? "", _fFrom, _fTo, includeIssued: _showIssued, includeHeld: _showHeld);
            _heldCount = Pp.CountPlanHeld(_fCustomer ?? "", _fFrom, _fTo);
        }
        catch (Exception ex) { ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); _rows = new(); }
        _selected.RemoveWhere(id => _rows.All(r => r.SoId != id));
        ApplyFilters();
    }

    // SO 번호 / 품번·품명 부분일치 클라이언트 필터.
    void ApplyFilters()
    {
        _view = string.IsNullOrWhiteSpace(_fText)
            ? _rows
            : _rows.Where(r =>
                  (r.SoNumber?.Contains(_fText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                  r.ItemNo.Contains(_fText, StringComparison.OrdinalIgnoreCase) ||
                  (r.ItemName?.Contains(_fText, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();
    }

    void Reset()
    {
        _fCustomer = ""; _fText = ""; _showIssued = false; _showHeld = false;
        _fFrom = DbClock.Today.AddDays(-7); _fTo = DbClock.Today.AddDays(7);
        Search();
    }

    // ◀ ▶ — 기간을 1주씩 옮긴다. 한쪽이 비어 있으면 오늘 기준 기본 기간에서 시작한다.
    void ShiftWeek(int dir)
    {
        _fFrom = (_fFrom ?? DbClock.Today.AddDays(-7)).AddDays(7 * dir);
        _fTo   = (_fTo   ?? DbClock.Today.AddDays(7)).AddDays(7 * dir);
        Search();
    }

    // 선택한 수주를 검토 대기로 보류 — 목록에서 숨기고 「검토 대기 보기」에서만 보인다(사유는 선택)
    async Task HoldSelected()
    {
        if (!_canEdit) return;
        var targets = _rows.Where(r => _selected.Contains(r.SoId) && !r.PlanHold).ToList();
        var ids = targets.Select(r => r.SoId).ToList();
        if (ids.Count == 0) { ShowMsg(L["PP.PlanConfirm.Err.NoneSelected"], true); return; }
        var res = await Dialog.OpenAsync<PlanHoldDialog>(L["PP.PlanConfirm.Dlg.HoldTitle"].Value,
            new Dictionary<string, object?> { ["Count"] = ids.Count, ["ItemNos"] = targets.Where(r => r.FgOnHand > 0).Select(r => r.ItemNo).ToList() },
            new DialogOptions { Width = "min(820px, 96vw)" });
        if (res is not PlanHoldDialog.Result r) return;
        await ApplyHold(ids, true, r.Reason, "PP.PlanConfirm.Ok.Held");
    }

    async Task ReleaseSelected()
    {
        if (!_canEdit) return;
        var ids = _rows.Where(r => _selected.Contains(r.SoId) && r.PlanHold).Select(r => r.SoId).ToList();
        if (ids.Count == 0) { ShowMsg(L["PP.PlanConfirm.Err.NoneSelected"], true); return; }
        await ApplyHold(ids, false, null, "PP.PlanConfirm.Ok.HoldReleased");
    }

    async Task ApplyHold(List<int> ids, bool hold, string? reason, string okKey)
    {
        try
        {
            var auth = await AuthPrvd.GetAuthenticationStateAsync();
            var actor = AMES.Web.Services.ActorCode.Of(auth.User, "system");
            var n = await Task.Run(() => Pp.SetPlanHold(ids, hold, reason, actor));
            var keys = _rows.Where(r => ids.Contains(r.SoId)).Select(r => $"{r.SoNumber}-{r.SoLineNo}").ToList();
            Audit.Log("PP-003", hold ? "HOLD" : "HOLD_RELEASE", "PP_CustomerOrder", string.Join(",", keys.Take(10)), null, new { Count = n, Reason = reason, Orders = keys });
            _selected.Clear();
            ShowMsg(string.Format(L[okKey].Value, n), false);
            Search();
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    string PartialTip(PpRepository.PlanLineRow r) => $"{r.IssuedQty:#,0} / {r.OrderQty:#,0} · {L["PP.PlanConfirm.Tip.CreateWo"].Value}";

    // 상태 배지(검토 대기·부분 발행)를 누르면 그 수주 하나만 골라 바로 WO 생성 창으로 간다 — 다음 순서로 이동
    async Task CreateFor(PpRepository.PlanLineRow r)
    {
        if (!_canEdit || r.Blocked || r.FullyIssued || r.PlanHold) return;
        _selected.Clear();
        _selected.Add(r.SoId);
        await OpenBatch();
    }

    void ToggleRow(int soId, bool on)
    {
        if (on) _selected.Add(soId); else _selected.Remove(soId);
    }

    void ToggleAll(bool on)
    {
        foreach (var r in Selectable)
            if (on) _selected.Add(r.SoId); else _selected.Remove(r.SoId);
    }

    static bool IsUrgent(DateTime d) => (d.Date - DbClock.Today).Days <= 14;

    // 라인 부하 색: >90 과부하(빨강) · 70~90 주의(주황) · <70 여유(초록)
    static string LoadColor(int p) => p > 90 ? "#f87171" : p >= 70 ? "#fbbf24" : "#4ade80";

    async Task OpenBatch()
    {
        if (!_canEdit) return;   // 버튼을 숨겨도 핸들러에서 한 번 더 막는다

        var lines = _rows.Where(r => _selected.Contains(r.SoId) && !r.PlanHold && !r.Blocked && !r.FullyIssued).ToList();
        if (lines.Count == 0) { ShowMsg(L["PP.PlanConfirm.Err.NoneSelected"], true); return; }

        var result = await Dialog.OpenAsync<PlanConfirmBatchDialog>(
            L["PP.PlanConfirm.Dlg.Title"].Value,
            new Dictionary<string, object?> { ["Lines"] = lines },
            new DialogOptions { Width = "min(1280px, 96vw)", CssClass = "ames-batch-dlg", Resizable = true });

        if (result is PlanConfirmBatchDialog.Result r)
        {
            _woCreated += r.Created;
            _selected.Clear();
            var msg = string.Format(L["PP.PlanConfirm.Ok.Scheduled"].Value, r.Created, r.Late, r.Short);
            if (r.Rejected > 0)
            {
                var why = new[] { ("PP.PlanConfirm.Ok.Rejected.NoMold", r.NoMold), ("PP.PlanConfirm.Ok.Rejected.NoCore", r.NoCore),
                                  ("PP.PlanConfirm.Ok.Rejected.NoLotPrefix", r.NoLotPrefix) }
                    .Where(x => x.Item2 > 0).Select(x => string.Format(L[x.Item1].Value, x.Item2));
                msg += " · " + string.Format(L["PP.PlanConfirm.Ok.Rejected"].Value, r.Rejected, string.Join(" · ", why));
            }
            ShowMsg(msg, r.Short > 0 || r.Rejected > 0);
            Search();
        }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
