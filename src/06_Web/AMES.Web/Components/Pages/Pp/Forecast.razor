@page "/pp/forecast"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.PpRepository Pp
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Web.Services.PermissionService PermSvc
@inject AMES.Web.Services.UomFormat UomFmt
@inject AuthenticationStateProvider AuthPrvd
@inject NavigationManager Nav
@inject DialogService Dialog
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.Forecast.Title"] · AMES</PageTitle>

<AmesPageHeader Code="PP-001" TitleKey="PP.Forecast.Title" />

<div class="ames-page-fill">
@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat" AllowClose="false">@_msg</RadzenAlert>
}

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["PP.Forecast.Kpi.Items"]</div><div class="ames-kpi-v">@_items.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["PP.Forecast.Kpi.Weeks"]</div><div class="ames-kpi-v">@_weeks.Count</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["PP.Forecast.Kpi.TotalQty"]</div><div class="ames-kpi-v">@_items.Sum(i => i.Qty.Values.Sum()).ToString("#,0")</div></div>
    <div class="ames-kpi @(UnmatchedCount > 0 ? "bad" : "")"><div class="ames-kpi-l">@L["PP.Forecast.Kpi.Unmatched"]</div><div class="ames-kpi-v">@UnmatchedCount</div></div>
</div>

<AmesTabs>
    <AmesTab Title="@L["PP.Forecast.Tab.Status"].Value">
    <div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.Forecast.Tab.Status"] · @_view.Count @L["Lbl.Items"]@(_view.Count < _items.Count ? $" / {L["Lbl.TotalOf"]} {_items.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_fCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text="@L["PP.Forecast.Fld.Period"]" />
            <RadzenDatePicker @bind-Value="_fFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker @bind-Value="_fTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <RadzenLabel Text="@L["Col.PartNo"]" />
            <RadzenTextBox @bind-Value="_fPartNo" @bind-Value:after="ApplyPartNo"
                           Placeholder="@L["PP.Forecast.Fld.PartNoPh"].Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />

            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="Search" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["PP.Forecast.Btn.ExcelUpload"].Value" Icon="upload"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="OpenUpload" />
            }
            <RadzenButton Text="@L["PP.Forecast.Btn.Export"].Value" Icon="download"
                          ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" class="ames-rz-btn" Click="ExportCsv" />
        </RadzenStack>
    </div>

    <div class="ames-grid-virtual">
    @if (_items.Count == 0)
    {
        <div class="ames-empty">@L["PP.Forecast.Empty"]</div>
    }
    else
    {
        <RadzenDataGrid Data="_view" TItem="ItemVm" AllowVirtualization="true" Style="height:100%"
                        AllowSorting="true" EmptyText="@L["Grid.Empty"].Value" AllowColumnResize="true" Density="Density.Compact"
                        AllowFiltering="true" FilterMode="FilterMode.CheckBoxList"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        class="ames-rz-grid">
            <Columns>
                @if (_showCustomerCol)
                {
                    <RadzenDataGridColumn TItem="ItemVm" Property="CustomerId" Title="@L["Col.Customer"].Value"
                                          Frozen="true" Width="120px" />
                }
                <RadzenDataGridColumn TItem="ItemVm" Property="ItemNo" Title="@L["Col.PartNo"].Value"
                                      Frozen="true" Width="170px">
                    <Template Context="it">
                        <span class="code">@it.ItemNo</span>
                        @if (!it.ItemExists)
                        {
                            <span class="badge-bad">@L["PP.Forecast.Badge.Unregistered"]</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ItemVm" Property="Name" Title="@L["Col.PartName"].Value" Width="200px" />
                <RadzenDataGridColumn TItem="ItemVm" Property="BaseInv" Title="@L["Col.BaseInv"].Value"
                                      Filterable="false" TextAlign="TextAlign.Right" Width="100px">
                    <Template Context="it">@(it.BaseInv?.ToString("#,0") ?? "—")</Template>
                </RadzenDataGridColumn>
                @foreach (var w in _weeks)
                {
                    var week  = w;
                    var label = _weeks.IndexOf(w) is var k && k < _weekLabels.Count ? _weekLabels[k] : "";
                    <RadzenDataGridColumn TItem="ItemVm" Title="@week.ToString(DateFmt.DateShort)" Sortable="false"
                                          Filterable="false" TextAlign="TextAlign.Right" Width="80px">
                        <HeaderTemplate>
                            <span title="@($"{week.ToString(DateFmt.Date)} {label}")">@week.ToString(DateFmt.DateShort)</span>
                        </HeaderTemplate>
                        <Template Context="it">@(it.Qty.TryGetValue(week, out var q) ? q.ToString("#,0") : "—")</Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
    </div>
    </div>
    </AmesTab>

    <AmesTab Title="@L["PP.Forecast.Tab.Daily"].Value">
    <div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.Forecast.Tab.Daily"] · @L["PP.DemandPlan.Kpi.Items"] @_dItems.Count · @L["PP.DemandPlan.Kpi.Days"] @_dDates.Count · @L["PP.DemandPlan.Kpi.TotalQty"] @UomFmt.Qty(_dItems.Sum(i => i.Qty.Values.Sum()), null) · @L["PP.DemandPlan.Kpi.Unmatched"] @_dItems.Count(i => !i.ItemExists)</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_dCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text="@L["PP.Forecast.Fld.Period"]" />
            <RadzenDatePicker @bind-Value="_dFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker @bind-Value="_dTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <RadzenLabel Text="@L["Col.PartNo"]" />
            <RadzenTextBox @bind-Value="_dPartNo" @bind-Value:after="ApplyDailyPartNo"
                           Placeholder="@L["PP.Forecast.Fld.PartNoPh"].Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />

            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="SearchDaily" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["PP.DemandPlan.Btn.Upload"].Value" Icon="upload"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="OpenDailyUpload" />
                <RadzenButton Text="@L["PP.DemandPlan.Btn.Api"].Value" Icon="cloud_download"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="OpenDailySync" />
            }
        </RadzenStack>
    </div>

    <div class="ames-grid-virtual">
    @if (_dItems.Count == 0)
    {
        <div class="ames-empty">@L["PP.DemandPlan.Empty"]</div>
    }
    else
    {
        <RadzenDataGrid Data="_dView" TItem="DailyVm" AllowVirtualization="true" Style="height:100%"
                        AllowSorting="true" EmptyText="@L["Grid.Empty"].Value" AllowColumnResize="true" Density="Density.Compact"
                        AllowFiltering="true" FilterMode="FilterMode.CheckBoxList"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        class="ames-rz-grid">
            <Columns>
                @if (_dShowCustomer)
                {
                    <RadzenDataGridColumn TItem="DailyVm" Property="CustomerId" Title="@L["Col.Customer"].Value"
                                          Frozen="true" Width="120px" />
                }
                <RadzenDataGridColumn TItem="DailyVm" Property="ItemNo" Title="@L["Col.PartNo"].Value"
                                      Frozen="true" Width="170px">
                    <Template Context="it">
                        <span class="code">@it.ItemNo</span>
                        @if (!it.ItemExists)
                        {
                            <span class="badge-bad">@L["PP.Forecast.Badge.Unregistered"]</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DailyVm" Property="Name" Title="@L["Col.PartName"].Value" Width="200px" />
                <RadzenDataGridColumn TItem="DailyVm" Title="@L["PP.DemandPlan.Col.Pack"].Value"
                                      Filterable="false" TextAlign="TextAlign.Right" Width="140px">
                    <Template Context="it">
                        @UomFmt.Qty(it.PackQty, it.Unit)
                        @if (it.PackMismatch)
                        {
                            <span class="badge-bad">@L["PP.DemandPlan.Badge.PackMismatch"]</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                @foreach (var d in _dDates)
                {
                    var date = d;
                    <RadzenDataGridColumn TItem="DailyVm" Title="@date.ToString(DateFmt.DateShort)" Sortable="false"
                                          Filterable="false" TextAlign="TextAlign.Right" Width="70px">
                        <Template Context="it">@(it.Qty.TryGetValue(date, out var q) && q != 0 ? UomFmt.Qty(q, it.Unit) : "—")</Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
    </div>
    </div>
    </AmesTab>

    <AmesTab Title="@L["PP.Forecast.Tab.History"].Value">
    <div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.Forecast.Tab.History"] · @_batches.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_hCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text="@L["PP.Forecast.Fld.Period"]" />
            <RadzenDatePicker @bind-Value="_hFrom" DateFormat="@DateFmt.Date" AllowClear="true"
                              Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker @bind-Value="_hTo" DateFormat="@DateFmt.Date" AllowClear="true"
                              Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />

            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="SearchHistory" />
        </RadzenStack>
    </div>

        <div class="ames-grid-virtual">
        @if (_batches.Count == 0)
        {
            <div class="ames-empty">@L["PP.Forecast.Hist.Empty"]</div>
        }
        else
        {
            <RadzenDataGrid Data="_batches" TItem="PpRepository.WeeklyImportBatch"
                            AllowVirtualization="true" Style="height:100%" AllowSorting="true" EmptyText="@L["Grid.Empty"].Value"
                            AllowColumnResize="true" Density="Density.Compact"
                            class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="PpRepository.WeeklyImportBatch" Property="CustomerId"
                                          Title="@L["Col.Customer"].Value" Width="120px" />
                    <RadzenDataGridColumn TItem="PpRepository.WeeklyImportBatch" Property="Batch"
                                          Title="@L["PP.Forecast.Hist.Batch"].Value" Width="160px">
                        <Template Context="b"><span class="code">@b.Batch</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PpRepository.WeeklyImportBatch" Property="Rows"
                                          Title="@L["PP.Forecast.Hist.Rows"].Value" TextAlign="TextAlign.Right" Width="90px">
                        <Template Context="b">@b.Rows.ToString("#,0")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PpRepository.WeeklyImportBatch" Property="Items"
                                          Title="@L["PP.Forecast.Hist.Items"].Value" TextAlign="TextAlign.Right" Width="90px">
                        <Template Context="b">@b.Items.ToString("#,0")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PpRepository.WeeklyImportBatch" Title="@L["PP.Forecast.Hist.Period"].Value"
                                          Sortable="false" Width="210px">
                        <Template Context="b">@(b.WeekFrom?.ToString(DateFmt.Date) ?? "—") ~ @(b.WeekTo?.ToString(DateFmt.Date) ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PpRepository.WeeklyImportBatch" Property="ImportedBy"
                                          Title="@L["PP.Forecast.Hist.By"].Value" Width="140px" />
                                          <RadzenDataGridColumn TItem="PpRepository.WeeklyImportBatch" Property="ImportedAt"
                                          Title="@L["PP.Forecast.Hist.Uploaded"].Value" Width="160px"
                                          SortOrder="SortOrder.Descending">
                        <Template Context="b">@(b.ImportedAt?.ToString(DateFmt.DateTime) ?? "—")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        </div>
    </div>

    <div class="ames-card" style="margin-top:12px;">
        <div class="ames-card-h">▼ @L["PP.DemandPlan.Hist.Title"] · @_dBatches.Count</div>
        <div class="ames-grid-virtual" style="height:260px">
        @if (_dBatches.Count == 0)
        {
            <div class="ames-empty">@L["PP.Forecast.Hist.Empty"]</div>
        }
        else
        {
            <RadzenDataGrid Data="_dBatches" TItem="PpRepository.DemandPlanBatchRow"
                            AllowVirtualization="true" Style="height:100%" AllowSorting="true" EmptyText="@L["Grid.Empty"].Value"
                            AllowColumnResize="true" Density="Density.Compact"
                            class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Property="CustomerId"
                                          Title="@L["Col.Customer"].Value" Width="120px" />
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Property="Source"
                                          Title="@L["PP.DemandPlan.Hist.Source"].Value" Width="90px" />
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Title="@L["PP.DemandPlan.Hist.File"].Value" Width="220px">
                        <Template Context="b">@(b.FileName ?? b.SourceKey ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Title="@L["PP.Forecast.Hist.Period"].Value"
                                          Sortable="false" Width="190px">
                        <Template Context="b">@b.DateFrom.ToString(DateFmt.Date) ~ @b.DateTo.ToString(DateFmt.Date)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Property="ItemCount"
                                          Title="@L["PP.Forecast.Hist.Items"].Value" TextAlign="TextAlign.Right" Width="80px" />
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Property="RowCount"
                                          Title="@L["PP.Forecast.Hist.Rows"].Value" TextAlign="TextAlign.Right" Width="80px" />
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Property="UnmatchedItems"
                                          Title="@L["PP.DemandPlan.Hist.Unmatched"].Value" TextAlign="TextAlign.Right" Width="90px" />
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Property="PackMismatch"
                                          Title="@L["PP.DemandPlan.Hist.Mismatch"].Value" TextAlign="TextAlign.Right" Width="100px" />
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Property="ImportedBy"
                                          Title="@L["PP.Forecast.Hist.By"].Value" Width="140px" />
                    <RadzenDataGridColumn TItem="PpRepository.DemandPlanBatchRow" Property="ImportedAt"
                                          Title="@L["PP.Forecast.Hist.Uploaded"].Value" Width="160px"
                                          SortOrder="SortOrder.Descending">
                        <Template Context="b">@b.ImportedAt.ToString(DateFmt.DateTime)</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        </div>
    </div>
    </AmesTab>
</AmesTabs>
</div>

@code {
    List<MasterDataRepository.CustomerRow> _customers = new();

    // 예측 현황 조회 필터
    string   _fCustomer = "";
    string   _fPartNo   = "";
    DateTime _fFrom = DbClock.Today;
    DateTime _fTo   = DbClock.Today.AddDays(154);   // 22주

    // 업로드 이력 조회 필터 (업로드 일시 기준, null = 무제한)
    string    _hCustomer = "";
    DateTime? _hFrom;
    DateTime? _hTo;

    // 피벗 표시 모델. CustomerId는 전체 고객 조회에서만 표시.
    record ItemVm(string? CustomerId, string ItemNo, string Name, decimal? BaseInv, bool ItemExists,
                  Dictionary<DateTime, decimal> Qty);
    bool _showCustomerCol;   // 조회 시점 스냅샷 (드롭다운만 바꾸고 조회 안 한 상태와 분리)
    List<DateTime> _weeks = new();
    List<string>   _weekLabels = new();
    List<ItemVm>   _items = new();
    List<ItemVm>   _view  = new();   // Part No 검색 적용된 표시용
    List<PpRepository.WeeklyImportBatch> _batches = new();

    // 일별 구매계획(MM30011) 탭 — 조회 필터·표시 모델
    record DailyVm(string? CustomerId, string ItemNo, string Name, string? Unit, decimal? PackQty, decimal? BoxQty, bool ItemExists, Dictionary<DateOnly, decimal> Qty)
    { public bool PackMismatch => PackQty is > 0 && BoxQty is > 0 && PackQty != BoxQty; }
    string _dCustomer = "", _dPartNo = "";
    DateTime _dFrom = DbClock.Today, _dTo = DbClock.Today.AddDays(30);
    List<DateOnly> _dDates = new();
    List<DailyVm> _dItems = new(), _dView = new();
    List<PpRepository.DemandPlanBatchRow> _dBatches = new();
    bool _dShowCustomer;

    string _msg = "";
    bool   _isErr;

    int UnmatchedCount => _items.Count(i => !i.ItemExists);

    // 권한 키(SYS_Screen.HRef) — R = 화면 조회, E = 엑셀 업로드
    const string Href = "pp/forecast";
    bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        // 메뉴에서 숨겨도 주소를 직접 치면 열리므로 읽기 권한은 화면에서도 확인한다
        if (!PermSvc.IsVisible(Href)) { Nav.NavigateTo("/unauthorized", replace: true); return; }
        _canEdit = PermSvc.CanEdit(Href);

        try { _customers = MD.ListCustomers(); } catch { }
        Search();
        SearchHistory();
        SearchDaily();
    }

    // 업로드 이력 조회 — 자체 필터(고객사·업로드 일시)로 로드.
    void SearchHistory()
    {
        try   { _batches = Pp.ListWeeklyImportBatches(_hCustomer ?? "", _hFrom, _hTo); }
        catch { _batches = new(); }
        SearchDailyHistory();
    }

    // ── 일별 구매계획(MM30011) 조회 ──────────────────────────────
    void SearchDaily()
    {
        List<PpRepository.DemandPlanCellRow> cells;
        try   { cells = Pp.ListDemandPlan(_dCustomer ?? "", DateOnly.FromDateTime(_dFrom), DateOnly.FromDateTime(_dTo)); }
        catch (Exception ex) { ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); cells = new(); }
        _dShowCustomer = string.IsNullOrEmpty(_dCustomer);
        _dDates = cells.Select(c => c.PlanDate).Distinct().Order().ToList();
        _dItems = cells.GroupBy(c => (c.CustomerId, c.ItemNo))
            .Select(g => new DailyVm(g.Key.CustomerId, g.Key.ItemNo, g.First().ItemName ?? g.First().PartName ?? g.Key.ItemNo, g.First().Unit,
                g.First().PackQty, g.First().BoxQty, g.First().ItemExists, g.ToDictionary(c => c.PlanDate, c => c.ScheduledQty)))
            .OrderBy(i => i.CustomerId).ThenBy(i => i.ItemNo).ToList();
        ApplyDailyPartNo();
        SearchDailyHistory();
    }

    void ApplyDailyPartNo() => _dView = string.IsNullOrWhiteSpace(_dPartNo) ? _dItems
        : _dItems.Where(i => i.ItemNo.Contains(_dPartNo, StringComparison.OrdinalIgnoreCase) || i.Name.Contains(_dPartNo, StringComparison.OrdinalIgnoreCase)).ToList();

    void SearchDailyHistory() { try { _dBatches = Pp.ListDemandPlanBatches(_hCustomer ?? "", _hFrom, _hTo); } catch { _dBatches = new(); } }

    async Task OpenDailyUpload()
    {
        if (!_canEdit) return;   // 버튼을 숨겨도 핸들러에서 한 번 더 막는다
        var result = await Dialog.OpenAsync<DemandPlanUploadDialog>(L["PP.DemandPlan.Upload.Title"].Value, new Dictionary<string, object?> { ["Customers"] = _customers });
        if (result is ValueTuple<PpRepository.DemandPlanImportResult, string> t)
        {
            var (r, cust) = t;
            ShowMsg(string.Format(L["PP.DemandPlan.Ok.Imported"].Value, r.ItemCount, r.RowCount, r.UnmatchedItems, r.PackMismatch), r.UnmatchedItems > 0 || r.PackMismatch > 0);
            _dCustomer = cust;
            _dFrom = r.From.ToDateTime(TimeOnly.MinValue); _dTo = r.To.ToDateTime(TimeOnly.MinValue);
            SearchDaily();   // 이력 탭의 일별 배치 표는 SearchDaily() 끝의 SearchDailyHistory() 로 함께 갱신된다 — 주간 이력 필터(_h*)는 건드리지 않는다
        }
    }

    async Task OpenDailySync()
    {
        if (!_canEdit) return;   // 버튼을 숨겨도 핸들러에서 한 번 더 막는다
        var result = await Dialog.OpenAsync<DemandPlanSyncDialog>(L["PP.DemandPlan.Api.Title"].Value);
        if (result is AMES.Data.Services.DemandPlan.DemandPlanRunResult { Ok: true } r)
        {
            ShowMsg(string.Format(L["PP.DemandPlan.Api.Ok"].Value, r.Items, r.Cells, r.Unmatched, r.PackMismatch), r.Unmatched > 0 || r.PackMismatch > 0);
            if (r.From is { } from && r.To is { } to) { _dFrom = from.ToDateTime(TimeOnly.MinValue); _dTo = to.ToDateTime(TimeOnly.MinValue); }
        }
        // X 로 닫으면 결과가 안 넘어온다 — 실행했을 수 있으니 항상 다시 읽는다
        SearchDaily();
    }

    // ── 업로드 다이얼로그 ────────────────────────────────────────
    async Task OpenUpload()
    {
        if (!_canEdit) return;   // 버튼을 숨겨도 핸들러에서 한 번 더 막는다

        var result = await Dialog.OpenAsync<ForecastUploadDialog>(
            L["PP.Forecast.Upload.Title"].Value,
            new Dictionary<string, object?> { ["Customers"] = _customers });

        if (result is ForecastUploadDialog.Result r)
        {
            ShowMsg(string.Format(L["PP.Forecast.Ok.Imported"].Value, r.Ins, r.Upd, r.Chg), false);
            _fCustomer = r.CustomerId;
            _fFrom = r.From;
            _fTo   = r.To;
            Search();

            // 방금 업로드한 배치가 이력에 바로 보이도록 이력 필터도 해당 고객으로 맞춰 재조회
            _hCustomer = r.CustomerId;
            _hFrom = null; _hTo = null;
            SearchHistory();
        }
    }

    // ── CSV 내보내기 ─────────────────────────────────────────────
    async Task ExportCsv()
    {
        if (_items.Count == 0) { ShowMsg(L["PP.Forecast.Err.NoExport"], true); return; }

        var sb = new System.Text.StringBuilder();
        var head = new List<string>();
        if (_showCustomerCol) head.Add(L["Col.Customer"]);
        head.Add(L["Col.PartNo"]); head.Add(L["Col.PartName"]); head.Add(L["Col.BaseInv"]);
        head.AddRange(_weeks.Select(w => w.ToString("yyyy-MM-dd")));
        sb.AppendLine(string.Join(",", head.Select(Csv)));

        foreach (var it in _items)
        {
            var row = new List<string>();
            if (_showCustomerCol) row.Add(it.CustomerId ?? "");
            row.Add(it.ItemNo); row.Add(it.Name); row.Add(it.BaseInv?.ToString("0.###") ?? "");
            row.AddRange(_weeks.Select(w => it.Qty.TryGetValue(w, out var q) ? q.ToString("0.###") : ""));
            sb.AppendLine(string.Join(",", row.Select(Csv)));
        }

        // UTF-8 BOM — Excel에서 한글 품명 정상 표시
        var bytes = System.Text.Encoding.UTF8.GetPreamble()
            .Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var name = $"Forecast_{DbClock.Now:yyyyMMdd_HHmmss}.csv";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes), "text/csv");
        ShowMsg(string.Format(L["PP.Forecast.Ok.Exported"].Value, _items.Count), false);
    }

    static string Csv(string s) => AMES.Contracts.Formatting.CsvCell.Escape(s);   // 엑셀 수식 주입 방지 포함

    // ── 조회 ─────────────────────────────────────────────────────
    void Search()
    {
        _weekLabels = new();
        List<PpRepository.WeeklyCell> cells;
        try   { cells = Pp.ListWeeklyForecast(_fCustomer ?? "", _fFrom, _fTo); }
        catch { cells = new(); }

        _showCustomerCol = string.IsNullOrEmpty(_fCustomer);
        _weeks = cells.Select(c => c.WeekStartDate).Distinct().Order().ToList();
        _weekLabels = _weeks
            .Select(w => cells.FirstOrDefault(c => c.WeekStartDate == w && c.WeekLabel != null)?.WeekLabel ?? "")
            .ToList();
        _items = cells.GroupBy(c => (c.CustomerId, c.ItemNo))
            .Select(g => new ItemVm(g.Key.CustomerId, g.Key.ItemNo,
                g.First().ItemName ?? g.First().PartName ?? g.Key.ItemNo,
                g.First().BaseInv, g.First().ItemExists,
                g.ToDictionary(c => c.WeekStartDate, c => c.Qty)))
            .OrderBy(i => i.CustomerId).ThenBy(i => i.ItemNo)
            .ToList();
        ApplyPartNo();
    }

    // Part No 검색 — 이미 로드된 _items에 대해 클라이언트 필터. 품번/품명 부분일치.
    void ApplyPartNo()
    {
        _view = string.IsNullOrWhiteSpace(_fPartNo)
            ? _items
            : _items.Where(i =>
                  i.ItemNo.Contains(_fPartNo, StringComparison.OrdinalIgnoreCase) ||
                  (i.Name?.Contains(_fPartNo, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
