    // 업로드·API 가져오기 뒤: 고객을 맞추고 기간을 업로드 범위까지 넓힌 다음, 세 탭(예측 현황·일별·대조)을 모두 다시 읽는다.
    // 어느 탭을 눌러도 방금 올린 데이터가 바로 보이도록 한다.
    void RefreshAfterChange(string? customerId, DateOnly? from, DateOnly? to)
    {
        if (!string.IsNullOrEmpty(customerId))
        {
            _fCustomer = customerId;
            _dCustomer = customerId;
            _rCustomer = customerId;
        }
        if (from is DateOnly f && to is DateOnly t)
        {
            var wf = DateOnly.FromDateTime(_fFrom);
            var wt = DateOnly.FromDateTime(_fTo);
            _fFrom = (f < wf ? f : wf).ToDateTime(TimeOnly.MinValue);
            _fTo = (t > wt ? t : wt).ToDateTime(TimeOnly.MinValue);
            _dFrom = f.ToDateTime(TimeOnly.MinValue);
            _dTo = t.ToDateTime(TimeOnly.MinValue);
            _rFrom = _dFrom;
            _rTo = _dTo;
        }
        Search();        // 예측 현황 = 일별 계획 주 합산
        SearchDaily();   // 일별 구매계획 + 일별 배치 이력
        SearchRecon();   // 일별 발주·대조 (고객 미선택 = 전체)
        SearchHistory(); // 업로드 이력
    }

    // ◀ ▶ — 탭마다 기간을 1주씩 옮기고 바로 조회한다
    void ShiftWeekly(int dir) { _fFrom = _fFrom.AddDays(7 * dir); _fTo = _fTo.AddDays(7 * dir); Search(); }
    void ShiftDaily(int dir)  { _dFrom = _dFrom.AddDays(7 * dir); _dTo = _dTo.AddDays(7 * dir); SearchDaily(); }
    void ShiftRecon(int dir)
    {
        _rFrom = (_rFrom ?? DbClock.Today.AddDays(-7)).AddDays(7 * dir);
        _rTo   = (_rTo   ?? DbClock.Today.AddDays(60)).AddDays(7 * dir);
        SearchRecon();
    }

    void SearchRecon()
    {
        var from = DateOnly.FromDateTime(_rFrom ?? DbClock.Today.AddDays(-7));
        var to = DateOnly.FromDateTime(_rTo ?? DbClock.Today.AddDays(60));
        try
        {
            var day = Pp.ListDayReconciliation(string.IsNullOrEmpty(_rCustomer) ? null : _rCustomer, from, to);   // 고객 미선택 = 전체
            var issues = DemandReconciliation.Days(day.Select(r => new DemandReconciliation.DayRow(r.CustomerId, r.ItemNo, r.Date, r.PoQty, r.DailyPoQty, r.PlanPoQty)))
                .GroupBy(i => (i.CustomerId, i.Item, i.Date))
                .ToDictionary(g => g.Key, g => string.Join(", ", g.Select(i => KindLabel(i.Kind))));
            _recon = day.Where(r => issues.ContainsKey((r.CustomerId, r.ItemNo, r.Date)))
                .Select(r => new ReconVm(r.CustomerId, r.ItemNo, r.Date.ToDateTime(TimeOnly.MinValue), r.PoQty, r.DailyPoQty, r.PlanPoQty,
                                         issues[(r.CustomerId, r.ItemNo, r.Date)]))
                .ToList();
        }
        catch (Exception ex) { _recon = new(); ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); }
    }

    string KindName(string kind) => kind switch
    {
        "PO" => L["PP.Hist.Kind.PO"].Value,
        "DAILYPO" => L["PP.Hist.Kind.DailyPo"].Value,
        "DAILYPLAN" => L["PP.Hist.Kind.DailyPlan"].Value,
        "WEEKLY" => L["PP.Hist.Kind.Weekly"].Value,
        _ => kind,
    };

    string KindLabel(string kind) => kind switch
    {
        DemandReconciliation.KindPoVsDailyPo => L["PP.Recon.Kind.PoDaily"].Value,
        DemandReconciliation.KindDailyPoMissing => L["PP.Recon.Kind.DailyPoMissing"].Value,
        DemandReconciliation.KindPoMissing => L["PP.Recon.Kind.PoMissing"].Value,
        DemandReconciliation.KindDailyVsPlanPo => L["PP.Recon.Kind.DailyVsPlan"].Value,
        _ => kind,
    };

