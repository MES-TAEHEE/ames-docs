@page "/pp/forecast"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using AMES.Data.Services.DemandPlan
@using AMES.Data.Services.Srm
@inject AMES.Data.Repositories.PpRepository Pp
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Web.Services.ActorNames Actors
@inject AMES.Web.Services.PermissionService PermSvc
@inject AMES.Web.Services.UomFormat UomFmt
@inject AuthenticationStateProvider AuthPrvd
@inject NavigationManager Nav
@inject DialogService Dialog
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.Forecast.Title"] · AMES</PageTitle>

<AmesPageHeader Code="PP-001" TitleKey="PP.Forecast.Title" />

<div class="ames-page-fill">
<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["PP.Forecast.Kpi.Items"]</div><div class="ames-kpi-v">@_items.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["PP.Forecast.Kpi.Weeks"]</div><div class="ames-kpi-v">@_weeks.Count</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["PP.Forecast.Kpi.TotalQty"]</div><div class="ames-kpi-v">@_items.Sum(i => i.Qty.Values.Sum()).ToString("#,0")</div></div>
    <div class="ames-kpi @(UnmatchedCount > 0 ? "bad" : "")"><div class="ames-kpi-l">@L["PP.Forecast.Kpi.Unmatched"]</div><div class="ames-kpi-v">@UnmatchedCount</div></div>
</div>

<AmesTabs TrailingContent="@MsgBadge">
    <AmesTab Title="@L["PP.Forecast.Tab.Status"].Value">
    <div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.Forecast.Tab.Status"] · @_view.Count @L["Lbl.Items"]@(_view.Count < _items.Count ? $" / {L["Lbl.TotalOf"]} {_items.Count}" : "")</span>
        <span class="dim" style="white-space:nowrap;font-size:.85em;">@L["PP.Forecast.Derived"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_fCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text="@L["PP.Forecast.Fld.Period"]" />
            <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn" title="@L["Btn.PrevWeek"]" Click="() => ShiftWeekly(-1)" />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_fFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_fTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn" title="@L["Btn.NextWeek"]" Click="() => ShiftWeekly(1)" />
            <RadzenLabel Text="@L["Col.PartNo"]" />
            <RadzenTextBox @bind-Value="_fPartNo" @bind-Value:after="ApplyPartNo"
                           Placeholder="@L["PP.Forecast.Fld.PartNoPh"].Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />

            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="Search" />
            <RadzenButton Text="@L["PP.Forecast.Btn.Export"].Value" Icon="download"
                          ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" class="ames-rz-btn" Click="ExportCsv" />
        </RadzenStack>
    </div>

    <div class="ames-grid-virtual">
    @if (_items.Count == 0)
    {
        <div class="ames-empty">@L["PP.Forecast.Empty"]</div>
    }
    else
    {
        <RadzenDataGrid Data="_view" TItem="ItemVm" AllowVirtualization="true" Style="height:100%"
                        AllowSorting="true" EmptyText="@L["Grid.Empty"].Value" AllowColumnResize="true" Density="Density.Compact"
                        AllowFiltering="true" FilterMode="FilterMode.CheckBoxList"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        class="ames-rz-grid">
            <Columns>
                @if (_showCustomerCol)
                {
                    <RadzenDataGridColumn TItem="ItemVm" MinWidth="130px" Property="CustomerId" Title="@L["Col.Customer"].Value"
                                          Frozen="true" Width="130px" />
                }
                <RadzenDataGridColumn TItem="ItemVm" MinWidth="250px" Property="ItemNo" Title="@L["Col.PartNo"].Value"
                                      Frozen="true" Width="250px">
                    <Template Context="it">
                        <span class="code" data-item="@(it.ItemExists ? it.ItemNo : null)">@it.ItemNo</span>
                        @if (!it.ItemExists)
                        {
                            <span class="badge-bad">@L["PP.Forecast.Badge.Unregistered"]</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ItemVm" MinWidth="200px" Property="Name" Title="@L["Col.PartName"].Value" />
                <RadzenDataGridColumn TItem="ItemVm" MinWidth="110px" Property="BaseInv" Title="@L["Col.BaseInv"].Value"
                                      Filterable="false" TextAlign="TextAlign.Right" Width="110px">
                    <Template Context="it">@(it.BaseInv?.ToString("#,0") ?? "—")</Template>
                </RadzenDataGridColumn>
                @foreach (var w in _weeks)
                {
                    var week  = w;
                    var label = _weeks.IndexOf(w) is var k && k < _weekLabels.Count ? _weekLabels[k] : "";
                    <RadzenDataGridColumn TItem="ItemVm" MinWidth="80px" Title="@week.ToString(DateFmt.DateShort)" Sortable="false"
                                          Filterable="false" TextAlign="TextAlign.Right" Width="80px">
                        <HeaderTemplate>
                            <span title="@($"{week.ToString(DateFmt.Date)} {label}")">@week.ToString(DateFmt.DateShort)</span>
                        </HeaderTemplate>
                        <Template Context="it">@(it.Qty.TryGetValue(week, out var q) ? q.ToString("#,0") : "—")</Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
    </div>
    </div>
    </AmesTab>

    <AmesTab Title="@L["PP.Forecast.Tab.Daily"].Value">
    <div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.Forecast.Tab.Daily"] · @L["PP.DemandPlan.Kpi.Items"] @_dItems.Count · @L["PP.DemandPlan.Kpi.Days"] @_dDates.Count · @L["PP.DemandPlan.Kpi.TotalQty"] @UomFmt.Qty(_dItems.Sum(i => i.Qty.Values.Sum()), null) · @L["PP.DemandPlan.Kpi.Unmatched"] @_dItems.Count(i => !i.ItemExists)</span>
        <span class="dim" style="white-space:nowrap;font-size:.85em;">@L["PP.Forecast.Effective.Note"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_dCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text="@L["PP.Forecast.Fld.Period"]" />
            <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn" title="@L["Btn.PrevWeek"]" Click="() => ShiftDaily(-1)" />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_dFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_dTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn" title="@L["Btn.NextWeek"]" Click="() => ShiftDaily(1)" />
            <RadzenLabel Text="@L["Col.PartNo"]" />
            <RadzenTextBox @bind-Value="_dPartNo" @bind-Value:after="ApplyDailyPartNo"
                           Placeholder="@L["PP.Forecast.Fld.PartNoPh"].Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />

            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="SearchDaily" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["PP.DemandPlan.Btn.Sample"].Value" Icon="download"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="DownloadDailySample" />
                <RadzenButton Text="@L["PP.DemandPlan.Btn.Upload"].Value" Icon="upload"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="OpenDailyUpload" />
                <RadzenButton Text="@L["PP.DemandPlan.Btn.Api"].Value" Icon="cloud_download"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="OpenDailySync" />
            }
        </RadzenStack>
    </div>

    <div class="ames-grid-virtual">
    @if (_dItems.Count == 0)
    {
        <div class="ames-empty">@L["PP.DemandPlan.Empty"]</div>
    }
    else
    {
        <RadzenDataGrid Data="_dView" TItem="DailyVm" AllowVirtualization="true" Style="height:100%"
                        AllowSorting="true" EmptyText="@L["Grid.Empty"].Value" AllowColumnResize="true" Density="Density.Compact"
                        AllowFiltering="true" FilterMode="FilterMode.CheckBoxList"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        class="ames-rz-grid">
            <Columns>
                @if (_dShowCustomer)
                {
                    <RadzenDataGridColumn TItem="DailyVm" MinWidth="130px" Property="CustomerId" Title="@L["Col.Customer"].Value"
                                          Frozen="true" Width="130px" />
                }
                <RadzenDataGridColumn TItem="DailyVm" MinWidth="250px" Property="ItemNo" Title="@L["Col.PartNo"].Value"
                                      Frozen="true" Width="250px">
                    <Template Context="it">
                        <span class="code" data-item="@(it.ItemExists ? it.ItemNo : null)">@it.ItemNo</span>
                        @if (!it.ItemExists)
                        {
                            <span class="badge-bad">@L["PP.Forecast.Badge.Unregistered"]</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DailyVm" MinWidth="200px" Property="Name" Title="@L["Col.PartName"].Value" />
                <RadzenDataGridColumn TItem="DailyVm" MinWidth="140px" Title="@L["PP.DemandPlan.Col.Pack"].Value"
                                      Filterable="false" TextAlign="TextAlign.Right" Width="140px">
                    <Template Context="it">
                        @UomFmt.Qty(it.PackQty, it.Unit)
                        @if (it.PackMismatch)
                        {
                            <span class="badge-bad">@L["PP.DemandPlan.Badge.PackMismatch"]</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                @foreach (var d in _dDates)
                {
                    var date = d;
                    <RadzenDataGridColumn TItem="DailyVm" MinWidth="70px" Title="@date.ToString(DateFmt.DateShort)" Sortable="false"
                                          Filterable="false" TextAlign="TextAlign.Right" Width="70px">
                        <Template Context="it">@(it.Qty.TryGetValue(date, out var q) && q != 0 ? UomFmt.Qty(q, it.Unit) : "—")</Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
    </div>
    </div>
    </AmesTab>

    <AmesTab Title="@L["PP.Forecast.Tab.Recon"].Value">
    <div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.Forecast.Tab.Recon"] · @L["PP.Recon.Kpi.Issues"] @_recon.Count</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_rCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text="@L["PP.Forecast.Fld.Period"]" />
            <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn" title="@L["Btn.PrevWeek"]" Click="() => ShiftRecon(-1)" />
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_rFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker NavigationMode="DatePickerNavigationMode.DropDown" @bind-Value="_rTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" class="ames-rz-btn" title="@L["Btn.NextWeek"]" Click="() => ShiftRecon(1)" />
            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="SearchRecon" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["PP.Sample.Btn.DailyPo"].Value" Icon="download"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="DownloadDailyPoSample" />
                <RadzenButton Text="@L["PP.DailyPo.Btn.Upload"].Value" Icon="upload"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="OpenDailyPoUpload" />
            }
        </RadzenStack>
    </div>
    <div class="ames-grid-virtual">
    @if (_recon.Count == 0)
    {
        <div class="ames-empty">@L["PP.Recon.Empty"]</div>
    }
    else
    {
        <RadzenDataGrid Data="_recon" TItem="ReconVm" AllowVirtualization="true" Style="height:100%"
                        AllowSorting="true" EmptyText="@L["Grid.Empty"].Value" AllowColumnResize="true" Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn TItem="ReconVm" Property="Customer" Title="@L["Col.Customer"].Value" MinWidth="130px" />
                <RadzenDataGridColumn TItem="ReconVm" Property="Item" Title="@L["Col.PartNo"].Value" MinWidth="150px" />
                <RadzenDataGridColumn TItem="ReconVm" Property="Date" Title="@L["PP.Recon.Col.Date"].Value" MinWidth="120px">
                    <Template Context="it">@it.Date.ToString(DateFmt.Date)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ReconVm" Property="Po" Title="@L["PP.Recon.Col.Po"].Value" MinWidth="120px">
                    <Template Context="it">@(it.Po?.ToString("#,0.###") ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ReconVm" Property="DailyPo" Title="@L["PP.Recon.Col.DailyPo"].Value" MinWidth="120px">
                    <Template Context="it">@(it.DailyPo?.ToString("#,0.###") ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ReconVm" Property="PlanPo" Title="@L["PP.Recon.Col.PlanPo"].Value" MinWidth="120px">
                    <Template Context="it">@(it.PlanPo?.ToString("#,0.###") ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ReconVm" Property="Issue" Title="@L["PP.Recon.Col.Kind"].Value" MinWidth="260px" />
            </Columns>
        </RadzenDataGrid>
    }
    </div>
    </div>
    </AmesTab>

    <AmesTab Title="@L["PP.Forecast.Tab.History"].Value">
    <div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.Forecast.Tab.History"] · @_history.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_hCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="SearchHistory" />
        </RadzenStack>
    </div>
    <div class="ames-grid-virtual">
    @if (_history.Count == 0)
    {
        <div class="ames-empty">@L["PP.Hist.Empty"]</div>
    }
    else
    {
        <RadzenDataGrid Data="_history" TItem="PpRepository.ImportHistoryRow" AllowVirtualization="true" Style="height:100%"
                        AllowSorting="true" EmptyText="@L["Grid.Empty"].Value" AllowColumnResize="true" Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="Kind" Title="@L["PP.Hist.Col.Kind"].Value" MinWidth="170px">
                    <Template Context="b">@KindName(b.Kind)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="CustomerId" Title="@L["Col.Customer"].Value" MinWidth="120px" />
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="Batch" Title="@L["PP.Hist.Col.Batch"].Value" MinWidth="160px">
                    <Template Context="b"><span class="code">@b.Batch</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="FileName" Title="@L["PP.Hist.Col.File"].Value" MinWidth="180px" />
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="DateFrom" Title="@L["PP.Forecast.Hist.Period"].Value" MinWidth="200px">
                    <Template Context="b">@(b.DateFrom?.ToString(DateFmt.Date) ?? "—") ~ @(b.DateTo?.ToString(DateFmt.Date) ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="RowCount" Title="@L["PP.Hist.Col.Rows"].Value" MinWidth="90px">
                    <Template Context="b">@b.RowCount.ToString("#,0")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="ItemCount" Title="@L["PP.Hist.Col.Items"].Value" MinWidth="90px">
                    <Template Context="b">@b.ItemCount.ToString("#,0")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="ImportedAt" Title="@L["PP.Forecast.Hist.Uploaded"].Value" MinWidth="160px">
                    <Template Context="b">@b.ImportedAt.ToString(DateFmt.DateTime)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="ImportedBy" Title="@L["PP.Hist.Col.By"].Value" MinWidth="180px">
                    <Template Context="b">@(Actors.Display(b.ImportedBy) is { Length: > 0 } ib ? ib : "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PpRepository.ImportHistoryRow" Property="Note" Title="@L["PP.Hist.Col.Note"].Value" MinWidth="220px" />
            </Columns>
        </RadzenDataGrid>
    }
    </div>
    </div>
    </AmesTab>
</AmesTabs>
</div>

@code {
    List<MasterDataRepository.CustomerRow> _customers = new();

    // 일별 발주 · 대조 탭
    string _rCustomer = "";
    DateTime? _rFrom, _rTo;
    List<ReconVm> _recon = new();
    sealed record ReconVm(string Customer, string Item, DateTime Date, decimal? Po, decimal? DailyPo, decimal? PlanPo, string Issue);

    // 예측 현황 조회 필터
    string   _fCustomer = "";
    string   _fPartNo   = "";
    DateTime _fFrom = DbClock.Today;
    DateTime _fTo   = DbClock.Today.AddDays(154);   // 22주

    // 업로드 이력 조회 필터 (업로드 일시 기준, null = 무제한)
    string    _hCustomer = "";
    DateTime? _hFrom;
    DateTime? _hTo;

    // 피벗 표시 모델. CustomerId는 전체 고객 조회에서만 표시.
    record ItemVm(string? CustomerId, string ItemNo, string Name, decimal? BaseInv, bool ItemExists,
                  Dictionary<DateTime, decimal> Qty);
    bool _showCustomerCol;   // 조회 시점 스냅샷 (드롭다운만 바꾸고 조회 안 한 상태와 분리)
    List<DateTime> _weeks = new();
    List<string>   _weekLabels = new();
    List<ItemVm>   _items = new();
    List<ItemVm>   _view  = new();   // Part No 검색 적용된 표시용
    List<PpRepository.ImportHistoryRow> _history = new();

    // 일별 구매계획(MM30011) 탭 — 조회 필터·표시 모델
    record DailyVm(string? CustomerId, string ItemNo, string Name, string? Unit, decimal? PackQty, decimal? PalletQty, bool ItemExists, Dictionary<DateOnly, decimal> Qty)
    { public bool PackMismatch => PackQty is > 0 && PalletQty is > 0 && PackQty != PalletQty; }
    string _dCustomer = "", _dPartNo = "";
    DateTime _dFrom = DbClock.Today, _dTo = DbClock.Today.AddDays(30);
    List<DateOnly> _dDates = new();
    List<DailyVm> _dItems = new(), _dView = new();
    bool _dShowCustomer;

    string _msg = "";
    bool   _isErr;

    int UnmatchedCount => _items.Count(i => !i.ItemExists);

    // 권한 키(SYS_Screen.HRef) — R = 화면 조회, E = 엑셀 업로드
    const string Href = "pp/forecast";
    bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        // 메뉴에서 숨겨도 주소를 직접 치면 열리므로 읽기 권한은 화면에서도 확인한다
        if (!PermSvc.IsVisible(Href)) { Nav.NavigateTo("/unauthorized", replace: true); return; }
        _canEdit = PermSvc.CanEdit(Href);

        try { _customers = MD.ListCustomers().Where(c => PlantCustomers.Contains(c.CustomerID)).ToList(); }
        catch (Exception ex) { ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); }
        Search();
        SearchHistory();
        SearchDaily();
    }

    // 업로드 이력 조회 — 자체 필터(고객사·업로드 일시)로 로드.
    void SearchHistory()
    {
        try   { _history = Pp.ListImportHistory(string.IsNullOrEmpty(_hCustomer) ? null : _hCustomer); }
        catch (Exception ex) { _history = new(); ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); }
    }

    // ── 일별 구매계획(MM30011) 조회 ──────────────────────────────
    void SearchDaily()
    {
        List<PpRepository.DemandPlanCellRow> cells;
        try   { cells = Pp.ListEffectiveDaily(string.IsNullOrEmpty(_dCustomer) ? null : _dCustomer, DateOnly.FromDateTime(_dFrom), DateOnly.FromDateTime(_dTo))
                .Select(e => new PpRepository.DemandPlanCellRow(e.CustomerId, e.ItemNo, e.ItemName, e.PartName, e.Unit, e.PackQty, e.PalletQty,
                                                                e.PlanDate, e.Qty, 0m, e.ItemExists)).ToList(); }
        catch (Exception ex) { ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); cells = new(); }
        _dShowCustomer = string.IsNullOrEmpty(_dCustomer);
        _dDates = cells.Select(c => c.PlanDate).Distinct().Order().ToList();
        _dItems = cells.GroupBy(c => (c.CustomerId, c.ItemNo))
            .Select(g => new DailyVm(g.Key.CustomerId, g.Key.ItemNo, g.First().ItemName ?? g.First().PartName ?? g.Key.ItemNo, g.First().Unit,
                g.First().PackQty, g.First().PalletQty, g.First().ItemExists, g.ToDictionary(c => c.PlanDate, c => c.ScheduledQty)))
            .OrderBy(i => i.CustomerId).ThenBy(i => i.ItemNo).ToList();
        ApplyDailyPartNo();
    }

    void ApplyDailyPartNo() => _dView = string.IsNullOrWhiteSpace(_dPartNo) ? _dItems
        : _dItems.Where(i => i.ItemNo.Contains(_dPartNo, StringComparison.OrdinalIgnoreCase) || i.Name.Contains(_dPartNo, StringComparison.OrdinalIgnoreCase)).ToList();


