@page "/pp/supply-plan-import"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.PpRepository Pp
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Web.Services.PermissionService PermSvc
@inject NavigationManager Nav
@inject DialogService Dialog
@inject AuthenticationStateProvider AuthPrvd
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.SupplyPlanImport.Title"] · AMES</PageTitle>

<AmesPageHeader Code="PP-002" TitleKey="PP.SupplyPlanImport.Title" />

<div class="ames-page-fill">
@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat" AllowClose="false">@_msg</RadzenAlert>
}

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["PP.SupplyPlanImport.Kpi.Imported"]</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["PP.SupplyPlanImport.Kpi.Selected"]</div><div class="ames-kpi-v">@_selected.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["PP.SupplyPlanImport.Kpi.Confirmed"]</div><div class="ames-kpi-v">@_rows.Count(r => r.Status == "Confirmed")</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["PP.SupplyPlanImport.Kpi.Open"]</div><div class="ames-kpi-v">@_rows.Count(r => r.Status == "Open")</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["PP.SupplyPlanImport.Kpi.TotalQty"]</div><div class="ames-kpi-v">@_rows.Sum(r => r.OrderQty).ToString("#,0")</div></div>
</div>

<div class="ames-card ames-card-fill">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.SupplyPlanImport.Title"] · @_view.Count @L["Lbl.Items"]@(_view.Count < _rows.Count ? $" / {L["Lbl.TotalOf"]} {_rows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Customer"]" />
            <RadzenDropDown AllowFiltering="true" Data="_customers" TextProperty="CustomerName" ValueProperty="CustomerID"
                            @bind-Value="_fCustomer" AllowClear="true" Placeholder="@L["Filter.All"].Value"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />
            <RadzenLabel Text='@($"{L["Col.Order"]} {L["PP.Forecast.Fld.Period"]}")' />
            <RadzenDatePicker @bind-Value="_fFrom" DateFormat="MM/dd/yyyy" AllowClear="true"
                              Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <span class="dim">~</span>
            <RadzenDatePicker @bind-Value="_fTo" DateFormat="MM/dd/yyyy" AllowClear="true"
                              Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px" />
            <RadzenLabel Text="@L["Col.Status"]" />
            <RadzenDropDown Data="_statuses" @bind-Value="_fStatus" @bind-Value:after="ApplyFilters"
                            AllowClear="true" Placeholder="@L["Filter.All"].Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px" />
            <RadzenLabel Text='@($"{L["Col.SoNo"]} / {L["Col.PartNo"]}")' />
            <RadzenTextBox @bind-Value="_fText" @bind-Value:after="ApplyFilters"
                           Placeholder="—" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px" />

            <RadzenButton Text="@L["Btn.Search"].Value" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" Click="Search" />
            @if (_canEdit)
            {
                <RadzenButton Text="@string.Format(L["PP.SupplyPlanImport.Btn.ConfirmSel"].Value, _selected.Count)"
                              Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" class="ames-rz-btn"
                              Disabled="@(_selected.Count == 0)" Click="ConfirmSelected" />
                <RadzenButton Text="@L["PP.SupplyPlanImport.Btn.Upload"].Value" Icon="upload"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="OpenUpload" />
                <RadzenButton Text="@L["PP.SupplyPlanImport.Btn.ApiImport"].Value" Icon="cloud_download"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" class="ames-rz-btn" Click="OpenApiImport" />
            }
            <RadzenButton Text="@L["PP.SupplyPlanImport.Btn.Export"].Value" Icon="download"
                          ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" class="ames-rz-btn" Click="ExportCsv" />
        </RadzenStack>
    </div>

<div class="ames-grid-virtual">
@if (_rows.Count == 0)
{
    <div class="ames-empty">@L["PP.SupplyPlanImport.Empty"]</div>
}
else
{
    <RadzenDataGrid Data="_view" TItem="PpRepository.SoRow" AllowVirtualization="true" Style="height:100%"
                    AllowSorting="true" EmptyText="@L["Grid.Empty"].Value" AllowColumnResize="true" Density="Density.Compact"
                    AllowFiltering="true" FilterMode="FilterMode.CheckBoxList"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    class="ames-rz-grid">
        <Columns>
            @* 선택은 확정 버튼에만 쓰이므로 E 권한이 없으면 열 자체를 내린다 *@
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Width="46px" Sortable="false" Visible="@_canEdit"
                                  Filterable="false" TextAlign="TextAlign.Center" Frozen="true">
                <HeaderTemplate>
                    <input type="checkbox" class="spi-ck" checked="@AllSelected"
                           @onchange="e => ToggleAll((bool)(e.Value ?? false))" />
                </HeaderTemplate>
                <Template Context="r">
                    <input type="checkbox" class="spi-ck" disabled="@(!IsOpen(r))"
                           checked="@_selected.Contains(r.SoId)"
                           @onchange="e => ToggleRow(r.SoId, (bool)(e.Value ?? false))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="SoNumber" Title="@L["Col.SoNo"].Value"
                                  Frozen="true" Width="140px">
                <Template Context="r"><span class="code">@r.SoNumber</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="SoLineNo" Title="@L["Col.Line"].Value"
                                  TextAlign="TextAlign.Right" Width="80px" />
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="CustomerId" Title="@L["Col.Customer"].Value"
                                  Width="130px" />
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="ItemNo" Title="@L["Col.PartNo"].Value" Width="240px">
                <Template Context="r">
                    <span class="code">@r.ItemNo</span>
                    @if (!r.ItemExists)
                    {
                        <span class="badge-bad">@L["PP.Forecast.Badge.Unregistered"]</span>
                    }
                    @if (!string.IsNullOrEmpty(r.ItemName))
                    {
                        <span class="dim"> · @r.ItemName</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="OrderQty" Title="@L["Col.Order"].Value"
                                  Filterable="false" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@r.OrderQty.ToString("#,0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="ShippedQty" Title="@L["Col.Ship"].Value"
                                  Filterable="false" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@r.ShippedQty.ToString("#,0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="RequestedDeliveryDate" Title="@L["Col.Requested"].Value"
                                  Filterable="false" Width="120px">
                <Template Context="r">
                    @if (r.RequestedDeliveryDate is DateTime d)
                    {
                        <span style="@(IsUrgent(d) ? "color:#f87171;font-weight:600;" : "")">@d.ToString("yyyy-MM-dd")</span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="PromisedDate" Title="@L["Col.Promised"].Value"
                                  Filterable="false" Width="120px">
                <Template Context="r"><span class="dim">@(r.PromisedDate?.ToString("yyyy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Property="Status" Title="@L["Col.Status"].Value" Width="100px">
                <Template Context="r">
                    <span class="pill @(r.Status == "Confirmed" ? "ok" : "warn")">@r.Status</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Title="@L["PP.SupplyPlanImport.Col.Wo"].Value"
                                  Filterable="false" Sortable="false" Width="180px">
                <Template Context="r">
                    @if (!string.IsNullOrEmpty(r.WoNumber))
                    {
                        <span class="code">@r.WoNumber</span> <span class="pill info">@r.WoStatus</span>@if (r.WoCount > 1) { <span class="dim" title="@string.Format(L["PP.SupplyPlanImport.WoMoreTip"].Value, r.WoCount)"> +@(r.WoCount - 1)</span> }
                    }
                    else if (r.Status == "Confirmed")
                    {
                        <span class="pill info">@L["PP.SupplyPlanImport.WoLink.Awaiting"]</span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PpRepository.SoRow" Title="@L["PP.SupplyPlanImport.Col.Action"].Value"
                                  Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r">
                    @if (_canEdit && r.Status == "Open")
                    {
                        <RadzenButton Text="@L["Btn.Confirm"].Value" Icon="check" ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.ExtraSmall" Click="@(() => Confirm(r.SoId))" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <Template Context="r">
            <div style="display:flex;gap:32px;flex-wrap:wrap;padding:8px 14px;">
                <div>
                    <div class="dim" style="font-size:.8em;">@L["PP.SupplyPlanImport.Detail.DDay"]</div>
                    @{ var dd = DaysTo(r.RequestedDeliveryDate); }
                    @if (dd is int n)
                    {
                        <div style="@(n <= 14 ? "color:#f87171;font-weight:600;" : "")">@(n >= 0 ? $"D-{n}" : $"D+{-n}")</div>
                    }
                    else { <div class="dim">—</div> }
                </div>
                <div>
                    <div class="dim" style="font-size:.8em;">@L["Col.Order"] / @L["Col.Ship"]</div>
                    <div>@r.OrderQty.ToString("#,0") / @r.ShippedQty.ToString("#,0")</div>
                </div>
                <div>
                    <div class="dim" style="font-size:.8em;">@L["PP.SupplyPlanImport.Detail.WoStatus"]</div>
                    <div>@(string.IsNullOrEmpty(r.WoNumber) ? "—" : $"{r.WoNumber} · {r.WoStatus}")</div>
                </div>
            </div>
        </Template>
    </RadzenDataGrid>
}
</div>
</div>
</div>

@code {
    List<MasterDataRepository.CustomerRow> _customers = new();

    string    _fCustomer = "";
    string    _fText     = "";
    string    _fStatus   = "";
    DateTime? _fFrom;
    DateTime? _fTo;

    readonly string[] _statuses = { "Open", "Confirmed" };

    List<PpRepository.SoRow> _rows = new();   // 조회 결과
    List<PpRepository.SoRow> _view = new();   // 텍스트·상태 필터 적용 표시용
    HashSet<int> _selected = new();           // 체크된 SoID

    string _msg = "";
    bool   _isErr;

    static bool IsOpen(PpRepository.SoRow r) => r.Status == "Open";
    IEnumerable<PpRepository.SoRow> Selectable => _view.Where(IsOpen);
    bool AllSelected => Selectable.Any() && Selectable.All(r => _selected.Contains(r.SoId));

    // 권한 키(SYS_Screen.HRef) — R = 화면 조회, E = 업로드·수주 확정
    const string Href = "pp/supply-plan-import";
    bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        await PermSvc.EnsureAsync(AuthPrvd);
        // 메뉴에서 숨겨도 주소를 직접 치면 열리므로 읽기 권한은 화면에서도 확인한다
        if (!PermSvc.IsVisible(Href)) { Nav.NavigateTo("/unauthorized", replace: true); return; }
        _canEdit = PermSvc.CanEdit(Href);

        try { _customers = MD.ListCustomers(); } catch { }
        Search();
    }

    void Search()
    {
        try   { _rows = Pp.ListCustomerOrders(_fCustomer ?? "", _fFrom, _fTo); }
        catch (Exception ex) { ShowMsg(string.Format(L["Err.LoadFailed"].Value, ex.Message), true); _rows = new(); }
        _selected.RemoveWhere(id => !_rows.Any(r => r.SoId == id && IsOpen(r)));
        ApplyFilters();
    }

    // SO 번호 / 품번·품명 부분일치 + 상태 클라이언트 필터.
    void ApplyFilters()
    {
        IEnumerable<PpRepository.SoRow> q = _rows;

        if (!string.IsNullOrWhiteSpace(_fText))
            q = q.Where(r =>
                (r.SoNumber?.Contains(_fText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                r.ItemNo.Contains(_fText, StringComparison.OrdinalIgnoreCase) ||
                (r.ItemName?.Contains(_fText, StringComparison.OrdinalIgnoreCase) ?? false));

        if (!string.IsNullOrEmpty(_fStatus))
            q = q.Where(r => r.Status == _fStatus);

        _view = q.ToList();
    }

    static int? DaysTo(DateTime? d) => d is DateTime x ? (x.Date - DbClock.Today).Days : null;
    static bool IsUrgent(DateTime d) => (d.Date - DbClock.Today).Days <= 14;

    async Task Confirm(int soId)
    {
        if (!_canEdit) return;   // 버튼을 숨겨도 핸들러에서 한 번 더 막는다

        try
        {
            var auth  = await AuthPrvd.GetAuthenticationStateAsync();
            var actor = auth.User.Identity?.Name ?? "system";
            var n = Pp.ConfirmCustomerOrder(soId, actor);
            if (n > 0) ShowMsg(L["PP.SupplyPlanImport.Ok.Confirmed"].Value, false);
            Search();
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    void ToggleRow(int soId, bool on)
    {
        if (on) _selected.Add(soId); else _selected.Remove(soId);
    }

    void ToggleAll(bool on)
    {
        foreach (var r in Selectable)
            if (on) _selected.Add(r.SoId); else _selected.Remove(r.SoId);
    }

    async Task ConfirmSelected()
    {
        if (!_canEdit) return;

        var ids = _rows.Where(r => _selected.Contains(r.SoId) && IsOpen(r)).Select(r => r.SoId).ToList();
        if (ids.Count == 0) { ShowMsg(L["PP.SupplyPlanImport.Err.NoneSelected"], true); return; }

        try
        {
            var auth  = await AuthPrvd.GetAuthenticationStateAsync();
            var actor = auth.User.Identity?.Name ?? "system";
            var n = ids.Sum(id => Pp.ConfirmCustomerOrder(id, actor));
            _selected.Clear();
            ShowMsg(string.Format(L["PP.SupplyPlanImport.Ok.ConfirmedN"].Value, n), false);
            Search();
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    async Task OpenUpload()
    {
        if (!_canEdit) return;

        var result = await Dialog.OpenAsync<SupplyPlanImportUploadDialog>(
            L["PP.SupplyPlanImport.Upload.Title"].Value,
            new Dictionary<string, object?> { ["Customers"] = _customers });

        if (result is SupplyPlanImportUploadDialog.Result r)
        {
            ShowMsg(string.Format(L["PP.SupplyPlanImport.Ok.Imported"].Value, r.Ins, r.Upd), false);
            _fCustomer = r.CustomerId;
            _fFrom = null; _fTo = null;
            Search();
        }
    }

    async Task OpenApiImport()
    {
        if (!_canEdit) return;

        var result = await Dialog.OpenAsync<SupplyPlanImportApiDialog>(L["PP.SupplyPlanImport.Api.Title"].Value);

        if (result is AMES.Data.Services.PoSync.PoSyncRunResult { Ok: true } r)
            ShowMsg(string.Format(L["PP.SupplyPlanImport.Ok.Imported"].Value, r.Inserted, r.Updated), false);
        // X 로 닫으면 결과가 안 넘어온다 — 실행했을 수 있으니 항상 다시 읽는다
        Search();
    }

    async Task ExportCsv()
    {
        if (_rows.Count == 0) { ShowMsg(L["PP.SupplyPlanImport.Err.NoExport"], true); return; }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(",", new[] {
            L["Col.SoNo"].Value, L["Col.Line"].Value, L["Col.Customer"].Value,
            L["Col.PartNo"].Value, L["Col.PartName"].Value, L["Col.Order"].Value, L["Col.Ship"].Value,
            L["Col.Requested"].Value, L["Col.Promised"].Value, L["Col.Status"].Value }.Select(Csv)));

        foreach (var r in _rows)
        {
            sb.AppendLine(string.Join(",", new[] {
                r.SoNumber ?? "", r.SoLineNo?.ToString() ?? "", r.CustomerId ?? "",
                r.ItemNo, r.ItemName ?? "", r.OrderQty.ToString("0.###"), r.ShippedQty.ToString("0.###"),
                r.RequestedDeliveryDate?.ToString("yyyy-MM-dd") ?? "",
                r.PromisedDate?.ToString("yyyy-MM-dd") ?? "", r.Status ?? "" }.Select(Csv)));
        }

        var bytes = System.Text.Encoding.UTF8.GetPreamble()
            .Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var name = $"SupplyPlanImport_{DbClock.Now:yyyyMMdd_HHmmss}.csv";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes), "text/csv");
        ShowMsg(string.Format(L["PP.SupplyPlanImport.Ok.Exported"].Value, _rows.Count), false);
    }

    static string Csv(string s) =>
        s.Contains(',') || s.Contains('"') || s.Contains('\n') ? $"\"{s.Replace("\"", "\"\"")}\"" : s;

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
