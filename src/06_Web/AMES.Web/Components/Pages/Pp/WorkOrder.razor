@page "/pp/work-order"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.WorkOrderRepository Wos

<PageTitle>PP-04 Work Order · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">PP-04</div>
    <div class="ames-page-t">Work Order</div>
    <div class="ames-page-sub">생산 작업 지시 · 라인별 진행률</div>
</div>

<div class="ames-card">
    <div class="ames-card-h">▼ ALL WORK ORDERS (@_rows.Count)</div>
    @if (_rows.Count == 0)
    {
        <div class="ames-empty">No work orders.</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>WO No</th><th>Item</th><th>Line</th>
                    <th class="num">Order</th><th class="num">Done</th><th class="num">%</th>
                    <th>Due</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in _rows)
                {
                    <tr>
                        <td class="code">@w.WoNumber</td>
                        <td>@(w.ItemNameEn ?? w.ItemName ?? w.ItemNo)</td>
                        <td>@w.LineId</td>
                        <td class="num">@w.OrderQty.ToString("0")</td>
                        <td class="num">@w.CompletedQty.ToString("0")</td>
                        <td class="num">@((int)Math.Clamp(w.ProgressPct, 0, 100))</td>
                        <td class="dim">@(w.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@w.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Contracts.Dto.WorkOrderDto> _rows = new();
    protected override void OnInitialized()
    {
        try
        {
            // Pull all lines we currently care about.
            var lines = new[] { "LINE-INJ-01", "LINE-INJ-02", "LINE-IMG-01", "LINE-PNT-01" };
            _rows = lines.SelectMany(l => Wos.ListForLine(l)).OrderBy(w => w.WoNumber).ToList();
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[PP-04] {ex.Message}"); }
    }
}
