@inject AMES.Data.Repositories.WorkOrderRepository Wos
@inject AuthenticationStateProvider AuthPrvd
@inject DialogService Dialog
@inject IStringLocalizer<SharedResources> L

<div style="display:flex;flex-direction:column;gap:6px;min-width:440px;">
    <label>① @L["PP.WorkOrder.Manual.Item"]</label>
    <RadzenDropDown Data="Items" TextProperty="Label" ValueProperty="ItemNo"
                    @bind-Value="_item" Disabled="_busy" AllowFiltering="true" AllowClear="true"
                    Placeholder="—" Style="width:100%" />

    <label>② @L["PP.WorkOrder.Manual.Qty"]</label>
    <RadzenNumeric TValue="decimal" @bind-Value="_qty" Min="1" Disabled="_busy" Style="width:100%" />

    <label>③ @L["PP.WorkOrder.Manual.Due"]</label>
    <RadzenDatePicker @bind-Value="_due" DateFormat="MM/dd/yyyy" Disabled="_busy" Style="width:100%" />

    <span class="dim" style="font-size:.8em;line-height:1.5;margin-top:2px;">@L["PP.WorkOrder.Manual.Hint"]</span>

    @if (SelectedNoRouting)
    {
        <div class="ames-alert bad">@L["PP.WorkOrder.Err.NoRouting"]</div>
    }
    else if (!string.IsNullOrEmpty(_err))
    {
        <div class="ames-alert bad">@_err</div>
    }

    <div class="ames-modal-footer">
        <RadzenButton Text="@L["Btn.Cancel"]" ButtonStyle="ButtonStyle.Light" Disabled="_busy"
                      Click="@(() => Dialog.Close(null))" />
        <RadzenButton Text="@(_busy ? L["Lbl.Loading"].Value : L["PP.WorkOrder.Manual.Create"].Value)"
                      Icon="add" Disabled="@(_busy || string.IsNullOrEmpty(_item) || _qty < 1 || SelectedNoRouting)"
                      Click="Create" />
    </div>
</div>

@code {
    [Parameter] public List<ItemVm> Items { get; set; } = new();

    string    _item = "";
    decimal   _qty  = 1;
    DateTime? _due  = DateTime.Today.AddDays(14);
    bool      _busy;
    string    _err = "";

    public sealed record ItemVm(string ItemNo, string Label, string? RoutingType);

    bool SelectedNoRouting =>
        !string.IsNullOrEmpty(_item) && Items.FirstOrDefault(i => i.ItemNo == _item)?.RoutingType is null;

    async Task Create()
    {
        if (string.IsNullOrEmpty(_item) || _qty < 1) { _err = L["PP.WorkOrder.Err.ManualInvalid"]; return; }
        if (SelectedNoRouting) { _err = L["PP.WorkOrder.Err.NoRouting"]; return; }
        _busy = true;
        try
        {
            var auth  = await AuthPrvd.GetAuthenticationStateAsync();
            var actor = auth.User.Identity?.Name ?? "system";
            var wo = Wos.CreateManualWo(_item, _qty, _due, actor);
            if (string.IsNullOrEmpty(wo)) { _err = L["PP.WorkOrder.Err.NoRouting"]; _busy = false; return; }
            Dialog.Close(new Result(wo));
        }
        catch (Exception ex) { _err = ex.Message; _busy = false; }
    }

    public record Result(string WoNumber);
}
