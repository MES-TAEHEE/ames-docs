@using AMES.Contracts.Dto
@inject AMES.Data.Repositories.WorkOrderRepository Wos
@inject DialogService Dialog
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS
@inject AMES.Web.Services.ActorNames Actors
@implements IAsyncDisposable
@using AMES.Data.Services

@* 작업지시 한 건의 내용·현재 상태·계획 → 실행 연결을 보여 주는 팝업. 수주(PP-002)·APS 등 WO 번호가 보이는 화면에서 연다. *@
<div class="@(_mode == "flow" ? "ames-flow-fill" : null)" style="min-width:640px;font-size:1em;@(_mode == "flow" ? "display:flex;flex-direction:column;" : "")">
@if (_wo is null)
{
    <div class="dim" style="padding:12px;">@L["PP.WoDetail.NotFound"]</div>
}
else
{
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap;">
        <span class="pill @StatusClass(_wo.Status)">@_wo.Status</span>
        <span class="pill info">@SourceText()</span>
        @if (_wo.TerminalLock is { Length: > 0 }) { <span class="pill warn" title="@L["PP.WoDetail.Lock"]">🔒 @_wo.TerminalLock</span> }
    </div>

    <LinkedDocChips WoNumber="@_wo.WoNumber" />

    <div style="margin-bottom:10px;">
        <RadzenSelectBar TValue="string" Value="@_mode" ValueChanged="@OnModeChanged" Size="ButtonSize.Small">
            <Items>
                <RadzenSelectBarItem Text="@L["PP.WoDetail.Mode.Detail"].Value" Value="@("detail")" />
                <RadzenSelectBarItem Text="@L["PP.WoDetail.Mode.Flow"].Value" Value="@("flow")" />
            </Items>
        </RadzenSelectBar>
    </div>

    @if (_mode == "flow")
    {
        <link rel="stylesheet" href="@(Nav.BaseUri)js/wo-flow/wo-flow.css" />
        @* <div id="@_flowId" class="ames-flow-host" style="flex:1 1 0;min-height:440px;width:100%;"></div> *@
        <div id="@_flowId" class="ames-flow-host" style="flex:1 1 0;min-height:440px;width:100%;"></div>
        <div class="dim" style="font-size:.8em;margin-top:4px;">@(_live ? "● " : "")@string.Format(L["PP.WoDetail.Flow.Live"].Value, RefreshSec, _updatedAt.ToString("HH:mm:ss"))</div>
        @if (!string.IsNullOrEmpty(_flowError)) { <div style="color:var(--ames-tx-red-400);">@_flowError</div> }
    }
    else
    {
    <div class="ipk-top" style="margin-bottom:12px;">
        <div class="ipk-stock">
            <div class="ipk-tl">@L["Col.Progress"]</div>
            <div class="ipk-big">@((int)_wo.ProgressPct)<span class="ipk-unit">%</span></div>
            <RadzenProgressBar Value="@Math.Min(100d, (double)_wo.ProgressPct)" ShowValue="false" Style="height:8px;" />
            <div class="ipk-stock-sub">@L["Col.Order"] @_wo.OrderQty.ToString("#,0")
                <span class="ipk-sep">·</span> @L["PP.WoDetail.Done"] @_wo.CompletedQty.ToString("#,0")
                <span class="ipk-sep">·</span> @L["PP.WoDetail.Open"] @_wo.OpenQty.ToString("#,0")</div>
        </div>
        <div class="ipk-info">
            <div class="ipk-k">@L["Col.PartNo"]</div><div class="ipk-v code" data-item="@_wo.ItemNo">@_wo.ItemNo</div>
            <div class="ipk-k">@L["PP.PlanConfirm.Col.Due"]</div><div class="ipk-v">@(_wo.DueDate?.ToString(DateFmt.Date) ?? "—")</div>
            <div class="ipk-k"></div><div class="ipk-v dim" style="font-weight:400;">@_wo.ItemName</div>
            <div class="ipk-k">@L["PP.WorkOrder.Detail.ProdDeadline"]</div><div class="ipk-v">@(_wo.ProdDeadline?.ToString(DateFmt.Date) ?? "—")</div>
            <div class="ipk-k">SAP SO</div><div class="ipk-v">@(_wo.SoNumber ?? "—")</div>
            <div class="ipk-k">@L["PP.WoDetail.Priority"]</div><div class="ipk-v">@_wo.Priority</div>
            <div class="ipk-k">@L["Col.Routing"]</div><div class="ipk-v">@(_wo.RoutingType ?? "INJ") · @(_wo.RouteLines ?? "—")</div>
            <div class="ipk-k">@L["PP.WoDetail.Mold"]</div><div class="ipk-v">@(_wo.MoldId ?? "—")</div>
        </div>
    </div>

    <div class="ipk-sub">@L["PP.WoDetail.Order.Title"]</div>
    @if (_order is { } od)
    {
        var remain = Math.Max(0m, od.OrderQty - od.ShippedQty);
        <div class="ipk-info wod-order" style="margin:4px 0 12px;">
            <div class="ipk-k">@L["PP.WoDetail.Order.SoNo"]</div><div class="ipk-v code">@od.SoNumber@(od.SoLineNo is int sl ? "-" + sl : "")  <span class="pill info">@od.Status</span></div>
            <div class="ipk-k">@L["Col.Customer"]</div><div class="ipk-v">@od.CustomerId <span class="dim">@od.CustomerName</span></div>
            <div class="ipk-k">@L["Col.PartNo"]</div><div class="ipk-v"><span class="code" data-item="@od.ItemNo">@od.ItemNo</span> <span class="dim">@od.ItemName</span></div>
            <div class="ipk-k">@L["PP.WoDetail.Order.OrderDate"]</div><div class="ipk-v">@(od.OrderDate?.ToString(DateFmt.Date) ?? "—")</div>
            <div class="ipk-k">@L["PP.WoDetail.Order.Requested"]</div><div class="ipk-v"><b>@(od.RequestedDeliveryDate?.ToString(DateFmt.Date) ?? "—")</b></div>
            <div class="ipk-k">@L["PP.WoDetail.Order.Promised"]</div><div class="ipk-v">@(od.PromisedDate?.ToString(DateFmt.Date) ?? "—")</div>
            <div class="ipk-k">@L["PP.WoDetail.Order.Qty"]</div><div class="ipk-v"><b>@od.OrderQty.ToString("#,0")</b> <span class="dim">· @L["PP.WoDetail.Order.Shipped"] @od.ShippedQty.ToString("#,0") · @L["PP.WoDetail.Order.Remain"] @remain.ToString("#,0")</span></div>
            <div class="ipk-k" style="grid-column:1;">@L["PP.WoDetail.Order.Issued"]</div><div class="ipk-v" style="white-space:normal;grid-column: span 3;">@od.WoQtyTotal.ToString("#,0") <span class="dim">(@string.Format(L["PP.WoDetail.Order.WoCountFmt"].Value, od.WoCount) · @L["PP.WoDetail.Order.ThisWo"] @od.ThisWoQty.ToString("#,0"))</span>
                @if (od.WoQtyTotal < remain + od.ShippedQty) { <span class="pill warn">@string.Format(L["PP.WoDetail.Order.NotIssuedFmt"].Value, (od.OrderQty - od.WoQtyTotal).ToString("#,0"))</span> }</div>
        </div>
    }
    else
    {
        <div class="dim" style="margin:4px 0 12px;">@L["PP.WoDetail.Order.None"]</div>
    }

    <div class="ipk-sub">@L["PP.WoDetail.Steps"] · @_steps.Count</div>
    @if (_steps.Count == 0)
    {
        <div class="dim" style="margin:4px 0 12px;">—</div>
    }
    else
    {
        <div class="ipk-tree wod-tree" style="margin:4px 0 12px;">
            <div class="ipk-row wod-row ipk-head">
                <span>@L["PP.WoDetail.Step"]</span><span>@L["Col.Line"]</span><span>@L["Col.PartNo"]</span><span>@L["Col.Status"]</span><span>@L["PP.WoDetail.Operator"]</span><span class="r">@L["PP.WoDetail.Done"]</span>
            </div>
            @foreach (var s in _steps)
            {
                <div class="ipk-row wod-row">
                    <span>@s.StepSeq · @s.ProcessCode</span>
                    <span>@(s.LineId ?? "—")</span>
                    <span class="code">@s.ItemNo</span>
                    <span><span class="pill @StatusClass(s.Status)">@s.Status</span></span>
                    <span>@OperatorCell(s.LineId)</span>
                    <span class="r">@s.CompletedQty.ToString("#,0") / @_wo.OrderQty.ToString("#,0")</span>
                </div>
            }
        </div>
    }

    @if (_trace is { } t)
    {
        <div class="ipk-sub">@L["PP.WorkOrder.Trace.Title"]</div>
        <div class="ipk-info wod-trace" style="margin-top:4px;">
            <div class="ipk-k">@L["PP.WorkOrder.Trace.Plan"]</div>
            <div class="ipk-v" style="white-space:normal;">
                @if (t.SourceType == "APS" && int.TryParse(t.SourceRef, out var runId))
                {
                    <a href="/pp/aps-plan?run=@runId" @onclick="Dialog.Close">APS @L["PP.WorkOrder.Trace.Run"] #@runId</a>
                    <span class="dim"> · @(t.ApsStatus ?? "—")</span>
                }
                else { <span>@SourceText() @(t.SourceRef is { Length: > 0 } ? "· " + t.SourceRef : "")</span> }
            </div>
            <div class="ipk-k">@L["PP.WorkOrder.Trace.Slots"]</div>
            <div class="ipk-v" style="white-space:normal;">@t.SlotCount @L["PP.WorkOrder.Trace.SlotUnit"] · @t.SlotQty.ToString("#,0") EA
                @if (t.SlotFrom is not null) { <span class="dim"> · @t.SlotFrom.Value.ToString(DateFmt.Date)@(t.SlotTo != t.SlotFrom ? " ~ " + t.SlotTo?.ToString(DateFmt.Date) : "")</span> }</div>
            <div class="ipk-k">@L["PP.WorkOrder.Trace.Result"]</div>
            <div class="ipk-v" style="white-space:normal;grid-column: span 3;">@L["PP.WorkOrder.Trace.Good"] @t.GoodQty.ToString("#,0") · @L["PP.WorkOrder.Trace.Defect"] @t.DefectCount · LOT @t.LotCount</div>
        </div>
    }
    }
}
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:8px;flex:none;">
        @if (_wo is not null)
        {
            <RadzenButton Text="@L["PP.WoDetail.OpenWo"]" Icon="open_in_new" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="OpenWorkOrder" class="ames-rz-btn" />
        }
        <RadzenButton Text="@L["Btn.Close"]" Icon="close" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => Dialog.Close())" class="ames-rz-btn" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string WoNumber { get; set; } = "";

    string _mode = "detail";
    readonly string _flowId = "wo-flow-" + Guid.NewGuid().ToString("N")[..8];
    IJSObjectReference? _mod;
    bool _flowPending;

    async Task OnModeChanged(string mode)
    {
        _mode = mode;
        _flowPending = mode == "flow";
        await Task.CompletedTask;
    }

    // 「흐름」 보기 — React Flow(번들 js/wo-flow/wo-flow.js)에 그래프를 넘겨 그린다. 요소가 그려진 뒤에 부른다.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_flowPending || _wo is null) return;
        _flowPending = false;
        try
        {
            _mod ??= await JS.InvokeAsync<IJSObjectReference>("import", $"{Nav.BaseUri}js/wo-flow/wo-flow.js?v=20261117b");
            var graph = BuildGraph();
            await _mod.InvokeVoidAsync("render", _flowId, graph, new { fit = L["PP.WoDetail.Flow.Fit"].Value, running = L["PP.WoDetail.Flow.ShowRunning"].Value, hint = L["PP.WoDetail.Flow.Hint"].Value, fullscreen = L["PP.WoDetail.Flow.Fullscreen"].Value, exitFullscreen = L["PP.WoDetail.Flow.ExitFullscreen"].Value }, _self ??= DotNetObjectReference.Create(this));
            StartLive();
        }
        catch (Exception ex) { _flowError = ex.Message; StateHasChanged(); }
    }
    string? _flowError;

    // 실시간 — 팝업이 열려 있는 동안 RefreshSec 마다 DB 에서 다시 읽어 상태·수량을 갱신한다(POP 화면의 5초 갱신과 같은 주기).
    // 진행 중 단계가 바뀌면 그 노드가 바로 강조된다. 사용자가 옮긴 노드 위치·화면은 그대로 둔다.
    const int RefreshSec = 5;
    DateTime _updatedAt = DateTime.Now;
    bool _live;
    CancellationTokenSource? _cts;

    void StartLive()
    {
        if (_cts is not null) return;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(RefreshSec));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                    await InvokeAsync(async () => await RefreshAsync());
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    async Task RefreshAsync()
    {
        if (_wo is null) return;
        try
        {
            var wo = Wos.GetByNumber(WoNumber);
            if (wo is null) return;
            _wo = wo;
            _steps = Wos.ListSteps(wo.WoId);
            _trace = Wos.GetTrace(wo.WoId);
            _ops = Wos.ListStepOperators(wo.WoId);
            _lots = Wos.ListWoLots(wo.WoId);
            _stepTrace = Wos.ListStepTrace(wo.WoId);
            _order = Wos.GetWoOrderInfo(WoNumber);
            _updatedAt = DateTime.Now;
            _live = _steps.Any(s => s.Status == "In Progress") || wo.Status == "In Progress";
            if (_mode == "flow" && _mod is not null)
                await _mod.InvokeVoidAsync("update", _flowId, BuildGraph());
            StateHasChanged();
        }
        catch { /* 일시 오류는 다음 주기에 다시 읽는다 */ }
    }

    WoFlowGraph.Graph BuildGraph() => WoFlowGraph.Build(_wo!, _steps, _trace, new WoFlowGraph.Texts(
        L["PP.WorkOrder.Trace.So"].Value, L["PP.WorkOrder.Trace.Plan"].Value, L["PP.WorkOrder.Trace.Wo"].Value, L["PP.WoDetail.Step"].Value,
        L["PP.WorkOrder.Trace.Slots"].Value, L["PP.WorkOrder.Trace.Result"].Value, L["PP.WorkOrder.Trace.Good"].Value,
        L["PP.WorkOrder.Trace.Defect"].Value, L["PP.WorkOrder.Trace.SlotUnit"].Value, L["PP.WorkOrder.Trace.Run"].Value,
        L["PP.WoDetail.OpenLink"].Value, L["PP.WorkOrder.Src.Plan003"].Value, L["PP.WorkOrder.Src.Manual"].Value, L["PP.WorkOrder.Src.None"].Value,
        L["PP.WoDetail.Flow.Done"].Value, L["PP.WoDetail.Flow.Running"].Value, L["PP.WoDetail.Flow.Waiting"].Value, L["PP.WoDetail.Flow.Cancelled"].Value),
        OperatorTexts(), _lots, _stepTrace);

    // 라인별 담당자 — 한 사람이 한 줄. 지금 로그인해 작업 중이면 「작업중」(강조), 로그아웃했거나 공정이 끝났으면 담당했던 시간(첫~마지막 실적, 로그아웃 시각)과 작업 시간을 보인다.
    Dictionary<string, IReadOnlyList<WoFlowGraph.OperatorRow>> OperatorTexts()
    {
        var map = new Dictionary<string, IReadOnlyList<WoFlowGraph.OperatorRow>>(StringComparer.OrdinalIgnoreCase);
        foreach (var o in _ops)
        {
            var ended = _steps.Any(st => string.Equals(st.LineId, o.LineId, StringComparison.OrdinalIgnoreCase) && WoStatusRules.IsFinished(st.Status));
            var workers = (o.Workers ?? []).OrderBy(w => w.FirstAt).ToList();
            var live = ended ? new Dictionary<string, AMES.Data.Repositories.WorkOrderRepository.OperatorSession>(StringComparer.OrdinalIgnoreCase)
                             : o.Sessions.GroupBy(s => s.Operator, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.OrderBy(s => s.StartedAt).First(), StringComparer.OrdinalIgnoreCase);
            var rows = new List<WoFlowGraph.OperatorRow>();
            foreach (var w in workers)
            {
                if (live.Remove(w.Operator, out var sess))
                    rows.Add(new($"{Actors.Display(w.Operator)} · {L["PP.WoDetail.Operator.Working"].Value} {Stamp(w.FirstAt)}~ · {w.GoodQty:#,0}", true));
                else
                {
                    var end = w.LoggedOutAt ?? w.LastAt;
                    rows.Add(new($"{Actors.Display(w.Operator)} · {Stamp(w.FirstAt)}~{Stamp(end, w.FirstAt)} ({Dur(end - w.FirstAt)}) · {w.GoodQty:#,0}", false));
                }
            }
            // 실적은 아직 없지만 지금 로그인해 있는 사람
            foreach (var s in live.Values.OrderBy(s => s.StartedAt))
                rows.Add(new($"{Actors.Display(s.Operator)}{(string.IsNullOrEmpty(s.Terminal) ? "" : $" ({s.Terminal})")} · {L["PP.WoDetail.Operator.Working"].Value} {Stamp(s.StartedAt)}~", true));
            if (rows.Count == 0 && !ended) rows.Add(new(L["PP.WoDetail.Operator.Logout"].Value, false));
            if (rows.Count > 0) map[o.LineId] = rows;
        }
        return map;
    }

    // 시각 — 오늘이 아니면 날짜를 붙이고, 끝 시각은 시작과 같은 날이면 시·분만
    static string Stamp(DateTime t, DateTime? sameDayAs = null)
        => (sameDayAs is DateTime s ? t.Date != s.Date : t.Date != DbClock.Today) ? t.ToString("MM-dd HH:mm") : t.ToString("HH:mm");

    string Dur(TimeSpan d)
    {
        var min = (int)Math.Round(Math.Max(0, d.TotalMinutes));
        if (min < 1) return "< 1" + L["PP.WoDetail.Unit.Min"].Value;
        return min >= 60 ? $"{min / 60}{L["PP.WoDetail.Unit.Hour"].Value} {min % 60}{L["PP.WoDetail.Unit.Min"].Value}" : $"{min}{L["PP.WoDetail.Unit.Min"].Value}";
    }

    // 공정 표 담당자 칸 — 한 사람이 한 줄
    RenderFragment OperatorCell(string? lineId) => builder =>
    {
        var map = OperatorTexts();
        if (lineId is null || !map.TryGetValue(lineId, out var rows)) { builder.AddMarkupContent(0, "<span class=\"dim\">—</span>"); return; }
        var seq = 1;
        foreach (var r in rows)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", r.Live ? "wod-op-live" : "dim");
            builder.AddContent(seq++, (r.Live ? "● " : "") + r.Text);
            builder.CloseElement();
        }
    };

    // 흐름 화면의 「양품」·공정별 줄을 누르면 JS 가 부른다 — 팝업을 닫고 그 작업지시의 생산품(LOT) 전체 화면으로 넘어간다
    [JSInvokable]
    public async Task OpenLotList(string key)
        => await InvokeAsync(() =>
        {
            var process = key.StartsWith("lots:", StringComparison.Ordinal) ? key[5..] : null;
            Dialog.Close();
            Nav.NavigateTo($"/pp/work-order/lots/{Uri.EscapeDataString(WoNumber)}" + (string.IsNullOrEmpty(process) ? "" : $"?process={Uri.EscapeDataString(process)}"));
        });

    // 흐름 화면의 LOT 칩을 누르면 JS 가 부른다 — 그 LOT 의 내용을 팝업으로 연다
    [JSInvokable]
    public async Task OpenLot(string lotCode)
        => await InvokeAsync(() => Dialog.OpenAsync<LotDetailDialog>(lotCode, new Dictionary<string, object?> { ["LotCode"] = lotCode },
               new DialogOptions { Width = "62vw", Height = "auto", Resizable = true, CloseDialogOnOverlayClick = true }));

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        _cts?.Cancel();
        _cts?.Dispose();
        if (_mod is null) return;
        try { await _mod.InvokeVoidAsync("dispose", _flowId); await _mod.DisposeAsync(); } catch { /* 회로가 이미 끊김 */ }
    }

    WorkOrderDto? _wo;
    AMES.Data.Repositories.WorkOrderRepository.WoOrderInfo? _order;
    List<AMES.Data.Repositories.WorkOrderRepository.StepRow> _steps = new();
    AMES.Data.Repositories.WorkOrderRepository.WoTraceRow? _trace;
    List<AMES.Data.Repositories.WorkOrderRepository.StepOperators> _ops = new();
    List<AMES.Data.Repositories.WorkOrderRepository.WoLotRow> _lots = new();   // 흐름 보기 LOT 칩
    List<AMES.Data.Repositories.WorkOrderRepository.WoStepTrace> _stepTrace = new();   // 흐름 보기 공정별 슬롯·실적
    DotNetObjectReference<WoDetailDialog>? _self;                                // 흐름 화면의 LOT 칩 클릭을 받는다

    protected override void OnInitialized()
    {
        try
        {
            _wo = Wos.GetByNumber(WoNumber);
            if (_wo is null) return;
            _steps = Wos.ListSteps(_wo.WoId);
            _trace = Wos.GetTrace(_wo.WoId);
            _ops = Wos.ListStepOperators(_wo.WoId);
            _lots = Wos.ListWoLots(_wo.WoId);
            _stepTrace = Wos.ListStepTrace(_wo.WoId);
            _order = Wos.GetWoOrderInfo(WoNumber);
            _live = _steps.Any(s => s.Status == "In Progress") || _wo.Status == "In Progress";
        }
        catch { _wo = null; }
    }

    static string StatusClass(string? status) => status switch
    {
        "Closed" or "Completed" => "ok",
        "In Progress" => "info",
        "Cancelled" => "bad",
        _ => "warn",
    };

    string SourceText() => _wo?.SourceType switch
    {
        "APS"     => $"APS {L["PP.WorkOrder.Trace.Run"].Value} #{_wo.SourceRef}",
        "PLAN003" => L["PP.WorkOrder.Src.Plan003"].Value,
        "MANUAL"  => L["PP.WorkOrder.Src.Manual"].Value,
        _         => L["PP.WorkOrder.Src.None"].Value,
    };

    void OpenWorkOrder()
    {
        Dialog.Close();
        Nav.NavigateTo("/pp/work-order");
    }
}
