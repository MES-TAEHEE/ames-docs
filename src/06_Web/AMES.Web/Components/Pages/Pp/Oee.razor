@page "/pp/oee"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.PpRepository Pp
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["PP.Oee.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">PP-OEE</div>
    <div class="ames-page-t">@L["PP.Oee.Title"]</div>
    <div class="ames-page-sub">@L["PP.Oee.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi ok"><div class="ames-kpi-l">AVG OEE</div><div class="ames-kpi-v">@(_avgOee.ToString("0.0"))%</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">AVG AVAILABILITY</div><div class="ames-kpi-v">@(_avgA.ToString("0.0"))%</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">AVG PERFORMANCE</div><div class="ames-kpi-v">@(_avgP.ToString("0.0"))%</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">AVG QUALITY</div><div class="ames-kpi-v">@(_avgQ.ToString("0.0"))%</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h">▼ OEE SNAPSHOTS</div>
    @if (_rows.Count == 0) { <div class="ames-empty">@L["PP.Oee.Empty"]</div> }
    else
    {
        <table class="ames-table">
            <thead><tr><th>Date</th><th>Line</th><th>Shift</th><th class="num">A</th><th class="num">P</th><th class="num">Q</th><th class="num">OEE</th><th class="num">Good</th><th class="num">Total</th></tr></thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td class="dim">@(r.PeriodDate?.ToString("MM-dd") ?? "—")</td>
                        <td>@r.LineId</td>
                        <td class="dim">@r.ShiftCode</td>
                        <td class="num">@((r.Availability * 100).ToString("0.0"))</td>
                        <td class="num">@((r.Performance * 100).ToString("0.0"))</td>
                        <td class="num">@((r.Quality * 100).ToString("0.0"))</td>
                        <td class="num"><strong>@((r.OEE * 100).ToString("0.0"))</strong></td>
                        <td class="num">@r.GoodQty.ToString("0")</td>
                        <td class="num">@r.TotalProducedQty.ToString("0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.PpRepository.OeeRow> _rows = new();
    decimal _avgA, _avgP, _avgQ, _avgOee;
    protected override void OnInitialized()
    {
        try
        {
            _rows = Pp.ListOee();
            if (_rows.Count > 0)
            {
                _avgA   = _rows.Average(r => r.Availability) * 100;
                _avgP   = _rows.Average(r => r.Performance)  * 100;
                _avgQ   = _rows.Average(r => r.Quality)      * 100;
                _avgOee = _rows.Average(r => r.OEE)          * 100;
            }
        }
        catch { }
    }
}
