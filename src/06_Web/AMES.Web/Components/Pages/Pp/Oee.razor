@page "/pp/oee"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject AMES.Data.Repositories.OeeRepository Repo
@inject AMES.Data.Repositories.MasterDataRepository MD
@inject AMES.Web.Services.PermissionService PermSvc
@inject IStringLocalizer<SharedResources> L
@inject AuthenticationStateProvider AuthPrvd
@inject Microsoft.JSInterop.IJSRuntime JS
@using AMES.Contracts.Dto
@using AMES.Data.Repositories

<PageTitle>@L["PP.Oee.Title"] · AMES</PageTitle>

<AmesPageHeader Code="PP-OEE" TitleKey="PP.Oee.Title" />

@* ── KPI ────────────────────────────────────────────────────────── *@
@{
    var ov = _overall;
}
<div class="ames-kpis pp-oee-kpis">
    <div class="ames-kpi @(ov is null ? "" : KpiCls(ov.Oee))">
        <div class="ames-kpi-l">@L["PP.Oee.Kpi.Overall"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v pp-oee-mono">@(ov is null ? "—" : $"{ov.Oee:F1}")<span style="font-size:14px;margin-left:2px;">%</span></div>
            <div class="ames-kpi-s">@string.Format(L["PP.Oee.Kpi.WorldClass"].Value, WORLD_CLASS)@(ov is null ? "" : $" · {GradeText(ov.Oee)}")</div>
        </div>
    </div>
    <div class="ames-kpi pp-oee-kpi-a">
        <div class="ames-kpi-l">@L["PP.Oee.Kpi.Availability"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v pp-oee-mono">@(ov is null ? "—" : $"{ov.A:F1}")<span style="font-size:14px;margin-left:2px;">%</span></div>
            <div class="ames-kpi-s">@(ov is null ? "" : $"{ov.Operating:N0} / {ov.Loading:N0} {L["Lbl.Min"]}")</div>
        </div>
    </div>
    <div class="ames-kpi pp-oee-kpi-p">
        <div class="ames-kpi-l">@L["PP.Oee.Kpi.Performance"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v pp-oee-mono">@(ov is null ? "—" : $"{ov.P:F1}")<span style="font-size:14px;margin-left:2px;">%</span></div>
            <div class="ames-kpi-s">@(ov is null ? "" : $"{ov.Produced:N0} ea")</div>
        </div>
    </div>
    <div class="ames-kpi pp-oee-kpi-q">
        <div class="ames-kpi-l">@L["PP.Oee.Kpi.Quality"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v pp-oee-mono">@(ov is null ? "—" : $"{ov.Q:F1}")<span style="font-size:14px;margin-left:2px;">%</span></div>
            <div class="ames-kpi-s">@(ov is null ? "" : $"{ov.Good:N0} / {ov.Produced:N0} ea")</div>
        </div>
    </div>
    <div class="ames-kpi bad">
        <div class="ames-kpi-l">@L["PP.Oee.Kpi.TotalLoss"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v pp-oee-mono">@(ov is null ? "—" : ov.TotalLoss.ToString("N0"))<span style="font-size:14px;margin-left:3px;">@L["Lbl.Min"]</span></div>
            <div class="ames-kpi-s">@(ov is null ? "" : $"{ov.Count} snapshots")</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_err)) { <RadzenAlert AlertStyle="AlertStyle.Danger"  Variant="Variant.Flat">@_err</RadzenAlert> }
@if (!string.IsNullOrEmpty(_msg)) { <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat">@_msg</RadzenAlert> }

@* ── 라인별 OEE (조회부는 Md/Rp/Station.razor 패턴) ───────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["PP.Oee.ByLine.Title"] · @_rows.Count @L["Lbl.Items"] · @string.Format(L["PP.Oee.Kpi.Range"].Value, _fFrom.ToString("MM-dd"), _fTo.ToString("MM-dd"), _snaps.Count)</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Lbl.Period"]" Component="DatePickerFrom" />
            <RadzenDatePicker TValue="DateTime" Name="DatePickerFrom" @bind-Value="_fFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <span class="dim">~</span>
            <RadzenDatePicker TValue="DateTime" Name="DatePickerTo" @bind-Value="_fTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Shift"]" Component="DropDownShift" />
            <RadzenDropDown Name="DropDownShift" @bind-Value="_fShift" Data="@ShiftFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
            <RadzenLabel Text="@L["PP.Oee.Lbl.Target"]" Component="NumericTarget" />
            <RadzenNumeric TValue="decimal" Name="NumericTarget" @bind-Value="_fTarget" Min="0" Max="100" InputSize="InputSize.Small" class="ames-rz-input" Style="width:90px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <div class="dim" style="font-size:10px;padding:0 0 6px;">@L["PP.Oee.ByLine.Hint"]</div>
    <RadzenDataGrid TItem="LineAgg" Data="@_rows" AllowPaging="false" AllowSorting="true"
                    RowClick="@(e => { if (e.Data is { } d) Select(d.LineId); })" RowRender="@LineRowRender"
                    EmptyText="@L["PP.Oee.ByLine.NoData"]" Class="ames-rz-grid pp-oee-lines">
        <Columns>
            <RadzenDataGridColumn TItem="LineAgg" Property="LineId" Title="@L["Col.Line"]" Width="130px">
                <Template Context="r"><span class="code">@r.LineId</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Name" Title="@L["Col.Name"]">
                <Template Context="r"><span style="white-space:nowrap;">@(r.Name ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="A" Title="@L["PP.Oee.Kpi.Availability"]" Width="17%">
                <Template Context="r">@(r.HasData ? Bar(r.A, "a") : Dash)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="P" Title="@L["PP.Oee.Kpi.Performance"]" Width="17%">
                <Template Context="r">@(r.HasData ? Bar(r.P, "p") : Dash)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Q" Title="@L["PP.Oee.Kpi.Quality"]" Width="17%">
                <Template Context="r">@(r.HasData ? Bar(r.Q, "q") : Dash)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Oee" Title="OEE" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.HasData) { <span class="pp-oee-pill @GradeKey(r.Oee)">@($"{r.Oee:F1}%")</span> } else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Title="@L["PP.Oee.Col.Grade"]" Width="120px" TextAlign="TextAlign.Center" Sortable="false">
                <Template Context="r">
                    @if (r.HasData) { <b style="font-size:11px;">@GradeText(r.Oee)</b> } else { <span class="dim" style="font-size:11px;">@L["PP.Oee.ByLine.NoData"]</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="TotalLoss" Title="@L["PP.Oee.Col.Loss"]" Width="100px" TextAlign="TextAlign.Right">
                <Template Context="r">
                    @if (r.HasData) { <span class="code" style="color:#f87171;">@r.TotalLoss.ToString("N0")</span> } else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── 손실 · 구성 ────────────────────────────────────────────────── *@
@{
    var fo    = Focus;
    var focus = _sel is null ? L["PP.Oee.Loss.OverallAvg"].Value : (_sel ?? "");
}
<div class="pp-oee-grid2">
    <div class="ames-card" style="margin-bottom:0;">
        <div class="ames-card-h">🔻 @L["PP.Oee.Loss.Title"] — <span style="margin-left:6px;">@focus</span></div>
        @if (fo is null || !fo.HasData)
        {
            <div class="ames-empty">@L["PP.Oee.ByLine.NoData"]</div>
        }
        else
        {
            var losses = new (string Name, string Cat, int Min, string Color)[]
            {
                (L["PP.Oee.Loss.Breakdown"].Value,  L["PP.Oee.Loss.Cat.Avail"].Value,   fo.Breakdown,  "#dc2626"),
                (L["PP.Oee.Loss.Setup"].Value,      L["PP.Oee.Loss.Cat.Avail"].Value,   fo.Setup,      "#f97316"),
                (L["PP.Oee.Loss.OtherStops"].Value, L["PP.Oee.Loss.Cat.Avail"].Value,   fo.OtherStops, "#f59e0b"),
                (L["PP.Oee.Loss.Speed"].Value,      L["PP.Oee.Loss.Cat.Perf"].Value,    fo.PerfLoss,   "#a78bfa"),
                (L["PP.Oee.Loss.Defects"].Value,    L["PP.Oee.Loss.Cat.Qual"].Value,    fo.QualLoss,   "#0891b2"),
                (L["PP.Oee.Loss.Planned"].Value,    L["PP.Oee.Loss.Cat.Planned"].Value, fo.Planned,    "#64748b"),
            };
            var maxLoss = Math.Max(1, losses.Max(x => x.Min));
            foreach (var x in losses)
            {
                <div class="pp-oee-loss-row">
                    <div class="pp-oee-loss-name">@x.Name<div class="pp-oee-loss-cat">@x.Cat</div></div>
                    <div class="pp-oee-track pp-oee-loss-track">
                        <i style="width:@((100.0 * x.Min / maxLoss).ToString("F1"))%;background:@x.Color;"></i>
                    </div>
                    <div class="pp-oee-loss-val">@x.Min.ToString("N0") min</div>
                </div>
            }
            <div class="dim" style="font-size:10px;margin-top:8px;">@L["PP.Oee.Loss.Hint"]</div>
        }
    </div>

    <div class="ames-card" style="margin-bottom:0;">
        <div class="ames-card-h">🎯 @L["PP.Oee.Comp.Title"] — <span style="margin-left:6px;">@focus</span></div>
        @if (fo is null || !fo.HasData)
        {
            <div class="ames-empty">@L["PP.Oee.ByLine.NoData"]</div>
        }
        else
        {
            <div class="pp-oee-donut-wrap @GradeKey(fo.Oee)">
                @((MarkupString)BuildDonutSvg(fo.Oee))
                <div style="font-size:11px;font-weight:800;">@L["PP.Oee.Col.Grade"]: @GradeText(fo.Oee)</div>
            </div>
            <div class="pp-oee-comp">
                @foreach (var (lbl, val, key) in new[] {
                    (L["PP.Oee.Kpi.Availability"].Value, fo.A, "a"),
                    (L["PP.Oee.Kpi.Performance"].Value,  fo.P, "p"),
                    (L["PP.Oee.Kpi.Quality"].Value,      fo.Q, "q") })
                {
                    <div class="pp-oee-comp-row">
                        <div class="pp-oee-comp-h"><span>@lbl</span><b>@($"{val:F1}%")</b></div>
                        <div class="pp-oee-track pp-oee-comp-track"><i class="pp-oee-fill-@key" style="width:@(Math.Min(100m, val).ToString("F1"))%;"></i></div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ── 라인 상세 (드릴다운) ───────────────────────────────────────── *@
@if (_sel is { } selLine)
{
    var lineSnaps = _snaps.Where(s => s.LineId == selLine).OrderBy(s => s.PeriodDate).ThenBy(s => s.ShiftCode).ToList();
    <div class="ames-card" style="margin-top:8px;">
        <div class="ames-card-h" style="gap:6px;flex-wrap:wrap;">
            <span>@string.Format(L["PP.Oee.Detail.Title"].Value, selLine)</span>
            <span class="dim" style="font-size:10px;text-transform:none;letter-spacing:0;">@_rows.FirstOrDefault(r => r.LineId == selLine)?.Name</span>
            <span style="margin-left:auto;display:flex;gap:4px;">
                <button class="ames-btn @(_tab == "trend" ? "" : "ghost")" style="padding:3px 10px;" @onclick='() => _tab = "trend"'>@L["PP.Oee.Tab.Trend"]</button>
                <button class="ames-btn @(_tab == "snaps" ? "" : "ghost")" style="padding:3px 10px;" @onclick='() => _tab = "snaps"'>@L["PP.Oee.Tab.Snapshots"]</button>
                <button class="ames-btn @(_tab == "log" ? "" : "ghost")" style="padding:3px 10px;" @onclick='() => { _tab = "log"; LoadLogs(); }'>@L["PP.Oee.Tab.Log"]</button>
                <button class="ames-btn @(_tab == "calc" ? "" : "ghost")" style="padding:3px 10px;" @onclick='() => _tab = "calc"'>@L["PP.Oee.Btn.Compute"]</button>
                <button class="ames-btn ghost" style="padding:3px 10px;" @onclick="() => Select(null)">✕</button>
            </span>
        </div>

        @if (_tab == "trend")
        {
            if (lineSnaps.Count == 0) { <div class="ames-empty">@L["PP.Oee.Trend.NoSnap"]</div> }
            else
            {
                var pts   = TrendPoints(lineSnaps);
                var above = pts.Where(p => p.Oee >= (double)_fTarget).ToList();
                var below = pts.Where(p => p.Oee <  (double)_fTarget).ToList();
                @* 목표 이상/미만 점은 마커만 있는 시리즈 2개로 색을 나눈다 — 마커는 시리즈당 단일 색이라 우회 *@
                <RadzenChart class="pp-oee-chart" Style="width:100%;height:260px;">
                    <RadzenChartTooltipOptions Visible="true" />
                    <RadzenLegend Position="LegendPosition.Bottom" />
                    <RadzenCategoryAxis FormatString="{0:MM-dd}" Padding="24" />
                    <RadzenValueAxis Min="0" Max="100" Step="25" FormatString="{0}%">
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>
                    <RadzenLineSeries TItem="TrendPoint" Data="@pts" CategoryProperty="At" ValueProperty="A"
                                      Title="@L["PP.Oee.Kpi.Availability"]" Stroke="#94a3b8" StrokeWidth="1.5" LineType="LineType.Dashed">
                        <RadzenMarkers MarkerType="MarkerType.None" />
                    </RadzenLineSeries>
                    <RadzenLineSeries TItem="TrendPoint" Data="@pts" CategoryProperty="At" ValueProperty="Oee"
                                      Title="OEE" Stroke="#3b82f6" StrokeWidth="2.5">
                        <RadzenMarkers MarkerType="MarkerType.None" />
                        <RadzenSeriesValueLine Value="@((double)_fTarget)" Stroke="#ef4444" StrokeWidth="1.5" LineType="LineType.Dashed" />
                    </RadzenLineSeries>
                    <RadzenLineSeries TItem="TrendPoint" Data="@above" CategoryProperty="At" ValueProperty="Oee"
                                      Title="@L["PP.Oee.Trend.LegendAbove"]" Stroke="transparent" StrokeWidth="0">
                        <RadzenMarkers MarkerType="MarkerType.Circle" Size="7" Fill="#22c55e" Stroke="#22c55e" />
                    </RadzenLineSeries>
                    <RadzenLineSeries TItem="TrendPoint" Data="@below" CategoryProperty="At" ValueProperty="Oee"
                                      Title="@L["PP.Oee.Trend.LegendBelow"]" Stroke="transparent" StrokeWidth="0">
                        <RadzenMarkers MarkerType="MarkerType.Circle" Size="7" Fill="#ef4444" Stroke="#ef4444" />
                    </RadzenLineSeries>
                </RadzenChart>
                <div class="dim" style="font-size:10px;padding:2px 0 0;">@L["PP.Oee.Lbl.Target"] @($"{_fTarget:F0}%") · @string.Format(L["PP.Oee.Kpi.Range"].Value, _fFrom.ToString("MM-dd"), _fTo.ToString("MM-dd"), pts.Count)</div>
            }
        }
        else if (_tab == "snaps")
        {
            <RadzenDataGrid TItem="OeeSnapshotDto" Data="@lineSnaps" AllowPaging="true" PageSize="10" PagerHorizontalAlign="HorizontalAlign.Center"
                            AllowSorting="true" EmptyText="@L["PP.Oee.Trend.NoSnap"]" Class="ames-rz-grid pp-oee-lines">
                <Columns>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="PeriodDate" Title="@L["PP.Oee.Snap.Col.Date"]" Width="110px">
                        <Template Context="s"><span class="code">@s.PeriodDate.ToString("yyyy-MM-dd")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="ShiftCode" Title="@L["Col.Shift"]" Width="90px" TextAlign="TextAlign.Center">
                        <Template Context="s"><span class="pill info">@(s.ShiftCode ?? L["PP.Oee.Shift.None"].Value)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="LoadingMin"       Title="@L["PP.Oee.Snap.Col.Load"]"      TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="OperatingMin"     Title="@L["PP.Oee.Snap.Col.Operating"]" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="TotalProducedQty" Title="@L["PP.Oee.Snap.Col.Produced"]"  TextAlign="TextAlign.Right">
                        <Template Context="s">@s.TotalProducedQty.ToString("N0")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="GoodQty" Title="@L["PP.Oee.Snap.Col.Good"]" TextAlign="TextAlign.Right">
                        <Template Context="s">@s.GoodQty.ToString("N0")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="Availability" Title="@L["PP.Oee.Snap.Col.Avail"]" TextAlign="TextAlign.Right">
                        <Template Context="s">@($"{s.Availability:F1}%")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="Performance" Title="@L["PP.Oee.Snap.Col.Perf"]" TextAlign="TextAlign.Right">
                        <Template Context="s">@($"{s.Performance:F1}%")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="Quality" Title="@L["PP.Oee.Snap.Col.Qual"]" TextAlign="TextAlign.Right">
                        <Template Context="s">@($"{s.Quality:F1}%")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="Oee" Title="OEE" Width="90px" TextAlign="TextAlign.Center">
                        <Template Context="s"><span class="pp-oee-pill @GradeKey(s.Oee)">@($"{s.Oee:F1}%")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="OeeSnapshotDto" Property="CreatedTs" Title="@L["PP.Oee.Snap.Col.SavedAt"]" Width="110px">
                        <Template Context="s"><span class="dim">@(s.CreatedTs?.ToString("MM-dd HH:mm") ?? "")</span></Template>
                    </RadzenDataGridColumn>
                    @if (_canEdit)
                    {
                        <RadzenDataGridColumn TItem="OeeSnapshotDto" Title="" Width="60px" Sortable="false" TextAlign="TextAlign.Center">
                            <Template Context="s">
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="@(() => DeleteSnap(s.OeeSnapshotId))" class="ames-rz-btn" Style="height:24px;padding:0 8px;line-height:1;" />
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        }
        else if (_tab == "log")
        {
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px;">
                <span class="dim" style="font-size:11px;">@L["PP.Oee.Log.Timeline"]</span>
                <input type="date" class="ames-input" style="width:148px;padding:3px 7px;"
                       value="@_logDate.ToString("yyyy-MM-dd")"
                       @onchange="e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) { _logDate = d; LoadLogs(); } }" />
                <span class="dim" style="font-size:11px;margin-left:auto;">
                    <span class="pp-oee-dot" style="background:#22c55e;"></span>@L["PP.Oee.Log.Run"] @_logs.Count(l => l.State == "RUN")
                    <span class="pp-oee-dot" style="background:#f59e0b;margin-left:10px;"></span>@L["PP.Oee.Log.Idle"] @_logs.Count(l => l.State == "IDLE")
                    <span class="pp-oee-dot" style="background:#ef4444;margin-left:10px;"></span>@L["PP.Oee.Log.Down"] @_logs.Count(l => l.State == "DOWN")
                    <span class="pp-oee-dot" style="background:#64748b;margin-left:10px;"></span>@L["PP.Oee.Log.PlanDown"] @_logs.Count(l => l.PlanState is not null && l.PlanState != "PLAN-RUN")
                </span>
            </div>
            @if (_logs.Count == 0) { <div class="ames-empty">@L["PP.Oee.Log.Empty"]</div> }
            else { <div class="pp-oee-chart-wrap">@((MarkupString)BuildTimelineSvg(_logs, _logDate))</div> }
        }
        else if (_tab == "calc")
        {
            <div class="dim" style="font-size:11px;margin-bottom:8px;">@L["PP.Oee.Calc.Title"] · @L["PP.Oee.Calc.Note"]</div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px;">
                <input type="date" class="ames-input" style="width:148px;padding:3px 7px;"
                       value="@_calcDate.ToString("yyyy-MM-dd")"
                       @onchange="e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) _calcDate = d; }" />
                <select class="ames-input" style="width:190px;" @bind="_calcShift">
                    <option value="">@L["PP.Oee.Shift.None"] (00:00–24:00)</option>
                    @foreach (var c in _shiftCodes)
                    {
                        <option value="@c.CodeValue">[@c.CodeValue] @MasterDataRepository.LocalName(c) @(c.Attribute1 is { Length: 9 } w ? $"({w[..2]}:{w[2..4]}–{w[5..7]}:{w[7..9]})" : "")</option>
                    }
                </select>
                <button class="ames-btn ok" @onclick="Compute">@L["PP.Oee.Btn.Compute"]</button>
                @if (_canEdit)
                {
                    <button class="ames-btn" @onclick="SaveSnapshot" disabled="@(_result is null)">@L["PP.Oee.Btn.SaveSnapshot"]</button>
                }
            </div>
            @if (_result is { } r)
            {
                <div class="pp-oee-calc">
                    <div class="pp-oee-donut-wrap @GradeKey(r.Oee)">
                        @((MarkupString)BuildDonutSvg(r.Oee))
                        <span class="pill @(r.Oee >= _fTarget ? "ok" : "bad")">
                            @(r.Oee >= _fTarget ? L["PP.Oee.Result.Above"].Value : string.Format(L["PP.Oee.Result.Below"].Value, _fTarget))
                        </span>
                    </div>
                    <div class="pp-oee-comp" style="margin-top:0;">
                        @foreach (var (lbl, val, key, note) in new[] {
                            (L["PP.Oee.Kpi.Availability"].Value, r.Availability, "a", $"{r.OperatingMin} / {r.LoadingMin} min"),
                            (L["PP.Oee.Kpi.Performance"].Value,  r.Performance,  "p", r.PerformanceAssumed ? L["PP.Oee.Calc.Assumed"].Value : ""),
                            (L["PP.Oee.Kpi.Quality"].Value,      r.Quality,      "q", $"{r.GoodQty:N0} / {r.TotalProducedQty:N0} ea") })
                        {
                            <div class="pp-oee-comp-row">
                                <div class="pp-oee-comp-h"><span>@lbl <span class="dim">@note</span></span><b>@($"{val:F1}%")</b></div>
                                <div class="pp-oee-track pp-oee-comp-track"><i class="pp-oee-fill-@key" style="width:@(Math.Min(100m, val).ToString("F1"))%;"></i></div>
                            </div>
                        }
                        <div class="dim" style="font-size:11px;display:flex;gap:14px;flex-wrap:wrap;">
                            <span>@L["PP.Oee.Loss.Planned"] @r.PlannedDownMin min</span>
                            <span style="color:#f87171;">@L["PP.Oee.Loss.Cat.Avail"] @r.UnplannedDownMin min</span>
                            <span>@L["PP.Oee.Snap.Col.Date"] @r.PeriodDate.ToString("yyyy-MM-dd") @(r.ShiftCode is null ? "" : $"[{r.ShiftCode}]")</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    // ── 상수 ─────────────────────────────────────────────────────────────
    const decimal WORLD_CLASS = 85m;
    const decimal GOOD        = 65m;


    // ── 필터 상태 ─────────────────────────────────────────────────────────
    DateTime _fFrom = DateTime.Today.AddDays(-6);
    DateTime _fTo   = DateTime.Today;
    string?  _fShift;
    decimal  _fTarget = 75m;

    sealed class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    IEnumerable<DropDownItem> ShiftFilterOptions => _shifts.Select(s => new DropDownItem { Text = s, Value = s });

    // ── 데이터 ───────────────────────────────────────────────────────────
    List<OeeRepository.LineRef>          _lineRefs   = [];
    List<string>                         _shifts     = [];
    List<MasterDataRepository.CodeItemRow> _shiftCodes = [];
    List<OeeSnapshotDto>                 _snaps      = [];
    List<OeeRepository.DowntimeByReason> _downtime   = [];
    List<LineAgg>                        _rows       = [];
    LineAgg?                             _overall;

    // ── 드릴다운 ─────────────────────────────────────────────────────────
    string?  _sel;
    string   _tab      = "trend";

    DateTime _logDate  = DateTime.Today;
    List<LineStateLogDto> _logs = [];
    DateTime _calcDate  = DateTime.Today;
    string   _calcShift = "";
    OeeSnapshotDto? _result;

    bool   _canEdit;
    string _actor = "web";
    string _err = "", _msg = "";

    LineAgg? Focus => _sel is null ? _overall : _rows.FirstOrDefault(r => r.LineId == _sel);

    // ── 라인 집계 ─────────────────────────────────────────────────────────
    // RadzenDataGrid 정렬은 프로퍼티 이름으로 동작하므로 필드가 아닌 프로퍼티로 둔다
    sealed class LineAgg
    {
        public string  LineId { get; set; } = "";
        public string? Name { get; set; }
        public bool    HasData { get; set; }
        public int     Count { get; set; }
        public int     Loading { get; set; }
        public int     Planned { get; set; }
        public int     Unplanned { get; set; }
        public int     Operating { get; set; }
        public decimal Produced { get; set; }
        public decimal Good { get; set; }
        public decimal A { get; set; }
        public decimal P { get; set; }
        public decimal Q { get; set; }
        public decimal Oee { get; set; }
        public int     PerfLoss { get; set; }
        public int     QualLoss { get; set; }
        public int     Breakdown { get; set; }
        public int     Setup { get; set; }
        public int     OtherStops { get; set; }
        public int     TotalLoss => Planned + Unplanned + PerfLoss + QualLoss;
    }

    void LineRowRender(RowRenderEventArgs<LineAgg> args)
    {
        var cls = "ames-row-link";
        if (_sel is not null && _sel == args.Data?.LineId) cls += " ames-row-selected";
        args.Attributes["class"] = cls;
    }

    static readonly MarkupString Dash = new("<span class=\"dim\">—</span>");

    // ── Init ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "web";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("pp/oee");

        try { _lineRefs   = Repo.ListLineRefs(); }               catch { }
        try { _shifts     = Repo.ListShiftCodes(); }             catch { }
        try { _shiftCodes = MD.ListCodeItems("WORK_SHIFT").Where(c => c.UseFlag).ToList(); } catch { }

        // 기본 기간 = 스냅샷이 있는 마지막 7일 (데이터가 오래됐어도 빈 화면이 되지 않도록)
        try
        {
            if (Repo.LatestSnapshotDate() is { } last) { _fTo = last; _fFrom = last.AddDays(-6); }
        }
        catch { }
        _logDate = _calcDate = _fTo;
        ApplyFilter();
    }

    // ── 조회 ─────────────────────────────────────────────────────────────
    void ApplyFilter()
    {
        _err = "";
        if (_fFrom > _fTo) { _err = L["PP.Oee.Err.DateRange"]; return; }
        try
        {
            _snaps    = Repo.GetSnapshots(_fFrom, _fTo, string.IsNullOrEmpty(_fShift) ? null : _fShift);
            _downtime = Repo.GetDowntimeByReason(_fFrom, _fTo);
        }
        catch (Exception ex) { _err = ex.Message; _snaps = []; _downtime = []; }

        var lineIds = _lineRefs.Select(l => l.LineId)
            .Union(_snaps.Select(s => s.LineId))
            .OrderBy(x => x).ToList();

        _rows = lineIds.Select(id =>
        {
            var lr = _lineRefs.FirstOrDefault(l => l.LineId == id);
            return Aggregate(id, lr is null ? null : MasterDataRepository.LocalName(lr.Name, lr.NameEn),
                             _snaps.Where(s => s.LineId == id), _downtime.Where(d => d.LineId == id));
        }).ToList();

        _overall = Aggregate("", null, _snaps, _downtime);
        if (_sel is not null && !_rows.Any(r => r.LineId == _sel)) _sel = null;

    }

    static LineAgg Aggregate(string lineId, string? name,
        IEnumerable<OeeSnapshotDto> snapsSrc, IEnumerable<OeeRepository.DowntimeByReason> dtSrc)
    {
        var snaps = snapsSrc.ToList();
        var agg   = new LineAgg { LineId = lineId, Name = name, Count = snaps.Count, HasData = snaps.Count > 0 };
        if (!agg.HasData) return agg;

        agg.Loading   = snaps.Sum(s => s.LoadingMin);
        agg.Planned   = snaps.Sum(s => s.PlannedDownMin);
        agg.Unplanned = snaps.Sum(s => s.UnplannedDownMin);
        agg.Operating = snaps.Sum(s => s.OperatingMin);
        agg.Produced  = snaps.Sum(s => s.TotalProducedQty);
        agg.Good      = snaps.Sum(s => s.GoodQty);

        agg.A = agg.Loading > 0 ? Round(100m * agg.Operating / agg.Loading) : Round(snaps.Average(s => s.Availability));
        agg.P = agg.Operating > 0
            ? Round(snaps.Sum(s => s.Performance * s.OperatingMin) / agg.Operating)   // 가동시간 가중
            : Round(snaps.Average(s => s.Performance));
        agg.Q = agg.Produced > 0 ? Round(100m * agg.Good / agg.Produced) : Round(snaps.Average(s => s.Quality));
        agg.Oee = Round(agg.A / 100m * agg.P / 100m * agg.Q / 100m * 100m);

        agg.PerfLoss = (int)Math.Round(agg.Operating * (1.0 - (double)agg.P / 100.0));
        agg.QualLoss = (int)Math.Round(agg.Operating * (double)agg.P / 100.0 * (1.0 - (double)agg.Q / 100.0));

        // 비계획 정지를 비가동 로그 사유 비율로 나눈다 — 로그가 없으면 전부 '기타 정지'
        var dt      = dtSrc.ToList();
        int dtTotal = dt.Sum(d => d.Minutes);
        int machine = dt.Where(d => d.ReasonCode == "MACHINE").Sum(d => d.Minutes);
        int change  = dt.Where(d => d.ReasonCode == "CHANGEOVER").Sum(d => d.Minutes);
        if (dtTotal > 0)
        {
            agg.Breakdown = (int)Math.Round((double)agg.Unplanned * machine / dtTotal);
            agg.Setup     = (int)Math.Round((double)agg.Unplanned * change  / dtTotal);
        }
        agg.OtherStops = Math.Max(0, agg.Unplanned - agg.Breakdown - agg.Setup);
        return agg;
    }

    static decimal Round(decimal v) => Math.Round(v, 2);

    // ── 드릴다운 ─────────────────────────────────────────────────────────
    void Select(string? lineId)
    {
        _sel = _sel == lineId ? null : lineId;
        _result = null; _err = "";
        if (_sel is not null && _tab == "log") LoadLogs();
    }

    void LoadLogs()
    {
        _logs = [];
        if (_sel is null) return;
        try { _logs = Repo.GetStateLogs(_sel, _logDate.Date, _logDate.Date.AddDays(1)); }
        catch (Exception ex) { _err = ex.Message; }
    }

    void Compute()
    {
        _err = ""; _result = null;
        if (_sel is null) { _err = L["PP.Oee.Err.NoLine"]; return; }
        var (ws, we) = ShiftWindow(_calcDate, _calcShift);
        try
        {
            _result = Repo.ComputeOee(_sel, ws, we, _calcShift.Length > 0 ? _calcShift : null);
            if (_result is null) _err = L["PP.Oee.Calc.NoLog"];
        }
        catch (Exception ex) { _err = string.Format(L["PP.Oee.Err.Compute"].Value, ex.Message); }
    }

    // WORK_SHIFT.Attribute1 = "HHMM-HHMM" (끝이 시작보다 빠르면 익일). 교대 미선택 시 하루 전체.
    (DateTime Start, DateTime End) ShiftWindow(DateTime date, string shiftCode)
    {
        var d = date.Date;
        var w = _shiftCodes.FirstOrDefault(c => c.CodeValue == shiftCode)?.Attribute1;
        if (w is not { Length: 9 }) return (d, d.AddDays(1));
        if (!int.TryParse(w[..2], out var sh) || !int.TryParse(w[2..4], out var sm)
         || !int.TryParse(w[5..7], out var eh) || !int.TryParse(w[7..9], out var em)) return (d, d.AddDays(1));
        var s = d.AddMinutes(sh * 60 + sm);
        var e = d.AddMinutes(eh * 60 + em);
        if (e <= s) e = e.AddDays(1);
        return (s, e);
    }

    void SaveSnapshot()
    {
        if (_result is null || !_canEdit) return;
        _err = "";
        try
        {
            Repo.SaveSnapshot(_result, _actor);
            ShowMsg(L["PP.Oee.Ok.Snapshot"]);
            if (_result.PeriodDate < _fFrom) _fFrom = _result.PeriodDate;
            if (_result.PeriodDate > _fTo)   _fTo   = _result.PeriodDate;
            ApplyFilter();
        }
        catch (Exception ex) { _err = string.Format(L["PP.Oee.Err.Save"].Value, ex.Message); }
    }

    async Task DeleteSnap(int id)
    {
        if (!_canEdit) return;
        if (!await JS.InvokeAsync<bool>("confirm", L["PP.Oee.Confirm.DeleteSnap"].Value)) return;
        try { Repo.DeleteSnapshot(id); ApplyFilter(); }
        catch (Exception ex) { _err = ex.Message; }
    }

    void ShowMsg(string msg)
    {
        _msg = msg;
        _ = Task.Delay(3000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    // ── 등급 / 표시 헬퍼 ─────────────────────────────────────────────────
    static string GradeKey(decimal oee) => oee >= WORLD_CLASS ? "wc" : oee >= GOOD ? "ok" : "lo";
    static string KpiCls(decimal oee)   => oee >= WORLD_CLASS ? "ok" : oee >= GOOD ? "warn" : "bad";
    string GradeText(decimal oee) => GradeKey(oee) switch
    {
        "wc" => L["PP.Oee.Grade.WorldClass"].Value,
        "ok" => L["PP.Oee.Grade.Good"].Value,
        _    => L["PP.Oee.Grade.Low"].Value,
    };

    static MarkupString Bar(decimal v, string key)
    {
        var w = Math.Min(100m, Math.Max(0m, v)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        return new MarkupString(
            $"<div class=\"pp-oee-apq\"><div class=\"pp-oee-track\"><i class=\"pp-oee-fill-{key}\" style=\"width:{w}%\"></i></div>" +
            $"<span class=\"pp-oee-apq-val\">{v:F1}%</span></div>");
    }

    // ── SVG 빌더 (Blazor <text> 태그 충돌 우회용 MarkupString) ──────────
    static string GradeColor(decimal oee) => oee >= WORLD_CLASS ? "#059669" : oee >= GOOD ? "#d97706" : "#dc2626";

    static string BuildDonutSvg(decimal oee)
    {
        var inv     = System.Globalization.CultureInfo.InvariantCulture;
        double circ = 2.0 * Math.PI * 52.0;
        double dash = Math.Min(1.0, (double)oee / 100.0) * circ;
        return $"""
            <svg viewBox="0 0 150 150" width="150" height="150" xmlns="http://www.w3.org/2000/svg">
              <circle cx="75" cy="75" r="52" fill="none" class="pp-oee-donut-track" stroke-width="18"/>
              <circle cx="75" cy="75" r="52" fill="none" stroke="{GradeColor(oee)}" stroke-width="18"
                      stroke-dasharray="{dash.ToString("F2", inv)} {circ.ToString("F2", inv)}" transform="rotate(-90 75 75)"/>
              <text x="75" y="80" text-anchor="middle" font-family="'JetBrains Mono',monospace" font-size="26" font-weight="900" fill="currentColor">{oee.ToString("F1", inv)}%</text>
              <text x="75" y="96" text-anchor="middle" font-size="10" fill="#64748b">OEE</text>
            </svg>
            """;
    }

    // ── 추세 차트 데이터 (RadzenChart) ──────────────────────────────────
    // X 는 날짜 축: 같은 날의 교대는 24h/교대수 간격으로 벌려 겹치지 않게 한다.
    public sealed class TrendPoint
    {
        public DateTime At   { get; set; }
        public string   Label { get; set; } = "";
        public double   Oee  { get; set; }
        public double   A    { get; set; }
    }

    static List<TrendPoint> TrendPoints(List<OeeSnapshotDto> snaps)
    {
        var list = new List<TrendPoint>();
        foreach (var day in snaps.GroupBy(s => s.PeriodDate.Date).OrderBy(g => g.Key))
        {
            var shifts = day.OrderBy(s => s.ShiftCode).ToList();
            double gap = 24.0 / Math.Max(1, shifts.Count);
            for (int i = 0; i < shifts.Count; i++)
            {
                var s = shifts[i];
                list.Add(new TrendPoint
                {
                    At    = day.Key.AddHours(gap * i),
                    Label = $"{s.PeriodDate:MM-dd} {s.ShiftCode}",
                    Oee   = (double)s.Oee,
                    A     = (double)s.Availability,
                });
            }
        }
        return list;
    }

    static string BuildTimelineSvg(List<LineStateLogDto> logs, DateTime day)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        const int W = 1440, H = 46, BAR = 26;
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {W} {H}\" width=\"100%\" preserveAspectRatio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"height:60px;\">");
        sb.Append($"<rect x=\"0\" y=\"0\" width=\"{W}\" height=\"{BAR}\" class=\"pp-oee-donut-track\" fill=\"#64748b\" fill-opacity=\".12\" stroke=\"none\"/>");

        // 같은 상태가 이어지는 분을 하나의 사각형으로 압축
        int i = 0;
        while (i < logs.Count)
        {
            var cur = logs[i]; int j = i;
            while (j + 1 < logs.Count && Key(logs[j + 1]) == Key(cur)) j++;
            int x0 = (int)(logs[i].MinuteTs - day.Date).TotalMinutes;
            int x1 = (int)(logs[j].MinuteTs - day.Date).TotalMinutes + 1;
            x0 = Math.Clamp(x0, 0, W); x1 = Math.Clamp(x1, 0, W);
            if (x1 > x0)
                sb.Append($"<rect x=\"{x0}\" y=\"0\" width=\"{x1 - x0}\" height=\"{BAR}\" fill=\"{Color(cur)}\"><title>{logs[i].MinuteTs:HH:mm}–{logs[j].MinuteTs.AddMinutes(1):HH:mm} {cur.State} / {cur.PlanState}</title></rect>");
            i = j + 1;
        }
        for (int h = 0; h <= 24; h += 2)
        {
            int x = h * 60;
            sb.Append($"<line x1=\"{x}\" y1=\"{BAR}\" x2=\"{x}\" y2=\"{BAR + 4}\" stroke=\"#64748b\"/>");
            sb.Append($"<text x=\"{x}\" y=\"{H - 4}\" text-anchor=\"{(h == 0 ? "start" : h == 24 ? "end" : "middle")}\" font-size=\"11\" fill=\"#64748b\">{h:00}</text>");
        }
        sb.Append("</svg>");
        return sb.ToString();

        static string Key(LineStateLogDto l) => $"{l.State}|{l.PlanState}";
        static string Color(LineStateLogDto l) =>
            l.PlanState is not null && l.PlanState != "PLAN-RUN" ? "#64748b"
            : l.State switch { "RUN" => "#22c55e", "IDLE" => "#f59e0b", "DOWN" => "#ef4444", _ => "#94a3b8" };
    }
}
