@inject DialogService Dialog
@inject UomFormat UomFmt
@inject IStringLocalizer<SharedResources> L
@using AMES.Data.Aps
@using AMES.Data.Repositories

@* PP-APS WO 미리보기 보드의 블록 클릭 상세(2026-10-07) — 이번 생성 WO 는 전 단계 배치·MC·부족까지, 기존 슬롯·MC·PM 은 블록 정보만 *@
<div style="display:flex;flex-direction:column;gap:12px;min-width:640px;">
    <div class="wp-tiles">
        @if (IsWo)
        {
            <div class="wp-tile"><span class="dim">@L["Col.WoNo"]</span><b class="code">@(Block.WoNumber ?? "—")</b></div>
            <div class="wp-tile"><span class="dim">@L["Col.ItemNo"]</span><b class="code">@(Block.ItemNo ?? "—")</b></div>
            @if (Order is { } o)
            {
                @* BOM 규칙 WO: WO 품번은 완제품, 사출 슬롯이 찍는 자식 품번은 따로 보인다(2026-10-12 사용자 요청) *@
                <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Col.InjItem"]</span><b class="code" title="@string.Join(", ", InjItems(o))">@(InjItems(o).Count == 0 ? "—" : string.Join(", ", InjItems(o)))</b></div>
                <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Col.Date"]</span><b class="code">@o.PlanDate.ToString(DateFmt.Date)</b></div>
                <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Col.So"]</span><b>@(o.SoId is int so ? $"SO #{so}" : L["PP.Aps.Wo.StockWo"].Value)</b></div>
                <div class="wp-tile"><span class="dim">@L["Col.Qty"]</span><b>@UomFmt.Qty(o.Qty, null)</b></div>
                <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Col.Deadline"] / @L["Col.Due"]</span><b class="code">@(o.Deadline?.ToString(DateFmt.Date) ?? "—") / @(o.DueDate?.ToString(DateFmt.Date) ?? "—")</b></div>
                <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Col.Late"]</span><b>@(o.LateQty > 0 ? UomFmt.Qty(o.LateQty, null) : "—")</b></div>
                <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Col.Over"]</span><b class="@(o.OverQty > 0 ? "bad" : "")">@(o.OverQty > 0 ? UomFmt.Qty(o.OverQty, null) : "—")</b></div>
                @if (o.ShortQty > 0) { <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Col.Short"]</span><b class="bad">@UomFmt.Qty(o.ShortQty, null)</b></div> }
            }
            else
            {
                <div class="wp-tile"><span class="dim">@L["Col.Qty"]</span><b>@UomFmt.Qty(Block.Qty, null)</b></div>
            }
        }
        else if (IsMc)
        {
            <div class="wp-tile"><span class="dim">@L["PP.LineSchedule.Mc.Name"]</span><b class="code">@(Block.Title ?? Block.MoldId ?? "—")</b></div>
            @if (Block.WoNumber is not null) { <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Detail.Before"]</span><b class="code">@Block.WoNumber · @Block.ItemNo</b></div> }
        }
        else
        {
            <div class="wp-tile"><span class="dim">@L["PP.Aps.Wo.Detail.Pm"]</span><b>@(Block.Title ?? "—")</b></div>
        }
    </div>

    <div class="wp-sec">
        <div class="wp-sec-h">
            <span>@L["PP.Aps.Wo.Detail.ThisSlot"] — <span class="code">@LineId · @Date.ToString(DateFmt.Date) · @Hm(Block.StartMin)~@Hm(Block.EndMin) (@Block.Minutes@L["Lbl.Min"])</span></span>
            @if (IsWo && Block.MoldId is not null) { <span class="pill mute">@L["PP.Aps.Wo.Detail.Mold"] @Block.MoldId</span> }
            @if (Block.Late) { <span class="pill warn">@L["PP.Aps.Wo.Lgd.Late"]</span> }
        </div>
        @if (Block.Kind is ApsWoBoard.BlockKind.OldWo or ApsWoBoard.BlockKind.OldMoldChange) { <div class="dim">@L["PP.Aps.Wo.Detail.ExistingSlot"]</div> }
        @if (CanEdit)
        {
            <div class="wp-edit">
                <div class="wp-edit-h">@L["PP.Aps.Wo.Edit.Title"]</div>
                <div class="wp-edit-grid">
                    <label><span>@L["Col.Line"]</span><RadzenDropDown TValue="string" @bind-Value="_line" Data="@Lines" TextProperty="LineId" ValueProperty="LineId" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" /></label>
                    <label><span>@L["Col.Date"]</span><RadzenDropDown TValue="string" @bind-Value="_date" Data="@DateOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" /></label>
                    <label><span>@L["PP.Aps.Wo.Edit.Start"]</span><RadzenTextBox @bind-Value="_start" Placeholder="HH:mm" MaxLength="5" class="ames-rz-input" Style="width:100%;" /></label>
                    <label><span>@L["PP.Aps.Wo.Edit.Dur"]</span><RadzenNumeric TValue="int" @bind-Value="_minutes" Min="5" Max="1440" Step="5" class="ames-rz-input" Style="width:100%;" /></label>
                    <label><span>@L["Col.Qty"]</span><RadzenNumeric TValue="decimal" @bind-Value="_qty" Min="0" class="ames-rz-input" Style="width:100%;" /></label>
                </div>
                <div class="dim" style="font-size:.85em;">@L["PP.Aps.Wo.Edit.QtyWarn"] @L["PP.Aps.Wo.Edit.McHint"]</div>
                @if (!string.IsNullOrEmpty(_err)) { <div class="ames-alert bad">@_err</div> }
            </div>
        }
        @if (Block.Siblings.Count > 0)
        {
            <div class="dim" style="margin-top:6px;">@L["PP.Aps.Wo.Siblings"]</div>
            <table class="ames-table" style="width:100%;">
                <thead><tr><th>@L["Col.WoNo"]</th><th>@L["Col.ItemNo"]</th><th style="text-align:right;">@L["Col.Qty"]</th></tr></thead>
                <tbody>@foreach (var s in Block.Siblings) { <tr><td class="code">@s.WoNumber</td><td class="code">@s.ItemNo</td><td style="text-align:right;">@UomFmt.Qty(s.Qty, null)@if (s.OverQty > 0) { <div class="wp-over">@string.Format(L["PP.Aps.Wo.Row.Over"].Value, UomFmt.Qty(s.OverQty, null))</div> }</td></tr> }</tbody>
            </table>
        }
    </div>

    @if (Order is { } wo)
    {
        var injSeq = ApsWoBoard.InjStepSeq(wo);
        <div class="wp-sec">
            <div class="wp-sec-h">@L["PP.Aps.Wo.Detail.Placements"]</div>
            <table class="ames-table" style="width:100%;">
                <thead><tr><th>@L["PP.Aps.Wo.Detail.Step"]</th><th>@L["Col.Line"]</th><th>@L["Col.Date"]</th><th>@L["Col.Time"]</th><th style="text-align:right;">@L["Lbl.Min"]</th><th style="text-align:right;">@L["Col.Qty"]</th><th>@L["PP.Aps.Wo.Detail.Mold"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in wo.Placements.OrderBy(p => p.StepSeq).ThenBy(p => p.Date).ThenBy(p => p.StartMin))
                    {
                        bool here = p.LineId == LineId && DateOnly.FromDateTime(p.Date) == Date && p.StartMin == Block.StartMin && p.EndMin == Block.EndMin;
                        <tr class="@(here ? "wp-here" : "")">
                            <td>@(p.StepSeq == injSeq ? L["PP.Aps.Tab.Inj"] : L["PP.Aps.Tab.Asm"]) <span class="dim">#@p.StepSeq</span>@if (p.ItemNo is { } pi) { <div class="code wp-step-item">@pi</div> }</td>
                            <td class="code">@p.LineId</td>
                            <td class="code">@p.Date.ToString(DateFmt.Date)</td>
                            <td class="code">@Hm(p.StartMin)~@Hm(p.EndMin)</td>
                            <td style="text-align:right;">@(p.EndMin - p.StartMin)</td>
                            <td style="text-align:right;">@UomFmt.Qty(p.Qty, null)@if (p.OverQty > 0) { <div class="wp-over">@string.Format(L["PP.Aps.Wo.Row.Over"].Value, UomFmt.Qty(p.OverQty, null))</div> }</td>
                            <td class="code">@(p.MoldId ?? "—")</td>
                            <td>@if (p.Late) { <span class="pill warn">@L["PP.Aps.Wo.Lgd.Late"]</span> }</td>
                        </tr>
                    }
                    @foreach (var m in wo.MoldChanges)
                    {
                        <tr>
                            <td>@L["PP.LineSchedule.Mc.Name"]</td>
                            <td class="code">@m.LineId</td>
                            <td class="code">@m.Date.ToString(DateFmt.Date)</td>
                            <td class="code">@Hm(m.StartMin)~@Hm(m.EndMin)</td>
                            <td style="text-align:right;">@(m.EndMin - m.StartMin)</td>
                            <td></td>
                            <td class="code">@(m.FromMoldId is null ? m.ToMoldId : $"{m.FromMoldId} → {m.ToMoldId}")</td>
                            <td></td>
                        </tr>
                    }
                    @foreach (var sf in wo.Shortfalls)
                    {
                        <tr>
                            <td>@(sf.StepSeq == injSeq ? L["PP.Aps.Tab.Inj"] : L["PP.Aps.Tab.Asm"]) <span class="dim">#@sf.StepSeq</span></td>
                            <td class="code">@sf.LineId</td>
                            <td colspan="3"><span class="pill bad">@L["PP.Aps.Wo.Col.Short"]</span></td>
                            <td style="text-align:right;">@UomFmt.Qty(sf.Qty, null)</td>
                            <td></td><td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="ames-modal-footer">
        @if (CanEdit && IsEdited)
        {
            <RadzenButton Text="@L["PP.Aps.Wo.Edit.Revert"]" Icon="undo" ButtonStyle="ButtonStyle.Warning" Click="@(() => Dialog.Close(new RevertRequest()))" />
        }
        <RadzenButton Text="@L["Btn.Close"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialog.Close())" />
        @if (CanEdit)
        {
            <RadzenButton Text="@L["PP.Aps.Wo.Edit.Apply"]" Icon="check" ButtonStyle="ButtonStyle.Primary" Click="Apply" />
        }
    </div>
</div>

@code {
    /// <summary>사출 슬롯이 찍는 자식 품번(중복 제거, 품번순) — 같은 품번 규칙 WO 는 WO 품번 자신.</summary>
    static List<string> InjItems(PpRepository.ApsWoOrder o) =>
        o.Placements.Where(p => !string.IsNullOrEmpty(p.ItemNo)).Select(p => p.ItemNo!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.Ordinal).ToList();

    [Parameter] public ApsWoBoard.Block Block { get; set; } = default!;
    [Parameter] public PpRepository.ApsWoOrder? Order { get; set; }
    [Parameter] public string LineId { get; set; } = "";
    [Parameter] public DateOnly Date { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool IsEdited { get; set; }
    [Parameter] public IReadOnlyList<ApsRepository.LineChoice> Lines { get; set; } = Array.Empty<ApsRepository.LineChoice>();
    [Parameter] public IReadOnlyList<DateOnly> Dates { get; set; } = Array.Empty<DateOnly>();

    /// <summary>「적용」 결과 — 페이지가 ApsSlotEdit 로 바꿔 검증·기록한다. Qty 는 바뀐 경우만.</summary>
    public sealed record EditRequest(string LineId, DateOnly Date, int StartMin, int Minutes, decimal? Qty);
    public sealed record RevertRequest;

    string _line = "", _date = "", _start = "", _err = "";
    int _minutes; decimal _qty;
    IEnumerable<DateOption> DateOptions => Dates.Select(d => new DateOption(d.ToString("yyyy-MM-dd"), d.ToString(DateFmt.Date)));
    sealed record DateOption(string Value, string Text);

    protected override void OnInitialized()
    {
        _line = LineId; _date = Date.ToString("yyyy-MM-dd"); _start = Hm(Block.StartMin); _minutes = Block.Minutes; _qty = Block.Qty;
    }

    void Apply()
    {
        _err = "";
        if (!TimeOnly.TryParseExact(_start, "HH:mm", out var t)) { _err = L["PP.Aps.Wo.Edit.Reason.BadRange"]; return; }
        if (_minutes <= 0 || _qty <= 0 || !DateOnly.TryParseExact(_date, "yyyy-MM-dd", out var d) || string.IsNullOrEmpty(_line)) { _err = L["PP.Aps.Wo.Edit.Reason.BadRange"]; return; }
        Dialog.Close(new EditRequest(_line, d, ApsSlotEditRules.Snap(t.Hour * 60 + t.Minute), _minutes, _qty == Block.Qty ? null : _qty));
    }

    bool IsWo => Block.Kind is ApsWoBoard.BlockKind.NewWo or ApsWoBoard.BlockKind.OldWo;
    bool IsMc => Block.Kind is ApsWoBoard.BlockKind.NewMoldChange or ApsWoBoard.BlockKind.OldMoldChange;

    static string Hm(int min) { int m = ((min % 1440) + 1440) % 1440; return $"{m / 60:00}:{m % 60:00}"; }
}
