                          .OrderBy(p => p.StartMin).ToList();
        int cur = start;
        foreach (var p in pms)
        {
            int ps = Math.Max(start, p.StartMin);
            if (ps > cur) yield return (cur, ps);
            cur = Math.Max(cur, Math.Min(end, p.EndMin));
