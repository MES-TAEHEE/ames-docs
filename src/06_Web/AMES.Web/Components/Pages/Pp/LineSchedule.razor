@page "/pp/line-schedule"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject LineScheduleRepository LSB
@inject WorkOrderRepository Wos
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

@implements IDisposable

<PageTitle>LSB @L["PP.LineSchedule.Title"] · AMES</PageTitle>
<AmesPageHeader Code="PP-LSB" TitleKey="PP.LineSchedule.Title" />

@* ── KPI ──────────────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["PP.LineSchedule.Kpi.Blocks"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_slots.Count</div>
            <div class="ames-kpi-s">@string.Format(L["PP.LineSchedule.Kpi.BlocksSub"].Value, OperatingMin, RemainMin)</div>
        </div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["PP.LineSchedule.Kpi.DownMin"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@DowntimeMin<span style="font-size:14px;margin-left:3px;">@L["Lbl.Min"]</span></div>
            <div class="ames-kpi-s">@L["PP.LineSchedule.Kpi.DownMinSub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["PP.LineSchedule.Kpi.Qty"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@PlannedQty.ToString("N0")</div>
            <div class="ames-kpi-s">@L["PP.LineSchedule.Kpi.QtySub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(OperatingMin == 0 ? "" : Utilization > 100 ? "bad" : Utilization >= 80 ? "ok" : "warn")">
        <div class="ames-kpi-l">@L["PP.LineSchedule.Kpi.Util"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@Utilization<span style="font-size:14px;margin-left:2px;">%</span></div>
            <div class="ames-kpi-s">@L["PP.LineSchedule.Kpi.UtilTarget"]</div>
        </div>
    </div>
    <div class="ames-kpi @(TotalConflicts > 0 ? "bad" : "ok")">
        <div class="ames-kpi-l">@L["PP.LineSchedule.Kpi.Conflict"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@TotalConflicts</div>
            <div class="ames-kpi-s">@L["PP.LineSchedule.Kpi.ConflictSub"]</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_err)) { <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_err</RadzenAlert> }
@if (!string.IsNullOrEmpty(_msg)) { <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat">@_msg</RadzenAlert> }

@* ── 조회 / 상태 툴바 ──────────────────────────────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <RadzenLabel Text="@L["Col.Line"]" />
            <RadzenDropDown TValue="string" @bind-Value="_lineId" @bind-Value:after="LoadData" Data="@LineOptions" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" Placeholder="@L["PP.LineSchedule.Ph.SelectLine"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:280px;" />
            <RadzenDatePicker TValue="DateTime" @bind-Value="_date" @bind-Value:after="LoadData" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenLabel Text="@L["PP.LineSchedule.Lbl.Pattern"]" />
            @* 적용(DRAFT)/발행(PUBLISHED)된 라인+일자는 패턴 변경 불가, 저장 스케줄이 없을 때만 선택 가능 *@
            <RadzenDropDown TValue="string" @bind-Value="_patternId" @bind-Value:after="OnPatternChanged" Data="@PatternDdOptions" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" AllowClear="true" Disabled="@(string.IsNullOrEmpty(_lineId) || _savedStatus != null)" Placeholder="@L["PP.LineSchedule.Ph.SelectPattern"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:400px;" />
            @* 초기화: 오늘 이후 날짜에서만 노출, 적용됐지만 미발행(DRAFT)일 때만 활성 → 저장 스케줄 삭제 *@
            @if (_date.Date >= ServerNow.Date)
            {
                <RadzenButton Text="@L["Btn.Reset"]" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Disabled="@(_savedStatus != "DRAFT")" Click="@(() => _confirmReset = true)" class="ames-rz-btn" />
            }
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
            @StatusPill()
            @if (_canEdit)
            {
                @* PM 등록: 패턴 선택 + 금일 이후에만. 예방보전 밴드를 가동시간대에 추가 *@
                <RadzenButton Text="@L["PP.LineSchedule.Btn.AddPm"]" Icon="build" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Disabled="@(!Editable || string.IsNullOrEmpty(_patternId))" Click="@OpenPmModal" class="ames-rz-btn" />
                <RadzenButton Text="@L["PP.LineSchedule.Btn.Apply"]" Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Disabled="@(string.IsNullOrEmpty(_patternId) || _date.Date < ServerNow.Date)" Click="@Apply" class="ames-rz-btn" />
                @* 발행: DB에 적용(저장)된 Draft 상태이고 미변경일 때만 활성화 *@
                <RadzenButton Text="@L["PP.LineSchedule.Btn.Publish"]" Icon="publish" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Disabled="@(_savedStatus != "DRAFT" || _dirty || _date.Date < ServerNow.Date)" Click="@Publish" class="ames-rz-btn" />
            }
        </div>
    </div>
    @* 발행 정보: 버튼 줄이 넘치지 않도록 헤더 아래 오른쪽 끝 별도 줄로 표시 (발행됐을 때만) *@
    @if (_publishedAt.HasValue)
    {
        <div style="display:flex;justify-content:flex-end;padding:0 14px 8px;">
            <span class="dim" style="font-size:11px;">
                @_publishedAt.Value.ToString("MM-dd HH:mm") @(_publishedBy is null ? "" : $"· {_publishedBy}")
            </span>
        </div>
    }

    @if (string.IsNullOrEmpty(_lineId))
    {
        <div class="ames-empty">@L["PP.LineSchedule.Empty.NoLine"]</div>
    }
    else if (string.IsNullOrEmpty(_patternId))
    {
        <div class="ames-empty">@(PatternOptions.Any() ? L["PP.LineSchedule.Ph.SelectPattern"].Value : L["PP.LineSchedule.Empty.NoPattern"].Value)</div>
    }
    else
    {
        @* WO 배치/수정은 밴드·WO 클릭 시 모달로 처리 (하단 참조) *@

        @* ── 타임라인 ── *@
        <div class="pp-tl-h">
            <span class="pp-tl-t">
                ▤ @string.Format(L["PP.LineSchedule.Tl.Title"].Value, MinToTime(HdrStart), MinToTime(HdrEnd))
            </span>
            <div class="pp-tl-legend">
                @foreach (var st in _segStates.Where(c => c.UseFlag))
                {
                    <span class="pp-lgd"><i style="background:color-mix(in srgb, @(SegColor(st.CodeValue ?? "")) 80%, transparent);"></i>@MasterDataRepository.LocalName(st)</span>
                }
                <span class="pp-lgd"><i style="background:rgba(168,85,247,.7);"></i>@L["PP.LineSchedule.Lgd.Wo"]</span>
                @* PM(예방보전)은 공통코드 SEGMENT_STATE 에 포함되어 위 루프에서 자동 표시됨 *@
            </div>
        </div>

        @GanttView()

        <div class="dim" style="font-size:11px;padding:6px 14px 10px;">@L["PP.LineSchedule.Hint.Board"]</div>

        @if (TotalConflicts > 0)
        {
            <div style="padding:0 14px 10px;">
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@string.Format(L["PP.LineSchedule.Err.ConflictSummary"].Value, TotalConflicts)</RadzenAlert>
            </div>
        }

        @* ── 배치 목록 ── *@
        <div class="ames-card-h" style="border-top:1px solid rgba(255,255,255,.06);">
            ▼ @L["PP.LineSchedule.Lbl.SlotList"] · @_slots.Count @L["Lbl.Items"]
        </div>
        <RadzenDataGrid TItem="StagedWo" Data="@_slots.ToList()" AllowPaging="false"
                        RowClick="@(a => { if (Editable && a.Data is not null) EditSlot(a.Data.WoId); })" RowRender="@SlotRowRender" EmptyText="@L["PP.LineSchedule.Empty.NoSlot"]" Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="StagedWo" Title="@L["PP.LineSchedule.Col.Label"]" TextAlign="TextAlign.Center" Width="60px" Sortable="false">
                    <Template Context="s"><span class="pill info">@SlotLabel(s)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StagedWo" Title="@L["PP.LineSchedule.Col.Wo"]" TextAlign="TextAlign.Center" Width="130px">
                    <Template Context="s"><span class="code">@s.WoNumber</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StagedWo" Title="@L["Col.Item"]" >
                    <Template Context="s"><span class="dim">@(s.ItemName ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StagedWo" Title="@L["Col.Start"]" TextAlign="TextAlign.Center" Width="90px">
                    <Template Context="s"><span class="code">@MinToTime(s.StartMin)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StagedWo" Title="@L["Col.End"]" TextAlign="TextAlign.Center" Width="90px">
                    <Template Context="s"><span class="code">@MinToTime(s.EndMin)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StagedWo" Title="@L["Col.Duration"]" TextAlign="TextAlign.Right" Width="90px">
                    <Template Context="s">@(s.EndMin - s.StartMin)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StagedWo" Title="@L["PP.LineSchedule.Lbl.PlannedQty"]" TextAlign="TextAlign.Right" Width="120px">
                    <Template Context="s">@s.Qty.ToString("N0")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StagedWo" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="100px">
                    <Template Context="s">
                        @if (ConflictIds.Contains(s.WoId)) { <span class="pill bad">@L["PP.LineSchedule.Cf.Conflict"]</span> }
                        else { <span class="pill ok">@L["PP.LineSchedule.Cf.Ok"]</span> }
                    </Template>
                </RadzenDataGridColumn>
                @if (Editable)
                {
                    <RadzenDataGridColumn TItem="StagedWo" TextAlign="TextAlign.Center" Width="120px" Sortable="false">
                        <Template Context="s">
                            <div @onclick:stopPropagation>
                                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="@(() => RemoveSlot(s.WoId))" class="ames-rz-btn" Style="height:24px;padding:0 8px;line-height:1;" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>

        @* ── PM(예방보전) 밴드 목록 ── *@
        <div class="ames-card-h" style="border-top:1px solid rgba(255,255,255,.06);">
            ▼ @L["PP.LineSchedule.Pm.ListTitle"] · @_pmBands.Count @L["Lbl.Items"]
        </div>
        <RadzenDataGrid TItem="PmBand" Data="@_pmBands.OrderBy(p => p.StartMin).ToList()" AllowPaging="false"
                        RowClick="@(a => { if (Editable && a.Data is not null) EditPm(a.Data.Id); })" RowRender="@PmRowRender" EmptyText="@L["PP.LineSchedule.Pm.Empty"]" Class="ames-rz-grid">
            <Columns>
                <RadzenDataGridColumn TItem="PmBand" Title="@L["PP.LineSchedule.Pm.Name"]">
                    <Template Context="p"><span class="pill orange">@L["PP.LineSchedule.Lgd.Pm"]</span> <span>@(string.IsNullOrWhiteSpace(p.Title) ? "—" : p.Title)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PmBand" Title="@L["PP.LineSchedule.Pm.Ref"]">
                    <Template Context="p"><span class="dim">@(p.RefLabel ?? "—")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PmBand" Title="@L["Col.Start"]" TextAlign="TextAlign.Center" Width="90px">
                    <Template Context="p"><span class="code">@MinToTime(p.StartMin)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PmBand" Title="@L["Col.End"]" TextAlign="TextAlign.Center" Width="90px">
                    <Template Context="p"><span class="code">@MinToTime(p.EndMin)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PmBand" Title="@L["Col.Duration"]" TextAlign="TextAlign.Right" Width="90px">
                    <Template Context="p">@(p.EndMin - p.StartMin)</Template>
                </RadzenDataGridColumn>
                @if (Editable)
                {
                    <RadzenDataGridColumn TItem="PmBand" TextAlign="TextAlign.Center" Width="120px" Sortable="false">
                        <Template Context="p">
                            <div @onclick:stopPropagation>
                                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="@(() => RemovePm(p.Id))" class="ames-rz-btn" Style="height:24px;padding:0 8px;line-height:1;" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
</div>

@* ── WO 배치 / 수정 모달 (가동 밴드 또는 WO 클릭 시) ─────────────────── *@
@if (_showPlaceModal)
{
    var editing = _editWoId.HasValue;
    var blocked = !editing && RemainMin <= 0;
    <div class="ames-modal-bg" @onmousedown="OnModalBgDown" @onclick="OnModalBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">
                @(editing ? L["PP.LineSchedule.Btn.Update"].Value : L["PP.LineSchedule.Btn.Place"].Value)
                @if (!string.IsNullOrEmpty(_bandWindow))
                {
                    <span class="dim" style="font-weight:400;font-size:.9em;margin-left:8px;">@_bandWindow</span>
                }
            </div>

            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="width:100%;">
                <div>
                    <RadzenLabel Text="@L["PP.LineSchedule.Lbl.WoSelect"]" />
                    @if (editing)
                    {
                        <RadzenTextBox Value="@(_slots.FirstOrDefault(s => s.WoId == _editWoId)?.WoNumber ?? "")" ReadOnly="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    }
                    else
                    {
                        <RadzenDropDown TValue="string" @bind-Value="_placeWoIdStr" @bind-Value:after="OnPlaceWoChanged" Data="@WoOptions" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    }
                </div>
                <RadzenRow Gap="8px">
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="@L["PP.LineSchedule.Lbl.StartTime"]" />
                        @* 시작시간은 자동 결정(밴드 클릭/편집) — 수정 불가. 지속 변경 시 이후 WO가 자동 이동 *@
                        <RadzenDatePicker TValue="DateTime?" @bind-Value="PlaceStartDt" Disabled="true" TimeOnly="true" ShowTime="true" ShowTimeOkButton="false" HourFormat="24" DateFormat="HH:mm" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="@L["PP.LineSchedule.Lbl.Duration"]" />
                        <RadzenNumeric TValue="int" @bind-Value="_placeDurMin" Min="1" Max="1440" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenLabel Text="@L["PP.LineSchedule.Lbl.PlannedQty"]" />
                        <RadzenNumeric TValue="decimal" @bind-Value="_placeQty" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(blocked ? L["PP.LineSchedule.Btn.CapOver"].Value : editing ? L["PP.LineSchedule.Btn.Update"].Value : L["PP.LineSchedule.Btn.Place"].Value)"
                              Icon="@(editing ? "check" : "add")" ButtonStyle="@(editing ? ButtonStyle.Success : ButtonStyle.Primary)" Size="ButtonSize.Small"
                              Disabled="@blocked" Click="@SaveSlot" class="ames-rz-btn" />
                @if (editing)
                {
                    <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DeleteEditingSlot" class="ames-rz-btn" />
                }
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ClosePlaceModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── PM(예방보전) 밴드 등록 / 수정 모달 ───────────────────────────────── *@
@if (_showPmModal)
{
    var editingPm = _editPmId.HasValue;
    <div class="ames-modal-bg" @onmousedown="OnPmModalBgDown" @onclick="OnPmModalBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">
                @(editingPm ? L["PP.LineSchedule.Pm.EditTitle"].Value : L["PP.LineSchedule.Pm.AddTitle"].Value)
            </div>

            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="width:100%;">
                <div>
                    <RadzenLabel Text="@L["PP.LineSchedule.Pm.Ref"]" />
                    @* MNT_PMSchedule 도래 예정 PM 선택 시 명칭 자동 채움 + RefType/RefID 연계. 미선택 = 수동 밴드 *@
                    <RadzenDropDown TValue="string" @bind-Value="_pmRefStr" @bind-Value:after="OnPmRefChanged" Data="@PmRefOptions" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" AllowClear="true" Placeholder="@L["PP.LineSchedule.Pm.RefPh"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["PP.LineSchedule.Pm.Name"]" />
                    <RadzenTextBox @bind-Value="_pmTitle" MaxLength="100" Placeholder="@L["PP.LineSchedule.Pm.NamePh"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <RadzenRow Gap="8px">
                    <RadzenColumn Size="6">
                        <RadzenLabel Text="@L["PP.LineSchedule.Lbl.StartTime"]" />
                        <RadzenDatePicker TValue="DateTime?" @bind-Value="PmStartDt" TimeOnly="true" ShowTime="true" ShowTimeOkButton="false" HourFormat="24" DateFormat="HH:mm" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenLabel Text="@L["PP.LineSchedule.Lbl.Duration"]" />
                        <RadzenNumeric TValue="int" @bind-Value="_pmDurMin" Min="1" Max="1440" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_pmModalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_pmModalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(editingPm ? L["PP.LineSchedule.Btn.Update"].Value : L["PP.LineSchedule.Btn.Place"].Value)"
                              Icon="@(editingPm ? "check" : "add")" ButtonStyle="@(editingPm ? ButtonStyle.Success : ButtonStyle.Primary)" Size="ButtonSize.Small"
                              Click="@SavePm" class="ames-rz-btn" />
                @if (editingPm)
                {
                    <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DeleteEditingPm" class="ames-rz-btn" />
                }
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ClosePmModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 초기화(삭제) 확인 ─────────────────────────────────────────────── *@
@if (_confirmReset)
{
    <div class="ames-modal-bg" @onclick="() => _confirmReset = false">
        <div class="ames-modal" style="max-width:420px;" @onclick:stopPropagation>
            <div class="ames-modal-h">@L["Btn.Reset"]</div>
            <div style="padding:8px 2px 14px;font-size:14px;color:#cbd5e1;line-height:1.7;">
                @L["PP.LineSchedule.Confirm.Reset"]
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@L["Btn.Confirm"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@Reset" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(() => _confirmReset = false)" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════════════ *@
@* ── Render Fragment: Gantt (밴드 = 선택 패턴 세그먼트, WO 오버레이) ── *@
@* ══════════════════════════════════════════════════════════════════ *@
@code {
    RenderFragment GanttView() => __b =>
    {
        int dayStart = _dayStart;
        const int rangeMin = 1440;   // 하루(교대 A→B→C, 야간 교대는 익일로 감쌈)

        // 절대분 → 하루 시작 기준 상대분(0..1440). 끝값은 경계에서 1440로 매핑
        int Rel(int m)    { int r = m - dayStart; if (r < 0)  r += 1440; return r; }
        int RelEnd(int m) { int r = m - dayStart; if (r <= 0) r += 1440; return r; }
        string LeftPct(int rel)            => $"{(double)rel / rangeMin * 100.0:F4}%";
        string WidthPct(int rlo, int rhi)  => $"{(double)(rhi - rlo) / rangeMin * 100.0:F4}%";

