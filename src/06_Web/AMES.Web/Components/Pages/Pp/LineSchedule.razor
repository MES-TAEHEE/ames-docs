                         .ToList();
            _pmBands = rows.Where(r => r.EntryType == "PM" && r.EndMin > r.StartMin)
                           .Select(r => new PmBand(r.ScheduleId, r.StartMin, r.EndMin, r.Title, r.RefType, r.RefId, PmRefLabel(r.RefType, r.RefId)))
                           .ToList();
            if (!string.IsNullOrEmpty(_patternId)) LoadSegments();
            ResetPlaceForm();
        }
        catch (Exception ex) { _err = string.Format(L["PP.LineSchedule.Err.Load"].Value, ex.Message); }
    }

    // MNT 연계 표시명 — 현재는 MNT_PMSchedule(PMSCH) 후보에서 조회
    string? PmRefLabel(string? refType, int? refId)
    {
        if (refType == "PMSCH" && refId is int id &&
            _pmCandidates.FirstOrDefault(c => c.PmScheduleId == id) is { } c)
            return $"[{c.EquipId}] {c.EquipName ?? c.EquipId} · {c.PmType ?? "PM"}";
        return null;
    }

    // 초기화: 적용됐지만 미발행(DRAFT)인 경우, 해당 라인+일자의 저장 스케줄을 삭제해 초기화 (확인창 후)
    void Reset()
    {
        _err = "";
        _confirmReset = false;
        if (string.IsNullOrEmpty(_lineId) || _savedStatus != "DRAFT") return;
        try
        {
            LSB.DeleteSchedule(_lineId, _date);
            ShowMsg(L["PP.LineSchedule.Ok.Reset"].Value);
            LoadData();
        }
        catch (Exception ex) { _err = ex.Message; }
    }

    void OnPatternChanged()
    {
        LoadSegments();
        ResetPlaceForm();
        _dirty = true;
    }

    void LoadSegments()
    {
        _segments = string.IsNullOrEmpty(_patternId) ? new() : MD.ListLineTimeSegments(_patternId);
        AdjustRange();
    }

    void AdjustRange()
    {
        var bands = Bands;
        if (bands.Count == 0) { _dayStart = 6 * 60; return; }
        // SortOrder가 가장 작은(=첫) 교대의 시작 시각을 하루 시작으로 → 축이 A→B→C 순, 야간은 익일로 감쌈
        int minSort = bands.Min(b => ShiftSort(b.Shift));
        _dayStart = bands.Where(b => ShiftSort(b.Shift) == minSort).Min(b => b.StartMin);
    }

    // ── WO 배치 / 수정 (메모리 스테이징) ──────────────────────────────────
    //  시작시간은 고정(비활성). 편집 시 지속(분)을 바꾸면 그 변화량(델타)만큼
    //  이후 등록된 WO들의 시작·종료를 이동 → 줄이면 앞당기고, 늘리면 뒤로 민다(연속 유지).
    void SaveSlot()
    {
        _modalErr = "";
        if (!Editable) { _modalErr = L["PP.LineSchedule.Err.PastDate"]; return; }
        int woId = _editWoId ?? _placeWoId;
        if (woId == 0) { _modalErr = L["PP.LineSchedule.Err.NoWo"]; return; }
        if (_placeDurMin <= 0) { _modalErr = L["PP.LineSchedule.Err.NoWo"]; return; }

        int startMin = _placeStartTime.Hour * 60 + _placeStartTime.Minute;
        int endMin   = startMin + _placeDurMin;

        // 후보 목록 구성
        var cand = new List<StagedWo>(_slots);
        int idx = cand.FindIndex(s => s.WoId == woId);
        bool editing = idx >= 0;
        if (editing)
        {
            var old   = cand[idx];
            int delta = endMin - old.EndMin;                 // 지속 변화량 (음수 = 감소)
            cand[idx] = old with { EndMin = endMin, Qty = _placeQty };
            if (delta != 0)
                for (int i = 0; i < cand.Count; i++)
                    if (i != idx && cand[i].StartMin >= old.EndMin)   // 편집 슬롯 이후에 시작하는 WO들
                        cand[i] = cand[i] with { StartMin = cand[i].StartMin + delta, EndMin = cand[i].EndMin + delta };
        }
        else
        {
            var wo = AvailableWos.FirstOrDefault(w => w.WoId == woId);
            if (wo is null) return;
            cand.Add(new StagedWo(wo.WoId, wo.WoNumber ?? $"#{wo.WoId}", wo.ItemName ?? wo.ItemNo, startMin, endMin, _placeQty));
        }

        // 검증 (전체 후보 기준)
        if (cand.Any(s => s.StartMin < 0 || s.EndMin <= s.StartMin || !InsideOperating(s.StartMin, s.EndMin)))
        { _modalErr = L["PP.LineSchedule.Err.NotInOperating"]; return; }
        var ord = cand.OrderBy(s => s.StartMin).ToList();
        for (int i = 1; i < ord.Count; i++)
            if (ord[i].StartMin < ord[i - 1].EndMin) { _modalErr = L["PP.LineSchedule.Err.Overlap"]; return; }
        // WO는 PM 밴드와 겹칠 수 없음
        if (cand.Any(s => _pmBands.Any(p => Overlap(s.StartMin, s.EndMin, p.StartMin, p.EndMin))))
        { _modalErr = L["PP.LineSchedule.Err.Overlap"]; return; }
        int load = cand.Sum(s => s.EndMin - s.StartMin);
        if (load > OperatingMin)
        { _modalErr = string.Format(L["PP.LineSchedule.Err.CapOver"].Value, OperatingMin - (load - _placeDurMin), _placeDurMin); return; }

        _slots = cand;
        ShowMsg(editing ? L["PP.LineSchedule.Ok.Updated"].Value : L["PP.LineSchedule.Ok.Placed"].Value);
        _dirty = true;
        ClosePlaceModal();
    }

    void EditSlot(int woId)
    {
        if (!Editable) return;
        var s = _slots.FirstOrDefault(x => x.WoId == woId);
        if (s is null) return;
        _modalErr       = "";
        _editWoId       = woId;
        _placeWoId      = 0;
        _placeStartTime = new TimeOnly(s.StartMin / 60, s.StartMin % 60);
        _placeDurMin    = s.EndMin - s.StartMin;
        _placeQty       = s.Qty;
        _bandWindow     = null;
        _showPlaceModal = true;
    }

    void RemoveSlot(int woId)
    {
        if (!Editable) return;
        _slots.RemoveAll(s => s.WoId == woId);
        if (_editWoId == woId) ResetPlaceForm();
        _dirty = true;
    }

    // 신규 배치 시 마지막 슬롯 다음(없으면 첫 가동밴드 시작)을 기본 시작시각으로 제안
    void ResetPlaceForm()
    {
        _editWoId  = null;
        _placeWoId = 0;
        _placeQty  = 0;
        int suggest = _slots.Count > 0
            ? _slots.Max(s => s.EndMin)
            : EffectiveBands.Where(b => b.State == "OPERATING").Select(b => (int?)b.StartMin).Min() ?? _dayStart;
        _placeStartTime = new TimeOnly(Math.Min(23, suggest / 60), suggest % 60);
    }

    // 밴드 클릭 라우팅: 비가동 밴드는 안내 메시지, 가동 밴드만 배치 모달
    void OnBandClick(Band band)
    {
        if (!Editable) return;
        if (band.State != "OPERATING") { ShowMsg(L["PP.LineSchedule.Msg.SelectOperating"].Value); return; }
        OnOperatingBandClick(band);
    }

    // 가동(OPERATING) 밴드 클릭 → 배치 끝시각부터 남은 시간으로 배치 모달 오픈 (신규 배치)
    void OnOperatingBandClick(Band band)
    {
        if (!Editable) return;
        _modalErr = "";
        // 밴드 내 이미 배치된 슬롯의 끝(가장 늦은) 다음부터, 없으면 밴드 시작부터
        var ends = _slots.Where(s => s.StartMin < band.EndMin && s.EndMin > band.StartMin)
                         .Select(s => s.EndMin).ToList();
        int start = ends.Count > 0 ? Math.Max(band.StartMin, ends.Max()) : band.StartMin;
        // 남은 시간이 없으면(가득 참) 모달을 열지 않고 안내
        if (start >= band.EndMin) { ShowMsg(L["PP.LineSchedule.Msg.BandFull"].Value); return; }
        int remain = band.EndMin - start;
        _editWoId       = null;
        _placeWoId      = 0;
        _placeQty       = 0;
        _placeStartTime = new TimeOnly(start / 60, start % 60);
        _placeDurMin    = remain;   // 기본값 = 밴드(잔여) 총 시간
        _bandWindow     = $"{MinToTime(band.StartMin)}–{MinToTime(band.EndMin)}";
        _showPlaceModal = true;
    }

    void ClosePlaceModal()
    {
        _showPlaceModal = false;
        _modalErr = "";
        _bandWindow = null;
        ResetPlaceForm();
    }

    void DeleteEditingSlot()
    {
        if (_editWoId is int woId) RemoveSlot(woId);
        ClosePlaceModal();
    }

    void OnModalBgDown() => _modalBgDown = true;
    void OnModalBgClick() { if (_modalBgDown) ClosePlaceModal(); _modalBgDown = false; }

    // 선택한 WO의 잔여 수량을 계획수량 기본값으로 채움
    void OnPlaceWoChanged()
    {
        var wo = AvailableWos.FirstOrDefault(w => w.WoId == _placeWoId);
        if (wo is not null && _placeQty == 0) _placeQty = wo.OpenQty;
    }

    // ── PM(예방보전) 밴드 등록 / 수정 (메모리 스테이징) ────────────────────
    void OpenPmModal()
    {
        if (!Editable || string.IsNullOrEmpty(_patternId)) return;
        _pmModalErr = ""; _editPmId = null; _pmRefId = null; _pmTitle = "";
        int suggest = Bands.FirstOrDefault(b => b.State == "OPERATING")?.StartMin ?? _dayStart;
        _pmStartTime = new TimeOnly(Math.Min(23, suggest / 60), suggest % 60);
        _pmDurMin = 60;
        _showPmModal = true;
    }

    void EditPm(int id)
    {
        if (!Editable) return;
        var p = _pmBands.FirstOrDefault(x => x.Id == id);
        if (p is null) return;
        _pmModalErr = "";
        _editPmId  = id;
        _pmRefId   = p.RefType == "PMSCH" ? p.RefId : null;
        _pmTitle   = p.Title ?? "";
        _pmStartTime = new TimeOnly(p.StartMin / 60, p.StartMin % 60);
        _pmDurMin  = p.EndMin - p.StartMin;
        _showPmModal = true;
    }

    void RemovePm(int id)
    {
        if (!Editable) return;
        var pm = _pmBands.FirstOrDefault(p => p.Id == id);
        _pmBands.RemoveAll(p => p.Id == id);
        if (_editPmId == id) ClosePmModal();
        // 삭제한 PM이 가동시간을 침범했던 경우에만 → PM으로 밀렸던 WO를 복원된 가동 시작부터 재배치
        if (pm is not null && Bands.Any(b => b.State == "OPERATING" && Overlap(pm.StartMin, pm.EndMin, b.StartMin, b.EndMin)))
            ReflowWos();
        _dirty = true;
    }

    // 도래 예정 PM 선택 시 명칭 자동 제안 (미입력일 때만)
    void OnPmRefChanged()
    {
        if (_pmRefId is int id && _pmCandidates.FirstOrDefault(c => c.PmScheduleId == id) is { } c
            && string.IsNullOrWhiteSpace(_pmTitle))
            _pmTitle = $"{c.EquipName ?? c.EquipId} {c.PmType ?? "PM"}";
    }

    void SavePm()
    {
        _pmModalErr = "";
        if (!Editable) { _pmModalErr = L["PP.LineSchedule.Err.PastDate"]; return; }
        if (_pmDurMin <= 0) { _pmModalErr = L["PP.LineSchedule.Pm.Err.NoDur"]; return; }

        int startMin = _pmStartTime.Hour * 60 + _pmStartTime.Minute;
        int endMin   = startMin + _pmDurMin;
        // PM은 가동시간대 제약·PM/패턴 겹침은 없으나, WO와는 겹칠 수 없음
        if (_slots.Any(s => Overlap(startMin, endMin, s.StartMin, s.EndMin)))
        { _pmModalErr = L["PP.LineSchedule.Err.Overlap"]; return; }

        string? refType  = _pmRefId.HasValue ? "PMSCH" : null;
        string? title    = string.IsNullOrWhiteSpace(_pmTitle) ? null : _pmTitle.Trim();
        string? refLabel = PmRefLabel(refType, _pmRefId);
        bool editing = _editPmId.HasValue;
        if (_editPmId is int eid)
        {
            int i = _pmBands.FindIndex(p => p.Id == eid);
            if (i >= 0) _pmBands[i] = new PmBand(eid, startMin, endMin, title, refType, _pmRefId, refLabel);
        }
        else
        {
            _pmBands.Add(new PmBand(_pmTempSeq--, startMin, endMin, title, refType, _pmRefId, refLabel));
        }
        ShowMsg(editing ? L["PP.LineSchedule.Ok.Updated"].Value : L["PP.LineSchedule.Pm.Ok.Added"].Value);
        _dirty = true;
        ClosePmModal();
    }

    void DeleteEditingPm() { if (_editPmId is int id) RemovePm(id); ClosePmModal(); }

    void ClosePmModal() { _showPmModal = false; _pmModalErr = ""; _editPmId = null; }

    void OnPmModalBgDown() => _pmModalBgDown = true;
    void OnPmModalBgClick() { if (_pmModalBgDown) ClosePmModal(); _pmModalBgDown = false; }

    void PmRowRender(RowRenderEventArgs<PmBand> args)
    {
        if (Editable) args.Attributes["class"] = "ames-row-link";
    }

    // ── 적용 / 발행 ───────────────────────────────────────────────────────
    void Apply()
    {
        _err = "";
        if (_date.Date < ServerNow.Date) { _err = L["PP.LineSchedule.Err.PastDate"]; return; }
        if (string.IsNullOrEmpty(_patternId)) { _err = L["PP.LineSchedule.Err.NoPattern"]; return; }
        try
        {
            LSB.SaveSchedule(_lineId, _date, _patternId,
                _slots.Select(s => (s.WoId, s.StartMin, s.EndMin, s.Qty)),
                _pmBands.Select(p => (p.StartMin, p.EndMin, p.Title, p.RefType, p.RefId)), _actor);
            ShowMsg(L["PP.LineSchedule.Ok.Applied"].Value);
            LoadData();
        }
        catch (Exception ex) { _err = ex.Message; }
    }

    void Publish()
    {
        _err = "";
        if (_date.Date < ServerNow.Date) { _err = L["PP.LineSchedule.Err.PastDate"]; return; }
        if (string.IsNullOrEmpty(_patternId)) { _err = L["PP.LineSchedule.Err.NoPattern"]; return; }
        if (ConflictIds.Count > 0) { _err = string.Format(L["PP.LineSchedule.Err.ConflictSummary"].Value, ConflictIds.Count); return; }
        try
        {
            LSB.SaveSchedule(_lineId, _date, _patternId,
                _slots.Select(s => (s.WoId, s.StartMin, s.EndMin, s.Qty)),
                _pmBands.Select(p => (p.StartMin, p.EndMin, p.Title, p.RefType, p.RefId)), _actor);
            LSB.PublishSchedule(_lineId, _date, _actor);
            ShowMsg(L["PP.LineSchedule.Ok.Published"].Value);
            LoadData();
        }
        catch (Exception ex) { _err = ex.Message; }
    }

    // ── Helpers ──────────────────────────────────────────────────────────
    static string MinToTime(int m) => $"{m / 60:00}:{m % 60:00}";

    // 배치 라벨 — 등록(_slots) 순서대로 A1~A9, B1~B9, … Z1~Z9
    string SlotLabel(StagedWo s)
    {
        int i = _slots.FindIndex(x => x.WoId == s.WoId);
        if (i < 0) return "";
        return i / 9 < 26 ? $"{(char)('A' + i / 9)}{i % 9 + 1}" : $"#{i + 1}";
    }

    // PM 반영된 유효 가동밴드 기준 — WO 는 PM 으로 잘린 가동 구간 안에만 배치 가능
    bool InsideOperating(int startMin, int endMin) =>
        EffectiveBands.Any(b => b.State == "OPERATING" && b.StartMin <= startMin && b.EndMin >= endMin);

    // 축(하루 시작 기준) 상대 위치 — 야간 교대 래핑 반영, 정렬용
    int AxisPos(int m) { int r = m - _dayStart; if (r < 0) r += 1440; return r; }

    // PM 삭제 등으로 가동시간이 복원되면 WO들을 (등록/시각 순서 유지) 가동 시작부터 연속 재배치.
    // 유효 가동구간을 순서대로 채우며, 현재 구간에 안 들어가면 다음 가동구간으로 넘어감.
    void ReflowWos()
    {
        var ops = EffectiveBands.Where(b => b.State == "OPERATING")
                                .OrderBy(b => AxisPos(b.StartMin)).ToList();
        if (ops.Count == 0 || _slots.Count == 0) return;
        var ordered = _slots.OrderBy(s => AxisPos(s.StartMin)).ToList();
        var result  = new List<StagedWo>();
        int oi = 0, cursor = ops[0].StartMin;
        foreach (var w in ordered)
        {
            int dur = w.EndMin - w.StartMin;
            while (oi < ops.Count && cursor + dur > ops[oi].EndMin)
            {
                oi++;
                if (oi < ops.Count) cursor = ops[oi].StartMin;
            }
            if (oi >= ops.Count) { result.Add(w); continue; }   // 남은 가동구간 없음 → 원위치(충돌 표시)
            result.Add(w with { StartMin = cursor, EndMin = cursor + dur });
            cursor += dur;
        }
        _slots = result;
    }

    // Rp/LineTimePattern.razor 와 동일 색상 팔레트(코드별)
    // 테마 반응형: CSS 변수 참조(app.css --seg-*). 라이트/다크에서 값이 재정의됨.
    string SegColor(string state) => state switch
    {
        "OPERATING"        => "var(--seg-operating)",
        "PLANNED_DOWNTIME" => "var(--seg-downtime)",
        "BREAK"            => "var(--seg-break)",
        "INSPECT"          => "var(--seg-inspect)",
        "PM"               => "var(--seg-pm)",   // 예방보전 — 주황
        "IDLE"             => "var(--seg-idle)",
        _                  => "var(--seg-meal)"
    };

    // 예방보전 표시명 — 공통코드 SEGMENT_STATE 'PM' 의 다국어 명칭(없으면 리소스 폴백)
    string PmName =>
        _segStates.FirstOrDefault(c => c.CodeValue == "PM") is { } c
            ? MasterDataRepository.LocalName(c)
            : L["PP.LineSchedule.Lgd.Pm"].Value;

    // 밴드 배경/테두리(반투명) — color-mix 로 토큰 색에 알파 적용(테마 반응형)
    string SegBandStyle(string state)
    {
        var c  = SegColor(state);
        var bs = state == "IDLE" ? "dashed" : "solid";
        return $"background:color-mix(in srgb, {c} 13%, transparent);border:1px {bs} color-mix(in srgb, {c} 53%, transparent);color:{c};";
    }

    string SegLabel(string state)
        => _segStates.FirstOrDefault(c => c.CodeValue == state) is { } c ? MasterDataRepository.LocalName(c) : state;

    // PP_LineSchedule 상태 라벨 — 공통코드 SCHEDULE_STATUS(DRAFT/PUBLISHED)의 다국어 명칭
    string SchedStatusText(string? code) =>
        _schedStatuses.FirstOrDefault(c => c.CodeValue == code) is { } c
            ? MasterDataRepository.LocalName(c)
            : (code ?? "");

    RenderFragment StatusPill() => __b =>
    {
        string cls, txt;
        if (_dirty)                             { cls = "warn"; txt = L["PP.LineSchedule.Status.Unsaved"].Value; }
        else if (_savedStatus == "PUBLISHED")   { cls = "ok";   txt = SchedStatusText("PUBLISHED"); }
        else if (_savedStatus == "DRAFT")       { cls = "info"; txt = SchedStatusText("DRAFT"); }
        else                                    { cls = "dim";  txt = L["PP.LineSchedule.Status.Unsaved"].Value; }
        __b.OpenElement(0, "span"); __b.AddAttribute(1, "class", $"pill {cls}"); __b.AddContent(2, txt); __b.CloseElement();
    };

    void ShowMsg(string msg)
    {
        _msg = msg;
        _ = Task.Delay(3500).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
