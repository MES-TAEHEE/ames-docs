@page "/md/re/vendor"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-009 @L["MD.Vendor.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-009" TitleKey="MD.Vendor.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Vendor.Kpi.EDI"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.EdiFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Vendor.Kpi.OtdSet"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.OtdTargetRate.HasValue)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Vendor.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Vendor.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fType" Data="@VendorTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.VendorRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Vendor.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="VendorID" Title="@L["Col.VendorId"]" Width="110px">
                <Template Context="r"><span class="code">@r.VendorID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="VendorName" Title="@L["Col.VendorName"]">
                <Template Context="r">@(r.VendorName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="VendorType" Title="@L["Col.Type"]" Width="100px">
                <Template Context="r">
                    @{
                        var typeName = _vendorTypes.FirstOrDefault(v => v.CodeValue == r.VendorType) is { } lf ? MasterDataRepository.LocalName(lf) : r.VendorType;
                    }
                    <span class="pill">@(typeName ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="VendorCategory" Title="@L["Col.Category"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.VendorCategory ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="ContactPerson" Title="@L["Col.Contact"]" Width="100px">
                <Template Context="r">@(r.ContactPerson ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="EdiFlag" Title="@L["Col.EDI"]" Width="70px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.EdiFlag) { <span class="pill ok">EDI</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="OtdTargetRate" Title="@L["Col.OtdPct"]" Width="70px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.OtdTargetRate?.ToString("F1") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="PaymentTerms" Title="@L["Col.PayTerm"]" Width="80px">
                <Template Context="r"><span class="dim">@(r.PaymentTerms ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.VendorRow" Property="ActiveFlag" Title="@L["Col.Active"]" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Vendor.Title"] — @L["Modal.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.VendorName"]" />
                    <RadzenTextBox @bind-Value="_f.VendorName" Placeholder='@L["MD.Vendor.Ph.VendorName"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.VendorType"]" />
                    <RadzenDropDown @bind-Value="_f.VendorType" Data="@VendorTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.VendorCategory"]" />
                    <RadzenTextBox @bind-Value="_f.VendorCategory" Placeholder='@L["MD.Vendor.Ph.VendorCategory"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.BizRegNo"]" />
                    <RadzenTextBox @bind-Value="_f.BizRegNo" Placeholder="000-00-00000" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Contact"]" />
                    <RadzenTextBox @bind-Value="_f.ContactPerson" Placeholder='@L["MD.Vendor.Ph.ContactPerson"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Phone"]" />
                    <RadzenTextBox @bind-Value="_f.Phone" Placeholder="02-0000-0000" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.Email"]" />
                    <RadzenTextBox @bind-Value="_f.Email" Placeholder="vendor@abc.com" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.ScmURL"]" />
                    <RadzenTextBox @bind-Value="_f.ScmURL" Placeholder="https://scm.abc.com" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.OtdTarget"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.OtdTargetRate" Min="0m" Max="100m" Step="0.1m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.PaymentTerms"]" />
                    <RadzenTextBox @bind-Value="_f.PaymentTerms" Placeholder="NET30" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:flex;gap:16px;margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.EdiFlag" />
                    <span>@L["MD.Vendor.Lbl.EDI"]</span>
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Vendor.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.VendorID</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.VendorName"]" />
                    <RadzenTextBox @bind-Value="_f.VendorName" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.VendorType"]" />
                    <RadzenDropDown @bind-Value="_f.VendorType" Data="@VendorTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.VendorCategory"]" />
                    <RadzenTextBox @bind-Value="_f.VendorCategory" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.BizRegNo"]" />
                    <RadzenTextBox @bind-Value="_f.BizRegNo" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Contact"]" />
                    <RadzenTextBox @bind-Value="_f.ContactPerson" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Phone"]" />
                    <RadzenTextBox @bind-Value="_f.Phone" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.Email"]" />
                    <RadzenTextBox @bind-Value="_f.Email" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.ScmURL"]" />
                    <RadzenTextBox @bind-Value="_f.ScmURL" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.OtdTarget"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.OtdTargetRate" Min="0m" Max="100m" Step="0.1m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Vendor.Lbl.PaymentTerms"]" />
                    <RadzenTextBox @bind-Value="_f.PaymentTerms" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:flex;gap:16px;margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.EdiFlag" />
                    <span>@L["MD.Vendor.Lbl.EDI"]</span>
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.VendorRow>   _allRows     = new();
    List<MasterDataRepository.VendorRow>   _rows        = new();
    List<MasterDataRepository.CodeItemRow> _vendorTypes = new();
    MasterDataRepository.VendorRow? _sel;

    string _fSearch = "";
    string? _fType, _fActive;
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> VendorTypeOptions => _vendorTypes.Where(t => t.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    private IEnumerable<DropDownItem> ActiveFilterOptions => new[]
    {
        new DropDownItem { Value = "Y", Text = L["Lbl.Active"].Value },
        new DropDownItem { Value = "N", Text = L["Lbl.Inactive"].Value },
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/re/vendor");
        try { _vendorTypes = MD.ListCodeItems("VENDOR_TYPE"); } catch { }
        Reload();
    }

    void Reload() { _allRows = MD.ListVendors(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.VendorName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fType)   || r.VendorType == _fType) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.VendorRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.VendorRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.VendorRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            VendorName     = r.VendorName     ?? "",
            VendorType     = r.VendorType     ?? "",
            VendorCategory = r.VendorCategory ?? "",
            BizRegNo       = r.BizRegNo       ?? "",
            ContactPerson  = r.ContactPerson  ?? "",
            Phone          = r.Phone          ?? "",
            Email          = r.Email          ?? "",
            ScmURL         = r.ScmURL         ?? "",
            EdiFlag        = r.EdiFlag,
            OtdTargetRate  = r.OtdTargetRate,
            PaymentTerms   = r.PaymentTerms   ?? "",
            ActiveFlag     = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.VendorName)) { _modalErr = L["MD.Vendor.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var newId = "V" + Guid.NewGuid().ToString("N")[..14].ToUpper();
            MD.InsertVendor(newId, _f.VendorName, NE(_f.VendorType), NE(_f.VendorCategory),
                NE(_f.BizRegNo), NE(_f.ContactPerson), NE(_f.Phone), NE(_f.Email),
                NE(_f.ScmURL), _f.EdiFlag, _f.OtdTargetRate,
                NE(_f.PaymentTerms), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Vendor.Ok.Created"].Value, _f.VendorName), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.VendorName)) { _modalErr = L["MD.Vendor.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateVendor(_sel.VendorID, _f.VendorName, NE(_f.VendorType), NE(_f.VendorCategory),
                NE(_f.BizRegNo), NE(_f.ContactPerson), NE(_f.Phone), NE(_f.Email),
                NE(_f.ScmURL), _f.EdiFlag, _f.OtdTargetRate,
                NE(_f.PaymentTerms), _f.ActiveFlag, _actor);
            var name = _f.VendorName;
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Vendor.Ok.Updated"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.VendorName ?? _sel.VendorID;
            MD.DeleteVendor(_sel.VendorID);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Vendor.Ok.Deleted"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string   VendorName     { get; set; } = "";
        public string   VendorType     { get; set; } = "";
        public string   VendorCategory { get; set; } = "";
        public string   BizRegNo       { get; set; } = "";
        public string   ContactPerson  { get; set; } = "";
        public string   Phone          { get; set; } = "";
        public string   Email          { get; set; } = "";
        public string   ScmURL         { get; set; } = "";
        public bool     EdiFlag        { get; set; } = false;
        public decimal? OtdTargetRate  { get; set; }
        public string   PaymentTerms   { get; set; } = "";
        public bool     ActiveFlag     { get; set; } = true;
    }
}