@page "/md/re/jig"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Jig.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-016</div>
    <div class="ames-page-t">@L["MD.Jig.Title"]</div>
    <div class="ames-page-sub">@L["MD.Jig.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.NeedMaint"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RatedCycle.HasValue && r.CycleCount.HasValue && r.CycleCount >= r.RatedCycle)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.AvgUsage"]</div>
        @{
            var validPct = _allRows
                .Where(r => r.RatedCycle is > 0 && r.CycleCount.HasValue)
                .Select(r => (double)r.CycleCount!.Value / r.RatedCycle!.Value * 100)
                .ToList();
        }
        <div class="ames-kpi-v">@(validPct.Count > 0 ? $"{validPct.Average():F0}%" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Jig.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:160px;padding:4px 8px;"
                   placeholder='@L["MD.Jig.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Health"]</span>
            <select class="ames-input" style="width:120px;" @bind="_fHealth">
                <option value="">@L["Filter.AllConditions"]</option>
                @foreach (var h in _allRows.Select(r => r.HealthStatus).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@h">@h</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Active"]</span>
            <select class="ames-input" style="width:100px;" @bind="_fActive">
                <option value="">@L["Filter.All"]</option>
                <option value="Y">@L["Lbl.Active"]</option>
                <option value="N">@L["Lbl.Inactive"]</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Jig.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.JigId"]</th><th>@L["Col.Name"]</th>
                    <th style="text-align:right;">@L["Col.HangerCount"]</th>
                    <th style="text-align:right;">@L["Col.RatedCycle"]</th>
                    <th style="text-align:right;">@L["Col.ShotsCurrent"]</th>
                    <th style="text-align:center;">@L["Col.UsagePct"]</th>
                    <th style="text-align:right;">@L["Col.ReadFailRate"]</th>
                    <th>@L["Col.Health"]</th>
                    <th>@L["Col.LastMaint"]</th>
                    <th>@L["Col.Active"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    var pct = r.RatedCycle is > 0 && r.CycleCount.HasValue
                        ? (double)r.CycleCount.Value / r.RatedCycle.Value * 100
                        : (double?)null;
                    var pctCss = pct is null ? "" : pct >= 100 ? "bad" : pct >= 80 ? "warn" : "ok";

                    var hCss = r.HealthStatus switch { "OK" => "ok", "WARN" => "warn", "FAIL" => "bad", _ => "" };

                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.JigID</td>
                        <td>@(r.JigName ?? "—")</td>
                        <td style="text-align:right;">@(r.HangerCount?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(r.RatedCycle?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(r.CycleCount?.ToString("N0") ?? "—")</td>
                        <td style="text-align:center;">
                            @if (pct.HasValue)
                            { <span class="pill @pctCss">@pct.Value.ToString("F0")%</span> }
                            else { <span class="dim">—</span> }
                        </td>
                        <td style="text-align:right;">@(r.ReadFailRate?.ToString("F2") ?? "—")</td>
                        <td>
                            @if (r.HealthStatus is not null)
                            { <span class="pill @hCss">@r.HealthStatus</span> }
                            else { <span class="dim">—</span> }
                        </td>
                        <td class="dim">@(r.LastServiceDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>
                            @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                            else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Jig.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.JigId"] * <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: JIG-PNT-001)</span></label>
            <input class="ames-input" @bind="_f.JigID" placeholder="JIG-PNT-001" autocomplete="off" />

            <label>@L["Col.JigName"] *</label>
            <input class="ames-input" @bind="_f.JigName" placeholder='@L["MD.Jig.Ph.JigName"]' autocomplete="off" />

            <label>@L["Col.HangerCount"]</label>
            <input class="ames-input" type="number" @bind="_f.HangerCount" placeholder="20" min="0" autocomplete="off" />

            <label>@L["Col.RatedCycle"]</label>
            <input class="ames-input" type="number" @bind="_f.RatedCycle" placeholder="10000" min="0" autocomplete="off" />

            <label>@L["Col.CycleCount"]</label>
            <input class="ames-input" type="number" @bind="_f.CycleCount" placeholder="0" min="0" autocomplete="off" />

            <label>@L["Col.ReadFailRate"]</label>
            <input class="ames-input" type="number" step="0.01" @bind="_f.ReadFailRate" placeholder="0.00" min="0" max="100" autocomplete="off" />

            <label>@L["Col.Health"]</label>
            <select class="ames-input" @bind="_f.HealthStatus">
                <option value="">@L["Opt.None"]</option>
                <option value="OK">OK</option>
                <option value="WARN">WARN</option>
                <option value="FAIL">FAIL</option>
            </select>

            <label>@L["Col.LastService"]</label>
            <input class="ames-input" type="date" @bind="_f.LastServiceDate" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Jig.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.JigID</span></div>

            <label>@L["Col.JigName"] *</label>
            <input class="ames-input" @bind="_f.JigName" autocomplete="off" />

            <label>@L["Col.HangerCount"]</label>
            <input class="ames-input" type="number" @bind="_f.HangerCount" min="0" autocomplete="off" />

            <label>@L["Col.RatedCycle"]</label>
            <input class="ames-input" type="number" @bind="_f.RatedCycle" min="0" autocomplete="off" />

            <label>@L["Col.CycleCount"]</label>
            <input class="ames-input" type="number" @bind="_f.CycleCount" min="0" autocomplete="off" />

            <label>@L["Col.ReadFailRate"]</label>
            <input class="ames-input" type="number" step="0.01" @bind="_f.ReadFailRate" min="0" max="100" autocomplete="off" />

            <label>@L["Col.Health"]</label>
            <select class="ames-input" @bind="_f.HealthStatus">
                <option value="">@L["Opt.None"]</option>
                <option value="OK">OK</option>
                <option value="WARN">WARN</option>
                <option value="FAIL">FAIL</option>
            </select>

            <label>@L["Col.LastService"]</label>
            <input class="ames-input" type="date" @bind="_f.LastServiceDate" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Edit"])</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.JigRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.JigRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.JigRow? _sel;

    int _page = 0;
    const int _pageSize = 20;

    string _fSearch = "", _fHealth = "", _fActive = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/re/jig");
        Reload();
    }

    void Reload() { _allRows = Md.ListJigs(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.JigID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.JigName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fHealth) || r.HealthStatus == _fHealth) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    void OpenCreate() { _f = new() { ActiveFlag = true }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.JigRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            JigID           = r.JigID,
            JigName         = r.JigName        ?? "",
            HangerCount     = r.HangerCount,
            RatedCycle      = r.RatedCycle,
            CycleCount      = r.CycleCount,
            ReadFailRate    = r.ReadFailRate,
            HealthStatus    = r.HealthStatus   ?? "",
            LastServiceDate = r.LastServiceDate,
            ActiveFlag      = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.JigID))   { _modalErr = L["Err.JigIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.JigName))  { _modalErr = L["Err.NameRequired"]; return; }
        if (Md.JigExists(_f.JigID.Trim()))           { _modalErr = $"지그 ID '{_f.JigID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertJig(_f.JigID.Trim(), _f.JigName, _f.HangerCount,
                _f.RatedCycle, _f.CycleCount, _f.ReadFailRate,
                NE(_f.HealthStatus), _f.LastServiceDate, _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.JigName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.JigName)) { _modalErr = L["Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateJig(_sel.JigID, _f.JigName, _f.HangerCount,
                _f.RatedCycle, _f.CycleCount, _f.ReadFailRate,
                NE(_f.HealthStatus), _f.LastServiceDate, _f.ActiveFlag, _actor);
            var name = _f.JigName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.JigName ?? _sel.JigID;
            Md.DeleteJig(_sel.JigID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   JigID           { get; set; } = "";
        public string   JigName         { get; set; } = "";
        public int?     HangerCount     { get; set; }
        public int?     RatedCycle      { get; set; }
        public int?     CycleCount      { get; set; }
        public decimal? ReadFailRate    { get; set; }
        public string   HealthStatus    { get; set; } = "";
        public DateOnly? LastServiceDate { get; set; }
        public bool     ActiveFlag      { get; set; } = true;
    }
}
