@page "/md/re/jig"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-016 @L["MD.Jig.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-016" TitleKey="MD.Jig.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.NeedMaint"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RatedCycle.HasValue && r.CycleCount.HasValue && r.CycleCount >= r.RatedCycle)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.AvgUsage"]</div>
        @{
            var validPct = _allRows
                .Where(r => r.RatedCycle is > 0 && r.CycleCount.HasValue)
                .Select(r => (double)r.CycleCount!.Value / r.RatedCycle!.Value * 100)
                .ToList();
        }
        <div class="ames-kpi-v">@(validPct.Count > 0 ? $"{validPct.Average():F0}%" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Jig.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Jig.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" />
            <RadzenLabel Text="@L["Col.Health"]" Component="DropDownHealth" />
            <RadzenDropDown Name="DropDownHealth" @bind-Value="_fHealth" Data="@HealthFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenLabel Text="@L["Col.Active"]" Component="DropDownActive" />
            <RadzenDropDown Name="DropDownActive" @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.JigRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Jig.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="JigID" Title="@L["Col.JigId"]" Width="110px">
                <Template Context="r"><span class="code">@r.JigID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="JigName" Title="@L["Col.Name"]">
                <Template Context="r">@(r.JigName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="HangerCount" Title="@L["Col.HangerCount"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.HangerCount?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="RatedCycle" Title="@L["Col.RatedCycle"]" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.RatedCycle?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="CycleCount" Title="@L["Col.ShotsCurrent"]" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.CycleCount?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Title="@L["Col.UsagePct"]" Width="80px" TextAlign="TextAlign.Center" Sortable="false">
                <Template Context="r">
                    @{
                        var pct    = r.RatedCycle is > 0 && r.CycleCount.HasValue ? (double)r.CycleCount.Value / r.RatedCycle.Value * 100 : (double?)null;
                        var pctCss = pct is null ? "" : pct >= 100 ? "bad" : pct >= 80 ? "warn" : "ok";
                    }
                    @if (pct.HasValue) { <span class="pill @pctCss">@pct.Value.ToString("F0")%</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="ReadFailRate" Title="@L["Col.ReadFailRate"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.ReadFailRate?.ToString("F2") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="HealthStatus" Title="@L["Col.Health"]" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @{
                        var hCss = r.HealthStatus switch { "OK" => "ok", "WARN" => "warn", "FAIL" => "bad", _ => "" };
                    }
                    @if (r.HealthStatus is not null) { <span class="pill @hCss">@r.HealthStatus</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="LastServiceDate" Title="@L["Col.LastMaint"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.LastServiceDate?.ToString("yyyy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.JigRow" Property="ActiveFlag" Title="@L["Col.Active"]" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Jig.Title"] — @L["Btn.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.JigId"]" />
                    <RadzenTextBox @bind-Value="_f.JigID" Placeholder="JIG-PNT-001" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.JigName"]" />
                    <RadzenTextBox @bind-Value="_f.JigName" Placeholder='@L["MD.Jig.Ph.JigName"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.HangerCount"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.HangerCount" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.RatedCycle"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.RatedCycle" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.CycleCount"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CycleCount" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ReadFailRate"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ReadFailRate" Min="0m" Max="100m" Step="0.01m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Health"]" />
                    <RadzenDropDown @bind-Value="_f.HealthStatus" Data="@HealthStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.None"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.LastService"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.LastServiceDate" DateFormat="yyyy-MM-dd" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Jig.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.JigID</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.JigName"]" />
                    <RadzenTextBox @bind-Value="_f.JigName" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.HangerCount"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.HangerCount" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.RatedCycle"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.RatedCycle" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.CycleCount"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CycleCount" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.ReadFailRate"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ReadFailRate" Min="0m" Max="100m" Step="0.01m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Health"]" />
                    <RadzenDropDown @bind-Value="_f.HealthStatus" Data="@HealthStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.None"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.LastService"]" />
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.LastServiceDate" DateFormat="yyyy-MM-dd" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.JigRow> _allRows = new();
    List<MasterDataRepository.JigRow> _rows    = new();
    MasterDataRepository.JigRow? _sel;

    string _fSearch = "";
    string? _fHealth, _fActive;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> HealthFilterOptions => _allRows.Select(r => r.HealthStatus).Where(x => x != null).Distinct().OrderBy(x => x).Select(h => new DropDownItem { Value = h!, Text = h! });
    DropDownItem[] HealthStatusOptions =
    {
        new() { Value = "OK",   Text = "OK"   },
        new() { Value = "WARN", Text = "WARN" },
        new() { Value = "FAIL", Text = "FAIL" },
    };
    DropDownItem[] ActiveFilterOptions =
    {
        new() { Value = "Y", Text = "Active"   },
        new() { Value = "N", Text = "Inactive" },
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/re/jig");
        Reload();
    }

    void Reload() { _allRows = MD.ListJigs(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.JigID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.JigName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fHealth) || r.HealthStatus == _fHealth) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.JigRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.JigRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new() { ActiveFlag = true }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.JigRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            JigID           = r.JigID,
            JigName         = r.JigName        ?? "",
            HangerCount     = r.HangerCount,
            RatedCycle      = r.RatedCycle,
            CycleCount      = r.CycleCount,
            ReadFailRate    = r.ReadFailRate,
            HealthStatus    = r.HealthStatus   ?? "",
            LastServiceDate = r.LastServiceDate,
            ActiveFlag      = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.JigID))  { _modalErr = L["Err.JigIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.JigName)) { _modalErr = L["Err.NameRequired"]; return; }
        if (MD.JigExists(_f.JigID.Trim())) { _modalErr = $"지그 ID '{_f.JigID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            MD.InsertJig(_f.JigID.Trim(), _f.JigName, _f.HangerCount,
                _f.RatedCycle, _f.CycleCount, _f.ReadFailRate,
                NE(_f.HealthStatus), _f.LastServiceDate, _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.JigName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.JigName)) { _modalErr = L["Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateJig(_sel.JigID, _f.JigName, _f.HangerCount,
                _f.RatedCycle, _f.CycleCount, _f.ReadFailRate,
                NE(_f.HealthStatus), _f.LastServiceDate, _f.ActiveFlag, _actor);
            var name = _f.JigName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.JigName ?? _sel.JigID;
            MD.DeleteJig(_sel.JigID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string    JigID           { get; set; } = "";
        public string    JigName         { get; set; } = "";
        public int?      HangerCount     { get; set; }
        public int?      RatedCycle      { get; set; }
        public int?      CycleCount      { get; set; }
        public decimal?  ReadFailRate    { get; set; }
        public string    HealthStatus    { get; set; } = "";
        public DateOnly? LastServiceDate { get; set; }
        public bool      ActiveFlag      { get; set; } = true;
    }
}