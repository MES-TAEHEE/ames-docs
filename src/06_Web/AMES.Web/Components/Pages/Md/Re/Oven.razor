@page "/md/re/oven"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>@L["MD.Oven.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.LineCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Oven.Kpi.AvgTargetTemp"]</div>
        <div class="ames-kpi-v">@(_allRows.Where(r => r.TargetTemp.HasValue).Select(r => r.TargetTemp!.Value) is { } temps && temps.Any() ? $"{temps.Average():F0}°C" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Oven.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.Oven.Ph.Search"]'
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' />
            <RadzenLabel Text="@L["Col.Line"]" />
            <RadzenDropDown @bind-Value="_fLine" Data="@LineFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllLines"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Status"]" />
            <RadzenDropDown @bind-Value="_fStatus" Data="@OvenStatusOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllStatus"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="25"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    RowRender="@OvenRowRender"
                    RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data); })"
                    EmptyText="@L["MD.Oven.Empty"]"
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="OvenID" Title="@L["Col.OvenId"]" Width="110px">
                <Template Context="r"><span class="code">@r.OvenID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="OvenName" Title="@L["Col.Name"]">
                <Template Context="r">@(r.OvenName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="LineID" Title="@L["Col.Line"]" Width="80px">
                <Template Context="r"><span class="dim">@(r.LineID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="ZoneCount" Title="@L["Col.ZoneCount"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.ZoneCount?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="TargetTemp" Title="@L["Col.TargetTemp"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.TargetTemp?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="Tolerance" Title="@L["Col.TempTolerance"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.Tolerance.HasValue ? $"±{r.Tolerance}" : "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="DwellSec" Title="@L["Col.DwellTime"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.DwellSec?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="ConveyorSpeed" Title="@L["Col.ConveyorSpeed"]" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.ConveyorSpeed?.ToString("F2") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="MaxLoadKg" Title="@L["Col.MaxLoad"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.MaxLoadKg?.ToString("F1") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.OvenRow" Property="Status" Title="@L["Col.Status"]" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @{
                        var scls   = r.Status == "ACTIVE" ? "ok" : "bad";
                        var sLabel = _ovenStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status;
                    }
                    <span class="pill @scls">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Oven.Title"] — @L["Btn.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.OvenId"]" />
                    <RadzenTextBox @bind-Value="_f.OvenID" Placeholder="OV-PNT-001" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Name"]" />
                    <RadzenTextBox @bind-Value="_f.OvenName" Placeholder='@L["MD.Oven.Ph.OvenName"]' AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.LineId"]" />
                    <RadzenDropDown @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Oven.ZoneCount"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ZoneCount" Min="1"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.TargetTemp"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.TargetTemp" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.TempTolerance"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.Tolerance" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.DwellTime"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DwellSec" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ConveyorSpeed"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ConveyorSpeed" Min="0m" Step="0.01m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.MaxLoadKg"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.MaxLoadKg" Min="0m" Step="0.1m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@OvenStatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Oven.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.OvenID</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.Name"]" />
                    <RadzenTextBox @bind-Value="_f.OvenName" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.LineId"]" />
                    <RadzenDropDown @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Oven.ZoneCount"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ZoneCount" Min="1"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.TargetTemp"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.TargetTemp" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.TempTolerance"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.Tolerance" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.DwellTime"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DwellSec" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.ConveyorSpeed"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ConveyorSpeed" Min="0m" Step="0.01m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.MaxLoadKg"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.MaxLoadKg" Min="0m" Step="0.1m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.Status"]" />
                <RadzenDropDown @bind-Value="_f.Status" Data="@OvenStatusOptions" TextProperty="Text" ValueProperty="Value"
                                Placeholder="@L["Opt.Select"]"
                                InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.OvenRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.OvenRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.OvenRow? _sel;

    List<AMES.Data.Repositories.MasterDataRepository.LineRow>     _lineList   = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _ovenStatus = new();

    string _fSearch = "";
    string? _fLine, _fStatus;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/re/oven");
        try { _lineList   = Md.ListLines();                   } catch { }
        try { _ovenStatus = Md.ListCodeItems("OVEN_STATUS");  } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListOvens(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.OvenID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.OvenName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineID == _fLine) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status == _fStatus)
    ).ToList(); }

    IEnumerable<DropDownItem> LineFilterOptions =>
        _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = l.LineID + (l.LineName != null ? $" {l.LineName}" : "") });

    IEnumerable<DropDownItem> LineOptions =>
        _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = $"[{l.LineID}]" + (l.LineName != null ? $" {l.LineName}" : "") });

    IEnumerable<DropDownItem> OvenStatusOptions =>
        _ovenStatus.Where(s => s.UseFlag)
            .Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });

    void OvenRowRender(RowRenderEventArgs<AMES.Data.Repositories.MasterDataRepository.OvenRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.OvenRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            OvenID        = r.OvenID,
            OvenName      = r.OvenName ?? "",
            LineID        = r.LineID   ?? "",
            ZoneCount     = r.ZoneCount,
            TargetTemp    = r.TargetTemp,
            Tolerance     = r.Tolerance,
            DwellSec      = r.DwellSec,
            ConveyorSpeed = r.ConveyorSpeed,
            MaxLoadKg     = r.MaxLoadKg,
            Status        = r.Status   ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.OvenID))  { _modalErr = L["Err.OvenIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.OvenName)) { _modalErr = L["Err.NameRequired"]; return; }
        if (Md.OvenExists(_f.OvenID.Trim()))         { _modalErr = $"건조로 ID '{_f.OvenID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertOven(_f.OvenID.Trim(), _f.OvenName, NE(_f.LineID),
                _f.ZoneCount, _f.TargetTemp, _f.Tolerance, _f.DwellSec,
                _f.ConveyorSpeed, _f.MaxLoadKg, NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.OvenName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.OvenName)) { _modalErr = L["Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateOven(_sel.OvenID, _f.OvenName, NE(_f.LineID),
                _f.ZoneCount, _f.TargetTemp, _f.Tolerance, _f.DwellSec,
                _f.ConveyorSpeed, _f.MaxLoadKg, NE(_f.Status), _actor);
            var name = _f.OvenName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.OvenName ?? _sel.OvenID;
            Md.DeleteOven(_sel.OvenID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    class FormModel
    {
        public string   OvenID        { get; set; } = "";
        public string   OvenName      { get; set; } = "";
        public string   LineID        { get; set; } = "";
        public int?     ZoneCount     { get; set; }
        public int?     TargetTemp    { get; set; }
        public int?     Tolerance     { get; set; }
        public int?     DwellSec      { get; set; }
        public decimal? ConveyorSpeed { get; set; }
        public decimal? MaxLoadKg     { get; set; }
        public string   Status        { get; set; } = "Active";
    }
}