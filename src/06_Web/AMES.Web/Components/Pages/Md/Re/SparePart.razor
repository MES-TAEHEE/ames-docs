@page "/md/re/spare-part"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider Auth
@inject PermissionService Perm
@inject MasterDataRepository Md
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-026 @L["MD.SparePart.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-026" TitleKey="MD.SparePart.Title" />


@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.CategoryCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.Category).Where(c => c != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.SupplierCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.SupplierID).Where(s => s != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.SparePart.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.SparePart.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenLabel Text="@L["Col.Category"]" Component="DropDownCategory" />
            <RadzenDropDown Name="DropDownCategory" @bind-Value="_fCat" Data="@CategoryFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:90px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.SparePartMasterRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.SparePart.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="PartNo" Title="@L["Col.PartNo"]" Width="100px">
                <Template Context="r"><span class="code">@r.PartNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="PartName" Title="@L["Col.Name"]">
                <Template Context="r">@(r.PartName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="Category" Title="@L["Col.Category"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.Category ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="UOM" Title="@L["Col.Uom"]" Width="60px">
                <Template Context="r"><span class="dim">@(r.UOM ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="UnitCost" Title="@L["Col.UnitPrice"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.UnitCost?.ToString("N2") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="SafetyStock" Title="@L["Col.Safety"]" Width="70px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.SafetyStock?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="ReorderPoint" Title="@L["Col.Reorder"]" Width="70px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.ReorderPoint?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="ReorderQty" Title="@L["Col.ReorderQty"]" Width="70px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.ReorderQty?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="LeadTimeDays" Title="@L["Col.LeadDays"]" Width="70px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.LeadTimeDays?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="SupplierID" Title="@L["Col.Supplier"]" Width="90px">
                <Template Context="r"><span class="dim">@(r.SupplierID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="StorageLoc" Title="@L["Col.StorageLoc"]" Width="90px">
                <Template Context="r"><span class="dim">@(r.StorageLoc ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.SparePartMasterRow" Property="ActiveFlag" Title="@L["Col.Status"]" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.SparePart.Title"] — @L["Modal.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.PartNo"]" />
                    <RadzenTextBox @bind-Value="_f.PartNo" Placeholder="SP-001" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Name"]" />
                    <RadzenTextBox @bind-Value="_f.PartName" Placeholder='@L["MD.SparePart.Ph.PartName"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Category"]" />
                    <RadzenTextBox @bind-Value="_f.Category" Placeholder="CONSUMABLE / MECHANICAL" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Uom"]" />
                    <RadzenTextBox @bind-Value="_f.UOM" Placeholder="EA" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.UnitPrice"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.UnitCost" Min="0m" Step="0.01m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Safety"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.SafetyStock" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Reorder"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ReorderPoint" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ReorderQty"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ReorderQty" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.LeadDays"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.LeadTimeDays" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Supplier"]" />
                    <RadzenTextBox @bind-Value="_f.SupplierID" Placeholder="V001" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.StorageLoc"]" />
                <RadzenTextBox @bind-Value="_f.StorageLoc" Placeholder="A-01-01" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.SparePart.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.PartNo</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.Name"]" />
                    <RadzenTextBox @bind-Value="_f.PartName" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Category"]" />
                    <RadzenTextBox @bind-Value="_f.Category" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Uom"]" />
                    <RadzenTextBox @bind-Value="_f.UOM" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.UnitPrice"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.UnitCost" Min="0m" Step="0.01m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Safety"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.SafetyStock" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Reorder"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ReorderPoint" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.ReorderQty"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ReorderQty" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.LeadDays"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.LeadTimeDays" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.Supplier"]" />
                <RadzenTextBox @bind-Value="_f.SupplierID" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.StorageLoc"]" />
                <RadzenTextBox @bind-Value="_f.StorageLoc" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.SparePartMasterRow> _allRows = new();
    List<MasterDataRepository.SparePartMasterRow> _rows    = new();
    MasterDataRepository.SparePartMasterRow? _sel;

    string _fSearch = "";
    string? _fCat, _fActive;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> CategoryFilterOptions => _allRows.Select(r => r.Category).Where(x => x != null).Distinct().OrderBy(x => x).Select(c => new DropDownItem { Value = c!, Text = c! });
    DropDownItem[] ActiveFilterOptions =
    {
        new() { Value = "Y", Text = "Active"   },
        new() { Value = "N", Text = "Inactive" },
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/re/spare-part");
        Reload();
    }

    void Reload()
    {
        try { _allRows = Md.ListSparePartMasters(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.PartNo.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.PartName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fCat))
            _rows = _rows.Where(r => r.Category == _fCat).ToList();
        if (_fActive == "Y") _rows = _rows.Where(r => r.ActiveFlag).ToList();
        if (_fActive == "N") _rows = _rows.Where(r => !r.ActiveFlag).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.SparePartMasterRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.SparePartMasterRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.SparePartMasterRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            PartName     = r.PartName     ?? "",
            Category     = r.Category     ?? "",
            UOM          = r.UOM          ?? "",
            UnitCost     = r.UnitCost,
            SafetyStock  = r.SafetyStock,
            ReorderPoint = r.ReorderPoint,
            ReorderQty   = r.ReorderQty,
            LeadTimeDays = r.LeadTimeDays,
            SupplierID   = r.SupplierID   ?? "",
            StorageLoc   = r.StorageLoc   ?? "",
            ActiveFlag   = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.PartNo)) { _modalErr = L["Err.PartNoRequired"]; return; }
        var no = _f.PartNo.Trim();
        if (Md.SparePartExists(no)) { _modalErr = $"'{no}' 품번이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertSparePart(no, NE(_f.PartName), NE(_f.Category),
                _f.UnitCost, NE(_f.UOM),
                _f.SafetyStock, _f.ReorderPoint, _f.ReorderQty, _f.LeadTimeDays,
                NE(_f.SupplierID), NE(_f.StorageLoc), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{no} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            Md.UpdateSparePart(_sel.PartNo, NE(_f.PartName), NE(_f.Category),
                _f.UnitCost, NE(_f.UOM),
                _f.SafetyStock, _f.ReorderPoint, _f.ReorderQty, _f.LeadTimeDays,
                NE(_f.SupplierID), NE(_f.StorageLoc), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.PartNo} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var no = _sel.PartNo;
            Md.DeleteSparePart(_sel.PartNo);
            CloseModal(); Reload();
            ShowMsg($"{no} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string   PartNo       { get; set; } = "";
        public string   PartName     { get; set; } = "";
        public string   Category     { get; set; } = "";
        public string   UOM          { get; set; } = "";
        public decimal? UnitCost     { get; set; }
        public int?     SafetyStock  { get; set; }
        public int?     ReorderPoint { get; set; }
        public int?     ReorderQty   { get; set; }
        public int?     LeadTimeDays { get; set; }
        public string   SupplierID   { get; set; } = "";
        public string   StorageLoc   { get; set; } = "";
        public bool     ActiveFlag   { get; set; } = true;
    }
}