@page "/md/re/reason-code"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.ReasonCode.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-025" TitleKey="MD.ReasonCode.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.ReasonCode.Kpi.PlanReason"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.PlannedFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.ReasonCode.Kpi.ReasonTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ReasonType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.ReasonCode.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:140px;padding:4px 8px;"
                   placeholder='@L["MD.ReasonCode.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:110px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _allRows.Select(r => r.ReasonType).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@t">@t</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Module"]</span>
            <select class="ames-input" style="width:110px;" @bind="_fModule">
                <option value="">@L["Filter.AllModules"]</option>
                @foreach (var m in _allRows.Select(r => r.AppliesToModule).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@m">@m</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.ReasonCode.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th class="num">@L["Col.Seq"]</th><th>@L["Col.ReasonCode"]</th><th>@L["Col.ReasonName"]</th>
                    <th>@L["Col.ReasonType"]</th><th>@L["Col.Module"]</th>
                    <th>@L["Col.Planned"]</th><th>@L["Col.NoteRequired"]</th><th>@L["Col.Description"]</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="num dim">@(r.DisplayOrder?.ToString() ?? "—")</td>
                        <td class="code">@r.ReasonCode</td>
                        <td>@(r.ReasonName ?? "—")</td>
                        <td>@(r.ReasonType ?? "—")</td>
                        <td class="dim">@(r.AppliesToModule ?? "—")</td>
                        <td>@(r.PlannedFlag ? (MarkupString)$"<span class=\"pill ok\">{L["MD.ReasonCode.PillPlanned"]}</span>" : (MarkupString)"")</td>
                        <td>@(r.RequiresComment ? (MarkupString)$"<span class=\"pill warn\">{L["MD.ReasonCode.PillRequired"]}</span>" : (MarkupString)"")</td>
                        <td class="dim" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(r.Description ?? "—")</td>
                        <td><span class="pill @(r.Status == "ACTIVE" ? "ok" : "warn")">@(r.Status ?? "—")</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.ReasonCode.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.ReasonCode"]</label>
            <input class="ames-input" @bind="_f.ReasonCode" placeholder="DT-001" autocomplete="off" />

            <label>@L["Col.ReasonName"]</label>
            <input class="ames-input" @bind="_f.ReasonName" placeholder='@L["MD.ReasonCode.Ph.ReasonName"]' autocomplete="off" />

            <label>@L["Col.ReasonType"]</label>
            <input class="ames-input" @bind="_f.ReasonType" placeholder="DOWNTIME / DEFECT / SCRAP" autocomplete="off" />

            <label>@L["Col.Module"]</label>
            <input class="ames-input" @bind="_f.AppliesToModule" placeholder="INJ / PNT / QC" autocomplete="off" />

            <label>@L["Col.Seq"]</label>
            <input class="ames-input" type="number" @bind="_f.DisplayOrder" placeholder="10" min="0" autocomplete="off" />

            <label>@L["Col.Description"]</label>
            <input class="ames-input" @bind="_f.Description" placeholder='@L["MD.ReasonCode.Ph.Description"]' autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.RequiresComment" />
                <span>@L["Col.NoteRequired"]</span>
            </label>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.PlannedFlag" />
                <span>@L["Col.Planned"]</span>
            </label>

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="ACTIVE">ACTIVE</option>
                <option value="INACTIVE">INACTIVE</option>
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.ReasonCode.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.ReasonCode</span></div>

            <label>@L["Col.ReasonName"]</label>
            <input class="ames-input" @bind="_f.ReasonName" autocomplete="off" />

            <label>@L["Col.ReasonType"]</label>
            <input class="ames-input" @bind="_f.ReasonType" autocomplete="off" />

            <label>@L["Col.Module"]</label>
            <input class="ames-input" @bind="_f.AppliesToModule" autocomplete="off" />

            <label>@L["Col.Seq"]</label>
            <input class="ames-input" type="number" @bind="_f.DisplayOrder" min="0" autocomplete="off" />

            <label>@L["Col.Description"]</label>
            <input class="ames-input" @bind="_f.Description" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.RequiresComment" />
                <span>@L["Col.NoteRequired"]</span>
            </label>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.PlannedFlag" />
                <span>@L["Col.Planned"]</span>
            </label>

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="ACTIVE">ACTIVE</option>
                <option value="INACTIVE">INACTIVE</option>
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveEdit" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow? _sel;
    int _page = 0;
    const int _pageSize = 20;
    string _fSearch = "", _fType = "", _fModule = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/re/reason-code");
        Reload();
    }

    void Reload()
    {
        try { _allRows = Md.ListReasonCodes(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _page = 0;
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.ReasonCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.ReasonName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fType))
            _rows = _rows.Where(r => r.ReasonType == _fType).ToList();
        if (!string.IsNullOrWhiteSpace(_fModule))
            _rows = _rows.Where(r => r.AppliesToModule == _fModule).ToList();
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            ReasonName       = r.ReasonName       ?? "",
            ReasonType       = r.ReasonType       ?? "",
            AppliesToModule  = r.AppliesToModule  ?? "",
            RequiresComment  = r.RequiresComment,
            PlannedFlag      = r.PlannedFlag,
            DisplayOrder     = r.DisplayOrder,
            Description      = r.Description      ?? "",
            Status           = r.Status           ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ReasonCode)) { _modalErr = L["Err.ReasonCodeRequired"]; return; }
        var code = _f.ReasonCode.Trim();
        if (Md.ReasonCodeExists(code)) { _modalErr = $"'{code}' 코드가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertReasonCode(code, NE(_f.ReasonName), NE(_f.ReasonType),
                NE(_f.AppliesToModule), _f.RequiresComment, _f.PlannedFlag,
                _f.DisplayOrder, NE(_f.Description), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{code} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            Md.UpdateReasonCode(_sel.ReasonCode, NE(_f.ReasonName), NE(_f.ReasonType),
                NE(_f.AppliesToModule), _f.RequiresComment, _f.PlannedFlag,
                _f.DisplayOrder, NE(_f.Description), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.ReasonCode} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var code = _sel.ReasonCode;
            Md.DeleteReasonCode(_sel.ReasonCode);
            CloseModal(); Reload();
            ShowMsg($"{code} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string  ReasonCode      { get; set; } = "";
        public string  ReasonName      { get; set; } = "";
        public string  ReasonType      { get; set; } = "";
        public string  AppliesToModule { get; set; } = "";
        public bool    RequiresComment { get; set; } = false;
        public bool    PlannedFlag     { get; set; } = false;
        public int?    DisplayOrder    { get; set; }
        public string  Description     { get; set; } = "";
        public string  Status          { get; set; } = "ACTIVE";
    }
}
