@page "/md/re/reason-code"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>@L["MD.ReasonCode.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.ReasonCode.Kpi.PlanReason"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.PlannedFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.ReasonCode.Kpi.ReasonTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ReasonType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.ReasonCode.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.ReasonCode.Ph.Search"]'
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' />
            <RadzenLabel Text="@L["Col.Type"]" />
            <RadzenDropDown @bind-Value="_fType" Data="@TypeFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllTypes"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />
            <RadzenLabel Text="@L["Col.Module"]" />
            <RadzenDropDown @bind-Value="_fModule" Data="@ModuleFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllModules"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="25"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    RowRender="@ReasonRowRender"
                    RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data); })"
                    EmptyText="@L["MD.ReasonCode.Empty"]"
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="DisplayOrder" Title="@L["Col.Seq"]" Width="60px" TextAlign="TextAlign.Right">
                <Template Context="r"><span class="dim">@(r.DisplayOrder?.ToString() ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="ReasonCode" Title="@L["Col.ReasonCode"]" Width="100px">
                <Template Context="r"><span class="code">@r.ReasonCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="ReasonName" Title="@L["Col.ReasonName"]">
                <Template Context="r">@(r.ReasonName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="ReasonType" Title="@L["Col.ReasonType"]" Width="100px">
                <Template Context="r"><span class="pill">@(r.ReasonType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="AppliesToModule" Title="@L["Col.Module"]" Width="80px">
                <Template Context="r"><span class="dim">@(r.AppliesToModule ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="PlannedFlag" Title="@L["Col.Planned"]" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.PlannedFlag) { <span class="pill ok">@L["MD.ReasonCode.PillPlanned"]</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="RequiresComment" Title="@L["Col.NoteRequired"]" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.RequiresComment) { <span class="pill warn">@L["MD.ReasonCode.PillRequired"]</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="Description" Title="@L["Col.Description"]">
                <Template Context="r"><span class="dim" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block;">@(r.Description ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow" Property="Status" Title="@L["Col.Status"]" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="r"><span class="pill @(r.Status == "ACTIVE" ? "ok" : "warn")">@(r.Status ?? "—")</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.ReasonCode.Title"] — @L["Btn.Create"]</div>

            <div style="margin-bottom:6px;">
                <RadzenLabel Text="@L["Col.ReasonCode"]" />
                <RadzenTextBox @bind-Value="_f.ReasonCode" Placeholder="DT-001" AutoComplete="false"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.ReasonName"]" />
                    <RadzenTextBox @bind-Value="_f.ReasonName" Placeholder='@L["MD.ReasonCode.Ph.ReasonName"]' AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ReasonType"]" />
                    <RadzenTextBox @bind-Value="_f.ReasonType" Placeholder="DOWNTIME / DEFECT / SCRAP" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Module"]" />
                    <RadzenTextBox @bind-Value="_f.AppliesToModule" Placeholder="INJ / PNT / QC" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Seq"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DisplayOrder" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.Description"]" />
                <RadzenTextBox @bind-Value="_f.Description" Placeholder='@L["MD.ReasonCode.Ph.Description"]' AutoComplete="false"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            <div style="display:flex;gap:16px;margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.RequiresComment" />
                    <span>@L["Col.NoteRequired"]</span>
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.PlannedFlag" />
                    <span>@L["Col.Planned"]</span>
                </label>
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.Status"]" />
                <RadzenDropDown @bind-Value="_f.Status" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value"
                                InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.ReasonCode.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.ReasonCode</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.ReasonName"]" />
                    <RadzenTextBox @bind-Value="_f.ReasonName" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ReasonType"]" />
                    <RadzenTextBox @bind-Value="_f.ReasonType" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Module"]" />
                    <RadzenTextBox @bind-Value="_f.AppliesToModule" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Seq"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DisplayOrder" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.Description"]" />
                <RadzenTextBox @bind-Value="_f.Description" AutoComplete="false"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            <div style="display:flex;gap:16px;margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.RequiresComment" />
                    <span>@L["Col.NoteRequired"]</span>
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.PlannedFlag" />
                    <span>@L["Col.Planned"]</span>
                </label>
            </div>

            <div style="margin-top:6px;">
                <RadzenLabel Text="@L["Col.Status"]" />
                <RadzenDropDown @bind-Value="_f.Status" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value"
                                InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow? _sel;

    string _fSearch = "";
    string? _fType, _fModule;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/re/reason-code");
        Reload();
    }

    void Reload()
    {
        try { _allRows = Md.ListReasonCodes(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.ReasonCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.ReasonName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fType))
            _rows = _rows.Where(r => r.ReasonType == _fType).ToList();
        if (!string.IsNullOrWhiteSpace(_fModule))
            _rows = _rows.Where(r => r.AppliesToModule == _fModule).ToList();
    }

    IEnumerable<DropDownItem> TypeFilterOptions =>
        _allRows.Select(r => r.ReasonType).Where(x => x != null).Distinct().OrderBy(x => x)
            .Select(t => new DropDownItem { Value = t!, Text = t! });

    IEnumerable<DropDownItem> ModuleFilterOptions =>
        _allRows.Select(r => r.AppliesToModule).Where(x => x != null).Distinct().OrderBy(x => x)
            .Select(m => new DropDownItem { Value = m!, Text = m! });

    DropDownItem[] StatusOptions =
    {
        new() { Value = "ACTIVE",   Text = "ACTIVE"   },
        new() { Value = "INACTIVE", Text = "INACTIVE" },
    };

    void ReasonRowRender(RowRenderEventArgs<AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.ReasonCodeRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            ReasonName      = r.ReasonName      ?? "",
            ReasonType      = r.ReasonType      ?? "",
            AppliesToModule = r.AppliesToModule  ?? "",
            RequiresComment = r.RequiresComment,
            PlannedFlag     = r.PlannedFlag,
            DisplayOrder    = r.DisplayOrder,
            Description     = r.Description     ?? "",
            Status          = r.Status          ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ReasonCode)) { _modalErr = L["Err.ReasonCodeRequired"]; return; }
        var code = _f.ReasonCode.Trim();
        if (Md.ReasonCodeExists(code)) { _modalErr = $"'{code}' 코드가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertReasonCode(code, NE(_f.ReasonName), NE(_f.ReasonType),
                NE(_f.AppliesToModule), _f.RequiresComment, _f.PlannedFlag,
                _f.DisplayOrder, NE(_f.Description), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{code} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            Md.UpdateReasonCode(_sel.ReasonCode, NE(_f.ReasonName), NE(_f.ReasonType),
                NE(_f.AppliesToModule), _f.RequiresComment, _f.PlannedFlag,
                _f.DisplayOrder, NE(_f.Description), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.ReasonCode} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var code = _sel.ReasonCode;
            Md.DeleteReasonCode(_sel.ReasonCode);
            CloseModal(); Reload();
            ShowMsg($"{code} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    class FormModel
    {
        public string  ReasonCode      { get; set; } = "";
        public string  ReasonName      { get; set; } = "";
        public string  ReasonType      { get; set; } = "";
        public string  AppliesToModule { get; set; } = "";
        public bool    RequiresComment { get; set; } = false;
        public bool    PlannedFlag     { get; set; } = false;
        public int?    DisplayOrder    { get; set; }
        public string  Description     { get; set; } = "";
        public string  Status          { get; set; } = "ACTIVE";
    }
}