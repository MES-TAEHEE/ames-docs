@page "/md/re/equipment"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider Auth
@inject PermissionService Perm
@inject MasterDataRepository Md
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-014 @L["MD.Equipment.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-014" TitleKey="MD.Equipment.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@RunLabel</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "RUN")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.LineCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Equipment.Kpi.EquipTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.EquipType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Equipment.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Equipment.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Line"]" Component="DropDownLine" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownLine" @bind-Value="_fLine" Data="@LineFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:280px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fType" Data="@EquipTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenLabel Text="@L["Col.Active"]" Component="DropDownActive" />
            <RadzenDropDown Name="DropDownActive" @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.EquipmentRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Equipment.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="EquipID" Title="@L["Col.EquipId"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="code">@r.EquipID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="EquipName" Title="@L["Col.EquipName"]">
                <Template Context="r">@(r.EquipName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="EquipType" Title="@L["Col.EquipType"]" Width="100px">
                <Template Context="r"><span class="pill">@(r.EquipType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="LineID" Title="@L["Col.Line"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r"><span class="dim">@(r.LineID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="WCID" Title="@L["Col.WorkCenter"]" Width="130px">
                <Template Context="r">
                    @if (!string.IsNullOrEmpty(r.WCID))
                    {
                        var wcName = _wcList.FirstOrDefault(w => w.WCID == r.WCID)?.WCName;
                        <span class="code">@r.WCID</span>
                        @if (!string.IsNullOrEmpty(wcName)) { <span class="dim" style="font-size:.8em;margin-left:4px;">@wcName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="MakerModel" Title="@L["Col.MakerModel"]" Width="150px">
                <Template Context="r"><span class="dim">@(r.MakerModel ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="InstallDate" Title="@L["Col.InstallDate"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="dim">@(r.InstallDate?.ToString(DateFmt.Date) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="TheoreticalCycle" Title="@L["Col.TheoreticalCycle"]" TextAlign="TextAlign.Right" Width="140px">
                <Template Context="r">@(r.TheoreticalCycle?.ToString("F2") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="TargetOEE" Title="@L["Col.TargetOee"]" TextAlign="TextAlign.Right" Width="130px">
                <Template Context="r">@(r.TargetOEE?.ToString("F1") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="PlcAddress" Title="@L["Col.PlcAddr"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="dim">@(r.PlcAddress ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r">
                    @{
                        var scls   = r.Status switch { "RUN" => "ok", "DOWN" => "bad", "PM" => "orange", "IDLE" => "mute", _ => "mute" };
                        var sLabel = _equipStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status;
                    }
                    <span class="pill @scls">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.EquipmentRow" Property="ActiveFlag" Title="@L["Col.Active"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r">
                    @{
                        var afCode  = r.ActiveFlag ? "ACTIVE" : "INACTIVE";
                        var afLabel = _activeFlagItems.FirstOrDefault(a => a.CodeValue == afCode) is { } af ? MasterDataRepository.LocalName(af) : afCode;
                    }
                    <span class="pill @(r.ActiveFlag ? "ok" : "bad")">@afLabel</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Equipment.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.EquipId"]" class="ames-rz-modal-label" Component="CreateTextBoxEquipID" />
                <RadzenTextBox Name="CreateTextBoxEquipID" @bind-Value="_f.EquipID" Placeholder="EQ-INJ-001" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["Col.EquipName"]" class="ames-rz-modal-label" Component="CreateTextBoxEquipName" />
                <RadzenTextBox Name="CreateTextBoxEquipName" @bind-Value="_f.EquipName" Placeholder='@L["MD.Equipment.Ph.EquipName"]' InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.EquipType"]" />
                    <RadzenTextBox @bind-Value="_f.EquipType" Placeholder="INJECTION, PAINT" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Line"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.WorkCenter"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.WCID" Data="@WcOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.MakerModel"]" />
                    <RadzenTextBox @bind-Value="_f.MakerModel" Placeholder='@L["MD.Equipment.Ph.MakerModel"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InstallDate"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.InstallDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.TheoreticalCycle"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.TheoreticalCycle" Min="0m" Step="0.01" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.TargetOee"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.TargetOEE" Min="0m" Max="100m" Step="0.1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.PlcAddr"]" />
                    <RadzenTextBox @bind-Value="_f.PlcAddress" Placeholder="192.168.1.10:502" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@EquipStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" Disabled="@(!_f.ActiveFlag)" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" Value="@_f.ActiveFlag" Change="@OnActiveChanged" Name="CreateChkActive" />
                <RadzenLabel Text="@L["Lbl.Active"]" Component="CreateChkActive" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Equipment.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.EquipID</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.EquipName"]" class="ames-rz-modal-label" Component="EditTextBoxEquipName" />
                <RadzenTextBox Name="EditTextBoxEquipName" @bind-Value="_f.EquipName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.EquipType"]" />
                    <RadzenTextBox @bind-Value="_f.EquipType" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Line"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.WorkCenter"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.WCID" Data="@WcOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.MakerModel"]" />
                    <RadzenTextBox @bind-Value="_f.MakerModel" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InstallDate"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.InstallDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.TheoreticalCycle"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.TheoreticalCycle" Min="0m" Step="0.01" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.TargetOee"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.TargetOEE" Min="0m" Max="100m" Step="0.1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.PlcAddr"]" />
                    <RadzenTextBox @bind-Value="_f.PlcAddress" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@EquipStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" Disabled="@(!_f.ActiveFlag)" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" Value="@_f.ActiveFlag" Change="@OnActiveChanged" Name="EditChkActive" />
                <RadzenLabel Text="@L["Lbl.Active"]" Component="EditChkActive" style="cursor:pointer;" />
            </RadzenStack>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.EquipmentRow>  _allRows     = new();
    List<MasterDataRepository.EquipmentRow> _rows = new();
    List<MasterDataRepository.LineRow> _lineList = new();
    List<MasterDataRepository.WorkCenterRow> _wcList = new();
    List<MasterDataRepository.CodeItemRow> _equipStatus = new();
    List<MasterDataRepository.CodeItemRow> _activeFlagItems = new();
    MasterDataRepository.EquipmentRow? _sel;

    string _fSearch = "";
    string? _fLine, _fType, _fActive;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool  _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> LineFilterOptions => _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = MasterDataRepository.LocalName(l.LineName, l.LineNameEn) is { Length: > 0 } nm ? $"[{l.LineID}] {nm}" : $"[{l.LineID}]" });
    IEnumerable<DropDownItem> LineOptions => _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = MasterDataRepository.LocalName(l.LineName, l.LineNameEn) is { Length: > 0 } nm ? $"[{l.LineID}] {nm}" : $"[{l.LineID}]" });
    IEnumerable<DropDownItem> EquipTypeOptions => _allRows.Select(r => r.EquipType).Where(x => x != null).Distinct().OrderBy(x => x).Select(t => new DropDownItem { Value = t!, Text = t! });
    IEnumerable<DropDownItem> WcOptions => _wcList.Where(w => w.ActiveFlag).Select(w => new DropDownItem { Value = w.WCID, Text = $"[{w.WCID}]" + (w.WCName != null ? $" {w.WCName}" : "") });
    IEnumerable<DropDownItem> EquipStatusOptions => _equipStatus.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });

    // 가동(RUN) KPI 라벨: EQUIP_STATUS 공통코드 LocalName (다국어)
    string RunLabel => _equipStatus.FirstOrDefault(s => s.CodeValue == "RUN") is { } rf ? MasterDataRepository.LocalName(rf) : "RUN";
    private IEnumerable<DropDownItem> ActiveFilterOptions =>
        _activeFlagItems.Where(a => a.UseFlag).Select(a => new DropDownItem { Value = a.CodeValue ?? "", Text = MasterDataRepository.LocalName(a) });

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/re/equipment");
        try { _lineList    = Md.ListLines();                   } catch { }
        try { _wcList      = Md.ListWorkCenters();             } catch { }
        try { _equipStatus = Md.ListCodeItems("EQUIP_STATUS"); } catch { }
        try { _activeFlagItems = Md.ListCodeItems("ACTIVE_FLAG"); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.EquipmentRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _allRows = Md.ListEquipments(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.EquipID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EquipName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineID    == _fLine) &&
        (string.IsNullOrEmpty(_fType)   || r.EquipType == _fType) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "ACTIVE" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.EquipmentRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.EquipmentRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new() { ActiveFlag = true, Status = "RUN" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    // 활성 해제 시 상태값을 유휴(IDLE)로 자동 선택하고 상태 콤보를 비활성화
    void OnActiveChanged(bool val)
    {
        _f.ActiveFlag = val;
        if (!val) _f.Status = "IDLE";
    }

    void OpenEdit(MasterDataRepository.EquipmentRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            EquipID          = r.EquipID,
            EquipName        = r.EquipName    ?? "",
            EquipType        = r.EquipType    ?? "",
            LineID           = r.LineID       ?? "",
            WCID             = r.WCID         ?? "",
            MakerModel       = r.MakerModel   ?? "",
            InstallDate      = r.InstallDate,
            TheoreticalCycle = r.TheoreticalCycle,
            TargetOEE        = r.TargetOEE,
            PlcAddress       = r.PlcAddress   ?? "",
            Status           = r.Status       ?? "Active",
            ActiveFlag       = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipID))  { _modalErr = L["Err.EquipIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.EquipName)) { _modalErr = L["Err.EquipNameRequired"]; return; }
        if (Md.EquipmentExists(_f.EquipID.Trim()))   { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], _f.EquipID.Trim()); return; }
        _busy = true;
        try
        {
            Md.InsertEquipment(_f.EquipID.Trim(), _f.EquipName, NE(_f.EquipType),
                NE(_f.LineID), NE(_f.WCID), NE(_f.MakerModel),
                _f.InstallDate, _f.TheoreticalCycle, _f.TargetOEE,
                NE(_f.PlcAddress), NE(_f.Status), _f.ActiveFlag, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{_f.EquipName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipName)) { _modalErr = L["Err.EquipNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateEquipment(_sel.EquipID, _f.EquipName, NE(_f.EquipType),
                NE(_f.LineID), NE(_f.WCID), NE(_f.MakerModel),
                _f.InstallDate, _f.TheoreticalCycle, _f.TargetOEE,
                NE(_f.PlcAddress), NE(_f.Status), _f.ActiveFlag, _actor);
            var name = _f.EquipName;
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.EquipName ?? _sel.EquipID;
            Md.DeleteEquipment(_sel.EquipID);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string    EquipID          { get; set; } = "";
        public string    EquipName        { get; set; } = "";
        public string    EquipType        { get; set; } = "";
        public string    LineID           { get; set; } = "";
        public string    WCID             { get; set; } = "";
        public string    MakerModel       { get; set; } = "";
        public DateOnly? InstallDate      { get; set; }
        public decimal?  TheoreticalCycle { get; set; }
        public decimal?  TargetOEE        { get; set; }
        public string    PlcAddress       { get; set; } = "";
        public string    Status           { get; set; } = "Active";
        public bool      ActiveFlag       { get; set; } = true;
    }
}