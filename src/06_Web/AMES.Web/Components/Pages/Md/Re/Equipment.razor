@page "/md/re/equipment"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>@L["MD.Equipment.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.LineCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Equipment.Kpi.EquipTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.EquipType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Equipment.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.Equipment.Ph.Search"]'
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' />
            <RadzenLabel Text="@L["Col.Line"]" />
            <RadzenDropDown @bind-Value="_fLine" Data="@LineFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllLines"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Type"]" />
            <RadzenDropDown @bind-Value="_fType" Data="@EquipTypeOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllTypes"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenLabel Text="@L["Col.Active"]" />
            <RadzenDropDown @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.All"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="25"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    RowRender="@EquipRowRender"
                    RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data); })"
                    EmptyText="@L["MD.Equipment.Empty"]"
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="EquipID" Title="@L["Col.EquipId"]" Width="110px">
                <Template Context="r"><span class="code">@r.EquipID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="EquipName" Title="@L["Col.EquipName"]">
                <Template Context="r">@(r.EquipName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="EquipType" Title="@L["Col.EquipType"]" Width="100px">
                <Template Context="r"><span class="pill">@(r.EquipType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="LineID" Title="@L["Col.Line"]" Width="80px">
                <Template Context="r"><span class="dim">@(r.LineID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="WCID" Title="@L["Col.WorkCenter"]" Width="90px">
                <Template Context="r"><span class="dim">@(r.WCID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="MakerModel" Title="@L["Col.MakerModel"]" Width="120px">
                <Template Context="r"><span class="dim">@(r.MakerModel ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="InstallDate" Title="@L["Col.InstallDate"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.InstallDate?.ToString("yyyy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="TheoreticalCycle" Title="@L["Col.TheoreticalCycle"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.TheoreticalCycle?.ToString("F2") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="TargetOEE" Title="@L["Col.TargetOee"]" Width="72px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.TargetOEE?.ToString("F1") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="PlcAddress" Title="@L["Col.PlcAddr"]" Width="120px">
                <Template Context="r"><span class="dim">@(r.PlcAddress ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.EquipmentRow" Property="Status" Title="@L["Col.Status"]" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @{
                        var scls   = r.Status switch { "ACTIVE" => "ok", "MAINT" => "warn", _ => "bad" };
                        var sLabel = _equipStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status;
                    }
                    <span class="pill @scls">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Equipment.Title"] — @L["Btn.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.EquipId"]" />
                    <RadzenTextBox @bind-Value="_f.EquipID" Placeholder="EQ-INJ-001" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.EquipName"]" />
                    <RadzenTextBox @bind-Value="_f.EquipName" Placeholder='@L["MD.Equipment.Ph.EquipName"]' AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.EquipType"]" />
                    <RadzenTextBox @bind-Value="_f.EquipType" Placeholder="INJECTION, PAINT 등" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.LineId"]" />
                    <RadzenDropDown @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="Work Center ID" />
                    <RadzenDropDown @bind-Value="_f.WCID" Data="@WcOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.MakerModel"]" />
                    <RadzenTextBox @bind-Value="_f.MakerModel" Placeholder='@L["MD.Equipment.Ph.MakerModel"]' AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.InstallDate"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.InstallDate" DateFormat="yyyy-MM-dd"
                                      InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.TheoreticalCycle"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.TheoreticalCycle" Min="0m" Step="0.01m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.TargetOee"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.TargetOEE" Min="0m" Max="100m" Step="0.1m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.PlcAddr"]" />
                    <RadzenTextBox @bind-Value="_f.PlcAddress" Placeholder="192.168.1.10:502" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@EquipStatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div style="display:flex;align-items:flex-end;padding-bottom:2px;">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                        <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                        <span>@L["Lbl.Active"]</span>
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Equipment.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.EquipID</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.EquipName"]" />
                    <RadzenTextBox @bind-Value="_f.EquipName" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.EquipType"]" />
                    <RadzenTextBox @bind-Value="_f.EquipType" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.LineId"]" />
                    <RadzenDropDown @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="Work Center ID" />
                    <RadzenDropDown @bind-Value="_f.WCID" Data="@WcOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.MakerModel"]" />
                    <RadzenTextBox @bind-Value="_f.MakerModel" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.InstallDate"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.InstallDate" DateFormat="yyyy-MM-dd"
                                      InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.TheoreticalCycle"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.TheoreticalCycle" Min="0m" Step="0.01m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.TargetOee"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.TargetOEE" Min="0m" Max="100m" Step="0.1m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.PlcAddr"]" />
                    <RadzenTextBox @bind-Value="_f.PlcAddress" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@EquipStatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.EquipmentRow>  _allRows     = new();
    List<AMES.Data.Repositories.MasterDataRepository.EquipmentRow>  _rows        = new();
    AMES.Data.Repositories.MasterDataRepository.EquipmentRow? _sel;

    List<AMES.Data.Repositories.MasterDataRepository.LineRow>       _lineList    = new();
    List<AMES.Data.Repositories.MasterDataRepository.WorkCenterRow> _wcList      = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow>   _equipStatus = new();

    string _fSearch = "";
    string? _fLine, _fType, _fActive;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/re/equipment");
        try { _lineList    = Md.ListLines();                   } catch { }
        try { _wcList      = Md.ListWorkCenters();             } catch { }
        try { _equipStatus = Md.ListCodeItems("EQUIP_STATUS"); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListEquipments(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.EquipID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EquipName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineID    == _fLine) &&
        (string.IsNullOrEmpty(_fType)   || r.EquipType == _fType) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    IEnumerable<DropDownItem> LineFilterOptions =>
        _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = l.LineID + (l.LineName != null ? $" {l.LineName}" : "") });

    IEnumerable<DropDownItem> LineOptions =>
        _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = $"[{l.LineID}]" + (l.LineName != null ? $" {l.LineName}" : "") });

    IEnumerable<DropDownItem> EquipTypeOptions =>
        _allRows.Select(r => r.EquipType).Where(x => x != null).Distinct().OrderBy(x => x)
            .Select(t => new DropDownItem { Value = t!, Text = t! });

    IEnumerable<DropDownItem> WcOptions =>
        _wcList.Where(w => w.ActiveFlag)
            .Select(w => new DropDownItem { Value = w.WCID, Text = $"[{w.WCID}]" + (w.WCName != null ? $" {w.WCName}" : "") });

    IEnumerable<DropDownItem> EquipStatusOptions =>
        _equipStatus.Where(s => s.UseFlag)
            .Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });

    DropDownItem[] ActiveFilterOptions =
    {
        new() { Value = "Y", Text = "Active" },
        new() { Value = "N", Text = "Inactive" },
    };

    void EquipRowRender(RowRenderEventArgs<AMES.Data.Repositories.MasterDataRepository.EquipmentRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OpenCreate() { _f = new() { ActiveFlag = true, Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.EquipmentRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            EquipID          = r.EquipID,
            EquipName        = r.EquipName    ?? "",
            EquipType        = r.EquipType    ?? "",
            LineID           = r.LineID       ?? "",
            WCID             = r.WCID         ?? "",
            MakerModel       = r.MakerModel   ?? "",
            InstallDate      = r.InstallDate,
            TheoreticalCycle = r.TheoreticalCycle,
            TargetOEE        = r.TargetOEE,
            PlcAddress       = r.PlcAddress   ?? "",
            Status           = r.Status       ?? "Active",
            ActiveFlag       = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipID))  { _modalErr = L["Err.EquipIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.EquipName)) { _modalErr = L["Err.EquipNameRequired"]; return; }
        if (Md.EquipmentExists(_f.EquipID.Trim()))   { _modalErr = $"설비ID '{_f.EquipID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertEquipment(_f.EquipID.Trim(), _f.EquipName, NE(_f.EquipType),
                NE(_f.LineID), NE(_f.WCID), NE(_f.MakerModel),
                _f.InstallDate, _f.TheoreticalCycle, _f.TargetOEE,
                NE(_f.PlcAddress), NE(_f.Status), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.EquipName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipName)) { _modalErr = L["Err.EquipNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateEquipment(_sel.EquipID, _f.EquipName, NE(_f.EquipType),
                NE(_f.LineID), NE(_f.WCID), NE(_f.MakerModel),
                _f.InstallDate, _f.TheoreticalCycle, _f.TargetOEE,
                NE(_f.PlcAddress), NE(_f.Status), _f.ActiveFlag, _actor);
            var name = _f.EquipName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.EquipName ?? _sel.EquipID;
            Md.DeleteEquipment(_sel.EquipID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    class FormModel
    {
        public string    EquipID          { get; set; } = "";
        public string    EquipName        { get; set; } = "";
        public string    EquipType        { get; set; } = "";
        public string    LineID           { get; set; } = "";
        public string    WCID             { get; set; } = "";
        public string    MakerModel       { get; set; } = "";
        public DateOnly? InstallDate      { get; set; }
        public decimal?  TheoreticalCycle { get; set; }
        public decimal?  TargetOEE        { get; set; }
        public string    PlcAddress       { get; set; } = "";
        public string    Status           { get; set; } = "Active";
        public bool      ActiveFlag       { get; set; } = true;
    }
}