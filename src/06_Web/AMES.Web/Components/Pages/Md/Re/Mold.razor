@page "/md/re/mold"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-007 @L["MD.Mold.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-007" TitleKey="MD.Mold.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "AVAILABLE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.NeedMaint"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RatedShots.HasValue && r.CurrentShots.HasValue && r.CurrentShots >= r.RatedShots)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.StorageLocs"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.StorageLoc).Where(l => l != null).Distinct().Count()</div>
    </div>
</div>

<AmesTabs>
    <AmesTab Title="@L["MD.Mold.Tab.Master"].Value">

        @if (!string.IsNullOrEmpty(_msg))
        {
            <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
        }

        <div class="ames-card">
            <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
                <span style="white-space:nowrap;">▼ @L["MD.Mold.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder='@L["MD.Mold.Ph.Search"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
                    <RadzenLabel Text="@L["Col.StorageLoc"]" Component="DropDownStorageLoc" />
                    <RadzenDropDown AllowFiltering="true" Name="DropDownStorageLoc" @bind-Value="_fLoc" Data="@LocFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
                    <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
                    <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />

                    <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
                    @if (_canEdit)
                    {
                        <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
                    }
                </RadzenStack>
            </div>

            <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.MoldRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                            PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Mold.Empty"]" Class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="MoldID" Title="@L["Col.MoldId"]" TextAlign="TextAlign.Center" Width="110px">
                        <Template Context="r"><span class="code">@r.MoldID</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="MoldName" Title="@L["Col.MoldName"]">
                        <Template Context="r">@(r.MoldName ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="CavityCount" Title="@L["Col.Cavities"]" TextAlign="TextAlign.Right" Width="100px">
                        <Template Context="r">@(r.CavityCount?.ToString() ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="Tonnage" Title="@L["Col.Tonnage"]" TextAlign="TextAlign.Right" Width="100px">
                        <Template Context="r">@(r.Tonnage?.ToString("N0") ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="RatedShots" Title="@L["Col.ShotsLifetime"]" TextAlign="TextAlign.Right" Width="100px">
                        <Template Context="r">@(r.RatedShots?.ToString("N0") ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="CurrentShots" Title="@L["Col.ShotsCurrent"]" TextAlign="TextAlign.Right" Width="120px">
                        <Template Context="r">@(r.CurrentShots?.ToString("N0") ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="CumulativeShots" Title="@L["Col.ShotsCumulative"]" TextAlign="TextAlign.Right" Width="100px">
                        <Template Context="r">@r.CumulativeShots.ToString("N0")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Title="@L["Col.UsagePct"]" TextAlign="TextAlign.Right" Width="80px" Sortable="false">
                        <Template Context="r">
                            @{
                                var pct = r.RatedShots.HasValue && r.RatedShots > 0 && r.CurrentShots.HasValue
                                    ? (double)r.CurrentShots.Value / r.RatedShots.Value * 100
                                    : (double?)null;
                            }
                            @if (pct.HasValue)
                            {
                                var cls = pct.Value >= 100 ? "bad" : pct.Value >= 80 ? "warn" : "ok";
                                <span class="pill @cls">@pct.Value.ToString("N1")%</span>
                            }
                            else { <span class="dim">—</span> }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="StorageLoc" Title="@L["Col.StorageLoc"]" TextAlign="TextAlign.Center" Width="120px">
                        <Template Context="r"><span class="dim">@(r.StorageLoc ?? "—")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="LastMaintDate" Title="@L["Col.LastMaint"]" TextAlign="TextAlign.Center" Width="120px">
                        <Template Context="r"><span class="dim">@(r.LastMaintDate?.ToString(DateFmt.Date) ?? "—")</span></Template>
                    </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.MoldRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="120px">
                        <Template Context="r">
                            @{
                                var scls   = r.Status switch { "AVAILABLE" => "ok", "MOUNTED" => "info", _ => "bad" };
                                var sLabel = _moldStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status;
                            }
                            <span class="pill @scls">@(sLabel ?? "—")</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>

    </AmesTab>

    <AmesTab Title="@L["MD.MoldItem.Title"].Value">
        <MoldItemPanel />
    </AmesTab>

    <AmesTab Title="@L["MD.MoldLine.Title"].Value">
        <MoldLinePanel />
    </AmesTab>
</AmesTabs>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Mold.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@(L["Col.MoldId"] + " *")' class="ames-rz-modal-label" Component="CreateTextBoxMoldID" />
                <RadzenTextBox Name="CreateTextBoxMoldID" @bind-Value="_f.MoldID" Placeholder="MLD-INJ-001" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@(L["Col.MoldName"] + " *")' class="ames-rz-modal-label" Component="CreateTextBoxMoldName" />
                <RadzenTextBox Name="CreateTextBoxMoldName" @bind-Value="_f.MoldName" Placeholder='@L["MD.Mold.Ph.MoldName"]' InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Cavities"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CavityCount" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Tonnage"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.Tonnage" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ShotsLifetime"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.RatedShots" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ShotsCurrent"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CurrentShots" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Mold.StoreLoc"]" />
                    <RadzenTextBox @bind-Value="_f.StorageLoc" Placeholder='@L["MD.Mold.Ph.StorageLoc"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.LastMaint"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.LastMaintDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.CarType"]" />
                    <RadzenTextBox @bind-Value="_f.CarType" MaxLength="20" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.RefCode"]" />
                    <RadzenTextBox @bind-Value="_f.RefCode" MaxLength="20" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.AssyInjResultFlag" Name="CreateChkAssyInj" />
                <RadzenLabel Text="@L["Col.AssyInjResult"]" Component="CreateChkAssyInj" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Mold.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.MoldID</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@(L["Col.MoldName"] + " *")' class="ames-rz-modal-label" Component="EditTextBoxMoldName" />
                <RadzenTextBox Name="EditTextBoxMoldName" @bind-Value="_f.MoldName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Cavities"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CavityCount" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Tonnage"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.Tonnage" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ShotsLifetime"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.RatedShots" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ShotsCurrent"]" />
                    <RadzenNumeric TValue="int?" Value="_f.CurrentShots" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Mold.StoreLoc"]" />
                    <RadzenTextBox @bind-Value="_f.StorageLoc" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.LastMaint"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.LastMaintDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.CarType"]" />
                    <RadzenTextBox @bind-Value="_f.CarType" MaxLength="20" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.RefCode"]" />
                    <RadzenTextBox @bind-Value="_f.RefCode" MaxLength="20" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.AssyInjResultFlag" Name="EditChkAssyInj" />
                <RadzenLabel Text="@L["Col.AssyInjResult"]" Component="EditChkAssyInj" style="cursor:pointer;" />
            </RadzenStack>

            @* ── 색상 관리 (MD_MoldColor, ZPD20041) ── *@
            <div style="margin-top:10px;">
                <RadzenLabel Text="@L["Col.Color"]" />
                <div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:4px;">
                    @foreach (var c in _colors)
                    {
                        <span class="pill info" style="display:inline-flex;align-items:center;gap:5px;">
                            @c.Color
                            <span style="cursor:pointer;font-weight:700;line-height:1;" title="@L["Btn.Delete"]" @onclick="() => RemoveColor(c.Color)">×</span>
                        </span>
                    }
                    @if (_colors.Count == 0) { <span class="dim" style="font-size:.85em;">—</span> }
                </div>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top:6px;">
                    <RadzenTextBox @bind-Value="_newColor" @onkeydown="OnColorKeyDown" Placeholder="@L["MD.Mold.Ph.Color"]" MaxLength="10" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;text-transform:uppercase;" AutoCompleteType="AutoCompleteType.Off" />
                    <RadzenButton Text="@L["Btn.Add"]" Icon="add" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@AddColor" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            </div>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.MoldRow>     _allRows    = new();
    List<MasterDataRepository.MoldRow>     _rows       = new();
    List<MasterDataRepository.CodeItemRow>  _moldStatus = new();
    List<MasterDataRepository.MoldColorRow> _colors     = new();
    MasterDataRepository.MoldRow? _sel;
    string _newColor = "";

    string _fSearch = "";
    string? _fStatus, _fLoc;
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> StatusOptions => _moldStatus.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });
    IEnumerable<DropDownItem> LocFilterOptions => _allRows.Select(r => r.StorageLoc).Where(x => x != null).Distinct().OrderBy(x => x).Select(l => new DropDownItem { Value = l!, Text = l! });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/re/mold");
        try { _moldStatus = MD.ListCodeItems("MOLD_STATUS"); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.MoldRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _allRows = MD.ListMolds(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.MoldID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MoldName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status     == _fStatus) &&
        (string.IsNullOrEmpty(_fLoc)    || r.StorageLoc == _fLoc)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.MoldRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.MoldRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.MoldRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            MoldID            = r.MoldID,
            MoldName          = r.MoldName      ?? "",
            RatedShots        = r.RatedShots,
            CurrentShots      = r.CurrentShots,
            CavityCount       = r.CavityCount,
            Tonnage           = r.Tonnage,
            StorageLoc        = r.StorageLoc    ?? "",
            LastMaintDate     = r.LastMaintDate,
            Status            = r.Status        ?? "AVAILABLE",
            CarType           = r.CarType       ?? "",
            RefCode           = r.RefCode       ?? "",
            AssyInjResultFlag = r.AssyInjResultFlag,
        };
        _newColor = "";
        try { _colors = MD.ListMoldColors(r.MoldID); } catch { _colors = new(); }
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MoldID))   { _modalErr = L["Err.MoldIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.MoldName))  { _modalErr = L["Err.MoldNameRequired"]; return; }
        if (MD.MoldExists(_f.MoldID.Trim())) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], _f.MoldID.Trim()); return; }
        _busy = true;
        try
        {
            MD.InsertMold(_f.MoldID.Trim(), _f.MoldName,
                _f.RatedShots, _f.CurrentShots, _f.CavityCount, _f.Tonnage,
                NE(_f.StorageLoc), _f.LastMaintDate, _f.Status, _actor,
                carType: NE(_f.CarType), refCode: NE(_f.RefCode), assyInjResultFlag: _f.AssyInjResultFlag);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{_f.MoldName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MoldName)) { _modalErr = L["Err.MoldNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateMold(_sel.MoldID, _f.MoldName,
                _f.RatedShots, _f.CurrentShots, _f.CavityCount, _f.Tonnage,
                NE(_f.StorageLoc), _f.LastMaintDate, _f.Status, _actor,
                carType: NE(_f.CarType), refCode: NE(_f.RefCode), assyInjResultFlag: _f.AssyInjResultFlag);
            var name = _f.MoldName;
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            // ZPD20041 삭제 가드: 제품정보/라인배정에서 사용 중이면 삭제 불가
            var (ic, lc, cc) = MD.MoldUsage(_sel.MoldID);
            if (ic > 0 || lc > 0)
            {
                _modalErr = string.Format(L["Err.MoldInUse"], ic, lc);
                _confirmDelete = false;
                return;
            }
            if (cc > 0)
                foreach (var c in MD.ListMoldColors(_sel.MoldID))
                    MD.DeleteMoldColor(_sel.MoldID, c.Color);
            var name = _sel.MoldName ?? _sel.MoldID;
            MD.DeleteMold(_sel.MoldID);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    // ── 색상 관리 (edit 모달) ─────────────────────────────────────────────
    void AddColor()
    {
        if (_sel is null || string.IsNullOrWhiteSpace(_newColor)) return;
        _modalErr = "";
        try
        {
            MD.InsertMoldColor(_sel.MoldID, _newColor.Trim().ToUpper(), _actor);
            _newColor = "";
            _colors = MD.ListMoldColors(_sel.MoldID);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
    }

    void RemoveColor(string color)
    {
        if (_sel is null) return;
        _modalErr = "";
        try
        {
            MD.DeleteMoldColor(_sel.MoldID, color);
            _colors = MD.ListMoldColors(_sel.MoldID);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
    }

    void OnColorKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddColor(); }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string    MoldID            { get; set; } = "";
        public string    MoldName          { get; set; } = "";
        public int?      RatedShots        { get; set; }
        public int?      CurrentShots      { get; set; }
        public int?      CavityCount       { get; set; }
        public int?      Tonnage           { get; set; }
        public string    StorageLoc        { get; set; } = "";
        public DateOnly? LastMaintDate     { get; set; }
        public string    Status            { get; set; } = "AVAILABLE";
        public string    CarType           { get; set; } = "";
        public string    RefCode           { get; set; } = "";
        public bool      AssyInjResultFlag { get; set; }
    }
}