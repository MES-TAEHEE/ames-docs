@page "/md/re/mold"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>@L["MD.Mold.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "AVAILABLE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.NeedMaint"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RatedShots.HasValue && r.CurrentShots.HasValue && r.CurrentShots >= r.RatedShots)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.StorageLocs"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.StorageLoc).Where(l => l != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Mold.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.Mold.Ph.Search"]'
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' />
            <RadzenLabel Text="@L["Col.Status"]" />
            <RadzenDropDown @bind-Value="_fStatus" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllStatus"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.StorageLoc"]" />
            <RadzenDropDown @bind-Value="_fLoc" Data="@LocFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllLocations"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="25"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    RowRender="@MoldRowRender"
                    RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data); })"
                    EmptyText="@L["MD.Mold.Empty"]"
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="MoldID" Title="@L["Col.MoldId"]" Width="110px">
                <Template Context="r"><span class="code">@r.MoldID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="MoldName" Title="@L["Col.MoldName"]">
                <Template Context="r">@(r.MoldName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="CavityCount" Title="@L["Col.Cavities"]" Width="70px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.CavityCount?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="Tonnage" Title="@L["Col.Tonnage"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.Tonnage?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="RatedShots" Title="@L["Col.ShotsLifetime"]" Width="100px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.RatedShots?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="CurrentShots" Title="@L["Col.ShotsCurrent"]" Width="100px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.CurrentShots?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Title="@L["Col.UsagePct"]" Width="80px" TextAlign="TextAlign.Right" Sortable="false">
                <Template Context="r">
                    @{
                        var pct = r.RatedShots.HasValue && r.RatedShots > 0 && r.CurrentShots.HasValue
                            ? (double)r.CurrentShots.Value / r.RatedShots.Value * 100
                            : (double?)null;
                    }
                    @if (pct.HasValue)
                    {
                        var cls = pct.Value >= 100 ? "bad" : pct.Value >= 80 ? "warn" : "ok";
                        <span class="pill @cls">@pct.Value.ToString("N1")%</span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="StorageLoc" Title="@L["Col.StorageLoc"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.StorageLoc ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="LastMaintDate" Title="@L["Col.LastMaint"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.LastMaintDate?.ToString("yyyy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.MoldRow" Property="Status" Title="@L["Col.Status"]" Width="110px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @{
                        var scls   = r.Status switch { "AVAILABLE" => "ok", "MOUNTED" => "info", _ => "bad" };
                        var sLabel = _moldStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status;
                    }
                    <span class="pill @scls">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Mold.Title"] — @L["Btn.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@(L["Col.MoldId"] + " *")' />
                    <RadzenTextBox @bind-Value="_f.MoldID" Placeholder="MLD-INJ-001" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@(L["Col.MoldName"] + " *")' />
                    <RadzenTextBox @bind-Value="_f.MoldName" Placeholder='@L["MD.Mold.Ph.MoldName"]' AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Cavities"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CavityCount" Min="1"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Tonnage"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.Tonnage" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.ShotsLifetime"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.RatedShots" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ShotsCurrent"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CurrentShots" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Mold.StoreLoc"]" />
                    <RadzenTextBox @bind-Value="_f.StorageLoc" Placeholder='@L["MD.Mold.Ph.StorageLoc"]' AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.LastMaint"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.LastMaintDate" DateFormat="yyyy-MM-dd"
                                      InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <RadzenLabel Text="@L["Col.Status"]" Style="margin-top:6px;" />
            <RadzenDropDown @bind-Value="_f.Status" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value"
                            Placeholder="@L["Opt.Select"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:50%;" />

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Mold.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.MoldID</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@(L["Col.MoldName"] + " *")' />
                    <RadzenTextBox @bind-Value="_f.MoldName" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Cavities"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CavityCount" Min="1"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Tonnage"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.Tonnage" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.ShotsLifetime"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.RatedShots" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ShotsCurrent"]" />
                    <RadzenNumeric TValue="int?" Value="_f.CurrentShots" Disabled="true"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Mold.StoreLoc"]" />
                    <RadzenTextBox @bind-Value="_f.StorageLoc" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.LastMaint"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.LastMaintDate" DateFormat="yyyy-MM-dd"
                                      InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.MoldRow>     _allRows    = new();
    List<AMES.Data.Repositories.MasterDataRepository.MoldRow>     _rows       = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _moldStatus = new();
    AMES.Data.Repositories.MasterDataRepository.MoldRow? _sel;

    string _fSearch = "";
    string? _fStatus, _fLoc;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/re/mold");
        try { _moldStatus = Md.ListCodeItems("MOLD_STATUS"); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListMolds(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.MoldID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MoldName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status     == _fStatus) &&
        (string.IsNullOrEmpty(_fLoc)    || r.StorageLoc == _fLoc)
    ).ToList(); }

    IEnumerable<DropDownItem> StatusOptions =>
        _moldStatus.Where(s => s.UseFlag)
            .Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });

    IEnumerable<DropDownItem> LocFilterOptions =>
        _allRows.Select(r => r.StorageLoc).Where(x => x != null).Distinct().OrderBy(x => x)
            .Select(l => new DropDownItem { Value = l!, Text = l! });

    void MoldRowRender(RowRenderEventArgs<AMES.Data.Repositories.MasterDataRepository.MoldRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.MoldRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            MoldID        = r.MoldID,
            MoldName      = r.MoldName      ?? "",
            RatedShots    = r.RatedShots,
            CurrentShots  = r.CurrentShots,
            CavityCount   = r.CavityCount,
            Tonnage       = r.Tonnage,
            StorageLoc    = r.StorageLoc    ?? "",
            LastMaintDate = r.LastMaintDate,
            Status        = r.Status        ?? "AVAILABLE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MoldID))   { _modalErr = L["Err.MoldIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.MoldName))  { _modalErr = L["Err.MoldNameRequired"]; return; }
        if (Md.MoldExists(_f.MoldID.Trim()))         { _modalErr = $"금형 ID '{_f.MoldID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertMold(_f.MoldID.Trim(), _f.MoldName,
                _f.RatedShots, _f.CurrentShots, _f.CavityCount, _f.Tonnage,
                NE(_f.StorageLoc), _f.LastMaintDate, _f.Status, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.MoldName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MoldName)) { _modalErr = L["Err.MoldNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateMold(_sel.MoldID, _f.MoldName,
                _f.RatedShots, _f.CurrentShots, _f.CavityCount, _f.Tonnage,
                NE(_f.StorageLoc), _f.LastMaintDate, _f.Status, _actor);
            var name = _f.MoldName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.MoldName ?? _sel.MoldID;
            Md.DeleteMold(_sel.MoldID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    class FormModel
    {
        public string    MoldID        { get; set; } = "";
        public string    MoldName      { get; set; } = "";
        public int?      RatedShots    { get; set; }
        public int?      CurrentShots  { get; set; }
        public int?      CavityCount   { get; set; }
        public int?      Tonnage       { get; set; }
        public string    StorageLoc    { get; set; } = "";
        public DateOnly? LastMaintDate { get; set; }
        public string    Status        { get; set; } = "AVAILABLE";
    }
}