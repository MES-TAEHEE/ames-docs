@page "/md/uom"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Uom.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-019</div>
    <div class="ames-page-t">@L["MD.Uom.Title"]</div>
    <div class="ames-page-sub">@L["MD.Uom.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">기준단위</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.BaseFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">카테고리 수</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.UOMCategory).Where(c => c != null).Distinct().Count()</div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Uom.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / 전체 {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:140px;padding:4px 8px;"
                   placeholder="단위코드 / 단위명" @bind="_fSearch" autocomplete="off" />
            <select class="ames-input" style="width:110px;padding:4px 8px;" @bind="_fCat">
                <option value="">@L["Filter.AllCategories"]</option>
                @foreach (var c in _allRows.Select(r => r.UOMCategory).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@c">@c</option>
                }
            </select>
            <select class="ames-input" style="width:90px;padding:4px 8px;" @bind="_fActive">
                <option value="">전체</option>
                <option value="Y">활성</option>
                <option value="N">비활성</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Uom.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>단위 코드</th><th>단위명</th><th>카테고리</th><th>기호</th>
                    <th>기준단위</th><th>기준UOM</th><th class="num">변환계수</th>
                    <th class="num">소수점</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td class="code">@r.UOMCode</td>
                        <td>@(r.UOMName ?? "—")</td>
                        <td class="dim">@(r.UOMCategory ?? "—")</td>
                        <td class="dim">@(r.Symbol ?? "—")</td>
                        <td>@(r.BaseFlag ? (MarkupString)"<span class=\"pill ok\">기준</span>" : (MarkupString)"")</td>
                        <td class="dim">@(r.BaseUOM ?? "—")</td>
                        <td class="num">@(r.ConvFactor?.ToString("0.########") ?? "—")</td>
                        <td class="num">@(r.DecimalPrec?.ToString() ?? "—")</td>
                        <td>@(r.ActiveFlag ? (MarkupString)"<span class=\"pill ok\">활성</span>" : (MarkupString)"<span class=\"pill bad\">비활성</span>")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.MasterDataRepository.UomRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.UomRow> _rows    = new();
    string _fSearch = "", _fCat = "", _fActive = "";

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Md.ListUoms(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.UOMCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.UOMName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fCat))
            _rows = _rows.Where(r => r.UOMCategory == _fCat).ToList();
        if (_fActive == "Y") _rows = _rows.Where(r => r.ActiveFlag).ToList();
        if (_fActive == "N") _rows = _rows.Where(r => !r.ActiveFlag).ToList();
    }
}
