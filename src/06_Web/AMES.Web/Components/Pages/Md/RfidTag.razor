@page "/md/rfid-tag"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.RfidTag.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-020</div>
    <div class="ames-page-t">@L["MD.RfidTag.Title"]</div>
    <div class="ames-page-sub">@L["MD.RfidTag.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">교체 필요</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ReplaceSchedule.HasValue && r.ReplaceSchedule.Value <= DateOnly.FromDateTime(DateTime.Today))</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">지그 연결</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.JigID != null)</div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.RfidTag.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / 전체 {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:140px;padding:4px 8px;"
                   placeholder="TagID / EPC" @bind="_fSearch" autocomplete="off" />
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _allRows.Select(r => r.Status).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@s">@s</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.RfidTag.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>Tag ID</th><th>EPC</th><th>태그 역할</th><th>지그 ID</th>
                    <th>장착 위치</th><th class="num">내열 등급</th>
                    <th class="num">사이클</th><th>설치일</th><th>교체 예정</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    var needReplace = r.ReplaceSchedule.HasValue && r.ReplaceSchedule.Value <= DateOnly.FromDateTime(DateTime.Today);
                    <tr>
                        <td class="code">@r.TagID</td>
                        <td class="dim">@(r.EPC ?? "—")</td>
                        <td>@(r.TagRole ?? "—")</td>
                        <td class="dim">@(r.JigID ?? "—")</td>
                        <td class="dim">@(r.MountPos ?? "—")</td>
                        <td class="num">@(r.HeatRating?.ToString() ?? "—")</td>
                        <td class="num">@(r.CycleCount?.ToString("N0") ?? "—")</td>
                        <td class="dim">@(r.InstallDate?.ToString("yy-MM-dd") ?? "—")</td>
                        <td class="@(needReplace ? "bad" : "dim")">@(r.ReplaceSchedule?.ToString("yy-MM-dd") ?? "—")</td>
                        <td><span class="pill @(r.Status == "ACTIVE" ? "ok" : "warn")">@(r.Status ?? "—")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.MasterDataRepository.RfidTagRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.RfidTagRow> _rows    = new();
    string _fSearch = "", _fStatus = "";

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Md.ListRfidTags(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.TagID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.EPC ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fStatus))
            _rows = _rows.Where(r => r.Status == _fStatus).ToList();
    }
}
