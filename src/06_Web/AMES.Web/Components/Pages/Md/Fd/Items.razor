    void OpenCreate()
    {
        _f = new();
        _confirmDelete = false; _modalErr = ""; _deleteBlocked = ""; _modal = "create";
    }

    void OpenEdit(MasterDataRepository.ItemRow r)
    {
        if (!_canEdit) return;
        _sel = r;
        _f = new()
        {
            ItemNo       = r.ItemNo,
            ItemName     = r.ItemName,
            ItemType     = r.ItemType ?? "",
            ItemCategory = r.ItemCategory ?? "",
            InjFlag      = r.InjFlag,
            CarType      = r.CarType ?? "",
            Uom          = r.DefaultUOM ?? "",
            RoutingType  = r.RoutingType ?? "",
            MinStock     = r.MinStock ?? 0,
            MaxStock     = r.MaxStock ?? 0,
            SafetyStock  = r.SafetyStock ?? 0,
            UnitCost     = r.UnitCost ?? 0,
            Pgn          = r.PGN ?? "",
            Alc          = r.ALC ?? "",
            DrawingNo    = r.DrawingNo ?? "",
            PalletQty    = r.PalletQty,
            MaxPalletQty = r.MaxPalletQty,
            ToteFlag     = r.ToteFlag,
            ScanRequired = r.ScanRequired,
            ProcureType  = r.ProcureType ?? "",
            IssueAddPct  = r.IssueAddPct,
            MrpAllowPct  = r.MrpAllowPct,
            ActiveFlag   = r.ActiveFlag,
        };
        try { _uomInUse = MD.ItemUomInUse(r.ItemNo); } catch { _uomInUse = false; }
        _confirmDelete = false; _modalErr = ""; _deleteBlocked = ""; _modal = "edit";
    }

    // 재고·실적이 있는 품목은 기본 단위를 바꿀 수 없다(10-20) — 수정 창의 단위를 끄고, 저장소(UpdateItem)도 거부한다
    bool _uomInUse;

    void CloseModal() { _modal = ""; _modalErr = ""; _confirmDelete = false; _deleteBlocked = ""; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ItemNo))   { _modalErr = L["MD.Items.Err.NoRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.ItemName))  { _modalErr = L["MD.Items.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var no = _f.ItemNo.Trim().ToUpper();
            if (MD.ItemExists(no)) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], no); return; }
            NormalizeCategory();
            MD.InsertItem(no, _f.ItemName.Trim(), N(_f.ItemType),
                N(_f.ItemCategory), InjEnabled && _f.InjFlag, N(_f.CarType), N(_f.Uom), N(_f.RoutingType),
                Nz(_f.MinStock), Nz(_f.MaxStock), Nz(_f.SafetyStock), Nz(_f.UnitCost),
                N(_f.Pgn), N(_f.Alc), N(_f.DrawingNo),
                _f.PalletQty, _f.ToteFlag ? null : _f.MaxPalletQty, _f.ToteFlag,
                _f.ActiveFlag, _actor, _f.ScanRequired, N(_f.ProcureType), _f.IssueAddPct, _f.MrpAllowPct);
            Audit.Created("MD-003", "MD_Item", no, _f);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Items.Ok.Created"].Value, no), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ItemName)) { _modalErr = L["MD.Items.Err.NameRequired"]; return; }
        if (_uomInUse) _f.Uom = _sel?.DefaultUOM ?? _f.Uom;
        _busy = true;
        try
        {
            NormalizeCategory();
            var bomLines = MD.UpdateItem(_f.ItemNo, _f.ItemName.Trim(), N(_f.ItemType),
                N(_f.ItemCategory), InjEnabled && _f.InjFlag, N(_f.CarType), N(_f.Uom), N(_f.RoutingType),
                Nz(_f.MinStock), Nz(_f.MaxStock), Nz(_f.SafetyStock), Nz(_f.UnitCost),
                N(_f.Pgn), N(_f.Alc), N(_f.DrawingNo),
                _f.PalletQty, _f.ToteFlag ? null : _f.MaxPalletQty, _f.ToteFlag,
                _f.ActiveFlag, _actor, _f.ScanRequired, _f.ProcureType ?? "", _f.IssueAddPct ?? 0, _f.MrpAllowPct ?? 0);
            Audit.Updated("MD-003", "MD_Item", _f.ItemNo, _sel, _f);
            if (bomLines > 0)
                Audit.Log("MD-003", "BOM_UOM_SYNC", "MD_Bom", _f.ItemNo, new { CompItemNo = _f.ItemNo, UOM = _sel?.DefaultUOM }, new { CompItemNo = _f.ItemNo, UOM = N(_f.Uom), Lines = bomLines });
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Items.Ok.Updated"].Value, _f.ItemNo)
                    + (bomLines > 0 ? " " + string.Format(L["MD.Items.Ok.BomUomSynced"].Value, bomLines, UomFmt.Sym(N(_f.Uom) ?? "")) : ""), false);
        }
        catch (MasterDataRepository.ItemUomLockedException) { _uomInUse = true; _f.Uom = _sel?.DefaultUOM ?? ""; _modalErr = L["MD.Items.Hint.UomLocked"]; }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    // 확인을 묻기 전에 사용처를 본다 — 사용 중이면 확인 대신 사용처 안내만 보인다(삭제할 때 저장소가 같은 규칙으로 다시 검사)
    void AskDelete()
    {
        if (!_canEdit) return;
        _modalErr = ""; _deleteBlocked = "";
        try
        {
            var usages = MD.ItemUsages(_f.ItemNo);
            if (usages.Count > 0) _deleteBlocked = InUseText(_f.ItemNo, usages);
            else _confirmDelete = true;
        }
        catch (Exception ex) { _modalErr = ex.Message; }
    }

    string InUseText(string key, List<MasterDataRepository.UsageRef> usages)
        => string.Format(L["MD.Items.Err.InUse"].Value, key, AMES.Web.Services.UsageText.Format(L, usages));

    async Task SaveDelete()
    {
        if (!_canEdit) return;
        _busy = true;
        try
        {
            var usages = MD.DeleteItem(_f.ItemNo);
            if (usages.Count > 0)
            {
                _deleteBlocked = InUseText(_f.ItemNo, usages);
                _confirmDelete = false;
                return;
            }
            Audit.Deleted("MD-003", "MD_Item", _f.ItemNo, _sel);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Items.Ok.Deleted"].Value, _f.ItemNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

