@page "/md/fd/items"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject AMES.Web.Services.AuditLogger Audit
@inject IStringLocalizer<SharedResources> L
@inject UomFormat UomFmt
@inject IJSRuntime JS

<PageTitle>MD-003 @L["MD.Items.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-003" TitleKey="MD.Items.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Items.Kpi.Assy"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ItemType == "ASSY")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Items.Kpi.Sub"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ItemType == "SUB")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Items.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Items.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:240px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fTypeFilter" Data="@ItemTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["MD.Items.Col.ProcureType"]" Component="DropDownProcure" />
            <RadzenDropDown Name="DropDownProcure" @bind-Value="_fProcureFilter" Data="@ProcureFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Active"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fActiveOnly" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
            <RadzenButton Text="@L["Excel.Download"]" Icon="download" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ExcelDownload" title="@L["Excel.Download.Hint"]" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Excel.Upload"]" Icon="upload" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => _excelOpen = true)" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.ItemRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Items.Empty"]" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            @* 행 번호 — 정렬·페이지를 반영한 화면상의 순번 *@
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Title="@L["Col.RowNo"]" Width="60px" MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                <Template Context="rn"><span class="dim">@GridRowNo.Of(_pgGrid, rn)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemNo" Title="@L["Col.ItemNo"]" TextAlign="TextAlign.Center" Width="130px">
                <Template Context="item"><span class="code">@item.ItemNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemName" Title="@L["Col.ItemName"]" />
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemType" Title="@L["Col.Type"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item"><span class="pill info">@(item.ItemType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemCategory" Title="@L["Col.Category"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="item"><span class="dim">@CategoryName(item.ItemCategory)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ProcureType" Title="@L["MD.Items.Col.ProcureType"]" TextAlign="TextAlign.Center" Width="140px">
                <Template Context="item">@ProcureName(item.ProcureType)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="InjFlag" Title="@L["MD.Items.Col.Inj"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item">
                    @if (item.InjFlag) { <RadzenIcon Icon="check_circle" Style="color:var(--ames-tx-green-400);vertical-align:middle;" /> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="CarType" Title="@L["Col.CarType"]" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="item"><span class="code dim">@(item.CarType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="PGN" Title="@L["Col.PGN"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="item"><span class="code dim">@(item.PGN ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ALC" Title="@L["Col.ALC"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item"><span class="code dim">@(item.ALC ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="DefaultUOM" Title="@L["Col.Uom"]" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="item"><span class="code dim">@UomFmt.Sym(item.DefaultUOM)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="RoutingType" Title="@L["Col.Routing"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item"><span class="pill @Ui.RoutingClass(item.RoutingType)">@(item.RoutingType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="SafetyStock" Title="@L["Col.Safety"]" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="item">@UomFmt.Qty(item.SafetyStock, item.DefaultUOM)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="MinStock" Title="@L["Col.MinStock"]" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="item">@UomFmt.Qty(item.MinStock, item.DefaultUOM)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="MaxStock" Title="@L["Col.MaxStock"]" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="item">@UomFmt.Qty(item.MaxStock, item.DefaultUOM)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="UnitCost" Title="@L["Col.UnitPrice"]" TextAlign="TextAlign.Right" Width="150px">
                <Template Context="item">@(item.UnitCost?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="IssueAddPct" Title="@L["MD.Items.Col.IssueAddPct"]" TextAlign="TextAlign.Right" Width="150px">
                <Template Context="item">@Pct(item.IssueAddPct)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="MrpAllowPct" Title="@L["MD.Items.Col.MrpAllowPct"]" TextAlign="TextAlign.Right" Width="150px">
                <Template Context="item">@Pct(item.MrpAllowPct)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="PalletQty" Title="@L["MD.Items.Col.PalletQty"]" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="item">@(item.PalletQty?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="MaxPalletQty" Title="@L["MD.Items.Col.MaxPalletQty"]" TextAlign="TextAlign.Right" Width="130px">
                <Template Context="item">@(item.MaxPalletQty?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ToteFlag" Title="@L["MD.Items.Col.Tote"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="item">
                    @if (item.ToteFlag) { <RadzenIcon Icon="check_circle" Style="color:var(--ames-tx-green-400);vertical-align:middle;" /> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ScanRequired" Title="@L["MD.Items.ScanRequired"]" TextAlign="TextAlign.Center" Width="170px">
                <Template Context="item">
                    @if (item.ScanRequired) { <RadzenIcon Icon="check_circle" Style="color:var(--ames-tx-green-400);vertical-align:middle;" /> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="SAPFlag" Title="@L["Col.Sap"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="item">
                    @if (item.SAPFlag) { <RadzenIcon Icon="check_circle" Style="color:var(--ames-tx-green-400);vertical-align:middle;" /> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ActiveFlag" Title="@L["Col.Active"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item">
                    @if (item.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_excelOpen)
{
    <ExcelImportModal Title="@L["MD.Items.Title"]" Parse="@ExcelParse" Apply="@ExcelApply" ColumnLabel="@ExcelLabel" OnClose="@ExcelClosed" />
}

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Items.Title"] — @L["Modal.Create"]</div>

            <RadzenRow Gap="8px">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@(L["MD.Items.Lbl.ItemNo"] + "  " + L["MD.Items.Lbl.ItemNoHint"])' />
                    <RadzenTextBox @bind-Value="_f.ItemNo" MaxLength="20" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@(L["MD.Items.Lbl.Uom"] + " (UOM)")' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.Uom" Data="@UomOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @ItemFormFields()

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Items.Title"] — @L["Modal.Edit"] <span class="code" style="font-weight:400;font-size:.9em;">@_f.ItemNo</span>@if (_sel?.SAPFlag == true) { <span class="pill info" style="margin-left:6px;font-size:.72em;" title="@L["Lbl.SapData"]">SAP</span> }</div>

            <RadzenRow Gap="8px">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Items.Lbl.ItemNo"]" />
                    <RadzenTextBox Value="@_f.ItemNo" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@(L["MD.Items.Lbl.Uom"] + " (UOM)")' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.Uom" Data="@UomOptions" TextProperty="Text" ValueProperty="Value" Disabled="@_uomInUse" title="@(_uomInUse ? L["MD.Items.Hint.UomLocked"].Value : "")" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    @if (_uomInUse)
                    {
                        <div class="dim" style="font-size:.78em;margin-top:2px;">🔒 @L["MD.Items.Hint.UomLocked"]</div>
                    }
                    else
                    {
                        <div class="dim" style="font-size:.78em;margin-top:2px;">@L["MD.Items.Hint.UomSyncsBom"]</div>
                    }
                </RadzenColumn>
            </RadzenRow>

            @ItemFormFields()

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.Items.ConfirmDelete"].Value, _f.ItemNo, _f.ItemName)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }
            else if (!string.IsNullOrEmpty(_deleteBlocked))
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@_deleteBlocked</span>
                    <RadzenButton Text="@L["Btn.Close"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _deleteBlocked = ""' class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click="@AskDelete" Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    bool _showPagerSummary = true;
    int  _pageRows = 25;   // 고정 페이저: 본문 높이 = 헤더 + 페이지 행 수 × 행 높이(.ames-grid-fixed)
    List<MasterDataRepository.ItemRow>        _allRows      = new();
    List<MasterDataRepository.ItemRow>        _rows         = new();
    List<MasterDataRepository.CodeItemRow>    _itemTypeItems = new();
    List<MasterDataRepository.CodeItemRow>    _categoryItems = new();
    List<MasterDataRepository.CodeItemRow>    _routingItems  = new();
    List<MasterDataRepository.CodeItemRow>    _procureItems  = new();
    List<MasterDataRepository.CodeItemRow>    _activeFlagItems = new();
    List<MasterDataRepository.UomRow> _uomList = new();
    MasterDataRepository.ItemRow? _sel;

    string  _fSearch     = "";
    string? _fTypeFilter, _fProcureFilter, _fActiveOnly;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    string _deleteBlocked = "";
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();
    
    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ItemTypeOptions => _itemTypeItems.Where(t => t.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    // 카테고리는 ITEM_CATEGORY 의 Attribute1(품목 유형, 쉼표로 여러 개)이 현재 유형과 맞는 코드만 고를 수 있다.
    // 공통코드에 없는 기존 값(자유 입력 시절 데이터)은 수정 중인 행의 값만 옵션에 남겨 저장 때 지워지지 않게 한다
    private IEnumerable<DropDownItem> CategoryOptions
    {
        get
        {
            var opts = CategoriesFor(_f.ItemType).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" }).ToList();
            if (!string.IsNullOrEmpty(_f.ItemCategory) && !opts.Any(o => o.Value == _f.ItemCategory))
                opts.Add(new DropDownItem { Value = _f.ItemCategory, Text = $"[{_f.ItemCategory}] {L["MD.Items.Opt.Unregistered"]}" });
            return opts;
        }
    }
    bool CategoryEnabled => CategoriesFor(_f.ItemType).Any();

    IEnumerable<MasterDataRepository.CodeItemRow> CategoriesFor(string? itemType) =>
        string.IsNullOrEmpty(itemType) ? [] :
        _categoryItems.Where(c => c.UseFlag && (c.Attribute1 ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                                                 .Contains(itemType, StringComparer.OrdinalIgnoreCase));

    // 등록된 카테고리 코드가 새 유형에서 쓸 수 없으면 비운다(기존 자유 입력 값은 그대로 둔다)
    void NormalizeCategory()
    {
        if (string.IsNullOrEmpty(_f.ItemCategory)) return;
        bool registered = _categoryItems.Any(c => c.CodeValue == _f.ItemCategory);
        if (registered && !CategoriesFor(_f.ItemType).Any(c => c.CodeValue == _f.ItemCategory))
            _f.ItemCategory = "";
    }
    // 사출품 여부는 SUB 유형만 지정한다 — 유형을 바꾸면 끈다(저장 때도 MasterDataRepository.NormalizeInjFlag 가 같은 규칙)
    bool InjEnabled => string.Equals(_f.ItemType, MasterDataRepository.ItemTypeSub, StringComparison.OrdinalIgnoreCase);

    void OnItemTypeChanged()
    {
        NormalizeCategory();
        if (!InjEnabled) _f.InjFlag = false;
    }
    // 조달형태: 공통코드 PROCURE_TYPE — 사용 안 함 코드·공통코드에 없는 값은 수정 중인 행의 값일 때만 남겨 저장 때 지워지지 않게 한다
    private IEnumerable<DropDownItem> ProcureOptions
    {
        get
        {
            var opts = _procureItems.Where(c => c.UseFlag || c.CodeValue == _f.ProcureType).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" }).ToList();
            if (!string.IsNullOrEmpty(_f.ProcureType) && !opts.Any(o => o.Value == _f.ProcureType))
                opts.Add(new DropDownItem { Value = _f.ProcureType, Text = $"[{_f.ProcureType}] {L["MD.Items.Opt.Unregistered"]}" });
            return opts;
        }
    }
    private IEnumerable<DropDownItem> ProcureFilterOptions => _procureItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = MasterDataRepository.LocalName(c) });
    private IEnumerable<DropDownItem> RoutingOptions => _routingItems.Where(r => r.UseFlag).Select(r => new DropDownItem { Value = r.CodeValue ?? "", Text = $"[{r.CodeValue}] {MasterDataRepository.LocalName(r)}" });
    private IEnumerable<DropDownItem> UomOptions => _uomList.Where(u => u.ActiveFlag && MasterDataRepository.IsQuantityUnit(u.UOMCode)).Select(u => new DropDownItem { Value = u.UOMCode ?? "", Text = u.UOMCode + (string.IsNullOrEmpty(u.UOMName) ? "" : $"  ({u.UOMName})") });
    // 상태 필터: 공통코드 ACTIVE_FLAG (ACTIVE/INACTIVE)
    private IEnumerable<DropDownItem> ActiveFilterOptions =>
        _activeFlagItems.Where(a => a.UseFlag).Select(a => new DropDownItem { Value = a.CodeValue ?? "", Text = MasterDataRepository.LocalName(a) });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = AMES.Web.Services.ActorCode.Of(auth.User, "system");
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/fd/items");
        try { _itemTypeItems = MD.ListCodeItems("ITEM_TYPE"); } catch { }
        try { _categoryItems = MD.ListCodeItems("ITEM_CATEGORY"); } catch { }
        try { _routingItems = MD.ListCodeItems("ROUTING"); } catch { }
        try { _procureItems = MD.ListCodeItems(MasterDataRepository.ProcureTypeGroup); } catch { }
        try { _activeFlagItems = MD.ListCodeItems("ACTIVE_FLAG"); } catch { }
        try { _uomList = MD.ListUoms(); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.ItemRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { try { _allRows = MD.ListItems(""); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter()
    {
        _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.ItemNo.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            r.ItemName.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CarType ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.PGN ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ALC ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fTypeFilter) || r.ItemType == _fTypeFilter) &&
        (string.IsNullOrEmpty(_fProcureFilter) || r.ProcureType == _fProcureFilter) &&
        (string.IsNullOrEmpty(_fActiveOnly) || (_fActiveOnly == "ACTIVE" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    private void RowRender(RowRenderEventArgs<MasterDataRepository.ItemRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.ItemRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
