@page "/md/fd/items"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject MasterDataRepository Md
@inject SysRepository Sys
@inject IHttpContextAccessor HttpCtxAccessor
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using System.Text.Json
@using Radzen

<PageTitle>MD-003 @L["MD.Items.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allItems.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Items.Kpi.FG"]</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ItemType == "FG")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Items.Kpi.WIP"]</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ItemType == "WIP")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Items.List"] · @_items.Count @L["Lbl.Items"]@(_items.Count < _allItems.Count ? $" / 전체 {_allItems.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder="@L["MD.Items.Ph.Search"]"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' />
            <RadzenLabel Text="@L["Col.Type"]" />
            <RadzenDropDown @bind-Value="_fTypeFilter" Data="@ItemTypeOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllTypes"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenLabel Text="@L["Col.Status"]" />
            <RadzenDropDown @bind-Value="_fActiveOnly" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.All"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.ItemRow"
                    Data="@_items"
                    AllowPaging="true" PageSize="15"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    RowRender="@ItemRowRender"
                    RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data); })"
                    EmptyText="@L["MD.Items.Empty"]"
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemNo" Title="@L["Col.ItemNo"]" Width="130px">
                <Template Context="item"><span class="code">@item.ItemNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemName" Title="@L["Col.ItemName"]" />
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemNameEN" Title="@L["Col.NameEn"]">
                <Template Context="item"><span class="dim">@item.ItemNameEN</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemType" Title="@L["Col.Type"]" Width="90px">
                <Template Context="item"><span class="pill info">@(item.ItemType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemCategory" Title="@L["Col.Category"]" Width="110px">
                <Template Context="item"><span class="dim">@item.ItemCategory</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="DefaultUOM" Title="@L["Col.Uom"]" Width="60px">
                <Template Context="item"><span class="code dim">@item.DefaultUOM</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="RoutingType" Title="@L["Col.Routing"]" Width="70px">
                <Template Context="item"><span class="code dim">@(item.RoutingType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="SafetyStock" Title="@L["Col.Safety"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="item">@(item.SafetyStock?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="MinStock" Title="@L["Col.MinStock"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="item">@(item.MinStock?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="MaxStock" Title="@L["Col.MaxStock"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="item">@(item.MaxStock?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="UnitCost" Title="@L["Col.UnitPrice"]" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="item">@(item.UnitCost?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ActiveFlag" Title="@L["Col.Active"]" Width="52px" TextAlign="TextAlign.Center">
                <Template Context="item">
                    <span class="pill @(item.ActiveFlag ? "ok" : "dim")">@(item.ActiveFlag ? "Y" : "N")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── 등록 모달 ──────────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:680px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Items.Modal.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@(L["MD.Items.Lbl.ItemNo"] + "  " + L["MD.Items.Lbl.ItemNoHint"])' />
                    <RadzenTextBox @bind-Value="_fItemNo" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@(L["MD.Items.Lbl.Uom"] + " (UOM)")' />
                    <RadzenDropDown @bind-Value="_fUom" Data="@UomOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            @ItemFormFields()

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 수정/삭제 모달 ─────────────────────────────────────────────────── *@
@if (_modal == "edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:680px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Items.Modal.Edit"] — <span class="code" style="font-weight:400;font-size:.9em;">@_fItemNo</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["MD.Items.Lbl.ItemNo"]" />
                    <RadzenTextBox Value="@_fItemNo" Disabled="true"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@(L["MD.Items.Lbl.Uom"] + " (UOM)")' />
                    <RadzenDropDown @bind-Value="_fUom" Data="@UomOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            @ItemFormFields()

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.Items.ConfirmDelete"].Value, _fItemNo, _fItemName)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.ItemRow>        _allItems      = new();
    List<MasterDataRepository.ItemRow>        _items         = new();
    List<MasterDataRepository.CodeItemRow>    _itemTypeItems = new();
    List<MasterDataRepository.CodeItemRow>    _routingItems  = new();
    List<MasterDataRepository.UomRow>         _uomList       = new();
    string  _fSearch     = "";
    string? _fTypeFilter;
    string? _fActiveOnly;

    readonly IEnumerable<int> _pageSizeOptions = new[] { 15, 30, 50, 100 };

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ItemTypeOptions =>
        _itemTypeItems.Where(t => t.UseFlag)
            .Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });

    private IEnumerable<DropDownItem> RoutingOptions =>
        _routingItems.Where(r => r.UseFlag)
            .Select(r => new DropDownItem { Value = r.CodeValue ?? "", Text = $"[{r.CodeValue}] {MasterDataRepository.LocalName(r)}" });

    private IEnumerable<DropDownItem> UomOptions =>
        _uomList.Where(u => u.ActiveFlag)
            .Select(u => new DropDownItem { Value = u.UOMCode ?? "", Text = u.UOMCode + (string.IsNullOrEmpty(u.UOMName) ? "" : $"  ({u.UOMName})") });

    private IEnumerable<DropDownItem> ActiveFilterOptions => new[]
    {
        new DropDownItem { Value = "Y", Text = L["Lbl.Use.On"].Value },
        new DropDownItem { Value = "N", Text = L["Lbl.Use.Off"].Value },
    };

    private void ItemRowRender(RowRenderEventArgs<MasterDataRepository.ItemRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }
    string _modal         = "";
    string _modalErr      = "";
    string _msg           = "";
    bool   _isErr, _busy, _bgDown, _confirmDelete;
    bool   _canEdit;
    string _actor     = "system";
    string _clientIp  = "";
    MasterDataRepository.ItemRow? _sel;

    // ── Form fields ──────────────────────────────────────────────────────
    string  _fItemNo       = "";
    string  _fItemName     = "";
    string  _fItemNameEn   = "";
    string  _fItemType     = "";
    string  _fItemCategory = "";
    string  _fUom          = "";
    string  _fRoutingType  = "";
    decimal _fMinStock     = 0;
    decimal _fMaxStock     = 0;
    decimal _fSafetyStock  = 0;
    decimal _fUnitCost     = 0;
    string  _fCustSav      = "";
    string  _fCustGeo      = "";
    string  _fDrawingNo    = "";
    bool    _fActiveFlag   = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor   = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/fd/items");
        // HttpContext is available during the prerender (HTTP) phase; null after WebSocket handoff.
        _clientIp = ToIpv4(HttpCtxAccessor.HttpContext?.Connection.RemoteIpAddress);
        try { _itemTypeItems = Md.ListCodeItems("ITEM_TYPE"); } catch { }
        try { _routingItems  = Md.ListCodeItems("ROUTING"); }   catch { }
        try { _uomList       = Md.ListUoms(); }                  catch { }
        Reload();
    }

    void Reload() { try { _allItems = Md.ListItems(""); } catch { _allItems = new(); } ApplyFilter(); }

    void ApplyFilter() { _items = _allItems.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.ItemNo.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            r.ItemName.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemNameEN ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fTypeFilter) || r.ItemType == _fTypeFilter) &&
        (string.IsNullOrEmpty(_fActiveOnly) || (_fActiveOnly == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    void CloseModal() { _modal = ""; _modalErr = ""; _confirmDelete = false; }
    void OnBgDown()  => _bgDown = true;
    void OnBgClick() { if (_bgDown) CloseModal(); _bgDown = false; }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    void OpenCreate()
    {
        _fItemNo = ""; _fItemName = ""; _fItemNameEn = ""; _fItemType = "";
        _fItemCategory = ""; _fUom = ""; _fRoutingType = "";
        _fMinStock = 0; _fMaxStock = 0; _fSafetyStock = 0; _fUnitCost = 0;
        _fCustSav = ""; _fCustGeo = ""; _fDrawingNo = ""; _fActiveFlag = true;
        _confirmDelete = false; _modalErr = ""; _modal = "create";
    }

    void OpenEdit(MasterDataRepository.ItemRow r)
    {
        if (!_canEdit) return;
        _sel           = r;
        _fItemNo       = r.ItemNo;
        _fItemName     = r.ItemName;
        _fItemNameEn   = r.ItemNameEN      ?? "";
        _fItemType     = r.ItemType        ?? "";
        _fItemCategory = r.ItemCategory    ?? "";
        _fUom          = r.DefaultUOM      ?? "";
        _fRoutingType  = r.RoutingType     ?? "";
        _fMinStock     = r.MinStock        ?? 0;
        _fMaxStock     = r.MaxStock        ?? 0;
        _fSafetyStock  = r.SafetyStock     ?? 0;
        _fUnitCost     = r.UnitCost        ?? 0;
        _fCustSav      = r.CustItemNoSAV   ?? "";
        _fCustGeo      = r.CustItemNoGEO   ?? "";
        _fDrawingNo    = r.DrawingNo       ?? "";
        _fActiveFlag   = r.ActiveFlag;
        _confirmDelete = false; _modalErr = ""; _modal = "edit";
    }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fItemNo))   { _modalErr = L["MD.Items.Err.NoRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fItemName))  { _modalErr = L["MD.Items.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var no = _fItemNo.Trim().ToUpper();
            if (Md.ItemExists(no)) { _modalErr = $"'{no}' 품목번호가 {L["Err.AlreadyExists"]}"; return; }
            Md.InsertItem(no, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                N(_fItemCategory), N(_fUom), N(_fRoutingType),
                Nz(_fMinStock), Nz(_fMaxStock), Nz(_fSafetyStock), Nz(_fUnitCost),
                N(_fCustSav), N(_fCustGeo), N(_fDrawingNo), _fActiveFlag, _actor);
            Sys.InsertAuditLog("MD", "MD-003", "CREATE", "MD_Item", no,
                null, ItemJson(no, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                    N(_fItemCategory), N(_fUom), _fActiveFlag),
                _actor, _clientIp,
                note: $"Created MD_Item '{no}' (ItemName='{_fItemName.Trim()}'" +
                      $", Type='{N(_fItemType) ?? "-"}', UOM='{N(_fUom) ?? "-"}') by '{_actor}'");
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Items.Ok.Created"].Value, no), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fItemName)) { _modalErr = L["MD.Items.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var beforeJson = _sel is null ? null : ItemJson(
                _sel.ItemNo, _sel.ItemName, _sel.ItemNameEN, _sel.ItemType,
                _sel.ItemCategory, _sel.DefaultUOM, _sel.ActiveFlag);
            Md.UpdateItem(_fItemNo, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                N(_fItemCategory), N(_fUom), N(_fRoutingType),
                Nz(_fMinStock), Nz(_fMaxStock), Nz(_fSafetyStock), Nz(_fUnitCost),
                N(_fCustSav), N(_fCustGeo), N(_fDrawingNo), _fActiveFlag, _actor);
            Sys.InsertAuditLog("MD", "MD-003", "UPDATE", "MD_Item", _fItemNo,
                beforeJson, ItemJson(_fItemNo, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                    N(_fItemCategory), N(_fUom), _fActiveFlag),
                _actor, _clientIp,
                note: $"Updated MD_Item '{_fItemNo}' (ItemName='{_fItemName.Trim()}'" +
                      $", Type='{N(_fItemType) ?? "-"}', UOM='{N(_fUom) ?? "-"}'," +
                      $" Active={_fActiveFlag}) by '{_actor}'");
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Items.Ok.Updated"].Value, _fItemNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        _busy = true;
        try
        {
            var beforeJson = _sel is null ? null : ItemJson(
                _sel.ItemNo, _sel.ItemName, _sel.ItemNameEN, _sel.ItemType,
                _sel.ItemCategory, _sel.DefaultUOM, _sel.ActiveFlag);
            Md.DeleteItem(_fItemNo);
            Sys.InsertAuditLog("MD", "MD-003", "DELETE", "MD_Item", _fItemNo,
                beforeJson, null,
                _actor, _clientIp,
                note: $"Deleted MD_Item '{_fItemNo}'" +
                      $" (ItemName='{_sel?.ItemName ?? "-"}', Type='{_sel?.ItemType ?? "-"}') by '{_actor}'");
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Items.Ok.Deleted"].Value, _fItemNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    static string ItemJson(string itemNo, string itemName, string? itemNameEn,
        string? itemType, string? itemCategory, string? uom, bool activeFlag)
        => JsonSerializer.Serialize(new
        {
            ItemNo       = itemNo,
            ItemName     = itemName,
            ItemNameEN   = itemNameEn,
            ItemType     = itemType,
            ItemCategory = itemCategory,
            DefaultUOM   = uom,
            ActiveFlag   = activeFlag
        });

    RenderFragment ItemFormFields() =>
    @<div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.ItemName"]" />
                <RadzenTextBox @bind-Value="_fItemName" AutoComplete="false"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.ItemNameEn"]" />
                <RadzenTextBox @bind-Value="_fItemNameEn" AutoComplete="false"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.ItemType"]" />
                <RadzenDropDown @bind-Value="_fItemType" Data="@ItemTypeOptions" TextProperty="Text" ValueProperty="Value"
                                Placeholder="@L["Opt.Select"]"
                                InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.Category"]" />
                <RadzenTextBox @bind-Value="_fItemCategory" Placeholder="예: BUMPER, DOOR" AutoComplete="false"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
            <div>
                <RadzenLabel Text="Routing" />
                <RadzenDropDown @bind-Value="_fRoutingType" Data="@RoutingOptions" TextProperty="Text" ValueProperty="Value"
                                Placeholder="@L["Opt.Select"]"
                                InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.SafetyStock"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_fSafetyStock" Min="0" Step="0.0001m"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.MinStock"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_fMinStock" Min="0" Step="0.0001m"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.MaxStock"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_fMaxStock" Min="0" Step="0.0001m"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.UnitCost"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_fUnitCost" Min="0" Step="0.01m"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.CustSav"]" />
                <RadzenTextBox @bind-Value="_fCustSav" AutoComplete="false"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
            <div>
                <RadzenLabel Text="@L["MD.Items.Lbl.CustGeo"]" />
                <RadzenTextBox @bind-Value="_fCustGeo" AutoComplete="false"
                               InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </div>
        </div>

        <RadzenLabel Text="@L["MD.Items.Lbl.DrawingNo"]" Style="margin-top:6px;" />
        <RadzenTextBox @bind-Value="_fDrawingNo" AutoComplete="false"
                       InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />

        <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
            <RadzenCheckBox TValue="bool" @bind-Value="_fActiveFlag" />
            @L["Lbl.Use.On"]
        </label>
    </div>;

    static string? N(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    static decimal? Nz(decimal v) => v == 0 ? null : v;

    static string ToIpv4(System.Net.IPAddress? ip)
    {
        if (ip is null) return "";
        if (ip.IsIPv4MappedToIPv6) return ip.MapToIPv4().ToString();
        if (ip.Equals(System.Net.IPAddress.IPv6Loopback)) return "127.0.0.1";
        return ip.ToString();
    }
}