@page "/md/fd/items"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject MasterDataRepository Md
@inject SysRepository Sys
@inject IHttpContextAccessor HttpCtxAccessor
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using System.Text.Json

<PageTitle>@L["MD.Items.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-003" TitleKey="MD.Items.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allItems.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Items.Kpi.FG"]</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ItemType == "FG")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Items.Kpi.WIP"]</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ItemType == "WIP")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Items.List"] · @_items.Count @L["Lbl.Items"]@(_items.Count < _allItems.Count ? $" / 전체 {_allItems.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:200px;padding:4px 8px;"
                   placeholder="@L["MD.Items.Ph.Search"]" @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:130px;" @bind="_fTypeFilter">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _itemTypeItems.Where(t => t.UseFlag))
                { <option value="@t.CodeValue">[@t.CodeValue] @MasterDataRepository.LocalName(t)</option> }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:100px;" @bind="_fActiveOnly">
                <option value="">@L["Filter.All"]</option>
                <option value="Y">@L["Lbl.Use.On"]</option>
                <option value="N">@L["Lbl.Use.Off"]</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_items.Count == 0)
    {
        <div class="ames-empty">@L["MD.Items.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th style="width:130px;">@L["Col.ItemNo"]</th>
                    <th>@L["Col.ItemName"]</th>
                    <th>@L["Col.NameEn"]</th>
                    <th style="width:90px;">@L["Col.Type"]</th>
                    <th style="width:110px;">@L["Col.Category"]</th>
                    <th style="width:60px;">@L["Col.Uom"]</th>
                    <th style="width:60px;">@L["Col.Routing"]</th>
                    <th style="width:80px;text-align:right;">@L["Col.Safety"]</th>
                    <th style="width:80px;text-align:right;">@L["Col.MinStock"]</th>
                    <th style="width:80px;text-align:right;">@L["Col.MaxStock"]</th>
                    <th style="width:90px;text-align:right;">@L["Col.UnitPrice"]</th>
                    <th style="width:48px;text-align:center;">@L["Col.Active"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items.Skip(_page * _pageSize).Take(_pageSize))
                {
                    var cap = item;
                    <tr class="ames-row-link" @onclick="() => OpenEdit(cap)">
                        <td class="code">@item.ItemNo</td>
                        <td>@item.ItemName</td>
                        <td class="dim">@item.ItemNameEN</td>
                        <td><span class="pill info">@(item.ItemType ?? "—")</span></td>
                        <td class="dim">@item.ItemCategory</td>
                        <td class="code dim">@item.DefaultUOM</td>
                        <td class="code dim">@(item.RoutingType ?? "—")</td>
                        <td style="text-align:right;">@(item.SafetyStock?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(item.MinStock?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(item.MaxStock?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(item.UnitCost?.ToString("N0") ?? "—")</td>
                        <td style="text-align:center;">
                            <span class="pill @(item.ActiveFlag ? "ok" : "dim")">@(item.ActiveFlag ? "Y" : "N")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_items.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── 등록 모달 ──────────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:680px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Items.Modal.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>@L["MD.Items.Lbl.ItemNo"] <span class="dim" style="font-size:.82em;">@L["MD.Items.Lbl.ItemNoHint"]</span></label>
                    <input class="ames-input" @bind="_fItemNo" maxlength="20" autocomplete="off" />
                </div>
                <div>
                    <label>@L["MD.Items.Lbl.Uom"] <span class="dim" style="font-size:.82em;">(UOM)</span></label>
                    <select class="ames-input" @bind="_fUom">
                        <option value="">@L["Opt.Select"]</option>
                        @foreach (var u in _uomList.Where(u => u.ActiveFlag))
                        { <option value="@u.UOMCode">@u.UOMCode@(string.IsNullOrEmpty(u.UOMName) ? "" : $"  ({u.UOMName})")</option> }
                    </select>
                </div>
            </div>

            @ItemFormFields()

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">
                    @(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)
                </button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── 수정/삭제 모달 ─────────────────────────────────────────────────── *@
@if (_modal == "edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:680px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Items.Modal.Edit"] — <span class="code" style="font-weight:400;font-size:.9em;">@_fItemNo</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>@L["MD.Items.Lbl.ItemNo"]</label>
                    <input class="ames-input" value="@_fItemNo" disabled />
                </div>
                <div>
                    <label>@L["MD.Items.Lbl.Uom"] <span class="dim" style="font-size:.82em;">(UOM)</span></label>
                    <select class="ames-input" @bind="_fUom">
                        <option value="">@L["Opt.Select"]</option>
                        @foreach (var u in _uomList.Where(u => u.ActiveFlag))
                        { <option value="@u.UOMCode">@u.UOMCode@(string.IsNullOrEmpty(u.UOMName) ? "" : $"  ({u.UOMName})")</option> }
                    </select>
                </div>
            </div>

            @ItemFormFields()

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@string.Format(L["MD.Items.ConfirmDelete"].Value, _fItemNo, _fItemName)</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">
                        @(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveEdit" disabled="@_busy">
                    @(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)
                </button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    int _page = 0;
    const int _pageSize = 20;
    List<MasterDataRepository.ItemRow>        _allItems      = new();
    List<MasterDataRepository.ItemRow>        _items         = new();
    List<MasterDataRepository.CodeItemRow>    _itemTypeItems = new();
    List<MasterDataRepository.CodeItemRow>    _routingItems  = new();
    List<MasterDataRepository.UomRow>         _uomList       = new();
    string _fSearch       = "";
    string _fTypeFilter   = "";
    string _fActiveOnly   = "";
    string _modal         = "";
    string _modalErr      = "";
    string _msg           = "";
    bool   _isErr, _busy, _bgDown, _confirmDelete;
    bool   _canEdit;
    string _actor     = "system";
    string _clientIp  = "";
    MasterDataRepository.ItemRow? _sel;

    // ── Form fields ──────────────────────────────────────────────────────
    string  _fItemNo       = "";
    string  _fItemName     = "";
    string  _fItemNameEn   = "";
    string  _fItemType     = "";
    string  _fItemCategory = "";
    string  _fUom          = "";
    string  _fRoutingType  = "";
    decimal _fMinStock     = 0;
    decimal _fMaxStock     = 0;
    decimal _fSafetyStock  = 0;
    decimal _fUnitCost     = 0;
    string  _fCustSav      = "";
    string  _fCustGeo      = "";
    string  _fDrawingNo    = "";
    bool    _fActiveFlag   = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor   = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/fd/items");
        // HttpContext is available during the prerender (HTTP) phase; null after WebSocket handoff.
        _clientIp = ToIpv4(HttpCtxAccessor.HttpContext?.Connection.RemoteIpAddress);
        try { _itemTypeItems = Md.ListCodeItems("ITEM_TYPE"); } catch { }
        try { _routingItems  = Md.ListCodeItems("ROUTING"); }   catch { }
        try { _uomList       = Md.ListUoms(); }                  catch { }
        Reload();
    }

    void Reload() { try { _allItems = Md.ListItems(""); } catch { _allItems = new(); } ApplyFilter(); }

    void ApplyFilter() { _page = 0; _items = _allItems.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.ItemNo.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            r.ItemName.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemNameEN ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fTypeFilter) || r.ItemType == _fTypeFilter) &&
        (string.IsNullOrEmpty(_fActiveOnly) || (_fActiveOnly == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    void CloseModal() { _modal = ""; _modalErr = ""; _confirmDelete = false; }
    void OnBgDown()  => _bgDown = true;
    void OnBgClick() { if (_bgDown) CloseModal(); _bgDown = false; }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    void OpenCreate()
    {
        _fItemNo = ""; _fItemName = ""; _fItemNameEn = ""; _fItemType = "";
        _fItemCategory = ""; _fUom = ""; _fRoutingType = "";
        _fMinStock = 0; _fMaxStock = 0; _fSafetyStock = 0; _fUnitCost = 0;
        _fCustSav = ""; _fCustGeo = ""; _fDrawingNo = ""; _fActiveFlag = true;
        _confirmDelete = false; _modalErr = ""; _modal = "create";
    }

    void OpenEdit(MasterDataRepository.ItemRow r)
    {
        if (!_canEdit) return;
        _sel           = r;
        _fItemNo       = r.ItemNo;
        _fItemName     = r.ItemName;
        _fItemNameEn   = r.ItemNameEN      ?? "";
        _fItemType     = r.ItemType        ?? "";
        _fItemCategory = r.ItemCategory    ?? "";
        _fUom          = r.DefaultUOM      ?? "";
        _fRoutingType  = r.RoutingType     ?? "";
        _fMinStock     = r.MinStock        ?? 0;
        _fMaxStock     = r.MaxStock        ?? 0;
        _fSafetyStock  = r.SafetyStock     ?? 0;
        _fUnitCost     = r.UnitCost        ?? 0;
        _fCustSav      = r.CustItemNoSAV   ?? "";
        _fCustGeo      = r.CustItemNoGEO   ?? "";
        _fDrawingNo    = r.DrawingNo       ?? "";
        _fActiveFlag   = r.ActiveFlag;
        _confirmDelete = false; _modalErr = ""; _modal = "edit";
    }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fItemNo))   { _modalErr = L["MD.Items.Err.NoRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fItemName))  { _modalErr = L["MD.Items.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var no = _fItemNo.Trim().ToUpper();
            if (Md.ItemExists(no)) { _modalErr = $"'{no}' 품목번호가 {L["Err.AlreadyExists"]}"; return; }
            Md.InsertItem(no, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                N(_fItemCategory), N(_fUom), N(_fRoutingType),
                Nz(_fMinStock), Nz(_fMaxStock), Nz(_fSafetyStock), Nz(_fUnitCost),
                N(_fCustSav), N(_fCustGeo), N(_fDrawingNo), _fActiveFlag, _actor);
            Sys.InsertAuditLog("MD", "MD-003", "CREATE", "MD_Item", no,
                null, ItemJson(no, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                    N(_fItemCategory), N(_fUom), _fActiveFlag),
                _actor, _clientIp,
                note: $"Created MD_Item '{no}' (ItemName='{_fItemName.Trim()}'" +
                      $", Type='{N(_fItemType) ?? "-"}', UOM='{N(_fUom) ?? "-"}') by '{_actor}'");
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Items.Ok.Created"].Value, no), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fItemName)) { _modalErr = L["MD.Items.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var beforeJson = _sel is null ? null : ItemJson(
                _sel.ItemNo, _sel.ItemName, _sel.ItemNameEN, _sel.ItemType,
                _sel.ItemCategory, _sel.DefaultUOM, _sel.ActiveFlag);
            Md.UpdateItem(_fItemNo, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                N(_fItemCategory), N(_fUom), N(_fRoutingType),
                Nz(_fMinStock), Nz(_fMaxStock), Nz(_fSafetyStock), Nz(_fUnitCost),
                N(_fCustSav), N(_fCustGeo), N(_fDrawingNo), _fActiveFlag, _actor);
            Sys.InsertAuditLog("MD", "MD-003", "UPDATE", "MD_Item", _fItemNo,
                beforeJson, ItemJson(_fItemNo, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                    N(_fItemCategory), N(_fUom), _fActiveFlag),
                _actor, _clientIp,
                note: $"Updated MD_Item '{_fItemNo}' (ItemName='{_fItemName.Trim()}'" +
                      $", Type='{N(_fItemType) ?? "-"}', UOM='{N(_fUom) ?? "-"}'," +
                      $" Active={_fActiveFlag}) by '{_actor}'");
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Items.Ok.Updated"].Value, _fItemNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        _busy = true;
        try
        {
            var beforeJson = _sel is null ? null : ItemJson(
                _sel.ItemNo, _sel.ItemName, _sel.ItemNameEN, _sel.ItemType,
                _sel.ItemCategory, _sel.DefaultUOM, _sel.ActiveFlag);
            Md.DeleteItem(_fItemNo);
            Sys.InsertAuditLog("MD", "MD-003", "DELETE", "MD_Item", _fItemNo,
                beforeJson, null,
                _actor, _clientIp,
                note: $"Deleted MD_Item '{_fItemNo}'" +
                      $" (ItemName='{_sel?.ItemName ?? "-"}', Type='{_sel?.ItemType ?? "-"}') by '{_actor}'");
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Items.Ok.Deleted"].Value, _fItemNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    static string ItemJson(string itemNo, string itemName, string? itemNameEn,
        string? itemType, string? itemCategory, string? uom, bool activeFlag)
        => JsonSerializer.Serialize(new
        {
            ItemNo       = itemNo,
            ItemName     = itemName,
            ItemNameEN   = itemNameEn,
            ItemType     = itemType,
            ItemCategory = itemCategory,
            DefaultUOM   = uom,
            ActiveFlag   = activeFlag
        });

    RenderFragment ItemFormFields() =>
    @<div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <label>@L["MD.Items.Lbl.ItemName"]</label>
                <input class="ames-input" @bind="_fItemName" autocomplete="off" />
            </div>
            <div>
                <label>@L["MD.Items.Lbl.ItemNameEn"]</label>
                <input class="ames-input" @bind="_fItemNameEn" autocomplete="off" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 80px;gap:8px;margin-top:6px;">
            <div>
                <label>@L["MD.Items.Lbl.ItemType"]</label>
                <select class="ames-input" @bind="_fItemType">
                    <option value="">@L["Opt.Select"]</option>
                    @foreach (var t in _itemTypeItems.Where(t => t.UseFlag))
                    { <option value="@t.CodeValue">[@t.CodeValue] @MasterDataRepository.LocalName(t)</option> }
                </select>
            </div>
            <div>
                <label>@L["MD.Items.Lbl.Category"]</label>
                <input class="ames-input" @bind="_fItemCategory" autocomplete="off"
                       placeholder="예: BUMPER, DOOR" maxlength="30" />
            </div>
            <div>
                <label>Routing</label>
                <select class="ames-input" @bind="_fRoutingType">
                    <option value="">@L["Opt.Select"]</option>
                    @foreach (var r in _routingItems.Where(r => r.UseFlag))
                    { <option value="@r.CodeValue">[@r.CodeValue] @MasterDataRepository.LocalName(r)</option> }
                </select>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <label>@L["MD.Items.Lbl.SafetyStock"]</label>
                <input type="number" class="ames-input" @bind="_fSafetyStock" min="0" step="0.0001" />
            </div>
            <div>
                <label>@L["MD.Items.Lbl.MinStock"]</label>
                <input type="number" class="ames-input" @bind="_fMinStock" min="0" step="0.0001" />
            </div>
            <div>
                <label>@L["MD.Items.Lbl.MaxStock"]</label>
                <input type="number" class="ames-input" @bind="_fMaxStock" min="0" step="0.0001" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <label>@L["MD.Items.Lbl.UnitCost"]</label>
                <input type="number" class="ames-input" @bind="_fUnitCost" min="0" step="0.01" />
            </div>
            <div>
                <label>@L["MD.Items.Lbl.CustSav"]</label>
                <input class="ames-input" @bind="_fCustSav" maxlength="30" autocomplete="off" />
            </div>
            <div>
                <label>@L["MD.Items.Lbl.CustGeo"]</label>
                <input class="ames-input" @bind="_fCustGeo" maxlength="30" autocomplete="off" />
            </div>
        </div>

        <label style="margin-top:6px;">@L["MD.Items.Lbl.DrawingNo"]</label>
        <input class="ames-input" @bind="_fDrawingNo" maxlength="30" autocomplete="off" />

        <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="checkbox" @bind="_fActiveFlag" style="accent-color:#60a5fa;" />
            @L["Lbl.Use.On"]
        </label>
    </div>;

    static string? N(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    static decimal? Nz(decimal v) => v == 0 ? null : v;

    static string ToIpv4(System.Net.IPAddress? ip)
    {
        if (ip is null) return "";
        if (ip.IsIPv4MappedToIPv6) return ip.MapToIPv4().ToString();
        if (ip.Equals(System.Net.IPAddress.IPv6Loopback)) return "127.0.0.1";
        return ip.ToString();
    }
}
