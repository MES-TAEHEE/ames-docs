@page "/md/fd/items"
@rendermode InteractiveServer

@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject SysRepository Sys
@inject IHttpContextAccessor HttpCtxAccessor
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-003 @L["MD.Items.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-003" TitleKey="MD.Items.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Items.Kpi.Assy"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ItemType == "ASSY")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Items.Kpi.Sub"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ItemType == "SUB")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Items.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Items.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fTypeFilter" Data="@ItemTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.Active"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fActiveOnly" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.ItemRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Items.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemNo" Title="@L["Col.ItemNo"]" TextAlign="TextAlign.Center" Width="130px">
                <Template Context="item"><span class="code">@item.ItemNo</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemName" Title="@L["Col.ItemName"]" />
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemType" Title="@L["Col.Type"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item"><span class="pill info">@(item.ItemType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ItemCategory" Title="@L["Col.Category"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item"><span class="dim">@item.ItemCategory</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="CarType" Title="@L["Col.CarType"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="item"><span class="code dim">@(item.CarType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="PGN" Title="@L["Col.PGN"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="item"><span class="code dim">@(item.PGN ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ALC" Title="@L["Col.ALC"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item"><span class="code dim">@(item.ALC ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="DefaultUOM" Title="@L["Col.Uom"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="item"><span class="code dim">@item.DefaultUOM</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="RoutingType" Title="@L["Col.Routing"]" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="item"><span class="code dim">@(item.RoutingType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="SafetyStock" Title="@L["Col.Safety"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="item">@(item.SafetyStock?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="MinStock" Title="@L["Col.MinStock"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="item">@(item.MinStock?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="MaxStock" Title="@L["Col.MaxStock"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="item">@(item.MaxStock?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="UnitCost" Title="@L["Col.UnitPrice"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="item">@(item.UnitCost?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ItemRow" Property="ActiveFlag" Title="@L["Col.Active"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="item">
                    @if (item.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Items.Title"] — @L["Modal.Create"]</div>

            <RadzenRow Gap="8px">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@(L["MD.Items.Lbl.ItemNo"] + "  " + L["MD.Items.Lbl.ItemNoHint"])' />
                    <RadzenTextBox @bind-Value="_f.ItemNo" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@(L["MD.Items.Lbl.Uom"] + " (UOM)")' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.Uom" Data="@UomOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @ItemFormFields()

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Items.Title"] — @L["Modal.Edit"] <span class="code" style="font-weight:400;font-size:.9em;">@_f.ItemNo</span></div>

            <RadzenRow Gap="8px">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Items.Lbl.ItemNo"]" />
                    <RadzenTextBox Value="@_f.ItemNo" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@(L["MD.Items.Lbl.Uom"] + " (UOM)")' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.Uom" Data="@UomOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @ItemFormFields()

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.Items.ConfirmDelete"].Value, _f.ItemNo, _f.ItemName)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.ItemRow>        _allRows      = new();
    List<MasterDataRepository.ItemRow>        _rows         = new();
    List<MasterDataRepository.CodeItemRow>    _itemTypeItems = new();
    List<MasterDataRepository.CodeItemRow>    _routingItems  = new();
    List<MasterDataRepository.CodeItemRow>    _activeFlagItems = new();
    List<MasterDataRepository.UomRow> _uomList = new();
    MasterDataRepository.ItemRow? _sel;

    string  _fSearch     = "";
    string? _fTypeFilter, _fActiveOnly;
    string _modal = "", _modalErr = "", _msg = "", _clientIp = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();
    
    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ItemTypeOptions => _itemTypeItems.Where(t => t.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    private IEnumerable<DropDownItem> RoutingOptions => _routingItems.Where(r => r.UseFlag).Select(r => new DropDownItem { Value = r.CodeValue ?? "", Text = $"[{r.CodeValue}] {MasterDataRepository.LocalName(r)}" });
    private IEnumerable<DropDownItem> UomOptions => _uomList.Where(u => u.ActiveFlag).Select(u => new DropDownItem { Value = u.UOMCode ?? "", Text = u.UOMCode + (string.IsNullOrEmpty(u.UOMName) ? "" : $"  ({u.UOMName})") });
    // 상태 필터: 공통코드 ACTIVE_FLAG (ACTIVE/INACTIVE)
    private IEnumerable<DropDownItem> ActiveFilterOptions =>
        _activeFlagItems.Where(a => a.UseFlag).Select(a => new DropDownItem { Value = a.CodeValue ?? "", Text = MasterDataRepository.LocalName(a) });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/fd/items");
        // HttpContext is available during the prerender (HTTP) phase; null after WebSocket handoff.
        _clientIp = ToIpv4(HttpCtxAccessor.HttpContext?.Connection.RemoteIpAddress);
        try { _itemTypeItems = MD.ListCodeItems("ITEM_TYPE"); } catch { }
        try { _routingItems = MD.ListCodeItems("ROUTING"); } catch { }
        try { _activeFlagItems = MD.ListCodeItems("ACTIVE_FLAG"); } catch { }
        try { _uomList = MD.ListUoms(); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.ItemRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { try { _allRows = MD.ListItems(""); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter()
    {
        _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.ItemNo.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            r.ItemName.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CarType ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.PGN ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ALC ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fTypeFilter) || r.ItemType == _fTypeFilter) &&
        (string.IsNullOrEmpty(_fActiveOnly) || (_fActiveOnly == "ACTIVE" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    private void RowRender(RowRenderEventArgs<MasterDataRepository.ItemRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.ItemRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate()
    {
        _f = new();
        _confirmDelete = false; _modalErr = ""; _modal = "create";
    }

    void OpenEdit(MasterDataRepository.ItemRow r)
    {
        if (!_canEdit) return;
        _sel = r;
        _f = new()
        {
            ItemNo       = r.ItemNo,
            ItemName     = r.ItemName,
            ItemType     = r.ItemType ?? "",
            ItemCategory = r.ItemCategory ?? "",
            CarType      = r.CarType ?? "",
            Uom          = r.DefaultUOM ?? "",
            RoutingType  = r.RoutingType ?? "",
            MinStock     = r.MinStock ?? 0,
            MaxStock     = r.MaxStock ?? 0,
            SafetyStock  = r.SafetyStock ?? 0,
            UnitCost     = r.UnitCost ?? 0,
            Pgn          = r.PGN ?? "",
            Alc          = r.ALC ?? "",
            DrawingNo    = r.DrawingNo ?? "",
            ActiveFlag   = r.ActiveFlag,
        };
        _confirmDelete = false; _modalErr = ""; _modal = "edit";
    }

    void CloseModal() { _modal = ""; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ItemNo))   { _modalErr = L["MD.Items.Err.NoRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.ItemName))  { _modalErr = L["MD.Items.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var no = _f.ItemNo.Trim().ToUpper();
            if (MD.ItemExists(no)) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], no); return; }
            MD.InsertItem(no, _f.ItemName.Trim(), N(_f.ItemType),
                N(_f.ItemCategory), N(_f.CarType), N(_f.Uom), N(_f.RoutingType),
                Nz(_f.MinStock), Nz(_f.MaxStock), Nz(_f.SafetyStock), Nz(_f.UnitCost),
                N(_f.Pgn), N(_f.Alc), N(_f.DrawingNo), _f.ActiveFlag, _actor);
            Sys.InsertAuditLog("MD", "MD-003", "CREATE", "MD_Item", no,
                null, ItemJson(no, _f.ItemName.Trim(), N(_f.CarType), N(_f.ItemType),
                    N(_f.ItemCategory), N(_f.Uom), _f.ActiveFlag),
                _actor, _clientIp,
                note: $"Created MD_Item '{no}' (ItemName='{_f.ItemName.Trim()}'" +
                      $", Type='{N(_f.ItemType) ?? "-"}', UOM='{N(_f.Uom) ?? "-"}') by '{_actor}'");
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Items.Ok.Created"].Value, no), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ItemName)) { _modalErr = L["MD.Items.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var beforeJson = _sel is null ? null : ItemJson(
                _sel.ItemNo, _sel.ItemName, _sel.CarType, _sel.ItemType,
                _sel.ItemCategory, _sel.DefaultUOM, _sel.ActiveFlag);
            MD.UpdateItem(_f.ItemNo, _f.ItemName.Trim(), N(_f.ItemType),
                N(_f.ItemCategory), N(_f.CarType), N(_f.Uom), N(_f.RoutingType),
                Nz(_f.MinStock), Nz(_f.MaxStock), Nz(_f.SafetyStock), Nz(_f.UnitCost),
                N(_f.Pgn), N(_f.Alc), N(_f.DrawingNo), _f.ActiveFlag, _actor);
            Sys.InsertAuditLog("MD", "MD-003", "UPDATE", "MD_Item", _f.ItemNo,
                beforeJson, ItemJson(_f.ItemNo, _f.ItemName.Trim(), N(_f.CarType), N(_f.ItemType),
                    N(_f.ItemCategory), N(_f.Uom), _f.ActiveFlag),
                _actor, _clientIp,
                note: $"Updated MD_Item '{_f.ItemNo}' (ItemName='{_f.ItemName.Trim()}'" +
                      $", Type='{N(_f.ItemType) ?? "-"}', UOM='{N(_f.Uom) ?? "-"}'," +
                      $" Active={_f.ActiveFlag}) by '{_actor}'");
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Items.Ok.Updated"].Value, _f.ItemNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        _busy = true;
        try
        {
            var beforeJson = _sel is null ? null : ItemJson(
                _sel.ItemNo, _sel.ItemName, _sel.CarType, _sel.ItemType,
                _sel.ItemCategory, _sel.DefaultUOM, _sel.ActiveFlag);
            MD.DeleteItem(_f.ItemNo);
            Sys.InsertAuditLog("MD", "MD-003", "DELETE", "MD_Item", _f.ItemNo,
                beforeJson, null,
                _actor, _clientIp,
                note: $"Deleted MD_Item '{_f.ItemNo}'" +
                      $" (ItemName='{_sel?.ItemName ?? "-"}', Type='{_sel?.ItemType ?? "-"}') by '{_actor}'");
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Items.Ok.Deleted"].Value, _f.ItemNo), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string ItemJson(string itemNo, string itemName, string? carType,
        string? itemType, string? itemCategory, string? uom, bool activeFlag)
        => JsonSerializer.Serialize(new
        {
            ItemNo       = itemNo,
            ItemName     = itemName,
            CarType      = carType,
            ItemType     = itemType,
            ItemCategory = itemCategory,
            DefaultUOM   = uom,
            ActiveFlag   = activeFlag
        });

    RenderFragment ItemFormFields() =>
    @<div>
        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="6">
                <RadzenLabel Text="@L["MD.Items.Lbl.ItemName"]" />
                <RadzenTextBox @bind-Value="_f.ItemName" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenLabel Text="@L["MD.Items.Lbl.CarType"]" />
                <RadzenTextBox @bind-Value="_f.CarType" Placeholder="LQ2" MaxLength="10" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["MD.Items.Lbl.ItemType"]" />
                <RadzenDropDown @bind-Value="_f.ItemType" Data="@ItemTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["MD.Items.Lbl.Category"]" />
                <RadzenTextBox @bind-Value="_f.ItemCategory" Placeholder="BUMPER, DOOR" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["Col.Routing"]" />
                <RadzenDropDown @bind-Value="_f.RoutingType" Data="@RoutingOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["MD.Items.Lbl.SafetyStock"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_f.SafetyStock" Min="0" Step="0.0001" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["MD.Items.Lbl.MinStock"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_f.MinStock" Min="0" Step="0.0001" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["MD.Items.Lbl.MaxStock"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_f.MaxStock" Min="0" Step="0.0001" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["MD.Items.Lbl.UnitCost"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_f.UnitCost" Min="0" Step="0.01" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["Col.PGN"]" />
                <RadzenTextBox @bind-Value="_f.Pgn" MaxLength="4" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["Col.ALC"]" />
                <RadzenTextBox @bind-Value="_f.Alc" MaxLength="10" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="12">
                <RadzenLabel Text="@L["MD.Items.Lbl.DrawingNo"]" />
                <RadzenTextBox @bind-Value="_f.DrawingNo" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
            <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" Name="ItemChkActive" />
            <RadzenLabel Text="@L["Lbl.Active"]" Component="ItemChkActive" style="cursor:pointer;" />
        </RadzenStack>
    </div>;

    static string? N(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    static decimal? Nz(decimal v) => v == 0 ? null : v;

    static string ToIpv4(IPAddress? ip)
    {
        if (ip is null) return "";
        if (ip.IsIPv4MappedToIPv6) return ip.MapToIPv4().ToString();
        if (ip.Equals(System.Net.IPAddress.IPv6Loopback)) return "127.0.0.1";
        return ip.ToString();
    }

    class FormModel
    {
        public string  ItemNo       { get; set; } = "";
        public string  ItemName     { get; set; } = "";
        public string  ItemType     { get; set; } = "";
        public string  ItemCategory { get; set; } = "";
        public string  CarType      { get; set; } = "";
        public string  Uom          { get; set; } = "";
        public string  RoutingType  { get; set; } = "";
        public decimal MinStock     { get; set; }
        public decimal MaxStock     { get; set; }
        public decimal SafetyStock  { get; set; }
        public decimal UnitCost     { get; set; }
        public string  Pgn          { get; set; } = "";
        public string  Alc          { get; set; } = "";
        public string  DrawingNo    { get; set; } = "";
        public bool    ActiveFlag   { get; set; } = true;
    }
}