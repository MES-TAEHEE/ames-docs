@page "/md/fd/location"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject WarehouseRepository Warehouse
@inject IStringLocalizer<SharedResources> L
@inject AMES.Web.Services.AuditLogger Audit
@inject DialogService Dialog

<PageTitle>MD-018 @L["MD.Location.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-018" TitleKey="MD.Location.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Location.Level.Primary"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.LocationLevel == MasterDataRepository.LocationLevelPrimary)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Col.Area"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.AreaCode).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Col.Warehouse"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.WhCode).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h master-list-toolbar">
        <span style="white-space:nowrap;">▼ @L["MD.Location.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["MD.Location.Col.Parent"]" Component="DropDownParentFilter" />
            <RadzenDropDown Name="DropDownParentFilter" @bind-Value="_fParent" Data="@ParentOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" AllowFiltering="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:320px;" />
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Location.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Area"]" Component="DropDownAreaFilter" />
            <RadzenDropDown Name="DropDownAreaFilter" @bind-Value="_fArea" Data="@FilterAreaOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["MD.Location.Lbl.Level"]" Component="DropDownLevelFilter" />
            <RadzenDropDown Name="DropDownLevelFilter" @bind-Value="_fLevel" Data="@LevelFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.LocationRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Location.Empty"]" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            @* 행 번호 — 정렬·페이지를 반영한 화면상의 순번 *@
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Title="@L["Col.RowNo"]" Width="60px" MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                <Template Context="rn"><span class="dim">@GridRowNo.Of(_pgGrid, rn)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="LocationID" Title="@L["Col.LocationId"]" TextAlign="TextAlign.Center" Width="190px" MinWidth="190px">
                <Template Context="r">
                    <span class="location-code-print-cell" @onclick:stopPropagation>
                        <span class="loc-tree">
                            @if (!IsPrimary(r) && r.ParentLocationID is not null) { <span class="dim loc-tree-mark">└</span> }
                            <span class="code" style="@(IsPrimary(r) ? "font-weight:700;" : null)">@r.LocationID</span>
                        </span>
                        <RadzenButton Icon="print" title="Print location barcode" aria-label="@($"Print location barcode {r.LocationID}")"
                                      ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn location-code-print-btn"
                                      Click="@(() => OpenBarcode(r))" />
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="ParentLocationID" Title="@L["MD.Location.Col.Parent"]" TextAlign="TextAlign.Center" Width="170px" MinWidth="170px">
                <Template Context="r">
                    @if (IsPrimary(r)) { <span class="pill info">@string.Format(L["MD.Location.Children"].Value, r.ChildCount)</span> }
                    else if (r.ParentLocationID is { } parent) { <span class="code">@parent</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="LocationName" Title="@L["Col.Name"]">
                <Template Context="r">@(r.LocationName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="WhCode" Title="@L["MD.Location.Col.WhCode"].Value" TextAlign="TextAlign.Center" Width="140px" MinWidth="140px" />
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="AreaCode" Title="@L["Col.Area"].Value" TextAlign="TextAlign.Center" Width="240px" MinWidth="240px">
                <Template Context="r"><span class="pill">@CodeLabel(_areaCodes, r.AreaCode)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="PartNo" Title="@L["MD.Location.Lbl.AssignedPart"]" Width="160px" MinWidth="160px" />
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="MinimumQty" Title="MINIMUM" Width="100px" MinWidth="100px" FormatString="{0:N0}" />
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="Aisle" Title="Y (Row)" TextAlign="TextAlign.Center" Width="100px" MinWidth="100px">
                <Template Context="r"><span class="dim">@CodeLabel(_aisleCodes, r.Aisle)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="Bay" Title="X (Column)" TextAlign="TextAlign.Center" Width="110px" MinWidth="110px">
                <Template Context="r"><span class="dim">@CodeLabel(_bayCodes, r.Bay)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="Slot" Title="Floor" TextAlign="TextAlign.Center" Width="100px" MinWidth="100px">
                <Template Context="r"><span class="dim">@CodeLabel(_slotCodes, r.Slot)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="Capacity" Title="@L["Col.LoadCapacity"]" TextAlign="TextAlign.Right" Width="180px" MinWidth="180px">
                <Template Context="r">@(r.Capacity?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="SAPFlag" Title="@L["Col.Sap"]" TextAlign="TextAlign.Center" Width="70px" MinWidth="70px">
                <Template Context="r">
                    @if (r.SAPFlag) { <RadzenIcon Icon="check_circle" Style="color:var(--ames-tx-green-400);vertical-align:middle;" /> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_barcodeLocation is not null)
{
    <LocationBarcodeDialog LocationCode="@_barcodeLocation.LocationID" OnClose="CloseBarcode" />
}


@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Location.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.LocationID</span>@if (_sel.SAPFlag) { <span class="pill info" style="margin-left:6px;font-size:.72em;" title="@L["Lbl.SapData"]">SAP</span> }</div>
            @if (IsPrimary(_sel))
            {
                <div class="dim" style="margin-bottom:8px;">@L["MD.Location.Hint.Primary"] · @string.Format(L["MD.Location.Children"].Value, _sel.ChildCount)</div>
            }

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["MD.Location.Lbl.LocationName"]" class="ames-rz-modal-label" Component="EditTextBoxLocationName" />
                <RadzenTextBox Name="EditTextBoxLocationName" @bind-Value="_f.LocationName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            @if (!IsPrimary(_sel))
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top:8px;">
                    <RadzenLabel Text="@L["MD.Location.Lbl.Capacity"]" class="ames-rz-modal-label" Component="EditCapacity" />
                    <RadzenNumeric Name="EditCapacity" TValue="decimal?" @bind-Value="_f.Capacity" Min="0" Step="1" Format="N0" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top:8px;">
                    <RadzenLabel Text="Minimum Qty" class="ames-rz-modal-label" Component="EditMinimumQty" />
                    <RadzenNumeric Name="EditMinimumQty" TValue="decimal" @bind-Value="_f.MinimumQty" Min="0" Max="99999999999" Step="1" Format="N0" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top:8px;">
                    <RadzenLabel Text="@L["MD.Location.Col.Parent"]" class="ames-rz-modal-label" Component="EditDropDownParent" />
                    <RadzenDropDown Name="EditDropDownParent" TValue="string" @bind-Value="_f.ParentLocationID" Data="@ParentOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" AllowFiltering="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>
                <div class="dim" style="font-size:.85em;margin-top:2px;">@L["MD.Location.Hint.Parent"]</div>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top:8px;">
                    <RadzenLabel Text="@L["MD.Location.Lbl.AssignedPart"]" class="ames-rz-modal-label" Component="EditDropDownAssignedPart" />
                    <RadzenDropDown Name="EditDropDownAssignedPart" TValue="string" @bind-Value="_f.PartNo" Data="_parts" TextProperty="ItemNo" ValueProperty="ItemNo" AllowFiltering="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                </RadzenStack>

            }


            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    bool _showPagerSummary = true;
    int  _pageRows = 25;   // 고정 페이저: 본문 높이 = 헤더 + 페이지 행 수 × 행 높이(.ames-grid-fixed)
    List<MasterDataRepository.LocationRow> _allRows = new();
    List<MasterDataRepository.ItemRow> _parts=[];
    List<MasterDataRepository.LocationRow> _rows    = new();
    List<MasterDataRepository.LocationRow> _primaries = new();
    List<MasterDataRepository.CodeItemRow> _areaCodes = new();
    List<MasterDataRepository.CodeItemRow> _aisleCodes = new();
    List<MasterDataRepository.CodeItemRow> _bayCodes   = new();
    List<MasterDataRepository.CodeItemRow> _slotCodes  = new();
    MasterDataRepository.LocationRow? _sel;
    MasterDataRepository.LocationRow? _barcodeLocation;

    string  _fSearch = "";
    string? _fArea;
    string? _fLevel;
    string? _fParent;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    // 구분 필터 — 1 = 상위 로케이션, 2 = 하위 로케이션, N = 상위 미지정 하위
    private IEnumerable<DropDownItem> LevelFilterOptions => new[]
    {
        new DropDownItem { Value = "1", Text = L["MD.Location.Level.Primary"] },
        new DropDownItem { Value = "2", Text = L["MD.Location.Level.Detail"] },
        new DropDownItem { Value = "N", Text = L["MD.Location.Filter.NoParent"] },
    };

    // 상위로 고를 수 있는 상위 로케이션 — 지금 행의 상위가 목록 밖(사용 안 함)이어도 남긴다
    private IEnumerable<DropDownItem> ParentOptions =>
        _primaries.Select(p => new DropDownItem { Value = p.LocationID, Text = string.IsNullOrEmpty(p.LocationName) ? p.LocationID : $"{p.LocationID} · {p.LocationName}" })
            .Concat(_modal == "edit" && _sel?.ParentLocationID is { Length: > 0 } cur && !_primaries.Any(p => p.LocationID == cur)
                ? new[] { new DropDownItem { Value = cur, Text = cur } } : Array.Empty<DropDownItem>());

    static bool IsPrimary(MasterDataRepository.LocationRow r) => r.LocationLevel == MasterDataRepository.LocationLevelPrimary;

    private IEnumerable<DropDownItem> FilterAreaOptions => CodeOptions(_areaCodes.Where(x => _allRows.Any(r => r.AreaCode == x.CodeValue)).ToList());

    private static IEnumerable<DropDownItem> CodeOptions(List<MasterDataRepository.CodeItemRow> codes)
        => codes.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    // 코드값을 현재 언어의 공통코드 명칭으로 표시 (미정의 값은 원본 코드, 빈 값은 —)
    private static string CodeLabel(List<MasterDataRepository.CodeItemRow> codes, string? value)
        => string.IsNullOrEmpty(value) ? "—"
         : codes.FirstOrDefault(c => c.CodeValue == value) is { } ci ? MasterDataRepository.LocalName(ci) : value;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = AMES.Web.Services.ActorCode.Of(auth.User, "system");
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/fd/location");
        _parts=await Task.Run(()=>MD.ListItems());
        try { _areaCodes  = MD.ListCodeItems("WH_AREA"); } catch { }
        try { _aisleCodes = MD.ListCodeItems("WH_AISLE"); } catch { }
        try { _bayCodes   = MD.ListCodeItems("WH_BAY");   } catch { }
        try { _slotCodes = MD.ListCodeItems("WH_SLOT"); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.LocationRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload()
    {
        var all = MD.ListLocations();
        _primaries = all.Where(r => IsPrimary(r) && r.ActiveFlag).ToList();
        _allRows = all
            .Where(x => x.ActiveFlag && !string.Equals(x.AreaCode, "SPARE_PARTS_AREA", StringComparison.OrdinalIgnoreCase))
            .ToList();
        ApplyFilter();
    }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.LocationID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.LocationName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.LineName ?? "").Contains(_fSearch,StringComparison.OrdinalIgnoreCase) ||
            (r.LineId ?? "").Contains(_fSearch,StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fArea) || r.AreaCode == _fArea) &&
        (_fLevel switch { "1" => IsPrimary(r), "2" => !IsPrimary(r), "N" => !IsPrimary(r) && r.ParentLocationID is null, _ => true }) &&
        (string.IsNullOrEmpty(_fParent) || r.ParentLocationID == _fParent || r.LocationID == _fParent)
    ).OrderBy(TreeKey, StringComparer.Ordinal).ThenBy(r => IsPrimary(r) ? 0 : 1).ThenBy(r => r.LocationID, StringComparer.Ordinal).ToList();
    }

    // 상위 로케이션 바로 아래에 그 하위가 이어지게 묶는다 — 상위 미지정 하위는 맨 뒤
    static string TreeKey(MasterDataRepository.LocationRow r) =>
        IsPrimary(r) ? r.LocationID : r.ParentLocationID ?? "~~" + r.LocationID;

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    // 조회는 DB 를 다시 읽는다 — 다른 화면·SQL 로 바뀐 로케이션·상위 지정이 열어 둔 화면에도 반영되게
    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") Reload(); }

    private void RowRender(RowRenderEventArgs<MasterDataRepository.LocationRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
        if (args.Data is { } row && IsPrimary(row)) args.Attributes["class"] += " loc-primary-row";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.LocationRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenBarcode(MasterDataRepository.LocationRow location) => _barcodeLocation = location;
    void CloseBarcode() => _barcodeLocation = null;


    void OpenEdit(MasterDataRepository.LocationRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = "";
        _f = new()
        {
            LocationID   = r.LocationID,
            LocationName = r.LocationName ?? "",
            WhCode       = r.WhCode,
            AreaCode     = r.AreaCode,
            Aisle        = r.Aisle        ?? "",
            Bay          = r.Bay          ?? "",
            Slot         = r.Slot         ?? "",
            Capacity     = r.Capacity,
            PartNo = r.PartNo??"",
            MinimumQty = r.MinimumQty ?? 0,
            ParentLocationID = r.ParentLocationID,
        };
        _modal = "edit";
    }


    string SqlErr(Microsoft.Data.SqlClient.SqlException ex, string id) => ex.Number switch
    {
        52073 => L["MD.Location.Err.ParentNotPrimary"],
        52074 => L["MD.Location.Err.PrimaryHasParent"],
        52075 => L["MD.Location.Err.ParentHasStock"],
        2627 or 2601 => string.Format(L["MD.Location.Err.IDExists"].Value, id),
        _ => ex.Message,
    };

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveEdit()
    {
        if (!_canEdit || _busy) return;
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            if (!await PermSvc.RecheckEditAsync(AuthPrvd, "md/fd/location")) throw new InvalidOperationException("You do not have permission to edit locations.");
            if (!IsPrimary(_sel)
                && (_f.MinimumQty < 0 || _f.MinimumQty > 99999999999m || _f.MinimumQty != decimal.Truncate(_f.MinimumQty)))
                throw new InvalidOperationException("Minimum qty must be a whole number from 0 to 99,999,999,999.");
            if (_f.Capacity is not null && _f.Capacity != decimal.Truncate(_f.Capacity.Value)) throw new InvalidOperationException("Load Capacity must be a whole number.");
            var saveConfirmed = false;
            if (_f.Capacity != _sel.Capacity)
            {
                var currentQty = Warehouse.GetLocationStockQty(_sel.LocationID);
                if (AMES.Data.Services.LocationCapacity.ShouldWarnOnReduction(currentQty, _sel.Capacity, _f.Capacity))
                {
                    var confirmed = await Dialog.Confirm(
                        $"Current stock at {_sel.LocationID} is {currentQty:N0}, above the new Load Capacity of {_f.Capacity:N0}. Save this lower capacity anyway?",
                        "Load Capacity Warning", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
                    if (confirmed != true) return;
                    saveConfirmed = true;
                }
            }
            if (!saveConfirmed && await Dialog.Confirm($"Are you sure you want to save changes to location {_sel.LocationID}?",
                "Confirm Changes", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" }) != true) return;
            // 지정 품번은 바꿨을 때만 보낸다 — 그대로 다시 보내면 품번 재지정 검사(51050)가 명칭만 고치는 저장도 막는다
            MD.UpdateLocation(_sel.LocationID, NE(_f.LocationName), _sel.WhCode, _sel.AreaCode, _sel.ZoneCode,
                _sel.Aisle, _sel.Bay, _sel.Slot,
                _f.Capacity, _sel.LocationType, _sel.PlantCode, _sel.ActiveFlag, _actor, IsPrimary(_sel) || NE(_f.PartNo) == _sel.PartNo ? null : _f.PartNo,
                setParent: !IsPrimary(_sel) && NE(_f.ParentLocationID) != _sel.ParentLocationID, parentLocationId: NE(_f.ParentLocationID),
                minimumQty: !IsPrimary(_sel) && _f.MinimumQty != (_sel.MinimumQty ?? 0) ? _f.MinimumQty : null);
            Audit.Updated("MD-018", "MD_Location", _sel.LocationID, _sel, _f);
            var key = _sel.LocationID;   // CloseModal 이 _sel 을 비우므로 먼저 꺼내 둔다
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Location.Ok.Updated"].Value, key), false);
        }
        catch (Microsoft.Data.SqlClient.SqlException ex) { _modalErr = SqlErr(ex, _sel?.LocationID ?? ""); }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
    
    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string   LocationID   { get; set; } = "";
        public string   LocationName { get; set; } = "";
