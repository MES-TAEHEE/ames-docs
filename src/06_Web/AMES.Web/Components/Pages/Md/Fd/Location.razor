@page "/md/fd/location"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Location.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-018</div>
    <div class="ames-page-t">@L["MD.Location.Title"]</div>
    <div class="ames-page-sub">@L["MD.Location.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Location.Kpi.Zones"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ZoneCode).Where(z => z != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Location.Kpi.Plants"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.PlantCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Location.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:160px;padding:4px 8px;"
                   placeholder="@L["MD.Location.Ph.Search"]" @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Zone"]</span>
            <select class="ames-input" style="width:120px;" @bind="_fZone">
                <option value="">@L["Filter.AllZones"]</option>
                @foreach (var z in _allRows.Select(r => r.ZoneCode).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@z">@z</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:130px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _allRows.Select(r => r.LocationType).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@t">@t</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Active"]</span>
            <select class="ames-input" style="width:100px;" @bind="_fActive">
                <option value="">@L["Filter.All"]</option>
                <option value="Y">@L["Lbl.Active"]</option>
                <option value="N">@L["Lbl.Inactive"]</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Location.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.LocationId"]</th><th>@L["Col.Name"]</th><th>@L["Col.Zone"]</th>
                    <th>@L["Col.Aisle"]</th><th>@L["Col.Bay"]</th><th>@L["Col.Slot"]</th>
                    <th style="text-align:right;">@L["Col.LoadCapacity"]</th>
                    <th>@L["Col.Type"]</th><th>@L["Col.Plant"]</th><th>@L["Col.Active"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.LocationID</td>
                        <td>@(r.LocationName ?? "—")</td>
                        <td><span class="pill">@(r.ZoneCode ?? "—")</span></td>
                        <td class="dim">@(r.Aisle ?? "—")</td>
                        <td class="dim">@(r.Bay ?? "—")</td>
                        <td class="dim">@(r.Slot ?? "—")</td>
                        <td style="text-align:right;">@(r.Capacity?.ToString("N3") ?? "—")</td>
                        <td><span class="pill">@(r.LocationType ?? "—")</span></td>
                        <td class="dim">@(r.PlantCode ?? "—")</td>
                        <td>
                            @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                            else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Location.Modal.Create"]</div>

            <label>@L["MD.Location.Lbl.LocationID"] <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: WH-A-01-01)</span></label>
            <input class="ames-input" @bind="_f.LocationID" placeholder="WH-A-01-01" autocomplete="off" />

            <label>@L["MD.Location.Lbl.LocationName"]</label>
            <input class="ames-input" @bind="_f.LocationName" placeholder='@L["MD.Location.Ph.LocationName"]' autocomplete="off" />

            <label>@L["MD.Location.Lbl.ZoneCode"]</label>
            <input class="ames-input" @bind="_f.ZoneCode" placeholder="A, B, FG 등" maxlength="10" autocomplete="off" />

            <label>@L["MD.Location.Lbl.Aisle"]</label>
            <input class="ames-input" @bind="_f.Aisle" placeholder="01" maxlength="5" autocomplete="off" />

            <label>@L["MD.Location.Lbl.Bay"]</label>
            <input class="ames-input" @bind="_f.Bay" placeholder="01" maxlength="5" autocomplete="off" />

            <label>@L["MD.Location.Lbl.Slot"]</label>
            <input class="ames-input" @bind="_f.Slot" placeholder="01" maxlength="5" autocomplete="off" />

            <label>@L["MD.Location.Lbl.Capacity"]</label>
            <input class="ames-input" type="number" step="0.001" @bind="_f.Capacity" placeholder="1000.000" min="0" autocomplete="off" />

            <label>@L["MD.Location.Lbl.LocationType"]</label>
            <input class="ames-input" @bind="_f.LocationType" placeholder="RACK, FLOOR, STAGING 등" maxlength="20" autocomplete="off" />

            <label>@L["MD.Location.Lbl.PlantCode"]</label>
            <select class="ames-input" @bind="_f.PlantCode">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var p in _plantCodes.Where(p => p.UseFlag))
                {
                    <option value="@p.CodeValue">@(MasterDataRepository.LocalName(p))</option>
                }
            </select>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Location.Modal.Edit"] — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.LocationID</span></div>

            <label>@L["MD.Location.Lbl.LocationName"]</label>
            <input class="ames-input" @bind="_f.LocationName" autocomplete="off" />

            <label>@L["MD.Location.Lbl.ZoneCode"]</label>
            <input class="ames-input" @bind="_f.ZoneCode" maxlength="10" autocomplete="off" />

            <label>@L["MD.Location.Lbl.Aisle"]</label>
            <input class="ames-input" @bind="_f.Aisle" maxlength="5" autocomplete="off" />

            <label>@L["MD.Location.Lbl.Bay"]</label>
            <input class="ames-input" @bind="_f.Bay" maxlength="5" autocomplete="off" />

            <label>@L["MD.Location.Lbl.Slot"]</label>
            <input class="ames-input" @bind="_f.Slot" maxlength="5" autocomplete="off" />

            <label>@L["MD.Location.Lbl.Capacity"]</label>
            <input class="ames-input" type="number" step="0.001" @bind="_f.Capacity" min="0" autocomplete="off" />

            <label>@L["MD.Location.Lbl.LocationType"]</label>
            <input class="ames-input" @bind="_f.LocationType" maxlength="20" autocomplete="off" />

            <label>@L["MD.Location.Lbl.PlantCode"]</label>
            <select class="ames-input" @bind="_f.PlantCode">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var p in _plantCodes.Where(p => p.UseFlag))
                {
                    <option value="@p.CodeValue">@(MasterDataRepository.LocalName(p))</option>
                }
            </select>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    int _page = 0;
    const int _pageSize = 20;
    List<AMES.Data.Repositories.MasterDataRepository.LocationRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.LocationRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.LocationRow? _sel;

    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _plantCodes = new();
    string _fSearch = "", _fZone = "", _fType = "", _fActive = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/fd/location");
        try { _plantCodes = Md.ListCodeItems("PLANT"); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListLocations(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.LocationID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.LocationName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fZone)   || r.ZoneCode     == _fZone) &&
        (string.IsNullOrEmpty(_fType)   || r.LocationType == _fType) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    void OpenCreate() { _f = new() { ActiveFlag = true }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.LocationRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            LocationID   = r.LocationID,
            LocationName = r.LocationName ?? "",
            ZoneCode     = r.ZoneCode     ?? "",
            Aisle        = r.Aisle        ?? "",
            Bay          = r.Bay          ?? "",
            Slot         = r.Slot         ?? "",
            Capacity     = r.Capacity,
            LocationType = r.LocationType ?? "",
            PlantCode      = r.PlantCode      ?? "",
            ActiveFlag   = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.LocationID)) { _modalErr = L["MD.Location.Err.IDRequired"]; return; }
        if (Md.LocationExists(_f.LocationID.Trim()))  { _modalErr = string.Format(L["MD.Location.Err.IDExists"].Value, _f.LocationID.Trim()); return; }
        _busy = true;
        try
        {
            Md.InsertLocation(_f.LocationID.Trim(), NE(_f.LocationName), NE(_f.ZoneCode),
                NE(_f.Aisle), NE(_f.Bay), NE(_f.Slot),
                _f.Capacity, NE(_f.LocationType), NE(_f.PlantCode), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Location.Ok.Created"].Value, _f.LocationID.Trim()), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            Md.UpdateLocation(_sel.LocationID, NE(_f.LocationName), NE(_f.ZoneCode),
                NE(_f.Aisle), NE(_f.Bay), NE(_f.Slot),
                _f.Capacity, NE(_f.LocationType), NE(_f.PlantCode), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Location.Ok.Updated"].Value, _sel.LocationID), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.LocationName ?? _sel.LocationID;
            Md.DeleteLocation(_sel.LocationID);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Location.Ok.Deleted"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   LocationID   { get; set; } = "";
        public string   LocationName { get; set; } = "";
        public string   ZoneCode     { get; set; } = "";
        public string   Aisle        { get; set; } = "";
        public string   Bay          { get; set; } = "";
        public string   Slot         { get; set; } = "";
        public decimal? Capacity     { get; set; }
        public string   LocationType { get; set; } = "";
        public string   PlantCode      { get; set; } = "";
        public bool     ActiveFlag   { get; set; } = true;
    }
}
