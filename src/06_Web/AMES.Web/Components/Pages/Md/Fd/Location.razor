@page "/md/fd/location"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject WarehouseRepository Warehouse
@inject IStringLocalizer<SharedResources> L
@inject AMES.Web.Services.AuditLogger Audit

<PageTitle>MD-018 @L["MD.Location.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-018" TitleKey="MD.Location.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Col.Area"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.AreaCode).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Col.Warehouse"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.WhCode).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Location.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Location.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Area"]" Component="DropDownAreaFilter" />
            <RadzenDropDown Name="DropDownAreaFilter" @bind-Value="_fArea" Data="@FilterAreaOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:190px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.LocationRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Location.Empty"]" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            @* 행 번호 — 정렬·페이지를 반영한 화면상의 순번 *@
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Title="@L["Col.RowNo"]" Width="60px" MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                <Template Context="rn"><span class="dim">@GridRowNo.Of(_pgGrid, rn)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="LocationID" Title="@L["Col.LocationId"]" TextAlign="TextAlign.Center" Width="150px">
                <Template Context="r"><span class="code">@r.LocationID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="LocationName" Title="@L["Col.Name"]">
                <Template Context="r">@(r.LocationName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="WhCode" Title="@L["MD.Location.Col.WhCode"].Value" TextAlign="TextAlign.Center" Width="140px" />
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="AreaCode" Title="@L["Col.Area"].Value" TextAlign="TextAlign.Center" Width="160px">
                <Template Context="r"><span class="pill">@CodeLabel(_areaCodes, r.AreaCode)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="Aisle" Title="Y (Row)" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="dim">@CodeLabel(_aisleCodes, r.Aisle)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="Bay" Title="X (Column)" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r"><span class="dim">@CodeLabel(_bayCodes, r.Bay)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="Slot" Title="Floor" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="dim">@CodeLabel(_slotCodes, r.Slot)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LocationRow" Property="Capacity" Title="@L["Col.LoadCapacity"]" TextAlign="TextAlign.Right" Width="180px">
                <Template Context="r">@(r.Capacity?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Location.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["MD.Location.Lbl.LocationName"]" class="ames-rz-modal-label" Component="CreateTextBoxLocationName" />
                <RadzenTextBox Name="CreateTextBoxLocationName" @bind-Value="_f.LocationName" Placeholder="Defaults to the generated Location ID" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Location.Col.WhCode"].Value" />
                    <RadzenDropDown @bind-Value="_f.WhCode" Data="@WhOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Area"].Value" />
                    <RadzenDropDown @bind-Value="_f.AreaCode" Data="@AreaOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Location.Lbl.Aisle"]" />
                    <RadzenDropDown @bind-Value="_f.Aisle" Data="@CreateAisleOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Location.Lbl.Bay"]" />
                    <RadzenDropDown @bind-Value="_f.Bay" Data="@CreateBayOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MD.Location.Lbl.Slot"]" />
                    <RadzenDropDown @bind-Value="_f.Slot" Data="@CreateSlotOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MD.Location.Lbl.Capacity"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.Capacity" Min="0" Step="1" Format="N0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Location.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.LocationID</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["MD.Location.Lbl.LocationName"]" class="ames-rz-modal-label" Component="EditTextBoxLocationName" />
                <RadzenTextBox Name="EditTextBoxLocationName" @bind-Value="_f.LocationName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top:8px;">
                <RadzenLabel Text="@L["MD.Location.Lbl.Capacity"]" class="ames-rz-modal-label" />
                <RadzenNumeric TValue="decimal?" @bind-Value="_f.Capacity" Min="0" Step="1" Format="N0" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    bool _showPagerSummary = true;
    int  _pageRows = 25;   // 고정 페이저: 본문 높이 = 헤더 + 페이지 행 수 × 행 높이(.ames-grid-fixed)
    List<MasterDataRepository.LocationRow> _allRows = new();
    List<MasterDataRepository.LocationRow> _rows    = new();
    List<MasterDataRepository.CodeItemRow> _whCodes = new();
    List<MasterDataRepository.CodeItemRow> _areaCodes = new();
    List<MasterDataRepository.CodeItemRow> _aisleCodes = new();
    List<MasterDataRepository.CodeItemRow> _bayCodes   = new();
    List<MasterDataRepository.CodeItemRow> _slotCodes  = new();
    MasterDataRepository.LocationRow? _sel;

    string  _fSearch = "";
    string? _fArea;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<MasterDataRepository.LocationRow> CreateScope => _allRows.Where(x => x.WhCode == _f.WhCode && x.AreaCode == _f.AreaCode);
    private IEnumerable<DropDownItem> CreateAisleOptions => CreateScope.Where(x => x.Slot == _f.Slot && !string.IsNullOrEmpty(x.Aisle))
        .Select(x => x.Aisle!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(LocationMapNaming.YOrder)
        .Select(x => new DropDownItem { Text = x, Value = x });
    private IEnumerable<DropDownItem> CreateBayOptions => CreateScope.Where(x => x.Slot == _f.Slot && !string.IsNullOrEmpty(x.Bay))
        .Select(x => x.Bay!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => int.TryParse(x, out var number) ? number : int.MaxValue)
        .Select(x => new DropDownItem { Text = x, Value = x });
    private IEnumerable<DropDownItem> CreateSlotOptions => CreateScope.Where(x => !string.IsNullOrEmpty(x.Slot))
        .Select(x => x.Slot!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(LocationMapNaming.FloorNumber)
        .Select(x => new DropDownItem { Text = $"{LocationMapNaming.FloorNumber(x)}F", Value = x });
    private IEnumerable<DropDownItem> WhOptions    => CodeOptions(_whCodes);
    private IEnumerable<DropDownItem> AreaOptions  => CodeOptions(_areaCodes
        .Where(x => !string.Equals(x.CodeValue, "SPARE_PARTS_AREA", StringComparison.OrdinalIgnoreCase)
            && x.ParentCodeID == $"WH_CODE_{_f.WhCode}")
        .ToList());
    private IEnumerable<DropDownItem> FilterAreaOptions => CodeOptions(_areaCodes.Where(x => _allRows.Any(r => r.AreaCode == x.CodeValue)).ToList());
    private IEnumerable<DropDownItem> AisleOptions => CodeOptions(_aisleCodes);
    private IEnumerable<DropDownItem> BayOptions   => CodeOptions(_bayCodes);
    private IEnumerable<DropDownItem> SlotOptions  => CodeOptions(_slotCodes);

    private static IEnumerable<DropDownItem> CodeOptions(List<MasterDataRepository.CodeItemRow> codes)
        => codes.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    // 코드값을 현재 언어의 공통코드 명칭으로 표시 (미정의 값은 원본 코드, 빈 값은 —)
    private static string CodeLabel(List<MasterDataRepository.CodeItemRow> codes, string? value)
        => string.IsNullOrEmpty(value) ? "—"
         : codes.FirstOrDefault(c => c.CodeValue == value) is { } ci ? MasterDataRepository.LocalName(ci) : value;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = AMES.Web.Services.ActorCode.Of(auth.User, "system");
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/fd/location");
        try { _whCodes    = MD.ListCodeItems("WH_CODE"); } catch { }
        try { _areaCodes  = MD.ListCodeItems("WH_AREA"); } catch { }
        try { _aisleCodes = MD.ListCodeItems("WH_AISLE"); } catch { }
        try { _bayCodes   = MD.ListCodeItems("WH_BAY");   } catch { }
        try { _slotCodes = MD.ListCodeItems("WH_SLOT"); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.LocationRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload()
    {
        _allRows = MD.ListLocations()
            .Where(x => !string.Equals(x.AreaCode, "SPARE_PARTS_AREA", StringComparison.OrdinalIgnoreCase))
            .ToList();
        ApplyFilter();
    }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.LocationID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.LocationName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fArea) || r.AreaCode == _fArea)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    private void RowRender(RowRenderEventArgs<MasterDataRepository.LocationRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.LocationRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new() { WhCode = "EOS", AreaCode = "MAT_AREA", Slot = "F1" }; _modalErr = ""; _modal = "create"; }

    void OpenEdit(MasterDataRepository.LocationRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = "";
        _f = new()
        {
            LocationID   = r.LocationID,
            LocationName = r.LocationName ?? "",
            WhCode       = r.WhCode,
            AreaCode     = r.AreaCode,
            Aisle        = r.Aisle        ?? "",
            Bay          = r.Bay          ?? "",
            Slot         = r.Slot         ?? "",
            Capacity     = r.Capacity,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        _busy = true;
        try
        {
            if (!WhOptions.Any(x => x.Value == _f.WhCode)) throw new InvalidOperationException("Select a Warehouse.");
            var area = _areaCodes.FirstOrDefault(x => x.UseFlag && x.CodeValue == _f.AreaCode && x.ParentCodeID == $"WH_CODE_{_f.WhCode}")
                ?? throw new InvalidOperationException("Select an Area in the chosen Warehouse.");
            if (!CreateSlotOptions.Any(x => x.Value == _f.Slot) || !CreateAisleOptions.Any(x => x.Value == _f.Aisle)
                || !CreateBayOptions.Any(x => x.Value == _f.Bay)) throw new InvalidOperationException("Select Aisle, Bay, and Slot.");
            var prefix = area.Attribute1;
            if (!LocationMapNaming.ValidPrefix(prefix))
            {
                prefix = LocationMapNaming.AvailablePrefix(_f.AreaCode, _areaCodes.Where(x => x.CodeValue != _f.AreaCode)
                    .SelectMany(x => new[] { x.CodeValue, x.Attribute1 }));
                Warehouse.SaveLocationMapAreaPrefix(_f.WhCode, _f.AreaCode, prefix);
                _areaCodes = MD.ListCodeItems("WH_AREA");
            }
            var existing = CreateScope.FirstOrDefault(x => x.Aisle == _f.Aisle && x.Bay == _f.Bay && x.Slot == _f.Slot);
            var created = existing?.LocationID ?? LocationMapNaming.LocationNo(prefix!, _f.Bay, _f.Aisle, _f.Slot);
            var name = string.IsNullOrWhiteSpace(_f.LocationName) ? created : _f.LocationName.Trim();
            if (name.Length > 60) throw new InvalidOperationException("Name must contain at most 60 characters.");
            if (_f.Capacity is not null && _f.Capacity != decimal.Truncate(_f.Capacity.Value)) throw new InvalidOperationException("Load Capacity must be a whole number.");
            if (existing is not null) throw new InvalidOperationException("This location already exists. Select its row to edit it.");
            if (MD.LocationExists(created)) throw new InvalidOperationException($"Location ID {created} already exists.");
            MD.InsertLocation(created, name, _f.WhCode, _f.AreaCode, null, _f.Aisle, _f.Bay, _f.Slot,
                _f.Capacity, null, null, true, _actor);
            Audit.Created("MD-018", "MD_Location", created, _f);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Location.Ok.Created"].Value, created), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            if (_f.Capacity is not null && _f.Capacity != decimal.Truncate(_f.Capacity.Value)) throw new InvalidOperationException("Load Capacity must be a whole number.");
            MD.UpdateLocation(_sel.LocationID, NE(_f.LocationName), _sel.WhCode, _sel.AreaCode, _sel.ZoneCode,
                _sel.Aisle, _sel.Bay, _sel.Slot,
                _f.Capacity, _sel.LocationType, _sel.PlantCode, _sel.ActiveFlag, _actor);
            Audit.Updated("MD-018", "MD_Location", _sel.LocationID, _sel, _f);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Location.Ok.Updated"].Value, _sel.LocationID), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
    
    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string   LocationID   { get; set; } = "";
        public string   LocationName { get; set; } = "";
        public string   WhCode       { get; set; } = "EOS";
        public string   AreaCode     { get; set; } = "MAT_AREA";
        public string   Aisle        { get; set; } = "";
        public string   Bay          { get; set; } = "";
        public string   Slot         { get; set; } = "";
        public decimal? Capacity     { get; set; }
    }
}
