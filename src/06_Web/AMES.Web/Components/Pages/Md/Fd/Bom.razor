@page "/md/fd/bom"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AMES.Web.Services.ActorNames Actors
@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L
@inject AMES.Web.Services.AuditLogger Audit
@inject UomFormat UomFmt
@inject IJSRuntime JS

<PageTitle>MD-004 @L["MD.Bom.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-004" TitleKey="MD.Bom.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Bom.Kpi.Products"]</div>
        <div class="ames-kpi-v">@_bomKpi.BomProducts</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Bom.Kpi.TotalComponents"]</div>
        <div class="ames-kpi-v">@_bomKpi.TotalComponents</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Bom.Kpi.AvgParts"]</div>
        <div class="ames-kpi-v">@(_bomKpi.BomProducts > 0 ? ((decimal)_bomKpi.TotalComponents / _bomKpi.BomProducts).ToString("N1") : "—")</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["MD.Bom.Kpi.SelMaterialCost"]</div>
        <div class="ames-kpi-v">@(_selVer is null ? "—" : _selMaterialCost.ToString("N2"))</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div style="display:flex;gap:14px;height:calc(100vh - 200px);">

    @* ── 좌: 버전 목록 ─────────────────────────────────────────────────── *@
    <div style="flex:0 0 630px;display:flex;flex-direction:column;min-height:0;">
        <div class="ames-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;margin-bottom:0;">
            <div class="ames-card-h" style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                    <RadzenTextBox @bind-Value="_search" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Bom.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:2;" />
                    <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
                    <RadzenDropDown Name="DropDownStatus" @bind-Value="_statusFilter" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem" Wrap="FlexWrap.Wrap" Style="width:100%;" class="bom-toolbar">
                    <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
                    <RadzenDropDown Name="DropDownType" @bind-Value="_typeFilter" Data="@ItemTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;min-width:110px;" />

                    <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Search" class="ames-rz-btn" />
                    @if (_canEdit) {
                        <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenVersionCreate" class="ames-rz-btn" />
                    }
                    <RadzenButton Text="@L["Excel.Download"]" Icon="download" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ExcelDownload" title="@L["Excel.Download.Hint"]" class="ames-rz-btn" />
                    @if (_canEdit)
                    {
                        <RadzenButton Text="@L["Excel.Upload"]" Icon="upload" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => _excelOpen = true)" class="ames-rz-btn" />
                    }
                </RadzenStack>
            </div>
            <div style="flex:1;min-height:0;overflow:hidden;">
                <RadzenDataGrid @ref="_verGrid" Page="OnVerPage" TItem="MasterDataRepository.BomVersionRow" Data="_versions" AllowPaging="true" PageSize="VerPageSize" PagerHorizontalAlign="HorizontalAlign.Center"
                                ShowPagingSummary="false" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" RowRender="VerRowRender" RowSelect="OnVerRowSelect" EmptyText="@L["MD.Bom.NoVersions"]" Class="ames-rz-grid ames-grid-fill">
                    <Columns>
                        <RadzenDataGridColumn TItem="MasterDataRepository.BomVersionRow" Property="RootItemNo" Title="@L["Col.RootItemNo"]">
                            <Template Context="v">
                                <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    <span style="font-weight:700;font-size:.9em;">@v.RootItemNo</span>
                                    @if (!string.IsNullOrEmpty(v.VersionNo))
                                    {
                                        <span class="dim" style="font-size:.8em;font-weight:400;margin-left:5px;">@v.VersionNo</span>
                                    }
                                    @if (!string.IsNullOrEmpty(v.RootItemName))
                                    {
                                        <span class="dim" style="font-size:.78em;margin-left:5px;">@v.RootItemName</span>
                                    }
                                </div>
                                <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    <span class="code dim" style="font-size:.72em;">@v.VersionID</span>
                                    @if (v.EffFrom.HasValue || v.EffTo.HasValue)
                                    {
                                        <span class="dim" style="font-size:.72em;margin-left:8px;">📅 @Period(v.EffFrom, v.EffTo)</span>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MasterDataRepository.BomVersionRow" Property="SAPFlag" Title="@L["Col.Sap"]" TextAlign="TextAlign.Center" Width="70px">
                            <Template Context="v">
                                @if (v.SAPFlag) { <RadzenIcon Icon="check_circle" Style="color:var(--ames-tx-green-400);vertical-align:middle;" /> }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MasterDataRepository.BomVersionRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="100px">
                            <Template Context="v"><span class="pill @StatusCss(v.Status)">@StatusName(v.Status)</span></Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </div>

    @* ── 우: 버전 상세 + BOM 라인 ─────────────────────────────────────── *@
    <div style="flex:1;min-width:0;display:flex;flex-direction:column;min-height:0;">
        <div class="ames-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;margin-bottom:0;">

            @if (_selVer is null && _usedItem is null)
            {
                <div style="flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;">
                    <div style="font-size:2.4em;opacity:.15;">📋</div>
                    <div class="dim" style="font-size:.9em;">@L["MD.Bom.SelectVersionHint"]</div>
                </div>
            }
            else if (_selVer is null)
            {
                @* BOM 버전이 없는 품번(원자재 등)을 검색 — 그 품번을 구성품으로 쓰는 상위 BOM 만 흐리게(읽기 전용) 보인다 *@
                <div class="ames-info-bar">
                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                        <span style="font-weight:700;font-size:.95em;">@_usedItem</span>
                        <span class="dim" style="font-size:.85em;">@_itemList.FirstOrDefault(i => string.Equals(i.ItemNo, _usedItem, StringComparison.OrdinalIgnoreCase))?.ItemName</span>
                        <span class="pill mute">@L["MD.Bom.NoVersion"]</span>
                    </div>
                    <div class="dim" style="font-size:.79em;margin-top:3px;">@L["MD.Bom.WhereUsedHint"]</div>
                </div>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding:4px 0 6px;">
                    <span class="dim" style="font-size:.82em;">@string.Format(L["MD.Bom.WhereUsedCount"], _displayLines.Count, _displayLines.Count(l => l.BOMLevel == -1))</span>
                </RadzenStack>
                @LineGrid(false, L["MD.Bom.NoParents"])
            }
            else
            {
                @* ─── 선택된 버전 정보 헤더 ─── *@
                <div class="ames-info-bar">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;">

                        <div style="min-width:0;flex:1;">
                            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                <span style="font-weight:700;font-size:.95em;">@_selVer.RootItemNo</span>
                                @if (!string.IsNullOrEmpty(_selVer.RootItemName))
                                {
                                    <span class="dim" style="font-size:.85em;">@_selVer.RootItemName</span>
                                }
                                <span class="pill @StatusCss(_selVer.Status)">@StatusName(_selVer.Status)</span>
                                @if (!string.IsNullOrEmpty(_selVer.VersionNo))
                                {
                                    <span class="dim code" style="font-size:.82em;border:1px solid var(--ames-bd-white-a10);padding:1px 7px;border-radius:4px;">@_selVer.VersionNo</span>
                                }
                                @if (_selVer.SAPFlag)
                                {
                                    <span class="pill info" style="font-size:.72em;" title="@L["Lbl.SapData"]">SAP</span>
                                }
                            </div>
                            <div class="dim code" style="font-size:.79em;margin-top:3px;">
                                @_selVer.VersionID
                                @if (_selVer.EffFrom.HasValue || _selVer.EffTo.HasValue)
                                {
                                    <span style="margin-left:10px;">📅 @Period(_selVer.EffFrom, _selVer.EffTo)</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_selVer.ChangeType) || !string.IsNullOrEmpty(_selVer.ChangeReason))
                            {
                                <div class="dim" style="font-size:.78em;margin-top:2px;">
                                    @if (!string.IsNullOrEmpty(_selVer.ChangeType)) { <span>@_selVer.ChangeType</span> }
                                    @if (!string.IsNullOrEmpty(_selVer.ChangeType) && !string.IsNullOrEmpty(_selVer.ChangeReason)) { <span> — </span> }
                                    @_selVer.ChangeReason
                                </div>
                            }
                            @if (_selVer.Status == "PENDING" && !string.IsNullOrEmpty(_selVer.RequestedBy))
                            {
                                <div style="font-size:.78em;color:var(--ames-tx-amber-400);margin-top:2px;">@L["MD.Bom.ApprovalRequester"]: @Actors.Display(_selVer.RequestedBy)</div>
                            }
                            @if (_selVer.Status == "APPROVED" && !string.IsNullOrEmpty(_selVer.ApprovedBy))
                            {
                                <div style="font-size:.78em;color:var(--ames-tx-green-300);margin-top:2px;">@L["MD.Bom.ApprovedBy"]: @Actors.Display(_selVer.ApprovedBy)  @(_selVer.ApprovedTS?.ToString(DateFmt.DateTime))</div>
                            }
                        </div>

                        @* 워크플로 버튼 — 초안 편집·승인 요청·되살리기는 수정 권한(E), 승인·반려는 승인 권한(A) *@
                        @if (_canEdit || _canApprove)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem" Wrap="FlexWrap.Wrap" Style="flex-shrink:0;">
                                @if (_selVer.Status == "DRAFT" && _canEdit) {
                                    <RadzenButton Text="@L["Btn.Edit"]" Icon="edit" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="() => OpenVersionEdit(_selVer)" Disabled="@_busy" class="ames-rz-btn" />
                                    <RadzenButton Text="@L["MD.Bom.AddItem"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenLineCreate" Disabled="@_busy" class="ames-rz-btn" />
                                    <RadzenButton Text="@L["MD.Bom.RequestApproval"]" Icon="send" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="@DoRequestApproval" Disabled="@(_busy || _lines.Count(l => l.ActiveFlag) == 0)" title="@(_lines.Count(l => l.ActiveFlag) == 0 ? L["MD.Bom.NeedRequestHint"].Value : "")" class="ames-rz-btn" />
                                    @if (!_verDelConfirm)
                                    {
                                        <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => _verDelConfirm = true' Disabled="@_busy" class="ames-rz-btn" />
                                    }
                                }
                                @if (_selVer.Status == "PENDING" && _canApprove)
                                {
                                    <RadzenButton Text="@L["Btn.Approve"]" Icon="check_circle" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@DoApprove" Disabled="@(_busy || _lines.Count(l => l.ActiveFlag) == 0)" title="@(_lines.Count(l => l.ActiveFlag) == 0 ? L["MD.Bom.NeedApprovalHint"].Value : "")" class="ames-rz-btn" />
                                    <RadzenButton Text="@L["Btn.Reject"]" Icon="block" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DoReject" Disabled="@_busy" class="ames-rz-btn" />
                                }
                                @if (_selVer.Status == "REJECTED" && _canEdit)
                                {
                                    <RadzenButton Text="@L["MD.Bom.ReviveDraft"]" Icon="restore" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@DoRevive" Disabled="@_busy" class="ames-rz-btn" />
                                }
                            </RadzenStack>
                        }
                    </div>

                    @* 삭제 인라인 확인 *@
                    @if (_verDelConfirm)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm" Style="margin-top:8px;">
                            <span>@string.Format(L["MD.Bom.ConfirmDeleteVersion"], _selVer.VersionID)</span>
                            <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _verDelConfirm = false' class="ames-rz-btn" />
                            <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DoVersionDelete" Disabled="@_busy" class="ames-rz-btn" />
                        </RadzenStack>
                    }
                </div>

                @* 라인 카운트 + 읽기 전용 안내 *@
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding:4px 0 6px;">
                    <span class="dim" style="font-size:.82em;">@string.Format(L["MD.Bom.LineCount"], _lines.Count)</span>
                    @{ int upperRows = _displayLines.Count(l => (l.BOMLevel ?? 0) < 0); }
                    @if (upperRows > 0)
                    {
                        <span class="dim" style="font-size:.78em;">@string.Format(L["MD.Bom.UpperCount"], upperRows)</span>
                    }
                    @if (_explodedIds.Count > 0)
                    {
                        <span class="dim" style="font-size:.78em;">@string.Format(L["MD.Bom.ExplodedCount"], _displayLines.Count - _lines.Count - upperRows)</span>
                    }
                    @if (_selVer.Status != "DRAFT")
                    {
                        <span class="dim" style="font-size:.78em;">@L["MD.Bom.DraftOnly"]</span>
                    }
                </RadzenStack>

                @* BOM 라인 그리드 *@
                @LineGrid(_selVer.Status == "DRAFT" && _canEdit)
            }
        </div>
    </div>
</div>

@if (_excelOpen)
{
    <ExcelImportModal Title="@L["MD.Bom.Title"]" Parse="@ExcelParse" Apply="@ExcelApply" ColumnLabel="@ExcelLabel" OnClose="@ExcelClosed" />
}

@* ── BOM 버전 등록 모달 ─────────────────────────────────────────────── *@
@if (_modal == "ver-create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Bom.Title"] — @L["Modal.Create"]</div>
            @VersionFormFields(false)
            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveVersionCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── BOM 버전 수정 모달 (DRAFT only) ────────────────────────────────── *@
@if (_modal == "ver-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Bom.Title"] — @L["Modal.Edit"] <span class="code" style="font-weight:400;font-size:.9em;">@_fv.VersionId</span>@if (_selVer?.SAPFlag == true) { <span class="pill info" style="margin-left:6px;font-size:.72em;" title="@L["Lbl.SapData"]">SAP</span> }</div>
            @VersionFormFields(true)
            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveVersionEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── BOM 라인 추가 모달 ─────────────────────────────────────────────── *@
@if (_modal == "line-create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Bom.Modal.AddLine"] — <span class="code" style="font-weight:400;font-size:.9em;">@_selVer!.VersionID</span></div>
            @LineFormFields()
            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Add"])" Click="@SaveLineCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── BOM 라인 수정/삭제 모달 ────────────────────────────────────────── *@
@if (_modal == "line-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">BOM — @L["Modal.Edit"] <span class="code" style="font-weight:400;font-size:.9em;">@_fl.CompItemNo</span></div>
            @LineFormFields()
            @if (_lineConfirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.Bom.ConfirmDeleteLine"], _fl.CompItemNo)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _lineConfirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveLineDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveLineEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                @if (_fl.ActiveFlag)
                {
                    <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _lineConfirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                }
                else
                {
                    <RadzenButton Text="@L["MD.Bom.ReactivateLine"]" Click="@SaveLineReactivate" Disabled="@_busy" Icon="restart_alt" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" class="ames-rz-btn" />
                }
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.BomVersionRow> _versions = new();
    List<MasterDataRepository.BomRow>        _lines    = new();
    List<MasterDataRepository.BomRow>        _displayLines = new();
    readonly HashSet<string>                 _explodedIds  = new();
    readonly HashSet<string>                 _upperIds     = new();
    List<MasterDataRepository.ItemRow>       _itemList = new();
    List<MasterDataRepository.UomRow>        _uomList  = new();
    MasterDataRepository.BomVersionRow?      _selVer;
    MasterDataRepository.BomKpiRow           _bomKpi = new(0, 0);
    List<MasterDataRepository.CodeItemRow>   _itemTypeItems = new();
    List<MasterDataRepository.CodeItemRow>   _statusItems = new();
    string _statusFilter = "";
    string? _typeFilter;
    string _search       = "";

    // 선택 버전의 자재비 = Σ(구성품 QtyPer × 품목 단가)
    decimal _selMaterialCost => _lines.Where(l => l.ActiveFlag).Sum(l =>
        (l.QtyPer ?? 0m) * (_itemList.FirstOrDefault(i => i.ItemNo == l.CompItemNo)?.UnitCost ?? 0m));

    string _modal = "", _modalErr = "", _msg = "";
    bool   _isErr, _busy, _bgDown;
    bool   _verDelConfirm, _lineConfirmDelete;
    bool   _canEdit, _canApprove;
    string _actor = "system";

    VersionForm _fv = new();
    LineForm    _fl = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ItemOptions => _itemList.Select(i => new DropDownItem { Value = i.ItemNo, Text = $"[{i.ItemNo}] {i.ItemName}" });
    private IEnumerable<DropDownItem> ItemTypeOptions => _itemTypeItems.Where(t => t.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    private IEnumerable<DropDownItem> UomOptions => _uomList.Where(u => u.ActiveFlag).Select(u => new DropDownItem { Value = u.UOMCode ?? "", Text = u.UOMCode + (string.IsNullOrEmpty(u.UOMName) ? "" : $"  ({u.UOMName})") });
    // 상태 값·이름은 공통코드 BOM_STATUS (DRAFT·PENDING·APPROVED·REJECTED·EXPIRED)
    private List<DropDownItem> StatusFilterOptions =>
        new List<DropDownItem> { new() { Value = "", Text = L["Filter.All"].Value } }
            .Concat(_statusItems.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) }))
            .ToList();

    string StatusName(string? code)
    {
        var item = _statusItems.FirstOrDefault(s => string.Equals(s.CodeValue, code, StringComparison.OrdinalIgnoreCase));
        return item is null ? code ?? "" : MasterDataRepository.LocalName(item);
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor   = AMES.Web.Services.ActorCode.Of(auth.User, "system");
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/fd/bom");
        _canApprove = PermSvc.CanApprove("md/fd/bom");
        try { _itemList = MD.ListItems(); } catch { }
        try { _uomList  = MD.ListUoms();  } catch { }
