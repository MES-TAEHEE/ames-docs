        // 만료(EXPIRED)·유효기간(종료일)이 지난 버전은 흐리게
        if (args.Data?.Status == "EXPIRED" || (args.Data?.EffTo is { } to && to < DateOnly.FromDateTime(DbClock.Today))) args.Attributes["style"] = "opacity:.5;";
    }

    void LineRowRender(RowRenderEventArgs<MasterDataRepository.BomRow> args, bool editable)
    {
        if (args.Data is not null && _explodedIds.Contains(args.Data.BOMID))
        {
            args.Attributes["style"] = "opacity:.6;";
            args.Attributes["title"] = string.Format(L["MD.Bom.ExplodedFrom"], args.Data.VersionID);
            return;
        }
        if (args.Data is not null && _upperIds.Contains(args.Data.BOMID))
        {
            args.Attributes["style"] = "opacity:.6;";
            args.Attributes["title"] = string.Format(L["MD.Bom.UpperFrom"], args.Data.ParentItemNo, args.Data.VersionID);
            return;
        }
        if (!editable) return;
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

