    void LoadVersions()
    {
        // 종료일이 지난 승인 버전은 읽을 때마다 EXPIRED 로 바꾼다(규칙: MasterDataRepository.ExpireBomVersions)
        try
        {
            foreach (var id in MD.ExpireBomVersions(_actor))
                Audit.Log("MD-004", "EXPIRE", "MD_BomVersion", id, new { Status = "APPROVED" }, new { Status = "EXPIRED" });
        }
        catch { }
        try
        {
            _versions = MD.ListBomVersions(string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var q = _search.Trim();
                _versions = _versions
                    .Where(v => (v.RootItemNo?.Contains(q, StringComparison.OrdinalIgnoreCase) == true)
                             || (v.RootItemName?.Contains(q, StringComparison.OrdinalIgnoreCase) == true))
                    .ToList();
            }
            if (!string.IsNullOrEmpty(_typeFilter))
            {
                var typeOf = _itemList.ToDictionary(i => i.ItemNo, i => i.ItemType, StringComparer.OrdinalIgnoreCase);
                _versions = _versions
                    .Where(v => v.RootItemNo is not null && typeOf.TryGetValue(v.RootItemNo, out var t) && t == _typeFilter)
                    .ToList();
            }
        }
        catch { _versions = new(); }
        try { _bomKpi = MD.BomKpi(); } catch { }
    }

    void LoadLines()
    {
        try { _lines = _selVer is null ? new() : MD.ListBomLines(_selVer.VersionID); } catch { _lines = new(); }
        ExplodeLines();
        try { _bomKpi = MD.BomKpi(); } catch { }   // 라인 증감 시 Total Components 갱신
    }

    // BOM 행은 부모 품번별 버전에 직접 자식(LV1)만 있으므로, 구성품이 자기 BOM 을 가지면
    // 그 품번의 대표 버전 라인을 아래에 이어 붙여 LV2·LV3… 로 보인다. 붙인 행은 다른 버전 소속이라 읽기 전용.
    void ExplodeLines()
    {
        _displayLines = new();
        _explodedIds.Clear();
        _upperIds.Clear();
        if (_selVer is null) return;
        List<MasterDataRepository.BomVersionRow> all;
        try { all = MD.ListBomVersions(); } catch { _displayLines = _lines.ToList(); return; }
        var cache = new Dictionary<string, List<MasterDataRepository.BomRow>>(StringComparer.OrdinalIgnoreCase);

        void Add(IEnumerable<MasterDataRepository.BomRow> rows, int level, HashSet<string> path, bool exploded)
        {
            foreach (var row in rows)
            {
                var shown = exploded ? row with { BOMLevel = level } : row;
                _displayLines.Add(shown);
                if (exploded) _explodedIds.Add(row.BOMID);
                var comp = row.CompItemNo;
                if (!row.ActiveFlag || string.IsNullOrEmpty(comp) || level >= 9 || path.Contains(comp)) continue;
                var ver = RepresentativeVersion(all, comp);
                if (ver is null) continue;
                if (!cache.TryGetValue(ver.VersionID, out var sub))
                {
                    try { sub = MD.ListBomLines(ver.VersionID); } catch { sub = new(); }
                    cache[ver.VersionID] = sub;
                }
                Add(sub, (shown.BOMLevel ?? level) + 1, new HashSet<string>(path, StringComparer.OrdinalIgnoreCase) { comp }, true);
            }
        }

        AddUpper(all, _selVer.RootItemNo);
        Add(_lines, 1, new HashSet<string>(StringComparer.OrdinalIgnoreCase) { _selVer.RootItemNo ?? "" }, false);
    }

    // 상위 BOM 역전개 — 이 품번을 쓰는 부모 품번의 대표 버전 라인을 목록 위에 LV -1·-2… 로 흐리게 보인다(읽기 전용).
    // 맨 위 부모부터 내려오도록 부모의 상위를 먼저 붙인다.
    void AddUpper(List<MasterDataRepository.BomVersionRow> all, string? rootItemNo)
    {
        if (string.IsNullOrEmpty(rootItemNo)) return;
        var cache = new Dictionary<string, List<MasterDataRepository.BomRow>>(StringComparer.OrdinalIgnoreCase);

        void Up(string item, int level, HashSet<string> path)
        {
            if (!cache.TryGetValue(item, out var used))
            {
                try { used = MD.ListBomWhereUsed(item); } catch { used = new(); }
                used = used.Where(r => r.ParentItemNo is { } p && RepresentativeVersion(all, p)?.VersionID == r.VersionID).ToList();
                cache[item] = used;
            }
            foreach (var row in used)
            {
                var parent = row.ParentItemNo!;
                if (path.Contains(parent)) continue;
                if (level > -9) Up(parent, level - 1, new HashSet<string>(path, StringComparer.OrdinalIgnoreCase) { parent });
                _displayLines.Add(row with { BOMLevel = level });
                _upperIds.Add(row.BOMID);
            }
        }

        Up(rootItemNo, -1, new HashSet<string>(StringComparer.OrdinalIgnoreCase) { rootItemNo });
    }

    // 하위 BOM 대표 버전 — 규칙 정본 BomVersionRules.Representative (BOP 상하위 조회와 공용)
    static MasterDataRepository.BomVersionRow? RepresentativeVersion(List<MasterDataRepository.BomVersionRow> all, string itemNo)
    {
        var rep = AMES.Data.Services.BomVersionRules.Representative(all.Select(MasterDataRepository.ToVersionInfo), itemNo, DateOnly.FromDateTime(DbClock.Today));
        return rep is null ? null : all.First(v => v.VersionID == rep.VersionId);
    }

    void SelectVersion(MasterDataRepository.BomVersionRow v) { _selVer = v; _verDelConfirm = false; LoadLines(); }

    void OnSearchChanged(string value) => _search = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") Search(); }

    // 검색어가 품번과 정확히 같고 그 품번의 BOM 버전이 목록에 없으면(원자재 등) 우측에 상위 BOM 을 보인다(10-20)
    string? _usedItem;

    void Search()
    {
        LoadVersions();
        _usedItem = null;
        var q = (_search ?? "").Trim();
        if (q.Length == 0) return;
        var item = _itemList.FirstOrDefault(i => string.Equals(i.ItemNo, q, StringComparison.OrdinalIgnoreCase));
        if (item is null || _versions.Any(v => string.Equals(v.RootItemNo, item.ItemNo, StringComparison.OrdinalIgnoreCase))) return;
        _usedItem = item.ItemNo;
        _selVer = null; _verDelConfirm = false; _linePage = 0;
        _lines = new(); _displayLines = new(); _explodedIds.Clear(); _upperIds.Clear();
        try { AddUpper(MD.ListBomVersions(), _usedItem); } catch { }
    }

