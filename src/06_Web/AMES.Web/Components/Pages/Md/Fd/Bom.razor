            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["Col.ScrapRate"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_fl.ScrapPct" Min="0" Step="0.01" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>
        @if (UomLocked)
        {
            <div class="dim" style="font-size:.78em;margin-top:4px;">🔒 @L["MD.Bom.Hint.UomLocked"]</div>
        }

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["Col.Seq"]" />
                <RadzenNumeric TValue="int" @bind-Value="_fl.Position" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="8">
                <RadzenLabel Text="@L["Col.Note"]" />
                <RadzenTextBox @bind-Value="_fl.Note" MaxLength="@NoteMax" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>
    </div>;

    class VersionForm
    {
        public string    VersionId    { get; set; } = "";
        public string    RootItemNo   { get; set; } = "";
        public string    VersionNo    { get; set; } = "";
        public DateOnly? EffFrom      { get; set; }
        public DateOnly? EffTo        { get; set; }
        public string    ChangeType   { get; set; } = "";
        public string    ChangeReason { get; set; } = "";
    }

    class LineForm
    {
        public string  BomId        { get; set; } = "";
        public string  ParentItemNo { get; set; } = "";
        public string  CompItemNo   { get; set; } = "";
        public int     BomLevel     { get; set; } = 1;
        public decimal QtyPer       { get; set; } = 1;
        public string  Uom          { get; set; } = "EA";
        public decimal ScrapPct     { get; set; } = 0;
        public int     Position     { get; set; } = 10;
        public string  Note         { get; set; } = "";
        public bool    ActiveFlag   { get; set; } = true;
    }
}
