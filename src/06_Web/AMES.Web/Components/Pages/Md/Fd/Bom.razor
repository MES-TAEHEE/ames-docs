    int _msgSeq;
    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        var seq = ++_msgSeq;   // 앞 메시지의 타이머가 새 메시지를 지우지 않게
        _ = Task.Delay(4000).ContinueWith(_ => { if (seq != _msgSeq) return; _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string StatusCss(string? s) => s switch
    {
        "DRAFT"    => "info",
        "PENDING"  => "warn",
        "APPROVED" => "ok",
        "REJECTED" => "bad",
        "EXPIRED"  => "mute",
        _          => ""
    };

    const int VerPageSize = 16;   // 좌측 버전 목록 — 16행 고정, 페이지 크기 선택기 없음
    const int NoteMax = 120, ChangeReasonMax = 200;   // MD_Bom.Note nvarchar(120) · MD_BomVersion.ChangeReason nvarchar(200)
    RadzenDataGrid<MasterDataRepository.BomVersionRow>? _verGrid;
    RadzenDataGrid<MasterDataRepository.BomRow>?        _lineGrid;
    int _verPage, _linePage;
    void OnVerPage(PagerEventArgs args)  => _verPage  = args.PageIndex;
    void OnLinePage(PagerEventArgs args) => _linePage = args.PageIndex;

    // 데이터 재로딩 후 버전/라인 목록의 현재 페이지를 유지
    async Task RestorePages()
    {
        await InvokeAsync(StateHasChanged);
        if (_verGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_versions.Count / (double)_verGrid.PageSize));
            await _verGrid.GoToPage(Math.Min(_verPage, pages - 1));
        }
        if (_lineGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_displayLines.Count / (double)_lineGrid.PageSize));
            await _lineGrid.GoToPage(Math.Min(_linePage, pages - 1));
        }
    }

    async Task RefreshVersion(string versionId)
    {
        LoadVersions();
        _selVer = _versions.FirstOrDefault(v => v.VersionID == versionId);
        LoadLines();
        await RestorePages();
    }

    // 라인 저장이 0행 — 버전이 그사이 승인 요청·승인돼 더 이상 DRAFT 가 아니다. 모달을 닫고 상태를 새로 읽어 안내한다
    async Task LineNotDraft()
    {
        var id = _selVer?.VersionID;
        CloseModal();
        if (id is not null) { await StatusChanged(id); LoadLines(); }
    }

    // 오래 열린 화면에서 다른 사용자가 먼저 상태를 바꾼 경우 — 감사 로그 없이 새로 읽고 안내만 한다
    async Task StatusChanged(string versionId)
    {
        await RefreshVersion(versionId);
        ShowMsg(string.Format(L["MD.Bom.Err.StatusChanged"], versionId), true);
    }

    // ── 워크플로 액션 (모달 없음) ─────────────────────────────────────────
    async Task DoRequestApproval()
    {
        if (!_canEdit) return;
        if (_selVer is null) return;
        if (_lines.Count(l => l.ActiveFlag) == 0) { ShowMsg(L["MD.Bom.NeedRequestHint"], true); return; }
        var id = _selVer.VersionID;
        _busy = true;
        try
        {
            if (!MD.RequestBomApproval(id, _actor)) { await StatusChanged(id); return; }
            Audit.Log("MD-004", "REQUEST", "MD_BomVersion", id, _selVer, new { Status = "PENDING" });
            await RefreshVersion(id);
            ShowMsg($"{id} {L["Msg.ApprovalRequested"]}", false);
        }
        // 화면을 연 사이 다른 사용자가 마지막 라인을 지웠다 — 라인을 새로 읽고 안내한다
        catch (MasterDataRepository.BomHasNoLinesException) { await RefreshVersion(id); ShowMsg(L["MD.Bom.NeedRequestHint"], true); }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    async Task DoApprove()
    {
        if (!_canApprove) return;
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try
        {
            var before = _selVer;
            var prior  = MD.ListBomVersions("APPROVED").ToDictionary(v => v.VersionID);
            var plan   = MD.ApproveBomVersion(id, _actor);
            if (plan is null) { await StatusChanged(id); return; }
            if (plan.Conflict is not null) { ShowMsg(string.Format(L["MD.Bom.Err.ApproveConflict"], plan.Conflict), true); return; }
            foreach (var (closedId, newTo) in plan.Close)
                Audit.Log("MD-004", "SUPERSEDE", "MD_BomVersion", closedId,
                    new { EffTo = prior.TryGetValue(closedId, out var p) ? p.EffTo : null }, new { EffTo = newTo, SupersededBy = id });
            Audit.Log("MD-004", "APPROVE", "MD_BomVersion", id, before, new { Status = "APPROVED", Superseded = plan.Close.Select(c => c.VersionId).ToList() });
            await RefreshVersion(id);
            var msg = $"{id} {L["Msg.Approved"]}";
            if (plan.Close.Count > 0) msg += " · " + string.Format(L["MD.Bom.Msg.Superseded"], string.Join(", ", plan.Close.Select(c => $"{c.VersionId} → {c.NewTo.ToString(DateFmt.Date)}")));
            ShowMsg(msg, false);
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    async Task DoReject()
    {
        if (!_canApprove) return;
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try
        {
            if (!MD.RejectBomVersion(id, _actor)) { await StatusChanged(id); return; }
            Audit.Log("MD-004", "REJECT", "MD_BomVersion", id, _selVer, new { Status = "REJECTED" });
            await RefreshVersion(id);
            ShowMsg($"{id} {L["Msg.Rejected"]}", true);
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    async Task DoRevive()
    {
        if (!_canEdit) return;
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try
        {
            if (!MD.ReviveBomVersion(id, _actor)) { await StatusChanged(id); return; }
            Audit.Log("MD-004", "REVIVE", "MD_BomVersion", id, _selVer, new { Status = "DRAFT" });
            await RefreshVersion(id);
            ShowMsg($"{id} {L["Msg.Revived"]}", false);
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    async Task DoVersionDelete()
    {
        if (!_canEdit) return;
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try
        {
            var lines = _lines.ToList();
            if (!MD.DeleteBomVersion(id)) { _verDelConfirm = false; await StatusChanged(id); return; }
            // 버전 삭제는 라인도 물리 삭제하므로 전 스냅샷에 라인을 함께 남긴다
            Audit.Deleted("MD-004", "MD_BomVersion", id, new { Version = _selVer, Lines = lines });
            _selVer = null; _lines = new(); _verDelConfirm = false;
            LoadVersions();
            await RestorePages();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    // ── Version CRUD ──────────────────────────────────────────────────────
    void OpenVersionCreate()
    {
        // 종료일은 비워 두면 무기한("~") — 다음 버전 승인 때 그 시작일 전날로 닫힌다
        _fv = new() { EffFrom = DateOnly.FromDateTime(DbClock.Today) };
        _modalErr = ""; _modal = "ver-create";
    }

    // 등록 창에서 최상위 품목을 고르면 시작일을 직전 버전 종료일 다음 날로 이어 붙인다(없거나 지난 날이면 오늘)
    void OnRootChanged(object? _)
    {
        if (_modal != "ver-create" || string.IsNullOrWhiteSpace(_fv.RootItemNo)) return;
        try
        {
            var all = MD.ListBomVersions().Select(MasterDataRepository.ToVersionInfo);
            var today = DateOnly.FromDateTime(DbClock.Today);
            var start = AMES.Data.Services.BomVersionRules.DefaultStart(all, _fv.RootItemNo, today);
            _fv.EffFrom = start < today ? today : start;
        }
        catch { }
    }

    // 키 입력마다 브라우저에서 숫자·점 하나·각 3자리 외의 글자를 지운다(서버 왕복 없이 입력 자체를 막음)
    const string VersionMaskJs = @"let v=this.value.replace(/[^0-9.]/g,'').replace(/^\./,'');const i=v.indexOf('.');v=i<0?v.slice(0,3):v.slice(0,i).slice(0,3)+'.'+v.slice(i+1).replace(/\./g,'').slice(0,3);if(this.value!==v)this.value=v;";

    string VersionDigits => (_fv.VersionNo ?? "").TrimStart('V', 'v');

    void OnVersionDigitsChanged(string value)
    {
        var digits = (value ?? "").Trim().TrimEnd('.');
        if (digits.Length == 0) { _fv.VersionNo = ""; return; }
        if (AMES.Data.Services.BomVersionRules.TryNormalizeVersionNo(digits, out var v)) { _fv.VersionNo = v; _modalErr = ""; }
    }

    // 저장 직전 — 버전 번호는 필수이고 V{주}.{부} 형식으로만 저장한다
    bool VersionNoInvalid()
    {
        if (AMES.Data.Services.BomVersionRules.TryNormalizeVersionNo(_fv.VersionNo, out var v)) { _fv.VersionNo = v; return false; }
        _modalErr = L["MD.Bom.Err.VersionNoFormat"];
        return true;
    }

    // 등록 때 시작일·종료일은 오늘(DB 날짜)부터 — 달력은 지난 날을 막고, 직접 입력한 지난 날은 달력이 지우므로 시작일은 필수로 저장 직전에 다시 본다(10-20)
    DateTime TodayMin => DbClock.Today;
    DateTime EndMin => _fv.EffFrom is { } f && f.ToDateTime(TimeOnly.MinValue) > DbClock.Today ? f.ToDateTime(TimeOnly.MinValue) : DbClock.Today;

    bool CreateDatesInvalid()
    {
        var today = DateOnly.FromDateTime(DbClock.Today);
        if (_fv.EffFrom is null) { _modalErr = L["MD.Bom.Err.StartRequired"]; return true; }   // 비우면 처음부터 유효(= 지난 날)로 읽히므로 필수
        if (_fv.EffFrom < today || _fv.EffTo < today) { _modalErr = L["MD.Bom.Err.PastDate"]; return true; }
        if (_fv.EffFrom is { } f && _fv.EffTo is { } t && t < f) { _modalErr = L["Err.DateRange"]; return true; }
        return false;
    }

    // 유효기간 표시 — 종료일이 없으면 "시작일 ~" 로 계속 유효함을 보인다
    static string Period(DateOnly? from, DateOnly? to)
        => $"{from?.ToString(DateFmt.Date)} ~ {to?.ToString(DateFmt.Date)}".Trim();

    void OpenVersionEdit(MasterDataRepository.BomVersionRow v)
    {
        _fv = new()
        {
            VersionId    = v.VersionID,
            RootItemNo   = v.RootItemNo   ?? "",
            VersionNo    = v.VersionNo    ?? "",
            EffFrom      = v.EffFrom,
            EffTo        = v.EffTo,
            ChangeType   = v.ChangeType   ?? "",
            ChangeReason = v.ChangeReason ?? "",
        };
        _modalErr = ""; _modal = "ver-edit";
    }

    async Task SaveVersionCreate()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fv.VersionId))  { _modalErr = L["Err.VersionIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fv.RootItemNo)) { _modalErr = L["Err.RootItemRequired"]; return; }
        if (VersionNoInvalid()) return;
        if (ChangeReasonTooLong()) return;
        if (CreateDatesInvalid()) return;
        _busy = true;
        try
        {
            var id = _fv.VersionId.Trim().ToUpper();
            if (MD.BomVersionExists(id)) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], id); return; }
            MD.InsertBomVersion(id, NE(_fv.RootItemNo), NE(_fv.VersionNo),
                _fv.EffFrom, _fv.EffTo, NE(_fv.ChangeType), NE(_fv.ChangeReason), _actor);
            Audit.Created("MD-004", "MD_BomVersion", id, _fv);
            LoadVersions();
            _selVer = _versions.FirstOrDefault(v => v.VersionID == id);
            LoadLines();
            CloseModal();
            await RestorePages();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveVersionEdit()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fv.RootItemNo)) { _modalErr = L["Err.RootItemRequired"]; return; }
        if (VersionNoInvalid()) return;
        if (ChangeReasonTooLong()) return;
        _busy = true;
        try
        {
            if (!MD.UpdateBomVersion(_fv.VersionId, NE(_fv.RootItemNo), NE(_fv.VersionNo),
                    _fv.EffFrom, _fv.EffTo, NE(_fv.ChangeType), NE(_fv.ChangeReason), _actor))
            {
                CloseModal();
                await StatusChanged(_fv.VersionId);
                return;
            }
            Audit.Updated("MD-004", "MD_BomVersion", _fv.VersionId, _selVer, _fv);
            await RefreshVersion(_fv.VersionId);
            CloseModal();
            ShowMsg($"{_fv.VersionId} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    // ── Line CRUD ─────────────────────────────────────────────────────────
    void OpenLineCreate()
    {
        int nextPos = _lines.Count > 0 ? ((_lines.Max(l => l.Position) ?? 0) + 10) : 10;
        _fl = new()
        {
            ParentItemNo = _selVer!.RootItemNo ?? "",
            Position     = nextPos,
        };
        _lineConfirmDelete = false; _modalErr = ""; _modal = "line-create";
    }

    void OpenLineEdit(MasterDataRepository.BomRow line)
    {
        _fl = new()
        {
            BomId        = line.BOMID,
            ParentItemNo = line.ParentItemNo ?? "",
            CompItemNo   = line.CompItemNo   ?? "",
            BomLevel     = line.BOMLevel     ?? 1,
            QtyPer       = line.QtyPer       ?? 1,
            Uom          = line.UOM          ?? "EA",
            ScrapPct     = line.ScrapPct     ?? 0,
            Position     = line.Position     ?? 10,
            Note         = line.Note         ?? "",
            ActiveFlag   = line.ActiveFlag,
        };
        _flOrigComp = _fl.CompItemNo; _flOrigUom = _fl.Uom;
        try { _flUomInUse = MD.ItemUomInUse(_fl.CompItemNo); } catch { _flUomInUse = false; }
        _lineConfirmDelete = false; _modalErr = ""; _modal = "line-edit";
    }

    // 구성품에 재고·실적이 있으면 단위를 바꿀 수 없다(10-20) — 구성품을 다른 품번으로 바꾼 동안만 풀린다. 저장소도 거부한다
    string _flOrigComp = "", _flOrigUom = "";
    bool   _flUomInUse;
    bool UomLocked => _modal == "line-edit" && _flUomInUse && string.Equals(_fl.CompItemNo, _flOrigComp, StringComparison.OrdinalIgnoreCase);

    async Task SaveLineCreate()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fl.CompItemNo)) { _modalErr = L["Err.CompItemRequired"]; return; }
        if (_fl.QtyPer <= 0) { _modalErr = L["Err.QtyGtZero"]; return; }
        _busy = true;
        try
        {
            if (LineError(_fl.CompItemNo, null) is { } err) { _modalErr = err; return; }
            var bomId = "B" + Guid.NewGuid().ToString("N")[..23];
            if (!MD.InsertBomLine(bomId, NE(_fl.ParentItemNo), _fl.CompItemNo.Trim().ToUpper(),
                    1, _fl.QtyPer, NE(_fl.Uom), _fl.ScrapPct == 0 ? null : _fl.ScrapPct,
                    _selVer!.VersionID, _fl.Position, NE(_fl.Note), _actor))
            { await LineNotDraft(); return; }
            Audit.Created("MD-004", "MD_Bom", bomId, _fl);
            LoadLines(); CloseModal(); await RestorePages(); ShowMsg(L["Msg.BomLineAdded"], false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveLineEdit()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fl.CompItemNo)) { _modalErr = L["Err.CompItemRequired"]; return; }
        if (_fl.QtyPer <= 0) { _modalErr = L["Err.QtyGtZero"]; return; }
        _busy = true;
        if (UomLocked) _fl.Uom = _flOrigUom;
        try
        {
            if (LineError(_fl.CompItemNo, _fl.BomId) is { } err) { _modalErr = err; return; }
            if (!MD.UpdateBomLine(_fl.BomId, NE(_fl.ParentItemNo), _fl.CompItemNo.Trim().ToUpper(),
                    _fl.BomLevel, _fl.QtyPer, NE(_fl.Uom), _fl.ScrapPct == 0 ? null : _fl.ScrapPct,
                    _fl.Position, NE(_fl.Note), _actor))
            { await LineNotDraft(); return; }
            Audit.Updated("MD-004", "MD_Bom", _fl.BomId, _lines.FirstOrDefault(l => l.BOMID == _fl.BomId), _fl);
            LoadLines(); CloseModal(); await RestorePages(); ShowMsg(L["Msg.BomLineUpdated"], false);
        }
        catch (MasterDataRepository.BomUomLockedException) { _flUomInUse = true; _fl.Uom = _flOrigUom; _modalErr = L["MD.Bom.Hint.UomLocked"]; }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveLineDelete()
    {
        if (!_canEdit) return;
        _busy = true;
        try
        {
            if (!MD.DeleteBomLine(_fl.BomId, _actor)) { await LineNotDraft(); return; }
            Audit.Deleted("MD-004", "MD_Bom", _fl.BomId, _lines.FirstOrDefault(l => l.BOMID == _fl.BomId)); LoadLines(); CloseModal(); await RestorePages(); ShowMsg(L["Msg.BomLineDeleted"], false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveLineReactivate()
    {
        if (!_canEdit) return;
        _busy = true;
        try
        {
            if (LineError(_fl.CompItemNo, _fl.BomId) is { } err) { _modalErr = err; return; }
            if (!MD.ReactivateBomLine(_fl.BomId, _actor)) { await LineNotDraft(); return; }
            Audit.Log("MD-004", "REACTIVATE", "MD_Bom", _fl.BomId, _lines.FirstOrDefault(l => l.BOMID == _fl.BomId), new { ActiveFlag = true });
            LoadLines(); CloseModal(); await RestorePages(); ShowMsg(L["Msg.BomLineReactivated"], false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    // 라인 저장 전 검사: 비고 길이 · 같은 버전 안 활성 구성품 중복 · 자기 참조·순환(구성품의 하위 BOM 에 상위 품목이 있음)
    string? LineError(string compItemNo, string? exceptBomId)
    {
        if ((_fl.Note ?? "").Trim().Length > NoteMax) return string.Format(L["Err.MaxLenFmt"], L["Col.Note"], NoteMax);
        var comp   = compItemNo.Trim();
        var parent = (_fl.ParentItemNo ?? "").Trim();
        if (_lines.Any(l => l.ActiveFlag && l.BOMID != exceptBomId && string.Equals(l.CompItemNo?.Trim(), comp, StringComparison.OrdinalIgnoreCase)))
            return string.Format(L["MD.Bom.Err.DuplicateComponent"], comp);
        if (string.Equals(parent, comp, StringComparison.OrdinalIgnoreCase)) return L["MD.Bom.Err.SelfComponent"];
        if (parent.Length > 0 && MD.BomWouldCycle(parent, comp)) return string.Format(L["MD.Bom.Err.Cycle"], comp, parent);
        return null;
    }

    bool ChangeReasonTooLong()
    {
        if ((_fv.ChangeReason ?? "").Trim().Length <= ChangeReasonMax) return false;
        _modalErr = string.Format(L["Err.MaxLenFmt"], L["Col.ChangeReason"], ChangeReasonMax);
        return true;
    }

    // ── 엑셀 내려받기·올리기(10-20) — 한 행 = 버전 정보 + 구성 라인 하나. 올리면 없는 버전은 초안으로 만들고,
    //    있는 초안 버전에는 없는 구성품만 더하며, 승인 요청·승인 등 초안이 아닌 버전은 건너뛴다(규칙 AMES.Data.Services.BomImport)
    bool _excelOpen;
    List<AMES.Data.Services.BomImport.Version> _excelPlans = new();

    string ExcelLabel(string key) => key switch
    {
        "VersionID" => "VersionID", "RootItemNo" => L["Col.RootItemNo"], "VersionNo" => L["Col.VersionNo"],
        "EffFrom" => L["Col.StartDate"], "EffTo" => L["Col.EndDate"], "ChangeType" => L["Col.ChangeType"], "ChangeReason" => L["Col.ChangeReason"],
        "Status" => L["Col.Status"], "CompItemNo" => L["Col.ComponentItem"], "QtyPer" => L["MD.Bom.Col.QtyPer"],
        "UOM" => L["Col.Uom"], "ScrapPct" => L["Col.ScrapPct"], "Position" => L["Col.Seq"], "Note" => L["Col.Note"], _ => key,
    };

    // 지금 좌측 목록(검색·필터 적용)의 버전과 활성 구성 라인을 올리기 양식 그대로 내려받는다. 상태 열은 참고용(올릴 때 읽지 않음)
    async Task ExcelDownload()
    {
        var headers = AMES.Data.Services.BomImport.Keys.Select(k => AMES.Data.Services.MasterExcel.Header(ExcelLabel(k), k)).ToList();
        List<MasterDataRepository.BomRow> all;
        try { all = await Task.Run(() => MD.ListAllBomLines()); } catch (Exception ex) { ShowMsg(ex.Message, true); return; }
        var byVer = all.Where(l => l.ActiveFlag).GroupBy(l => l.VersionID ?? "").ToDictionary(g => g.Key, g => g.ToList());
        var data = new List<IReadOnlyList<object?>>();
        foreach (var v in _versions)
        {
            object?[] Head() => [v.VersionID, v.RootItemNo, v.VersionNo, v.EffFrom?.ToString("yyyy-MM-dd"), v.EffTo?.ToString("yyyy-MM-dd"),
                                 v.ChangeType, v.ChangeReason, v.Status];
            if (!byVer.TryGetValue(v.VersionID, out var lines) || lines.Count == 0) { data.Add([.. Head(), null, null, null, null, null, null]); continue; }
            foreach (var l in lines) data.Add([.. Head(), l.CompItemNo, l.QtyPer, l.UOM, l.ScrapPct, l.Position, l.Note]);
        }
        var bytes = AMES.Web.Services.XlsxWriter.Build(L["MD.Bom.Title"].Value, headers, data);
        await JS.InvokeVoidAsync("amesDownload", $"BOM_{DbClock.Now:yyyyMMdd_HHmmss}.xlsx", Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    AMES.Web.Services.ExcelImportPreview ExcelParse(List<string[]> sheet)
    {
        var lines = MD.ListAllBomLines();
        var comps = lines.GroupBy(l => l.VersionID ?? "", StringComparer.OrdinalIgnoreCase)
                         .ToDictionary(g => g.Key, g => (IReadOnlySet<string>)new HashSet<string>(g.Select(l => l.CompItemNo ?? ""), StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase);
        var maxPos = lines.GroupBy(l => l.VersionID ?? "", StringComparer.OrdinalIgnoreCase)
                          .ToDictionary(g => g.Key, g => g.Max(l => l.Position ?? 0), StringComparer.OrdinalIgnoreCase);
        var versions = MD.ListBomVersions().ToDictionary(v => v.VersionID,
            v => new AMES.Data.Services.BomImport.ExistingVersion(v.Status, v.RootItemNo,
                     comps.TryGetValue(v.VersionID, out var c) ? c : new HashSet<string>(StringComparer.OrdinalIgnoreCase),
                     maxPos.TryGetValue(v.VersionID, out var mp) ? mp : 0),
            StringComparer.OrdinalIgnoreCase);
        var items = new HashSet<string>(MD.ListItems("").Select(i => i.ItemNo), StringComparer.OrdinalIgnoreCase);
        var uoms = new HashSet<string>(MD.ListUoms().Where(u => u.ActiveFlag).Select(u => (u.UOMCode ?? "").Trim()), StringComparer.OrdinalIgnoreCase);
        var r = AMES.Data.Services.BomImport.Parse(sheet, new(versions, items, uoms, DateOnly.FromDateTime(DbClock.Today), (p, c) => MD.BomWouldCycle(p, c)));
        _excelPlans = r.Plans;
        var news = r.Plans.Select(v => v.IsNew ? $"{v.VersionId} (+{v.Lines.Count})" : $"{v.VersionId} +{v.Lines.Count} → DRAFT").ToList();
        var skips = r.SkippedVersions.Select(x => $"{x.VersionId} [{StatusName(x.Status)}]")
                     .Concat(r.SkippedLines.Select(x => $"{x.VersionId}/{x.CompItemNo}")).ToList();
        return new(news, skips, r.Problems);
    }

    async Task<AMES.Web.Services.ExcelImportOutcome> ExcelApply()
    {
        if (!_canEdit) return new(0, 0, []);
        int created = 0, skipped = 0;
        var failures = new List<string>();
        foreach (var v in _excelPlans)
        {
            try
            {
                var added = await Task.Run(() => MD.ImportBomVersion(v, _actor));
                if (added is null) { skipped++; continue; }   // 확인 뒤 다른 사용자가 같은 버전을 만들었거나 상태를 바꿨다
                if (v.IsNew) Audit.Created("MD-004", "MD_BomVersion", v.VersionId, v);
                else Audit.Log("MD-004", "IMPORT", "MD_Bom", v.VersionId, null, new { v.VersionId, Lines = v.Lines });
                created++;
            }
            catch (Exception ex) { failures.Add($"{v.VersionId}: {ex.Message}"); }
        }
        return new(created, skipped, failures);
    }

    async Task ExcelClosed(bool changed)
    {
        _excelOpen = false; _excelPlans = new();
        if (!changed) return;
        var id = _selVer?.VersionID;
        LoadVersions();
        _selVer = id is null ? null : _versions.FirstOrDefault(v => v.VersionID == id);
        LoadLines();
        await RestorePages();
    }

