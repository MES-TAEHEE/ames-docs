@page "/md/fd/bom"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-004 @L["MD.Bom.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-004" TitleKey="MD.Bom.Title" />

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div style="display:flex;gap:14px;height:calc(100vh - 120px);">

    @* ── 좌: 버전 목록 ─────────────────────────────────────────────────── *@
    <div style="flex:0 0 500px;display:flex;flex-direction:column;min-height:0;">
        <div class="ames-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;margin-bottom:0;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom:8px;">
                <RadzenTextBox @bind-Value="_search" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Bom.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;" />
                @if (_canEdit)
                {
                    <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenVersionCreate" class="ames-rz-btn" />
                }
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom:8px;">
                <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
                <RadzenDropDown Name="DropDownStatus" @bind-Value="_statusFilter" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;" />
                <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@LoadVersions" class="ames-rz-btn" />
            </RadzenStack>
            <div style="flex:1;min-height:0;overflow:hidden;">
                <RadzenDataGrid TItem="MasterDataRepository.BomVersionRow" Data="_versions" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center"
                                ShowPagingSummary="false" RowRender="VerRowRender" RowSelect="OnVerRowSelect" EmptyText="@L["MD.Bom.NoVersions"]" Class="ames-rz-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="MasterDataRepository.BomVersionRow" Property="RootItemNo" Title="@L["Col.RootItemNo"]">
                            <Template Context="v">
                                <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    <span style="font-weight:700;font-size:.9em;">@v.RootItemNo</span>
                                    @if (!string.IsNullOrEmpty(v.VersionNo))
                                    {
                                        <span class="dim" style="font-size:.8em;font-weight:400;margin-left:5px;">@v.VersionNo</span>
                                    }
                                    @if (!string.IsNullOrEmpty(v.RootItemName))
                                    {
                                        <span class="dim" style="font-size:.78em;margin-left:5px;">@v.RootItemName</span>
                                    }
                                </div>
                                <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    <span class="code dim" style="font-size:.72em;">@v.VersionID</span>
                                    @if (v.EffFrom.HasValue)
                                    {
                                        <span class="dim" style="font-size:.72em;margin-left:8px;">📅 @v.EffFrom?.ToString("yyyy-MM-dd")@(v.EffTo.HasValue ? $" ~ {v.EffTo?.ToString("MM-dd")}" : "")</span>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MasterDataRepository.BomVersionRow" Property="Status" Title="@L["Col.Status"]" Width="86px" TextAlign="TextAlign.Center">
                            <Template Context="v"><span class="pill @StatusCss(v.Status)">@v.Status</span></Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </div>

    @* ── 우: 버전 상세 + BOM 라인 ─────────────────────────────────────── *@
    <div style="flex:1;min-width:0;display:flex;flex-direction:column;min-height:0;">
        <div class="ames-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;margin-bottom:0;">

            @if (_selVer is null)
            {
                <div style="flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;">
                    <div style="font-size:2.4em;opacity:.15;">📋</div>
                    <div class="dim" style="font-size:.9em;">@L["MD.Bom.SelectVersionHint"]</div>
                </div>
            }
            else
            {
                @* ─── 선택된 버전 정보 헤더 ─── *@
                <div class="ames-info-bar">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;">

                        <div style="min-width:0;flex:1;">
                            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                <span style="font-weight:700;font-size:.95em;">@_selVer.RootItemNo</span>
                                @if (!string.IsNullOrEmpty(_selVer.RootItemName))
                                {
                                    <span class="dim" style="font-size:.85em;">@_selVer.RootItemName</span>
                                }
                                <span class="pill @StatusCss(_selVer.Status)">@_selVer.Status</span>
                                @if (!string.IsNullOrEmpty(_selVer.VersionNo))
                                {
                                    <span class="dim code" style="font-size:.82em;border:1px solid rgba(255,255,255,.1);padding:1px 7px;border-radius:4px;">@_selVer.VersionNo</span>
                                }
                            </div>
                            <div class="dim code" style="font-size:.79em;margin-top:3px;">
                                @_selVer.VersionID
                                @if (_selVer.EffFrom.HasValue)
                                {
                                    <span style="margin-left:10px;">📅 @_selVer.EffFrom?.ToString("yyyy-MM-dd")@(_selVer.EffTo.HasValue ? $" ~ {_selVer.EffTo?.ToString("yyyy-MM-dd")}" : "")</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_selVer.ChangeType) || !string.IsNullOrEmpty(_selVer.ChangeReason))
                            {
                                <div class="dim" style="font-size:.78em;margin-top:2px;">
                                    @if (!string.IsNullOrEmpty(_selVer.ChangeType)) { <span>@_selVer.ChangeType</span> }
                                    @if (!string.IsNullOrEmpty(_selVer.ChangeType) && !string.IsNullOrEmpty(_selVer.ChangeReason)) { <span> — </span> }
                                    @_selVer.ChangeReason
                                </div>
                            }
                            @if (_selVer.Status == "PENDING" && !string.IsNullOrEmpty(_selVer.RequestedBy))
                            {
                                <div style="font-size:.78em;color:#fbbf24;margin-top:2px;">@L["MD.Bom.ApprovalRequester"]: @_selVer.RequestedBy</div>
                            }
                            @if (_selVer.Status == "APPROVED" && !string.IsNullOrEmpty(_selVer.ApprovedBy))
                            {
                                <div style="font-size:.78em;color:#86efac;margin-top:2px;">@L["MD.Bom.ApprovedBy"]: @_selVer.ApprovedBy  @(_selVer.ApprovedTS?.ToString("yyyy-MM-dd HH:mm"))</div>
                            }
                        </div>

                        @* 워크플로 버튼 *@
                        @if (_canEdit)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.35rem" Wrap="FlexWrap.Wrap" Style="flex-shrink:0;">
                                @if (_selVer.Status == "DRAFT")
                                {
                                    <RadzenButton Text="@L["MD.Bom.AddItem"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@OpenLineCreate" Disabled="@_busy" class="ames-rz-btn" />
                                    <RadzenButton Text="@L["Btn.Edit"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="() => OpenVersionEdit(_selVer)" Disabled="@_busy" class="ames-rz-btn" />
                                    <RadzenButton Text="@L["MD.Bom.RequestApproval"]" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="@DoRequestApproval" Disabled="@_busy" class="ames-rz-btn" />
                                    @if (!_verDelConfirm)
                                    {
                                        <RadzenButton Text="@L["Btn.Delete"]" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => _verDelConfirm = true' Disabled="@_busy" class="ames-rz-btn" />
                                    }
                                }
                                @if (_selVer.Status == "PENDING")
                                {
                                    <RadzenButton Text="@L["Btn.Approve"]" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@DoApprove" Disabled="@(_busy || _lines.Count == 0)" title="@(_lines.Count == 0 ? L["MD.Bom.NeedApprovalHint"].Value : "")" class="ames-rz-btn" />
                                    <RadzenButton Text="@L["Btn.Reject"]" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DoReject" Disabled="@_busy" class="ames-rz-btn" />
                                }
                                @if (_selVer.Status == "REJECTED")
                                {
                                    <RadzenButton Text="@L["MD.Bom.ReviveDraft"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@DoRevive" Disabled="@_busy" class="ames-rz-btn" />
                                }
                            </RadzenStack>
                        }
                    </div>

                    @* 삭제 인라인 확인 *@
                    @if (_verDelConfirm)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm" Style="margin-top:8px;">
                            <span>@string.Format(L["MD.Bom.ConfirmDeleteVersion"], _selVer.VersionID)</span>
                            <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _verDelConfirm = false' class="ames-rz-btn" />
                            <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DoVersionDelete" Disabled="@_busy" class="ames-rz-btn" />
                        </RadzenStack>
                    }
                </div>

                @* 라인 카운트 + 읽기 전용 안내 *@
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="padding:4px 0 6px;">
                    <span class="dim" style="font-size:.82em;">@string.Format(L["MD.Bom.LineCount"], _lines.Count)</span>
                    @if (_selVer.Status != "DRAFT")
                    {
                        <span class="dim" style="font-size:.78em;">@L["MD.Bom.DraftOnly"]</span>
                    }
                </RadzenStack>

                @* BOM 라인 그리드 *@
                <div style="flex:1;min-height:0;overflow:hidden;">
                    @{ bool editable = _selVer.Status == "DRAFT"; }
                    <RadzenDataGrid TItem="MasterDataRepository.BomRow" Data="_lines" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center"
                                    ShowPagingSummary="@_showPagerSummary" PageSizeOptions="@_pageSizeOptions" RowRender="@(args => LineRowRender(args, editable))" RowSelect="@(l => { if (editable) OpenLineEdit(l); })" EmptyText="@L["MD.Bom.NoLines"]" Class="ames-rz-grid">
                        <Columns>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BomRow" Property="BOMLevel" Title="@L["Col.Level"]" Width="48px" TextAlign="TextAlign.Center">
                                <Template Context="line"><span class="dim">@(line.BOMLevel ?? 0)</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BomRow" Property="ParentItemNo" Title="@L["Col.ParentItem"]" Width="110px">
                                <Template Context="line"><span class="code dim" style="font-size:.82em;">@line.ParentItemNo</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BomRow" Property="CompItemNo" Title="@L["Col.ComponentItem"]">
                                <Template Context="line">
                                    @{ int indent = (line.BOMLevel ?? 0) * 16; }
                                    @if (indent > 0) { <span style="display:inline-block;width:@(indent)px;"></span> }
                                    @if ((line.BOMLevel ?? 0) > 0) { <span class="dim" style="font-size:.78em;">└ </span> }
                                    <span class="code" style="color:#93c5fd;font-weight:700;">@line.CompItemNo</span>
                                    @if (!string.IsNullOrEmpty(line.CompItemName)) { <span class="dim" style="font-size:.8em;margin-left:5px;">@line.CompItemName</span> }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BomRow" Property="QtyPer" Title="@L["Col.Qty"]" Width="80px" TextAlign="TextAlign.Right">
                                <Template Context="line"><span class="code" style="font-weight:600;">@(line.QtyPer?.ToString("N4"))</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BomRow" Property="UOM" Title="@L["Col.Uom"]" Width="52px">
                                <Template Context="line"><span class="dim">@line.UOM</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BomRow" Property="ScrapPct" Title="@L["Col.ScrapPct"]" Width="66px" TextAlign="TextAlign.Right">
                                <Template Context="line"><span class="code dim">@(line.ScrapPct?.ToString("N2"))</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BomRow" Property="Position" Title="@L["Col.Seq"]" Width="52px" TextAlign="TextAlign.Center">
                                <Template Context="line"><span class="dim">@line.Position</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BomRow" Property="Note" Title="@L["Col.Note"]">
                                <Template Context="line"><span class="dim">@line.Note</span></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </div>
    </div>
</div>

@* ── BOM 버전 등록 모달 ─────────────────────────────────────────────── *@
@if (_modal == "ver-create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:540px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Bom.Title"] — @L["Modal.Create"]</div>
            @VersionFormFields(false)
            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveVersionCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── BOM 버전 수정 모달 (DRAFT only) ────────────────────────────────── *@
@if (_modal == "ver-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:540px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Bom.Title"] — @L["Modal.Edit"] <span class="code" style="font-weight:400;font-size:.9em;">@_fv.VersionId</span></div>
            @VersionFormFields(true)
            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveVersionEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── BOM 라인 추가 모달 ─────────────────────────────────────────────── *@
@if (_modal == "line-create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:500px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Bom.Modal.AddLine"] — <span class="code" style="font-weight:400;font-size:.9em;">@_selVer!.VersionID</span></div>
            @LineFormFields()
            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Add"])" Click="@SaveLineCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── BOM 라인 수정/삭제 모달 ────────────────────────────────────────── *@
@if (_modal == "line-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:500px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">BOM — @L["Modal.Edit"] <span class="code" style="font-weight:400;font-size:.9em;">@_fl.CompItemNo</span></div>
            @LineFormFields()
            @if (_lineConfirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.Bom.ConfirmDeleteLine"], _fl.CompItemNo)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _lineConfirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveLineDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveLineEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _lineConfirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.BomVersionRow> _versions = new();
    List<MasterDataRepository.BomRow>        _lines    = new();
    List<MasterDataRepository.ItemRow>       _itemList = new();
    MasterDataRepository.BomVersionRow?      _selVer;
    string _statusFilter = "";
    string _search       = "";

    string _modal = "", _modalErr = "", _msg = "";
    bool   _isErr, _busy, _bgDown;
    bool   _verDelConfirm, _lineConfirmDelete;
    bool   _canEdit;
    string _actor = "system";

    VersionForm _fv = new();
    LineForm    _fl = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ItemOptions => _itemList.Select(i => new DropDownItem { Value = i.ItemNo, Text = $"[{i.ItemNo}] {i.ItemName}" });
    private List<DropDownItem> StatusFilterOptions => new()
    {
        new() { Value = "",         Text = L["Filter.All"].Value },
        new() { Value = "DRAFT",    Text = "DRAFT" },
        new() { Value = "PENDING",  Text = "PENDING" },
        new() { Value = "APPROVED", Text = "APPROVED" },
        new() { Value = "REJECTED", Text = "REJECTED" },
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor   = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/fd/bom");
        try { _itemList = MD.ListItems(); } catch { }
        LoadVersions();
    }

    void LoadVersions()
    {
        try
        {
            _versions = MD.ListBomVersions(string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var q = _search.Trim();
                _versions = _versions
                    .Where(v => (v.VersionID?.Contains(q, StringComparison.OrdinalIgnoreCase) == true)
                             || (v.RootItemNo?.Contains(q, StringComparison.OrdinalIgnoreCase) == true)
                             || (v.RootItemName?.Contains(q, StringComparison.OrdinalIgnoreCase) == true))
                    .ToList();
            }
        }
        catch { _versions = new(); }
    }

    void LoadLines() { try { _lines = _selVer is null ? new() : MD.ListBomLines(_selVer.VersionID); } catch { _lines = new(); } }

    void SelectVersion(MasterDataRepository.BomVersionRow v) { _selVer = v; _verDelConfirm = false; LoadLines(); }

    void OnSearchChanged(string value) => _search = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") LoadVersions(); }

    void VerRowRender(RowRenderEventArgs<MasterDataRepository.BomVersionRow> args)
    {
        var cls = "ames-row-link";
        if (_selVer?.VersionID == args.Data?.VersionID) cls += " ames-row-selected";
        args.Attributes["class"] = cls;
    }

    void LineRowRender(RowRenderEventArgs<MasterDataRepository.BomRow> args, bool editable)
    {
        if (!editable) return;
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OnVerRowSelect(MasterDataRepository.BomVersionRow v) => SelectVersion(v);

    void CloseModal() { _modal = ""; _modalErr = ""; _lineConfirmDelete = false; }

    void OnBgDown()  => _bgDown = true;
    void OnBgClick() { if (_bgDown) CloseModal(); _bgDown = false; }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string StatusCss(string? s) => s switch
    {
        "DRAFT"    => "info",
        "PENDING"  => "warn",
        "APPROVED" => "ok",
        "REJECTED" => "bad",
        _          => ""
    };

    void RefreshVersion(string versionId)
    {
        LoadVersions();
        _selVer = _versions.FirstOrDefault(v => v.VersionID == versionId);
        LoadLines();
    }

    // ── 워크플로 액션 (모달 없음) ─────────────────────────────────────────
    void DoRequestApproval()
    {
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try { MD.RequestBomApproval(id, _actor); RefreshVersion(id); ShowMsg($"{id} {L["Msg.ApprovalRequested"]}", false); }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    void DoApprove()
    {
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try { MD.ApproveBomVersion(id, _actor); RefreshVersion(id); ShowMsg($"{id} {L["Msg.Approved"]}", false); }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    void DoReject()
    {
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try { MD.RejectBomVersion(id, _actor); RefreshVersion(id); ShowMsg($"{id} {L["Msg.Rejected"]}", true); }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    void DoRevive()
    {
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try { MD.ReviveBomVersion(id, _actor); RefreshVersion(id); ShowMsg($"{id} {L["Msg.Revived"]}", false); }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    void DoVersionDelete()
    {
        if (_selVer is null) return;
        var id = _selVer.VersionID;
        _busy = true;
        try
        {
            MD.DeleteBomVersion(id);
            _selVer = null; _lines = new(); _verDelConfirm = false;
            LoadVersions();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
        finally { _busy = false; }
    }

    // ── Version CRUD ──────────────────────────────────────────────────────
    void OpenVersionCreate()
    {
        _fv = new()
        {
            EffFrom = DateOnly.FromDateTime(DateTime.Today),
            EffTo   = DateOnly.FromDateTime(DateTime.Today.AddYears(1)),
        };
        _modalErr = ""; _modal = "ver-create";
    }

    void OpenVersionEdit(MasterDataRepository.BomVersionRow v)
    {
        _fv = new()
        {
            VersionId    = v.VersionID,
            RootItemNo   = v.RootItemNo   ?? "",
            VersionNo    = v.VersionNo    ?? "",
            EffFrom      = v.EffFrom,
            EffTo        = v.EffTo,
            ChangeType   = v.ChangeType   ?? "",
            ChangeReason = v.ChangeReason ?? "",
        };
        _modalErr = ""; _modal = "ver-edit";
    }

    void SaveVersionCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fv.VersionId))  { _modalErr = L["Err.VersionIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fv.RootItemNo)) { _modalErr = L["Err.RootItemRequired"]; return; }
        _busy = true;
        try
        {
            var id = _fv.VersionId.Trim().ToUpper();
            if (MD.BomVersionExists(id)) { _modalErr = $"'{id}' {L["Err.AlreadyExists"]}"; return; }
            MD.InsertBomVersion(id, NE(_fv.RootItemNo), NE(_fv.VersionNo),
                _fv.EffFrom, _fv.EffTo, NE(_fv.ChangeType), NE(_fv.ChangeReason), _actor);
            LoadVersions();
            _selVer = _versions.FirstOrDefault(v => v.VersionID == id);
            LoadLines();
            CloseModal();
            ShowMsg($"{id} BOM 버전 {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveVersionEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fv.RootItemNo)) { _modalErr = L["Err.RootItemRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateBomVersion(_fv.VersionId, NE(_fv.RootItemNo), NE(_fv.VersionNo),
                _fv.EffFrom, _fv.EffTo, NE(_fv.ChangeType), NE(_fv.ChangeReason), _actor);
            RefreshVersion(_fv.VersionId);
            CloseModal();
            ShowMsg($"{_fv.VersionId} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    // ── Line CRUD ─────────────────────────────────────────────────────────
    void OpenLineCreate()
    {
        int nextPos = _lines.Count > 0 ? ((_lines.Max(l => l.Position) ?? 0) + 10) : 10;
        _fl = new()
        {
            ParentItemNo = _selVer!.RootItemNo ?? "",
            Position     = nextPos,
        };
        _lineConfirmDelete = false; _modalErr = ""; _modal = "line-create";
    }

    void OpenLineEdit(MasterDataRepository.BomRow line)
    {
        _fl = new()
        {
            BomId        = line.BOMID,
            ParentItemNo = line.ParentItemNo ?? "",
            CompItemNo   = line.CompItemNo   ?? "",
            BomLevel     = line.BOMLevel     ?? 1,
            QtyPer       = line.QtyPer       ?? 1,
            Uom          = line.UOM          ?? "EA",
            ScrapPct     = line.ScrapPct     ?? 0,
            Position     = line.Position     ?? 10,
            Note         = line.Note         ?? "",
        };
        _lineConfirmDelete = false; _modalErr = ""; _modal = "line-edit";
    }

    void SaveLineCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fl.CompItemNo)) { _modalErr = L["Err.CompItemRequired"]; return; }
        if (_fl.QtyPer <= 0) { _modalErr = L["Err.QtyGtZero"]; return; }
        _busy = true;
        try
        {
            var bomId = "B" + Guid.NewGuid().ToString("N")[..23];
            MD.InsertBomLine(bomId, NE(_fl.ParentItemNo), _fl.CompItemNo.Trim().ToUpper(),
                _fl.BomLevel, _fl.QtyPer, NE(_fl.Uom), _fl.ScrapPct == 0 ? null : _fl.ScrapPct,
                _selVer!.VersionID, _fl.Position, NE(_fl.Note), _actor);
            LoadLines(); CloseModal(); ShowMsg(L["Msg.BomLineAdded"], false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveLineEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fl.CompItemNo)) { _modalErr = L["Err.CompItemRequired"]; return; }
        if (_fl.QtyPer <= 0) { _modalErr = L["Err.QtyGtZero"]; return; }
        _busy = true;
        try
        {
            MD.UpdateBomLine(_fl.BomId, NE(_fl.ParentItemNo), _fl.CompItemNo.Trim().ToUpper(),
                _fl.BomLevel, _fl.QtyPer, NE(_fl.Uom), _fl.ScrapPct == 0 ? null : _fl.ScrapPct,
                _fl.Position, NE(_fl.Note), _actor);
            LoadLines(); CloseModal(); ShowMsg(L["Msg.BomLineUpdated"], false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveLineDelete()
    {
        _busy = true;
        try { MD.DeleteBomLine(_fl.BomId); LoadLines(); CloseModal(); ShowMsg(L["Msg.BomLineDeleted"], false); }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    // ── Form fragments ────────────────────────────────────────────────────
    RenderFragment VersionFormFields(bool editMode) =>
    @<div>
        <RadzenRow Gap="8px">
            <RadzenColumn Size="8">
                <RadzenLabel Text='@($"VersionID * ({L["MD.Bom.Max24Chars"]})")' />
                <RadzenTextBox @bind-Value="_fv.VersionId" Disabled="@editMode" Placeholder="예: V-PN001-001" MaxLength="24" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["Col.VersionNo"]" />
                <RadzenTextBox @bind-Value="_fv.VersionNo" Placeholder="V1.0" MaxLength="10" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="12">
                <RadzenLabel Text='@($"{L["Col.RootItemNo"]} *")' />
                <RadzenDropDown @bind-Value="_fv.RootItemNo" Data="@ItemOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" AllowFiltering="true" Placeholder="@L["Opt.SelectItem"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="6">
                <RadzenLabel Text="@L["Col.StartDate"]" />
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="_fv.EffFrom" DateFormat="yyyy-MM-dd" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenLabel Text="@L["Col.EndDate"]" />
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="_fv.EffTo" DateFormat="yyyy-MM-dd" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="12">
                <RadzenLabel Text="@L["Col.ChangeType"]" />
                <RadzenTextBox @bind-Value="_fv.ChangeType" Placeholder="ECO, NPI, REVISION…" MaxLength="16" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="12">
                <RadzenLabel Text="@L["Col.ChangeReason"]" />
                <RadzenTextArea @bind-Value="_fv.ChangeReason" Rows="2" class="ames-rz-input" Style="width:100%;resize:vertical;" />
            </RadzenColumn>
        </RadzenRow>
    </div>;

    RenderFragment LineFormFields() =>
    @<div>
        <RadzenRow Gap="8px">
            <RadzenColumn Size="6">
                <RadzenLabel Text="@L["Col.ParentItem"]" />
                <RadzenDropDown @bind-Value="_fl.ParentItemNo" Data="@ItemOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" AllowFiltering="true" Placeholder="@L["Opt.RootLevel"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenLabel Text='@($"{L["Col.CompItem"]} *")' />
                <RadzenDropDown @bind-Value="_fl.CompItemNo" Data="@ItemOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" AllowFiltering="true" Placeholder="@L["Opt.SelectItem"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="3">
                <RadzenLabel Text="@L["Col.Level"]" />
                <RadzenNumeric TValue="int" @bind-Value="_fl.BomLevel" Min="0" Max="9" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenLabel Text='@($"{L["Col.Qty"]} *")' />
                <RadzenNumeric TValue="decimal" @bind-Value="_fl.QtyPer" Min="0.0001m" Step="0.0001m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenLabel Text="@L["Col.Uom"]" />
                <RadzenTextBox @bind-Value="_fl.Uom" MaxLength="10" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenLabel Text="@L["Col.ScrapRate"]" />
                <RadzenNumeric TValue="decimal" @bind-Value="_fl.ScrapPct" Min="0" Step="0.01m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="4">
                <RadzenLabel Text="@L["Col.Seq"]" />
                <RadzenNumeric TValue="int" @bind-Value="_fl.Position" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="8">
                <RadzenLabel Text="@L["Col.Note"]" />
                <RadzenTextBox @bind-Value="_fl.Note" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>
    </div>;

    class VersionForm
    {
        public string    VersionId    { get; set; } = "";
        public string    RootItemNo   { get; set; } = "";
        public string    VersionNo    { get; set; } = "";
        public DateOnly? EffFrom      { get; set; }
        public DateOnly? EffTo        { get; set; }
        public string    ChangeType   { get; set; } = "";
        public string    ChangeReason { get; set; } = "";
    }

    class LineForm
    {
        public string  BomId        { get; set; } = "";
        public string  ParentItemNo { get; set; } = "";
        public string  CompItemNo   { get; set; } = "";
        public int     BomLevel     { get; set; } = 1;
        public decimal QtyPer       { get; set; } = 1;
        public string  Uom          { get; set; } = "EA";
        public decimal ScrapPct     { get; set; } = 0;
        public int     Position     { get; set; } = 10;
        public string  Note         { get; set; } = "";
    }
}
