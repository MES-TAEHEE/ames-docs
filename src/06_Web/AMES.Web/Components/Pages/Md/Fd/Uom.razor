@page "/md/fd/uom"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>@L["MD.Uom.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Uom.Kpi.BaseUnit"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.BaseFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.CategoryCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.UOMCategory).Where(c => c != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Uom.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder="@L["MD.Uom.Ph.Search"]"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' />
            <RadzenLabel Text="@L["Col.Category"]" />
            <RadzenDropDown @bind-Value="_fCat" Data="@CategoryOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllCategories"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenLabel Text="@L["Col.Status"]" />
            <RadzenDropDown @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.All"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.MasterDataRepository.UomRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="15"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    RowRender="@UomRowRender"
                    RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data); })"
                    EmptyText="@L["MD.Uom.Empty"]"
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="UOMCode" Title="@L["Col.UomCode"]" Width="80px">
                <Template Context="r"><span class="code">@r.UOMCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="UOMName" Title="@L["Col.UomName"]">
                <Template Context="r">@(r.UOMName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="UOMCategory" Title="@L["Col.UomCategory"]" Width="120px">
                <Template Context="r">
                    <span class="dim">@(_unitCategories.FirstOrDefault(x => x.CodeValue == r.UOMCategory) is { } cat ? MasterDataRepository.LocalName(cat) : r.UOMCategory ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="Symbol" Title="@L["Col.UomSymbol"]" Width="70px">
                <Template Context="r"><span class="dim">@(r.Symbol ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="BaseFlag" Title="기준" Width="56px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.BaseFlag) { <span class="pill ok">@L["MD.Uom.PillBase"]</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="BaseUOM" Title="기준단위" Width="80px">
                <Template Context="r"><span class="dim">@(r.BaseUOM ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="ConvFactor" Title="@L["Col.ConvFactor"]" Width="100px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.ConvFactor?.ToString("0.########") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="DecimalPrec" Title="@L["Col.Decimals"]" Width="66px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.DecimalPrec?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.UomRow" Property="ActiveFlag" Title="@L["Col.Status"]" Width="72px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Uom.Title"] — @L["Btn.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.UomCode"]" />
                    <RadzenTextBox @bind-Value="_f.UOMCode" Placeholder="EA" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.UomName"]" />
                    <RadzenTextBox @bind-Value="_f.UOMName" Placeholder="@L["MD.Uom.Ph.UomName"]" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.UomCategory"]" />
                    <RadzenDropDown @bind-Value="_f.UOMCategory" Data="@CategoryOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.UomSymbol"]" />
                    <RadzenTextBox @bind-Value="_f.Symbol" Placeholder="ea" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="기준단위 (BaseUOM)" />
                    <RadzenTextBox @bind-Value="_f.BaseUOM" Placeholder="EA" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ConvFactor"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ConvFactor" Placeholder="1.0" Step="0.000001m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Decimals"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DecimalPrec" Placeholder="0" Min="0" Max="8"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.BaseFlag" />
                <span>@L["MD.Uom.BaseUnit"]</span>
            </label>
            <label style="margin-top:4px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Uom.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.UOMCode</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.UomName"]" />
                    <RadzenTextBox @bind-Value="_f.UOMName" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.UomCategory"]" />
                    <RadzenDropDown @bind-Value="_f.UOMCategory" Data="@CategoryOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.UomSymbol"]" />
                    <RadzenTextBox @bind-Value="_f.Symbol" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="기준단위 (BaseUOM)" />
                    <RadzenTextBox @bind-Value="_f.BaseUOM" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.ConvFactor"]" />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ConvFactor" Step="0.000001m"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Decimals"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DecimalPrec" Min="0" Max="8"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.BaseFlag" />
                <span>@L["MD.Uom.BaseUnit"]</span>
            </label>
            <label style="margin-top:4px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.UomRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.UomRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.UomRow? _sel;

    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _unitCategories = new();
    string  _fSearch = "";
    string? _fCat;
    string? _fActive;

    readonly IEnumerable<int> _pageSizeOptions = new[] { 15, 30, 50, 100 };

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> CategoryOptions =>
        _unitCategories.Where(c => c.UseFlag)
            .Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    private IEnumerable<DropDownItem> ActiveFilterOptions => new[]
    {
        new DropDownItem { Value = "Y", Text = L["Lbl.Active"].Value },
        new DropDownItem { Value = "N", Text = L["Lbl.Inactive"].Value },
    };

    private void UomRowRender(RowRenderEventArgs<AMES.Data.Repositories.MasterDataRepository.UomRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/fd/uom");
        try { _unitCategories = Md.ListCodeItems("UNIT_CATEGORY"); } catch { }
        Reload();
    }

    void Reload()
    {
        try { _allRows = Md.ListUoms(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.UOMCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.UOMName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fCat))
            _rows = _rows.Where(r => r.UOMCategory == _fCat).ToList();
        if (_fActive == "Y") _rows = _rows.Where(r => r.ActiveFlag).ToList();
        if (_fActive == "N") _rows = _rows.Where(r => !r.ActiveFlag).ToList();
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.UomRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            UOMName     = r.UOMName     ?? "",
            UOMCategory = r.UOMCategory ?? "",
            BaseFlag    = r.BaseFlag,
            BaseUOM     = r.BaseUOM     ?? "",
            ConvFactor  = r.ConvFactor,
            DecimalPrec = r.DecimalPrec,
            Symbol      = r.Symbol      ?? "",
            ActiveFlag  = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.UOMCode)) { _modalErr = L["Err.UomCodeRequired"]; return; }
        var code = _f.UOMCode.Trim().ToUpper();
        if (Md.UomExists(code)) { _modalErr = $"'{code}' 코드가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertUom(code, NE(_f.UOMName), NE(_f.UOMCategory),
                _f.BaseFlag, NE(_f.BaseUOM), _f.ConvFactor,
                _f.DecimalPrec, NE(_f.Symbol), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{code} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            Md.UpdateUom(_sel.UOMCode, NE(_f.UOMName), NE(_f.UOMCategory),
                _f.BaseFlag, NE(_f.BaseUOM), _f.ConvFactor,
                _f.DecimalPrec, NE(_f.Symbol), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.UOMCode} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var code = _sel.UOMCode;
            Md.DeleteUom(_sel.UOMCode);
            CloseModal(); Reload();
            ShowMsg($"{code} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   UOMCode     { get; set; } = "";
        public string   UOMName     { get; set; } = "";
        public string   UOMCategory { get; set; } = "";
        public bool     BaseFlag    { get; set; } = false;
        public string   BaseUOM     { get; set; } = "";
        public decimal? ConvFactor  { get; set; }
        public int?     DecimalPrec { get; set; }
        public string   Symbol      { get; set; } = "";
        public bool     ActiveFlag  { get; set; } = true;
    }
}