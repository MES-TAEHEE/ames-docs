@page "/md/items"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Items.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-003</div>
    <div class="ames-page-t">@L["MD.Items.Title"]</div>
    <div class="ames-page-sub">@L["MD.Items.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allItems.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">완제품(FG)</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ItemType == "FG")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">반제품(WIP)</div>
        <div class="ames-kpi-v">@_allItems.Count(r => r.ItemType == "WIP")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Items.List"] · @_items.Count @L["Lbl.Items"]@(_items.Count < _allItems.Count ? $" / 전체 {_allItems.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:200px;padding:4px 8px;"
                   placeholder="품목번호·품목명·영문명 검색" @bind="_fSearch" autocomplete="off" />
            <select class="ames-input" style="width:130px;padding:4px 8px;" @bind="_fTypeFilter">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _allItems.Select(r => r.ItemType).Where(t => t != null).Distinct().OrderBy(t => t))
                {
                    <option value="@t">@t</option>
                }
            </select>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fActiveOnly">
                <option value="">전체</option>
                <option value="Y">사용</option>
                <option value="N">미사용</option>
            </select>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
        </div>
    </div>

    @if (_items.Count == 0)
    {
        <div class="ames-empty">@L["MD.Items.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th style="width:130px;">품목번호</th>
                    <th>품목명</th>
                    <th>품목명(영문)</th>
                    <th style="width:90px;">품목유형</th>
                    <th style="width:110px;">카테고리</th>
                    <th style="width:60px;">단위</th>
                    <th style="width:60px;">Routing</th>
                    <th style="width:80px;text-align:right;">안전재고</th>
                    <th style="width:80px;text-align:right;">최소재고</th>
                    <th style="width:80px;text-align:right;">최대재고</th>
                    <th style="width:90px;text-align:right;">단가</th>
                    <th style="width:48px;text-align:center;">사용</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    var cap = item;
                    <tr class="ames-row-link" @onclick="() => OpenEdit(cap)">
                        <td class="code">@item.ItemNo</td>
                        <td>@item.ItemName</td>
                        <td class="dim">@item.ItemNameEN</td>
                        <td><span class="pill info">@(item.ItemType ?? "—")</span></td>
                        <td class="dim">@item.ItemCategory</td>
                        <td class="code dim">@item.DefaultUOM</td>
                        <td class="code dim">@(item.RoutingType ?? "—")</td>
                        <td style="text-align:right;">@(item.SafetyStock?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(item.MinStock?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(item.MaxStock?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(item.UnitCost?.ToString("N0") ?? "—")</td>
                        <td style="text-align:center;">
                            <span class="pill @(item.ActiveFlag ? "ok" : "dim")">@(item.ActiveFlag ? "Y" : "N")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* ── 등록 모달 ──────────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:680px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">품목 등록</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>품목번호 * <span class="dim" style="font-size:.82em;">(최대 20자)</span></label>
                    <input class="ames-input" @bind="_fItemNo" maxlength="20" autocomplete="off" />
                </div>
                <div>
                    <label>단위 <span class="dim" style="font-size:.82em;">(UOM)</span></label>
                    <input class="ames-input" @bind="_fUom" maxlength="10" autocomplete="off"
                           placeholder="예: EA, KG, M" />
                </div>
            </div>

            @ItemFormFields()

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveCreate" disabled="@_busy">
                    @(_busy ? "저장 중…" : "등록")
                </button>
                <button class="ames-btn" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── 수정/삭제 모달 ─────────────────────────────────────────────────── *@
@if (_modal == "edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:680px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">품목 수정 — <span class="code" style="font-weight:400;font-size:.9em;">@_fItemNo</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>품목번호</label>
                    <input class="ames-input" value="@_fItemNo" disabled />
                </div>
                <div>
                    <label>단위 <span class="dim" style="font-size:.82em;">(UOM)</span></label>
                    <input class="ames-input" @bind="_fUom" maxlength="10" autocomplete="off" />
                </div>
            </div>

            @ItemFormFields()

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@_fItemNo (@_fItemName) 을 삭제합니까?</span>
                    <button class="ames-btn" @onclick='() => _confirmDelete = false'>아니오</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">
                        @(_busy ? "삭제 중…" : "예, 삭제")
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveEdit" disabled="@_busy">
                    @(_busy ? "저장 중…" : "수정")
                </button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.ItemRow> _allItems = new();
    List<MasterDataRepository.ItemRow> _items    = new();
    string _fSearch       = "";
    string _fTypeFilter   = "";
    string _fActiveOnly   = "";
    string _modal         = "";
    string _modalErr      = "";
    string _msg           = "";
    bool   _isErr, _busy, _bgDown, _confirmDelete;
    string _actor         = "system";

    // ── Form fields ──────────────────────────────────────────────────────
    string  _fItemNo       = "";
    string  _fItemName     = "";
    string  _fItemNameEn   = "";
    string  _fItemType     = "";
    string  _fItemCategory = "";
    string  _fUom          = "";
    string  _fRoutingType  = "";
    decimal _fMinStock     = 0;
    decimal _fMaxStock     = 0;
    decimal _fSafetyStock  = 0;
    decimal _fUnitCost     = 0;
    string  _fCustSav      = "";
    string  _fCustGeo      = "";
    string  _fDrawingNo    = "";
    bool    _fActiveFlag   = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor   = auth.User.Identity?.Name ?? "system";
        Reload();
    }

    void Reload() { try { _allItems = Md.ListItems(""); } catch { _allItems = new(); } ApplyFilter(); }

    void ApplyFilter() => _items = _allItems.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.ItemNo.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            r.ItemName.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemNameEN ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fTypeFilter) || r.ItemType == _fTypeFilter) &&
        (string.IsNullOrEmpty(_fActiveOnly) || (_fActiveOnly == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList();

    void CloseModal() { _modal = ""; _modalErr = ""; _confirmDelete = false; }
    void OnBgDown()  => _bgDown = true;
    void OnBgClick() { if (_bgDown) CloseModal(); _bgDown = false; }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    void OpenCreate()
    {
        _fItemNo = ""; _fItemName = ""; _fItemNameEn = ""; _fItemType = "";
        _fItemCategory = ""; _fUom = "EA"; _fRoutingType = "";
        _fMinStock = 0; _fMaxStock = 0; _fSafetyStock = 0; _fUnitCost = 0;
        _fCustSav = ""; _fCustGeo = ""; _fDrawingNo = ""; _fActiveFlag = true;
        _confirmDelete = false; _modalErr = ""; _modal = "create";
    }

    void OpenEdit(MasterDataRepository.ItemRow r)
    {
        _fItemNo       = r.ItemNo;
        _fItemName     = r.ItemName;
        _fItemNameEn   = r.ItemNameEN      ?? "";
        _fItemType     = r.ItemType        ?? "";
        _fItemCategory = r.ItemCategory    ?? "";
        _fUom          = r.DefaultUOM      ?? "";
        _fRoutingType  = r.RoutingType     ?? "";
        _fMinStock     = r.MinStock        ?? 0;
        _fMaxStock     = r.MaxStock        ?? 0;
        _fSafetyStock  = r.SafetyStock     ?? 0;
        _fUnitCost     = r.UnitCost        ?? 0;
        _fCustSav      = r.CustItemNoSAV   ?? "";
        _fCustGeo      = r.CustItemNoGEO   ?? "";
        _fDrawingNo    = r.DrawingNo       ?? "";
        _fActiveFlag   = r.ActiveFlag;
        _confirmDelete = false; _modalErr = ""; _modal = "edit";
    }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fItemNo))   { _modalErr = "품목번호를 입력하세요."; return; }
        if (string.IsNullOrWhiteSpace(_fItemName))  { _modalErr = "품목명을 입력하세요."; return; }
        _busy = true;
        try
        {
            var no = _fItemNo.Trim().ToUpper();
            if (Md.ItemExists(no)) { _modalErr = $"'{no}' 품목번호가 이미 존재합니다."; return; }
            Md.InsertItem(no, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                N(_fItemCategory), N(_fUom), N(_fRoutingType),
                Nz(_fMinStock), Nz(_fMaxStock), Nz(_fSafetyStock), Nz(_fUnitCost),
                N(_fCustSav), N(_fCustGeo), N(_fDrawingNo), _fActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{no} 품목 등록 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fItemName)) { _modalErr = "품목명을 입력하세요."; return; }
        _busy = true;
        try
        {
            Md.UpdateItem(_fItemNo, _fItemName.Trim(), N(_fItemNameEn), N(_fItemType),
                N(_fItemCategory), N(_fUom), N(_fRoutingType),
                Nz(_fMinStock), Nz(_fMaxStock), Nz(_fSafetyStock), Nz(_fUnitCost),
                N(_fCustSav), N(_fCustGeo), N(_fDrawingNo), _fActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_fItemNo} 품목 수정 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        _busy = true;
        try
        {
            Md.DeleteItem(_fItemNo);
            CloseModal(); Reload();
            ShowMsg($"{_fItemNo} 삭제 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    RenderFragment ItemFormFields() =>
    @<div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <label>품목명 *</label>
                <input class="ames-input" @bind="_fItemName" autocomplete="off" />
            </div>
            <div>
                <label>품목명(영문)</label>
                <input class="ames-input" @bind="_fItemNameEn" autocomplete="off" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 80px;gap:8px;margin-top:6px;">
            <div>
                <label>품목유형</label>
                <input class="ames-input" @bind="_fItemType" autocomplete="off"
                       placeholder="예: FG, WIP, RM" maxlength="10" />
            </div>
            <div>
                <label>카테고리</label>
                <input class="ames-input" @bind="_fItemCategory" autocomplete="off"
                       placeholder="예: BUMPER, DOOR" maxlength="30" />
            </div>
            <div>
                <label>Routing</label>
                <input class="ames-input" @bind="_fRoutingType" maxlength="1" autocomplete="off"
                       placeholder="예: A" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <label>안전재고</label>
                <input type="number" class="ames-input" @bind="_fSafetyStock" min="0" step="0.0001" />
            </div>
            <div>
                <label>최소재고</label>
                <input type="number" class="ames-input" @bind="_fMinStock" min="0" step="0.0001" />
            </div>
            <div>
                <label>최대재고</label>
                <input type="number" class="ames-input" @bind="_fMaxStock" min="0" step="0.0001" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:6px;">
            <div>
                <label>단가</label>
                <input type="number" class="ames-input" @bind="_fUnitCost" min="0" step="0.01" />
            </div>
            <div>
                <label>고객품번(SAV)</label>
                <input class="ames-input" @bind="_fCustSav" maxlength="30" autocomplete="off" />
            </div>
            <div>
                <label>고객품번(GEO)</label>
                <input class="ames-input" @bind="_fCustGeo" maxlength="30" autocomplete="off" />
            </div>
        </div>

        <label style="margin-top:6px;">도면번호</label>
        <input class="ames-input" @bind="_fDrawingNo" maxlength="30" autocomplete="off" />

        <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="checkbox" @bind="_fActiveFlag" style="accent-color:#60a5fa;" />
            사용
        </label>
    </div>;

    static string? N(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    static decimal? Nz(decimal v) => v == 0 ? null : v;
}
