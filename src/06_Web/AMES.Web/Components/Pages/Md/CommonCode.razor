@page "/md/common-code"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject MasterDataRepository Md
@inject AuthenticationStateProvider Auth

<PageTitle>MD-025 코드 기준정보 관리 · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-025</div>
    <div class="ames-page-t">코드 기준정보 관리</div>
    <div class="ames-page-sub">코드 그룹 × 코드 항목</div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")" style="margin-bottom:12px;">@_msg</div>
}

<div style="display:flex;gap:16px;align-items:flex-start;">

    @* ── 좌: 코드 그룹 ─────────────────────────────────────────────── *@
    <div style="flex:0 0 480px;">
        <div class="ames-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                <span style="font-weight:600;font-size:1em;">코드 그룹</span>
                <button class="ames-btn ok" @onclick="OpenGroupCreate">+ 등록</button>
            </div>
            <table class="ames-table" style="table-layout:fixed;width:100%;">
                <thead>
                    <tr>
                        <th style="width:160px;">그룹코드</th>
                        <th>그룹명</th>
                        <th style="width:48px;text-align:center;">사용</th>
                        <th style="width:48px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in _groups)
                    {
                        var gCap = g;
                        <tr class="ames-row-link @(_selGroup?.GroupCode == g.GroupCode ? "ames-row-selected" : "")"
                            @onclick="() => OpenGroupEdit(gCap)">
                            <td class="code">@g.GroupCode</td>
                            <td>@g.GroupName</td>
                            <td style="text-align:center;">
                                <span class="pill @(g.UseFlag ? "ok" : "dim")">@(g.UseFlag ? "Y" : "N")</span>
                            </td>
                            <td style="text-align:center;">
                                <button class="ames-btn" style="padding:2px 10px;font-size:.85em;"
                                        title="항목 보기"
                                        @onclick:stopPropagation
                                        @onclick="() => SelectGroup(gCap)">▶</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── 우: 코드 항목 ─────────────────────────────────────────────── *@
    <div style="flex:1;min-width:0;">
        <div class="ames-card">
            @if (_selGroup is null)
            {
                <div class="dim" style="padding:24px 0;text-align:center;">← 코드 그룹의 ▶ 버튼을 눌러 항목을 조회하세요</div>
            }
            else
            {
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                    <span style="font-weight:600;font-size:1em;">
                        <span class="code" style="font-size:.9em;margin-right:6px;">@_selGroup.GroupCode</span>
                        @_selGroup.GroupName
                        <span class="dim" style="font-weight:400;margin-left:6px;">@(_items.Count)개 항목</span>
                    </span>
                    <button class="ames-btn ok" @onclick="OpenItemCreate">+ 등록</button>
                </div>
                <table class="ames-table">
                    <thead>
                        <tr>
                            <th style="width:60px;">순서</th>
                            <th style="width:120px;">코드값</th>
                            <th>코드명</th>
                            <th>코드명(영문)</th>
                            <th style="width:100px;">Attribute1</th>
                            <th style="width:44px;text-align:center;">사용</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            var iCap = item;
                            <tr class="ames-row-link" @onclick="() => OpenItemEdit(iCap)">
                                <td class="num">@item.SortOrder</td>
                                <td class="code">@item.CodeValue</td>
                                <td>@item.CodeName</td>
                                <td class="dim">@item.CodeNameEn</td>
                                <td class="dim">@item.Attribute1</td>
                                <td style="text-align:center;">
                                    <span class="pill @(item.UseFlag ? "ok" : "dim")">@(item.UseFlag ? "Y" : "N")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@* ── 코드 그룹 등록 모달 ────────────────────────────────────────────── *@
@if (_modal == "grp-create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:500px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">코드 그룹 등록</div>

            <label>그룹코드 * <span class="dim" style="font-size:.82em;">(영문·숫자·밑줄, 최대 20자)</span></label>
            <input class="ames-input" @bind="_fGroupCode" placeholder="예: DEFECT_TYPE" autocomplete="off" maxlength="20" />

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <label>그룹명 *</label>
                    <input class="ames-input" @bind="_fGroupName" placeholder="예: 불량 유형" autocomplete="off" />
                </div>
                <div>
                    <label>그룹명(영문)</label>
                    <input class="ames-input" @bind="_fGroupNameEn" placeholder="예: Defect Type" autocomplete="off" />
                </div>
            </div>

            <label style="margin-top:6px;">설명</label>
            <input class="ames-input" @bind="_fDescription" autocomplete="off" />

            <label style="margin-top:8px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_fUseFlag" style="accent-color:#60a5fa;" /> 사용
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveGroupCreate" disabled="@_busy">
                    @(_busy ? "저장 중…" : "등록")
                </button>
                <button class="ames-btn" @onclick="CloseModal">취소</button>
            </div>
        </div>
    </div>
}

@* ── 코드 그룹 수정/삭제 모달 ───────────────────────────────────────── *@
@if (_modal == "grp-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:500px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">코드 그룹 수정 — <span class="code" style="font-weight:400;font-size:.9em;">@_fGroupCode</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>그룹명 *</label>
                    <input class="ames-input" @bind="_fGroupName" autocomplete="off" />
                </div>
                <div>
                    <label>그룹명(영문)</label>
                    <input class="ames-input" @bind="_fGroupNameEn" autocomplete="off" />
                </div>
            </div>

            <label style="margin-top:6px;">설명</label>
            <input class="ames-input" @bind="_fDescription" autocomplete="off" />

            <label style="margin-top:8px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_fUseFlag" style="accent-color:#60a5fa;" /> 사용
            </label>

            @if (_grpConfirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>그룹과 하위 항목 @(_items.Count)개를 삭제합니까?</span>
                    <button class="ames-btn" @onclick='() => _grpConfirmDelete = false'>아니오</button>
                    <button class="ames-btn bad" @onclick="SaveGroupDelete" disabled="@_busy">
                        @(_busy ? "삭제 중…" : "예, 삭제")
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveGroupEdit" disabled="@_busy">
                    @(_busy ? "저장 중…" : "수정")
                </button>
                <button class="ames-btn bad" @onclick='() => { _grpConfirmDelete = true; _modalErr = ""; }' disabled="@_busy">삭제</button>
                <button class="ames-btn" @onclick="CloseModal">취소</button>
            </div>
        </div>
    </div>
}

@* ── 코드 항목 등록 모달 ────────────────────────────────────────────── *@
@if (_modal == "item-create" && _selGroup is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:560px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">코드 항목 등록 — <span class="code" style="font-weight:400;font-size:.9em;">@_selGroup.GroupCode</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>코드값 * <span class="dim" style="font-size:.82em;">(최대 20자)</span></label>
                    <input class="ames-input" value="@_fCodeValue"
                           @oninput="OnCodeValueInput"
                           placeholder="예: SCRAP" autocomplete="off" maxlength="20" />
                </div>
                <div>
                    <label>CodeID <span class="dim" style="font-size:.82em;">(자동생성, 최대 24자)</span></label>
                    <input class="ames-input" @bind="_fCodeId" autocomplete="off" maxlength="24" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <label>코드명 *</label>
                    <input class="ames-input" @bind="_fCodeName" autocomplete="off" />
                </div>
                <div>
                    <label>코드명(영문)</label>
                    <input class="ames-input" @bind="_fCodeNameEn" autocomplete="off" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:80px 1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <label>순서</label>
                    <input type="number" class="ames-input" @bind="_fSortOrder" min="0" />
                </div>
                <div>
                    <label>Attribute1</label>
                    <input class="ames-input" @bind="_fAttribute1" autocomplete="off" />
                </div>
                <div>
                    <label>설명</label>
                    <input class="ames-input" @bind="_fItemDescription" autocomplete="off" />
                </div>
            </div>

            <label style="margin-top:8px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_fItemUseFlag" style="accent-color:#60a5fa;" /> 사용
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveItemCreate" disabled="@_busy">
                    @(_busy ? "저장 중…" : "등록")
                </button>
                <button class="ames-btn" @onclick="CloseModal">취소</button>
            </div>
        </div>
    </div>
}

@* ── 코드 항목 수정/삭제 모달 ───────────────────────────────────────── *@
@if (_modal == "item-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:560px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">코드 항목 수정 — <span class="code" style="font-weight:400;font-size:.9em;">@_fCodeId</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>코드값 *</label>
                    <input class="ames-input" @bind="_fCodeValue" autocomplete="off" maxlength="20" />
                </div>
                <div>
                    <label>코드명 *</label>
                    <input class="ames-input" @bind="_fCodeName" autocomplete="off" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 80px 1fr;gap:8px;margin-top:6px;">
                <div>
                    <label>코드명(영문)</label>
                    <input class="ames-input" @bind="_fCodeNameEn" autocomplete="off" />
                </div>
                <div>
                    <label>순서</label>
                    <input type="number" class="ames-input" @bind="_fSortOrder" min="0" />
                </div>
                <div>
                    <label>Attribute1</label>
                    <input class="ames-input" @bind="_fAttribute1" autocomplete="off" />
                </div>
            </div>

            <label style="margin-top:6px;">설명</label>
            <input class="ames-input" @bind="_fItemDescription" autocomplete="off" />

            <label style="margin-top:8px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_fItemUseFlag" style="accent-color:#60a5fa;" /> 사용
            </label>

            @if (_itemConfirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@_fCodeId (@_fCodeName) 을 삭제합니까?</span>
                    <button class="ames-btn" @onclick='() => _itemConfirmDelete = false'>아니오</button>
                    <button class="ames-btn bad" @onclick="SaveItemDelete" disabled="@_busy">
                        @(_busy ? "삭제 중…" : "예, 삭제")
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad" style="margin-top:8px;">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveItemEdit" disabled="@_busy">
                    @(_busy ? "저장 중…" : "수정")
                </button>
                <button class="ames-btn bad" @onclick='() => { _itemConfirmDelete = true; _modalErr = ""; }' disabled="@_busy">삭제</button>
                <button class="ames-btn" @onclick="CloseModal">취소</button>
            </div>
        </div>
    </div>
}

@code {
    // ── State ────────────────────────────────────────────────────────────
    List<MasterDataRepository.CodeGroupRow> _groups = new();
    List<MasterDataRepository.CodeItemRow>  _items  = new();
    MasterDataRepository.CodeGroupRow?      _selGroup;

    string _modal             = "";
    string _modalErr          = "";
    string _msg               = "";
    bool   _isErr, _busy, _bgDown;
    bool   _grpConfirmDelete, _itemConfirmDelete;
    string _actor             = "system";

    // ── Group form fields ────────────────────────────────────────────────
    string _fGroupCode   = "";
    string _fGroupName   = "";
    string _fGroupNameEn = "";
    string _fDescription = "";
    bool   _fUseFlag     = true;

    // ── Item form fields ─────────────────────────────────────────────────
    string _fCodeId          = "";
    string _fCodeValue       = "";
    string _fCodeName        = "";
    string _fCodeNameEn      = "";
    int    _fSortOrder       = 0;
    string _fAttribute1      = "";
    bool   _fItemUseFlag     = true;
    string _fItemDescription = "";

    // ── Init ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor   = auth.User.Identity?.Name ?? "system";
        LoadGroups();
    }

    void LoadGroups() { try { _groups = Md.ListCodeGroups(); } catch { _groups = new(); } }

    void LoadItems()
    {
        if (_selGroup is null) { _items = new(); return; }
        try { _items = Md.ListCodeItems(_selGroup.GroupCode); } catch { _items = new(); }
    }

    void SelectGroup(MasterDataRepository.CodeGroupRow g) { _selGroup = g; LoadItems(); }

    // ── Modal helpers ─────────────────────────────────────────────────────
    void CloseModal() { _modal = ""; _modalErr = ""; _grpConfirmDelete = false; _itemConfirmDelete = false; }
    void OnBgDown()  => _bgDown = true;
    void OnBgClick() { if (_bgDown) CloseModal(); _bgDown = false; }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    // ── CodeGroup CRUD ────────────────────────────────────────────────────
    void OpenGroupCreate()
    {
        _fGroupCode = ""; _fGroupName = ""; _fGroupNameEn = "";
        _fDescription = ""; _fUseFlag = true;
        _grpConfirmDelete = false; _modalErr = "";
        _modal = "grp-create";
    }

    void OpenGroupEdit(MasterDataRepository.CodeGroupRow g)
    {
        _fGroupCode   = g.GroupCode;
        _fGroupName   = g.GroupName   ?? "";
        _fGroupNameEn = g.GroupNameEn ?? "";
        _fDescription = g.Description ?? "";
        _fUseFlag     = g.UseFlag;
        _grpConfirmDelete = false; _modalErr = "";
        // 아이템 카운트를 삭제 확인 메시지에 사용하기 위해 로드
        if (_selGroup?.GroupCode != g.GroupCode)
            try { _items = Md.ListCodeItems(g.GroupCode); } catch { _items = new(); }
        _modal = "grp-edit";
    }

    void SaveGroupCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fGroupCode)) { _modalErr = "그룹코드를 입력하세요."; return; }
        if (string.IsNullOrWhiteSpace(_fGroupName)) { _modalErr = "그룹명을 입력하세요."; return; }
        _busy = true;
        try
        {
            var code = _fGroupCode.Trim().ToUpper();
            if (Md.CodeGroupExists(code)) { _modalErr = $"'{code}' 이미 존재합니다."; return; }
            Md.InsertCodeGroup(code, _fGroupName.Trim(), N(_fGroupNameEn), N(_fDescription), _fUseFlag, _actor);
            LoadGroups(); CloseModal();
            ShowMsg($"{code} 그룹 등록 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveGroupEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fGroupName)) { _modalErr = "그룹명을 입력하세요."; return; }
        _busy = true;
        try
        {
            Md.UpdateCodeGroup(_fGroupCode, _fGroupName.Trim(), N(_fGroupNameEn), N(_fDescription), _fUseFlag, _actor);
            LoadGroups();
            if (_selGroup?.GroupCode == _fGroupCode)
                _selGroup = _groups.FirstOrDefault(g => g.GroupCode == _fGroupCode);
            CloseModal();
            ShowMsg($"{_fGroupCode} 수정 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveGroupDelete()
    {
        _busy = true;
        try
        {
            foreach (var item in _items) Md.DeleteCodeItem(item.CodeID);
            Md.DeleteCodeGroup(_fGroupCode);
            if (_selGroup?.GroupCode == _fGroupCode) { _selGroup = null; _items = new(); }
            LoadGroups(); CloseModal();
            ShowMsg("그룹 삭제 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    // ── CodeItem CRUD ────────────────────────────────────────────────────
    void OpenItemCreate()
    {
        int next = _items.Count > 0 ? (_items.Max(i => i.SortOrder ?? 0) + 10) : 10;
        _fCodeId = ""; _fCodeValue = ""; _fCodeName = ""; _fCodeNameEn = "";
        _fSortOrder = next; _fAttribute1 = ""; _fItemUseFlag = true; _fItemDescription = "";
        _itemConfirmDelete = false; _modalErr = "";
        _modal = "item-create";
    }

    void OnCodeValueInput(ChangeEventArgs e)
    {
        _fCodeValue = e.Value?.ToString() ?? "";
        var s = (_selGroup!.GroupCode + "_" + _fCodeValue.Trim().ToUpper());
        _fCodeId = s.Length <= 24 ? s : s[..24];
    }

    void OpenItemEdit(MasterDataRepository.CodeItemRow item)
    {
        _fCodeId          = item.CodeID;
        _fCodeValue       = item.CodeValue    ?? "";
        _fCodeName        = item.CodeName     ?? "";
        _fCodeNameEn      = item.CodeNameEn   ?? "";
        _fSortOrder       = item.SortOrder    ?? 0;
        _fAttribute1      = item.Attribute1   ?? "";
        _fItemUseFlag     = item.UseFlag;
        _fItemDescription = item.Description  ?? "";
        _itemConfirmDelete = false; _modalErr = "";
        _modal = "item-edit";
    }

    void SaveItemCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fCodeValue)) { _modalErr = "코드값을 입력하세요."; return; }
        if (string.IsNullOrWhiteSpace(_fCodeName))  { _modalErr = "코드명을 입력하세요."; return; }
        if (string.IsNullOrWhiteSpace(_fCodeId))    { _modalErr = "CodeID를 입력하세요."; return; }
        if (_fCodeId.Length > 24)                   { _modalErr = "CodeID는 24자 이하여야 합니다."; return; }
        _busy = true;
        try
        {
            var id = _fCodeId.Trim().ToUpper();
            if (Md.CodeItemExists(id)) { _modalErr = $"CodeID '{id}' 이미 존재합니다."; return; }
            Md.InsertCodeItem(id, _selGroup!.GroupCode, _fCodeValue.Trim(), _fCodeName.Trim(),
                N(_fCodeNameEn), _fSortOrder, N(_fAttribute1), _fItemUseFlag, N(_fItemDescription), _actor);
            LoadItems(); CloseModal();
            ShowMsg($"{id} 항목 등록 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveItemEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fCodeValue)) { _modalErr = "코드값을 입력하세요."; return; }
        if (string.IsNullOrWhiteSpace(_fCodeName))  { _modalErr = "코드명을 입력하세요."; return; }
        _busy = true;
        try
        {
            Md.UpdateCodeItem(_fCodeId, _fCodeValue.Trim(), _fCodeName.Trim(),
                N(_fCodeNameEn), _fSortOrder, N(_fAttribute1), _fItemUseFlag, N(_fItemDescription), _actor);
            LoadItems(); CloseModal();
            ShowMsg($"{_fCodeId} 수정 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveItemDelete()
    {
        _busy = true;
        try
        {
            Md.DeleteCodeItem(_fCodeId);
            LoadItems(); CloseModal();
            ShowMsg($"{_fCodeId} 삭제 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    static string? N(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
