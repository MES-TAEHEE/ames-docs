@page "/md/oven"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Oven.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-015</div>
    <div class="ames-page-t">@L["MD.Oven.Title"]</div>
    <div class="ames-page-sub">@L["MD.Oven.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.LineCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Oven.Kpi.AvgTargetTemp"]</div>
        <div class="ames-kpi-v">@(_allRows.Where(r => r.TargetTemp.HasValue).Select(r => r.TargetTemp!.Value) is { } temps && temps.Any() ? $"{temps.Average():F0}°C" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Oven.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:160px;padding:4px 8px;"
                   placeholder='@L["MD.Oven.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Line"]</span>
            <select class="ames-input" style="width:130px;padding:4px 8px;" @bind="_fLine">
                <option value="">@L["Filter.AllLines"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">@l.LineID@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _ovenStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">@(MasterDataRepository.LocalName(s))</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Oven.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.OvenId"]</th><th>@L["Col.Name"]</th><th>@L["Col.Line"]</th>
                    <th style="text-align:right;">@L["Col.ZoneCount"]</th>
                    <th style="text-align:right;">@L["Col.TargetTemp"]</th>
                    <th style="text-align:right;">@L["Col.TempTolerance"]</th>
                    <th style="text-align:right;">@L["Col.DwellTime"]</th>
                    <th style="text-align:right;">@L["Col.ConveyorSpeed"]</th>
                    <th style="text-align:right;">@L["Col.MaxLoad"]</th>
                    <th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.OvenID</td>
                        <td>@(r.OvenName ?? "—")</td>
                        <td class="dim">@(r.LineID ?? "—")</td>
                        <td style="text-align:right;">@(r.ZoneCount?.ToString() ?? "—")</td>
                        <td style="text-align:right;">@(r.TargetTemp?.ToString() ?? "—")</td>
                        <td style="text-align:right;">@(r.Tolerance.HasValue ? $"±{r.Tolerance}" : "—")</td>
                        <td style="text-align:right;">@(r.DwellSec?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(r.ConveyorSpeed?.ToString("F2") ?? "—")</td>
                        <td style="text-align:right;">@(r.MaxLoadKg?.ToString("F1") ?? "—")</td>
                        <td>
                            @{
                                var scls   = r.Status == "ACTIVE" ? "ok" : "bad";
                                var sLabel = _ovenStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } _lf_ ? MasterDataRepository.LocalName(_lf_) : r.Status;
                            }
                            <span class="pill @scls">@(sLabel ?? "—")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Oven.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.OvenId"] * <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: OV-PNT-001)</span></label>
            <input class="ames-input" @bind="_f.OvenID" placeholder="OV-PNT-001" autocomplete="off" />

            <label>@L["Col.Name"] *</label>
            <input class="ames-input" @bind="_f.OvenName" placeholder='@L["MD.Oven.Ph.OvenName"]' autocomplete="off" />

            <label>@L["Col.LineId"]</label>
            <select class="ames-input" @bind="_f.LineID">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">[@l.LineID]@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>

            <label>@L["MD.Oven.ZoneCount"]</label>
            <input class="ames-input" type="number" @bind="_f.ZoneCount" placeholder="5" min="1" autocomplete="off" />

            <label>@L["Col.TargetTemp"]</label>
            <input class="ames-input" type="number" @bind="_f.TargetTemp" placeholder="180" min="0" autocomplete="off" />

            <label>@L["Col.TempTolerance"]</label>
            <input class="ames-input" type="number" @bind="_f.Tolerance" placeholder="5" min="0" autocomplete="off" />

            <label>@L["Col.DwellTime"]</label>
            <input class="ames-input" type="number" @bind="_f.DwellSec" placeholder="1800" min="0" autocomplete="off" />

            <label>@L["Col.ConveyorSpeed"]</label>
            <input class="ames-input" type="number" step="0.01" @bind="_f.ConveyorSpeed" placeholder="1.50" min="0" autocomplete="off" />

            <label>@L["Col.MaxLoadKg"]</label>
            <input class="ames-input" type="number" step="0.1" @bind="_f.MaxLoadKg" placeholder="500.0" min="0" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _ovenStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">@(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Oven.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.OvenID</span></div>

            <label>@L["Col.Name"] *</label>
            <input class="ames-input" @bind="_f.OvenName" autocomplete="off" />

            <label>@L["Col.LineId"]</label>
            <select class="ames-input" @bind="_f.LineID">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">[@l.LineID]@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>

            <label>@L["MD.Oven.ZoneCount"]</label>
            <input class="ames-input" type="number" @bind="_f.ZoneCount" min="1" autocomplete="off" />

            <label>@L["Col.TargetTemp"]</label>
            <input class="ames-input" type="number" @bind="_f.TargetTemp" min="0" autocomplete="off" />

            <label>@L["Col.TempTolerance"]</label>
            <input class="ames-input" type="number" @bind="_f.Tolerance" min="0" autocomplete="off" />

            <label>@L["Col.DwellTime"]</label>
            <input class="ames-input" type="number" @bind="_f.DwellSec" min="0" autocomplete="off" />

            <label>@L["Col.ConveyorSpeed"]</label>
            <input class="ames-input" type="number" step="0.01" @bind="_f.ConveyorSpeed" min="0" autocomplete="off" />

            <label>@L["Col.MaxLoadKg"]</label>
            <input class="ames-input" type="number" step="0.1" @bind="_f.MaxLoadKg" min="0" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _ovenStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">@(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Edit"])</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.OvenRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.OvenRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.OvenRow? _sel;

    int _page = 0;
    const int _pageSize = 20;

    List<AMES.Data.Repositories.MasterDataRepository.LineRow>     _lineList   = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _ovenStatus = new();
    string _fSearch = "", _fLine = "", _fStatus = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        try { _lineList   = Md.ListLines();                      } catch { }
        try { _ovenStatus = Md.ListCodeItems("OVEN_STATUS"); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListOvens(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.OvenID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.OvenName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineID == _fLine) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.OvenRow r)
    {
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            OvenID         = r.OvenID,
            OvenName       = r.OvenName ?? "",
            LineID         = r.LineID   ?? "",
            ZoneCount      = r.ZoneCount,
            TargetTemp     = r.TargetTemp,
            Tolerance      = r.Tolerance,
            DwellSec       = r.DwellSec,
            ConveyorSpeed  = r.ConveyorSpeed,
            MaxLoadKg      = r.MaxLoadKg,
            Status         = r.Status   ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.OvenID))   { _modalErr = L["Err.OvenIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.OvenName))  { _modalErr = L["Err.NameRequired"]; return; }
        if (Md.OvenExists(_f.OvenID.Trim()))          { _modalErr = $"건조로 ID '{_f.OvenID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertOven(_f.OvenID.Trim(), _f.OvenName, NE(_f.LineID),
                _f.ZoneCount, _f.TargetTemp, _f.Tolerance, _f.DwellSec,
                _f.ConveyorSpeed, _f.MaxLoadKg, NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.OvenName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.OvenName)) { _modalErr = L["Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateOven(_sel.OvenID, _f.OvenName, NE(_f.LineID),
                _f.ZoneCount, _f.TargetTemp, _f.Tolerance, _f.DwellSec,
                _f.ConveyorSpeed, _f.MaxLoadKg, NE(_f.Status), _actor);
            var name = _f.OvenName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.OvenName ?? _sel.OvenID;
            Md.DeleteOven(_sel.OvenID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   OvenID        { get; set; } = "";
        public string   OvenName      { get; set; } = "";
        public string   LineID        { get; set; } = "";
        public int?     ZoneCount     { get; set; }
        public int?     TargetTemp    { get; set; }
        public int?     Tolerance     { get; set; }
        public int?     DwellSec      { get; set; }
        public decimal? ConveyorSpeed { get; set; }
        public decimal? MaxLoadKg     { get; set; }
        public string   Status        { get; set; } = "Active";
    }
}
