@page "/md/rm/rfid-tag"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-020 @L["MD.RfidTag.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-020" TitleKey="MD.RfidTag.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.RfidTag.Kpi.NeedReplace"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ReplaceSchedule.HasValue && r.ReplaceSchedule.Value <= DateOnly.FromDateTime(DateTime.Today))</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.RfidTag.Kpi.JigLinked"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.JigID != null)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.RfidTag.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.RfidTag.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:180px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.RfidTagRow" Data="_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.RfidTag.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="TagID" Title="@L["Col.TagId"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="code">@r.TagID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="EPC" Title="@L["Col.EPC"]" TextAlign="TextAlign.Center">
                <Template Context="r"><span class="dim">@(r.EPC ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="TagRole" Title="@L["Col.TagRole"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r">@(r.TagRole ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="JigID" Title="@L["Col.JigId"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="dim">@(r.JigID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="MountPos" Title="@L["Col.MountLocation"]" Width="150px">
                <Template Context="r"><span class="dim">@(r.MountPos ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="HeatRating" Title="@L["Col.HeatRating"]" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="r">@(r.HeatRating?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="CycleCount" Title="@L["Col.Cycles"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@(r.CycleCount?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="InstallDate" Title="@L["Col.InstallDate"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="dim">@(r.InstallDate?.ToString(DateFmt.DateShort) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="ReplaceSchedule" Title="@L["Col.ReplaceDue"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r">
                    @{ var needReplace = r.ReplaceSchedule.HasValue && r.ReplaceSchedule.Value <= DateOnly.FromDateTime(DateTime.Today); }
                    <span class="@(needReplace ? "bad" : "dim")">@(r.ReplaceSchedule?.ToString(DateFmt.DateShort) ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RfidTagRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="pill @(r.Status switch { "ACTIVE" => "ok", "REPLACED" => "warn", "FAILED" => "bad", _ => "mute" })">@(_rfidStatus.FirstOrDefault(x => x.CodeValue == r.Status) is { } stLf ? MasterDataRepository.LocalName(stLf) : r.Status ?? "—")</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RfidTag.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.TagId"]" class="ames-rz-modal-label" Component="CreateTextBoxTagID" />
                <RadzenTextBox Name="CreateTextBoxTagID" @bind-Value="_f.TagID" Placeholder="TAG-001" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.EPC"]" />
                    <RadzenTextBox @bind-Value="_f.EPC" Placeholder="E200..." AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.TagRole"]" />
                    <RadzenTextBox @bind-Value="_f.TagRole" Placeholder="JIG / CARRIER" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.JigId"]" />
                    <RadzenTextBox @bind-Value="_f.JigID" Placeholder="JIG-001" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.MountLocation"]" />
                    <RadzenTextBox @bind-Value="_f.MountPos" Placeholder="TOP" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.HeatRating"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.HeatRating" Placeholder="200" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Cycles"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CycleCount" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InstallDate"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.InstallDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ReplaceDue"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ReplaceSchedule" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RfidTag.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.TagID</span></div>

            <RadzenRow Gap="8px">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.EPC"]" />
                    <RadzenTextBox @bind-Value="_f.EPC" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.TagRole"]" />
                    <RadzenTextBox @bind-Value="_f.TagRole" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.JigId"]" />
                    <RadzenTextBox @bind-Value="_f.JigID" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.MountLocation"]" />
                    <RadzenTextBox @bind-Value="_f.MountPos" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.HeatRating"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.HeatRating" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Cycles"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CycleCount" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InstallDate"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.InstallDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ReplaceDue"]" />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ReplaceSchedule" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.RfidTagRow> _allRows = new();
    List<MasterDataRepository.RfidTagRow> _rows = new();
    List<MasterDataRepository.CodeItemRow> _rfidStatus = new();
    MasterDataRepository.RfidTagRow? _sel;

    string _fSearch = "";
    string? _fStatus;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> StatusFilterOptions => _rfidStatus.Where(x => x.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });
    IEnumerable<DropDownItem> StatusOptions => _rfidStatus.Where(x => x.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/rm/rfid-tag");
        try { _rfidStatus = MD.ListCodeItems("RFID_STATUS"); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.RfidTagRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { try { _allRows = MD.ListRfidTags(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.TagID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EPC ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fStatus == null || r.Status == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.RfidTagRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.RfidTagRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.RfidTagRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            EPC             = r.EPC       ?? "",
            JigID           = r.JigID     ?? "",
            TagRole         = r.TagRole   ?? "",
            HeatRating      = r.HeatRating,
            MountPos        = r.MountPos  ?? "",
            InstallDate     = r.InstallDate,
            CycleCount      = r.CycleCount,
            ReplaceSchedule = r.ReplaceSchedule,
            Status          = r.Status    ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.TagID)) { _modalErr = L["Err.TagIdRequired"]; return; }
        var id = _f.TagID.Trim();
        if (MD.RfidTagExists(id)) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], id); return; }
        _busy = true;
        try
        {
            MD.InsertRfidTag(id, NE(_f.EPC), NE(_f.JigID), NE(_f.TagRole),
                _f.HeatRating, NE(_f.MountPos),
                _f.InstallDate, _f.CycleCount, _f.ReplaceSchedule,
                NE(_f.Status), _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            MD.UpdateRfidTag(_sel.TagID, NE(_f.EPC), NE(_f.JigID), NE(_f.TagRole),
                _f.HeatRating, NE(_f.MountPos),
                _f.InstallDate, _f.CycleCount, _f.ReplaceSchedule,
                NE(_f.Status), _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{_sel.TagID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.TagID;
            MD.DeleteRfidTag(_sel.TagID);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string    TagID           { get; set; } = "";
        public string    EPC             { get; set; } = "";
        public string    JigID           { get; set; } = "";
        public string    TagRole         { get; set; } = "";
        public int?      HeatRating      { get; set; }
        public string    MountPos        { get; set; } = "";
        public DateOnly? InstallDate     { get; set; }
        public int?      CycleCount      { get; set; }
        public DateOnly? ReplaceSchedule { get; set; }
        public string    Status          { get; set; } = "ACTIVE";
    }
}