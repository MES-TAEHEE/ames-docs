@page "/md/rm/rfid-tag"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.RfidTag.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.RfidTag.Kpi.NeedReplace"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ReplaceSchedule.HasValue && r.ReplaceSchedule.Value <= DateOnly.FromDateTime(DateTime.Today))</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.RfidTag.Kpi.JigLinked"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.JigID != null)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.RfidTag.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder="TagID / EPC" Style="width:140px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Status"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fStatus" Data="StatusFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllStatus"]' Style="width:130px;" />
            <RadzenButton Text='@L["Btn.Search"]' ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="ApplyFilter" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.RfidTagRow"
                    RowRender="TagRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.RfidTag.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="TagID" Title='@L["Col.TagId"]' Width="130px">
                <Template Context="r"><span class="code">@r.TagID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="EPC" Title='@L["Col.EPC"]' Width="140px">
                <Template Context="r"><span class="dim">@(r.EPC ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="TagRole" Title='@L["Col.TagRole"]' Width="100px">
                <Template Context="r">@(r.TagRole ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="JigID" Title='@L["Col.JigId"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.JigID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="MountPos" Title='@L["Col.MountLocation"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.MountPos ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="HeatRating" Title='@L["Col.HeatRating"]' Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.HeatRating?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="CycleCount" Title='@L["Col.Cycles"]' Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.CycleCount?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="InstallDate" Title='@L["Col.InstallDate"]' Width="105px">
                <Template Context="r"><span class="dim">@(r.InstallDate?.ToString("yy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ReplaceSchedule" Title='@L["Col.ReplaceDue"]' Width="105px">
                <Template Context="r">
                    @{ var needReplace = r.ReplaceSchedule.HasValue && r.ReplaceSchedule.Value <= DateOnly.FromDateTime(DateTime.Today); }
                    <span class="@(needReplace ? "bad" : "dim")">@(r.ReplaceSchedule?.ToString("yy-MM-dd") ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Status" Title='@L["Col.Status"]' Width="100px">
                <Template Context="r">
                    <span class="pill @(r.Status == "ACTIVE" ? "ok" : "warn")">@(_rfidStatus.FirstOrDefault(x => x.CodeValue == r.Status) is { } stLf ? MasterDataRepository.LocalName(stLf) : r.Status ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RfidTag.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.TagId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.TagID" Placeholder="TAG-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.EPC"]' /><br />
                    <RadzenTextBox @bind-Value="_f.EPC" Placeholder="E200..." Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.TagRole"]' /><br />
                    <RadzenTextBox @bind-Value="_f.TagRole" Placeholder="JIG / CARRIER" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.JigId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.JigID" Placeholder="JIG-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.MountLocation"]' /><br />
                    <RadzenTextBox @bind-Value="_f.MountPos" Placeholder="TOP" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.HeatRating"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.HeatRating" Placeholder="200" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Cycles"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CycleCount" Min="0" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InstallDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.InstallDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ReplaceDue"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ReplaceSchedule" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <div class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RfidTag.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.TagID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.EPC"]' /><br />
                    <RadzenTextBox @bind-Value="_f.EPC" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.TagRole"]' /><br />
                    <RadzenTextBox @bind-Value="_f.TagRole" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.JigId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.JigID" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.MountLocation"]' /><br />
                    <RadzenTextBox @bind-Value="_f.MountPos" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.HeatRating"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.HeatRating" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Cycles"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CycleCount" Min="0" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InstallDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.InstallDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ReplaceDue"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ReplaceSchedule" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Light" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" />
                </div>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <div class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" ButtonStyle="ButtonStyle.Danger" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.RfidTagRow> _allRows = new();
    List<MasterDataRepository.RfidTagRow> _rows    = new();
    MasterDataRepository.RfidTagRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    List<MasterDataRepository.CodeItemRow> _rfidStatus = new();
    string? _fStatus;
    string  _fSearch = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    IEnumerable<DropDownItem> StatusFilterOptions =>
        _rfidStatus.Where(x => x.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });
    IEnumerable<DropDownItem> StatusOptions =>
        _rfidStatus.Where(x => x.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });

    void TagRowRender(RowRenderEventArgs<MasterDataRepository.RfidTagRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rm/rfid-tag");
        try { _rfidStatus = Md.ListCodeItems("RFID_STATUS"); } catch { }
        Reload();
    }

    void Reload() { try { _allRows = Md.ListRfidTags(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.TagID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EPC ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fStatus == null || r.Status == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.RfidTagRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            EPC             = r.EPC       ?? "",
            JigID           = r.JigID     ?? "",
            TagRole         = r.TagRole   ?? "",
            HeatRating      = r.HeatRating,
            MountPos        = r.MountPos  ?? "",
            InstallDate     = r.InstallDate,
            CycleCount      = r.CycleCount,
            ReplaceSchedule = r.ReplaceSchedule,
            Status          = r.Status    ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.TagID)) { _modalErr = L["Err.TagIdRequired"]; return; }
        var id = _f.TagID.Trim();
        if (Md.RfidTagExists(id)) { _modalErr = $"'{id}' TagID가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertRfidTag(id, NE(_f.EPC), NE(_f.JigID), NE(_f.TagRole),
                _f.HeatRating, NE(_f.MountPos),
                _f.InstallDate, _f.CycleCount, _f.ReplaceSchedule,
                NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            Md.UpdateRfidTag(_sel.TagID, NE(_f.EPC), NE(_f.JigID), NE(_f.TagRole),
                _f.HeatRating, NE(_f.MountPos),
                _f.InstallDate, _f.CycleCount, _f.ReplaceSchedule,
                NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.TagID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.TagID;
            Md.DeleteRfidTag(_sel.TagID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string    TagID           { get; set; } = "";
        public string    EPC             { get; set; } = "";
        public string    JigID           { get; set; } = "";
        public string    TagRole         { get; set; } = "";
        public int?      HeatRating      { get; set; }
        public string    MountPos        { get; set; } = "";
        public DateOnly? InstallDate     { get; set; }
        public int?      CycleCount      { get; set; }
        public DateOnly? ReplaceSchedule { get; set; }
        public string    Status          { get; set; } = "ACTIVE";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}