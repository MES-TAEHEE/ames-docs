@page "/md/rm/ral-color"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.RalColor.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.RalColor.Kpi.PowderLots"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.CurrentPowderLot != null)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.RalColor.Kpi.AvgCureTemp"]</div>
        <div class="ames-kpi-v">@((_allRows.Where(r => r.CureTemp.HasValue).Select(r => r.CureTemp!.Value) is var temps && temps.Any()) ? $"{temps.Average():0}°C" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.RalColor.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.RalColor.Ph.Search"]' Style="width:140px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Active"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fActive" Data="_activeFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.All"]' Style="width:110px;" />
            <RadzenButton Text='@L["Btn.Search"]' ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="ApplyFilter" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.RalColorRow"
                    RowRender="ColorRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.RalColor.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="RALCode" Title='@L["Col.RalCode"]' Width="110px">
                <Template Context="r"><span class="code">@r.RALCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ColorName" Title='@L["Col.ColorName"]' Width="160px">
                <Template Context="r">
                    @{ var hex1 = ValidHex(r.HexValue); var fg1 = hex1 != null ? TextColorFor(hex1) : null; }
                    <span style="@(hex1 != null ? $"background:{hex1};color:{fg1};font-weight:500;padding:2px 6px;border-radius:4px;" : "")">@(r.ColorName ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="HexValue" Title='@L["Col.Hex"]' Width="130px">
                <Template Context="r">
                    @{ var hex2 = ValidHex(r.HexValue); var fg2 = hex2 != null ? TextColorFor(hex2) : null; }
                    @if (hex2 != null)
                    { <span style="background:@hex2;color:@fg2;padding:2px 6px;border-radius:4px;">@hex2</span> }
                    else if (r.HexValue != null)
                    {
                        <span style="display:inline-flex;align-items:center;gap:5px;">
                            <span style="width:14px;height:14px;border-radius:3px;background:@r.HexValue;border:1px solid #cbd5e1;display:inline-block;"></span>
                            @r.HexValue
                        </span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="CurrentPowderLot" Title='@L["Col.CurrentLot"]' Width="130px">
                <Template Context="r"><span class="dim">@(r.CurrentPowderLot ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="CureTemp" Title='@L["Col.CureTemp"]' Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.CureTemp?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="CureDuration" Title='@L["Col.CureTime"]' Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.CureDuration?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ElectroV" Title='@L["Col.Voltage"]' Width="75px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.ElectroV?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ParticleUm" Title='@L["Col.ParticleSize"]' Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.ParticleUm?.ToString("0.0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ActiveFlag" Title='@L["Col.Status"]' Width="90px">
                <Template Context="r">
                    @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RalColor.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.RalCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.RALCode" Placeholder="RAL1000" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ColorName"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ColorName" Placeholder="Green Beige" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Hex"]' /><br />
                    <RadzenTextBox @bind-Value="_f.HexValue" Placeholder="#CDBA88" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.CurrentLot"]' /><br />
                    <RadzenTextBox @bind-Value="_f.CurrentPowderLot" Placeholder="LOT-2024-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.CureTemp"]} (°C)")' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CureTemp" Placeholder="180" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.CureTime"]} (분)")' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CureDuration" Placeholder="20" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.Voltage"]} (V)")' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ElectroV" Placeholder="70" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.ParticleSize"]} (μm)")' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ParticleUm" Step="0.1m" Placeholder="60.0" Style="width:100%;" />
                </div>
            </div>
            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <div class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RalColor.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.RALCode</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.ColorName"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ColorName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Hex"]' /><br />
                    <RadzenTextBox @bind-Value="_f.HexValue" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.CurrentLot"]' /><br />
                    <RadzenTextBox @bind-Value="_f.CurrentPowderLot" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.CureTemp"]} (°C)")' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CureTemp" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.CureTime"]} (분)")' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CureDuration" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.Voltage"]} (V)")' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ElectroV" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.ParticleSize"]} (μm)")' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ParticleUm" Step="0.1m" Style="width:100%;" />
                </div>
            </div>
            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>
            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Light" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" />
                </div>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <div class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" ButtonStyle="ButtonStyle.Danger" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.RalColorRow> _allRows = new();
    List<MasterDataRepository.RalColorRow> _rows    = new();
    MasterDataRepository.RalColorRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string? _fActive;
    string  _fSearch = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    DropDownItem[] _activeFilterOptions =
    {
        new() { Value = "Y", Text = "Active" },
        new() { Value = "N", Text = "Inactive" },
    };

    void ColorRowRender(RowRenderEventArgs<MasterDataRepository.RalColorRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rm/ral-color");
        Reload();
    }

    void Reload() { try { _allRows = Md.ListRalColors(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.RALCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ColorName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fActive == null || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.RalColorRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            ColorName        = r.ColorName        ?? "",
            HexValue         = r.HexValue         ?? "",
            CurrentPowderLot = r.CurrentPowderLot ?? "",
            CureTemp         = r.CureTemp,
            CureDuration     = r.CureDuration,
            ElectroV         = r.ElectroV,
            ParticleUm       = r.ParticleUm,
            ActiveFlag       = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    static string? ValidHex(string? hex)
    {
        if (hex == null) return null;
        var h = hex.Trim();
        return System.Text.RegularExpressions.Regex.IsMatch(h, @"^#[0-9A-Fa-f]{3}(?:[0-9A-Fa-f]{3})?$") ? h : null;
    }

    static string TextColorFor(string hex)
    {
        if (hex.Length == 4)
            hex = $"#{hex[1]}{hex[1]}{hex[2]}{hex[2]}{hex[3]}{hex[3]}";
        int r = Convert.ToInt32(hex.Substring(1, 2), 16);
        int g = Convert.ToInt32(hex.Substring(3, 2), 16);
        int b = Convert.ToInt32(hex.Substring(5, 2), 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.55 ? "#1e293b" : "#ffffff";
    }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.RALCode)) { _modalErr = L["Err.RalCodeRequired"]; return; }
        var code = _f.RALCode.Trim().ToUpper();
        if (Md.RalColorExists(code)) { _modalErr = $"'{code}' 코드가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertRalColor(code, NE(_f.ColorName), NE(_f.HexValue),
                NE(_f.CurrentPowderLot), _f.CureTemp, _f.CureDuration,
                _f.ElectroV, _f.ParticleUm, _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{code} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            Md.UpdateRalColor(_sel.RALCode, NE(_f.ColorName), NE(_f.HexValue),
                NE(_f.CurrentPowderLot), _f.CureTemp, _f.CureDuration,
                _f.ElectroV, _f.ParticleUm, _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.RALCode} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var code = _sel.RALCode;
            Md.DeleteRalColor(_sel.RALCode);
            CloseModal(); Reload();
            ShowMsg($"{code} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   RALCode          { get; set; } = "";
        public string   ColorName        { get; set; } = "";
        public string   HexValue         { get; set; } = "";
        public string   CurrentPowderLot { get; set; } = "";
        public int?     CureTemp         { get; set; }
        public int?     CureDuration     { get; set; }
        public int?     ElectroV         { get; set; }
        public decimal? ParticleUm       { get; set; }
        public bool     ActiveFlag       { get; set; } = true;
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}