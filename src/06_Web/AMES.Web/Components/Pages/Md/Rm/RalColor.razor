@page "/md/rm/ral-color"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-021 @L["MD.RalColor.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-021" TitleKey="MD.RalColor.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.RalColor.Kpi.PowderLots"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.CurrentPowderLot != null)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.RalColor.Kpi.AvgCureTemp"]</div>
        <div class="ames-kpi-v">@((_allRows.Where(r => r.CureTemp.HasValue).Select(r => r.CureTemp!.Value) is var temps && temps.Any()) ? $"{temps.Average():0}°C" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.RalColor.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' Placeholder='@L["MD.RalColor.Ph.Search"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" AutoCompleteType="AutoCompleteType.Off" />
            <RadzenLabel Text='@L["Col.Active"]' Component="DropDownActive" />
            <RadzenDropDown Name="DropDownActive" @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["Filter.All"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.RalColorRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.RalColor.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="RALCode" Title="@L["Col.RalCode"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="code">@r.RALCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="ColorName" Title="@L["Col.ColorName"]">
                <Template Context="r">
                    @{ var hex1 = ValidHex(r.HexValue); var fg1 = hex1 != null ? TextColorFor(hex1) : null; }
                    <span style="@(hex1 != null ? $"background:{hex1};color:{fg1};font-weight:500;padding:2px 6px;border-radius:4px;" : "")">@(r.ColorName ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="HexValue" Title="@L["Col.Hex"]" Width="130px">
                <Template Context="r">
                    @{ var hex2 = ValidHex(r.HexValue); var fg2 = hex2 != null ? TextColorFor(hex2) : null; }
                    @if (hex2 != null)
                    { <span style="background:@hex2;color:@fg2;padding:2px 6px;border-radius:4px;">@hex2</span> }
                    else if (r.HexValue != null)
                    {
                        <span style="display:inline-flex;align-items:center;gap:5px;">
                            <span style="width:14px;height:14px;border-radius:3px;background:@r.HexValue;border:1px solid #cbd5e1;display:inline-block;"></span>
                            @r.HexValue
                        </span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="CurrentPowderLot" Title="@L["Col.CurrentLot"]" Width="150px">
                <Template Context="r"><span class="dim">@(r.CurrentPowderLot ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="CureTemp" Title="@L["Col.CureTemp"]" TextAlign="TextAlign.Right" Width="140px">
                <Template Context="r">@(r.CureTemp?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="CureDuration" Title="@L["Col.CureTime"]" TextAlign="TextAlign.Right" Width="130px">
                <Template Context="r">@(r.CureDuration?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="ElectroV" Title="@L["Col.Voltage"]" TextAlign="TextAlign.Right" Width="120px">
                <Template Context="r">@(r.ElectroV?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="ParticleUm" Title="@L["Col.ParticleSize"]" TextAlign="TextAlign.Right" Width="130px">
                <Template Context="r">@(r.ParticleUm?.ToString("0.0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.RalColorRow" Property="ActiveFlag" Title="@L["Col.Active"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r">
                    @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RalColor.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@L["Col.RalCode"]' class="ames-rz-modal-label" Component="CreateTextBoxRALCode" />
                <RadzenTextBox Name="CreateTextBoxRALCode" @bind-Value="_f.RALCode" Placeholder="RAL1000" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@L["Col.ColorName"]' class="ames-rz-modal-label" Component="CreateTextBoxColorName" />
                <RadzenTextBox Name="CreateTextBoxColorName" @bind-Value="_f.ColorName" Placeholder="Green Beige" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Hex"]' />
                    <RadzenColorPicker @bind-Value="_f.HexValue" ShowHSV="true" ShowRGBA="true" ShowColors="true" ShowButton="true" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.CurrentLot"]' />
                    <RadzenTextBox @bind-Value="_f.CurrentPowderLot" Placeholder="LOT-2024-001" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.CureTemp"]} (°C)")' />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CureTemp" Placeholder="180" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.CureTime"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CureDuration" Placeholder="20" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.Voltage"]} (V)")' />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ElectroV" Placeholder="70" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.ParticleSize"]} (μm)")' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ParticleUm" Step="0.1" Placeholder="60.0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" Name="CreateChkActive" />
                <RadzenLabel Text="@L["Lbl.Active"]" Component="CreateChkActive" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RalColor.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.RALCode</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@L["Col.ColorName"]' class="ames-rz-modal-label" Component="EditTextBoxColorName" />
                <RadzenTextBox Name="EditTextBoxColorName" @bind-Value="_f.ColorName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Hex"]' />
                    <RadzenColorPicker @bind-Value="_f.HexValue" ShowHSV="true" ShowRGBA="true" ShowColors="true" ShowButton="true" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.CurrentLot"]' />
                    <RadzenTextBox @bind-Value="_f.CurrentPowderLot" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.CureTemp"]} (°C)")' />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CureTemp" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.CureTime"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CureDuration" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.Voltage"]} (V)")' />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.ElectroV" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.ParticleSize"]} (μm)")' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.ParticleUm" Step="0.1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" Name="EditChkActive" />
                <RadzenLabel Text="@L["Lbl.Active"]" Component="EditChkActive" style="cursor:pointer;" />
            </RadzenStack>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.RalColorRow> _allRows = new();
    List<MasterDataRepository.RalColorRow> _rows    = new();
    MasterDataRepository.RalColorRow? _sel;

    string _fSearch = "";
    string? _fActive;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    List<MasterDataRepository.CodeItemRow> _activeFlagItems = new();
    private IEnumerable<DropDownItem> ActiveFilterOptions =>
        _activeFlagItems.Where(a => a.UseFlag).Select(a => new DropDownItem { Value = a.CodeValue ?? "", Text = MasterDataRepository.LocalName(a) });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/rm/ral-color");
        try { _activeFlagItems = MD.ListCodeItems("ACTIVE_FLAG"); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.RalColorRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { try { _allRows = MD.ListRalColors(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.RALCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ColorName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fActive == null || (_fActive == "ACTIVE" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.RalColorRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.RalColorRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.RalColorRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            ColorName        = r.ColorName        ?? "",
            HexValue         = r.HexValue         ?? "",
            CurrentPowderLot = r.CurrentPowderLot ?? "",
            CureTemp         = r.CureTemp,
            CureDuration     = r.CureDuration,
            ElectroV         = r.ElectroV,
            ParticleUm       = r.ParticleUm,
            ActiveFlag       = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.RALCode)) { _modalErr = L["Err.RalCodeRequired"]; return; }
        var code = _f.RALCode.Trim().ToUpper();
        if (MD.RalColorExists(code)) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], code); return; }
        _busy = true;
        try
        {
            MD.InsertRalColor(code, NE(_f.ColorName), NormHex(_f.HexValue),
                NE(_f.CurrentPowderLot), _f.CureTemp, _f.CureDuration,
                _f.ElectroV, _f.ParticleUm, _f.ActiveFlag, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{code} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            MD.UpdateRalColor(_sel.RALCode, NE(_f.ColorName), NormHex(_f.HexValue),
                NE(_f.CurrentPowderLot), _f.CureTemp, _f.CureDuration,
                _f.ElectroV, _f.ParticleUm, _f.ActiveFlag, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{_sel.RALCode} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var code = _sel.RALCode;
            MD.DeleteRalColor(_sel.RALCode);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{code} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    // ColorPicker가 rgb()/rgba()를 낼 수 있어 DB엔 항상 #RRGGBB 로 저장
    static string? NormHex(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        var v = s.Trim();
        var m = System.Text.RegularExpressions.Regex.Match(v, @"^rgba?\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})");
        if (m.Success)
        {
            int r = Math.Clamp(int.Parse(m.Groups[1].Value), 0, 255);
            int g = Math.Clamp(int.Parse(m.Groups[2].Value), 0, 255);
            int b = Math.Clamp(int.Parse(m.Groups[3].Value), 0, 255);
            return $"#{r:X2}{g:X2}{b:X2}";
        }
        return v.StartsWith("#") ? v.ToUpperInvariant() : v;
    }

    static string? ValidHex(string? hex)
    {
        if (hex == null) return null;
        var h = hex.Trim();
        return System.Text.RegularExpressions.Regex.IsMatch(h, @"^#[0-9A-Fa-f]{3}(?:[0-9A-Fa-f]{3})?$") ? h : null;
    }

    static string TextColorFor(string hex)
    {
        if (hex.Length == 4)
            hex = $"#{hex[1]}{hex[1]}{hex[2]}{hex[2]}{hex[3]}{hex[3]}";
        int r = Convert.ToInt32(hex.Substring(1, 2), 16);
        int g = Convert.ToInt32(hex.Substring(3, 2), 16);
        int b = Convert.ToInt32(hex.Substring(5, 2), 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.55 ? "#1e293b" : "#ffffff";
    }

    class FormModel
    {
        public string   RALCode          { get; set; } = "";
        public string   ColorName        { get; set; } = "";
        public string   HexValue         { get; set; } = "";
        public string   CurrentPowderLot { get; set; } = "";
        public int?     CureTemp         { get; set; }
        public int?     CureDuration     { get; set; }
        public int?     ElectroV         { get; set; }
        public decimal? ParticleUm       { get; set; }
        public bool     ActiveFlag       { get; set; } = true;
    }
}