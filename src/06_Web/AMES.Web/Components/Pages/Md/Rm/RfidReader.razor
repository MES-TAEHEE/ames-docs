@page "/md/rm/rfid-reader"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.RfidReader.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["MD.RfidReader.Kpi.Online"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.RfidReader.Kpi.Maint"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "MAINT")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.LineCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.RfidReader.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.RfidReader.Ph.Search"]' Style="width:140px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Line"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fLine" Data="LineFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllLines"]' Style="width:150px;" />
            <RadzenLabel Text='@L["Col.Status"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fStatus" Data="StatusFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllStatus"]' Style="width:110px;" />
            <RadzenButton Text='@L["Btn.Search"]' ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="ApplyFilter" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.RfidReaderRow"
                    RowRender="ReaderRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.RfidReader.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="ReaderID" Title='@L["Col.ReaderId"]' Width="120px">
                <Template Context="r"><span class="code">@r.ReaderID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ReaderName" Title='@L["Col.ReaderName"]' />
            <RadzenDataGridColumn Property="LineID" Title='@L["Col.Line"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.LineID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="GateLocation" Title='@L["Col.Gate"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.GateLocation ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="IpAddress" Title='@L["Col.IpAddr"]' Width="130px">
                <Template Context="r"><span class="dim">@(r.IpAddress ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="AntennaCount" Title='@L["Col.Antenna"]' Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.AntennaCount?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="PowerDbm" Title='@L["Col.OutputDbm"]' Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.PowerDbm?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="WindowMs" Title='@L["Col.WindowMs"]' Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.WindowMs?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="PeTriggerFlag" Title='@L["Col.PeTrigger"]' Width="90px">
                <Template Context="r">
                    @if (r.PeTriggerFlag) { <span class="pill ok">ON</span> }
                    else { <span class="pill">OFF</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="FirmwareVer" Title='@L["Col.Firmware"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.FirmwareVer ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Status" Title='@L["Col.Status"]' Width="100px">
                <Template Context="r">
                    @{ var scls = r.Status == "ONLINE" ? "ok" : "bad";
                       var sLabel = _readerStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status; }
                    <span class="pill @scls">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RfidReader.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.ReaderId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ReaderID" Placeholder="RDR-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ReaderName"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ReaderName" Placeholder='@L["MD.RfidReader.Ph.ReaderName"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Line"]' /><br />
                    <RadzenDropDown @bind-Value="_f.LineID" Data="LineOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Gate"]' /><br />
                    <RadzenTextBox @bind-Value="_f.GateLocation" Placeholder="GATE-A" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.IpAddr"]' /><br />
                    <RadzenTextBox @bind-Value="_f.IpAddress" Placeholder="192.168.1.100" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Firmware"]' /><br />
                    <RadzenTextBox @bind-Value="_f.FirmwareVer" Placeholder="v2.1.0" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Antenna"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.AntennaCount" Min="1" Placeholder="4" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.OutputDbm"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.PowerDbm" Placeholder="27" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.WindowMs"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.WindowMs" Placeholder="500" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.PeTriggerFlag" />
                    <span>@L["Col.PeTrigger"]</span>
                </label>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <div class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.RfidReader.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.ReaderID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.ReaderName"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ReaderName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Line"]' /><br />
                    <RadzenDropDown @bind-Value="_f.LineID" Data="LineOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Gate"]' /><br />
                    <RadzenTextBox @bind-Value="_f.GateLocation" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.IpAddr"]' /><br />
                    <RadzenTextBox @bind-Value="_f.IpAddress" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Antenna"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.AntennaCount" Min="1" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.OutputDbm"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.PowerDbm" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.WindowMs"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.WindowMs" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Firmware"]' /><br />
                    <RadzenTextBox @bind-Value="_f.FirmwareVer" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.PeTriggerFlag" />
                    <span>@L["Col.PeTrigger"]</span>
                </label>
            </div>
            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Light" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" />
                </div>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <div class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" ButtonStyle="ButtonStyle.Danger" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.RfidReaderRow> _allRows = new();
    List<MasterDataRepository.RfidReaderRow> _rows    = new();
    MasterDataRepository.RfidReaderRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    List<MasterDataRepository.LineRow>     _lineList     = new();
    List<MasterDataRepository.CodeItemRow> _readerStatus = new();
    string? _fLine, _fStatus;
    string  _fSearch = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    IEnumerable<DropDownItem> LineFilterOptions =>
        _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = l.LineID + (l.LineName != null ? $" {l.LineName}" : "") });
    IEnumerable<DropDownItem> LineOptions =>
        _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = $"[{l.LineID}]" + (l.LineName != null ? $" {l.LineName}" : "") });
    IEnumerable<DropDownItem> StatusFilterOptions =>
        _readerStatus.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });
    IEnumerable<DropDownItem> StatusOptions =>
        _readerStatus.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });

    void ReaderRowRender(RowRenderEventArgs<MasterDataRepository.RfidReaderRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rm/rfid-reader");
        try { _lineList     = Md.ListLines();                         } catch { }
        try { _readerStatus = Md.ListCodeItems("RFID_READER_STATUS"); } catch { }
        Reload();
    }

    void Reload() { try { _allRows = Md.ListRfidReaders(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.ReaderID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ReaderName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fLine   == null || r.LineID == _fLine) &&
        (_fStatus == null || r.Status == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.RfidReaderRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            ReaderName    = r.ReaderName    ?? "",
            GateLocation  = r.GateLocation  ?? "",
            LineID        = r.LineID,
            AntennaCount  = r.AntennaCount,
            PowerDbm      = r.PowerDbm,
            PeTriggerFlag = r.PeTriggerFlag,
            WindowMs      = r.WindowMs,
            IpAddress     = r.IpAddress     ?? "",
            FirmwareVer   = r.FirmwareVer   ?? "",
            Status        = r.Status        ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ReaderID)) { _modalErr = L["Err.ReaderIdRequired"]; return; }
        var id = _f.ReaderID.Trim();
        if (Md.RfidReaderExists(id)) { _modalErr = $"'{id}' ID가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertRfidReader(id, NE(_f.ReaderName), NE(_f.GateLocation),
                _f.LineID, _f.AntennaCount, _f.PowerDbm, _f.PeTriggerFlag,
                _f.WindowMs, NE(_f.IpAddress), NE(_f.FirmwareVer), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            Md.UpdateRfidReader(_sel.ReaderID, NE(_f.ReaderName), NE(_f.GateLocation),
                _f.LineID, _f.AntennaCount, _f.PowerDbm, _f.PeTriggerFlag,
                _f.WindowMs, NE(_f.IpAddress), NE(_f.FirmwareVer), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.ReaderID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.ReaderID;
            Md.DeleteRfidReader(_sel.ReaderID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string  ReaderID      { get; set; } = "";
        public string  ReaderName    { get; set; } = "";
        public string  GateLocation  { get; set; } = "";
        public string? LineID        { get; set; }
        public int?    AntennaCount  { get; set; }
        public int?    PowerDbm      { get; set; }
        public bool    PeTriggerFlag { get; set; } = false;
        public int?    WindowMs      { get; set; }
        public string  IpAddress     { get; set; } = "";
        public string  FirmwareVer   { get; set; } = "";
        public string  Status        { get; set; } = "ACTIVE";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}