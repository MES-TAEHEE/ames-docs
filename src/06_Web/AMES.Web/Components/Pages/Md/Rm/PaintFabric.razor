@page "/md/rm/paint-fabric"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.PaintFabric.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.PaintFabric.Kpi.ExpiringSoon"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ExpDate.HasValue && r.ExpDate.Value >= _today && r.ExpDate.Value <= _today.AddDays(30))</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.PaintFabric.Kpi.MatTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.MatType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.PaintFabric.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.PaintFabric.Ph.Search"]' Style="width:180px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Type"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fType" Data="MatTypeFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllTypes"]' Style="width:160px;" />
            <RadzenLabel Text='@L["Col.Status"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fStatus" Data="MatStatusFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllStatus"]' Style="width:140px;" />
            <RadzenButton Text='@L["Btn.Search"]' ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="ApplyFilter" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.PaintFabricRow"
                    RowRender="PfRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.PaintFabric.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="MatLotID" Title='@L["Col.LotId"]' Width="155px">
                <Template Context="r"><span class="code">@r.MatLotID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="MatCode" Title='@L["Col.MaterialCode"]' Width="120px">
                <Template Context="r"><span class="code dim">@(r.MatCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="MatName" Title='@L["Col.Name"]' />
            <RadzenDataGridColumn Property="MatType" Title='@L["Col.Type"]' Width="130px">
                <Template Context="r">
                    <span class="pill">@(_matTypes.FirstOrDefault(m => m.CodeValue == r.MatType) is { } tLf ? MasterDataRepository.LocalName(tLf) : r.MatType ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="LotNo" Title='@L["Col.LotNo"]' Width="120px">
                <Template Context="r"><span class="dim">@(r.LotNo ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="SupplierID" Title='@L["Col.Supplier"]' Width="110px">
                <Template Context="r"><span class="dim">@(r.SupplierID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="UOM" Title='@L["Col.Uom"]' Width="70px">
                <Template Context="r"><span class="dim">@(r.UOM ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="QtyOnHand" Title='@L["Col.OnHand"]' Width="100px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.QtyOnHand?.ToString("N3") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ReceiptDate" Title='@L["Col.ReceivedDate"]' Width="110px">
                <Template Context="r"><span class="dim">@(r.ReceiptDate?.ToString("yyyy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ExpDate" Title='@L["Col.ExpiryDate"]' Width="110px">
                <Template Context="r">
                    @{ var expCss = r.ExpDate.HasValue ? (r.ExpDate.Value < _today ? "bad" : r.ExpDate.Value <= _today.AddDays(30) ? "warn" : "") : ""; }
                    @if (r.ExpDate.HasValue)
                    { <span class="@(!string.IsNullOrEmpty(expCss) ? $"pill {expCss}" : "")">@r.ExpDate.Value.ToString("yyyy-MM-dd")</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="StorageReq" Title='@L["Col.StorageCond"]' Width="120px">
                <Template Context="r"><span class="dim">@(r.StorageReq ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Status" Title='@L["Col.Status"]' Width="100px">
                <Template Context="r">
                    @{ var stCss = r.Status == "ACTIVE" ? "ok" : r.Status == "EXPIRED" ? "bad" : "warn";
                       var stLabel = _matStatuses.FirstOrDefault(s => s.CodeValue == r.Status) is { } stLf ? MasterDataRepository.LocalName(stLf) : r.Status; }
                    <span class="pill @stCss">@(stLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PaintFabric.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="LOT ID *" /><br />
                    <RadzenTextBox @bind-Value="_f.MatLotID" Placeholder="PF-PAINT-20260101-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.MatCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.MatCode" Placeholder="MAT-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.MatName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.MatName" Placeholder='@L["MD.PaintFabric.Ph.MatName"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.MatType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.MatType" Data="MatTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.None"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.PaintFabric.LotNo"]' /><br />
                    <RadzenTextBox @bind-Value="_f.LotNo" Placeholder="LOT-2026-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Supplier"]' /><br />
                    <RadzenDropDown @bind-Value="_f.SupplierID" Data="VendorOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Uom"]' /><br />
                    <RadzenDropDown @bind-Value="_f.UOM" Data="UomOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.StockQty"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.QtyOnHand" Step="0.001m" Min="0m" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InboundDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ReceiptDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ExpiryDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ExpDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.StorageCond"]' /><br />
                    <RadzenTextBox @bind-Value="_f.StorageReq" Placeholder='@L["MD.PaintFabric.Ph.StorageReq"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="MatStatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <div class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PaintFabric.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.MatLotID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.MatCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.MatCode" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.MatType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.MatType" Data="MatTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.None"]' Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.MatName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.MatName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.PaintFabric.LotNo"]' /><br />
                    <RadzenTextBox @bind-Value="_f.LotNo" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Supplier"]' /><br />
                    <RadzenDropDown @bind-Value="_f.SupplierID" Data="VendorOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Uom"]' /><br />
                    <RadzenDropDown @bind-Value="_f.UOM" Data="UomOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.StockQty"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.QtyOnHand" Step="0.001m" Min="0m" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InboundDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ReceiptDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ExpiryDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ExpDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.StorageCond"]' /><br />
                    <RadzenTextBox @bind-Value="_f.StorageReq" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="MatStatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Light" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" />
                </div>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <div class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" ButtonStyle="ButtonStyle.Danger" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.PaintFabricRow> _allRows = new();
    List<MasterDataRepository.PaintFabricRow> _rows    = new();
    MasterDataRepository.PaintFabricRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };
    DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    List<MasterDataRepository.CodeItemRow> _matTypes    = new();
    List<MasterDataRepository.CodeItemRow> _matStatuses = new();
    List<MasterDataRepository.VendorRow>   _vendors     = new();
    List<MasterDataRepository.UomRow>      _uomList     = new();
    string? _fType, _fStatus;
    string  _fSearch = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    IEnumerable<DropDownItem> MatTypeFilterOptions =>
        _matTypes.Where(t => t.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    IEnumerable<DropDownItem> MatStatusFilterOptions =>
        _matStatuses.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });
    IEnumerable<DropDownItem> MatTypeOptions =>
        _matTypes.Where(t => t.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    IEnumerable<DropDownItem> MatStatusOptions =>
        _matStatuses.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });
    IEnumerable<DropDownItem> VendorOptions =>
        _vendors.Select(v => new DropDownItem { Value = v.VendorID, Text = $"[{v.VendorID}] {v.VendorName ?? v.VendorID}" });
    IEnumerable<DropDownItem> UomOptions =>
        _uomList.Select(u => new DropDownItem { Value = u.UOMCode, Text = $"[{u.UOMCode}] {u.UOMName ?? u.UOMCode}" });

    void PfRowRender(RowRenderEventArgs<MasterDataRepository.PaintFabricRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rm/paint-fabric");
        try { _matTypes    = Md.ListCodeItems("MATERIAL_TYPE");   } catch { }
        try { _matStatuses = Md.ListCodeItems("MATERIAL_STATUS"); } catch { }
        try { _vendors     = Md.ListVendors().Where(v => v.ActiveFlag).ToList(); } catch { }
        try { _uomList     = Md.ListUoms().Where(u => u.ActiveFlag).OrderBy(u => u.UOMCode).ToList(); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListPaintFabrics(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.MatLotID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MatCode ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MatName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType   == null || r.MatType == _fType) &&
        (_fStatus == null || r.Status  == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.PaintFabricRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            MatLotID    = r.MatLotID,
            MatCode     = r.MatCode     ?? "",
            MatName     = r.MatName     ?? "",
            MatType     = r.MatType,
            LotNo       = r.LotNo       ?? "",
            SupplierID  = r.SupplierID,
            UOM         = r.UOM,
            QtyOnHand   = r.QtyOnHand,
            ReceiptDate = r.ReceiptDate,
            ExpDate     = r.ExpDate,
            StorageReq  = r.StorageReq  ?? "",
            Status      = r.Status      ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MatLotID)) { _modalErr = L["Err.LotIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.MatName))  { _modalErr = L["Err.MatNameRequired"]; return; }
        if (Md.PaintFabricExists(_f.MatLotID.Trim())) { _modalErr = $"LOT ID '{_f.MatLotID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertPaintFabric(_f.MatLotID.Trim(), NE(_f.MatCode), _f.MatName,
                _f.MatType, NE(_f.LotNo), _f.SupplierID, _f.UOM,
                _f.QtyOnHand, _f.ReceiptDate, _f.ExpDate,
                NE(_f.StorageReq), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.MatName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MatName)) { _modalErr = L["Err.MatNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdatePaintFabric(_sel.MatLotID, NE(_f.MatCode), _f.MatName,
                _f.MatType, NE(_f.LotNo), _f.SupplierID, _f.UOM,
                _f.QtyOnHand, _f.ReceiptDate, _f.ExpDate,
                NE(_f.StorageReq), NE(_f.Status), _actor);
            var name = _f.MatName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.MatName ?? _sel.MatLotID;
            Md.DeletePaintFabric(_sel.MatLotID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string    MatLotID    { get; set; } = "";
        public string    MatCode     { get; set; } = "";
        public string    MatName     { get; set; } = "";
        public string?   MatType     { get; set; }
        public string    LotNo       { get; set; } = "";
        public string?   SupplierID  { get; set; }
        public string?   UOM         { get; set; }
        public decimal?  QtyOnHand   { get; set; }
        public DateOnly? ReceiptDate { get; set; }
        public DateOnly? ExpDate     { get; set; }
        public string    StorageReq  { get; set; } = "";
        public string    Status      { get; set; } = "Active";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}