@page "/md/rm/paint-fabric"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.PaintFabric.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-008" TitleKey="MD.PaintFabric.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.PaintFabric.Kpi.ExpiringSoon"]</div>
        @{ var today = DateOnly.FromDateTime(DateTime.Today); }
        <div class="ames-kpi-v">@_allRows.Count(r => r.ExpDate.HasValue && r.ExpDate.Value >= today && r.ExpDate.Value <= today.AddDays(30))</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.PaintFabric.Kpi.MatTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.MatType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.PaintFabric.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:180px;padding:4px 8px;"
                   placeholder='@L["MD.PaintFabric.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:120px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _matTypes.Where(t => t.UseFlag))
                {
                    <option value="@t.CodeValue">[@t.CodeValue] @(MasterDataRepository.LocalName(t))</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:100px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _matStatuses.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.PaintFabric.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.LotId"]</th><th>@L["Col.MaterialCode"]</th><th>@L["Col.Name"]</th><th>@L["Col.Type"]</th><th>@L["Col.LotNo"]</th>
                    <th>@L["Col.Supplier"]</th><th>@L["Col.Uom"]</th>
                    <th style="text-align:right;">@L["Col.OnHand"]</th>
                    <th>@L["Col.ReceivedDate"]</th><th>@L["Col.ExpiryDate"]</th>
                    <th>@L["Col.StorageCond"]</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    var expCss = r.ExpDate.HasValue
                        ? (r.ExpDate.Value < today ? "bad"
                           : r.ExpDate.Value <= today.AddDays(30) ? "warn" : "")
                        : "";

                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.MatLotID</td>
                        <td class="code dim">@(r.MatCode ?? "—")</td>
                        <td>@(r.MatName ?? "—")</td>
                        <td><span class="pill">@(_matTypes.FirstOrDefault(m => m.CodeValue == r.MatType) is { } _tLf ? MasterDataRepository.LocalName(_tLf) : r.MatType ?? "—")</span></td>
                        <td class="dim">@(r.LotNo ?? "—")</td>
                        <td class="dim">@(r.SupplierID ?? "—")</td>
                        <td class="dim">@(r.UOM ?? "—")</td>
                        <td style="text-align:right;">@(r.QtyOnHand?.ToString("N3") ?? "—")</td>
                        <td class="dim">@(r.ReceiptDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>
                            @if (r.ExpDate.HasValue)
                            {
                                <span class="@(!string.IsNullOrEmpty(expCss) ? $"pill {expCss}" : "")">@r.ExpDate.Value.ToString("yyyy-MM-dd")</span>
                            }
                            else { <span class="dim">—</span> }
                        </td>
                        <td class="dim">@(r.StorageReq ?? "—")</td>
                        <td>
                            @{
                                var stCss   = r.Status == "ACTIVE" ? "ok" : r.Status == "EXPIRED" ? "bad" : "warn";
                                var stLabel = _matStatuses.FirstOrDefault(s => s.CodeValue == r.Status) is { } _stLf ? MasterDataRepository.LocalName(_stLf) : r.Status;
                            }
                            <span class="pill @stCss">@(stLabel ?? "—")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PaintFabric.Title"] — @L["Btn.Create"]</div>

            <label>LOT ID * <span style="font-weight:400;color:#64748b;font-size:.85em;">(e.g. PF-PAINT-20260101-001)</span></label>
            <input class="ames-input" @bind="_f.MatLotID" placeholder="PF-PAINT-20260101-001" autocomplete="off" />

            <label>@L["Col.MatCode"]</label>
            <input class="ames-input" @bind="_f.MatCode" placeholder="MAT-001" maxlength="20" autocomplete="off" />

            <label>@L["Col.MatName"] *</label>
            <input class="ames-input" @bind="_f.MatName" placeholder='@L["MD.PaintFabric.Ph.MatName"]' autocomplete="off" />

            <label>@L["Col.MatType"]</label>
            <select class="ames-input" @bind="_f.MatType">
                <option value="">@L["Opt.None"]</option>
                @foreach (var t in _matTypes.Where(t => t.UseFlag))
                {
                    <option value="@t.CodeValue">[@t.CodeValue] @(MasterDataRepository.LocalName(t))</option>
                }
            </select>

            <label>@L["MD.PaintFabric.LotNo"]</label>
            <input class="ames-input" @bind="_f.LotNo" placeholder="LOT-2026-001" maxlength="24" autocomplete="off" />

            <label>@L["Col.Supplier"]</label>
            <select class="ames-input" @bind="_f.SupplierID">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var v in _vendors)
                {
                    <option value="@v.VendorID">[@v.VendorID] @(v.VendorName ?? v.VendorID)</option>
                }
            </select>

            <label>@L["Col.Uom"]</label>
            <select class="ames-input" @bind="_f.UOM">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var u in _uomList)
                {
                    <option value="@u.UOMCode">[@u.UOMCode] @(u.UOMName ?? u.UOMCode)</option>
                }
            </select>

            <label>@L["Col.StockQty"]</label>
            <input class="ames-input" type="number" step="0.001" @bind="_f.QtyOnHand" placeholder="0.000" min="0" autocomplete="off" />

            <label>@L["Col.InboundDate"]</label>
            <input class="ames-input" type="date" @bind="_f.ReceiptDate" autocomplete="off" />

            <label>@L["Col.ExpiryDate"]</label>
            <input class="ames-input" type="date" @bind="_f.ExpDate" autocomplete="off" />

            <label>@L["Col.StorageCond"]</label>
            <input class="ames-input" @bind="_f.StorageReq" placeholder='@L["MD.PaintFabric.Ph.StorageReq"]' maxlength="40" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _matStatuses.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PaintFabric.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.MatLotID</span></div>

            <label>@L["Col.MatCode"]</label>
            <input class="ames-input" @bind="_f.MatCode" maxlength="20" autocomplete="off" />

            <label>@L["Col.MatName"] *</label>
            <input class="ames-input" @bind="_f.MatName" autocomplete="off" />

            <label>@L["Col.MatType"]</label>
            <select class="ames-input" @bind="_f.MatType">
                <option value="">@L["Opt.None"]</option>
                @foreach (var t in _matTypes.Where(t => t.UseFlag))
                {
                    <option value="@t.CodeValue">[@t.CodeValue] @(MasterDataRepository.LocalName(t))</option>
                }
            </select>

            <label>@L["MD.PaintFabric.LotNo"]</label>
            <input class="ames-input" @bind="_f.LotNo" maxlength="24" autocomplete="off" />

            <label>@L["Col.Supplier"]</label>
            <select class="ames-input" @bind="_f.SupplierID">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var v in _vendors)
                {
                    <option value="@v.VendorID">[@v.VendorID] @(v.VendorName ?? v.VendorID)</option>
                }
            </select>

            <label>@L["Col.Uom"]</label>
            <select class="ames-input" @bind="_f.UOM">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var u in _uomList)
                {
                    <option value="@u.UOMCode">[@u.UOMCode] @(u.UOMName ?? u.UOMCode)</option>
                }
            </select>

            <label>@L["Col.StockQty"]</label>
            <input class="ames-input" type="number" step="0.001" @bind="_f.QtyOnHand" min="0" autocomplete="off" />

            <label>@L["Col.InboundDate"]</label>
            <input class="ames-input" type="date" @bind="_f.ReceiptDate" autocomplete="off" />

            <label>@L["Col.ExpiryDate"]</label>
            <input class="ames-input" type="date" @bind="_f.ExpDate" autocomplete="off" />

            <label>@L["Col.StorageCond"]</label>
            <input class="ames-input" @bind="_f.StorageReq" maxlength="40" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _matStatuses.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Edit"])</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.PaintFabricRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.PaintFabricRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.PaintFabricRow? _sel;

    int _page = 0;
    const int _pageSize = 20;

    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _matTypes    = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _matStatuses = new();
    List<AMES.Data.Repositories.MasterDataRepository.VendorRow>   _vendors     = new();
    List<AMES.Data.Repositories.MasterDataRepository.UomRow>      _uomList     = new();
    string _fSearch = "", _fType = "", _fStatus = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rm/paint-fabric");
        try { _matTypes    = Md.ListCodeItems("MATERIAL_TYPE");                              } catch { }
        try { _matStatuses = Md.ListCodeItems("MATERIAL_STATUS");                            } catch { }
        try { _vendors     = Md.ListVendors().Where(v => v.ActiveFlag).ToList();             } catch { }
        try { _uomList     = Md.ListUoms().Where(u => u.ActiveFlag).OrderBy(u => u.UOMCode).ToList(); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListPaintFabrics(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.MatLotID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MatCode ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MatName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fType)   || r.MatType == _fType) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status  == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.PaintFabricRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            MatLotID    = r.MatLotID,
            MatCode     = r.MatCode     ?? "",
            MatName     = r.MatName     ?? "",
            MatType     = r.MatType     ?? "",
            LotNo       = r.LotNo       ?? "",
            SupplierID  = r.SupplierID  ?? "",
            UOM         = r.UOM         ?? "",
            QtyOnHand   = r.QtyOnHand,
            ReceiptDate = r.ReceiptDate,
            ExpDate     = r.ExpDate,
            StorageReq  = r.StorageReq  ?? "",
            Status      = r.Status      ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MatLotID)) { _modalErr = L["Err.LotIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.MatName))  { _modalErr = L["Err.MatNameRequired"]; return; }
        if (Md.PaintFabricExists(_f.MatLotID.Trim())) { _modalErr = $"LOT ID '{_f.MatLotID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertPaintFabric(_f.MatLotID.Trim(), NE(_f.MatCode), _f.MatName,
                NE(_f.MatType), NE(_f.LotNo), NE(_f.SupplierID), NE(_f.UOM),
                _f.QtyOnHand, _f.ReceiptDate, _f.ExpDate,
                NE(_f.StorageReq), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.MatName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MatName)) { _modalErr = L["Err.MatNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdatePaintFabric(_sel.MatLotID, NE(_f.MatCode), _f.MatName,
                NE(_f.MatType), NE(_f.LotNo), NE(_f.SupplierID), NE(_f.UOM),
                _f.QtyOnHand, _f.ReceiptDate, _f.ExpDate,
                NE(_f.StorageReq), NE(_f.Status), _actor);
            var name = _f.MatName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.MatName ?? _sel.MatLotID;
            Md.DeletePaintFabric(_sel.MatLotID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string    MatLotID    { get; set; } = "";
        public string    MatCode     { get; set; } = "";
        public string    MatName     { get; set; } = "";
        public string    MatType     { get; set; } = "";
        public string    LotNo       { get; set; } = "";
        public string    SupplierID  { get; set; } = "";
        public string    UOM         { get; set; } = "";
        public decimal?  QtyOnHand   { get; set; }
        public DateOnly? ReceiptDate { get; set; }
        public DateOnly? ExpDate     { get; set; }
        public string    StorageReq  { get; set; } = "";
        public string    Status      { get; set; } = "Active";
    }
}
