@page "/md/rm/paint-fabric"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-008 @L["MD.PaintFabric.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-008" TitleKey="MD.PaintFabric.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.PaintFabric.Kpi.ExpiringSoon"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ExpDate.HasValue && r.ExpDate.Value >= _today && r.ExpDate.Value <= _today.AddDays(30))</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.PaintFabric.Kpi.MatTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.MatType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.PaintFabric.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.PaintFabric.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:180px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fType" Data="@MatTypeFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:160px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@MatStatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.PaintFabricRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.PaintFabric.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="MatLotID" Title='@L["Col.LotId"]' Width="155px">
                <Template Context="r"><span class="code">@r.MatLotID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="MatCode" Title='@L["Col.MaterialCode"]' Width="120px">
                <Template Context="r"><span class="code dim">@(r.MatCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="MatName" Title='@L["Col.Name"]' />
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="MatType" Title='@L["Col.Type"]' Width="130px">
                <Template Context="r"><span class="pill">@(_matTypes.FirstOrDefault(m => m.CodeValue == r.MatType) is { } tLf ? MasterDataRepository.LocalName(tLf) : r.MatType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="LotNo" Title='@L["Col.LotNo"]' Width="120px">
                <Template Context="r"><span class="dim">@(r.LotNo ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="SupplierID" Title='@L["Col.Supplier"]' Width="110px">
                <Template Context="r"><span class="dim">@(r.SupplierID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="UOM" Title='@L["Col.Uom"]' Width="70px">
                <Template Context="r"><span class="dim">@(r.UOM ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="QtyOnHand" Title='@L["Col.OnHand"]' Width="100px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.QtyOnHand?.ToString("N3") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="ReceiptDate" Title='@L["Col.ReceivedDate"]' Width="110px">
                <Template Context="r"><span class="dim">@(r.ReceiptDate?.ToString("yyyy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="ExpDate" Title='@L["Col.ExpiryDate"]' Width="110px">
                <Template Context="r">
                    @{ var expCss = r.ExpDate.HasValue ? (r.ExpDate.Value < _today ? "bad" : r.ExpDate.Value <= _today.AddDays(30) ? "warn" : "") : ""; }
                    @if (r.ExpDate.HasValue)
                    { <span class="@(!string.IsNullOrEmpty(expCss) ? $"pill {expCss}" : "")">@r.ExpDate.Value.ToString("yyyy-MM-dd")</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="StorageReq" Title='@L["Col.StorageCond"]' Width="120px">
                <Template Context="r"><span class="dim">@(r.StorageReq ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PaintFabricRow" Property="Status" Title='@L["Col.Status"]' Width="100px">
                <Template Context="r">
                    @{ var stCss = r.Status == "ACTIVE" ? "ok" : r.Status == "EXPIRED" ? "bad" : "warn";
                       var stLabel = _matStatuses.FirstOrDefault(s => s.CodeValue == r.Status) is { } stLf ? MasterDataRepository.LocalName(stLf) : r.Status; }
                    <span class="pill @stCss">@(stLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PaintFabric.Title"] — @L["Modal.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="LOT ID *" /><br />
                    <RadzenTextBox @bind-Value="_f.MatLotID" Placeholder="PF-PAINT-20260101-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.MatCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.MatCode" Placeholder="MAT-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.MatName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.MatName" Placeholder='@L["MD.PaintFabric.Ph.MatName"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.MatType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.MatType" Data="MatTypeOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["Opt.None"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.PaintFabric.LotNo"]' /><br />
                    <RadzenTextBox @bind-Value="_f.LotNo" Placeholder="LOT-2026-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Supplier"]' /><br />
                    <RadzenDropDown @bind-Value="_f.SupplierID" Data="VendorOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Uom"]' /><br />
                    <RadzenDropDown @bind-Value="_f.UOM" Data="UomOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.StockQty"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.QtyOnHand" Step="0.001m" Min="0m" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InboundDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ReceiptDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ExpiryDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ExpDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.StorageCond"]' /><br />
                    <RadzenTextBox @bind-Value="_f.StorageReq" Placeholder='@L["MD.PaintFabric.Ph.StorageReq"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="MatStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PaintFabric.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.MatLotID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.MatCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.MatCode" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.MatType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.MatType" Data="MatTypeOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["Opt.None"]' Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.MatName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.MatName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.PaintFabric.LotNo"]' /><br />
                    <RadzenTextBox @bind-Value="_f.LotNo" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Supplier"]' /><br />
                    <RadzenDropDown @bind-Value="_f.SupplierID" Data="VendorOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Uom"]' /><br />
                    <RadzenDropDown @bind-Value="_f.UOM" Data="UomOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.StockQty"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.QtyOnHand" Step="0.001m" Min="0m" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InboundDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ReceiptDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ExpiryDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.ExpDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.StorageCond"]' /><br />
                    <RadzenTextBox @bind-Value="_f.StorageReq" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="MatStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.PaintFabricRow> _allRows = new();
    List<MasterDataRepository.PaintFabricRow> _rows = new();
    List<MasterDataRepository.CodeItemRow> _matTypes = new();
    List<MasterDataRepository.CodeItemRow> _matStatuses = new();
    List<MasterDataRepository.VendorRow> _vendors = new();
    List<MasterDataRepository.UomRow> _uomList = new();
    MasterDataRepository.PaintFabricRow? _sel;

    DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    string _fSearch = "";
    string? _fType, _fStatus;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> MatTypeFilterOptions => _matTypes.Where(t => t.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    IEnumerable<DropDownItem> MatStatusFilterOptions => _matStatuses.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });
    IEnumerable<DropDownItem> MatTypeOptions => _matTypes.Where(t => t.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    IEnumerable<DropDownItem> MatStatusOptions => _matStatuses.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });
    IEnumerable<DropDownItem> VendorOptions => _vendors.Select(v => new DropDownItem { Value = v.VendorID, Text = $"[{v.VendorID}] {v.VendorName ?? v.VendorID}" });
    IEnumerable<DropDownItem> UomOptions => _uomList.Select(u => new DropDownItem { Value = u.UOMCode, Text = $"[{u.UOMCode}] {u.UOMName ?? u.UOMCode}" });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/rm/paint-fabric");
        try { _matTypes = MD.ListCodeItems("MATERIAL_TYPE"); } catch { }
        try { _matStatuses = MD.ListCodeItems("MATERIAL_STATUS"); } catch { }
        try { _vendors = MD.ListVendors().Where(v => v.ActiveFlag).ToList(); } catch { }
        try { _uomList = MD.ListUoms().Where(u => u.ActiveFlag).OrderBy(u => u.UOMCode).ToList(); } catch { }
        Reload();
    }

    void Reload() { _allRows = MD.ListPaintFabrics(); ApplyFilter(); }

    void ApplyFilter()
    {
        _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.MatLotID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MatCode ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MatName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType == null || r.MatType == _fType) &&
        (_fStatus == null || r.Status == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.PaintFabricRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.PaintFabricRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.PaintFabricRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            MatLotID    = r.MatLotID,
            MatCode     = r.MatCode     ?? "",
            MatName     = r.MatName     ?? "",
            MatType     = r.MatType,
            LotNo       = r.LotNo       ?? "",
            SupplierID  = r.SupplierID,
            UOM         = r.UOM,
            QtyOnHand   = r.QtyOnHand,
            ReceiptDate = r.ReceiptDate,
            ExpDate     = r.ExpDate,
            StorageReq  = r.StorageReq  ?? "",
            Status      = r.Status      ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MatLotID)) { _modalErr = L["Err.LotIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.MatName))  { _modalErr = L["Err.MatNameRequired"]; return; }
        if (MD.PaintFabricExists(_f.MatLotID.Trim())) { _modalErr = $"LOT ID '{_f.MatLotID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            MD.InsertPaintFabric(_f.MatLotID.Trim(), NE(_f.MatCode), _f.MatName,
                _f.MatType, NE(_f.LotNo), _f.SupplierID, _f.UOM,
                _f.QtyOnHand, _f.ReceiptDate, _f.ExpDate,
                NE(_f.StorageReq), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.MatName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MatName)) { _modalErr = L["Err.MatNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdatePaintFabric(_sel.MatLotID, NE(_f.MatCode), _f.MatName,
                _f.MatType, NE(_f.LotNo), _f.SupplierID, _f.UOM,
                _f.QtyOnHand, _f.ReceiptDate, _f.ExpDate,
                NE(_f.StorageReq), NE(_f.Status), _actor);
            var name = _f.MatName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.MatName ?? _sel.MatLotID;
            MD.DeletePaintFabric(_sel.MatLotID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string    MatLotID    { get; set; } = "";
        public string    MatCode     { get; set; } = "";
        public string    MatName     { get; set; } = "";
        public string?   MatType     { get; set; }
        public string    LotNo       { get; set; } = "";
        public string?   SupplierID  { get; set; }
        public string?   UOM         { get; set; }
