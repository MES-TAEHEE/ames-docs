@page "/md/recipe"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Recipe.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-029" TitleKey="MD.Recipe.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Recipe.Kpi.RecipeTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.RecipeType).Where(t => t != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Recipe.Kpi.AvgCycleTime"]</div>
        <div class="ames-kpi-v">@((_allRows.Where(r => r.CycleTime.HasValue).Select(r => r.CycleTime!.Value) is var cts && cts.Any()) ? $"{cts.Average():0}" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Recipe.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:150px;padding:4px 8px;"
                   placeholder='@L["MD.Recipe.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:110px;padding:4px 8px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _allRows.Select(r => r.RecipeType).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@t">@t</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:90px;padding:4px 8px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _allRows.Select(r => r.Status).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@s">@s</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Recipe.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.RecipeId"]</th><th>@L["Col.RecipeName"]</th><th>@L["Col.Type"]</th>
                    <th>@L["Col.ItemNo"]</th><th class="num">@L["Col.CycleTime"]</th>
                    <th>@L["Col.Version"]</th><th>@L["Col.EffectiveDate"]</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.RecipeID</td>
                        <td>@(r.RecipeName ?? "—")</td>
                        <td>@(r.RecipeType ?? "—")</td>
                        <td class="dim">@(r.ItemNo ?? "—")</td>
                        <td class="num">@(r.CycleTime?.ToString() ?? "—")</td>
                        <td class="dim">@(r.Version ?? "—")</td>
                        <td class="dim">@(r.EffectiveDate?.ToString("yy-MM-dd") ?? "—")</td>
                        <td><span class="pill @(r.Status == "ACTIVE" ? "ok" : r.Status == "OBSOLETE" ? "bad" : "warn")">@(r.Status ?? "—")</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Recipe.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.RecipeId"]</label>
            <input class="ames-input" @bind="_f.RecipeID" placeholder="RCP-001" autocomplete="off" />

            <label>@L["Col.RecipeName"]</label>
            <input class="ames-input" @bind="_f.RecipeName" placeholder='@L["MD.Recipe.Ph.RecipeName"]' autocomplete="off" />

            <label>@L["Col.Type"]</label>
            <input class="ames-input" @bind="_f.RecipeType" placeholder="INJECTION / PAINTING / BONDING" autocomplete="off" />

            <label>@L["Col.ItemNo"]</label>
            <input class="ames-input" @bind="_f.ItemNo" placeholder="ITEM-001" autocomplete="off" />

            <label>@L["Col.CycleTime"] (초)</label>
            <input class="ames-input" type="number" @bind="_f.CycleTime" placeholder="30" min="0" autocomplete="off" />

            <label>@L["Col.Version"]</label>
            <input class="ames-input" @bind="_f.Version" placeholder="v1.0" autocomplete="off" />

            <label>@L["Col.EffectiveDate"]</label>
            <input class="ames-input" type="text" @bind="_f.EffectiveDate" placeholder="yyyy-MM-dd" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="DRAFT">DRAFT</option>
                <option value="ACTIVE">ACTIVE</option>
                <option value="OBSOLETE">OBSOLETE</option>
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Recipe.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.RecipeID</span></div>

            <label>@L["Col.RecipeName"]</label>
            <input class="ames-input" @bind="_f.RecipeName" autocomplete="off" />

            <label>@L["Col.Type"]</label>
            <input class="ames-input" @bind="_f.RecipeType" autocomplete="off" />

            <label>@L["Col.ItemNo"]</label>
            <input class="ames-input" @bind="_f.ItemNo" autocomplete="off" />

            <label>@L["Col.CycleTime"] (초)</label>
            <input class="ames-input" type="number" @bind="_f.CycleTime" min="0" autocomplete="off" />

            <label>@L["Col.Version"]</label>
            <input class="ames-input" @bind="_f.Version" autocomplete="off" />

            <label>@L["Col.EffectiveDate"]</label>
            <input class="ames-input" type="text" @bind="_f.EffectiveDate" placeholder="yyyy-MM-dd" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="DRAFT">DRAFT</option>
                <option value="ACTIVE">ACTIVE</option>
                <option value="OBSOLETE">OBSOLETE</option>
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveEdit" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    int _page = 0;
    const int _pageSize = 20;
    List<AMES.Data.Repositories.MasterDataRepository.RecipeRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.RecipeRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.RecipeRow? _sel;

    string _fSearch = "", _fType = "", _fStatus = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        Reload();
    }

    void Reload()
    {
        try { _allRows = Md.ListRecipes(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _page = 0;
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.RecipeID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.RecipeName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fType))
            _rows = _rows.Where(r => r.RecipeType == _fType).ToList();
        if (!string.IsNullOrWhiteSpace(_fStatus))
            _rows = _rows.Where(r => r.Status == _fStatus).ToList();
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.RecipeRow r)
    {
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            RecipeName    = r.RecipeName    ?? "",
            RecipeType    = r.RecipeType    ?? "",
            ItemNo        = r.ItemNo        ?? "",
            CycleTime     = r.CycleTime,
            Version       = r.Version       ?? "",
            EffectiveDate = r.EffectiveDate?.ToString("yyyy-MM-dd") ?? "",
            Status        = r.Status        ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.RecipeID)) { _modalErr = L["Err.RecipeIdRequired"]; return; }
        var id = _f.RecipeID.Trim();
        if (Md.RecipeExists(id)) { _modalErr = $"'{id}' ID가 {L["Err.AlreadyExists"]}"; return; }
        DateOnly? effDate = DateOnly.TryParse(_f.EffectiveDate, out var d1) ? d1 : null;
        _busy = true;
        try
        {
            Md.InsertRecipe(id, NE(_f.RecipeName), NE(_f.RecipeType),
                NE(_f.ItemNo), _f.CycleTime, NE(_f.Version),
                effDate, NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        DateOnly? effDate = DateOnly.TryParse(_f.EffectiveDate, out var d1) ? d1 : null;
        _busy = true;
        try
        {
            Md.UpdateRecipe(_sel.RecipeID, NE(_f.RecipeName), NE(_f.RecipeType),
                NE(_f.ItemNo), _f.CycleTime, NE(_f.Version),
                effDate, NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.RecipeID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.RecipeID;
            Md.DeleteRecipe(_sel.RecipeID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string  RecipeID      { get; set; } = "";
        public string  RecipeName    { get; set; } = "";
        public string  RecipeType    { get; set; } = "";
        public string  ItemNo        { get; set; } = "";
        public int?    CycleTime     { get; set; }
        public string  Version       { get; set; } = "";
        public string  EffectiveDate { get; set; } = "";
        public string  Status        { get; set; } = "DRAFT";
    }
}
