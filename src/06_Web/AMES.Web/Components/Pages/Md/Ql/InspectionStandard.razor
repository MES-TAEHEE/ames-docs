@page "/md/ql/inspection-standard"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-017 @L["MD.InspStd.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-017" TitleKey="MD.InspStd.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.InspStd.Kpi.Ctq"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.IsCTQ)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.ProcessCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.InspStd.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.InspStd.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:170px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fType" Data="@TypeFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Process"]" Component="DropDownProcess" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownProcess" @bind-Value="_fProcess" Data="@ProcessFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@_statusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.InspectionStandardRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.InspStd.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="InspStdID" Title="@L["Col.StandardId"]" Width="130px">
                <Template Context="r"><span class="code">@r.InspStdID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="ItemID" Title="@L["Col.ItemNo"]" Width="160px">
                <Template Context="r">
                    @{ var it = r.ItemID != null ? _items.FirstOrDefault(x => x.ItemNo == r.ItemID) : null; }
                    @if (r.ItemID != null)
                    {
                        <span class="code">@r.ItemID</span>
                        @if (it != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@it.ItemName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="ProcessCode" Title="@L["Col.ProcessName"]" Width="130px">
                <Template Context="r">
                    @if (r.ProcessCode != null)
                    {
                        var procName = _processItems.FirstOrDefault(c2 => c2.CodeValue == r.ProcessCode) is { } pf ? MasterDataRepository.LocalName(pf) : null;
                        <span class="pill @Ui.ProcessClass(r.ProcessCode)">@r.ProcessCode</span>
                        @if (procName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@procName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="InspType" Title="@L["Col.InspType"]" Width="100px">
                <Template Context="r">
                    @if (r.InspType != null) { <span class="pill">@r.InspType</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="CharName" Title="@L["Col.CharName"]" Width="150px" />
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="SpecNominal" Title="@L["Col.Nominal"]" Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r"><span>@(r.SpecNominal?.ToString("G6") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="SpecLSL" Title="@L["Col.LSL"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r"><span class="dim">@(r.SpecLSL?.ToString("G6") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="SpecUSL" Title="@L["Col.USL"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r"><span class="dim">@(r.SpecUSL?.ToString("G6") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="UOM" Title="@L["Col.Uom"]" Width="110px">
                <Template Context="r">
                    @{ var u = r.UOM != null ? _uomList.FirstOrDefault(x => x.UOMCode == r.UOM) : null; }
                    @if (r.UOM != null)
                    {
                        <span class="code">@r.UOM</span>
                        @if (u?.UOMName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@u.UOMName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="SamplingPlan" Title="@L["Col.SamplingPlan"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.SamplingPlan ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="InspMethod" Title="@L["Col.InspMethod"]" Width="110px">
                <Template Context="r"><span class="dim">@(r.InspMethod ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="IsCTQ" Title="@L["Col.CTQ"]" Width="65px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.IsCTQ) { <span class="pill warn">CTQ</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="EffectiveDate" Title="@L["Col.EffectiveDate"]" Width="110px">
                <Template Context="r"><span class="dim">@(r.EffectiveDate?.ToString(DateFmt.Date) ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InspectionStandardRow" Property="Status" Title="@L["Col.Status"]" Width="90px">
                <Template Context="r"><span class="pill @(r.Status == "Active" ? "ok" : "bad")">@(r.Status ?? "—")</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.InspStd.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["Col.InspStdId"]} *")' class="ames-rz-modal-label" Component="CreateTextBoxInspStdID" />
                <RadzenTextBox Name="CreateTextBoxInspStdID" @bind-Value="_f.InspStdID" Placeholder="IS-INJ-001" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@($"{L["Col.CharName"]} *")' class="ames-rz-modal-label" Component="CreateTextBoxCharName" />
                <RadzenTextBox Name="CreateTextBoxCharName" @bind-Value="_f.CharName" Placeholder='@L["MD.InspStd.Ph.CharName"]' InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.ItemId"]' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ItemID" Data="ItemOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Process"]' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ProcessCode" Data="ProcessOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.InspType"]' />
                    <RadzenTextBox @bind-Value="_f.InspType" Placeholder="INCOMING" MaxLength="10" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Uom"]' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.UOM" Data="UomOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text='@L["Col.Nominal"]' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecNominal" Step="0.0001" Placeholder="0.0000" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text='@L["Col.LSL"]' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecLSL" Step="0.0001" Placeholder="0.0000" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text='@L["Col.USL"]' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecUSL" Step="0.0001" Placeholder="0.0000" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.SamplingPlan"]' />
                    <RadzenTextBox @bind-Value="_f.SamplingPlan" Placeholder="AQL-1.0" MaxLength="20" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.EffectiveDate"]' />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.EffectiveDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@L["Col.InspMethod"]' />
                    <RadzenTextBox @bind-Value="_f.InspMethod" Placeholder='@L["MD.InspStd.Ph.InspMethod"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Status"]' />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@L["Opt.Select"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.IsCTQ" Name="CreateChkCtq" />
                <RadzenLabel Text='@L["MD.InspStd.CtqLabel"]' Component="CreateChkCtq" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.InspStd.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.InspStdID</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["Col.CharName"]} *")' class="ames-rz-modal-label" Component="EditTextBoxCharName" />
                <RadzenTextBox Name="EditTextBoxCharName" @bind-Value="_f.CharName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.ItemId"]' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ItemID" Data="ItemOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Process"]' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ProcessCode" Data="ProcessOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.InspType"]' />
                    <RadzenTextBox @bind-Value="_f.InspType" MaxLength="10" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Uom"]' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.UOM" Data="UomOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text='@L["Col.Nominal"]' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecNominal" Step="0.0001" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text='@L["Col.LSL"]' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecLSL" Step="0.0001" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text='@L["Col.USL"]' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecUSL" Step="0.0001" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.SamplingPlan"]' />
                    <RadzenTextBox @bind-Value="_f.SamplingPlan" MaxLength="20" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.EffectiveDate"]' />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.EffectiveDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@L["Col.InspMethod"]' />
                    <RadzenTextBox @bind-Value="_f.InspMethod" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Status"]' />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder='@L["Opt.Select"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.IsCTQ" Name="EditChkCtq" />
                <RadzenLabel Text='@L["MD.InspStd.CtqLabel"]' Component="EditChkCtq" style="cursor:pointer;" />
            </RadzenStack>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.InspectionStandardRow> _allRows = new();
    List<MasterDataRepository.InspectionStandardRow> _rows    = new();
    MasterDataRepository.InspectionStandardRow? _sel;
    List<MasterDataRepository.CodeItemRow> _processItems = new();
    List<MasterDataRepository.ItemRow>     _items   = new();
    List<MasterDataRepository.UomRow>      _uomList = new();

    string _fSearch = "";
    string? _fType, _fProcess, _fStatus;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> TypeFilterOptions => _allRows.Select(r => r.InspType).Where(x => x != null).Distinct().OrderBy(x => x).Select(t => new DropDownItem { Value = t!, Text = t! });
    IEnumerable<DropDownItem> ProcessFilterOptions => _allRows.Select(r => r.ProcessCode).Where(x => x != null).Distinct().OrderBy(x => x).Select(p => new DropDownItem { Value = p!, Text = p! });
    IEnumerable<DropDownItem> ProcessOptions => _processItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    IEnumerable<DropDownItem> ItemOptions    => _items.Where(i => i.ActiveFlag).Select(i => new DropDownItem { Value = i.ItemNo, Text = $"[{i.ItemNo}] {i.ItemName}" });
    IEnumerable<DropDownItem> UomOptions     => _uomList.Where(u => u.ActiveFlag).Select(u => new DropDownItem { Value = u.UOMCode, Text = $"[{u.UOMCode}] {u.UOMName ?? u.UOMCode}" });
    DropDownItem[] _statusFilterOptions =
    {
        new() { Value = "Active",   Text = "Active"   },
        new() { Value = "Inactive", Text = "Inactive" },
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/ql/inspection-standard");
        try { _processItems = MD.ListCodeItems("PROCESS"); } catch { }
        try { _items   = MD.ListItems(); } catch { }
        try { _uomList = MD.ListUoms(); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.InspectionStandardRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _allRows = MD.ListInspectionStandards(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.InspStdID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CharName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemID   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType    == null || r.InspType    == _fType) &&
        (_fProcess == null || r.ProcessCode == _fProcess) &&
        (_fStatus  == null || r.Status      == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.InspectionStandardRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.InspectionStandardRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.InspectionStandardRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            InspStdID     = r.InspStdID,
            ItemID        = r.ItemID       ?? "",
            ProcessCode   = r.ProcessCode  ?? "",
            InspType      = r.InspType     ?? "",
            CharName      = r.CharName     ?? "",
            SpecNominal   = r.SpecNominal,
            SpecLSL       = r.SpecLSL,
            SpecUSL       = r.SpecUSL,
            UOM           = r.UOM          ?? "",
            SamplingPlan  = r.SamplingPlan ?? "",
            InspMethod    = r.InspMethod   ?? "",
            IsCTQ         = r.IsCTQ,
            EffectiveDate = r.EffectiveDate,
            Status        = r.Status       ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.InspStdID)) { _modalErr = L["Err.InspStdIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.CharName))  { _modalErr = L["Err.CharNameRequired"]; return; }
        if (MD.InspectionStandardExists(_f.InspStdID.Trim())) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], _f.InspStdID.Trim()); return; }
        _busy = true;
        try
        {
            MD.InsertInspectionStandard(_f.InspStdID.Trim(), NE(_f.ItemID), NE(_f.ProcessCode),
                NE(_f.InspType), _f.CharName, _f.SpecNominal, _f.SpecLSL, _f.SpecUSL,
                NE(_f.UOM), NE(_f.SamplingPlan), NE(_f.InspMethod), _f.IsCTQ,
                _f.EffectiveDate, NE(_f.Status), _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{_f.CharName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CharName)) { _modalErr = L["Err.CharNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateInspectionStandard(_sel.InspStdID, NE(_f.ItemID), NE(_f.ProcessCode),
                NE(_f.InspType), _f.CharName, _f.SpecNominal, _f.SpecLSL, _f.SpecUSL,
                NE(_f.UOM), NE(_f.SamplingPlan), NE(_f.InspMethod), _f.IsCTQ,
                _f.EffectiveDate, NE(_f.Status), _actor);
            var name = _f.CharName;
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.CharName ?? _sel.InspStdID;
            MD.DeleteInspectionStandard(_sel.InspStdID);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string   InspStdID     { get; set; } = "";
        public string   ItemID        { get; set; } = "";
        public string   ProcessCode   { get; set; } = "";
        public string   InspType      { get; set; } = "";
        public string   CharName      { get; set; } = "";
        public decimal? SpecNominal   { get; set; }
        public decimal? SpecLSL       { get; set; }
        public decimal? SpecUSL       { get; set; }
        public string   UOM           { get; set; } = "";
        public string   SamplingPlan  { get; set; } = "";
        public string   InspMethod    { get; set; } = "";
        public bool     IsCTQ         { get; set; }
        public DateOnly? EffectiveDate { get; set; }
        public string   Status        { get; set; } = "Active";
    }
}