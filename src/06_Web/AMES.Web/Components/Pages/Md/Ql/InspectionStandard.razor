@page "/md/ql/inspection-standard"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.InspStd.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.InspStd.Kpi.Ctq"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.IsCTQ)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.ProcessCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.InspStd.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.InspStd.Ph.Search"]' Style="width:170px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Type"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fType" Data="TypeFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllInspectionTypes"]' Style="width:130px;" />
            <RadzenLabel Text='@L["Col.Process"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fProcess" Data="ProcessFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllProcesses"]' Style="width:100px;" />
            <RadzenLabel Text='@L["Col.Status"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fStatus" Data="_statusFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllStatus"]' Style="width:110px;" />
            <RadzenButton Text='@L["Btn.Search"]' Icon="refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.InspectionStandardRow"
                    RowRender="IsRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.InspStd.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="InspStdID" Title='@L["Col.StandardId"]' Width="130px">
                <Template Context="r"><span class="code">@r.InspStdID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ItemID" Title='@L["Col.ItemNo"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.ItemID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ProcessCode" Title='@L["Col.ProcessName"]' Width="80px">
                <Template Context="r"><span class="dim">@(r.ProcessCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="InspType" Title='@L["Col.InspType"]' Width="100px">
                <Template Context="r">
                    @if (r.InspType != null) { <span class="pill">@r.InspType</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="CharName" Title='@L["Col.CharName"]' Width="150px" />
            <RadzenDataGridColumn Property="SpecNominal" Title='@L["Col.Nominal"]' Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r"><span>@(r.SpecNominal?.ToString("G6") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="SpecLSL" Title='@L["Col.LSL"]' Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r"><span class="dim">@(r.SpecLSL?.ToString("G6") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="SpecUSL" Title='@L["Col.USL"]' Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r"><span class="dim">@(r.SpecUSL?.ToString("G6") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="UOM" Title='@L["Col.Uom"]' Width="65px">
                <Template Context="r"><span class="dim">@(r.UOM ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="SamplingPlan" Title='@L["Col.SamplingPlan"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.SamplingPlan ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="InspMethod" Title='@L["Col.InspMethod"]' Width="110px">
                <Template Context="r"><span class="dim">@(r.InspMethod ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="IsCTQ" Title='@L["Col.CTQ"]' Width="65px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.IsCTQ) { <span class="pill warn">CTQ</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="EffectiveDate" Title='@L["Col.EffectiveDate"]' Width="110px">
                <Template Context="r"><span class="dim">@(r.EffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Status" Title='@L["Col.Status"]' Width="90px">
                <Template Context="r">
                    <span class="pill @(r.Status == "Active" ? "ok" : "bad")">@(r.Status ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.InspStd.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.InspStdId"]} * (예: IS-INJ-001)")' /><br />
                    <RadzenTextBox @bind-Value="_f.InspStdID" Placeholder="IS-INJ-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ItemId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ItemID" Placeholder="ITEM-001" MaxLength="20" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ProcessCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ProcessCode" Placeholder="INJ, QC" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InspType"]' /><br />
                    <RadzenTextBox @bind-Value="_f.InspType" Placeholder="INCOMING" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.CharName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.CharName" Placeholder='@L["MD.InspStd.Ph.CharName"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Nominal"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecNominal" Step="0.0001m" Placeholder="0.0000" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.LSL"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecLSL" Step="0.0001m" Placeholder="0.0000" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.USL"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecUSL" Step="0.0001m" Placeholder="0.0000" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Uom"]' /><br />
                    <RadzenTextBox @bind-Value="_f.UOM" Placeholder="mm, kg" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.SamplingPlan"]' /><br />
                    <RadzenTextBox @bind-Value="_f.SamplingPlan" Placeholder="AQL-1.0" MaxLength="20" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.InspMethod"]' /><br />
                    <RadzenTextBox @bind-Value="_f.InspMethod" Placeholder='@L["MD.InspStd.Ph.InspMethod"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.EffectiveDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.EffectiveDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div style="display:flex; align-items:center; gap:8px; padding-top:22px;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.IsCTQ" />
                    <RadzenLabel Text='@L["MD.InspStd.CtqLabel"]' Style="cursor:pointer;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusFilterOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.InspStd.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.InspStdID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.ItemId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ItemID" MaxLength="20" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ProcessCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ProcessCode" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InspType"]' /><br />
                    <RadzenTextBox @bind-Value="_f.InspType" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.CharName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.CharName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Nominal"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecNominal" Step="0.0001m" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.LSL"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecLSL" Step="0.0001m" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.USL"]' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.SpecUSL" Step="0.0001m" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Uom"]' /><br />
                    <RadzenTextBox @bind-Value="_f.UOM" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.SamplingPlan"]' /><br />
                    <RadzenTextBox @bind-Value="_f.SamplingPlan" MaxLength="20" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.InspMethod"]' /><br />
                    <RadzenTextBox @bind-Value="_f.InspMethod" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.EffectiveDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.EffectiveDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div style="display:flex; align-items:center; gap:8px; padding-top:22px;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.IsCTQ" />
                    <RadzenLabel Text='@L["MD.InspStd.CtqLabel"]' Style="cursor:pointer;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusFilterOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.InspectionStandardRow> _allRows = new();
    List<MasterDataRepository.InspectionStandardRow> _rows    = new();
    MasterDataRepository.InspectionStandardRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string? _fType, _fProcess, _fStatus;
    string  _fSearch = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    DropDownItem[] _statusFilterOptions =
    {
        new() { Value = "Active",   Text = "Active"   },
        new() { Value = "Inactive", Text = "Inactive" },
    };

    IEnumerable<DropDownItem> TypeFilterOptions =>
        _allRows.Select(r => r.InspType).Where(x => x != null).Distinct().OrderBy(x => x)
                .Select(t => new DropDownItem { Value = t!, Text = t! });

    IEnumerable<DropDownItem> ProcessFilterOptions =>
        _allRows.Select(r => r.ProcessCode).Where(x => x != null).Distinct().OrderBy(x => x)
                .Select(p => new DropDownItem { Value = p!, Text = p! });

    void IsRowRender(RowRenderEventArgs<MasterDataRepository.InspectionStandardRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/ql/inspection-standard");
        Reload();
    }

    void Reload() { _allRows = Md.ListInspectionStandards(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.InspStdID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CharName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemID   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType    == null || r.InspType    == _fType) &&
        (_fProcess == null || r.ProcessCode == _fProcess) &&
        (_fStatus  == null || r.Status      == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.InspectionStandardRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            InspStdID     = r.InspStdID,
            ItemID        = r.ItemID       ?? "",
            ProcessCode   = r.ProcessCode  ?? "",
            InspType      = r.InspType     ?? "",
            CharName      = r.CharName     ?? "",
            SpecNominal   = r.SpecNominal,
            SpecLSL       = r.SpecLSL,
            SpecUSL       = r.SpecUSL,
            UOM           = r.UOM          ?? "",
            SamplingPlan  = r.SamplingPlan ?? "",
            InspMethod    = r.InspMethod   ?? "",
            IsCTQ         = r.IsCTQ,
            EffectiveDate = r.EffectiveDate,
            Status        = r.Status       ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.InspStdID)) { _modalErr = L["Err.InspStdIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.CharName))  { _modalErr = L["Err.CharNameRequired"]; return; }
        if (Md.InspectionStandardExists(_f.InspStdID.Trim())) { _modalErr = $"기준 ID '{_f.InspStdID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertInspectionStandard(_f.InspStdID.Trim(), NE(_f.ItemID), NE(_f.ProcessCode),
                NE(_f.InspType), _f.CharName, _f.SpecNominal, _f.SpecLSL, _f.SpecUSL,
                NE(_f.UOM), NE(_f.SamplingPlan), NE(_f.InspMethod), _f.IsCTQ,
                _f.EffectiveDate, NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.CharName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CharName)) { _modalErr = L["Err.CharNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateInspectionStandard(_sel.InspStdID, NE(_f.ItemID), NE(_f.ProcessCode),
                NE(_f.InspType), _f.CharName, _f.SpecNominal, _f.SpecLSL, _f.SpecUSL,
                NE(_f.UOM), NE(_f.SamplingPlan), NE(_f.InspMethod), _f.IsCTQ,
                _f.EffectiveDate, NE(_f.Status), _actor);
            var name = _f.CharName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.CharName ?? _sel.InspStdID;
            Md.DeleteInspectionStandard(_sel.InspStdID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   InspStdID     { get; set; } = "";
        public string   ItemID        { get; set; } = "";
        public string   ProcessCode   { get; set; } = "";
        public string   InspType      { get; set; } = "";
        public string   CharName      { get; set; } = "";
        public decimal? SpecNominal   { get; set; }
        public decimal? SpecLSL       { get; set; }
        public decimal? SpecUSL       { get; set; }
        public string   UOM           { get; set; } = "";
        public string   SamplingPlan  { get; set; } = "";
        public string   InspMethod    { get; set; } = "";
        public bool     IsCTQ         { get; set; }
        public DateOnly? EffectiveDate { get; set; }
        public string   Status        { get; set; } = "Active";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}