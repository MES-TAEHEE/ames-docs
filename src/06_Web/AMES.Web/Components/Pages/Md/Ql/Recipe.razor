@page "/md/ql/recipe"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Recipe.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Recipe.Kpi.RecipeTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.RecipeType).Where(t => t != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Recipe.Kpi.AvgCycleTime"]</div>
        <div class="ames-kpi-v">@((_allRows.Where(r => r.CycleTime.HasValue).Select(r => r.CycleTime!.Value) is var cts && cts.Any()) ? $"{cts.Average():0}" : "—")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Recipe.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.Recipe.Ph.Search"]' Style="width:150px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Type"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fType" Data="TypeFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllTypes"]' Style="width:130px;" />
            <RadzenLabel Text='@L["Col.Status"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fStatus" Data="_statusFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllStatus"]' Style="width:110px;" />
            <RadzenButton Text='@L["Btn.Search"]' Icon="refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.RecipeRow"
                    RowRender="RcpRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.Recipe.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="RecipeID" Title='@L["Col.RecipeId"]' Width="120px">
                <Template Context="r"><span class="code">@r.RecipeID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="RecipeName" Title='@L["Col.RecipeName"]' Width="160px">
                <Template Context="r">@(r.RecipeName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="RecipeType" Title='@L["Col.Type"]' Width="110px">
                <Template Context="r">@(r.RecipeType ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ItemNo" Title='@L["Col.ItemNo"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.ItemNo ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="CycleTime" Title='@L["Col.CycleTime"]' Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.CycleTime?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Version" Title='@L["Col.Version"]' Width="75px">
                <Template Context="r"><span class="dim">@(r.Version ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="EffectiveDate" Title='@L["Col.EffectiveDate"]' Width="105px">
                <Template Context="r"><span class="dim">@(r.EffectiveDate?.ToString("yy-MM-dd") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Status" Title='@L["Col.Status"]' Width="95px">
                <Template Context="r">
                    @{ var stCss = r.Status == "ACTIVE" ? "ok" : r.Status == "OBSOLETE" ? "bad" : "warn"; }
                    <span class="pill @stCss">@(r.Status ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Recipe.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.RecipeId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.RecipeID" Placeholder="RCP-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.RecipeName"]' /><br />
                    <RadzenTextBox @bind-Value="_f.RecipeName" Placeholder='@L["MD.Recipe.Ph.RecipeName"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Type"]' /><br />
                    <RadzenTextBox @bind-Value="_f.RecipeType" Placeholder="INJECTION / PAINTING" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ItemNo"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ItemNo" Placeholder="ITEM-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.CycleTime"]} (초)")' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CycleTime" Placeholder="30" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Version"]' /><br />
                    <RadzenTextBox @bind-Value="_f.Version" Placeholder="v1.0" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.EffectiveDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.EffectiveDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusModalOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Recipe.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.RecipeID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.RecipeName"]' /><br />
                    <RadzenTextBox @bind-Value="_f.RecipeName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Type"]' /><br />
                    <RadzenTextBox @bind-Value="_f.RecipeType" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ItemNo"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ItemNo" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.CycleTime"]} (초)")' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.CycleTime" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Version"]' /><br />
                    <RadzenTextBox @bind-Value="_f.Version" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.EffectiveDate"]' /><br />
                    <RadzenDatePicker TValue="DateOnly?" @bind-Value="_f.EffectiveDate" DateFormat="yyyy-MM-dd" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusModalOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.RecipeRow> _allRows = new();
    List<MasterDataRepository.RecipeRow> _rows    = new();
    MasterDataRepository.RecipeRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string? _fType, _fStatus;
    string  _fSearch = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    DropDownItem[] _statusFilterOptions =
    {
        new() { Value = "DRAFT",    Text = "DRAFT"    },
        new() { Value = "ACTIVE",   Text = "ACTIVE"   },
        new() { Value = "OBSOLETE", Text = "OBSOLETE" },
    };

    DropDownItem[] _statusModalOptions =
    {
        new() { Value = "DRAFT",    Text = "DRAFT"    },
        new() { Value = "ACTIVE",   Text = "ACTIVE"   },
        new() { Value = "OBSOLETE", Text = "OBSOLETE" },
    };

    IEnumerable<DropDownItem> TypeFilterOptions =>
        _allRows.Select(r => r.RecipeType).Where(x => x != null).Distinct().OrderBy(x => x)
                .Select(t => new DropDownItem { Value = t!, Text = t! });

    void RcpRowRender(RowRenderEventArgs<MasterDataRepository.RecipeRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/ql/recipe");
        Reload();
    }

    void Reload() { try { _allRows = Md.ListRecipes(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.RecipeID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.RecipeName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType   == null || r.RecipeType == _fType) &&
        (_fStatus == null || r.Status     == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.RecipeRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            RecipeName    = r.RecipeName  ?? "",
            RecipeType    = r.RecipeType  ?? "",
            ItemNo        = r.ItemNo      ?? "",
            CycleTime     = r.CycleTime,
            Version       = r.Version     ?? "",
            EffectiveDate = r.EffectiveDate,
            Status        = r.Status      ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.RecipeID)) { _modalErr = L["Err.RecipeIdRequired"]; return; }
        var id = _f.RecipeID.Trim();
        if (Md.RecipeExists(id)) { _modalErr = $"'{id}' ID가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertRecipe(id, NE(_f.RecipeName), NE(_f.RecipeType),
                NE(_f.ItemNo), _f.CycleTime, NE(_f.Version),
                _f.EffectiveDate, NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            Md.UpdateRecipe(_sel.RecipeID, NE(_f.RecipeName), NE(_f.RecipeType),
                NE(_f.ItemNo), _f.CycleTime, NE(_f.Version),
                _f.EffectiveDate, NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.RecipeID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.RecipeID;
            Md.DeleteRecipe(_sel.RecipeID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   RecipeID      { get; set; } = "";
        public string   RecipeName    { get; set; } = "";
        public string   RecipeType    { get; set; } = "";
        public string   ItemNo        { get; set; } = "";
        public int?     CycleTime     { get; set; }
        public string   Version       { get; set; } = "";
        public DateOnly? EffectiveDate { get; set; }
        public string   Status        { get; set; } = "DRAFT";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}