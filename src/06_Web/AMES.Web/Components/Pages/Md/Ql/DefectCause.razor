@page "/md/ql/defect-cause"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-013 @L["MD.DefectCause.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-013" TitleKey="MD.DefectCause.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.DefectCause.Kpi.RootCause"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RootCauseFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.ProcessCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.DefectCause.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.DefectCause.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Process"]" Component="DropDownProcess" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownProcess" @bind-Value="_fProcess" Data="@ProcessFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.Category"]" Component="DropDownCategory" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownCategory" @bind-Value="_fCategory" Data="@CategoryFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["Col.Active"]" Component="DropDownActive" />
            <RadzenDropDown Name="DropDownActive" @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.DefectCauseRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.DefectCause.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="CauseCode" Title="@L["Col.CauseCode"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r"><span class="code">@r.CauseCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="CauseName" Title="@L["Col.CauseName"]">
                <Template Context="r"><span class="dim">@(r.CauseName ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="CauseNameEn" Title="@L["Col.CauseNameEn"]">
                <Template Context="r"><span class="dim">@(r.CauseNameEn ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="ProcessCode" Title="@L["Col.Process"]" Width="160px">
                <Template Context="r">
                    @if (r.ProcessCode != null) {
                        var procName = _processItems.FirstOrDefault(c2 => c2.CodeValue == r.ProcessCode) is { } pf ? MasterDataRepository.LocalName(pf) : null;
                        <span class="pill @Ui.ProcessClass(r.ProcessCode)">@r.ProcessCode</span>
                        @if (procName != null) {
                            <span class="dim" style="font-size:.8em;margin-left:4px;">@procName</span>
                        }
                    } else {
                        <span class="dim">—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="CauseCategory" Title="@L["Col.Category"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r">
                    @if (r.CauseCategory != null)
                    {
                        <span class="pill">@(_categoryItems.FirstOrDefault(c => c.CodeValue == r.CauseCategory) is { } cf ? MasterDataRepository.LocalName(cf) : r.CauseCategory)</span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="ParentCauseCode" Title="@L["Col.UpperCause"]" Width="120px">
                <Template Context="r"><span class="dim">@(r.ParentCauseCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="ResponsibleDept" Title="@L["Col.Dept"]" Width="110px">
                <Template Context="r">
                    @{ var dLabel = _deptCodes.FirstOrDefault(d => d.CodeValue == r.ResponsibleDept) is { } dl ? MasterDataRepository.LocalName(dl) : r.ResponsibleDept; }
                    <span class="dim">@(dLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="SortOrder" Title="@L["Col.Seq"]" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="r"><span class="dim">@(r.SortOrder?.ToString() ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="RootCauseFlag" Title="@L["Col.RootCause"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r">
                    @if (r.RootCauseFlag) { <span class="pill ok">Y</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCauseRow" Property="ActiveFlag" Title="@L["Col.Active"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r">
                    @{
                        var afCode  = r.ActiveFlag ? "ACTIVE" : "INACTIVE";
                        var afLabel = _activeFlagItems.FirstOrDefault(a => a.CodeValue == afCode) is { } af ? MasterDataRepository.LocalName(af) : afCode;
                    }
                    <span class="pill @(r.ActiveFlag ? "ok" : "bad")">@afLabel</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.DefectCause.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["Col.CauseCode"]} *")' class="ames-rz-modal-label" Component="CreateTextBoxCauseCode" />
                <RadzenTextBox Name="CreateTextBoxCauseCode" @bind-Value="_f.CauseCode" Placeholder="CC-INJ-001" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@($"{L["Col.CauseName"]} *")' class="ames-rz-modal-label" Component="CreateTextBoxCauseName" />
                <RadzenTextBox Name="CreateTextBoxCauseName" @bind-Value="_f.CauseName" Placeholder="@L["MD.DefectCause.Ph.CauseName"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["Col.CauseNameEn"]" class="ames-rz-modal-label" Component="CreateTextBoxCauseNameEn" />
                <RadzenTextBox Name="CreateTextBoxCauseNameEn" @bind-Value="_f.CauseNameEn" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Process"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ProcessCode" Data="ProcessOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Category"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.CauseCategory" Data="CategoryOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" Value="_f.RootCauseFlag" ValueChanged="v => { _f.RootCauseFlag = v; if (v) _f.ParentCauseCode = null; }" Name="CreateChkRootCause" />
                <RadzenLabel Text="@L["Col.RootCause"]" Component="CreateChkRootCause" style="cursor:pointer;" />
            </RadzenStack>

            @if (!_f.RootCauseFlag)
            {
                <RadzenRow Gap="8px" Style="margin-top:6px;">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="@L["Col.DefaultCause"]" />
                        <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ParentCauseCode" Data="@(_allRows.Where(r => r.RootCauseFlag).OrderBy(r => r.CauseCode).Select(rc => new DropDownItem { Value = rc.CauseCode, Text = $"[{rc.CauseCode}] {(MasterDataRepository.LocalName(rc.CauseName, rc.CauseNameEn) is { Length: > 0 } nm ? nm : rc.CauseCode)}" }))" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.None"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>
            }

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Dept"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ResponsibleDept" Data="DeptOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.SortSeq"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.SortOrder" Placeholder="10" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text="@L["Col.CorrectiveGuide"]" />
                    <RadzenTextArea @bind-Value="_f.CorrectiveGuide" Rows="3" Placeholder="@L["MD.DefectCause.Ph.CorrectiveGuide"]" class="ames-rz-input" Style="width:100%;resize:vertical;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Active"]" />
                    <div style="display:flex;align-items:center;gap:0.5rem;height:32px;">
                        <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                        <RadzenLabel Text="@L["Lbl.Active"]" style="cursor:pointer;" />
                    </div>
                </RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.DefectCause.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.CauseCode</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["Col.CauseName"]} *")' class="ames-rz-modal-label" Component="EditTextBoxCauseName" />
                <RadzenTextBox Name="EditTextBoxCauseName" @bind-Value="_f.CauseName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["Col.CauseNameEn"]" class="ames-rz-modal-label" Component="EditTextBoxCauseNameEn" />
                <RadzenTextBox Name="EditTextBoxCauseNameEn" @bind-Value="_f.CauseNameEn" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Process"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ProcessCode" Data="ProcessOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Category"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.CauseCategory" Data="CategoryOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" Value="_f.RootCauseFlag" ValueChanged="v => { _f.RootCauseFlag = v; if (v) _f.ParentCauseCode = null; }" Name="EditChkRootCause" />
                <RadzenLabel Text="@L["Col.RootCause"]" Component="EditChkRootCause" style="cursor:pointer;" />
            </RadzenStack>

            @if (!_f.RootCauseFlag)
            {
                <RadzenRow Gap="8px" Style="margin-top:6px;">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="@L["Col.DefaultCause"]" />
                        <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ParentCauseCode" Data="@(_allRows.Where(r => r.RootCauseFlag && r.CauseCode != _sel!.CauseCode).OrderBy(r => r.CauseCode).Select(rc => new DropDownItem { Value = rc.CauseCode, Text = $"[{rc.CauseCode}] {(MasterDataRepository.LocalName(rc.CauseName, rc.CauseNameEn) is { Length: > 0 } nm ? nm : rc.CauseCode)}" }))" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.None"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                    </RadzenColumn>
                </RadzenRow>
            }

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Dept"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.ResponsibleDept" Data="DeptOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.SortSeq"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.SortOrder" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text="@L["Col.CorrectiveGuide"]" />
                    <RadzenTextArea @bind-Value="_f.CorrectiveGuide" Rows="3" class="ames-rz-input" Style="width:100%;resize:vertical;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Active"]" />
                    <div style="display:flex;align-items:center;gap:0.5rem;height:32px;">
                        <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                        <RadzenLabel Text="@L["Lbl.Active"]" style="cursor:pointer;" />
                    </div>
                </RadzenColumn>
            </RadzenRow>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.DefectCauseRow> _allRows = new();
    List<MasterDataRepository.DefectCauseRow> _rows = new();
    List<MasterDataRepository.CodeItemRow> _deptCodes = new();
    List<MasterDataRepository.CodeItemRow> _activeFlagItems = new();
    List<MasterDataRepository.CodeItemRow> _processItems = new();
    List<MasterDataRepository.CodeItemRow> _categoryItems = new();
    MasterDataRepository.DefectCauseRow? _sel;

    string _fSearch = "";
    string? _fCategory, _fProcess, _fActive;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> CategoryFilterOptions => _categoryItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    IEnumerable<DropDownItem> ProcessFilterOptions => _processItems.Where(p => p.UseFlag && p.Attribute1 == "ROUTING").Select(p => new DropDownItem { Value = p.CodeValue ?? "", Text = $"[{p.CodeValue}] {MasterDataRepository.LocalName(p)}" });
    IEnumerable<DropDownItem> ProcessOptions  => _processItems.Where(c => c.UseFlag && c.Attribute1 == "ROUTING").Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    IEnumerable<DropDownItem> CategoryOptions => _categoryItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    IEnumerable<DropDownItem> ActiveFilterOptions => _activeFlagItems.Where(a => a.UseFlag).Select(a => new DropDownItem { Value = a.CodeValue ?? "", Text = MasterDataRepository.LocalName(a) });
    IEnumerable<DropDownItem> DeptOptions => _deptCodes.Where(d => d.UseFlag).Select(d => new DropDownItem { Value = d.CodeValue ?? "", Text = MasterDataRepository.LocalName(d) });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/ql/defect-cause");
        try { _deptCodes    = MD.ListCodeItems("DEPARTMENT");     } catch { }
        try { _activeFlagItems = MD.ListCodeItems("ACTIVE_FLAG"); } catch { }
        try { _processItems = MD.ListCodeItems("PROCESS");        } catch { }
        try { _categoryItems = MD.ListCodeItems("CAUSE_CATEGORY"); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.DefectCauseRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _allRows = MD.ListDefectCauses(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.CauseCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CauseName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fCategory == null || r.CauseCategory == _fCategory) &&
        (_fProcess  == null || r.ProcessCode   == _fProcess) &&
        (_fActive == null || (_fActive == "ACTIVE" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.DefectCauseRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.DefectCauseRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new() { ActiveFlag = true }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.DefectCauseRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            CauseCode       = r.CauseCode,
            CauseName       = r.CauseName       ?? "",
            CauseNameEn     = r.CauseNameEn     ?? "",
            CauseCategory   = r.CauseCategory   ?? "",
            ParentCauseCode = r.RootCauseFlag ? null : r.ParentCauseCode,
            ProcessCode     = r.ProcessCode     ?? "",
            RootCauseFlag   = r.RootCauseFlag,
            CorrectiveGuide = r.CorrectiveGuide ?? "",
            ResponsibleDept = r.ResponsibleDept,
            SortOrder       = r.SortOrder,
            ActiveFlag      = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CauseCode)) { _modalErr = L["Err.CauseCodeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.CauseName)) { _modalErr = L["Err.CauseNameRequired"]; return; }
        if (MD.DefectCauseExists(_f.CauseCode.Trim())) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], _f.CauseCode.Trim()); return; }
        _busy = true;
        try
        {
            MD.InsertDefectCause(_f.CauseCode.Trim(), _f.CauseName, NE(_f.CauseNameEn), NE(_f.CauseCategory),
                _f.ParentCauseCode, NE(_f.ProcessCode), _f.RootCauseFlag,
                NE(_f.CorrectiveGuide), _f.ResponsibleDept, _f.SortOrder,
                _f.ActiveFlag, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{_f.CauseName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CauseName)) { _modalErr = L["Err.CauseNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateDefectCause(_sel.CauseCode, _f.CauseName, NE(_f.CauseNameEn), NE(_f.CauseCategory),
                _f.ParentCauseCode, NE(_f.ProcessCode), _f.RootCauseFlag,
                NE(_f.CorrectiveGuide), _f.ResponsibleDept, _f.SortOrder,
                _f.ActiveFlag, _actor);
            var name = _f.CauseName;
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.CauseName ?? _sel.CauseCode;
            MD.DeleteDefectCause(_sel.CauseCode);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string  CauseCode       { get; set; } = "";
        public string  CauseName       { get; set; } = "";
        public string  CauseNameEn     { get; set; } = "";
        public string  CauseCategory   { get; set; } = "";
        public string? ParentCauseCode { get; set; }
        public string  ProcessCode     { get; set; } = "";
        public bool    RootCauseFlag   { get; set; }
        public string  CorrectiveGuide { get; set; } = "";
        public string? ResponsibleDept { get; set; }
        public int?    SortOrder       { get; set; }
        public bool    ActiveFlag      { get; set; } = true;
    }
}