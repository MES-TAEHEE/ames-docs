@page "/md/ql/label-template"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.LabelTpl.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.LabelTpl.Kpi.LabelTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LabelType).Where(t => t != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.LabelTpl.Kpi.CustomerAssigned"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.CustomerID != null)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.LabelTpl.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.LabelTemplate.Ph.Search"]' Style="width:150px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Type"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fType" Data="LabelTypeFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllTypes"]' Style="width:130px;" />
            <RadzenButton Text='@L["Btn.Search"]' Icon="refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.LabelTemplateRow"
                    RowRender="LtRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.LabelTpl.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="LabelTemplateID" Title='@L["Col.TemplateId"]' Width="120px">
                <Template Context="r"><span class="code">@r.LabelTemplateID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="TemplateName" Title='@L["Col.TemplateName"]' Width="160px">
                <Template Context="r">@(r.TemplateName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="LabelType" Title='@L["Col.LabelType"]' Width="110px">
                <Template Context="r">
                    @{ var ltEntry = _labelTypes.FirstOrDefault(x => x.CodeValue == r.LabelType); }
                    @(ltEntry != null ? MasterDataRepository.LocalName(ltEntry) : r.LabelType ?? "—")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="PaperSize" Title='@L["Col.PaperSize"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.PaperSize ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="BarcodeType" Title='@L["Col.BarcodeType"]' Width="110px">
                <Template Context="r">
                    @{ var btEntry = _barcodeTypes.FirstOrDefault(x => x.CodeValue == r.BarcodeType); }
                    <span class="dim">@(btEntry != null ? MasterDataRepository.LocalName(btEntry) : r.BarcodeType ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="CustomerID" Title='@L["Col.Customer"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.CustomerID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Version" Title='@L["Col.Version"]' Width="75px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.Version?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="PrinterModel" Title='@L["Col.PrinterModel"]' Width="120px">
                <Template Context="r"><span class="dim">@(r.PrinterModel ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Status" Title='@L["Col.Status"]' Width="95px">
                <Template Context="r">
                    @{ var stEntry = _labelStatuses.FirstOrDefault(x => x.CodeValue == r.Status); var stCss = r.Status == "ACTIVE" ? "ok" : "warn"; var stLabel = stEntry != null ? MasterDataRepository.LocalName(stEntry) : r.Status; }
                    <span class="pill @stCss">@(stLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.LabelTpl.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.TemplateId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.LabelTemplateID" Placeholder="LBL-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.TemplateName"]' /><br />
                    <RadzenTextBox @bind-Value="_f.TemplateName" Placeholder='@L["MD.LabelTemplate.Ph.TemplateName"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.LabelType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.LabelType" Data="LabelTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.PaperSize"]' /><br />
                    <RadzenTextBox @bind-Value="_f.PaperSize" Placeholder="A4 / 100x70" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.BarcodeType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.BarcodeType" Data="BarcodeTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Customer"]' /><br />
                    <RadzenTextBox @bind-Value="_f.CustomerID" Placeholder="CUST-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Version"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.Version" Placeholder="1" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.PrinterModel"]' /><br />
                    <RadzenTextBox @bind-Value="_f.PrinterModel" Placeholder="Zebra ZT230" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.LabelTpl.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.LabelTemplateID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.TemplateName"]' /><br />
                    <RadzenTextBox @bind-Value="_f.TemplateName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.LabelType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.LabelType" Data="LabelTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.PaperSize"]' /><br />
                    <RadzenTextBox @bind-Value="_f.PaperSize" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.BarcodeType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.BarcodeType" Data="BarcodeTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Customer"]' /><br />
                    <RadzenTextBox @bind-Value="_f.CustomerID" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Version"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.Version" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.PrinterModel"]' /><br />
                    <RadzenTextBox @bind-Value="_f.PrinterModel" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.LabelTemplateRow> _allRows = new();
    List<MasterDataRepository.LabelTemplateRow> _rows    = new();
    MasterDataRepository.LabelTemplateRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };
    List<MasterDataRepository.CodeItemRow> _labelTypes    = new();
    List<MasterDataRepository.CodeItemRow> _barcodeTypes  = new();
    List<MasterDataRepository.CodeItemRow> _labelStatuses = new();

    string? _fType;
    string  _fSearch = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    IEnumerable<DropDownItem> LabelTypeFilterOptions =>
        _labelTypes.Where(x => x.UseFlag)
                   .Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = MasterDataRepository.LocalName(t) });

    IEnumerable<DropDownItem> LabelTypeOptions =>
        _labelTypes.Where(x => x.UseFlag)
                   .Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });

    IEnumerable<DropDownItem> BarcodeTypeOptions =>
        _barcodeTypes.Where(x => x.UseFlag)
                     .Select(b => new DropDownItem { Value = b.CodeValue ?? "", Text = $"[{b.CodeValue}] {MasterDataRepository.LocalName(b)}" });

    IEnumerable<DropDownItem> StatusOptions =>
        _labelStatuses.Where(x => x.UseFlag)
                      .Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });

    void LtRowRender(RowRenderEventArgs<MasterDataRepository.LabelTemplateRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/ql/label-template");
        try { _labelTypes    = Md.ListCodeItems("LABEL_TYPE");   } catch { }
        try { _barcodeTypes  = Md.ListCodeItems("BARCODE_TYPE"); } catch { }
        try { _labelStatuses = Md.ListCodeItems("LABEL_STATUS"); } catch { }
        Reload();
    }

    void Reload() { try { _allRows = Md.ListLabelTemplates(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.LabelTemplateID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.TemplateName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType == null || r.LabelType == _fType)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.LabelTemplateRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            TemplateName = r.TemplateName ?? "",
            LabelType    = r.LabelType,
            PaperSize    = r.PaperSize    ?? "",
            BarcodeType  = r.BarcodeType,
            CustomerID   = r.CustomerID   ?? "",
            Version      = r.Version,
            PrinterModel = r.PrinterModel ?? "",
            Status       = r.Status       ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.LabelTemplateID)) { _modalErr = L["Err.TemplateIdRequired"]; return; }
        var id = _f.LabelTemplateID.Trim();
        if (Md.LabelTemplateExists(id)) { _modalErr = $"'{id}' ID가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertLabelTemplate(id, NE(_f.TemplateName), _f.LabelType,
                NE(_f.PaperSize), _f.BarcodeType, NE(_f.CustomerID),
                _f.Version, NE(_f.PrinterModel), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            Md.UpdateLabelTemplate(_sel.LabelTemplateID, NE(_f.TemplateName), _f.LabelType,
                NE(_f.PaperSize), _f.BarcodeType, NE(_f.CustomerID),
                _f.Version, NE(_f.PrinterModel), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.LabelTemplateID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.LabelTemplateID;
            Md.DeleteLabelTemplate(_sel.LabelTemplateID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string  LabelTemplateID { get; set; } = "";
        public string  TemplateName    { get; set; } = "";
        public string? LabelType       { get; set; }
        public string  PaperSize       { get; set; } = "";
        public string? BarcodeType     { get; set; }
        public string  CustomerID      { get; set; } = "";
        public int?    Version         { get; set; }
        public string  PrinterModel    { get; set; } = "";
        public string  Status          { get; set; } = "ACTIVE";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}