@page "/md/ql/packaging-spec"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.PackSpec.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.PackSpec.Kpi.Returnable"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ReturnableFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.PackSpec.Kpi.PackTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.PackType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.PackSpec.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.PackagingSpec.Ph.Search"]' Style="width:140px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Type"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fType" Data="PackTypeFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllTypes"]' Style="width:130px;" />
            <RadzenButton Text='@L["Btn.Search"]' Icon="refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.PackagingSpecRow"
                    RowRender="PsRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.PackSpec.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="PackSpecID" Title='@L["Col.SpecId"]' Width="110px">
                <Template Context="r"><span class="code">@r.PackSpecID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ItemID" Title='@L["Col.ItemNo"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.ItemID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="PackType" Title='@L["Col.PackType"]' Width="110px">
                <Template Context="r">
                    @{ var ptEntry = _packingTypes.FirstOrDefault(x => x.CodeValue == r.PackType); }
                    @(ptEntry != null ? MasterDataRepository.LocalName(ptEntry) : r.PackType ?? "—")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="QtyPerInner" Title='@L["Col.InnerQty"]' Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.QtyPerInner?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="InnerPerOuter" Title='@L["Col.InnerPerOuter"]' Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.InnerPerOuter?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="OuterPerPallet" Title='@L["Col.OuterPerPallet"]' Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.OuterPerPallet?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="NetWeightKg" Title='@L["Col.NetWeight"]' Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.NetWeightKg?.ToString("0.000") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="GrossWeightKg" Title='@L["Col.GrossWeight"]' Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.GrossWeightKg?.ToString("0.000") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="DimLxWxH" Title='@L["Col.Dimensions"]' Width="120px">
                <Template Context="r"><span class="dim">@(r.DimLxWxH ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="ReturnableFlag" Title='@L["Col.Returnable"]' Width="85px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.ReturnableFlag) { <span class="pill ok">@L["MD.PackagingSpec.PillReturn"]</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="LabelTemplateID" Title='@L["Col.LabelTemplate"]' Width="110px">
                <Template Context="r"><span class="dim">@(r.LabelTemplateID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Status" Title='@L["Col.Status"]' Width="95px">
                <Template Context="r">
                    @{ var stEntry = _packStatus.FirstOrDefault(x => x.CodeValue == r.Status); var stCss = r.Status == "ACTIVE" ? "ok" : "warn"; var stLabel = stEntry != null ? MasterDataRepository.LocalName(stEntry) : r.Status; }
                    <span class="pill @stCss">@(stLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PackSpec.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["Col.SpecId"]' /><br />
                    <RadzenTextBox @bind-Value="_f.PackSpecID" Placeholder="PS-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.ItemNo"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ItemID" Placeholder="ITEM-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.PackType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.PackType" Data="PackTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InnerQty"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.QtyPerInner" Placeholder="10" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InnerPerOuter"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.InnerPerOuter" Placeholder="5" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.OuterPerPallet"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.OuterPerPallet" Placeholder="20" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.NetWeight"]} (kg)")' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.NetWeightKg" Step="0.001m" Placeholder="0.500" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.GrossWeight"]} (kg)")' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.GrossWeightKg" Step="0.001m" Placeholder="0.600" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.Dimensions"]} (L×W×H mm)")' /><br />
                    <RadzenTextBox @bind-Value="_f.DimLxWxH" Placeholder="400x300x200" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.LabelTemplate"]' /><br />
                    <RadzenTextBox @bind-Value="_f.LabelTemplateID" Placeholder="LBL-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="display:flex;align-items:center;gap:8px;padding-top:22px;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ReturnableFlag" />
                    <RadzenLabel Text='@L["Col.Returnable"]' Style="cursor:pointer;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PackSpec.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.PackSpecID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.ItemNo"]' /><br />
                    <RadzenTextBox @bind-Value="_f.ItemID" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.PackType"]' /><br />
                    <RadzenDropDown @bind-Value="_f.PackType" Data="PackTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InnerQty"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.QtyPerInner" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.InnerPerOuter"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.InnerPerOuter" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.OuterPerPallet"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.OuterPerPallet" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.NetWeight"]} (kg)")' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.NetWeightKg" Step="0.001m" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["Col.GrossWeight"]} (kg)")' /><br />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.GrossWeightKg" Step="0.001m" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.Dimensions"]' /><br />
                    <RadzenTextBox @bind-Value="_f.DimLxWxH" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.LabelTemplate"]' /><br />
                    <RadzenTextBox @bind-Value="_f.LabelTemplateID" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="display:flex;align-items:center;gap:8px;padding-top:22px;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ReturnableFlag" />
                    <RadzenLabel Text='@L["Col.Returnable"]' Style="cursor:pointer;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.PackagingSpecRow> _allRows = new();
    List<MasterDataRepository.PackagingSpecRow> _rows    = new();
    MasterDataRepository.PackagingSpecRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };
    List<MasterDataRepository.CodeItemRow> _packingTypes = new();
    List<MasterDataRepository.CodeItemRow> _packStatus   = new();

    string? _fType;
    string  _fSearch = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    IEnumerable<DropDownItem> PackTypeFilterOptions =>
        _packingTypes.Where(x => x.UseFlag)
                     .Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = MasterDataRepository.LocalName(t) });

    IEnumerable<DropDownItem> PackTypeOptions =>
        _packingTypes.Where(x => x.UseFlag)
                     .Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });

    IEnumerable<DropDownItem> StatusOptions =>
        _packStatus.Where(x => x.UseFlag)
                   .Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });

    void PsRowRender(RowRenderEventArgs<MasterDataRepository.PackagingSpecRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/ql/packaging-spec");
        try { _packingTypes = Md.ListCodeItems("PACKING_TYPE"); } catch { }
        try { _packStatus   = Md.ListCodeItems("PACK_STATUS");  } catch { }
        Reload();
    }

    void Reload() { try { _allRows = Md.ListPackagingSpecs(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.PackSpecID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemID ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType == null || r.PackType == _fType)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.PackagingSpecRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            ItemID          = r.ItemID          ?? "",
            PackType        = r.PackType,
            QtyPerInner     = r.QtyPerInner,
            InnerPerOuter   = r.InnerPerOuter,
            OuterPerPallet  = r.OuterPerPallet,
            NetWeightKg     = r.NetWeightKg,
            GrossWeightKg   = r.GrossWeightKg,
            DimLxWxH        = r.DimLxWxH        ?? "",
            ReturnableFlag  = r.ReturnableFlag,
            LabelTemplateID = r.LabelTemplateID  ?? "",
            Status          = r.Status           ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.PackSpecID)) { _modalErr = L["Err.SpecIdRequired"]; return; }
        var id = _f.PackSpecID.Trim();
        if (Md.PackagingSpecExists(id)) { _modalErr = $"'{id}' ID가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertPackagingSpec(id, NE(_f.ItemID), _f.PackType,
                _f.QtyPerInner, _f.InnerPerOuter, _f.OuterPerPallet,
                _f.NetWeightKg, _f.GrossWeightKg, NE(_f.DimLxWxH),
                _f.ReturnableFlag, NE(_f.LabelTemplateID), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            Md.UpdatePackagingSpec(_sel.PackSpecID, NE(_f.ItemID), _f.PackType,
                _f.QtyPerInner, _f.InnerPerOuter, _f.OuterPerPallet,
                _f.NetWeightKg, _f.GrossWeightKg, NE(_f.DimLxWxH),
                _f.ReturnableFlag, NE(_f.LabelTemplateID), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.PackSpecID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.PackSpecID;
            Md.DeletePackagingSpec(_sel.PackSpecID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   PackSpecID      { get; set; } = "";
        public string   ItemID          { get; set; } = "";
        public string?  PackType        { get; set; }
        public int?     QtyPerInner     { get; set; }
        public int?     InnerPerOuter   { get; set; }
        public int?     OuterPerPallet  { get; set; }
        public decimal? NetWeightKg     { get; set; }
        public decimal? GrossWeightKg   { get; set; }
        public string   DimLxWxH        { get; set; } = "";
        public bool     ReturnableFlag  { get; set; }
        public string   LabelTemplateID { get; set; } = "";
        public string   Status          { get; set; } = "ACTIVE";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}