@page "/md/ql/packaging-spec"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-023 @L["MD.PackSpec.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-023" TitleKey="MD.PackSpec.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.PackSpec.Kpi.Returnable"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ReturnableFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.PackSpec.Kpi.PackTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.PackType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.PackSpec.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.PackagingSpec.Ph.Search"]" Style="width:140px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fType" Data="@PackTypeFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.PackagingSpecRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.PackSpec.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="PackSpecID" Title="@L["Col.SpecId"]" Width="110px">
                <Template Context="r"><span class="code">@r.PackSpecID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="ItemID" Title="@L["Col.ItemNo"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.ItemID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="PackType" Title="@L["Col.PackType"]" Width="110px">
                <Template Context="r">
                    @{ var ptEntry = _packingTypes.FirstOrDefault(x => x.CodeValue == r.PackType); }
                    @(ptEntry != null ? MasterDataRepository.LocalName(ptEntry) : r.PackType ?? "—")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="QtyPerInner" Title="@L["Col.InnerQty"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.QtyPerInner?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="InnerPerOuter" Title="@L["Col.InnerPerOuter"]" Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.InnerPerOuter?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="OuterPerPallet" Title="@L["Col.OuterPerPallet"]" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.OuterPerPallet?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="NetWeightKg" Title="@L["Col.NetWeight"]" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.NetWeightKg?.ToString("0.000") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="GrossWeightKg" Title="@L["Col.GrossWeight"]" Width="90px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.GrossWeightKg?.ToString("0.000") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="DimLxWxH" Title="@L["Col.Dimensions"]" Width="120px">
                <Template Context="r"><span class="dim">@(r.DimLxWxH ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="ReturnableFlag" Title="@L["Col.Returnable"]" Width="85px" TextAlign="TextAlign.Center">
                <Template Context="r">@if (r.ReturnableFlag) { <span class="pill ok">@L["MD.PackagingSpec.PillReturn"]</span> }</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="LabelTemplateID" Title="@L["Col.LabelTemplate"]" Width="110px">
                <Template Context="r"><span class="dim">@(r.LabelTemplateID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PackagingSpecRow" Property="Status" Title="@L["Col.Status"]" Width="95px">
                <Template Context="r">
                    @{ var stEntry = _packStatus.FirstOrDefault(x => x.CodeValue == r.Status); var stCss = r.Status == "ACTIVE" ? "ok" : "warn"; var stLabel = stEntry != null ? MasterDataRepository.LocalName(stEntry) : r.Status; }
                    <span class="pill @stCss">@(stLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PackSpec.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["Col.SpecId"]" class="ames-rz-modal-label" Component="CreateTextBoxPackSpecID" />
                <RadzenTextBox Name="CreateTextBoxPackSpecID" @bind-Value="_f.PackSpecID" Placeholder="PS-001" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ItemNo"]" />
                    <RadzenTextBox @bind-Value="_f.ItemID" Placeholder="ITEM-001" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.PackType"]" />
                    <RadzenDropDown @bind-Value="_f.PackType" Data="PackTypeOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InnerQty"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.QtyPerInner" Placeholder="10" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InnerPerOuter"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.InnerPerOuter" Placeholder="5" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.OuterPerPallet"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.OuterPerPallet" Placeholder="20" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.NetWeight"]} (kg)")' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.NetWeightKg" Step="0.001m" Placeholder="0.500" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.GrossWeight"]} (kg)")' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.GrossWeightKg" Step="0.001m" Placeholder="0.600" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.LabelTemplate"]" />
                    <RadzenTextBox @bind-Value="_f.LabelTemplateID" Placeholder="LBL-001" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@($"{L["Col.Dimensions"]} (L×W×H mm)")' />
                    <RadzenTextBox @bind-Value="_f.DimLxWxH" Placeholder="400x300x200" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ReturnableFlag" Name="CreateChkReturnable" />
                <RadzenLabel Text="@L["Col.Returnable"]" Component="CreateChkReturnable" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PackSpec.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.PackSpecID</span></div>

            <RadzenRow Gap="8px">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.ItemNo"]" />
                    <RadzenTextBox @bind-Value="_f.ItemID" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.PackType"]" />
                    <RadzenDropDown @bind-Value="_f.PackType" Data="PackTypeOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InnerQty"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.QtyPerInner" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.InnerPerOuter"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.InnerPerOuter" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.OuterPerPallet"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.OuterPerPallet" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.NetWeight"]} (kg)")' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.NetWeightKg" Step="0.001m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@($"{L["Col.GrossWeight"]} (kg)")' />
                    <RadzenNumeric TValue="decimal?" @bind-Value="_f.GrossWeightKg" Step="0.001m" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.LabelTemplate"]" />
                    <RadzenTextBox @bind-Value="_f.LabelTemplateID" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text="@L["Col.Dimensions"]" />
                    <RadzenTextBox @bind-Value="_f.DimLxWxH" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ReturnableFlag" Name="EditChkReturnable" />
                <RadzenLabel Text="@L["Col.Returnable"]" Component="EditChkReturnable" style="cursor:pointer;" />
            </RadzenStack>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.PackagingSpecRow> _allRows = new();
    List<MasterDataRepository.PackagingSpecRow> _rows = new();
    List<MasterDataRepository.CodeItemRow> _packingTypes = new();
    List<MasterDataRepository.CodeItemRow> _packStatus = new();
    MasterDataRepository.PackagingSpecRow? _sel;

    string _fSearch = "";
    string? _fType;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> PackTypeFilterOptions => _packingTypes.Where(x => x.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = MasterDataRepository.LocalName(t) });
    IEnumerable<DropDownItem> PackTypeOptions => _packingTypes.Where(x => x.UseFlag).Select(t => new DropDownItem { Value = t.CodeValue ?? "", Text = $"[{t.CodeValue}] {MasterDataRepository.LocalName(t)}" });
    IEnumerable<DropDownItem> StatusOptions => _packStatus.Where(x => x.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/ql/packaging-spec");
        try { _packingTypes = MD.ListCodeItems("PACKING_TYPE"); } catch { }
        try { _packStatus   = MD.ListCodeItems("PACK_STATUS");  } catch { }
        Reload();
    }

    void Reload() { try { _allRows = MD.ListPackagingSpecs(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.PackSpecID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemID ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType == null || r.PackType == _fType)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.PackagingSpecRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.PackagingSpecRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.PackagingSpecRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            ItemID          = r.ItemID          ?? "",
            PackType        = r.PackType,
            QtyPerInner     = r.QtyPerInner,
            InnerPerOuter   = r.InnerPerOuter,
            OuterPerPallet  = r.OuterPerPallet,
            NetWeightKg     = r.NetWeightKg,
            GrossWeightKg   = r.GrossWeightKg,
            DimLxWxH        = r.DimLxWxH        ?? "",
            ReturnableFlag  = r.ReturnableFlag,
            LabelTemplateID = r.LabelTemplateID  ?? "",
            Status          = r.Status           ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.PackSpecID)) { _modalErr = L["Err.SpecIdRequired"]; return; }
        var id = _f.PackSpecID.Trim();
        if (MD.PackagingSpecExists(id)) { _modalErr = $"'{id}' ID가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            MD.InsertPackagingSpec(id, NE(_f.ItemID), _f.PackType,
                _f.QtyPerInner, _f.InnerPerOuter, _f.OuterPerPallet,
                _f.NetWeightKg, _f.GrossWeightKg, NE(_f.DimLxWxH),
                _f.ReturnableFlag, NE(_f.LabelTemplateID), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            MD.UpdatePackagingSpec(_sel.PackSpecID, NE(_f.ItemID), _f.PackType,
                _f.QtyPerInner, _f.InnerPerOuter, _f.OuterPerPallet,
                _f.NetWeightKg, _f.GrossWeightKg, NE(_f.DimLxWxH),
                _f.ReturnableFlag, NE(_f.LabelTemplateID), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.PackSpecID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.PackSpecID;
            MD.DeletePackagingSpec(_sel.PackSpecID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string   PackSpecID      { get; set; } = "";
        public string   ItemID          { get; set; } = "";
