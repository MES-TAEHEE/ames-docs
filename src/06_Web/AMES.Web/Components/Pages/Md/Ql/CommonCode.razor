@page "/md/ql/common-code"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-030 @L["MD.CommonCode.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-030" TitleKey="MD.CommonCode.Title" />

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div style="display:flex;gap:16px;align-items:flex-start;">

    @* ── 좌: 코드 그룹 ────────────────────────────────────────────────── *@
    <div style="flex:0 0 480px;">
        <div class="ames-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                <span style="font-weight:600;font-size:1em;">@L["MD.CommonCode.GrpHeader"]</span>
                @if (_canEdit) {
                    <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenGroupCreate" class="ames-rz-btn" />
                }
            </div>
            <RadzenDataGrid Data="_groups" TItem="MasterDataRepository.CodeGroupRow"
                            RowRender="GrpRowRender" RowSelect="OnGroupRowSelect"
                            AllowPaging="true" PageSize="15" PageSizeOptions="_pageSizeOptions"
                            PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                            Class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn Property="GroupCode" Title='@L["Col.GroupCode"]' Width="160px">
                        <Template Context="g"><span class="code">@g.GroupCode</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="GroupName" Title='@L["Col.GroupName"]' />
                    <RadzenDataGridColumn Property="UseFlag" Title='@L["Col.Active"]' Width="60px" TextAlign="TextAlign.Center">
                        <Template Context="g">
                            <span class="pill @(g.UseFlag ? "ok" : "dim")">@(g.UseFlag ? "Y" : "N")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="52px" TextAlign="TextAlign.Center">
                        <Template Context="g">
                            <div @onclick:stopPropagation>
                                <RadzenButton ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Text="▶"
                                              Click="() => SelectGroup(g)" title='@L["MD.CommonCode.Title.ViewItems"]' />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>

    @* ── 우: 코드 항목 ────────────────────────────────────────────────── *@
    <div style="flex:1;min-width:0;">
        <div class="ames-card">
            @if (_selGroup is null)
            {
                <div class="dim" style="padding:24px 0;text-align:center;">@L["MD.CommonCode.ItemHint"]</div>
            }
            else
            {
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                    <span style="font-weight:600;font-size:1em;">
                        <span class="code" style="font-size:.9em;margin-right:6px;">@_selGroup.GroupCode</span>
                        @_selGroup.GroupName
                        <span class="dim" style="font-weight:400;margin-left:6px;">@string.Format(L["MD.CommonCode.ItemCount"].Value, _items.Count)</span>
                    </span>
                    @if (_canEdit) {
                        <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenItemCreate" class="ames-rz-btn" />
                    }
                </div>
                <RadzenDataGrid Data="_items" TItem="MasterDataRepository.CodeItemRow"
                                RowRender="ItemRowRender" RowSelect="OpenItemEdit"
                                AllowPaging="false" Class="ames-rz-grid">
                    <Columns>
                        <RadzenDataGridColumn Property="SortOrder" Title='@L["Col.Seq"]' Width="60px" TextAlign="TextAlign.Right">
                            <Template Context="i">@i.SortOrder</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="CodeValue" Title='@L["Col.CodeValue"]' Width="120px">
                            <Template Context="i"><span class="code">@i.CodeValue</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="CodeName" Title='@L["Col.CodeName"]' />
                        <RadzenDataGridColumn Property="CodeNameEn" Title='@L["Col.NameEn"]'>
                            <Template Context="i"><span class="dim">@i.CodeNameEn</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="Attribute1" Title='@L["Col.Attr1"]' Width="100px">
                            <Template Context="i"><span class="dim">@i.Attribute1</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="UseFlag" Title='@L["Col.Active"]' Width="60px" TextAlign="TextAlign.Center">
                            <Template Context="i">
                                <span class="pill @(i.UseFlag ? "ok" : "dim")">@(i.UseFlag ? "Y" : "N")</span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>
    </div>
</div>

@* ── 코드 그룹 등록 모달 ──────────────────────────────────────────────── *@
@if (_modal == "grp-create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:500px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.CommonCode.Grp.Create"]</div>
            <div style="margin-bottom:6px;">
                <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.GroupCode"]} {L["MD.CommonCode.Lbl.GroupCodeHint"]}")' /><br />
                <RadzenTextBox @bind-Value="_fGroupCode" Placeholder="예: DEFECT_TYPE" MaxLength="20" Style="width:100%;" autocomplete="off" />
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.GroupName"]' /><br />
                    <RadzenTextBox @bind-Value="_fGroupName" Placeholder='@L["MD.CommonCode.Ph.GroupName"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.GroupNameEn"]' /><br />
                    <RadzenTextBox @bind-Value="_fGroupNameEn" Placeholder="예: Defect Type" Style="width:100%;" autocomplete="off" />
                </div>
            </div>
            <div style="margin-top:6px;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.Description"]' /><br />
                <RadzenTextBox @bind-Value="_fDescription" Style="width:100%;" autocomplete="off" />
            </div>
            <div style="margin-top:8px;display:flex;align-items:center;gap:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_fUseFlag" />
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.UseFlag"]' Style="cursor:pointer;" />
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveGroupCreate" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 코드 그룹 수정/삭제 모달 ────────────────────────────────────────── *@
@if (_modal == "grp-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:500px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.CommonCode.Grp.Edit"] — <span class="code" style="font-weight:400;font-size:.9em;">@_fGroupCode</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.GroupName"]' /><br />
                    <RadzenTextBox @bind-Value="_fGroupName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.GroupNameEn"]' /><br />
                    <RadzenTextBox @bind-Value="_fGroupNameEn" Style="width:100%;" autocomplete="off" />
                </div>
            </div>
            <div style="margin-top:6px;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.Description"]' /><br />
                <RadzenTextBox @bind-Value="_fDescription" Style="width:100%;" autocomplete="off" />
            </div>
            <div style="margin-top:8px;display:flex;align-items:center;gap:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_fUseFlag" />
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.UseFlag"]' Style="cursor:pointer;" />
            </div>
            @if (_grpConfirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.CommonCode.ConfirmGrpDelete"].Value, _items.Count)</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _grpConfirmDelete = false' ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveGroupDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveGroupEdit" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _grpConfirmDelete = true; _modalErr = ""; }' Disabled="_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 코드 항목 등록 모달 ──────────────────────────────────────────────── *@
@if (_modal == "item-create" && _selGroup is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:560px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.CommonCode.Item.Create"] — <span class="code" style="font-weight:400;font-size:.9em;">@_selGroup.GroupCode</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.CodeValue"]} {L["MD.CommonCode.Lbl.CodeValueHint"]}")' /><br />
                    <RadzenTextBox Value="@_fCodeValue" ValueChanged="OnCodeValueInput"
                                   Placeholder="예: SCRAP" MaxLength="20" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.CodeId"]} {L["MD.CommonCode.Lbl.CodeIdHint"]}")' /><br />
                    <RadzenTextBox @bind-Value="_fCodeId" MaxLength="24" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeName"]' /><br />
                    <RadzenTextBox @bind-Value="_fCodeName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeNameEn"]' /><br />
                    <RadzenTextBox @bind-Value="_fCodeNameEn" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.ParentCode"]} {L["MD.CommonCode.Lbl.ParentCodeOpt"]}")' /><br />
                    <RadzenDropDown @bind-Value="_fParentCodeId"
                                    Data="@(_items.Select(p => new DropDownItem { Value = p.CodeID, Text = $"[{p.CodeValue}] {p.CodeName}" }))"
                                    TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["MD.CommonCode.Opt.None"]' Style="width:100%;" />
                </div>
            </div>
            <div style="display:grid;grid-template-columns:80px 1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.SortOrder"]' /><br />
                    <RadzenNumeric TValue="int" @bind-Value="_fSortOrder" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Attr1"]' /><br />
                    <RadzenTextBox @bind-Value="_fAttribute1" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.Description"]' /><br />
                    <RadzenTextBox @bind-Value="_fItemDescription" Style="width:100%;" autocomplete="off" />
                </div>
            </div>
            <div style="margin-top:8px;display:flex;align-items:center;gap:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_fItemUseFlag" />
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.UseFlag"]' Style="cursor:pointer;" />
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveItemCreate" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 코드 항목 수정/삭제 모달 ────────────────────────────────────────── *@
@if (_modal == "item-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:560px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.CommonCode.Item.Edit"] — <span class="code" style="font-weight:400;font-size:.9em;">@_fCodeId</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeValue"]' /><br />
                    <RadzenTextBox @bind-Value="_fCodeValue" MaxLength="20" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeId"]' /><br />
                    <RadzenTextBox Value="@_fCodeId" Disabled="true" Style="width:100%;opacity:.6;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeName"]' /><br />
                    <RadzenTextBox @bind-Value="_fCodeName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeNameEn"]' /><br />
                    <RadzenTextBox @bind-Value="_fCodeNameEn" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.ParentCode"]} {L["MD.CommonCode.Lbl.ParentCodeOpt"]}")' /><br />
                    <RadzenDropDown @bind-Value="_fParentCodeId"
                                    Data="@(_items.Where(i => i.CodeID != _fCodeId).Select(p => new DropDownItem { Value = p.CodeID, Text = $"[{p.CodeValue}] {p.CodeName}" }))"
                                    TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["MD.CommonCode.Opt.None"]' Style="width:100%;" />
                </div>
            </div>
            <div style="display:grid;grid-template-columns:80px 1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.SortOrder"]' /><br />
                    <RadzenNumeric TValue="int" @bind-Value="_fSortOrder" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Attr1"]' /><br />
                    <RadzenTextBox @bind-Value="_fAttribute1" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.Description"]' /><br />
                    <RadzenTextBox @bind-Value="_fItemDescription" Style="width:100%;" autocomplete="off" />
                </div>
            </div>
            <div style="margin-top:8px;display:flex;align-items:center;gap:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_fItemUseFlag" />
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.UseFlag"]' Style="cursor:pointer;" />
            </div>
            @if (_itemConfirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.CommonCode.ConfirmItemDelete"].Value, _fCodeId, _fCodeName)</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _itemConfirmDelete = false' ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveItemDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveItemEdit" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _itemConfirmDelete = true; _modalErr = ""; }' Disabled="_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.CodeGroupRow> _groups = new();
    List<MasterDataRepository.CodeItemRow>  _items  = new();
    MasterDataRepository.CodeGroupRow?      _selGroup;
    int[] _pageSizeOptions = { 15, 30, 50 };

    string _modal             = "";
    string _modalErr          = "";
    string _msg               = "";
    bool   _isErr, _busy, _bgDown;
    bool   _grpConfirmDelete, _itemConfirmDelete;
    bool   _canEdit;
    string _actor             = "system";

    string _fGroupCode   = "";
    string _fGroupName   = "";
    string _fGroupNameEn = "";
    string _fDescription = "";
    bool   _fUseFlag     = true;

    string  _fCodeId          = "";
    string  _fCodeValue       = "";
    string  _fCodeName        = "";
    string  _fCodeNameEn      = "";
    string? _fParentCodeId;
    int     _fSortOrder       = 0;
    string  _fAttribute1      = "";
    bool    _fItemUseFlag     = true;
    string  _fItemDescription = "";

    void GrpRowRender(RowRenderEventArgs<MasterDataRepository.CodeGroupRow> args)
    {
        var cls = "ames-row-link";
        if (_selGroup?.GroupCode == args.Data?.GroupCode) cls += " ames-row-selected";
        args.Attributes["class"] = cls;
    }

    void ItemRowRender(RowRenderEventArgs<MasterDataRepository.CodeItemRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OnGroupRowSelect(MasterDataRepository.CodeGroupRow g)
    {
        if (_canEdit) OpenGroupEdit(g);
        else SelectGroup(g);
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor   = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/ql/common-code");
        LoadGroups();
    }

    void LoadGroups() { try { _groups = MD.ListCodeGroups(); } catch { _groups = new(); } }

    void LoadItems()
    {
        if (_selGroup is null) { _items = new(); return; }
        try { _items = MD.ListCodeItems(_selGroup.GroupCode); } catch { _items = new(); }
    }

    void SelectGroup(MasterDataRepository.CodeGroupRow g) { _selGroup = g; LoadItems(); }

    void CloseModal() { _modal = ""; _modalErr = ""; _grpConfirmDelete = false; _itemConfirmDelete = false; }
    void OnBgDown()  => _bgDown = true;
    void OnBgClick() { if (_bgDown) CloseModal(); _bgDown = false; }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    void OpenGroupCreate()
    {
        _fGroupCode = ""; _fGroupName = ""; _fGroupNameEn = "";
        _fDescription = ""; _fUseFlag = true;
        _grpConfirmDelete = false; _modalErr = "";
        _modal = "grp-create";
    }

    void OpenGroupEdit(MasterDataRepository.CodeGroupRow g)
    {
        _fGroupCode   = g.GroupCode;
        _fGroupName   = g.GroupName   ?? "";
        _fGroupNameEn = g.GroupNameEn ?? "";
        _fDescription = g.Description ?? "";
        _fUseFlag     = g.UseFlag;
        _grpConfirmDelete = false; _modalErr = "";
        if (_selGroup?.GroupCode != g.GroupCode)
            try { _items = MD.ListCodeItems(g.GroupCode); } catch { _items = new(); }
        _modal = "grp-edit";
    }

    void SaveGroupCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fGroupCode)) { _modalErr = L["Err.GroupCodeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fGroupName)) { _modalErr = L["Err.GroupNameRequired"]; return; }
        _busy = true;
        try
        {
            var code = _fGroupCode.Trim().ToUpper();
            if (MD.CodeGroupExists(code)) { _modalErr = $"'{code}' {L["Err.AlreadyExists"]}"; return; }
            MD.InsertCodeGroup(code, _fGroupName.Trim(), N(_fGroupNameEn), N(_fDescription), _fUseFlag, _actor);
            LoadGroups(); CloseModal();
            ShowMsg($"{code} 그룹 {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveGroupEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fGroupName)) { _modalErr = L["Err.GroupNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateCodeGroup(_fGroupCode, _fGroupName.Trim(), N(_fGroupNameEn), N(_fDescription), _fUseFlag, _actor);
            LoadGroups();
            if (_selGroup?.GroupCode == _fGroupCode)
                _selGroup = _groups.FirstOrDefault(g => g.GroupCode == _fGroupCode);
            CloseModal();
            ShowMsg($"{_fGroupCode} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveGroupDelete()
    {
        _busy = true;
        try
        {
            foreach (var item in _items) MD.DeleteCodeItem(item.CodeID);
            MD.DeleteCodeGroup(_fGroupCode);
            if (_selGroup?.GroupCode == _fGroupCode) { _selGroup = null; _items = new(); }
            LoadGroups(); CloseModal();
            ShowMsg($"그룹 {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void OpenItemCreate()
    {
        int next = _items.Count > 0 ? (_items.Max(i => i.SortOrder ?? 0) + 10) : 10;
        _fCodeId = ""; _fCodeValue = ""; _fCodeName = ""; _fCodeNameEn = "";
        _fParentCodeId = null; _fSortOrder = next; _fAttribute1 = "";
        _fItemUseFlag = true; _fItemDescription = "";
        _itemConfirmDelete = false; _modalErr = "";
        _modal = "item-create";
    }

    void OnCodeValueInput(string? v)
    {
        _fCodeValue = v ?? "";
        var s = _selGroup!.GroupCode + "_" + _fCodeValue.Trim().ToUpper();
        _fCodeId = s.Length <= 24 ? s : s[..24];
    }

    void OpenItemEdit(MasterDataRepository.CodeItemRow item)
    {
        if (!_canEdit) return;
        _fCodeId          = item.CodeID;
        _fCodeValue       = item.CodeValue    ?? "";
        _fCodeName        = item.CodeName     ?? "";
        _fCodeNameEn      = item.CodeNameEn   ?? "";
        _fParentCodeId    = item.ParentCodeID;
        _fSortOrder       = item.SortOrder    ?? 0;
        _fAttribute1      = item.Attribute1   ?? "";
        _fItemUseFlag     = item.UseFlag;
        _fItemDescription = item.Description  ?? "";
        _itemConfirmDelete = false; _modalErr = "";
        _modal = "item-edit";
    }

    void SaveItemCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fCodeValue)) { _modalErr = L["Err.CodeValueRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fCodeName))  { _modalErr = L["Err.CodeNameRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fCodeId))    { _modalErr = L["Err.CodeIdRequired"]; return; }
        if (_fCodeId.Length > 24)                   { _modalErr = L["Err.CodeIdMax24"]; return; }
        _busy = true;
        try
        {
            var id = _fCodeId.Trim().ToUpper();
            if (MD.CodeItemExists(id)) { _modalErr = $"CodeID '{id}' {L["Err.AlreadyExists"]}"; return; }
            MD.InsertCodeItem(id, _selGroup!.GroupCode, _fCodeValue.Trim(), _fCodeName.Trim(),
                N(_fCodeNameEn), _fSortOrder, N(_fAttribute1), _fItemUseFlag, N(_fItemDescription), _actor,
                _fParentCodeId);
            LoadItems(); CloseModal();
            ShowMsg($"{id} 항목 {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveItemEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fCodeValue)) { _modalErr = L["Err.CodeValueRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fCodeName))  { _modalErr = L["Err.CodeNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateCodeItem(_fCodeId, _fCodeValue.Trim(), _fCodeName.Trim(),
                N(_fCodeNameEn), _fSortOrder, N(_fAttribute1), _fItemUseFlag, N(_fItemDescription), _actor,
                _fParentCodeId);
            LoadItems(); CloseModal();
            ShowMsg($"{_fCodeId} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveItemDelete()
    {
        _busy = true;
        try
        {
            MD.DeleteCodeItem(_fCodeId);
            LoadItems(); CloseModal();
            ShowMsg($"{_fCodeId} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    static string? N(string? s) => string.IsNullOrWhiteSpace(s) ? null : s?.Trim();

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}