@page "/md/ql/common-code"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-030 @L["MD.CommonCode.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-030" TitleKey="MD.CommonCode.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.CommonCode.Kpi.TotalCodes"]</div>
        <div class="ames-kpi-v">@_ccKpi.TotalCodes</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["MD.CommonCode.Kpi.Active"]</div>
        <div class="ames-kpi-v">@_ccKpi.ActiveCodes</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.CommonCode.Kpi.CodeGroups"]</div>
        <div class="ames-kpi-v">@_groups.Count</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.CommonCode.Kpi.SelInactive"]</div>
        <div class="ames-kpi-v">@(_selGroup is null ? "—" : _items.Count(i => !i.UseFlag))</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div style="display:flex;gap:16px;height:calc(100vh - 200px);">

    @* ── 좌: 코드 그룹 ────────────────────────────────────────────────── *@
    <div style="flex:0 0 480px;display:flex;flex-direction:column;min-height:0;">
        <div class="ames-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;margin-bottom:0;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                <span style="font-weight:600;font-size:1em;">@L["MD.CommonCode.GrpHeader"]</span>
                @if (_canEdit)
                {
                    <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenGroupCreate" class="ames-rz-btn" />
                }
            </div>
            <div style="flex:1;min-height:0;overflow:hidden;">
            <RadzenDataGrid @ref="_grpGrid" TItem="MasterDataRepository.CodeGroupRow" Data="_groups" AllowPaging="true" PageSize="GrpPageSize" PagerHorizontalAlign="HorizontalAlign.Center"
                            ShowPagingSummary="false" Page="OnGrpPage" RowRender="GrpRowRender" RowSelect="OnGroupRowSelect" Class="ames-rz-grid">
                <Columns>
                    <RadzenDataGridColumn Property="GroupCode" Title='@L["Col.GroupCode"]' Width="160px">
                        <Template Context="g"><span class="code">@g.GroupCode</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="GroupName" Title='@L["Col.GroupName"]'>
                        <Template Context="g">@MasterDataRepository.LocalName(g.GroupName, g.GroupNameEn)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="UseFlag" Title='@L["Col.Active"]' Width="60px" TextAlign="TextAlign.Center">
                        <Template Context="g">
                            <span class="pill @(g.UseFlag ? "ok" : "bad")">@(g.UseFlag ? "Y" : "N")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="52px" TextAlign="TextAlign.Center">
                        <Template Context="g">
                            <div @onclick:stopPropagation>
                                <RadzenButton ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Text="▶" Click="() => SelectGroup(g)" title='@L["MD.CommonCode.Title.ViewItems"]' class="ames-rz-btn" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            </div>
        </div>
    </div>

    @* ── 우: 코드 항목 ────────────────────────────────────────────────── *@
    <div style="flex:1;min-width:0;display:flex;flex-direction:column;min-height:0;">
        <div class="ames-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;margin-bottom:0;">
            @if (_selGroup is null)
            {
                <div style="flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;">
                    <div style="font-size:2.4em;opacity:.15;">🏷️</div>
                    <div class="dim" style="font-size:.9em;">@L["MD.CommonCode.ItemHint"]</div>
                </div>
            }
            else
            {
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                    <span style="font-weight:600;font-size:1em;">
                        <span class="code" style="font-size:.9em;margin-right:6px;">@_selGroup.GroupCode</span>
                        @MasterDataRepository.LocalName(_selGroup.GroupName, _selGroup.GroupNameEn)
                        <span class="dim" style="font-weight:400;margin-left:6px;">@string.Format(L["MD.CommonCode.ItemCount"].Value, _items.Count)</span>
                    </span>

                    @if (_canEdit)
                    {
                        <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenItemCreate" class="ames-rz-btn" />
                    }
                </div>
                <div style="flex:1;min-height:0;overflow:auto;">
                <RadzenDataGrid TItem="MasterDataRepository.CodeItemRow" Data="_items" AllowPaging="false"
                                RowRender="ItemRowRender" RowSelect="OpenItemEdit" Class="ames-rz-grid">
                    <Columns>
                        <RadzenDataGridColumn Property="SortOrder" Title='@L["Col.Seq"]' Width="60px" TextAlign="TextAlign.Right">
                            <Template Context="i">@i.SortOrder</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="CodeValue" Title='@L["Col.CodeValue"]' Width="120px">
                            <Template Context="i"><span class="code">@i.CodeValue</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="CodeName" Title='@L["MD.CommonCode.Lbl.CodeName"]' />
                        <RadzenDataGridColumn Property="CodeNameEn" Title='@L["MD.CommonCode.Lbl.CodeNameEn"]'>
                            <Template Context="i"><span class="dim">@i.CodeNameEn</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="Attribute1" Title='@L["Col.Attr1"]' Width="100px">
                            <Template Context="i"><span class="dim">@i.Attribute1</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="UseFlag" Title='@L["Col.Active"]' Width="60px" TextAlign="TextAlign.Center">
                            <Template Context="i">
                                <span class="pill @(i.UseFlag ? "ok" : "bad")">@(i.UseFlag ? "Y" : "N")</span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                </div>
            }
        </div>
    </div>
</div>

@* ── 코드 그룹 등록 모달 ──────────────────────────────────────────────── *@
@if (_modal == "grp-create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.CommonCode.Grp.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.GroupCode"]} {L["MD.CommonCode.Lbl.GroupCodeHint"]}")' class="ames-rz-modal-label" Component="GrpCreateTextBoxGroupCode" />
                <RadzenTextBox Name="GrpCreateTextBoxGroupCode" @bind-Value="_fGroup.GroupCode" Placeholder="DEFECT_TYPE" MaxLength="20" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.GroupName"]' class="ames-rz-modal-label" Component="GrpCreateTextBoxGroupName" />
                <RadzenTextBox Name="GrpCreateTextBoxGroupName" @bind-Value="_fGroup.GroupName" Placeholder='@L["MD.CommonCode.Ph.GroupName"]' InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.GroupNameEn"]' class="ames-rz-modal-label" Component="GrpCreateTextBoxGroupNameEn" />
                <RadzenTextBox Name="GrpCreateTextBoxGroupNameEn" @bind-Value="_fGroup.GroupNameEn" Placeholder="Defect Type" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.Description"]' />
                    <RadzenTextBox @bind-Value="_fGroup.Description" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_fGroup.UseFlag" Name="GrpCreateChkUse" />
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.UseFlag"]' Component="GrpCreateChkUse" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveGroupCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 코드 그룹 수정/삭제 모달 ────────────────────────────────────────── *@
@if (_modal == "grp-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.CommonCode.Grp.Edit"] — <span class="code" style="font-weight:400;font-size:.9em;">@_fGroup.GroupCode</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.GroupName"]' class="ames-rz-modal-label" Component="GrpEditTextBoxGroupName" />
                <RadzenTextBox Name="GrpEditTextBoxGroupName" @bind-Value="_fGroup.GroupName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.GroupNameEn"]' class="ames-rz-modal-label" Component="GrpEditTextBoxGroupNameEn" />
                <RadzenTextBox Name="GrpEditTextBoxGroupNameEn" @bind-Value="_fGroup.GroupNameEn" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.Description"]' />
                    <RadzenTextBox @bind-Value="_fGroup.Description" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_fGroup.UseFlag" Name="GrpEditChkUse" />
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.UseFlag"]' Component="GrpEditChkUse" style="cursor:pointer;" />
            </RadzenStack>

            @if (_grpConfirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.CommonCode.ConfirmGrpDelete"].Value, _items.Count)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _grpConfirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveGroupDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveGroupEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _grpConfirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 코드 항목 등록 모달 ──────────────────────────────────────────────── *@
@if (_modal == "item-create" && _selGroup is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.CommonCode.Item.Create"] — <span class="code" style="font-weight:400;font-size:.9em;">@_selGroup.GroupCode</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.CodeValue"]} {L["MD.CommonCode.Lbl.CodeValueHint"]}")' class="ames-rz-modal-label" Component="ItemCreateTextBoxCodeValue" />
                <RadzenTextBox Name="ItemCreateTextBoxCodeValue" Value="@_fItem.CodeValue" ValueChanged="OnCodeValueInput" Immediate="true" Placeholder="SCRAP" MaxLength="20" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.CodeId"]} {L["MD.CommonCode.Lbl.CodeIdHint"]}")' class="ames-rz-modal-label" Component="ItemCreateTextBoxCodeId" />
                <RadzenTextBox Name="ItemCreateTextBoxCodeId" Value="@_fItem.CodeId" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.CodeName"]} *")' class="ames-rz-modal-label" Component="ItemCreateTextBoxCodeName" />
                <RadzenTextBox Name="ItemCreateTextBoxCodeName" @bind-Value="_fItem.CodeName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeNameEn"]' class="ames-rz-modal-label" Component="ItemCreateTextBoxCodeNameEn" />
                <RadzenTextBox Name="ItemCreateTextBoxCodeNameEn" @bind-Value="_fItem.CodeNameEn" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.ParentCode"]} {L["MD.CommonCode.Lbl.ParentCodeOpt"]}")' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_fItem.ParentCodeId" Data="@(_items.Select(p => new DropDownItem { Value = p.CodeID, Text = $"[{p.CodeValue}] {p.CodeName}" }))" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["MD.CommonCode.Opt.None"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.SortOrder"]' />
                    <RadzenNumeric TValue="int" @bind-Value="_fItem.SortOrder" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Attr1"]' />
                    <RadzenTextBox @bind-Value="_fItem.Attribute1" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.Description"]' />
                    <RadzenTextBox @bind-Value="_fItem.Description" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_fItem.UseFlag" Name="ItemCreateChkUse" />
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.UseFlag"]' Component="ItemCreateChkUse" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveItemCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 코드 항목 수정/삭제 모달 ────────────────────────────────────────── *@
@if (_modal == "item-edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.CommonCode.Item.Edit"] — <span class="code" style="font-weight:400;font-size:.9em;">@_fItem.CodeId</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeValue"]' class="ames-rz-modal-label" Component="ItemEditTextBoxCodeValue" />
                <RadzenTextBox Name="ItemEditTextBoxCodeValue" @bind-Value="_fItem.CodeValue" MaxLength="20" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeId"]' class="ames-rz-modal-label" Component="ItemEditTextBoxCodeId" />
                <RadzenTextBox Name="ItemEditTextBoxCodeId" Value="@_fItem.CodeId" Disabled="true" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.CodeName"]} *")' class="ames-rz-modal-label" Component="ItemEditTextBoxCodeName" />
                <RadzenTextBox Name="ItemEditTextBoxCodeName" @bind-Value="_fItem.CodeName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.CodeNameEn"]' class="ames-rz-modal-label" Component="ItemEditTextBoxCodeNameEn" />
                <RadzenTextBox Name="ItemEditTextBoxCodeNameEn" @bind-Value="_fItem.CodeNameEn" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@($"{L["MD.CommonCode.Lbl.ParentCode"]} {L["MD.CommonCode.Lbl.ParentCodeOpt"]}")' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_fItem.ParentCodeId" Data="@(_items.Where(i => i.CodeID != _fItem.CodeId).Select(p => new DropDownItem { Value = p.CodeID, Text = $"[{p.CodeValue}] {p.CodeName}" }))" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder='@L["MD.CommonCode.Opt.None"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.SortOrder"]' />
                    <RadzenNumeric TValue="int" @bind-Value="_fItem.SortOrder" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@L["Col.Attr1"]' />
                    <RadzenTextBox @bind-Value="_fItem.Attribute1" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text='@L["MD.CommonCode.Lbl.Description"]' />
                    <RadzenTextBox @bind-Value="_fItem.Description" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_fItem.UseFlag" Name="ItemEditChkUse" />
                <RadzenLabel Text='@L["MD.CommonCode.Lbl.UseFlag"]' Component="ItemEditChkUse" style="cursor:pointer;" />
            </RadzenStack>

            @if (_itemConfirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.CommonCode.ConfirmItemDelete"].Value, _fItem.CodeId, _fItem.CodeName)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _itemConfirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveItemDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveItemEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _itemConfirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    const int GrpPageSize = 15;

    List<MasterDataRepository.CodeGroupRow> _groups = new();
    List<MasterDataRepository.CodeItemRow>  _items  = new();
    MasterDataRepository.CodeGroupRow?      _selGroup;
    MasterDataRepository.CommonCodeKpiRow   _ccKpi = new(0, 0);

    RadzenDataGrid<MasterDataRepository.CodeGroupRow>? _grpGrid;
    int _grpPage;

    string _modal    = "", _modalErr = "", _msg = "";
    bool   _isErr, _busy, _bgDown;
    bool   _grpConfirmDelete, _itemConfirmDelete;
    bool   _canEdit;
    string _actor    = "system";

    GroupFormModel _fGroup = new();
    ItemFormModel _fItem = new();

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor   = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/ql/common-code");
        LoadGroups();
    }

    void LoadGroups() { try { _groups = MD.ListCodeGroups(); } catch { _groups = new(); } try { _ccKpi = MD.CommonCodeKpi(); } catch { } }

    void OnGrpPage(PagerEventArgs args) => _grpPage = args.PageIndex;

    // 등록/수정/삭제 후 그룹 목록을 다시 읽되, 사용자가 보던 페이지를 유지한다.
    async Task ReloadGroupsKeepPage()
    {
        LoadGroups();
        await InvokeAsync(StateHasChanged);
        if (_grpGrid is not null)
        {
            int pages  = Math.Max(1, (int)Math.Ceiling(_groups.Count / (double)GrpPageSize));
            int target = Math.Min(_grpPage, pages - 1);
            await _grpGrid.GoToPage(target);
        }
    }

    void LoadItems()
    {
        if (_selGroup is null) { _items = new(); return; }
        try { _items = MD.ListCodeItems(_selGroup.GroupCode); } catch { _items = new(); }
        try { _ccKpi = MD.CommonCodeKpi(); } catch { }   // 코드 항목 증감/활성 변경 반영
    }

    void SelectGroup(MasterDataRepository.CodeGroupRow g) { _selGroup = g; LoadItems(); }

    void GrpRowRender(RowRenderEventArgs<MasterDataRepository.CodeGroupRow> args)
    {
        var cls = "ames-row-link";
        if (_selGroup?.GroupCode == args.Data?.GroupCode) cls += " ames-row-selected";
        args.Attributes["class"] = cls;
    }

    void ItemRowRender(RowRenderEventArgs<MasterDataRepository.CodeItemRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OnGroupRowSelect(MasterDataRepository.CodeGroupRow g)
    {
        if (_canEdit) OpenGroupEdit(g);
        else SelectGroup(g);
    }

    void CloseModal() { _modal = ""; _modalErr = ""; _grpConfirmDelete = false; _itemConfirmDelete = false; }

    void OnBgDown()  => _bgDown = true;
    void OnBgClick() { if (_bgDown) CloseModal(); _bgDown = false; }

    void OpenGroupCreate()
    {
        _fGroup = new();
        _grpConfirmDelete = false; _modalErr = "";
        _modal = "grp-create";
    }

    void OpenGroupEdit(MasterDataRepository.CodeGroupRow g)
    {
        _fGroup = new()
        {
            GroupCode   = g.GroupCode,
            GroupName   = g.GroupName   ?? "",
            GroupNameEn = g.GroupNameEn ?? "",
            Description = g.Description ?? "",
            UseFlag     = g.UseFlag,
        };
        _grpConfirmDelete = false; _modalErr = "";
        if (_selGroup?.GroupCode != g.GroupCode)
            try { _items = MD.ListCodeItems(g.GroupCode); } catch { _items = new(); }
        _modal = "grp-edit";
    }

    async Task SaveGroupCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fGroup.GroupCode)) { _modalErr = L["Err.GroupCodeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fGroup.GroupName)) { _modalErr = L["Err.GroupNameRequired"]; return; }
        _busy = true;
        try
        {
            var code = _fGroup.GroupCode.Trim().ToUpper();
            if (MD.CodeGroupExists(code)) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], code); return; }
            MD.InsertCodeGroup(code, _fGroup.GroupName.Trim(), NE(_fGroup.GroupNameEn), NE(_fGroup.Description), _fGroup.UseFlag, _actor);
            CloseModal();
            await ReloadGroupsKeepPage();
            ShowMsg($"{code} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveGroupEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fGroup.GroupName)) { _modalErr = L["Err.GroupNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateCodeGroup(_fGroup.GroupCode, _fGroup.GroupName.Trim(), NE(_fGroup.GroupNameEn), NE(_fGroup.Description), _fGroup.UseFlag, _actor);
            CloseModal();
            await ReloadGroupsKeepPage();
            if (_selGroup?.GroupCode == _fGroup.GroupCode)
                _selGroup = _groups.FirstOrDefault(g => g.GroupCode == _fGroup.GroupCode);
            ShowMsg($"{_fGroup.GroupCode} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveGroupDelete()
    {
        _busy = true;
        try
        {
            foreach (var item in _items) MD.DeleteCodeItem(item.CodeID);
            MD.DeleteCodeGroup(_fGroup.GroupCode);
            if (_selGroup?.GroupCode == _fGroup.GroupCode) { _selGroup = null; _items = new(); }
            CloseModal();
            await ReloadGroupsKeepPage();
            ShowMsg($"{L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void OpenItemCreate()
    {
        int next = _items.Count > 0 ? (_items.Max(i => i.SortOrder ?? 0) + 10) : 10;
        _fItem = new() { SortOrder = next };
        _itemConfirmDelete = false; _modalErr = "";
        _modal = "item-create";
    }

    void OnCodeValueInput(string? v)
    {
        _fItem.CodeValue = v ?? "";
        var s = _selGroup!.GroupCode + "_" + _fItem.CodeValue.Trim().ToUpper();
        _fItem.CodeId = s.Length <= 41 ? s : s[..41];
    }

    void OpenItemEdit(MasterDataRepository.CodeItemRow item)
    {
        if (!_canEdit) return;
        _fItem = new()
        {
            CodeId       = item.CodeID,
            CodeValue    = item.CodeValue    ?? "",
            CodeName     = item.CodeName     ?? "",
            CodeNameEn   = item.CodeNameEn   ?? "",
            ParentCodeId = item.ParentCodeID,
            SortOrder    = item.SortOrder    ?? 0,
            Attribute1   = item.Attribute1   ?? "",
            UseFlag      = item.UseFlag,
            Description  = item.Description  ?? "",
        };
        _itemConfirmDelete = false; _modalErr = "";
        _modal = "item-edit";
    }

    void SaveItemCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fItem.CodeValue)) { _modalErr = L["Err.CodeValueRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fItem.CodeName))  { _modalErr = L["Err.CodeNameRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fItem.CodeId))    { _modalErr = L["Err.CodeIdRequired"]; return; }
        if (_fItem.CodeId.Length > 41)                   { _modalErr = L["Err.CodeIdMax41"]; return; }
        _busy = true;
        try
        {
            var id = _fItem.CodeId.Trim().ToUpper();
            if (MD.CodeItemExists(id)) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], id); return; }
            MD.InsertCodeItem(id, _selGroup!.GroupCode, _fItem.CodeValue.Trim(), _fItem.CodeName.Trim(),
                NE(_fItem.CodeNameEn), _fItem.SortOrder, NE(_fItem.Attribute1), _fItem.UseFlag, NE(_fItem.Description), _actor,
                _fItem.ParentCodeId);
            LoadItems(); CloseModal();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveItemEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_fItem.CodeValue)) { _modalErr = L["Err.CodeValueRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_fItem.CodeName))  { _modalErr = L["Err.CodeNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateCodeItem(_fItem.CodeId, _fItem.CodeValue.Trim(), _fItem.CodeName.Trim(),
                NE(_fItem.CodeNameEn), _fItem.SortOrder, NE(_fItem.Attribute1), _fItem.UseFlag, NE(_fItem.Description), _actor,
                _fItem.ParentCodeId);
            LoadItems(); CloseModal();
            ShowMsg($"{_fItem.CodeId} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveItemDelete()
    {
        _busy = true;
        try
        {
            MD.DeleteCodeItem(_fItem.CodeId);
            LoadItems(); CloseModal();
            ShowMsg($"{_fItem.CodeId} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s?.Trim();

    class GroupFormModel {
        public string GroupCode   { get; set; } = "";
        public string GroupName   { get; set; } = "";
        public string GroupNameEn { get; set; } = "";
        public string Description { get; set; } = "";
        public bool   UseFlag     { get; set; } = true;
    }

    class ItemFormModel {
        public string  CodeId       { get; set; } = "";
        public string  CodeValue    { get; set; } = "";
        public string  CodeName     { get; set; } = "";
        public string  CodeNameEn   { get; set; } = "";
        public string? ParentCodeId { get; set; }
        public int     SortOrder    { get; set; } = 0;
        public string  Attribute1   { get; set; } = "";
        public bool    UseFlag      { get; set; } = true;
        public string  Description  { get; set; } = "";
    }
}