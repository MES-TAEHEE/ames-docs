@page "/md/ql/defect-code"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.DefectCode.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-012" TitleKey="MD.DefectCode.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.DefectCode.Kpi.Pareto"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ParetoFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.ProcessCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.DefectCode.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:160px;padding:4px 8px;"
                   placeholder='@L["MD.DefectCode.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Category"]</span>
            <select class="ames-input" style="width:120px;" @bind="_fCategory">
                <option value="">@L["Filter.AllCategories"]</option>
                @foreach (var c in _allRows.Select(r => r.DefectCategory).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@c">@c</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Process"]</span>
            <select class="ames-input" style="width:110px;" @bind="_fProcess">
                <option value="">@L["Filter.AllProcesses"]</option>
                @foreach (var p in _allRows.Select(r => r.ProcessCode).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@p">@p</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:100px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _statusCodes.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">@(MasterDataRepository.LocalName(s))</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.DefectCode.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.DefectCode"]</th><th>@L["Col.DefectName"]</th><th>@L["Col.DefectNameEn"]</th>
                    <th>@L["Col.ProcessName"]</th><th>@L["Col.Category"]</th><th>@L["Col.Severity"]</th><th>@L["Col.DefaultAction"]</th>
                    <th style="text-align:center;">@L["Col.Pareto"]</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.DefectCode</td>
                        <td>@(r.DefectName ?? "—")</td>
                        <td class="dim">@(r.DefectNameEn ?? "—")</td>
                        <td class="dim">@(r.ProcessCode ?? "—")</td>
                        <td><span class="pill">@(r.DefectCategory ?? "—")</span></td>
                        <td>
                            @if (r.SeverityLevel is not null)
                            {
                                var sc     = r.SeverityLevel switch { "CRITICAL" => "bad", "MAJOR" => "warn", _ => "ok" };
                                var svLabel = _severityCodes.FirstOrDefault(s => s.CodeValue == r.SeverityLevel) is { } _svLf ? MasterDataRepository.LocalName(_svLf) : r.SeverityLevel;
                                <span class="pill @sc">@svLabel</span>
                            }
                            else { <span class="dim">—</span> }
                        </td>
                        <td class="dim">@(r.DispositionDefault ?? "—")</td>
                        <td style="text-align:center;">
                            @if (r.ParetoFlag) { <span class="pill ok">Y</span> }
                            else { <span class="dim">—</span> }
                        </td>
                        <td>
                            @{
                                var stCss  = r.Status == "ACTIVE" ? "ok" : "bad";
                                var stLabel = _statusCodes.FirstOrDefault(s => s.CodeValue == r.Status) is { } _stLf ? MasterDataRepository.LocalName(_stLf) : r.Status;
                            }
                            <span class="pill @stCss">@(stLabel ?? "—")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.DefectCode.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.DefectCode"] * <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: DC-INJ-001)</span></label>
            <input class="ames-input" @bind="_f.DefectCode" placeholder="DC-INJ-001" autocomplete="off" />

            <label>@L["Col.DefectName"] *</label>
            <input class="ames-input" @bind="_f.DefectName" placeholder='@L["MD.DefectCode.Ph.DefectName"]' autocomplete="off" />

            <label>@L["Col.DefectNameEn"]</label>
            <input class="ames-input" @bind="_f.DefectNameEn" placeholder="Gate Mark" autocomplete="off" />

            <label>@L["Col.ProcessCode"]</label>
            <input class="ames-input" @bind="_f.ProcessCode" placeholder="INJ, PNT 등" maxlength="10" autocomplete="off" />

            <label>@L["Col.Category"]</label>
            <input class="ames-input" @bind="_f.DefectCategory" placeholder="APPEARANCE, DIMENSION 등" maxlength="14" autocomplete="off" />

            <label>@L["Col.SeverityLevel"]</label>
            <select class="ames-input" @bind="_f.SeverityLevel">
                <option value="">@L["Opt.None"]</option>
                @foreach (var s in _severityCodes.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            <label>@L["Col.DispositionDefault"]</label>
            <input class="ames-input" @bind="_f.DispositionDefault" placeholder="REWORK, SCRAP 등" maxlength="10" autocomplete="off" />

            <label>@L["Col.DefaultCauseCode"]</label>
            <select class="ames-input" @bind="_f.DefaultCauseCode">
                <option value="">@L["Opt.None"]</option>
                @foreach (var rc in _rootCauses)
                {
                    <option value="@rc.CauseCode">[@rc.CauseCode] @(rc.CauseName ?? rc.CauseCode)</option>
                }
            </select>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ParetoFlag" />
                <span>@L["MD.DefectCode.Kpi.Pareto"]</span>
            </label>

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _statusCodes.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">@(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.DefectCode.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.DefectCode</span></div>

            <label>@L["Col.DefectName"] *</label>
            <input class="ames-input" @bind="_f.DefectName" autocomplete="off" />

            <label>@L["Col.DefectNameEn"]</label>
            <input class="ames-input" @bind="_f.DefectNameEn" autocomplete="off" />

            <label>@L["Col.ProcessCode"]</label>
            <input class="ames-input" @bind="_f.ProcessCode" maxlength="10" autocomplete="off" />

            <label>@L["Col.Category"]</label>
            <input class="ames-input" @bind="_f.DefectCategory" maxlength="14" autocomplete="off" />

            <label>@L["Col.SeverityLevel"]</label>
            <select class="ames-input" @bind="_f.SeverityLevel">
                <option value="">@L["Opt.None"]</option>
                @foreach (var s in _severityCodes.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            <label>@L["Col.DispositionDefault"]</label>
            <input class="ames-input" @bind="_f.DispositionDefault" maxlength="10" autocomplete="off" />

            <label>@L["Col.DefaultCauseCode"]</label>
            <select class="ames-input" @bind="_f.DefaultCauseCode">
                <option value="">@L["Opt.None"]</option>
                @foreach (var rc in _rootCauses)
                {
                    <option value="@rc.CauseCode">[@rc.CauseCode] @(rc.CauseName ?? rc.CauseCode)</option>
                }
            </select>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ParetoFlag" />
                <span>@L["MD.DefectCode.Kpi.Pareto"]</span>
            </label>

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _statusCodes.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">@(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Edit"])</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.DefectCodeRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.DefectCodeRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.DefectCodeRow? _sel;
    int _page = 0;
    const int _pageSize = 20;

    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow>    _severityCodes = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow>    _statusCodes   = new();
    List<AMES.Data.Repositories.MasterDataRepository.DefectCauseRow> _rootCauses    = new();
    string _fSearch = "", _fCategory = "", _fProcess = "", _fStatus = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/ql/defect-code");
        try { _severityCodes = Md.ListCodeItems("DEFECT_CODE_SEVERITY"); } catch { }
        try { _statusCodes   = Md.ListCodeItems("DEFECT_CODE_STATUS");   } catch { }
        try { _rootCauses    = Md.ListDefectCauses().Where(r => r.RootCauseFlag).OrderBy(r => r.CauseCode).ToList(); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListDefectCodes(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.DefectCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.DefectName   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.DefectNameEn ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fCategory) || r.DefectCategory == _fCategory) &&
        (string.IsNullOrEmpty(_fProcess)  || r.ProcessCode    == _fProcess) &&
        (string.IsNullOrEmpty(_fStatus)   || r.Status         == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.DefectCodeRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            DefectCode         = r.DefectCode,
            DefectName         = r.DefectName         ?? "",
            DefectNameEn       = r.DefectNameEn       ?? "",
            ProcessCode        = r.ProcessCode        ?? "",
            DefectCategory     = r.DefectCategory     ?? "",
            SeverityLevel      = r.SeverityLevel      ?? "",
            DispositionDefault = r.DispositionDefault ?? "",
            DefaultCauseCode   = r.DefaultCauseCode   ?? "",
            ParetoFlag         = r.ParetoFlag,
            Status             = r.Status             ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.DefectCode)) { _modalErr = L["Err.DefectCodeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.DefectName)) { _modalErr = L["Err.DefectNameRequired"]; return; }
        if (Md.DefectCodeExists(_f.DefectCode.Trim())) { _modalErr = $"불량코드 '{_f.DefectCode.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertDefectCode(_f.DefectCode.Trim(), _f.DefectName, NE(_f.DefectNameEn),
                NE(_f.ProcessCode), NE(_f.DefectCategory), NE(_f.SeverityLevel),
                NE(_f.DispositionDefault), NE(_f.DefaultCauseCode), _f.ParetoFlag,
                NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.DefectName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.DefectName)) { _modalErr = L["Err.DefectNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateDefectCode(_sel.DefectCode, _f.DefectName, NE(_f.DefectNameEn),
                NE(_f.ProcessCode), NE(_f.DefectCategory), NE(_f.SeverityLevel),
                NE(_f.DispositionDefault), NE(_f.DefaultCauseCode), _f.ParetoFlag,
                NE(_f.Status), _actor);
            var name = _f.DefectName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.DefectName ?? _sel.DefectCode;
            Md.DeleteDefectCode(_sel.DefectCode);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string DefectCode         { get; set; } = "";
        public string DefectName         { get; set; } = "";
        public string DefectNameEn       { get; set; } = "";
        public string ProcessCode        { get; set; } = "";
        public string DefectCategory     { get; set; } = "";
        public string SeverityLevel      { get; set; } = "";
        public string DispositionDefault { get; set; } = "";
        public string DefaultCauseCode   { get; set; } = "";
        public bool   ParetoFlag         { get; set; }
        public string Status             { get; set; } = "Active";
    }
}
