@page "/md/ql/defect-code"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-012 @L["MD.DefectCode.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-012" TitleKey="MD.DefectCode.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.DefectCode.Kpi.Pareto"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ParetoFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.ProcessCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.DefectCode.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.DefectCode.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
            <RadzenLabel Text="@L["Col.Category"]" Component="DropDownCategory" />
            <RadzenDropDown Name="DropDownCategory" @bind-Value="_fCategory" Data="@CategoryFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Process"]" Component="DropDownProcess" />
            <RadzenDropDown Name="DropDownProcess" @bind-Value="_fProcess" Data="@ProcessFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.DefectCodeRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.DefectCode.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="DefectCode" Title="@L["Col.DefectCode"]" Width="140px">
                <Template Context="r"><span class="code">@r.DefectCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="DefectName" Title="@L["Col.DefectName"]" Width="160px" />
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="DefectNameEn" Title="@L["Col.DefectNameEn"]" Width="140px">
                <Template Context="r"><span class="dim">@(r.DefectNameEn ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="ProcessCode" Title="@L["Col.ProcessName"]" Width="85px">
                <Template Context="r"><span class="dim">@(r.ProcessCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="DefectCategory" Title="@L["Col.Category"]" Width="120px">
                <Template Context="r">
                    @if (r.DefectCategory != null) { <span class="pill">@r.DefectCategory</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="SeverityLevel" Title="@L["Col.Severity"]" Width="100px">
                <Template Context="r">
                    @if (r.SeverityLevel != null)
                    {
                        var svCss = r.SeverityLevel == "CRITICAL" ? "bad" : r.SeverityLevel == "MAJOR" ? "warn" : "ok";
                        var svEntry = _severityCodes.FirstOrDefault(s => s.CodeValue == r.SeverityLevel);
                        var svLabel = svEntry != null ? MasterDataRepository.LocalName(svEntry) : r.SeverityLevel;
                        <span class="pill @svCss">@svLabel</span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="DispositionDefault" Title="@L["Col.DefaultAction"]" Width="100px">
                <Template Context="r"><span class="dim">@(r.DispositionDefault ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="ParetoFlag" Title="@L["Col.Pareto"]" Width="75px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.ParetoFlag) { <span class="pill ok">Y</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.DefectCodeRow" Property="Status" Title="@L["Col.Status"]" Width="95px">
                <Template Context="r">
                    @{ var stEntry = _statusCodes.FirstOrDefault(s => s.CodeValue == r.Status); var stCss = r.Status == "ACTIVE" || r.Status == "Active" ? "ok" : "bad"; var stLabel = stEntry != null ? MasterDataRepository.LocalName(stEntry) : r.Status; }
                    <span class="pill @stCss">@(stLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.DefectCode.Title"] — @L["Modal.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.DefectCode"]} * (예: DC-INJ-001)")' /><br />
                    <RadzenTextBox @bind-Value="_f.DefectCode" Placeholder="DC-INJ-001" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.DefectName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.DefectName" Placeholder="@L["MD.DefectCode.Ph.DefectName"]" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.DefectNameEn"]" /><br />
                    <RadzenTextBox @bind-Value="_f.DefectNameEn" Placeholder="Gate Mark" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ProcessCode"]" /><br />
                    <RadzenTextBox @bind-Value="_f.ProcessCode" Placeholder="INJ" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Category"]" /><br />
                    <RadzenTextBox @bind-Value="_f.DefectCategory" Placeholder="APPEARANCE" MaxLength="14" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.SeverityLevel"]" /><br />
                    <RadzenDropDown @bind-Value="_f.SeverityLevel" Data="SeverityOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.None"]" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.DispositionDefault"]" /><br />
                    <RadzenTextBox @bind-Value="_f.DispositionDefault" Placeholder="REWORK" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.DefaultCauseCode"]" /><br />
                    <RadzenDropDown @bind-Value="_f.DefaultCauseCode" Data="RootCauseOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.None"]" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2; display:flex; align-items:center; gap:8px;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ParetoFlag" />
                    <RadzenLabel Text="@L["MD.DefectCode.Kpi.Pareto"]" Style="cursor:pointer;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusModalOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" Style="width:100%;" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.DefectCode.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.DefectCode</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.DefectName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.DefectName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.DefectNameEn"]" /><br />
                    <RadzenTextBox @bind-Value="_f.DefectNameEn" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ProcessCode"]" /><br />
                    <RadzenTextBox @bind-Value="_f.ProcessCode" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Category"]" /><br />
                    <RadzenTextBox @bind-Value="_f.DefectCategory" MaxLength="14" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.SeverityLevel"]" /><br />
                    <RadzenDropDown @bind-Value="_f.SeverityLevel" Data="SeverityOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.None"]" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.DispositionDefault"]" /><br />
                    <RadzenTextBox @bind-Value="_f.DispositionDefault" MaxLength="10" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.DefaultCauseCode"]" /><br />
                    <RadzenDropDown @bind-Value="_f.DefaultCauseCode" Data="RootCauseOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.None"]" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2; display:flex; align-items:center; gap:8px;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ParetoFlag" />
                    <RadzenLabel Text="@L["MD.DefectCode.Kpi.Pareto"]" Style="cursor:pointer;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusModalOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" Style="width:100%;" />
                </div>
            </div>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.DefectCodeRow> _allRows = new();
    List<MasterDataRepository.DefectCodeRow> _rows = new();
    List<MasterDataRepository.CodeItemRow> _severityCodes = new();
    List<MasterDataRepository.CodeItemRow> _statusCodes = new();
    List<MasterDataRepository.DefectCauseRow> _rootCauses = new();
    MasterDataRepository.DefectCodeRow? _sel;

    string _fSearch = "";
    string? _fCategory, _fProcess, _fStatus;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> CategoryFilterOptions => _allRows.Select(r => r.DefectCategory).Where(x => x != null).Distinct().OrderBy(x => x).Select(c => new DropDownItem { Value = c!, Text = c! });
    IEnumerable<DropDownItem> ProcessFilterOptions => _allRows.Select(r => r.ProcessCode).Where(x => x != null).Distinct().OrderBy(x => x).Select(p => new DropDownItem { Value = p!, Text = p! });
    IEnumerable<DropDownItem> StatusFilterOptions => _statusCodes.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });
    IEnumerable<DropDownItem> StatusModalOptions => _statusCodes.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = MasterDataRepository.LocalName(s) });
    IEnumerable<DropDownItem> SeverityOptions => _severityCodes.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });
    IEnumerable<DropDownItem> RootCauseOptions => _rootCauses.Select(rc => new DropDownItem { Value = rc.CauseCode, Text = $"[{rc.CauseCode}] {rc.CauseName ?? rc.CauseCode}" });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/ql/defect-code");
        try { _severityCodes = MD.ListCodeItems("DEFECT_CODE_SEVERITY"); } catch { }
        try { _statusCodes   = MD.ListCodeItems("DEFECT_CODE_STATUS");   } catch { }
        try { _rootCauses    = MD.ListDefectCauses().Where(r => r.RootCauseFlag).OrderBy(r => r.CauseCode).ToList(); } catch { }
        Reload();
    }

    void Reload() { _allRows = MD.ListDefectCodes(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.DefectCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.DefectName   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.DefectNameEn ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fCategory == null || r.DefectCategory == _fCategory) &&
        (_fProcess  == null || r.ProcessCode    == _fProcess) &&
        (_fStatus   == null || r.Status         == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.DefectCodeRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.DefectCodeRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.DefectCodeRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            DefectCode         = r.DefectCode,
            DefectName         = r.DefectName         ?? "",
            DefectNameEn       = r.DefectNameEn       ?? "",
            ProcessCode        = r.ProcessCode        ?? "",
            DefectCategory     = r.DefectCategory     ?? "",
            SeverityLevel      = r.SeverityLevel,
            DispositionDefault = r.DispositionDefault ?? "",
            DefaultCauseCode   = r.DefaultCauseCode,
            ParetoFlag         = r.ParetoFlag,
            Status             = r.Status             ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.DefectCode)) { _modalErr = L["Err.DefectCodeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.DefectName)) { _modalErr = L["Err.DefectNameRequired"]; return; }
        if (MD.DefectCodeExists(_f.DefectCode.Trim())) { _modalErr = $"불량코드 '{_f.DefectCode.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            MD.InsertDefectCode(_f.DefectCode.Trim(), _f.DefectName, NE(_f.DefectNameEn),
                NE(_f.ProcessCode), NE(_f.DefectCategory), _f.SeverityLevel,
                NE(_f.DispositionDefault), _f.DefaultCauseCode, _f.ParetoFlag,
                NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.DefectName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.DefectName)) { _modalErr = L["Err.DefectNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateDefectCode(_sel.DefectCode, _f.DefectName, NE(_f.DefectNameEn),
                NE(_f.ProcessCode), NE(_f.DefectCategory), _f.SeverityLevel,
                NE(_f.DispositionDefault), _f.DefaultCauseCode, _f.ParetoFlag,
                NE(_f.Status), _actor);
            var name = _f.DefectName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.DefectName ?? _sel.DefectCode;
            MD.DeleteDefectCode(_sel.DefectCode);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string  DefectCode         { get; set; } = "";
        public string  DefectName         { get; set; } = "";
        public string  DefectNameEn       { get; set; } = "";
        public string  ProcessCode        { get; set; } = "";
        public string  DefectCategory     { get; set; } = "";
        public string? SeverityLevel      { get; set; }
        public string  DispositionDefault { get; set; } = "";
        public string? DefaultCauseCode   { get; set; }
        public bool    ParetoFlag         { get; set; }
        public string  Status             { get; set; } = "Active";
    }
}