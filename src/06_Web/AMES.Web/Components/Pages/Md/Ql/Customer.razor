@page "/md/ql/customer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Customer.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-010</div>
    <div class="ames-page-t">@L["MD.Customer.Title"]</div>
    <div class="ames-page-sub">@L["MD.Customer.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Customer.Kpi.EDI"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.EDIFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Customer.Kpi.Domestic"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Country == "KOR")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Customer.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:220px;padding:4px 8px;"
                   placeholder="@L["MD.Customer.Ph.Search"]" @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:110px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                <option>OEM</option><option>TIER1</option><option>TIER2</option><option>Direct</option>
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:100px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                <option>Active</option><option>Inactive</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Customer.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.CustomerId"]</th><th>@L["Col.Code"]</th><th>@L["Col.CustomerName"]</th><th>@L["Col.NameEn"]</th>
                    <th>@L["Col.Type"]</th><th>@L["Col.Country"]</th><th>@L["Col.Contact"]</th><th>@L["Col.Phone"]</th>
                    <th>@L["Col.EDI"]</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.CustomerID</td>
                        <td class="dim">@(r.CustomerCode ?? "—")</td>
                        <td>@(r.CustomerName ?? "—")</td>
                        <td class="dim">@(r.CustomerNameEn ?? "—")</td>
                        <td><span class="pill">@(r.CustomerType ?? "—")</span></td>
                        <td class="dim">@(r.Country ?? "—")</td>
                        <td>@(r.ContactPerson ?? "—")</td>
                        <td class="dim">@(r.ContactPhone ?? "—")</td>
                        <td>
                            @if (r.EDIFlag) { <span class="pill ok">EDI</span> }
                            else { <span class="dim">—</span> }
                        </td>
                        <td>
                            @if (r.Status == "Active") { <span class="pill ok">Active</span> }
                            else { <span class="pill bad">@(r.Status ?? "—")</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Customer.Modal.Create"]</div>

            <label>@L["MD.Customer.Lbl.CustomerCode"]</label>
            <input class="ames-input" @bind="_f.CustomerCode" placeholder="예: HYUNDAI" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.CustomerName"]</label>
            <input class="ames-input" @bind="_f.CustomerName" placeholder='@L["MD.Customer.Ph.CustomerName"]' autocomplete="off" />

            <label>@L["MD.Customer.Lbl.CustomerNameEn"]</label>
            <input class="ames-input" @bind="_f.CustomerNameEn" placeholder="Hyundai Motor Co." autocomplete="off" />

            <label>@L["MD.Customer.Lbl.CustomerType"]</label>
            <select class="ames-input" @bind="_f.CustomerType">
                <option value="">@L["Opt.Select"]</option>
                <option>OEM</option><option>TIER1</option><option>TIER2</option><option>Direct</option>
            </select>

            <label>@L["MD.Customer.Lbl.BizRegNo"]</label>
            <input class="ames-input" @bind="_f.BizRegNo" placeholder="000-00-00000" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.Country"]</label>
            <input class="ames-input" @bind="_f.Country" placeholder="KOR" maxlength="3" autocomplete="off" />

            <label>@L["Col.Contact"]</label>
            <input class="ames-input" @bind="_f.ContactPerson" autocomplete="off" />

            <label>@L["Col.Phone"]</label>
            <input class="ames-input" @bind="_f.ContactPhone" placeholder="02-0000-0000" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.Email"]</label>
            <input class="ames-input" @bind="_f.ContactEmail" placeholder="contact@customer.com" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.Currency"]</label>
            <input class="ames-input" @bind="_f.CurrencyCode" placeholder="KRW" maxlength="3" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.EDIFlag" />
                <span>@L["MD.Customer.Lbl.EDI"]</span>
            </label>

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option>Active</option><option>Inactive</option>
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Customer.Modal.Edit"] — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.CustomerID</span></div>

            <label>@L["MD.Customer.Lbl.CustomerCode"]</label>
            <input class="ames-input" @bind="_f.CustomerCode" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.CustomerName"]</label>
            <input class="ames-input" @bind="_f.CustomerName" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.CustomerNameEn"]</label>
            <input class="ames-input" @bind="_f.CustomerNameEn" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.CustomerType"]</label>
            <select class="ames-input" @bind="_f.CustomerType">
                <option value="">@L["Opt.Select"]</option>
                <option>OEM</option><option>TIER1</option><option>TIER2</option><option>Direct</option>
            </select>

            <label>@L["MD.Customer.Lbl.BizRegNo"]</label>
            <input class="ames-input" @bind="_f.BizRegNo" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.Country"]</label>
            <input class="ames-input" @bind="_f.Country" maxlength="3" autocomplete="off" />

            <label>@L["Col.Contact"]</label>
            <input class="ames-input" @bind="_f.ContactPerson" autocomplete="off" />

            <label>@L["Col.Phone"]</label>
            <input class="ames-input" @bind="_f.ContactPhone" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.Email"]</label>
            <input class="ames-input" @bind="_f.ContactEmail" autocomplete="off" />

            <label>@L["MD.Customer.Lbl.Currency"]</label>
            <input class="ames-input" @bind="_f.CurrencyCode" maxlength="3" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.EDIFlag" />
                <span>@L["MD.Customer.Lbl.EDI"]</span>
            </label>

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option>Active</option><option>Inactive</option>
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.CustomerRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.CustomerRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.CustomerRow? _sel;
    int _page = 0;
    const int _pageSize = 20;

    string _fSearch = "", _fType = "", _fStatus = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/ql/customer");
        Reload();
    }

    void Reload() { _allRows = Md.ListCustomers(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.CustomerCode   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CustomerName   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CustomerNameEn ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fType)   || r.CustomerType == _fType) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status       == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.CustomerRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            CustomerCode   = r.CustomerCode   ?? "",
            CustomerName   = r.CustomerName   ?? "",
            CustomerNameEn = r.CustomerNameEn ?? "",
            CustomerType   = r.CustomerType   ?? "",
            BizRegNo       = r.BizRegNo       ?? "",
            Country        = r.Country        ?? "",
            ContactPerson  = r.ContactPerson  ?? "",
            ContactPhone   = r.ContactPhone   ?? "",
            ContactEmail   = r.ContactEmail   ?? "",
            CurrencyCode   = r.CurrencyCode   ?? "",
            EDIFlag        = r.EDIFlag,
            Status         = r.Status         ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CustomerName)) { _modalErr = L["Err.CustomerNameRequired"]; return; }
        _busy = true;
        try
        {
            var newId = "C" + Guid.NewGuid().ToString("N")[..14].ToUpper();
            Md.InsertCustomer(newId, NE(_f.CustomerCode),
                _f.CustomerName, NE(_f.CustomerNameEn),
                NE(_f.CustomerType), NE(_f.BizRegNo),
                NE(_f.Country), NE(_f.ContactPerson),
                NE(_f.ContactPhone), NE(_f.ContactEmail),
                _f.EDIFlag, NE(_f.CurrencyCode), _f.Status, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.CustomerName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CustomerName)) { _modalErr = L["Err.CustomerNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateCustomer(_sel.CustomerID,
                NE(_f.CustomerCode), _f.CustomerName, NE(_f.CustomerNameEn),
                NE(_f.CustomerType), NE(_f.BizRegNo),
                NE(_f.Country), NE(_f.ContactPerson),
                NE(_f.ContactPhone), NE(_f.ContactEmail),
                _f.EDIFlag, NE(_f.CurrencyCode), _f.Status, _actor);
            var name = _f.CustomerName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.CustomerName ?? _sel.CustomerID;
            Md.DeleteCustomer(_sel.CustomerID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string CustomerCode   { get; set; } = "";
        public string CustomerName   { get; set; } = "";
        public string CustomerNameEn { get; set; } = "";
        public string CustomerType   { get; set; } = "";
        public string BizRegNo       { get; set; } = "";
        public string Country        { get; set; } = "KOR";
        public string ContactPerson  { get; set; } = "";
        public string ContactPhone   { get; set; } = "";
        public string ContactEmail   { get; set; } = "";
        public string CurrencyCode   { get; set; } = "KRW";
        public bool   EDIFlag        { get; set; } = false;
        public string Status         { get; set; } = "Active";
    }
}
