@page "/md/ql/customer"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-010 @L["MD.Customer.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-010" TitleKey="MD.Customer.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Customer.Kpi.EDI"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.EDIFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Customer.Kpi.Domestic"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Country == "KOR")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Customer.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Customer.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:220px;" />
            <RadzenLabel Text="@L["Col.Type"]" Component="DropDownType" />
            <RadzenDropDown Name="DropDownType" @bind-Value="_fType" Data="_typeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="_statusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:110px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.CustomerRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Customer.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="CustomerID" Title="@L["Col.CustomerId"]" Width="130px">
                <Template Context="r"><span class="code">@r.CustomerID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="CustomerCode" Title="@L["Col.Code"]" Width="110px">
                <Template Context="r"><span class="dim">@(r.CustomerCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="CustomerName" Title="@L["Col.CustomerName"]" />
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="CustomerNameEn" Title="@L["MD.Customer.Lbl.CustomerNameEn"]">
                <Template Context="r"><span class="dim">@(r.CustomerNameEn ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="CustomerType" Title="@L["Col.Type"]" Width="90px">
                <Template Context="r"><span class="pill">@(r.CustomerType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="Country" Title="@L["Col.Country"]" Width="75px">
                <Template Context="r"><span class="dim">@(r.Country ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="ContactPerson" Title="@L["Col.Contact"]" Width="110px">
                <Template Context="r">@(r.ContactPerson ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="ContactPhone" Title="@L["Col.Phone"]" Width="130px">
                <Template Context="r"><span class="dim">@(r.ContactPhone ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="EDIFlag" Title="@L["Col.EDI"]" Width="70px">
                <Template Context="r">
                    @if (r.EDIFlag) { <span class="pill ok">EDI</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.CustomerRow" Property="Status" Title="@L["Col.Status"]" Width="95px">
                <Template Context="r">
                    @if (r.Status == "Active") { <span class="pill ok">Active</span> }
                    else { <span class="pill bad">@(r.Status ?? "—")</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Customer.Title"] — @L["Modal.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.CustomerCode"]" /><br />
                    <RadzenTextBox @bind-Value="_f.CustomerCode" Placeholder="예: HYUNDAI" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.CustomerType"]" /><br />
                    <RadzenDropDown @bind-Value="_f.CustomerType" Data="_typeOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text="@L["MD.Customer.Lbl.CustomerName"]" /><br />
                    <RadzenTextBox @bind-Value="_f.CustomerName" Placeholder="@L["MD.Customer.Ph.CustomerName"]" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text="@L["MD.Customer.Lbl.CustomerNameEn"]" /><br />
                    <RadzenTextBox @bind-Value="_f.CustomerNameEn" Placeholder="Hyundai Motor Co." Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.BizRegNo"]" /><br />
                    <RadzenTextBox @bind-Value="_f.BizRegNo" Placeholder="000-00-00000" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.Country"]" /><br />
                    <RadzenTextBox @bind-Value="_f.Country" Placeholder="KOR" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Contact"]" /><br />
                    <RadzenTextBox @bind-Value="_f.ContactPerson" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Phone"]" /><br />
                    <RadzenTextBox @bind-Value="_f.ContactPhone" Placeholder="02-0000-0000" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.Email"]" /><br />
                    <RadzenTextBox @bind-Value="_f.ContactEmail" Placeholder="contact@customer.com" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.Currency"]" /><br />
                    <RadzenTextBox @bind-Value="_f.CurrencyCode" Placeholder="KRW" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" Style="width:100%;" />
                </div>
            </div>
            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.EDIFlag" />
                    <span>@L["MD.Customer.Lbl.EDI"]</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Customer.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.CustomerID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.CustomerCode"]" /><br />
                    <RadzenTextBox @bind-Value="_f.CustomerCode" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.CustomerType"]" /><br />
                    <RadzenDropDown @bind-Value="_f.CustomerType" Data="_typeOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text="@L["MD.Customer.Lbl.CustomerName"]" /><br />
                    <RadzenTextBox @bind-Value="_f.CustomerName" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text="@L["MD.Customer.Lbl.CustomerNameEn"]" /><br />
                    <RadzenTextBox @bind-Value="_f.CustomerNameEn" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.BizRegNo"]" /><br />
                    <RadzenTextBox @bind-Value="_f.BizRegNo" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.Country"]" /><br />
                    <RadzenTextBox @bind-Value="_f.Country" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Contact"]" /><br />
                    <RadzenTextBox @bind-Value="_f.ContactPerson" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Phone"]" /><br />
                    <RadzenTextBox @bind-Value="_f.ContactPhone" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.Email"]" /><br />
                    <RadzenTextBox @bind-Value="_f.ContactEmail" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Customer.Lbl.Currency"]" /><br />
                    <RadzenTextBox @bind-Value="_f.CurrencyCode" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" Style="width:100%;" />
                </div>
            </div>
            <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.EDIFlag" />
                    <span>@L["MD.Customer.Lbl.EDI"]</span>
                </label>
            </div>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.CustomerRow> _allRows = new();
    List<MasterDataRepository.CustomerRow> _rows    = new();
    MasterDataRepository.CustomerRow? _sel;

    string _fSearch = "";
    string? _fType, _fStatus;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    DropDownItem[] _typeOptions =
    {
        new() { Value = "OEM",    Text = "OEM"    },
        new() { Value = "TIER1",  Text = "TIER1"  },
        new() { Value = "TIER2",  Text = "TIER2"  },
        new() { Value = "Direct", Text = "Direct" },
    };
    DropDownItem[] _statusOptions =
    {
        new() { Value = "Active",   Text = "Active"   },
        new() { Value = "Inactive", Text = "Inactive" },
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/ql/customer");
        Reload();
    }

    void Reload() { _allRows = MD.ListCustomers(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.CustomerCode   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CustomerName   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CustomerNameEn ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fType   == null || r.CustomerType == _fType) &&
        (_fStatus == null || r.Status       == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.CustomerRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.CustomerRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.CustomerRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            CustomerCode   = r.CustomerCode   ?? "",
            CustomerName   = r.CustomerName   ?? "",
            CustomerNameEn = r.CustomerNameEn ?? "",
            CustomerType   = r.CustomerType,
            BizRegNo       = r.BizRegNo       ?? "",
            Country        = r.Country        ?? "",
            ContactPerson  = r.ContactPerson  ?? "",
            ContactPhone   = r.ContactPhone   ?? "",
            ContactEmail   = r.ContactEmail   ?? "",
            CurrencyCode   = r.CurrencyCode   ?? "",
            EDIFlag        = r.EDIFlag,
            Status         = r.Status         ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CustomerName)) { _modalErr = L["Err.CustomerNameRequired"]; return; }
        _busy = true;
        try
        {
            var newId = "C" + Guid.NewGuid().ToString("N")[..14].ToUpper();
            MD.InsertCustomer(newId, NE(_f.CustomerCode),
                _f.CustomerName, NE(_f.CustomerNameEn),
                _f.CustomerType, NE(_f.BizRegNo),
                NE(_f.Country), NE(_f.ContactPerson),
                NE(_f.ContactPhone), NE(_f.ContactEmail),
                _f.EDIFlag, NE(_f.CurrencyCode), _f.Status, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.CustomerName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CustomerName)) { _modalErr = L["Err.CustomerNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateCustomer(_sel.CustomerID,
                NE(_f.CustomerCode), _f.CustomerName, NE(_f.CustomerNameEn),
                _f.CustomerType, NE(_f.BizRegNo),
                NE(_f.Country), NE(_f.ContactPerson),
                NE(_f.ContactPhone), NE(_f.ContactEmail),
                _f.EDIFlag, NE(_f.CurrencyCode), _f.Status, _actor);
            var name = _f.CustomerName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.CustomerName ?? _sel.CustomerID;
            MD.DeleteCustomer(_sel.CustomerID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string  CustomerCode   { get; set; } = "";
        public string  CustomerName   { get; set; } = "";
        public string  CustomerNameEn { get; set; } = "";
        public string? CustomerType   { get; set; }
        public string  BizRegNo       { get; set; } = "";
        public string  Country        { get; set; } = "KOR";
        public string  ContactPerson  { get; set; } = "";
        public string  ContactPhone   { get; set; } = "";
        public string  ContactEmail   { get; set; } = "";
        public string  CurrencyCode   { get; set; } = "KRW";
        public bool    EDIFlag        { get; set; } = false;
        public string  Status         { get; set; } = "Active";
    }
}