@page "/md/ql/shipment-dest"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-011 @L["MD.ShipDest.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-011" TitleKey="MD.ShipDest.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.ShipDest.Kpi.Domestic"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Country == "KOR")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.ShipDest.Kpi.Export"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Country != null && r.Country != "KOR")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.ShipDest.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.ShipmentDest.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:180px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.ShipmentDestRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.ShipDest.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="ShipDestID" Title="@L["Col.ShipDestId"]" TextAlign="TextAlign.Center" Width="150px">
                <Template Context="r"><span class="code">@r.ShipDestID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="CustomerName" Title="@L["Col.Customer"]" TextAlign="TextAlign.Center" Width="150px">
                <Template Context="r">@(r.CustomerName ?? r.CustomerID ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="DestName" Title="@L["Col.ShipDestName"]" />
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="DestType" Title="@L["Col.Type"]" Width="200px">
                <Template Context="r">
                    @if (r.DestType != null)
                    {
                        <span class="pill">@(_destTypeItems.FirstOrDefault(c => c.CodeValue == r.DestType) is { } df ? MasterDataRepository.LocalName(df) : r.DestType)</span>
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="Country" Title="@L["Col.Country"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r">
                    @{ var nf = r.Country != null ? _nationItems.FirstOrDefault(c => c.CodeValue == r.Country) : null; }
                    <span class="dim">@(nf != null ? MasterDataRepository.LocalName(nf) : r.Country ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="DeliveryDock" Title="@L["Col.Dock"]" Width="150px">
                <Template Context="r"><span class="dim">@(r.DeliveryDock ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="LeadTimeDays" Title="@L["Col.LeadDays"]" TextAlign="TextAlign.Right" Width="150px">
                <Template Context="r">@(r.LeadTimeDays?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="DefaultCarrier" Title="@L["Col.Carrier"]" Width="200px">
                <Template Context="r"><span class="dim">@(r.DefaultCarrier ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.ShipmentDestRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r">
                    @{
                        var scls   = r.Status switch { "ACTIVE" => "ok", "HOLD" => "orange", "CLOSED" => "mute", _ => "mute" };
                        var strike = r.Status == "CLOSED";
                        var sLabel = _statusItems.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status;
                    }
                    <span class="pill @scls" style="@(strike ? "text-decoration:line-through;" : "")">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.ShipDest.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["Col.CustomerCode"]} *")' class="ames-rz-modal-label" Component="CreateDropDownCustomerID" />
                <RadzenDropDown AllowFiltering="true" Name="CreateDropDownCustomerID" @bind-Value="_f.CustomerID" Data="CustomerOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@($"{L["Col.ShipDestName"]} *")' class="ames-rz-modal-label" Component="CreateTextBoxDestName" />
                <RadzenTextBox Name="CreateTextBoxDestName" @bind-Value="_f.DestName" Placeholder="@L["MD.ShipmentDest.Ph.DestName"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Type"]" />
                    <RadzenDropDown @bind-Value="_f.DestType" Data="DestTypeOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.CountryCode"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.Country" Data="NationOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Dock"]" />
                    <RadzenTextBox @bind-Value="_f.DeliveryDock" Placeholder="DOCK-A" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.LeadTimeDays"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.LeadTimeDays" Placeholder="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Carrier"]" />
                    <RadzenTextBox @bind-Value="_f.DefaultCarrier" Placeholder="@L["MD.ShipmentDest.Ph.DefaultCarrier"]" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.DeliveryWindow"]" />
                    <RadzenTextBox @bind-Value="_f.DeliveryWindow" Placeholder="08:00-17:00" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text="@L["Col.Address"]" />
                    <RadzenTextBox @bind-Value="_f.Address" Placeholder="@L["MD.ShipmentDest.Ph.Address"]" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.ShipDest.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.ShipDestID</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["Col.CustomerCode"]} *")' class="ames-rz-modal-label" Component="EditDropDownCustomerID" />
                <RadzenDropDown AllowFiltering="true" Name="EditDropDownCustomerID" @bind-Value="_f.CustomerID" Data="CustomerOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@($"{L["Col.ShipDestName"]} *")' class="ames-rz-modal-label" Component="EditTextBoxDestName" />
                <RadzenTextBox Name="EditTextBoxDestName" @bind-Value="_f.DestName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Type"]" />
                    <RadzenDropDown @bind-Value="_f.DestType" Data="DestTypeOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.CountryCode"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.Country" Data="NationOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Dock"]" />
                    <RadzenTextBox @bind-Value="_f.DeliveryDock" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.LeadTimeDays"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.LeadTimeDays" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Carrier"]" />
                    <RadzenTextBox @bind-Value="_f.DefaultCarrier" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.DeliveryWindow"]" />
                    <RadzenTextBox @bind-Value="_f.DeliveryWindow" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="12">
                    <RadzenLabel Text="@L["Col.Address"]" />
                    <RadzenTextBox @bind-Value="_f.Address" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.ShipmentDestRow> _allRows   = new();
    List<MasterDataRepository.ShipmentDestRow> _rows      = new();
    List<MasterDataRepository.CustomerRow>     _customers = new();
    List<MasterDataRepository.CodeItemRow>     _destTypeItems = new();
    List<MasterDataRepository.CodeItemRow>     _nationItems   = new();
    MasterDataRepository.ShipmentDestRow? _sel;

    string _fSearch = "";
    string? _fStatus;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    IEnumerable<DropDownItem> DestTypeOptions => _destTypeItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    IEnumerable<DropDownItem> NationOptions   => _nationItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    List<MasterDataRepository.CodeItemRow> _statusItems = new();
    IEnumerable<DropDownItem> StatusOptions => _statusItems.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });
    IEnumerable<DropDownItem> CustomerOptions => _customers.Select(c => new DropDownItem { Value = c.CustomerID, Text = $"[{c.CustomerID}] {c.CustomerName ?? c.CustomerID}" });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/ql/shipment-dest");
        _customers = MD.ListCustomers();
        try { _destTypeItems = MD.ListCodeItems("SHIPMENT_DEST_TYPE"); } catch { }
        try { _nationItems   = MD.ListCodeItems("NATION_CODE"); } catch { }
        try { _statusItems   = MD.ListCodeItems("SHIPMENT_DEST_STATUS"); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.ShipmentDestRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _allRows = MD.ListShipmentDests(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.DestName     ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CustomerName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fStatus == null || r.Status == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.ShipmentDestRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.ShipmentDestRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.ShipmentDestRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            CustomerID     = r.CustomerID,
            DestName       = r.DestName        ?? "",
            DestType       = r.DestType,
            Address        = r.Address         ?? "",
            Country        = r.Country         ?? "",
            DeliveryDock   = r.DeliveryDock    ?? "",
            LeadTimeDays   = r.LeadTimeDays,
            DefaultCarrier = r.DefaultCarrier  ?? "",
            DeliveryWindow = r.DeliveryWindow  ?? "",
            Status         = r.Status          ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.DestName)) { _modalErr = L["Err.DestNameRequired"]; return; }
        _busy = true;
        try
        {
            var newId = "SD" + Guid.NewGuid().ToString("N")[..13].ToUpper();
            MD.InsertShipmentDest(newId, _f.CustomerID, _f.DestName, _f.DestType,
                NE(_f.Address), NE(_f.Country), NE(_f.DeliveryDock), _f.LeadTimeDays,
                NE(_f.DefaultCarrier), NE(_f.DeliveryWindow), _f.Status, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{_f.DestName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.DestName)) { _modalErr = L["Err.DestNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateShipmentDest(_sel.ShipDestID, _f.CustomerID, _f.DestName, _f.DestType,
                NE(_f.Address), NE(_f.Country), NE(_f.DeliveryDock), _f.LeadTimeDays,
                NE(_f.DefaultCarrier), NE(_f.DeliveryWindow), _f.Status, _actor);
            var name = _f.DestName;
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.DestName ?? _sel.ShipDestID;
            MD.DeleteShipmentDest(_sel.ShipDestID);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
