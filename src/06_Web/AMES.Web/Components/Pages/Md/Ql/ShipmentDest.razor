@page "/md/ql/shipment-dest"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.ShipDest.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.ShipDest.Kpi.Domestic"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Country == "KOR")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.ShipDest.Kpi.Export"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Country != null && r.Country != "KOR")</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.ShipDest.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder='@L["MD.ShipmentDest.Ph.Search"]' Style="width:160px;"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <RadzenLabel Text='@L["Col.Status"]' class="dim" Style="font-size:.82em;white-space:nowrap;" />
            <RadzenDropDown @bind-Value="_fStatus" Data="_statusOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder='@L["Filter.AllStatus"]' Style="width:110px;" />
            <RadzenButton Text='@L["Btn.Search"]' Icon="refresh" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text='@L["Btn.Create"]' Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid Data="_rows" TItem="MasterDataRepository.ShipmentDestRow"
                    RowRender="DestRowRender" RowSelect="OpenEdit"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizeOptions"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                    Class="ames-rz-grid" EmptyText='@L["MD.ShipDest.Empty"]'>
        <Columns>
            <RadzenDataGridColumn Property="ShipDestID" Title='@L["Col.ShipDestId"]' Width="140px">
                <Template Context="r"><span class="code">@r.ShipDestID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="CustomerName" Title='@L["Col.Customer"]' Width="150px">
                <Template Context="r">@(r.CustomerName ?? r.CustomerID ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="DestName" Title='@L["Col.ShipDestName"]' />
            <RadzenDataGridColumn Property="DestType" Title='@L["Col.Type"]' Width="90px">
                <Template Context="r"><span class="pill">@(r.DestType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Country" Title='@L["Col.Country"]' Width="80px">
                <Template Context="r"><span class="dim">@(r.Country ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="DeliveryDock" Title='@L["Col.Dock"]' Width="100px">
                <Template Context="r"><span class="dim">@(r.DeliveryDock ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="LeadTimeDays" Title='@L["Col.LeadDays"]' Width="85px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.LeadTimeDays?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="DefaultCarrier" Title='@L["Col.Carrier"]' Width="120px">
                <Template Context="r"><span class="dim">@(r.DefaultCarrier ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Status" Title='@L["Col.Status"]' Width="95px">
                <Template Context="r">
                    @if (r.Status == "Active") { <span class="pill ok">Active</span> }
                    else { <span class="pill bad">@(r.Status ?? "—")</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.ShipDest.Title"] — @L["Btn.Create"]</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.CustomerCode"]} *")' /><br />
                    <RadzenDropDown @bind-Value="_f.CustomerID" Data="CustomerOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.ShipDestName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.DestName" Placeholder='@L["MD.ShipmentDest.Ph.DestName"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Type"]' /><br />
                    <RadzenDropDown @bind-Value="_f.DestType" Data="_destTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.CountryCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.Country" Placeholder="KOR" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.Address"]' /><br />
                    <RadzenTextBox @bind-Value="_f.Address" Placeholder='@L["MD.ShipmentDest.Ph.Address"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Dock"]' /><br />
                    <RadzenTextBox @bind-Value="_f.DeliveryDock" Placeholder="DOCK-A" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.LeadTimeDays"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.LeadTimeDays" Placeholder="1" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Carrier"]' /><br />
                    <RadzenTextBox @bind-Value="_f.DefaultCarrier" Placeholder='@L["MD.ShipmentDest.Ph.DefaultCarrier"]' Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.DeliveryWindow"]' /><br />
                    <RadzenTextBox @bind-Value="_f.DeliveryWindow" Placeholder="08:00-17:00" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)' Click="SaveCreate" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.ShipDest.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.ShipDestID</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.CustomerCode"]} *")' /><br />
                    <RadzenDropDown @bind-Value="_f.CustomerID" Data="CustomerOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@($"{L["Col.ShipDestName"]} *")' /><br />
                    <RadzenTextBox @bind-Value="_f.DestName" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Type"]' /><br />
                    <RadzenDropDown @bind-Value="_f.DestType" Data="_destTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    AllowClear="true" Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.CountryCode"]' /><br />
                    <RadzenTextBox @bind-Value="_f.Country" Style="width:100%;" autocomplete="off" />
                </div>
                <div style="grid-column:span 2;">
                    <RadzenLabel Text='@L["Col.Address"]' /><br />
                    <RadzenTextBox @bind-Value="_f.Address" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Dock"]' /><br />
                    <RadzenTextBox @bind-Value="_f.DeliveryDock" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.LeadTimeDays"]' /><br />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.LeadTimeDays" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Carrier"]' /><br />
                    <RadzenTextBox @bind-Value="_f.DefaultCarrier" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.DeliveryWindow"]' /><br />
                    <RadzenTextBox @bind-Value="_f.DeliveryWindow" Style="width:100%;" autocomplete="off" />
                </div>
                <div>
                    <RadzenLabel Text='@L["Col.Status"]' /><br />
                    <RadzenDropDown @bind-Value="_f.Status" Data="_statusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder='@L["Opt.Select"]' Style="width:100%;" />
                </div>
            </div>
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text='@L["Msg.No"]' Click='() => _confirmDelete = false' ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
                    <RadzenButton Text='@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)' Click="SaveDelete" Disabled="_busy" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                </RadzenStack>
            }
            @if (!string.IsNullOrEmpty(_modalErr))
            { <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="false" Variant="Variant.Flat" class="ames-alert-rz" Style="margin-top:8px;">@_modalErr</RadzenAlert> }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text='@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)' Click="SaveEdit" Disabled="_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Delete"]' Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text='@L["Btn.Cancel"]' Click="CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<MasterDataRepository.ShipmentDestRow> _allRows   = new();
    List<MasterDataRepository.ShipmentDestRow> _rows      = new();
    List<MasterDataRepository.CustomerRow>     _customers = new();
    MasterDataRepository.ShipmentDestRow? _sel;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string? _fStatus;
    string  _fSearch = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr, _canEdit;
    string _actor = "system";
    FormModel _f = new();

    DropDownItem[] _destTypeOptions =
    {
        new() { Value = "PLANT",  Text = "PLANT"  },
        new() { Value = "DC",     Text = "DC"     },
        new() { Value = "PORT",   Text = "PORT"   },
        new() { Value = "DEALER", Text = "DEALER" },
    };
    DropDownItem[] _statusOptions =
    {
        new() { Value = "Active",   Text = "Active"   },
        new() { Value = "Inactive", Text = "Inactive" },
    };

    IEnumerable<DropDownItem> CustomerOptions =>
        _customers.Select(c => new DropDownItem { Value = c.CustomerID, Text = $"[{c.CustomerID}] {c.CustomerName ?? c.CustomerID}" });

    void DestRowRender(RowRenderEventArgs<MasterDataRepository.ShipmentDestRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/ql/shipment-dest");
        _customers = Md.ListCustomers();
        Reload();
    }

    void Reload() { _allRows = Md.ListShipmentDests(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.DestName     ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CustomerName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fStatus == null || r.Status == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.ShipmentDestRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            CustomerID     = r.CustomerID,
            DestName       = r.DestName        ?? "",
            DestType       = r.DestType,
            Address        = r.Address         ?? "",
            Country        = r.Country         ?? "",
            DeliveryDock   = r.DeliveryDock    ?? "",
            LeadTimeDays   = r.LeadTimeDays,
            DefaultCarrier = r.DefaultCarrier  ?? "",
            DeliveryWindow = r.DeliveryWindow  ?? "",
            Status         = r.Status          ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.DestName)) { _modalErr = L["Err.DestNameRequired"]; return; }
        _busy = true;
        try
        {
            var newId = "SD" + Guid.NewGuid().ToString("N")[..13].ToUpper();
            Md.InsertShipmentDest(newId, _f.CustomerID, _f.DestName, _f.DestType,
                NE(_f.Address), NE(_f.Country), NE(_f.DeliveryDock), _f.LeadTimeDays,
                NE(_f.DefaultCarrier), NE(_f.DeliveryWindow), _f.Status, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.DestName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.DestName)) { _modalErr = L["Err.DestNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateShipmentDest(_sel.ShipDestID, _f.CustomerID, _f.DestName, _f.DestType,
                NE(_f.Address), NE(_f.Country), NE(_f.DeliveryDock), _f.LeadTimeDays,
                NE(_f.DefaultCarrier), NE(_f.DeliveryWindow), _f.Status, _actor);
            var name = _f.DestName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.DestName ?? _sel.ShipDestID;
            Md.DeleteShipmentDest(_sel.ShipDestID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string? CustomerID     { get; set; }
        public string  DestName       { get; set; } = "";
        public string? DestType       { get; set; }
        public string  Address        { get; set; } = "";
        public string  Country        { get; set; } = "KOR";
        public string  DeliveryDock   { get; set; } = "";
        public int?    LeadTimeDays   { get; set; }
        public string  DefaultCarrier { get; set; } = "";
        public string  DeliveryWindow { get; set; } = "";
        public string  Status         { get; set; } = "Active";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
}