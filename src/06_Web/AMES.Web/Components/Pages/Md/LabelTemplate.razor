@page "/md/label-template"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.LabelTpl.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-024" TitleKey="MD.LabelTpl.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.LabelTpl.Kpi.LabelTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LabelType).Where(t => t != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.LabelTpl.Kpi.CustomerAssigned"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.CustomerID != null)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.LabelTpl.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:150px;padding:4px 8px;"
                   placeholder='@L["MD.LabelTemplate.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:110px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _labelTypes.Where(x => x.UseFlag))
                {
                    <option value="@t.CodeValue">@(MasterDataRepository.LocalName(t))</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.LabelTpl.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.TemplateId"]</th><th>@L["Col.TemplateName"]</th><th>@L["Col.LabelType"]</th>
                    <th>@L["Col.PaperSize"]</th><th>@L["Col.BarcodeType"]</th><th>@L["Col.Customer"]</th>
                    <th class="num">@L["Col.Version"]</th><th>@L["Col.PrinterModel"]</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.LabelTemplateID</td>
                        <td>@(r.TemplateName ?? "—")</td>
                        <td>@(_labelTypes.FirstOrDefault(x => x.CodeValue == r.LabelType) is { } _ltLf ? MasterDataRepository.LocalName(_ltLf) : r.LabelType ?? "—")</td>
                        <td class="dim">@(r.PaperSize ?? "—")</td>
                        <td class="dim">@(_barcodeTypes.FirstOrDefault(x => x.CodeValue == r.BarcodeType) is { } _btLf ? MasterDataRepository.LocalName(_btLf) : r.BarcodeType ?? "—")</td>
                        <td class="dim">@(r.CustomerID ?? "—")</td>
                        <td class="num">@(r.Version?.ToString() ?? "—")</td>
                        <td class="dim">@(r.PrinterModel ?? "—")</td>
                        <td><span class="pill @(r.Status == "ACTIVE" ? "ok" : "warn")">@(_labelStatuses.FirstOrDefault(x => x.CodeValue == r.Status) is { } _stLf ? MasterDataRepository.LocalName(_stLf) : r.Status ?? "—")</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.LabelTpl.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.TemplateId"]</label>
            <input class="ames-input" @bind="_f.LabelTemplateID" placeholder="LBL-001" autocomplete="off" />

            <label>@L["Col.TemplateName"]</label>
            <input class="ames-input" @bind="_f.TemplateName" placeholder='@L["MD.LabelTemplate.Ph.TemplateName"]' autocomplete="off" />

            <label>@L["Col.LabelType"]</label>
            <select class="ames-input" @bind="_f.LabelType">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var t in _labelTypes.Where(x => x.UseFlag))
                {
                    <option value="@t.CodeValue">@(MasterDataRepository.LocalName(t))</option>
                }
            </select>

            <label>@L["Col.PaperSize"]</label>
            <input class="ames-input" @bind="_f.PaperSize" placeholder="A4 / 100x70" autocomplete="off" />

            <label>@L["Col.BarcodeType"]</label>
            <select class="ames-input" @bind="_f.BarcodeType">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var b in _barcodeTypes.Where(x => x.UseFlag))
                {
                    <option value="@b.CodeValue">@(MasterDataRepository.LocalName(b))</option>
                }
            </select>

            <label>@L["Col.Customer"]</label>
            <input class="ames-input" @bind="_f.CustomerID" placeholder="CUST-001" autocomplete="off" />

            <label>@L["Col.Version"]</label>
            <input class="ames-input" type="number" @bind="_f.Version" placeholder="1" min="1" autocomplete="off" />

            <label>@L["Col.PrinterModel"]</label>
            <input class="ames-input" @bind="_f.PrinterModel" placeholder="Zebra ZT230" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _labelStatuses.Where(x => x.UseFlag))
                {
                    <option value="@s.CodeValue">@(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.LabelTpl.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.LabelTemplateID</span></div>

            <label>@L["Col.TemplateName"]</label>
            <input class="ames-input" @bind="_f.TemplateName" autocomplete="off" />

            <label>@L["Col.LabelType"]</label>
            <select class="ames-input" @bind="_f.LabelType">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var t in _labelTypes.Where(x => x.UseFlag))
                {
                    <option value="@t.CodeValue">@(MasterDataRepository.LocalName(t))</option>
                }
            </select>

            <label>@L["Col.PaperSize"]</label>
            <input class="ames-input" @bind="_f.PaperSize" autocomplete="off" />

            <label>@L["Col.BarcodeType"]</label>
            <select class="ames-input" @bind="_f.BarcodeType">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var b in _barcodeTypes.Where(x => x.UseFlag))
                {
                    <option value="@b.CodeValue">@(MasterDataRepository.LocalName(b))</option>
                }
            </select>

            <label>@L["Col.Customer"]</label>
            <input class="ames-input" @bind="_f.CustomerID" autocomplete="off" />

            <label>@L["Col.Version"]</label>
            <input class="ames-input" type="number" @bind="_f.Version" min="1" autocomplete="off" />

            <label>@L["Col.PrinterModel"]</label>
            <input class="ames-input" @bind="_f.PrinterModel" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _labelStatuses.Where(x => x.UseFlag))
                {
                    <option value="@s.CodeValue">@(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveEdit" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.LabelTemplateRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.LabelTemplateRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.LabelTemplateRow? _sel;
    int _page = 0;
    const int _pageSize = 20;
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _labelTypes   = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _barcodeTypes = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _labelStatuses = new();
    string _fSearch = "", _fType = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/label-template");
        try { _labelTypes    = Md.ListCodeItems("LABEL_TYPE");   } catch { }
        try { _barcodeTypes  = Md.ListCodeItems("BARCODE_TYPE"); } catch { }
        try { _labelStatuses = Md.ListCodeItems("LABEL_STATUS"); } catch { }
        Reload();
    }

    void Reload()
    {
        try { _allRows = Md.ListLabelTemplates(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _page = 0;
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.LabelTemplateID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.TemplateName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fType))
            _rows = _rows.Where(r => r.LabelType == _fType).ToList();
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.LabelTemplateRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            TemplateName = r.TemplateName ?? "",
            LabelType    = r.LabelType    ?? "",
            PaperSize    = r.PaperSize    ?? "",
            BarcodeType  = r.BarcodeType  ?? "",
            CustomerID   = r.CustomerID   ?? "",
            Version      = r.Version,
            PrinterModel = r.PrinterModel ?? "",
            Status       = r.Status       ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.LabelTemplateID)) { _modalErr = L["Err.TemplateIdRequired"]; return; }
        var id = _f.LabelTemplateID.Trim();
        if (Md.LabelTemplateExists(id)) { _modalErr = $"'{id}' ID가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertLabelTemplate(id, NE(_f.TemplateName), NE(_f.LabelType),
                NE(_f.PaperSize), NE(_f.BarcodeType), NE(_f.CustomerID),
                _f.Version, NE(_f.PrinterModel), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            Md.UpdateLabelTemplate(_sel.LabelTemplateID, NE(_f.TemplateName), NE(_f.LabelType),
                NE(_f.PaperSize), NE(_f.BarcodeType), NE(_f.CustomerID),
                _f.Version, NE(_f.PrinterModel), NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.LabelTemplateID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.LabelTemplateID;
            Md.DeleteLabelTemplate(_sel.LabelTemplateID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string  LabelTemplateID { get; set; } = "";
        public string  TemplateName    { get; set; } = "";
        public string  LabelType       { get; set; } = "";
        public string  PaperSize       { get; set; } = "";
        public string  BarcodeType     { get; set; } = "";
        public string  CustomerID      { get; set; } = "";
        public int?    Version         { get; set; }
        public string  PrinterModel    { get; set; } = "";
        public string  Status          { get; set; } = "ACTIVE";
    }
}
