@page "/md/vendor"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Vendor.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-009" TitleKey="MD.Vendor.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Vendor.Kpi.EDI"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.EdiFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Vendor.Kpi.OtdSet"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.OtdTargetRate.HasValue)</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Vendor.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:160px;padding:4px 8px;"
                   placeholder="@L["MD.Vendor.Ph.Search"]" @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:120px;padding:4px 8px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _vendorTypes.Where(t => t.UseFlag))
                {
                    <option value="@t.CodeValue">[@t.CodeValue] @(MasterDataRepository.LocalName(t))</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fActive">
                <option value="">@L["Filter.AllStatus"]</option>
                <option value="Y">@L["Lbl.Active"]</option>
                <option value="N">@L["Lbl.Inactive"]</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Vendor.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.VendorId"]</th><th>@L["Col.VendorName"]</th><th>@L["Col.Type"]</th><th>@L["Col.Category"]</th>
                    <th>@L["Col.Contact"]</th><th>@L["Col.EDI"]</th><th class="num">@L["Col.OtdPct"]</th><th>@L["Col.PayTerm"]</th><th>@L["Col.Active"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.VendorID</td>
                        <td>@(r.VendorName ?? "—")</td>
                        <td><span class="pill">@(_vendorTypes.FirstOrDefault(v => v.CodeValue == r.VendorType) is { } _lf_ ? MasterDataRepository.LocalName(_lf_) : r.VendorType ?? "—")</span></td>
                        <td class="dim">@(r.VendorCategory ?? "—")</td>
                        <td>@(r.ContactPerson ?? "—")</td>
                        <td>
                            @if (r.EdiFlag) { <span class="pill ok">EDI</span> }
                            else { <span class="dim">—</span> }
                        </td>
                        <td class="num">@(r.OtdTargetRate?.ToString("F1") ?? "—")</td>
                        <td class="dim">@(r.PaymentTerms ?? "—")</td>
                        <td>
                            @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                            else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Vendor.Modal.Create"]</div>

            <label>@L["MD.Vendor.Lbl.VendorName"]</label>
            <input class="ames-input" @bind="_f.VendorName" placeholder='@L["MD.Vendor.Ph.VendorName"]' autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.VendorType"]</label>
            <select class="ames-input" @bind="_f.VendorType">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var t in _vendorTypes.Where(t => t.UseFlag))
                {
                    <option value="@t.CodeValue">[@t.CodeValue] @(MasterDataRepository.LocalName(t))</option>
                }
            </select>

            <label>@L["MD.Vendor.Lbl.VendorCategory"]</label>
            <input class="ames-input" @bind="_f.VendorCategory" placeholder='@L["MD.Vendor.Ph.VendorCategory"]' autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.BizRegNo"]</label>
            <input class="ames-input" @bind="_f.BizRegNo" placeholder="000-00-00000" autocomplete="off" />

            <label>@L["Col.Contact"]</label>
            <input class="ames-input" @bind="_f.ContactPerson" placeholder='@L["MD.Vendor.Ph.ContactPerson"]' autocomplete="off" />

            <label>@L["Col.Phone"]</label>
            <input class="ames-input" @bind="_f.Phone" placeholder="02-0000-0000" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.Email"]</label>
            <input class="ames-input" @bind="_f.Email" placeholder="vendor@abc.com" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.ScmURL"]</label>
            <input class="ames-input" @bind="_f.ScmURL" placeholder="https://scm.abc.com" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.OtdTarget"]</label>
            <input class="ames-input" type="number" @bind="_f.OtdTargetRate" placeholder="95.0" min="0" max="100" step="0.1" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.PaymentTerms"]</label>
            <input class="ames-input" @bind="_f.PaymentTerms" placeholder="NET30" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.EdiFlag" />
                <span>@L["MD.Vendor.Lbl.EDI"]</span>
            </label>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Create"].Value)</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Vendor.Modal.Edit"] — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.VendorID</span></div>

            <label>@L["MD.Vendor.Lbl.VendorName"]</label>
            <input class="ames-input" @bind="_f.VendorName" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.VendorType"]</label>
            <select class="ames-input" @bind="_f.VendorType">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var t in _vendorTypes.Where(t => t.UseFlag))
                {
                    <option value="@t.CodeValue">[@t.CodeValue] @(MasterDataRepository.LocalName(t))</option>
                }
            </select>

            <label>@L["MD.Vendor.Lbl.VendorCategory"]</label>
            <input class="ames-input" @bind="_f.VendorCategory" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.BizRegNo"]</label>
            <input class="ames-input" @bind="_f.BizRegNo" autocomplete="off" />

            <label>@L["Col.Contact"]</label>
            <input class="ames-input" @bind="_f.ContactPerson" autocomplete="off" />

            <label>@L["Col.Phone"]</label>
            <input class="ames-input" @bind="_f.Phone" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.Email"]</label>
            <input class="ames-input" @bind="_f.Email" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.ScmURL"]</label>
            <input class="ames-input" @bind="_f.ScmURL" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.OtdTarget"]</label>
            <input class="ames-input" type="number" @bind="_f.OtdTargetRate" min="0" max="100" step="0.1" autocomplete="off" />

            <label>@L["MD.Vendor.Lbl.PaymentTerms"]</label>
            <input class="ames-input" @bind="_f.PaymentTerms" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.EdiFlag" />
                <span>@L["MD.Vendor.Lbl.EDI"]</span>
            </label>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? L["Msg.Deleting"].Value : L["Msg.Yes"].Value)</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? L["Msg.Saving"].Value : L["Btn.Edit"].Value)</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    int _page = 0;
    const int _pageSize = 20;
    List<AMES.Data.Repositories.MasterDataRepository.VendorRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.VendorRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.VendorRow? _sel;

    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _vendorTypes = new();
    string _fSearch = "", _fType = "", _fActive = "";
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        try { _vendorTypes = Md.ListCodeItems("VENDOR_TYPE"); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListVendors(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            (r.VendorName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fType)   || r.VendorType == _fType) &&
        (string.IsNullOrEmpty(_fActive) ||
            (_fActive == "Y" ?  r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.VendorRow r)
    {
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            VendorName     = r.VendorName     ?? "",
            VendorType     = r.VendorType     ?? "",
            VendorCategory = r.VendorCategory ?? "",
            BizRegNo       = r.BizRegNo       ?? "",
            ContactPerson  = r.ContactPerson  ?? "",
            Phone          = r.Phone          ?? "",
            Email          = r.Email          ?? "",
            ScmURL         = r.ScmURL         ?? "",
            EdiFlag        = r.EdiFlag,
            OtdTargetRate  = r.OtdTargetRate,
            PaymentTerms   = r.PaymentTerms   ?? "",
            ActiveFlag     = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.VendorName)) { _modalErr = L["MD.Vendor.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            var newId = "V" + Guid.NewGuid().ToString("N")[..14].ToUpper();
            Md.InsertVendor(newId, _f.VendorName, NE(_f.VendorType), NE(_f.VendorCategory),
                NE(_f.BizRegNo), NE(_f.ContactPerson), NE(_f.Phone), NE(_f.Email),
                NE(_f.ScmURL), _f.EdiFlag, _f.OtdTargetRate,
                NE(_f.PaymentTerms), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Vendor.Ok.Created"].Value, _f.VendorName), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.VendorName)) { _modalErr = L["MD.Vendor.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateVendor(_sel.VendorID, _f.VendorName, NE(_f.VendorType), NE(_f.VendorCategory),
                NE(_f.BizRegNo), NE(_f.ContactPerson), NE(_f.Phone), NE(_f.Email),
                NE(_f.ScmURL), _f.EdiFlag, _f.OtdTargetRate,
                NE(_f.PaymentTerms), _f.ActiveFlag, _actor);
            var name = _f.VendorName;
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Vendor.Ok.Updated"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.VendorName ?? _sel.VendorID;
            Md.DeleteVendor(_sel.VendorID);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Vendor.Ok.Deleted"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string  VendorName     { get; set; } = "";
        public string  VendorType     { get; set; } = "";
        public string  VendorCategory { get; set; } = "";
        public string  BizRegNo       { get; set; } = "";
        public string  ContactPerson  { get; set; } = "";
        public string  Phone          { get; set; } = "";
        public string  Email          { get; set; } = "";
        public string  ScmURL         { get; set; } = "";
        public bool    EdiFlag        { get; set; } = false;
        public decimal? OtdTargetRate { get; set; }
        public string  PaymentTerms   { get; set; } = "";
        public bool    ActiveFlag     { get; set; } = true;
    }
}
