    </div>;

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> ItemOptions => _itemList.Select(i => new DropDownItem { Value = i.ItemNo, Text = $"[{i.ItemNo}] {i.ItemName}" });
    private IEnumerable<DropDownItem> RoutingOptions => _routingItems.Where(r => r.UseFlag).Select(r => new DropDownItem { Value = r.CodeValue ?? "", Text = $"[{r.CodeValue}] {MasterDataRepository.LocalName(r)}" });
    private IEnumerable<DropDownItem> CopyOptions => _copyCandidates.Select(i => new DropDownItem { Value = i.ItemNo, Text = $"[{i.ItemNo}] {i.ItemName} ({i.StepCount})" });
    private IEnumerable<DropDownItem> StationOptions => _stationList.Select(s => new DropDownItem { Value = s.StationCode, Text = $"[{s.StationCode}] {MasterDataRepository.LocalName(s.StationName, s.StationNameEn)}" });

    class StepForm
    {
        public string  BopId        { get; set; } = "";
        public string  ItemNo       { get; set; } = "";
        public string  RoutingType  { get; set; } = "A";
        public int     StepSeq      { get; set; } = 10;
        public string  StationCode  { get; set; } = "";
        public decimal CycleTime    { get; set; } = 0;
        public decimal SetupTime    { get; set; } = 0;
        public bool    QcRequired   { get; set; } = false;
        public string  StepDesc     { get; set; } = "";
        public bool    ActiveFlag   { get; set; } = true;
    }
}
