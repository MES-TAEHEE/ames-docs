@page "/md/rp/bop"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-005 @L["MD.Bop.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-005" TitleKey="MD.Bop.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Bop.Kpi.TotalOps"]</div>
        <div class="ames-kpi-v">@_kpi.TotalOps</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["MD.Bop.Kpi.ActiveOps"]</div>
        <div class="ames-kpi-v">@_kpi.ActiveOps</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Bop.Kpi.AvgCt"]</div>
        <div class="ames-kpi-v">@(_kpi.AvgCycle?.ToString("N1") ?? "—")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Bop.Kpi.ProductsRouted"]</div>
        <div class="ames-kpi-v">@_kpi.ProductsRouted</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div style="display:flex;gap:14px;height:calc(100vh - 200px);">

    @* ── 좌: 품목 목록 ─────────────────────────────────────────────────── *@
    <div style="flex:0 0 500px;display:flex;flex-direction:column;min-height:0;">
        <div class="ames-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;margin-bottom:0;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom:8px;">
                <RadzenTextBox @bind-Value="_search" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Bop.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;" />
                <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@LoadItems" class="ames-rz-btn" />
            </RadzenStack>
            <div style="flex:1;min-height:0;overflow:hidden;">
                <RadzenDataGrid @ref="_itemGrid" Page="OnItemPage" TItem="MasterDataRepository.BopItemRow" Data="_items" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center"
                                ShowPagingSummary="false" RowRender="ItemRowRender" RowSelect="OnItemRowSelect" EmptyText="@L["MD.Bop.NoItems"]" Class="ames-rz-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="MasterDataRepository.BopItemRow" Property="ItemNo" Title="@L["Col.ItemNo"]">
                            <Template Context="item">
                                <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    <span class="code">@item.ItemNo</span>
                                    @if (!string.IsNullOrEmpty(item.ItemName))
                                    {
                                        <span class="dim" style="font-size:.8em;margin-left:6px;">@item.ItemName</span>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MasterDataRepository.BopItemRow" Property="StepCount" Title="@L["Col.StepCount"]" Width="80px" TextAlign="TextAlign.Center">
                            <Template Context="item"><span class="pill info">@item.StepCount</span></Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </div>

    @* ── 우: 공정 단계 ─────────────────────────────────────────────────── *@
    <div style="flex:1;min-width:0;display:flex;flex-direction:column;min-height:0;">
        <div class="ames-card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;margin-bottom:0;">

            @if (_selItem is null)
            {
                <div style="flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;">
                    <div style="font-size:2.4em;opacity:.15;">⚙️</div>
                    <div class="dim" style="font-size:.9em;">@L["MD.Bop.SelectItemHint"]</div>
                </div>
            }
            else
            {
                @* ─── 품목 정보 바 ─── *@
                <div class="ames-info-bar">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
                        <div>
                            <div style="display:flex;align-items:baseline;gap:8px;">
                                <span class="code" style="font-weight:700;font-size:.95em;">@_selItem.ItemNo</span>
                                @if (!string.IsNullOrEmpty(_selItem.ItemName))
                                {
                                    <span style="font-size:.88em;color:rgba(255,255,255,.7);">@_selItem.ItemName</span>
                                }
                            </div>
                            <div class="dim" style="font-size:.8em;margin-top:2px;">
                                @string.Format(L["MD.Bop.StepCount"], _steps.Count)
                                @if (_rtFilter != null) { <span> · @string.Format(L["MD.Bop.RoutingFilter"], _rtFilter)</span> }
                            </div>
                        </div>
                        @if (_canEdit)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenButton Text="@L["MD.Bop.CopyStep"]" Icon="content_copy" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@OpenStepCopy" class="ames-rz-btn" />
                                <RadzenButton Text="@L["MD.Bop.AddStep"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenStepCreate" class="ames-rz-btn" />
                            </RadzenStack>
                        }
                    </div>
                </div>

                @* ─── 라우팅 타입 필터 ─── *@
                @if (_routingTypes.Count > 0)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem" Wrap="FlexWrap.Wrap" Style="padding-bottom:8px;">
                        <span class="dim" style="font-size:.79em;font-family:'JetBrains Mono',monospace;letter-spacing:.5px;">Routing:</span>
                        <RadzenButton Text="@L["Btn.All"]" ButtonStyle="@(_rtFilter == null ? ButtonStyle.Info : ButtonStyle.Light)" Size="ButtonSize.ExtraSmall" Click='() => SetRtFilter(null)' class="ames-rz-btn" />
                        @foreach (var rt in _routingTypes)
                        {
                            var rtCap = rt;
                            <RadzenButton Text="@rt" ButtonStyle="@(_rtFilter == rt ? ButtonStyle.Info : ButtonStyle.Light)" Size="ButtonSize.ExtraSmall" Click="() => SetRtFilter(rtCap)" class="ames-rz-btn" />
                        }
                    </RadzenStack>
                }

                @* ─── 공정 단계 그리드 ─── *@
                <div style="flex:1;min-height:0;overflow:hidden;">
                    <RadzenDataGrid @ref="_stepGrid" Page="OnStepPage" TItem="MasterDataRepository.BopRow" Data="_steps" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center"
                                    ShowPagingSummary="@_showPagerSummary" PageSizeOptions="@_pageSizeOptions" RowRender="StepRowRender" RowSelect="OnStepRowSelect" EmptyText="@L["MD.Bop.NoSteps"]" Class="ames-rz-grid">
                        <Columns>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BopRow" Property="RoutingType" Title="@L["Col.Routing"]" Width="70px" TextAlign="TextAlign.Center">
                                <Template Context="step"><span class="pill info">@(step.RoutingType ?? "—")</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BopRow" Property="StepSeq" Title="@L["Col.Seq"]" Width="60px" TextAlign="TextAlign.Center">
                                <Template Context="step"><span class="code">@step.StepSeq</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BopRow" Property="StationCode" Title="@L["Col.Station"]">
                                <Template Context="step">
                                    @if (!string.IsNullOrEmpty(step.StationCode))
                                    {
                                        <span class="code" style="color:#a78bfa;">@step.StationCode</span>
                                    }
                                    @{ var stName = MasterDataRepository.LocalName(step.StationName, step.StationNameEn); }
                                    @if (!string.IsNullOrEmpty(stName))
                                    {
                                        <div class="dim" style="font-size:.8em;">@stName</div>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BopRow" Property="StdCycleTime" Title="@L["Col.CycleSetup"]" Width="120px" TextAlign="TextAlign.Right">
                                <Template Context="step">
                                    <span>@(step.StdCycleTime?.ToString("N1") ?? "—")</span>
                                    <span class="dim"> / @(step.StdSetupTime?.ToString("N1") ?? "—")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BopRow" Property="QcRequiredFlag" Title="@L["Col.QcActive"]" Width="72px" TextAlign="TextAlign.Center">
                                <Template Context="step">
                                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="0.2rem">
                                        @if (step.QcRequiredFlag) { <span class="pill ok">QC</span> }
                                        <span class="pill @(step.ActiveFlag ? "ok" : "dim")">@(step.ActiveFlag ? "Y" : "N")</span>
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MasterDataRepository.BopRow" Property="StepDescription" Title="@L["Col.Description"]">
                                <Template Context="step"><span class="dim">@step.StepDescription</span></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </div>
    </div>
</div>

@* ── 공정 단계 추가 모달 ─────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Bop.Title"] — @L["Modal.Create"]</div>

            @StepFormFields(false)

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Add"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 공정 단계 수정/삭제 모달 ───────────────────────────────────────── *@
@if (_modal == "edit")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">
                @L["MD.Bop.Title"] — @L["Modal.Edit"]
                <span class="pill info" style="margin-left:8px;font-size:.8em;">@_f.RoutingType</span>
                <span class="dim" style="margin-left:6px;font-size:.88em;font-weight:400;">Step @_f.StepSeq</span>
            </div>

            @StepFormFields(true)

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.Bop.ConfirmDeleteStep"], _f.ItemNo, _f.StepSeq)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── 단계 복사 모달 ─────────────────────────────────────────────────── *@
@if (_modal == "copy")
{
    <div class="ames-modal-bg" @onmousedown="OnBgDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">
                @L["MD.Bop.CopyStep"]
                <span class="dim" style="margin-left:6px;font-size:.88em;font-weight:400;">→ @_selItem?.ItemNo</span>
            </div>

            <div class="dim" style="font-size:.85em;">@string.Format(L["MD.Bop.CopyHint"], ItemRouting(_selItem?.ItemNo))</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@($"{L["MD.Bop.CopySource"]} *")' class="ames-rz-modal-label" Component="CopySourceDd" />
                @if (_copyCandidates.Count == 0)
                {
                    <span class="dim" style="flex:1;">@L["MD.Bop.CopyNoCandidates"]</span>
                }
                else
                {
                    <RadzenDropDown Name="CopySourceDd" @bind-Value="_copySource" Data="@CopyOptions" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
                }
            </RadzenStack>

            @if (_copyConfirm)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@string.Format(L["MD.Bop.CopyConfirmOverwrite"], _selItem?.StepCount)</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _copyConfirm = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DoCopy" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["MD.Bop.CopyStep"])" Click="@SaveCopy" Disabled="@(_busy || _copyCandidates.Count == 0)" Icon="content_copy" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.BopItemRow>    _items    = new();
    List<MasterDataRepository.BopRow>        _steps    = new();
    List<MasterDataRepository.ItemRow>       _itemList = new();
    List<MasterDataRepository.StationRow>    _stationList = new();
    List<MasterDataRepository.CodeItemRow>   _routingItems = new();
    MasterDataRepository.BopItemRow?         _selItem;
    MasterDataRepository.BopKpiRow           _kpi = new(0, 0, null, 0);
    List<string> _routingTypes = new();
    string? _rtFilter;
    string  _search = "";

    List<MasterDataRepository.BopItemRow> _copyCandidates = new();
    string _copySource = "";
    bool   _copyConfirm;

    string _modal = "", _modalErr = "", _msg = "";
    bool   _isErr, _busy, _bgDown, _confirmDelete;
    bool   _canEdit;
    string _actor = "system";

    StepForm _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor   = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/rp/bop");
        try { _itemList = MD.ListItems();       } catch { }
        try { _stationList = MD.ListStations(); } catch { }
        try { _routingItems = MD.ListCodeItems("ROUTING"); } catch { }
        LoadItems();
    }

    RadzenDataGrid<MasterDataRepository.BopItemRow>? _itemGrid;
    RadzenDataGrid<MasterDataRepository.BopRow>?     _stepGrid;
    int _itemPage, _stepPage;
    void OnItemPage(PagerEventArgs args) => _itemPage = args.PageIndex;
    void OnStepPage(PagerEventArgs args) => _stepPage = args.PageIndex;

    // 데이터 재로딩 후 품목/단계 목록의 현재 페이지를 유지
    async Task RestorePages()
    {
        await InvokeAsync(StateHasChanged);
        if (_itemGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_items.Count / (double)_itemGrid.PageSize));
            await _itemGrid.GoToPage(Math.Min(_itemPage, pages - 1));
        }
        if (_stepGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_steps.Count / (double)_stepGrid.PageSize));
            await _stepGrid.GoToPage(Math.Min(_stepPage, pages - 1));
        }
    }

    void LoadItems()
    {
        try { _items = MD.ListBopItems(string.IsNullOrWhiteSpace(_search) ? null : _search); }
        catch { _items = new(); }
        try { _kpi = MD.BopKpi(); } catch { }
    }

    void LoadSteps()
    {
        if (_selItem is null) { _steps = new(); _routingTypes = new(); return; }
        try
        {
            _steps = MD.ListBopSteps(_selItem.ItemNo, _rtFilter);
            _routingTypes = MD.ListBopSteps(_selItem.ItemNo)
                .Select(s => s.RoutingType ?? "")
                .Where(rt => rt.Length > 0)
                .Distinct().Order().ToList();
        }
        catch { _steps = new(); _routingTypes = new(); }
    }

    void SelectItem(MasterDataRepository.BopItemRow item) { _selItem = item; _rtFilter = null; LoadSteps(); }

    void SetRtFilter(string? rt) { _rtFilter = rt; LoadSteps(); }

    void OnSearchChanged(string value) => _search = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") LoadItems(); }

    void ItemRowRender(RowRenderEventArgs<MasterDataRepository.BopItemRow> args)
    {
        var cls = "ames-row-link";
        if (_selItem?.ItemNo == args.Data?.ItemNo) cls += " ames-row-selected";
        args.Attributes["class"] = cls;
    }

    void StepRowRender(RowRenderEventArgs<MasterDataRepository.BopRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OnItemRowSelect(MasterDataRepository.BopItemRow item) => SelectItem(item);

    void OnStepRowSelect(MasterDataRepository.BopRow step) { if (_canEdit) OpenStepEdit(step); }

    // 선택 품목(MD_Item)에 정의된 RoutingType 을 그대로 사용 (수정 불가)
    string ItemRouting(string? itemNo, string? fallback = null)
        => _itemList.FirstOrDefault(i => i.ItemNo == itemNo)?.RoutingType is { Length: > 0 } rt ? rt : (fallback ?? "");

    void CloseModal() { _modal = ""; _modalErr = ""; _confirmDelete = false; _copyConfirm = false; _copySource = ""; }

    void OnBgDown()  => _bgDown = true;
    void OnBgClick() { if (_bgDown) CloseModal(); _bgDown = false; }

    // ── 단계 복사 ──────────────────────────────────────────────
    void OpenStepCopy()
    {
        if (_selItem is null) return;
        var targetRt = ItemRouting(_selItem.ItemNo);
        _copyCandidates = MD.ListBopItems(null)
            .Where(i => i.StepCount > 0
                     && i.ItemNo != _selItem.ItemNo
                     && ItemRouting(i.ItemNo) == targetRt)
            .ToList();
        _copySource = ""; _copyConfirm = false; _modalErr = ""; _modal = "copy";
    }

    async Task SaveCopy()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_copySource)) { _modalErr = L["Opt.Select"]; return; }
        if ((_selItem?.StepCount ?? 0) > 0 && !_copyConfirm) { _copyConfirm = true; return; }
        await DoCopy();
    }

    async Task DoCopy()
    {
        if (_selItem is null || string.IsNullOrWhiteSpace(_copySource)) return;
        _busy = true;
        try
        {
            int n = MD.CopyBopSteps(_copySource, _selItem.ItemNo, (_selItem.StepCount) > 0, _actor);
            var itemNo = _selItem.ItemNo;
            LoadItems();
            _selItem = _items.FirstOrDefault(i => i.ItemNo == itemNo) ?? _selItem;
            LoadSteps(); CloseModal();
            await RestorePages();
            ShowMsg(string.Format(L["MD.Bop.CopyOk"].Value, n), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void OpenStepCreate()
    {
        int nextSeq = _steps.Count > 0 ? ((_steps.Max(s => s.StepSeq) ?? 0) + 10) : 10;
        _f = new()
        {
            ItemNo      = _selItem?.ItemNo ?? "",
            RoutingType = ItemRouting(_selItem?.ItemNo),
            StepSeq     = nextSeq,
        };
        _confirmDelete = false; _modalErr = ""; _modal = "create";
    }

    void OpenStepEdit(MasterDataRepository.BopRow step)
    {
        _f = new()
        {
            BopId       = step.BOPID,
            ItemNo      = step.ItemNo         ?? "",
            RoutingType = ItemRouting(step.ItemNo, step.RoutingType),
            StepSeq     = step.StepSeq        ?? 10,
            StationCode = step.StationCode    ?? "",
            CycleTime   = step.StdCycleTime   ?? 0,
            SetupTime   = step.StdSetupTime   ?? 0,
            QcRequired  = step.QcRequiredFlag,
            StepDesc    = step.StepDescription ?? "",
            ActiveFlag  = step.ActiveFlag,
        };
        _confirmDelete = false; _modalErr = ""; _modal = "edit";
    }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.ItemNo))      { _modalErr = L["Err.ItemNoRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.RoutingType)) { _modalErr = L["Err.RoutingTypeRequired"]; return; }
        if (_f.StepSeq <= 0)                           { _modalErr = L["Err.StepSeqMin1"]; return; }
        _busy = true;
        try
        {
            var id = "P" + Guid.NewGuid().ToString("N")[..23];
            MD.InsertBopStep(id, _f.ItemNo.Trim().ToUpper(),
                NE(_f.RoutingType)?.ToUpper(), _f.StepSeq,
                NE(_f.StationCode),
                _f.CycleTime == 0 ? null : _f.CycleTime,
                _f.SetupTime == 0 ? null : _f.SetupTime,
                _f.QcRequired, NE(_f.StepDesc), _f.ActiveFlag, _actor);

            var newItemNo = _f.ItemNo.Trim().ToUpper();
            LoadItems();
            if (_selItem?.ItemNo != newItemNo)
                _selItem = _items.FirstOrDefault(i => i.ItemNo == newItemNo);

            LoadSteps(); CloseModal();
            await RestorePages();
            ShowMsg($"{newItemNo} Step {_f.StepSeq} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.RoutingType)) { _modalErr = L["Err.RoutingTypeRequired"]; return; }
        if (_f.StepSeq <= 0)                           { _modalErr = L["Err.StepSeqMin1"]; return; }
        _busy = true;
        try
        {
            MD.UpdateBopStep(_f.BopId, NE(_f.RoutingType)?.ToUpper(), _f.StepSeq,
                NE(_f.StationCode),
                _f.CycleTime == 0 ? null : _f.CycleTime,
                _f.SetupTime == 0 ? null : _f.SetupTime,
                _f.QcRequired, NE(_f.StepDesc), _f.ActiveFlag, _actor);
            LoadSteps(); CloseModal();
            await RestorePages();
            ShowMsg($"Step {_f.StepSeq} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        _busy = true;
        try
        {
            MD.DeleteBopStep(_f.BopId);
            LoadItems(); LoadSteps(); CloseModal();
            await RestorePages();
            ShowMsg($"Step {_f.StepSeq} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    RenderFragment StepFormFields(bool editMode) =>
    @<div>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
            <RadzenLabel Text='@($"{L["Col.ItemNo"]} *")' class="ames-rz-modal-label" Component="StepFormItemNo" />
            <RadzenDropDown AllowFiltering="true" Name="StepFormItemNo" @bind-Value="_f.ItemNo" Data="@ItemOptions" TextProperty="Text" ValueProperty="Value" Disabled="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" />
        </RadzenStack>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="6">
                <RadzenLabel Text="@L["Col.Routing"]" />
                <RadzenDropDown @bind-Value="_f.RoutingType" Data="@RoutingOptions" TextProperty="Text" ValueProperty="Value" Disabled="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenLabel Text='@($"{L["Col.StepSeq"]} *")' />
                <RadzenNumeric TValue="int" @bind-Value="_f.StepSeq" Min="1" Step="10" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="12">
                <RadzenLabel Text="@L["Col.Station"]" />
                <RadzenDropDown @bind-Value="_f.StationCode" Data="@StationOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" AllowFiltering="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="6">
                <RadzenLabel Text='@($"{L["Col.StdCycleTime"]} (s)")' />
                <RadzenNumeric TValue="decimal" @bind-Value="_f.CycleTime" Min="0" Step="0.1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenLabel Text='@($"{L["Col.StdSetupTime"]} (s)")' />
                <RadzenNumeric TValue="decimal" @bind-Value="_f.SetupTime" Min="0" Step="0.1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="8px" Style="margin-top:6px;">
            <RadzenColumn Size="12">
                <RadzenLabel Text="@L["Col.StepDesc"]" />
                <RadzenTextBox @bind-Value="_f.StepDesc" Placeholder='@L["MD.Bop.Ph.StepDesc"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem" Style="margin-top:8px;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.QcRequired" Name="StepFormChkQc" />
                <RadzenLabel Text="@L["MD.Bop.QcRequired"]" Component="StepFormChkQc" style="cursor:pointer;" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" Name="StepFormChkActive" />
