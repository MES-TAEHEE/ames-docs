@page "/md/rp/pm-template"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-027 @L["MD.PmTemplate.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-027" TitleKey="MD.PmTemplate.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.PmTemplate.Kpi.LoTo"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.SafetyLOTOFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.PmTemplate.Kpi.EquipTypes"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.EquipType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.PmTemplate.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder='@L["MD.LabelTemplate.Ph.Search"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />
            <RadzenLabel Text="@L["Col.EquipType"]" Component="DropDownEquipType" />
            <RadzenDropDown Name="DropDownEquipType" @bind-Value="_fEquipType" Data="@EquipTypeOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" />
            <RadzenLabel Text="@L["Col.Active"]" Component="DropDownActive" />
            <RadzenDropDown Name="DropDownActive" @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="MasterDataRepository.PmTemplateRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.PmTemplate.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="PMTemplateID" Title="@L["Col.TemplateId"]" Width="110px">
                <Template Context="r"><span class="code">@r.PMTemplateID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="TemplateName" Title="@L["Col.TemplateName"]">
                <Template Context="r">@(r.TemplateName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="EquipType" Title="@L["Col.EquipType"]" Width="110px">
                <Template Context="r"><span class="dim">@(r.EquipType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="CycleBasis" Title="@L["Col.BasisCycle"]" Width="100px">
                <Template Context="r"><span class="pill">@(r.CycleBasis ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="IntervalValue" Title="@L["Col.Cycle"]" Width="70px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.IntervalValue?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="IntervalUnit" Title="@L["Col.Uom"]" Width="80px">
                <Template Context="r"><span class="dim">@(r.IntervalUnit ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="StdDurationMin" Title="@L["Col.StdDuration"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.StdDurationMin?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="SafetyLOTOFlag" Title="@L["Col.LOTO"]" Width="72px" TextAlign="TextAlign.Center">
                <Template Context="r">@if (r.SafetyLOTOFlag) { <span class="pill warn">LOTO</span> }</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Property="ActiveFlag" Title="@L["Col.Status"]" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.PmTemplateRow" Title="@L["Col.CheckItems"]" Width="80px" TextAlign="TextAlign.Center" Sortable="false">
                <Template Context="r">
                    <span @onclick:stopPropagation="true">
                        <RadzenButton Icon="@(_expandedId == r.PMTemplateID ? "expand_less" : "expand_more")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => ToggleSteps(r.PMTemplateID))" class="ames-rz-btn" />
                    </span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (_expandedId != null && _steps.Count > 0)
    {
        <div class="ames-card-h" style="margin-top:12px;font-size:.9em;">▶ @L["MD.PmTemplate.Steps"] — <span class="code">@_expandedId</span></div>
        <table class="ames-table" style="font-size:.9em;">
            <thead>
                <tr>
                    <th class="num">@L["Col.Seq"]</th>
                    <th>@L["Col.CheckItem"]</th>
                    <th>@L["Col.PassCriteria"]</th>
                    <th>@L["Col.RequiredPart"]</th>
                    <th class="num">@L["Col.Qty"]</th>
                    <th class="num">@L["Col.DurationMin"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _steps)
                {
                    <tr>
                        <td class="num">@(s.StepSeq?.ToString() ?? "—")</td>
                        <td>@(s.StepDescription ?? "—")</td>
                        <td class="dim">@(s.AcceptanceCriteria ?? "—")</td>
                        <td class="dim">@(s.RequiredPartNo ?? "—")</td>
                        <td class="num">@(s.RequiredQty?.ToString("0.###") ?? "—")</td>
                        <td class="num">@(s.StepDurationMin?.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PmTemplate.Title"] — @L["Modal.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.TemplateId"]" />
                    <RadzenTextBox @bind-Value="_f.PMTemplateID" Placeholder="PM-001" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.TemplateName"]" />
                    <RadzenTextBox @bind-Value="_f.TemplateName" Placeholder='@L["MD.PmTemplate.Ph.TemplateName"]' AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.EquipType"]" />
                    <RadzenTextBox @bind-Value="_f.EquipType" Placeholder="INJECTION / PAINTING" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.BasisCycle"]" />
                    <RadzenDropDown @bind-Value="_f.CycleBasis" Data="@CycleBasisOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Cycle"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.IntervalValue" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Uom"]" />
                    <RadzenTextBox @bind-Value="_f.IntervalUnit" Placeholder="MONTH / WEEK / DAY / SHOT" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <RadzenLabel Text='@(L["Col.StdDuration"] + " (분)")' Style="margin-top:6px;" />
            <RadzenNumeric TValue="int?" @bind-Value="_f.StdDurationMin" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:50%;" />

            <div style="display:flex;gap:16px;margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.SafetyLOTOFlag" />
                    <span>@L["Col.LOTO"] 필요</span>
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.PmTemplate.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.PMTemplateID</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["Col.TemplateName"]" />
                    <RadzenTextBox @bind-Value="_f.TemplateName" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.EquipType"]" />
                    <RadzenTextBox @bind-Value="_f.EquipType" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.BasisCycle"]" />
                    <RadzenDropDown @bind-Value="_f.CycleBasis" Data="@CycleBasisOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Cycle"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.IntervalValue" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.Uom"]" />
                    <RadzenTextBox @bind-Value="_f.IntervalUnit" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@(L["Col.StdDuration"] + " (분)")' />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.StdDurationMin" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:flex;gap:16px;margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.SafetyLOTOFlag" />
                    <span>@L["Col.LOTO"] 필요</span>
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                    <span>@L["Lbl.Active"]</span>
                </label>
            </div>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.PmTemplateRow>     _allRows = new();
    List<MasterDataRepository.PmTemplateRow>     _rows    = new();
    List<MasterDataRepository.PmTemplateStepRow> _steps   = new();
    MasterDataRepository.PmTemplateRow? _sel;

    string _fSearch = "";
    string? _fEquipType, _fActive;
    string? _expandedId;
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    
    IEnumerable<DropDownItem> EquipTypeOptions => _allRows.Select(r => r.EquipType).Where(x => x != null).Distinct().OrderBy(x => x).Select(t => new DropDownItem { Value = t!, Text = t! });
    private List<DropDownItem> CycleBasisOptions => new()
    {
        new() { Value = "TIME",     Text = "TIME" },
        new() { Value = "COUNT",    Text = "COUNT" },
        new() { Value = "CALENDAR", Text = "CALENDAR" },
    };
    private List<DropDownItem> ActiveFilterOptions => new()
    {
        new() { Value = "Y", Text = L["Lbl.Active"].Value },
        new() { Value = "N", Text = L["Lbl.Inactive"].Value },
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/rp/pm-template");
        Reload();
    }

    void Reload()
    {
        try { _allRows = MD.ListPmTemplates(); } catch { _allRows = new(); }
        _expandedId = null;
        _steps      = new();
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.PMTemplateID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.TemplateName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fEquipType))
            _rows = _rows.Where(r => r.EquipType == _fEquipType).ToList();
        if (_fActive == "Y") _rows = _rows.Where(r => r.ActiveFlag).ToList();
        if (_fActive == "N") _rows = _rows.Where(r => !r.ActiveFlag).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }
    
    void RowRender(RowRenderEventArgs<MasterDataRepository.PmTemplateRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.PmTemplateRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void ToggleSteps(string templateId)
    {
        if (_expandedId == templateId) { _expandedId = null; _steps = new(); return; }
        _expandedId = templateId;
        try { _steps = MD.ListPmTemplateSteps(templateId); } catch { _steps = new(); }
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.PmTemplateRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            TemplateName   = r.TemplateName   ?? "",
            EquipType      = r.EquipType      ?? "",
            CycleBasis     = r.CycleBasis     ?? "",
            IntervalValue  = r.IntervalValue,
            IntervalUnit   = r.IntervalUnit   ?? "",
            StdDurationMin = r.StdDurationMin,
            SafetyLOTOFlag = r.SafetyLOTOFlag,
            ActiveFlag     = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.PMTemplateID)) { _modalErr = L["Err.TemplateIdRequired"]; return; }
        var id = _f.PMTemplateID.Trim();
        if (MD.PmTemplateExists(id)) { _modalErr = $"'{id}' ID가 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            MD.InsertPmTemplate(id, NE(_f.TemplateName), NE(_f.EquipType),
                NE(_f.CycleBasis), _f.IntervalValue, NE(_f.IntervalUnit),
                _f.StdDurationMin, _f.SafetyLOTOFlag, _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        _busy = true;
        try
        {
            MD.UpdatePmTemplate(_sel.PMTemplateID, NE(_f.TemplateName), NE(_f.EquipType),
                NE(_f.CycleBasis), _f.IntervalValue, NE(_f.IntervalUnit),
                _f.StdDurationMin, _f.SafetyLOTOFlag, _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_sel.PMTemplateID} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var id = _sel.PMTemplateID;
            MD.DeletePmTemplate(_sel.PMTemplateID);
            CloseModal(); Reload();
            ShowMsg($"{id} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string  PMTemplateID   { get; set; } = "";
        public string  TemplateName   { get; set; } = "";
        public string  EquipType      { get; set; } = "";
        public string  CycleBasis     { get; set; } = "";
        public int?    IntervalValue  { get; set; }
        public string  IntervalUnit   { get; set; } = "";
        public int?    StdDurationMin { get; set; }
        public bool    SafetyLOTOFlag { get; set; } = false;
        public bool    ActiveFlag     { get; set; } = true;
    }
}