@page "/md/rp/line"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-001 @L["MD.Line.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-001" TitleKey="MD.Line.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Line.Kpi.Rfid"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RfidEnabledFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Line.Kpi.Plants"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.PlantCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Line.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Line.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@LineStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.LineRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Line.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="LineID" Title="@L["Col.LineId"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="code">@r.LineID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="LineName" Title="@L["Col.LineName"]">
                <Template Context="r">@(r.LineName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="LineNameEn" Title="@L["Col.LineNameEn"]">
                <Template Context="r"><span class="dim">@(r.LineNameEn ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="PlantCode" Title="@L["Col.Plant"]" TextAlign="TextAlign.Center" Width="120px">
                <Template Context="r">
                    @{ var plantName = _plantCodes.FirstOrDefault(p => p.CodeValue == r.PlantCode) is { } pf ? MasterDataRepository.LocalName(pf) : r.PlantCode; }
                    <span class="dim">@(plantName ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="WCID" Title="@L["Col.WCID"]" Width="80px">
                <Template Context="r"><span class="dim" style="font-size:12px;">@(r.WCID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="DailyCap" Title="@L["Col.Capacity"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r">@(r.DailyCap?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="ShiftPattern" Title="@L["Col.Pattern"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r">
                    @if (r.ShiftPattern != null)
                    {
                        var shiftName = _shiftCodes.FirstOrDefault(c2 => c2.CodeValue == r.ShiftPattern) is { } scf ? MasterDataRepository.LocalName(scf) : null;
                        <span class="pill info">@r.ShiftPattern</span>
                        @if (shiftName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@shiftName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="RfidEnabledFlag" Title="@L["Col.RFID"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="r">
                    @if (r.RfidEnabledFlag) { <span class="pill ok">ON</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.LineRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r">
                    @{ var sLabel = _lineStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status; }
                    <span class="pill @(r.Status == "ACTIVE" ? "ok" : "bad")">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Line.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["MD.Line.Lbl.LineId"]" class="ames-rz-modal-label" Component="CreateTextBoxLineID" />
                <RadzenTextBox Name="CreateTextBoxLineID" @bind-Value="_f.LineID" Placeholder="INJ-L01" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["MD.Line.Lbl.LineName"]" class="ames-rz-modal-label" Component="CreateTextBoxLineName" />
                <RadzenTextBox Name="CreateTextBoxLineName" @bind-Value="_f.LineName" Placeholder="@L["MD.Line.Ph.LineName"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["MD.Line.Lbl.LineNameEn"]" class="ames-rz-modal-label" Component="CreateTextBoxLineNameEn" />
                <RadzenTextBox Name="CreateTextBoxLineNameEn" @bind-Value="_f.LineNameEn" Placeholder="Injection Line 1" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@(L["MD.Line.Lbl.Wcid"] + " *")' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.WCID" Data="@WcOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Plant"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.PlantCode" Data="@PlantOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Line.Lbl.DailyCap"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DailyCap" Placeholder="1000" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Line.Lbl.ShiftPattern"]" />
                    <RadzenDropDown @bind-Value="_f.ShiftPattern" Data="@ShiftOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@LineStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.RfidEnabledFlag" Name="CreateChkRfid" />
                <RadzenLabel Text="@L["MD.Line.Lbl.RfidEnabled"]" Component="CreateChkRfid" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Line.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.LineID</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["MD.Line.Lbl.LineName"]" class="ames-rz-modal-label" Component="EditTextBoxLineName" />
                <RadzenTextBox Name="EditTextBoxLineName" @bind-Value="_f.LineName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["MD.Line.Lbl.LineNameEn"]" class="ames-rz-modal-label" Component="EditTextBoxLineNameEn" />
                <RadzenTextBox Name="EditTextBoxLineNameEn" @bind-Value="_f.LineNameEn" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text='@(L["MD.Line.Lbl.Wcid"] + " *")' />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.WCID" Data="@WcOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Plant"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.PlantCode" Data="@PlantOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Line.Lbl.DailyCap"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DailyCap" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["MD.Line.Lbl.ShiftPattern"]" />
                    <RadzenDropDown @bind-Value="_f.ShiftPattern" Data="@ShiftOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@LineStatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:6px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.RfidEnabledFlag" Name="EditChkRfid" />
                <RadzenLabel Text="@L["MD.Line.Lbl.RfidEnabled"]" Component="EditChkRfid" style="cursor:pointer;" />
            </RadzenStack>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.LineRow>      _allRows       = new();
    List<MasterDataRepository.LineRow>      _rows          = new();
    List<MasterDataRepository.CodeItemRow>  _lineStatus    = new();
    List<MasterDataRepository.CodeItemRow>  _plantCodes    = new();
    List<MasterDataRepository.CodeItemRow>  _shiftCodes    = new();
    List<MasterDataRepository.WorkCenterRow> _wcList       = new();
    MasterDataRepository.LineRow? _sel;

    string  _fSearch = "";
    string? _fStatus;
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> LineStatusOptions => _lineStatus.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });
    private IEnumerable<DropDownItem> PlantOptions => _plantCodes.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });
    private IEnumerable<DropDownItem> WcOptions => _wcList.Where(w => w.ActiveFlag).Select(w => new DropDownItem { Value = w.WCID ?? "", Text = $"[{w.WCID}]{(w.WCName != null ? $" {w.WCName}" : "")}" });
    private IEnumerable<DropDownItem> ShiftOptions => _shiftCodes.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/rp/line");
        try { _lineStatus = MD.ListCodeItems("LINE_STATUS"); } catch { }
        try { _plantCodes = MD.ListCodeItems("PLANT"); } catch { }
        try { _shiftCodes = MD.ListCodeItems("SHIFT_PATTERN"); } catch { }
        try { _wcList = MD.ListWorkCenters(); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.LineRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _allRows = MD.ListLines(); ApplyFilter(); }

    void ApplyFilter()
    {
        _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) || r.LineID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase)
                                        || (r.LineName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    private void RowRender(RowRenderEventArgs<MasterDataRepository.LineRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.LineRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.LineRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            LineID          = r.LineID,
            LineName        = r.LineName        ?? "",
            LineNameEn      = r.LineNameEn      ?? "",
            PlantCode         = r.PlantCode         ?? "",
            WCID            = r.WCID            ?? "",
            DailyCap        = r.DailyCap,
            ShiftPattern    = r.ShiftPattern    ?? "",
            RfidEnabledFlag = r.RfidEnabledFlag,
            Status          = r.Status          ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.LineID))   { _modalErr = L["MD.Line.Err.IDRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.LineName)) { _modalErr = L["MD.Line.Err.NameRequired"]; return; }
        if (MD.LineExists(_f.LineID.Trim())) { _modalErr = string.Format(L["MD.Line.Err.IDExists"].Value, _f.LineID.Trim()); return; }
        if (string.IsNullOrWhiteSpace(_f.WCID)) { _modalErr = $"{L["MD.Line.Lbl.Wcid"]}: {L["Opt.Select"]}"; return; }
        _busy = true;
        try
        {
            MD.InsertLine(_f.LineID.Trim(), _f.LineName, NE(_f.LineNameEn),
                NE(_f.PlantCode), NE(_f.WCID),
                _f.DailyCap, NE(_f.ShiftPattern),
                _f.RfidEnabledFlag, _f.Status, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Line.Ok.Created"].Value, _f.LineName), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.LineName)) { _modalErr = L["MD.Line.Err.NameRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.WCID)) { _modalErr = $"{L["MD.Line.Lbl.Wcid"]}: {L["Opt.Select"]}"; return; }
        _busy = true;
        try
        {
            MD.UpdateLine(_sel.LineID, _f.LineName, NE(_f.LineNameEn),
                NE(_f.PlantCode), NE(_f.WCID),
                _f.DailyCap, NE(_f.ShiftPattern),
                _f.RfidEnabledFlag, _f.Status, _actor);
            var name = _f.LineName;
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Line.Ok.Updated"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.LineName ?? _sel.LineID;
            MD.DeleteLine(_sel.LineID);
            CloseModal(); await ReloadRestorePage();
            ShowMsg(string.Format(L["MD.Line.Ok.Deleted"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string LineID          { get; set; } = "";
        public string LineName        { get; set; } = "";
        public string LineNameEn      { get; set; } = "";
        public string PlantCode         { get; set; } = "";
