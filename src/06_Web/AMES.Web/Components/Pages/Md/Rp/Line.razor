@page "/md/rp/line"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>@L["MD.Line.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Line.Kpi.Rfid"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RfidEnabledFlag)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Line.Kpi.Plants"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.PlantCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Line.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder="@L["MD.Line.Ph.Search"]"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:120px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' />
            <RadzenLabel Text="@L["Col.Type"]" />
            <RadzenDropDown @bind-Value="_fType" Data="@LineTypeOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllTypes"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Status"]" />
            <RadzenDropDown @bind-Value="_fStatus" Data="@LineStatusOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllStatus"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.MasterDataRepository.LineRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="25"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    RowRender="@LineRowRender"
                    RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data); })"
                    EmptyText="@L["MD.Line.Empty"]"
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="LineID" Title="@L["Col.LineId"]" Width="100px">
                <Template Context="r"><span class="code">@r.LineID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="LineName" Title="@L["Col.LineName"]">
                <Template Context="r">@(r.LineName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="LineNameEn" Title="@L["Col.LineNameEn"]">
                <Template Context="r"><span class="dim">@(r.LineNameEn ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="LineType" Title="@L["Col.Type"]" Width="130px">
                <Template Context="r">
                    @{ var typeName = _lineTypeCodes.FirstOrDefault(c2 => c2.CodeValue == r.LineType) is { } ltf ? MasterDataRepository.LocalName(ltf) : null; }
                    <span class="pill @TypeClass(r.LineType)">@(r.LineType ?? "—")</span>
                    @if (typeName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@typeName</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="PlantCode" Title="@L["Col.Plant"]" Width="70px">
                <Template Context="r"><span class="code dim" style="font-size:12px;">@(r.PlantCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="DefaultWCID" Title="@L["Col.WCID"]" Width="80px">
                <Template Context="r"><span class="dim" style="font-size:12px;">@(r.DefaultWCID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="DailyCap" Title="@L["Col.Capacity"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.DailyCap?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="ShiftPattern" Title="@L["Col.Pattern"]" Width="130px">
                <Template Context="r">
                    @if (r.ShiftPattern != null)
                    {
                        var shiftName = _shiftCodes.FirstOrDefault(c2 => c2.CodeValue == r.ShiftPattern) is { } scf ? MasterDataRepository.LocalName(scf) : null;
                        <span class="pill info">@r.ShiftPattern</span>
                        @if (shiftName != null) { <span class="dim" style="font-size:.8em;margin-left:4px;">@shiftName</span> }
                    }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="RfidEnabledFlag" Title="@L["Col.RFID"]" Width="56px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.RfidEnabledFlag) { <span class="pill ok">ON</span> }
                    else { <span class="dim">—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.LineRow" Property="Status" Title="@L["Col.Status"]" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @{ var sLabel = _lineStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status; }
                    <span class="pill @(r.Status == "ACTIVE" ? "ok" : "bad")">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Line.Modal.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@(L["MD.Line.Lbl.LineId"] + "  (예: INJ-L01)")' />
                    <RadzenTextBox @bind-Value="_f.LineID" Placeholder="INJ-L01" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.LineName"]" />
                    <RadzenTextBox @bind-Value="_f.LineName" Placeholder="@L["MD.Line.Ph.LineName"]" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.LineNameEn"]" />
                    <RadzenTextBox @bind-Value="_f.LineNameEn" Placeholder="Injection Line 1" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.LineType"]" />
                    <RadzenDropDown @bind-Value="_f.LineType" Data="@LineTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.PlantId"]" />
                    <RadzenDropDown @bind-Value="_f.PlantCode" Data="@PlantOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.DefaultWcid"]" />
                    <RadzenDropDown @bind-Value="_f.DefaultWCID" Data="@WcOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.DailyCap"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DailyCap" Placeholder="1000" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.ShiftPattern"]" />
                    <RadzenDropDown @bind-Value="_f.ShiftPattern" Data="@ShiftOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <RadzenLabel Text="@L["Col.Status"]" Style="margin-top:6px;" />
            <RadzenDropDown @bind-Value="_f.Status" Data="@LineStatusOptions" TextProperty="Text" ValueProperty="Value"
                            Placeholder="@L["Opt.Select"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />

            <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.RfidEnabledFlag" />
                <span>@L["MD.Line.Lbl.RfidEnabled"]</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Line.Modal.Edit"] — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.LineID</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.LineName"]" />
                    <RadzenTextBox @bind-Value="_f.LineName" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.LineNameEn"]" />
                    <RadzenTextBox @bind-Value="_f.LineNameEn" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.LineType"]" />
                    <RadzenDropDown @bind-Value="_f.LineType" Data="@LineTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.PlantId"]" />
                    <RadzenDropDown @bind-Value="_f.PlantCode" Data="@PlantOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.DefaultWcid"]" />
                    <RadzenDropDown @bind-Value="_f.DefaultWCID" Data="@WcOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.DailyCap"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DailyCap" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["MD.Line.Lbl.ShiftPattern"]" />
                    <RadzenDropDown @bind-Value="_f.ShiftPattern" Data="@ShiftOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@LineStatusOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.RfidEnabledFlag" />
                <span>@L["MD.Line.Lbl.RfidEnabled"]</span>
            </label>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.LineRow>      _allRows       = new();
    List<AMES.Data.Repositories.MasterDataRepository.LineRow>      _rows          = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow>  _lineTypeCodes = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow>  _lineStatus    = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow>  _plantCodes    = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow>  _shiftCodes    = new();
    List<AMES.Data.Repositories.MasterDataRepository.WorkCenterRow> _wcList       = new();
    AMES.Data.Repositories.MasterDataRepository.LineRow? _sel;

    string  _fSearch = "";
    string? _fType;
    string? _fStatus;

    readonly IEnumerable<int> _pageSizeOptions = new[] { 15, 30, 50, 100 };

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> LineTypeOptions =>
        _lineTypeCodes.Where(c => c.UseFlag)
            .Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    private IEnumerable<DropDownItem> LineStatusOptions =>
        _lineStatus.Where(s => s.UseFlag)
            .Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });

    private IEnumerable<DropDownItem> PlantOptions =>
        _plantCodes.Where(c => c.UseFlag)
            .Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    private IEnumerable<DropDownItem> WcOptions =>
        _wcList.Where(w => w.ActiveFlag)
            .Select(w => new DropDownItem { Value = w.WCID ?? "", Text = $"[{w.WCID}]{(w.WCName != null ? $" {w.WCName}" : "")}" });

    private IEnumerable<DropDownItem> ShiftOptions =>
        _shiftCodes.Where(c => c.UseFlag)
            .Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    private void LineRowRender(RowRenderEventArgs<AMES.Data.Repositories.MasterDataRepository.LineRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rp/line");
        try { _lineTypeCodes = Md.ListCodeItems("LINE_TYPE");   } catch { }
        try { _lineStatus    = Md.ListCodeItems("LINE_STATUS"); } catch { }
        try { _plantCodes    = Md.ListCodeItems("PLANT");       } catch { }
        try { _shiftCodes    = Md.ListCodeItems("WORK_SHIFT");  } catch { }
        try { _wcList        = Md.ListWorkCenters();            } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListLines(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) || r.LineID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase)
                                        || (r.LineName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fType)   || r.LineType == _fType) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status   == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.LineRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            LineID          = r.LineID,
            LineName        = r.LineName        ?? "",
            LineNameEn      = r.LineNameEn      ?? "",
            LineType        = r.LineType        ?? "",
            PlantCode         = r.PlantCode         ?? "",
            DefaultWCID     = r.DefaultWCID     ?? "",
            DailyCap        = r.DailyCap,
            ShiftPattern    = r.ShiftPattern    ?? "",
            RfidEnabledFlag = r.RfidEnabledFlag,
            Status          = r.Status          ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.LineID))   { _modalErr = L["MD.Line.Err.IDRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.LineName)) { _modalErr = L["MD.Line.Err.NameRequired"]; return; }
        if (Md.LineExists(_f.LineID.Trim()))         { _modalErr = string.Format(L["MD.Line.Err.IDExists"].Value, _f.LineID.Trim()); return; }
        _busy = true;
        try
        {
            Md.InsertLine(_f.LineID.Trim(), _f.LineName, NE(_f.LineNameEn), NE(_f.LineType),
                NE(_f.PlantCode), NE(_f.DefaultWCID),
                _f.DailyCap, NE(_f.ShiftPattern),
                _f.RfidEnabledFlag, _f.Status, _actor);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Line.Ok.Created"].Value, _f.LineName), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.LineName)) { _modalErr = L["MD.Line.Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateLine(_sel.LineID, _f.LineName, NE(_f.LineNameEn), NE(_f.LineType),
                NE(_f.PlantCode), NE(_f.DefaultWCID),
                _f.DailyCap, NE(_f.ShiftPattern),
                _f.RfidEnabledFlag, _f.Status, _actor);
            var name = _f.LineName;
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Line.Ok.Updated"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.LineName ?? _sel.LineID;
            Md.DeleteLine(_sel.LineID);
            CloseModal(); Reload();
            ShowMsg(string.Format(L["MD.Line.Ok.Deleted"].Value, name), false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string TypeClass(string? t) => t switch
    {
        "INJ" => "info",
        "IMG" => "warn",
        "PNT" => "bad",
        "QC"  => "ok",
        "WH"  => "",
        "FG"  => "ok",
        _     => ""
    };

