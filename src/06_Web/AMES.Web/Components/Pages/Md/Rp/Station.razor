@page "/md/rp/station"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L

<PageTitle>MD-002 @L["MD.Station.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-002" TitleKey="MD.Station.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Station.Kpi.Lines"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Station.Kpi.Types"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessCode).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Station.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.Station.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:300px;" />
            <RadzenLabel Text="@L["Col.Line"]" Component="DropDownLine" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownLine" @bind-Value="_fLine" Data="@LineFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:280px;" />
            <RadzenLabel Text="@L["Col.Status"]" Component="DropDownStatus" />
            <RadzenDropDown Name="DropDownStatus" @bind-Value="_fStatus" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:150px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.StationRow" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.Station.Empty"]" Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="MasterDataRepository.StationRow" Property="StationCode" Title="@L["Col.StationCode"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="code">@r.StationCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.StationRow" Property="StationName" Title="@L["Col.StationName"]">
                <Template Context="r">@(r.StationName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.StationRow" Property="StationNameEn" Title="@L["Col.StationNameEn"]">
                <Template Context="r"><span class="dim">@(r.StationNameEn ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.StationRow" Property="LineID" Title="@L["Col.Line"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r"><span class="dim">@(r.LineID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.StationRow" Property="OrderSeq" Title="@L["Col.Seq"]" TextAlign="TextAlign.Center" Width="70px">
                <Template Context="r">@(r.OrderSeq?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.StationRow" Property="Status" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r">
                    @{
                        var scls   = r.Status == "ACTIVE" ? "ok" : "bad";
                        var sLabel = _stationStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } lf ? MasterDataRepository.LocalName(lf) : r.Status;
                    }
                    <span class="pill @scls">@(sLabel ?? "—")</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Station.Title"] — @L["Modal.Create"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@($"{L["Col.StationCode"]} *")' class="ames-rz-modal-label" Component="CreateTextBoxStationCode" />
                <RadzenTextBox Name="CreateTextBoxStationCode" @bind-Value="_f.StationCode" Placeholder="ST-INJ-001" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text='@(L["Col.StationName"] + " *")' class="ames-rz-modal-label" Component="CreateTextBoxStationName" />
                <RadzenTextBox Name="CreateTextBoxStationName" @bind-Value="_f.StationName" Placeholder="@L["MD.Station.Ph.StationName"]" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["Col.StationNameEn"]" class="ames-rz-modal-label" Component="CreateTextBoxStationNameEn" />
                <RadzenTextBox Name="CreateTextBoxStationNameEn" @bind-Value="_f.StationNameEn" Placeholder="Injection Process 1" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Line"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.OrderSeq"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.OrderSeq" Placeholder="10" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal ames-modal-wide" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Station.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.StationCode</span></div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text='@(L["Col.StationName"] + " *")' class="ames-rz-modal-label" Component="EditTextBoxStationName" />
                <RadzenTextBox Name="EditTextBoxStationName" @bind-Value="_f.StationName" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["Col.StationNameEn"]" class="ames-rz-modal-label" Component="EditTextBoxStationNameEn" />
                <RadzenTextBox Name="EditTextBoxStationNameEn" @bind-Value="_f.StationNameEn" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Line"]" />
                    <RadzenDropDown AllowFiltering="true" @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value" AllowClear="true" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.OrderSeq"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.OrderSeq" Min="1" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@L["Col.Status"]" />
                    <RadzenDropDown @bind-Value="_f.Status" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;
    List<MasterDataRepository.StationRow>  _allRows       = new();
    List<MasterDataRepository.StationRow>  _rows          = new();
    List<MasterDataRepository.CodeItemRow> _stationStatus = new();
    List<MasterDataRepository.LineRow>     _lineList      = new();
    MasterDataRepository.StationRow? _sel;

    string  _fSearch = "";
    string? _fLine;
    string? _fStatus;
    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    private IEnumerable<DropDownItem> LineFilterOptions => _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = MasterDataRepository.LocalName(l.LineName, l.LineNameEn) is { Length: > 0 } nm ? $"[{l.LineID}] {nm}" : $"[{l.LineID}]" });
    private IEnumerable<DropDownItem> LineOptions => _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = MasterDataRepository.LocalName(l.LineName, l.LineNameEn) is { Length: > 0 } nm ? $"[{l.LineID}] {nm}" : $"[{l.LineID}]" });
    private IEnumerable<DropDownItem> StatusOptions => _stationStatus.Where(s => s.UseFlag).Select(s => new DropDownItem { Value = s.CodeValue ?? "", Text = $"[{s.CodeValue}] {MasterDataRepository.LocalName(s)}" });

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/rp/station");
        try { _stationStatus = MD.ListCodeItems("STATION_STATUS"); } catch { }
        try { _lineList = MD.ListLines(); } catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.StationRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { _allRows = MD.ListStations(); ApplyFilter(); }

    void ApplyFilter()
    {
        _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.StationCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.StationName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine) || r.LineID == _fLine) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status == _fStatus)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    private void RowRender(RowRenderEventArgs<MasterDataRepository.StationRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.StationRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.StationRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            StationCode   = r.StationCode,
            StationName   = r.StationName   ?? "",
            StationNameEn = r.StationNameEn ?? "",
            LineID        = r.LineID        ?? "",
            OrderSeq    = r.OrderSeq,
            Status      = r.Status      ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.StationCode))   { _modalErr = L["Err.StationIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.StationName)) { _modalErr = L["Err.StationNameRequired"]; return; }
        if (MD.StationExists(_f.StationCode.Trim()))     { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], _f.StationCode.Trim()); return; }
        _busy = true;
        try
        {
            MD.InsertStation(_f.StationCode.Trim(), _f.StationName, NE(_f.StationNameEn), NE(_f.LineID),
                _f.OrderSeq, _f.Status, _actor);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{_f.StationName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.StationName)) { _modalErr = L["Err.StationNameRequired"]; return; }
        _busy = true;
        try
        {
            MD.UpdateStation(_sel.StationCode, _f.StationName, NE(_f.StationNameEn), NE(_f.LineID),
                _f.OrderSeq, _f.Status, _actor);
            var name = _f.StationName;
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.StationName ?? _sel.StationCode;
            MD.DeleteStation(_sel.StationCode);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    class FormModel
    {
        public string StationCode    { get; set; } = "";
        public string StationName    { get; set; } = "";
        public string StationNameEn  { get; set; } = "";
        public string LineID       { get; set; } = "";
        public int?   OrderSeq     { get; set; }
        public string Status       { get; set; } = "ACTIVE";
    }
}