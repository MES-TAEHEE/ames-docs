@page "/md/rp/station"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Station.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-002" TitleKey="MD.Station.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.Station.Kpi.Lines"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.Station.Kpi.Types"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.StationType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Station.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:140px;padding:4px 8px;"
                   placeholder="@L["MD.Station.Ph.Search"]" @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Line"]</span>
            <select class="ames-input" style="width:130px;" @bind="_fLine">
                <option value="">@L["Filter.AllLines"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">@l.LineID@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:130px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _allRows.Select(r => r.StationType).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@t">@t</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:140px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _stationStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Station.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.ProcessId"]</th><th>@L["Col.ProcessName"]</th><th>@L["Col.ProcessNameEn"]</th><th>@L["Col.Line"]</th><th>@L["Col.Type"]</th>
                    <th>@L["Col.Code"]</th><th style="text-align:right;">@L["Col.Seq"]</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.StationCode</td>
                        <td>@(r.StationName ?? "—")</td>
                        <td class="dim">@(r.StationNameEn ?? "—")</td>
                        <td class="dim">@(r.LineID ?? "—")</td>
                        <td><span class="pill">@(r.StationType ?? "—")</span></td>
                        <td class="dim">@(r.ProcessCode ?? "—")</td>
                        <td style="text-align:right;">@(r.OrderSeq?.ToString() ?? "—")</td>
                        <td>
                            @{
                                var scls   = r.Status == "ACTIVE" ? "ok" : "bad";
                                var sLabel = _stationStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } _lf_ ? MasterDataRepository.LocalName(_lf_) : r.Status;
                            }
                            <span class="pill @scls">@(sLabel ?? "—")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Station.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.StationCode"] * <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: ST-INJ-001)</span></label>
            <input class="ames-input" @bind="_f.StationCode" placeholder="ST-INJ-001" autocomplete="off" />

            <label>@L["Col.StationName"] *</label>
            <input class="ames-input" @bind="_f.StationName" placeholder='@L["MD.Station.Ph.StationName"]' autocomplete="off" />

            <label>@L["Col.ProcessNameEn"]</label>
            <input class="ames-input" @bind="_f.StationNameEn" placeholder="Injection Process 1" autocomplete="off" />

            <label>@L["Col.LineId"]</label>
            <select class="ames-input" @bind="_f.LineID">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">[@l.LineID]@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>

            <label>@L["Col.ProcessType"]</label>
            <input class="ames-input" @bind="_f.StationType" placeholder="INJECTION, ASSEMBLY 등" autocomplete="off" />

            <label>@L["Col.ProcessCode"]</label>
            <input class="ames-input" @bind="_f.ProcessCode" placeholder="INJ" maxlength="10" autocomplete="off" />

            <label>@L["Col.OrderSeq"]</label>
            <input class="ames-input" type="number" @bind="_f.OrderSeq" placeholder="10" min="1" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _stationStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Station.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.StationCode</span></div>

            <label>@L["Col.StationName"] *</label>
            <input class="ames-input" @bind="_f.StationName" autocomplete="off" />

            <label>@L["Col.ProcessNameEn"]</label>
            <input class="ames-input" @bind="_f.StationNameEn" autocomplete="off" />

            <label>@L["Col.LineId"]</label>
            <select class="ames-input" @bind="_f.LineID">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">[@l.LineID]@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>

            <label>@L["Col.ProcessType"]</label>
            <input class="ames-input" @bind="_f.StationType" autocomplete="off" />

            <label>@L["Col.ProcessCode"]</label>
            <input class="ames-input" @bind="_f.ProcessCode" maxlength="10" autocomplete="off" />

            <label>@L["Col.OrderSeq"]</label>
            <input class="ames-input" type="number" @bind="_f.OrderSeq" min="1" autocomplete="off" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _stationStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Edit"])</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.StationRow>  _allRows       = new();
    List<AMES.Data.Repositories.MasterDataRepository.StationRow>  _rows          = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _stationStatus = new();
    List<AMES.Data.Repositories.MasterDataRepository.LineRow>     _lineList      = new();
    AMES.Data.Repositories.MasterDataRepository.StationRow? _sel;

    int _page = 0;
    const int _pageSize = 20;

    string _fSearch = "", _fLine = "", _fType = "", _fStatus = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rp/station");
        try { _stationStatus = Md.ListCodeItems("STATION_STATUS"); } catch { }
        try { _lineList       = Md.ListLines();                    } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListStations(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.StationCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.StationName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineID      == _fLine) &&
        (string.IsNullOrEmpty(_fType)   || r.StationType == _fType) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status      == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.StationRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            StationCode   = r.StationCode,
            StationName   = r.StationName   ?? "",
            StationNameEn = r.StationNameEn ?? "",
            LineID        = r.LineID        ?? "",
            StationType = r.StationType ?? "",
            ProcessCode = r.ProcessCode ?? "",
            OrderSeq    = r.OrderSeq,
            Status      = r.Status      ?? "ACTIVE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.StationCode))   { _modalErr = L["Err.StationIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.StationName)) { _modalErr = L["Err.StationNameRequired"]; return; }
        if (Md.StationExists(_f.StationCode.Trim()))     { _modalErr = $"공정 ID '{_f.StationCode.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertStation(_f.StationCode.Trim(), _f.StationName, NE(_f.StationNameEn), NE(_f.LineID),
                NE(_f.StationType), NE(_f.ProcessCode), _f.OrderSeq, _f.Status, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.StationName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.StationName)) { _modalErr = L["Err.StationNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateStation(_sel.StationCode, _f.StationName, NE(_f.StationNameEn), NE(_f.LineID),
                NE(_f.StationType), NE(_f.ProcessCode), _f.OrderSeq, _f.Status, _actor);
            var name = _f.StationName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.StationName ?? _sel.StationCode;
            Md.DeleteStation(_sel.StationCode);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string StationCode    { get; set; } = "";
        public string StationName    { get; set; } = "";
        public string StationNameEn  { get; set; } = "";
        public string LineID       { get; set; } = "";
        public string StationType  { get; set; } = "";
        public string ProcessCode  { get; set; } = "";
        public int?   OrderSeq     { get; set; }
        public string Status       { get; set; } = "ACTIVE";
    }
}
