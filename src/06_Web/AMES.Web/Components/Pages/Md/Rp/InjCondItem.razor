@page "/md/rp/inj-cond-item"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using AMES.Web.Services
@using Radzen

@attribute [Authorize]

@inject AuthenticationStateProvider AuthPrvd
@inject PermissionService PermSvc
@inject MasterDataRepository MD
@inject IStringLocalizer<SharedResources> L
@inject AMES.Web.Services.AuditLogger Audit

<PageTitle>MD-035 @L["MD.InjCond.Title"] · AMES</PageTitle>
<AmesPageHeader Code="MD-035" TitleKey="MD.InjCond.Title" />

@* ── KPI strip ──────────────────────────────────────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["MD.InjCond.Kpi.Enabled"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Enabled)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.InjCond.Kpi.Lines"]</div>
        <div class="ames-kpi-v">@_allRows.Where(r => r.Enabled).Select(r => r.LineID).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.InjCond.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["MD.InjCond.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:220px;" />
            <RadzenLabel Text="@L["Col.Line"]" Component="DropDownLine" />
            <RadzenDropDown Name="DropDownLine" @bind-Value="_fLine" Data="LineFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:280px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit)
            {
                <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" />
            }
        </RadzenStack>
    </div>

    <RadzenDataGrid @ref="_pgGrid" Page="OnPgPage" TItem="MasterDataRepository.InjCondItemRow" Data="@_rows" AllowPaging="true" PageSize="25" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" PagingSummaryFormat="@L["Pager.Summary"]" PageSizeText="@L["Pager.PageSize"]" RowClick="@OnRowClick" RowRender="@RowRender" EmptyText="@L["MD.InjCond.Empty"]" PageSizeChanged="@(s => _pageRows = s)" Style="@($"--ames-page-rows:{_pageRows}")" Class="ames-rz-grid ames-grid-fixed">
        <Columns>
            @* 행 번호 — 정렬·페이지를 반영한 화면상의 순번 *@
            <RadzenDataGridColumn TItem="MasterDataRepository.InjCondItemRow" Title="@L["Col.RowNo"]" Width="60px" MinWidth="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                <Template Context="rn"><span class="dim">@GridRowNo.Of(_pgGrid, rn)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InjCondItemRow" Property="LineID" Title="@L["Col.Line"]" Width="200px" MinWidth="200px">
                <Template Context="r"><span class="code">@r.LineID</span> <span class="dim">@LineName(r.LineID)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InjCondItemRow" Property="ItemCode" Title="@L["MD.InjCond.Col.ItemCode"]" Width="130px" MinWidth="130px">
                <Template Context="r"><span class="code">@r.ItemCode</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InjCondItemRow" Property="ItemName" Title="@L["MD.InjCond.Col.ItemName"]" MinWidth="160px">
                <Template Context="r">@(r.ItemName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InjCondItemRow" Property="SetAddress" Title="@L["MD.InjCond.Col.SetAddress"]" TextAlign="TextAlign.Right" Width="130px" MinWidth="130px">
                <Template Context="r">@(r.SetAddress?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InjCondItemRow" Property="ActualAddress" Title="@L["MD.InjCond.Col.ActualAddress"]" TextAlign="TextAlign.Right" Width="130px" MinWidth="130px">
                <Template Context="r">@(r.ActualAddress?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InjCondItemRow" Property="DataType" Title="@L["MD.InjCond.Col.DataType"]" TextAlign="TextAlign.Center" Width="110px" MinWidth="110px">
                <Template Context="r"><span class="pill">@r.DataType</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MasterDataRepository.InjCondItemRow" Property="Enabled" Title="@L["MD.InjCond.Col.Enabled"]" TextAlign="TextAlign.Center" Width="100px" MinWidth="100px">
                <Template Context="r">
                    @if (r.Enabled) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:560px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.InjCond.Title"] — @L["Modal.Create"]</div>

            <RadzenRow Gap="8px">
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@(L["Col.Line"].Value + " *")" Component="CreateDropDownLine" />
                    <RadzenDropDown Name="CreateDropDownLine" @bind-Value="_f.LineID" Data="LineOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Opt.Select"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenLabel Text="@(L["MD.InjCond.Col.ItemCode"].Value + " *")" Component="CreateTextBoxItemCode" />
                    <RadzenTextBox Name="CreateTextBoxItemCode" @bind-Value="_f.ItemCode" MaxLength="20" Placeholder="TEMP" AutoComplete="false" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;margin-top:6px;">
                <RadzenLabel Text="@L["MD.InjCond.Col.ItemName"]" class="ames-rz-modal-label" Component="CreateTextBoxItemName" />
                <RadzenTextBox Name="CreateTextBoxItemName" @bind-Value="_f.ItemName" MaxLength="50" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MD.InjCond.Col.SetAddress"]" Component="@(_modal == "create" ? "CreateNumericSetAddress" : "EditNumericSetAddress")" />
                    <RadzenNumeric Name="@(_modal == "create" ? "CreateNumericSetAddress" : "EditNumericSetAddress")" TValue="int?" @bind-Value="_f.SetAddress" Min="0" Placeholder="5400" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MD.InjCond.Col.ActualAddress"]" Component="@(_modal == "create" ? "CreateNumericActualAddress" : "EditNumericActualAddress")" />
                    <RadzenNumeric Name="@(_modal == "create" ? "CreateNumericActualAddress" : "EditNumericActualAddress")" TValue="int?" @bind-Value="_f.ActualAddress" Min="0" Placeholder="5404" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@(L["MD.InjCond.Col.DataType"].Value + " *")" Component="@(_modal == "create" ? "CreateDropDownDataType" : "EditDropDownDataType")" />
                    <RadzenDropDown Name="@(_modal == "create" ? "CreateDropDownDataType" : "EditDropDownDataType")" @bind-Value="_f.DataType" Data="MasterDataRepository.InjCondDataTypes" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.Enabled" Name="CreateChkEnabled" />
                <RadzenLabel Text="@L["MD.InjCond.Lbl.Enabled"]" Component="CreateChkEnabled" style="cursor:pointer;" />
            </RadzenStack>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Click="@SaveCreate" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ──────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" style="max-width:560px;" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.InjCond.Title"] — @L["Modal.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.LineID · @_sel.ItemCode</span></div>

            <div class="dim" style="font-size:.9em;margin-bottom:6px;">@L["MD.InjCond.Hint.Keys"]</div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:100%;">
                <RadzenLabel Text="@L["MD.InjCond.Col.ItemName"]" class="ames-rz-modal-label" Component="EditTextBoxItemName" />
                <RadzenTextBox Name="EditTextBoxItemName" @bind-Value="_f.ItemName" MaxLength="50" InputSize="InputSize.Small" class="ames-rz-input" Style="flex:1;width:100%;" AutoCompleteType="AutoCompleteType.Off" />
            </RadzenStack>

            <RadzenRow Gap="8px" Style="margin-top:6px;">
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MD.InjCond.Col.SetAddress"]" Component="@(_modal == "create" ? "CreateNumericSetAddress" : "EditNumericSetAddress")" />
                    <RadzenNumeric Name="@(_modal == "create" ? "CreateNumericSetAddress" : "EditNumericSetAddress")" TValue="int?" @bind-Value="_f.SetAddress" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@L["MD.InjCond.Col.ActualAddress"]" Component="@(_modal == "create" ? "CreateNumericActualAddress" : "EditNumericActualAddress")" />
                    <RadzenNumeric Name="@(_modal == "create" ? "CreateNumericActualAddress" : "EditNumericActualAddress")" TValue="int?" @bind-Value="_f.ActualAddress" Min="0" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenLabel Text="@(L["MD.InjCond.Col.DataType"].Value + " *")" Component="@(_modal == "create" ? "CreateDropDownDataType" : "EditDropDownDataType")" />
                    <RadzenDropDown Name="@(_modal == "create" ? "CreateDropDownDataType" : "EditDropDownDataType")" @bind-Value="_f.DataType" Data="MasterDataRepository.InjCondDataTypes" InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Style="margin-top:8px;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.Enabled" Name="EditChkEnabled" />
                <RadzenLabel Text="@L["MD.InjCond.Lbl.Enabled"]" Component="EditChkEnabled" style="cursor:pointer;" />
            </RadzenStack>

            @* 삭제 버튼 클릭 후 인라인 확인 *@
            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Save"])" Click="@SaveEdit" Disabled="@_busy" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Click="@CloseModal" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100 };
    bool _showPagerSummary = true;
    int  _pageRows = 25;   // 고정 페이저: 본문 높이 = 헤더 + 페이지 행 수 × 행 높이(.ames-grid-fixed)
    List<MasterDataRepository.InjCondItemRow> _allRows = new();
    List<MasterDataRepository.InjCondItemRow> _rows    = new();
    List<MasterDataRepository.LineRow> _lines = new();
    HashSet<string> _injLines = new(StringComparer.OrdinalIgnoreCase);
    MasterDataRepository.InjCondItemRow? _sel;

    string _fSearch = "";
    string? _fLine;
    string _modal = "", _modalErr = "", _msg = "";
    bool _busy, _bgMouseDownOnSelf, _isErr, _confirmDelete;
    bool _canEdit;
    string _actor = "system";

    FormModel _f = new();

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    // 등록 후보 = 사출(INJ) 공정 작업장의 라인 — InjAgent 가 수집하는 라인
    IEnumerable<DropDownItem> LineOptions => _lines
        .Where(l => _injLines.Contains(l.LineID) && l.Status != "INACTIVE")
        .Select(l => new DropDownItem { Value = l.LineID, Text = $"[{l.LineID}] {l.LineName}" });
    IEnumerable<DropDownItem> LineFilterOptions => _allRows.Select(r => r.LineID).Distinct()
        .Select(id => new DropDownItem { Value = id, Text = $"[{id}] {LineName(id)}" });

    string LineName(string lineId) => _lines.FirstOrDefault(l => l.LineID == lineId)?.LineName ?? "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthPrvd.GetAuthenticationStateAsync();
        _actor = AMES.Web.Services.ActorCode.Of(auth.User, "system");
        await PermSvc.EnsureAsync(AuthPrvd);
        _canEdit = PermSvc.CanEdit("md/rp/inj-cond-item");
        try { _lines = MD.ListLines(); } catch { }
        try
        {
            var injWc = MD.ListWorkCenters().Where(w => w.ProcessCode == "INJ").Select(w => w.WCID).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _injLines = _lines.Where(l => l.WCID != null && injWc.Contains(l.WCID)).Select(l => l.LineID).ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        catch { }
        Reload();
    }

    RadzenDataGrid<MasterDataRepository.InjCondItemRow>? _pgGrid;
    int _pgIndex;
    void OnPgPage(PagerEventArgs args) => _pgIndex = args.PageIndex;

    async Task ReloadRestorePage()
    {
        Reload();
        await InvokeAsync(StateHasChanged);
        if (_pgGrid is not null)
        {
            int pages = Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pgGrid.PageSize));
            await _pgGrid.GoToPage(Math.Min(_pgIndex, pages - 1));
        }
    }

    void Reload() { try { _allRows = MD.ListInjCondItems(); } catch { _allRows = new(); } ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.ItemCode.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (_fLine == null || r.LineID == _fLine)
    ).ToList();
    }

    void OnSearchChanged(string value) => _fSearch = value ?? "";

    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    void RowRender(RowRenderEventArgs<MasterDataRepository.InjCondItemRow> args)
    {
        if (args.Attributes.TryGetValue("class", out var existing))
            args.Attributes["class"] = existing + " ames-row-link";
        else
            args.Attributes["class"] = "ames-row-link";
    }

    void OnRowClick(DataGridRowMouseEventArgs<MasterDataRepository.InjCondItemRow> args)
    {
        if (args.Data is not null) OpenEdit(args.Data);
    }

    void OpenCreate() { _f = new() { LineID = _fLine }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(MasterDataRepository.InjCondItemRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            LineID        = r.LineID,
            ItemCode      = r.ItemCode,
            ItemName      = r.ItemName ?? "",
            SetAddress    = r.SetAddress,
            ActualAddress = r.ActualAddress,
            DataType      = r.DataType,
            Enabled       = r.Enabled,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    async Task SaveCreate()
    {
        if (!_canEdit) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.LineID))   { _modalErr = L["MD.InjCond.Err.LineRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.ItemCode)) { _modalErr = L["MD.InjCond.Err.CodeRequired"]; return; }
        var code = _f.ItemCode.Trim();
        if (MD.InjCondItemExists(_f.LineID, code)) { _modalErr = string.Format(L["Err.AlreadyExistsFmt"], $"{_f.LineID} · {code}"); return; }
        _busy = true;
        try
        {
            MD.InsertInjCondItem(_f.LineID, code, NE(_f.ItemName), _f.SetAddress, _f.ActualAddress, _f.DataType, _f.Enabled, _actor);
            Audit.Created("MD-035", "MD_InjCondItem", $"{_f.LineID}/{code}", _f);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{code} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveEdit()
    {
        if (!_canEdit) return;
        if (_sel is null) return;
        _busy = true;
        try
        {
            MD.UpdateInjCondItem(_sel.CondItemID, NE(_f.ItemName), _f.SetAddress, _f.ActualAddress, _f.DataType, _f.Enabled, _actor);
            Audit.Updated("MD-035", "MD_InjCondItem", $"{_sel.LineID}/{_sel.ItemCode}", _sel, _f);
            var key = _sel.ItemCode;   // CloseModal 이 _sel 을 비우므로 먼저 꺼내 둔다
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{key} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    async Task SaveDelete()
    {
        if (!_canEdit) return;
        if (_sel is null) return;
        _busy = true;
        try
        {
            var key = _sel.ItemCode;
            MD.DeleteInjCondItem(_sel.CondItemID);
            Audit.Deleted("MD-035", "MD_InjCondItem", $"{_sel.LineID}/{_sel.ItemCode}", _sel);
            CloseModal(); await ReloadRestorePage();
            ShowMsg($"{key} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    class FormModel
    {
        public string? LineID        { get; set; }
        public string  ItemCode      { get; set; } = "";
        public string  ItemName      { get; set; } = "";
        public int?    SetAddress    { get; set; }
        public int?    ActualAddress { get; set; }
        public string  DataType      { get; set; } = "LONG";
        public bool    Enabled       { get; set; } = true;
    }
}
