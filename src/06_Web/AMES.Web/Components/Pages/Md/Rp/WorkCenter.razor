@page "/md/rp/work-center"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.WorkCenter.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-006" TitleKey="MD.WorkCenter.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.WorkCenter.Kpi.Lines"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.WorkCenter.Kpi.Types"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.WorkCenter.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:140px;padding:4px 8px;"
                   placeholder='@L["MD.WorkCenter.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Line"]</span>
            <select class="ames-input" style="width:130px;" @bind="_fLine">
                <option value="">@L["Filter.AllLines"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">@l.LineID@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.ProcessType"]</span>
            <select class="ames-input" style="width:130px;" @bind="_fType">
                <option value="">@L["Filter.AllProcessTypes"]</option>
                @foreach (var t in _allRows.Select(r => r.ProcessType).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@t">@t</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Active"]</span>
            <select class="ames-input" style="width:100px;" @bind="_fActive">
                <option value="">@L["Filter.All"]</option>
                <option value="Y">@L["Lbl.Active"]</option>
                <option value="N">@L["Lbl.Inactive"]</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            @if (_canEdit) { <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button> }
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.WorkCenter.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.WCID"]</th><th>@L["Col.WcName"]</th><th>@L["Col.ProcessType"]</th><th>@L["Col.Line"]</th>
                    <th style="text-align:right;">@L["Col.Capacity"]</th>
                    <th style="text-align:right;">@L["Col.StdHeadcount"]</th>
                    <th>@L["Col.CostCenter"]</th><th>@L["Col.Loc"]</th><th>@L["Col.Active"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.WCID</td>
                        <td>@(r.WCName ?? "—")</td>
                        <td><span class="pill">@(r.ProcessType ?? "—")</span></td>
                        <td class="dim">@(r.LineID ?? "—")</td>
                        <td style="text-align:right;">@(r.DailyCapacity?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(r.StdManpower?.ToString() ?? "—")</td>
                        <td class="dim">@(r.CostCenterCode ?? "—")</td>
                        <td class="dim">@(r.LocationDesc ?? "—")</td>
                        <td>
                            @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                            else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.WorkCenter.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.WCID"] * <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: WC-INJ-001)</span></label>
            <input class="ames-input" @bind="_f.WCID" placeholder="WC-INJ-001" autocomplete="off" />

            <label>@L["Col.Name"] *</label>
            <input class="ames-input" @bind="_f.WCName" placeholder='@L["MD.WorkCenter.Ph.WcName"]' autocomplete="off" />

            <label>@L["Col.ProcessType"]</label>
            <input class="ames-input" @bind="_f.ProcessType" placeholder="INJ, ASM, PNT 등" maxlength="16" autocomplete="off" />

            <label>@L["Col.LineId"]</label>
            <select class="ames-input" @bind="_f.LineID">
                <option value="">— @L["Opt.Select"] —</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">[@l.LineID]@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>

            <label>@L["Col.DailyCapacity"] (EA)</label>
            <input class="ames-input" type="number" @bind="_f.DailyCapacity" placeholder="1000" min="0" autocomplete="off" />

            <label>@L["Col.StdManpower"]</label>
            <input class="ames-input" type="number" @bind="_f.StdManpower" placeholder="3" min="0" autocomplete="off" />

            <label>@L["Col.CostCenter"]</label>
            <input class="ames-input" @bind="_f.CostCenterCode" placeholder="CC-INJ-001" maxlength="20" autocomplete="off" />

            <label>@L["Col.LocationDesc"]</label>
            <input class="ames-input" @bind="_f.LocationDesc" placeholder='@L["MD.WorkCenter.Ph.LocationDesc"]' autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.WorkCenter.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.WCID</span></div>

            <label>@L["Col.Name"] *</label>
            <input class="ames-input" @bind="_f.WCName" autocomplete="off" />

            <label>@L["Col.ProcessType"]</label>
            <input class="ames-input" @bind="_f.ProcessType" maxlength="16" autocomplete="off" />

            <label>@L["Col.LineId"]</label>
            <select class="ames-input" @bind="_f.LineID">
                <option value="">— @L["Opt.Select"] —</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">[@l.LineID]@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>

            <label>@L["Col.DailyCapacity"] (EA)</label>
            <input class="ames-input" type="number" @bind="_f.DailyCapacity" min="0" autocomplete="off" />

            <label>@L["Col.StdManpower"]</label>
            <input class="ames-input" type="number" @bind="_f.StdManpower" min="0" autocomplete="off" />

            <label>@L["Col.CostCenter"]</label>
            <input class="ames-input" @bind="_f.CostCenterCode" maxlength="20" autocomplete="off" />

            <label>@L["Col.LocationDesc"]</label>
            <input class="ames-input" @bind="_f.LocationDesc" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Edit"])</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.WorkCenterRow> _allRows  = new();
    List<AMES.Data.Repositories.MasterDataRepository.WorkCenterRow> _rows     = new();
    List<AMES.Data.Repositories.MasterDataRepository.LineRow>       _lineList = new();
    AMES.Data.Repositories.MasterDataRepository.WorkCenterRow? _sel;

    int _page = 0;
    const int _pageSize = 20;

    string _fSearch = "", _fLine = "", _fType = "", _fActive = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rp/work-center");
        try { _lineList = Md.ListLines(); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListWorkCenters(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.WCID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.WCName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineID      == _fLine) &&
        (string.IsNullOrEmpty(_fType)   || r.ProcessType == _fType) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.WorkCenterRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            WCID           = r.WCID,
            WCName         = r.WCName         ?? "",
            ProcessType    = r.ProcessType    ?? "",
            LineID         = r.LineID         ?? "",
            DailyCapacity  = r.DailyCapacity,
            StdManpower    = r.StdManpower,
            CostCenterCode = r.CostCenterCode ?? "",
            LocationDesc   = r.LocationDesc   ?? "",
            ActiveFlag     = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.WCID))   { _modalErr = L["Err.WcIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.WCName))  { _modalErr = L["Err.NameRequired"]; return; }
        if (Md.WorkCenterExists(_f.WCID.Trim()))   { _modalErr = $"WC ID '{_f.WCID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertWorkCenter(_f.WCID.Trim(), _f.WCName, NE(_f.ProcessType),
                NE(_f.LineID), _f.DailyCapacity, _f.StdManpower,
                NE(_f.CostCenterCode), NE(_f.LocationDesc), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.WCName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.WCName)) { _modalErr = L["Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateWorkCenter(_sel.WCID, _f.WCName, NE(_f.ProcessType),
                NE(_f.LineID), _f.DailyCapacity, _f.StdManpower,
                NE(_f.CostCenterCode), NE(_f.LocationDesc), _f.ActiveFlag, _actor);
            var name = _f.WCName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.WCName ?? _sel.WCID;
            Md.DeleteWorkCenter(_sel.WCID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string WCID           { get; set; } = "";
        public string WCName         { get; set; } = "";
        public string ProcessType    { get; set; } = "";
        public string LineID         { get; set; } = "";
        public int?   DailyCapacity  { get; set; }
        public int?   StdManpower    { get; set; }
        public string CostCenterCode { get; set; } = "";
        public string LocationDesc   { get; set; } = "";
        public bool   ActiveFlag     { get; set; } = true;
    }
}
