@page "/md/rp/work-center"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject AMES.Web.Services.PermissionService Perm
@inject IStringLocalizer<SharedResources> L
@using Radzen

<PageTitle>@L["MD.WorkCenter.Title"] · AMES</PageTitle>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.WorkCenter.Kpi.Lines"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["MD.WorkCenter.Kpi.Types"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.WorkCenter.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.375rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Placeholder="@L["MD.WorkCenter.Ph.Search"]"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" AutoComplete="false"
                           @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' />
            <RadzenLabel Text="@L["Col.Line"]" />
            <RadzenDropDown @bind-Value="_fLine" Data="@LineFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllLines"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.ProcessType"]" />
            <RadzenDropDown @bind-Value="_fType" Data="@TypeFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.AllProcessTypes"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Active"]" />
            <RadzenDropDown @bind-Value="_fActive" Data="@ActiveFilterOptions" TextProperty="Text" ValueProperty="Value"
                            AllowClear="true" Placeholder="@L["Filter.All"]"
                            InputSize="InputSize.Small" class="ames-rz-input" Style="width:100px;" />
            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ApplyFilter" class="ames-rz-btn" />
            @if (_canEdit) { <RadzenButton Text="@L["Btn.Create"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@OpenCreate" class="ames-rz-btn" /> }
        </RadzenStack>
    </div>

    <RadzenDataGrid TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow"
                    Data="@_rows"
                    AllowPaging="true" PageSize="25"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    PageSizeOptions="@_pageSizeOptions"
                    ShowPagingSummary="true"
                    AllowSorting="true"
                    RowRender="@WcRowRender"
                    RowClick="@(args => { if (args.Data is not null) OpenEdit(args.Data); })"
                    EmptyText="@L["MD.WorkCenter.Empty"]"
                    Class="ames-rz-grid">
        <Columns>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="WCID" Title="@L["Col.WCID"]" Width="110px">
                <Template Context="r"><span class="code">@r.WCID</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="WCName" Title="@L["Col.WcName"]">
                <Template Context="r">@(r.WCName ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="ProcessType" Title="@L["Col.ProcessType"]" Width="100px">
                <Template Context="r"><span class="pill">@(r.ProcessType ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="LineID" Title="@L["Col.Line"]" Width="90px">
                <Template Context="r"><span class="dim">@(r.LineID ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="DailyCapacity" Title="@L["Col.Capacity"]" Width="80px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.DailyCapacity?.ToString("N0") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="StdManpower" Title="@L["Col.StdHeadcount"]" Width="72px" TextAlign="TextAlign.Right">
                <Template Context="r">@(r.StdManpower?.ToString() ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="CostCenterCode" Title="@L["Col.CostCenter"]" Width="110px">
                <Template Context="r"><span class="dim">@(r.CostCenterCode ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="LocationDesc" Title="@L["Col.Loc"]">
                <Template Context="r"><span class="dim">@(r.LocationDesc ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AMES.Data.Repositories.MasterDataRepository.WorkCenterRow" Property="ActiveFlag" Title="@L["Col.Active"]" Width="72px" TextAlign="TextAlign.Center">
                <Template Context="r">
                    @if (r.ActiveFlag) { <span class="pill ok">@L["Lbl.Active"]</span> }
                    else { <span class="pill bad">@L["Lbl.Inactive"]</span> }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.WorkCenter.Title"] — @L["Btn.Create"]</div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@(L["Col.WCID"] + " *  (예: WC-INJ-001)")' />
                    <RadzenTextBox @bind-Value="_f.WCID" Placeholder="WC-INJ-001" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@(L["Col.Name"] + " *")' />
                    <RadzenTextBox @bind-Value="_f.WCName" Placeholder="@L["MD.WorkCenter.Ph.WcName"]" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.ProcessType"]" />
                    <RadzenTextBox @bind-Value="_f.ProcessType" Placeholder="INJ, ASM, PNT 등" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.LineId"]" />
                    <RadzenDropDown @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text='@(L["Col.DailyCapacity"] + " (EA)")' />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DailyCapacity" Placeholder="1000" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.StdManpower"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.StdManpower" Placeholder="3" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.CostCenter"]" />
                    <RadzenTextBox @bind-Value="_f.CostCenterCode" Placeholder="CC-INJ-001" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.LocationDesc"]" />
                    <RadzenTextBox @bind-Value="_f.LocationDesc" Placeholder="@L["MD.WorkCenter.Ph.LocationDesc"]" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Create"])" Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveCreate" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.WorkCenter.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.WCID</span></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <RadzenLabel Text='@(L["Col.Name"] + " *")' />
                    <RadzenTextBox @bind-Value="_f.WCName" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.ProcessType"]" />
                    <RadzenTextBox @bind-Value="_f.ProcessType" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.LineId"]" />
                    <RadzenDropDown @bind-Value="_f.LineID" Data="@LineOptions" TextProperty="Text" ValueProperty="Value"
                                    Placeholder="@L["Opt.Select"]"
                                    InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text='@(L["Col.DailyCapacity"] + " (EA)")' />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.DailyCapacity" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <RadzenLabel Text="@L["Col.StdManpower"]" />
                    <RadzenNumeric TValue="int?" @bind-Value="_f.StdManpower" Min="0"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Col.CostCenter"]" />
                    <RadzenTextBox @bind-Value="_f.CostCenterCode" AutoComplete="false"
                                   InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />
                </div>
            </div>

            <RadzenLabel Text="@L["Col.LocationDesc"]" Style="margin-top:6px;" />
            <RadzenTextBox @bind-Value="_f.LocationDesc" AutoComplete="false"
                           InputSize="InputSize.Small" class="ames-rz-input" Style="width:100%;" />

            <label style="margin-top:6px;display:flex;align-items:center;gap:8px;cursor:pointer;">
                <RadzenCheckBox TValue="bool" @bind-Value="_f.ActiveFlag" />
                <span>@L["Lbl.Active"]</span>
            </label>

            @if (_confirmDelete)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <RadzenButton Text="@L["Msg.No"]" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click='() => _confirmDelete = false' class="ames-rz-btn" />
                    <RadzenButton Text="@(_busy ? L["Msg.Deleting"] : L["Msg.Yes"])" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@SaveDelete" Disabled="@_busy" class="ames-rz-btn" />
                </RadzenStack>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Style="margin-top:8px;">@_modalErr</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="ames-modal-footer">
                <RadzenButton Text="@(_busy ? L["Msg.Saving"] : L["Btn.Edit"])" Icon="save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@SaveEdit" Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click='() => { _confirmDelete = true; _modalErr = ""; }' Disabled="@_busy" class="ames-rz-btn" />
                <RadzenButton Text="@L["Btn.Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@CloseModal" class="ames-rz-btn" />
            </RadzenStack>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.WorkCenterRow> _allRows  = new();
    List<AMES.Data.Repositories.MasterDataRepository.WorkCenterRow> _rows     = new();
    List<AMES.Data.Repositories.MasterDataRepository.LineRow>       _lineList = new();
    AMES.Data.Repositories.MasterDataRepository.WorkCenterRow? _sel;

    string _fSearch = "";
    string? _fLine, _fType, _fActive;
    int[] _pageSizeOptions = { 15, 30, 50, 100 };

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    bool   _canEdit;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        await Perm.EnsureAsync(Auth);
        _canEdit = Perm.CanEdit("md/rp/work-center");
        try { _lineList = Md.ListLines(); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListWorkCenters(); ApplyFilter(); }

    void ApplyFilter() { _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.WCID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.WCName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineID      == _fLine) &&
        (string.IsNullOrEmpty(_fType)   || r.ProcessType == _fType) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList(); }

    IEnumerable<DropDownItem> LineFilterOptions =>
        _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = l.LineID + (l.LineName != null ? $" {l.LineName}" : "") });

    IEnumerable<DropDownItem> LineOptions =>
        _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = $"[{l.LineID}]" + (l.LineName != null ? $" {l.LineName}" : "") });

    IEnumerable<DropDownItem> TypeFilterOptions =>
        _allRows.Select(r => r.ProcessType).Where(x => x != null).Distinct().OrderBy(x => x)
            .Select(t => new DropDownItem { Value = t!, Text = t! });

    DropDownItem[] ActiveFilterOptions =
    {
        new() { Value = "Y", Text = "Active" },
        new() { Value = "N", Text = "Inactive" },
    };

    void WcRowRender(RowRenderEventArgs<AMES.Data.Repositories.MasterDataRepository.WorkCenterRow> args)
    {
        if (!args.Attributes.TryGetValue("class", out var cls)) cls = "";
        args.Attributes["class"] = cls + " ames-row-link";
    }

    class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.WorkCenterRow r)
    {
        if (!_canEdit) return;
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            WCID           = r.WCID,
            WCName         = r.WCName         ?? "",
            ProcessType    = r.ProcessType    ?? "",
            LineID         = r.LineID         ?? "",
            DailyCapacity  = r.DailyCapacity,
            StdManpower    = r.StdManpower,
            CostCenterCode = r.CostCenterCode ?? "",
            LocationDesc   = r.LocationDesc   ?? "",
            ActiveFlag     = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.WCID))   { _modalErr = L["Err.WcIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.WCName))  { _modalErr = L["Err.NameRequired"]; return; }
        if (Md.WorkCenterExists(_f.WCID.Trim()))   { _modalErr = $"WC ID '{_f.WCID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertWorkCenter(_f.WCID.Trim(), _f.WCName, NE(_f.ProcessType),
                NE(_f.LineID), _f.DailyCapacity, _f.StdManpower,
                NE(_f.CostCenterCode), NE(_f.LocationDesc), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.WCName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.WCName)) { _modalErr = L["Err.NameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateWorkCenter(_sel.WCID, _f.WCName, NE(_f.ProcessType),
                NE(_f.LineID), _f.DailyCapacity, _f.StdManpower,
                NE(_f.CostCenterCode), NE(_f.LocationDesc), _f.ActiveFlag, _actor);
            var name = _f.WCName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.WCName ?? _sel.WCID;
            Md.DeleteWorkCenter(_sel.WCID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string WCID           { get; set; } = "";
        public string WCName         { get; set; } = "";
        public string ProcessType    { get; set; } = "";
        public string LineID         { get; set; } = "";
        public int?   DailyCapacity  { get; set; }
        public int?   StdManpower    { get; set; }
        public string CostCenterCode { get; set; } = "";
        public string LocationDesc   { get; set; } = "";
        public bool   ActiveFlag     { get; set; } = true;
    }
}