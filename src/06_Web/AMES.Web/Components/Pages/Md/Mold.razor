@page "/md/mold"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Mold.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-007" TitleKey="MD.Mold.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "AVAILABLE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["Kpi.NeedMaint"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.RatedShots.HasValue && r.CurrentShots.HasValue && r.CurrentShots >= r.RatedShots)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.StorageLocs"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.StorageLoc).Where(l => l != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Mold.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:140px;padding:4px 8px;"
                   placeholder='@L["MD.Mold.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:120px;padding:4px 8px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _moldStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.StorageLoc"]</span>
            <select class="ames-input" style="width:120px;padding:4px 8px;" @bind="_fLoc">
                <option value="">@L["Filter.AllLocations"]</option>
                @foreach (var l in _allRows.Select(r => r.StorageLoc).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@l">@l</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Mold.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.MoldId"]</th><th>@L["Col.MoldName"]</th>
                    <th style="text-align:right;">@L["Col.Cavities"]</th>
                    <th style="text-align:right;">@L["Col.Tonnage"]</th>
                    <th style="text-align:right;">@L["Col.ShotsLifetime"]</th>
                    <th style="text-align:right;">@L["Col.ShotsCurrent"]</th>
                    <th style="text-align:right;">@L["Col.UsagePct"]</th>
                    <th>@L["Col.StorageLoc"]</th>
                    <th>@L["Col.LastMaint"]</th>
                    <th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    var pct = r.RatedShots.HasValue && r.RatedShots > 0 && r.CurrentShots.HasValue
                        ? (double)r.CurrentShots.Value / r.RatedShots.Value * 100
                        : (double?)null;
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.MoldID</td>
                        <td>@(r.MoldName ?? "—")</td>
                        <td style="text-align:right;">@(r.CavityCount?.ToString() ?? "—")</td>
                        <td style="text-align:right;">@(r.Tonnage?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(r.RatedShots?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">@(r.CurrentShots?.ToString("N0") ?? "—")</td>
                        <td style="text-align:right;">
                            @if (pct.HasValue)
                            {
                                var cls = pct >= 100 ? "bad" : pct >= 80 ? "warn" : "ok";
                                <span class="pill @cls">@pct.Value.ToString("N1")%</span>
                            }
                            else { <span class="dim">—</span> }
                        </td>
                        <td class="dim">@(r.StorageLoc ?? "—")</td>
                        <td class="dim">@(r.LastMaintDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>
                            @{
                                var scls = r.Status switch { "AVAILABLE" => "ok", "MOUNTED" => "info", _ => "bad" };
                                var sLabel = _moldStatus.FirstOrDefault(s => s.CodeValue == r.Status) is { } _lf_ ? MasterDataRepository.LocalName(_lf_) : r.Status;
                            }
                            <span class="pill @scls">@(sLabel ?? "—")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Mold.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.MoldId"] * <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: MLD-INJ-001)</span></label>
            <input class="ames-input" @bind="_f.MoldID" placeholder="MLD-INJ-001" autocomplete="off" />

            <label>@L["Col.MoldName"] *</label>
            <input class="ames-input" @bind="_f.MoldName" placeholder='@L["MD.Mold.Ph.MoldName"]' autocomplete="off" />

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>@L["Col.Cavities"]</label>
                    <input class="ames-input" type="number" @bind="_f.CavityCount" min="1" autocomplete="off" />
                </div>
                <div>
                    <label>@L["Col.Tonnage"]</label>
                    <input class="ames-input" type="number" @bind="_f.Tonnage" min="0" autocomplete="off" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <label>@L["Col.ShotsLifetime"]</label>
                    <input class="ames-input" type="number" @bind="_f.RatedShots" min="0" autocomplete="off" />
                </div>
                <div>
                    <label>@L["Col.ShotsCurrent"]</label>
                    <input class="ames-input" type="number" @bind="_f.CurrentShots" min="0" autocomplete="off" />
                </div>
            </div>

            <label style="margin-top:6px;">@L["MD.Mold.StoreLoc"]</label>
            <input class="ames-input" @bind="_f.StorageLoc" placeholder='@L["MD.Mold.Ph.StorageLoc"]' maxlength="20" autocomplete="off" />

            <label>@L["Col.LastMaint"]</label>
            <input type="date" class="ames-input"
                   value="@(_f.LastMaintDate?.ToString("yyyy-MM-dd"))"
                   @oninput="e => _f.LastMaintDate = ParseDate(e.Value?.ToString())" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _moldStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.Mold.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.MoldID</span></div>

            <label>@L["Col.MoldName"] *</label>
            <input class="ames-input" @bind="_f.MoldName" autocomplete="off" />

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <div>
                    <label>@L["Col.Cavities"]</label>
                    <input class="ames-input" type="number" @bind="_f.CavityCount" min="1" autocomplete="off" />
                </div>
                <div>
                    <label>@L["Col.Tonnage"]</label>
                    <input class="ames-input" type="number" @bind="_f.Tonnage" min="0" autocomplete="off" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                <div>
                    <label>@L["Col.ShotsLifetime"]</label>
                    <input class="ames-input" type="number" @bind="_f.RatedShots" min="0" autocomplete="off" />
                </div>
                <div>
                    <label>@L["Col.ShotsCurrent"]</label>
                    <input class="ames-input" type="number" value="@_f.CurrentShots" readonly style="background:#94a3b8;color:#1e293b;cursor:not-allowed;" />
                </div>
            </div>

            <label style="margin-top:6px;">@L["MD.Mold.StoreLoc"]</label>
            <input class="ames-input" @bind="_f.StorageLoc" maxlength="20" autocomplete="off" />

            <label>@L["Col.LastMaint"]</label>
            <input type="date" class="ames-input"
                   value="@(_f.LastMaintDate?.ToString("yyyy-MM-dd"))"
                   @oninput="e => _f.LastMaintDate = ParseDate(e.Value?.ToString())" />

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="">@L["Opt.Select"]</option>
                @foreach (var s in _moldStatus.Where(s => s.UseFlag))
                {
                    <option value="@s.CodeValue">[@s.CodeValue] @(MasterDataRepository.LocalName(s))</option>
                }
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Edit"])</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.MoldRow>    _allRows    = new();
    List<AMES.Data.Repositories.MasterDataRepository.MoldRow>    _rows       = new();
    List<AMES.Data.Repositories.MasterDataRepository.CodeItemRow> _moldStatus = new();
    AMES.Data.Repositories.MasterDataRepository.MoldRow? _sel;

    int _page = 0;
    const int _pageSize = 20;

    string _fSearch = "", _fStatus = "", _fLoc = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        try { _moldStatus = Md.ListCodeItems("MOLD_STATUS"); } catch { }
        Reload();
    }

    void Reload() { _allRows = Md.ListMolds(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.MoldID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.MoldName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fStatus) || r.Status    == _fStatus) &&
        (string.IsNullOrEmpty(_fLoc)    || r.StorageLoc == _fLoc)
    ).ToList(); }

    void OpenCreate() { _f = new(); _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.MoldRow r)
    {
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            MoldID       = r.MoldID,
            MoldName     = r.MoldName     ?? "",
            RatedShots   = r.RatedShots,
            CurrentShots = r.CurrentShots,
            CavityCount  = r.CavityCount,
            Tonnage      = r.Tonnage,
            StorageLoc   = r.StorageLoc   ?? "",
            LastMaintDate = r.LastMaintDate,
            Status       = r.Status       ?? "AVAILABLE",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;
    static DateOnly? ParseDate(string? s) => DateOnly.TryParse(s, out var d) ? d : null;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MoldID))   { _modalErr = L["Err.MoldIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.MoldName))  { _modalErr = L["Err.MoldNameRequired"]; return; }
        if (Md.MoldExists(_f.MoldID.Trim()))         { _modalErr = $"금형 ID '{_f.MoldID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertMold(_f.MoldID.Trim(), _f.MoldName,
                _f.RatedShots, _f.CurrentShots, _f.CavityCount, _f.Tonnage,
                NE(_f.StorageLoc), _f.LastMaintDate, _f.Status, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.MoldName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.MoldName)) { _modalErr = L["Err.MoldNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateMold(_sel.MoldID, _f.MoldName,
                _f.RatedShots, _f.CurrentShots, _f.CavityCount, _f.Tonnage,
                NE(_f.StorageLoc), _f.LastMaintDate, _f.Status, _actor);
            var name = _f.MoldName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.MoldName ?? _sel.MoldID;
            Md.DeleteMold(_sel.MoldID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   MoldID        { get; set; } = "";
        public string   MoldName      { get; set; } = "";
        public int?     RatedShots    { get; set; }
        public int?     CurrentShots  { get; set; }
        public int?     CavityCount   { get; set; }
        public int?     Tonnage       { get; set; }
        public string   StorageLoc    { get; set; } = "";
        public DateOnly? LastMaintDate { get; set; }
        public string   Status        { get; set; } = "AVAILABLE";
    }
}
