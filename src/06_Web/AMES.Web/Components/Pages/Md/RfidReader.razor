@page "/md/rfid-reader"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.RfidReader.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-022</div>
    <div class="ames-page-t">@L["MD.RfidReader.Title"]</div>
    <div class="ames-page-sub">@L["MD.RfidReader.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">운영 중</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "ACTIVE")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">점검 중</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "MAINT")</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">라인 수</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.RfidReader.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / 전체 {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:140px;padding:4px 8px;"
                   placeholder="리더ID / 리더명" @bind="_fSearch" autocomplete="off" />
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fLine">
                <option value="">@L["Filter.AllLines"]</option>
                @foreach (var l in _allRows.Select(r => r.LineID).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@l">@l</option>
                }
            </select>
            <select class="ames-input" style="width:90px;padding:4px 8px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                @foreach (var s in _allRows.Select(r => r.Status).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@s">@s</option>
                }
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.RfidReader.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>리더 ID</th><th>리더명</th><th>라인</th><th>게이트</th>
                    <th>IP 주소</th><th class="num">안테나</th><th class="num">출력(dBm)</th>
                    <th class="num">윈도우(ms)</th><th>PE 트리거</th><th>펌웨어</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td class="code">@r.ReaderID</td>
                        <td>@(r.ReaderName ?? "—")</td>
                        <td class="dim">@(r.LineID ?? "—")</td>
                        <td class="dim">@(r.GateLocation ?? "—")</td>
                        <td class="dim">@(r.IpAddress ?? "—")</td>
                        <td class="num">@(r.AntennaCount?.ToString() ?? "—")</td>
                        <td class="num">@(r.PowerDbm?.ToString() ?? "—")</td>
                        <td class="num">@(r.WindowMs?.ToString() ?? "—")</td>
                        <td>@(r.PeTriggerFlag ? (MarkupString)"<span class=\"pill ok\">ON</span>" : (MarkupString)"<span class=\"pill\">OFF</span>")</td>
                        <td class="dim">@(r.FirmwareVer ?? "—")</td>
                        <td><span class="pill @(r.Status == "ACTIVE" ? "ok" : r.Status == "MAINT" ? "warn" : "bad")">@(r.Status ?? "—")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.MasterDataRepository.RfidReaderRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.RfidReaderRow> _rows    = new();
    string _fSearch = "", _fLine = "", _fStatus = "";

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Md.ListRfidReaders(); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _allRows;
        if (!string.IsNullOrWhiteSpace(_fSearch))
            _rows = _rows.Where(r =>
                r.ReaderID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (r.ReaderName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_fLine))
            _rows = _rows.Where(r => r.LineID == _fLine).ToList();
        if (!string.IsNullOrWhiteSpace(_fStatus))
            _rows = _rows.Where(r => r.Status == _fStatus).ToList();
    }
}
