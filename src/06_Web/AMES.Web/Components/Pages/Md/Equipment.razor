@page "/md/equipment"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.Equipment.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">MD-014</div>
    <div class="ames-page-t">@L["MD.Equipment.Title"]</div>
    <div class="ames-page-sub">@L["MD.Equipment.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.ActiveFlag)</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">라인 수</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.LineID).Where(l => l != null).Distinct().Count()</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">설비유형 수</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.EquipType).Where(t => t != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.Equipment.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / 전체 {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:160px;padding:4px 8px;"
                   placeholder="설비ID / 설비명" @bind="_fSearch" autocomplete="off" />
            <select class="ames-input" style="width:120px;padding:4px 8px;" @bind="_fLine">
                <option value="">@L["Filter.AllLines"]</option>
                @foreach (var l in _allRows.Select(r => r.LineID).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@l">@l</option>
                }
            </select>
            <select class="ames-input" style="width:120px;padding:4px 8px;" @bind="_fType">
                <option value="">@L["Filter.AllTypes"]</option>
                @foreach (var t in _allRows.Select(r => r.EquipType).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@t">@t</option>
                }
            </select>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fActive">
                <option value="">전체</option>
                <option value="Y">활성</option>
                <option value="N">비활성</option>
            </select>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.Equipment.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>설비ID</th><th>설비명</th><th>유형</th><th>라인</th><th>Work Center</th>
                    <th>제조사/모델</th><th>설치일</th>
                    <th style="text-align:right;">이론사이클(s)</th>
                    <th style="text-align:right;">목표OEE(%)</th>
                    <th>PLC주소</th><th>활성</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.EquipID</td>
                        <td>@(r.EquipName ?? "—")</td>
                        <td><span class="pill">@(r.EquipType ?? "—")</span></td>
                        <td class="dim">@(r.LineID ?? "—")</td>
                        <td class="dim">@(r.WCID ?? "—")</td>
                        <td class="dim">@(r.MakerModel ?? "—")</td>
                        <td class="dim">@(r.InstallDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td style="text-align:right;">@(r.TheoreticalCycle?.ToString("F2") ?? "—")</td>
                        <td style="text-align:right;">@(r.TargetOEE?.ToString("F1") ?? "—")</td>
                        <td class="dim">@(r.PlcAddress ?? "—")</td>
                        <td>
                            @if (r.ActiveFlag) { <span class="pill ok">활성</span> }
                            else { <span class="pill bad">비활성</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">신규 설비 등록</div>

            <label>설비ID * <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: EQ-INJ-01)</span></label>
            <input class="ames-input" @bind="_f.EquipID" placeholder="EQ-INJ-01" autocomplete="off" />

            <label>설비명 *</label>
            <input class="ames-input" @bind="_f.EquipName" placeholder="사출기 1호" autocomplete="off" />

            <label>설비유형</label>
            <input class="ames-input" @bind="_f.EquipType" placeholder="INJECTION, PAINT 등" maxlength="16" autocomplete="off" />

            <label>라인 ID</label>
            <input class="ames-input" @bind="_f.LineID" placeholder="INJ-L01" maxlength="20" autocomplete="off" />

            <label>Work Center ID</label>
            <input class="ames-input" @bind="_f.WCID" placeholder="WC-INJ-01" maxlength="20" autocomplete="off" />

            <label>제조사/모델</label>
            <input class="ames-input" @bind="_f.MakerModel" placeholder="LG전자 LGI-500T" autocomplete="off" />

            <label>설치일</label>
            <input class="ames-input" type="date" @bind="_f.InstallDate" autocomplete="off" />

            <label>이론사이클 (초)</label>
            <input class="ames-input" type="number" step="0.01" @bind="_f.TheoreticalCycle" placeholder="30.00" min="0" autocomplete="off" />

            <label>목표 OEE (%)</label>
            <input class="ames-input" type="number" step="0.1" @bind="_f.TargetOEE" placeholder="85.0" min="0" max="100" autocomplete="off" />

            <label>PLC 주소</label>
            <input class="ames-input" @bind="_f.PlcAddress" placeholder="192.168.1.10:502" maxlength="40" autocomplete="off" />

            <label>상태</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="MAINT">MAINT</option>
            </select>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>활성</span>
            </label>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok" @onclick="SaveCreate" disabled="@_busy">@(_busy ? "저장 중…" : "등록")</button>
                <button class="ames-btn" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">설비 수정 — <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.EquipID</span></div>

            <label>설비명 *</label>
            <input class="ames-input" @bind="_f.EquipName" autocomplete="off" />

            <label>설비유형</label>
            <input class="ames-input" @bind="_f.EquipType" maxlength="16" autocomplete="off" />

            <label>라인 ID</label>
            <input class="ames-input" @bind="_f.LineID" maxlength="20" autocomplete="off" />

            <label>Work Center ID</label>
            <input class="ames-input" @bind="_f.WCID" maxlength="20" autocomplete="off" />

            <label>제조사/모델</label>
            <input class="ames-input" @bind="_f.MakerModel" autocomplete="off" />

            <label>설치일</label>
            <input class="ames-input" type="date" @bind="_f.InstallDate" autocomplete="off" />

            <label>이론사이클 (초)</label>
            <input class="ames-input" type="number" step="0.01" @bind="_f.TheoreticalCycle" min="0" autocomplete="off" />

            <label>목표 OEE (%)</label>
            <input class="ames-input" type="number" step="0.1" @bind="_f.TargetOEE" min="0" max="100" autocomplete="off" />

            <label>PLC 주소</label>
            <input class="ames-input" @bind="_f.PlcAddress" maxlength="40" autocomplete="off" />

            <label>상태</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="MAINT">MAINT</option>
            </select>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.ActiveFlag" />
                <span>활성</span>
            </label>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>정말 삭제하시겠습니까?</span>
                    <button class="ames-btn" @onclick='() => _confirmDelete = false'>아니오</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? "삭제 중…" : "예, 삭제")</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn ok"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? "저장 중…" : "수정")</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.EquipmentRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.EquipmentRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.EquipmentRow? _sel;

    string _fSearch = "", _fLine = "", _fType = "", _fActive = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        Reload();
    }

    void Reload() { _allRows = Md.ListEquipments(); ApplyFilter(); }

    void ApplyFilter() => _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.EquipID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.EquipName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fLine)   || r.LineID    == _fLine) &&
        (string.IsNullOrEmpty(_fType)   || r.EquipType == _fType) &&
        (string.IsNullOrEmpty(_fActive) || (_fActive == "Y" ? r.ActiveFlag : !r.ActiveFlag))
    ).ToList();

    void OpenCreate() { _f = new() { ActiveFlag = true, Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.EquipmentRow r)
    {
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            EquipID          = r.EquipID,
            EquipName        = r.EquipName    ?? "",
            EquipType        = r.EquipType    ?? "",
            LineID           = r.LineID       ?? "",
            WCID             = r.WCID         ?? "",
            MakerModel       = r.MakerModel   ?? "",
            InstallDate      = r.InstallDate,
            TheoreticalCycle = r.TheoreticalCycle,
            TargetOEE        = r.TargetOEE,
            PlcAddress       = r.PlcAddress   ?? "",
            Status           = r.Status       ?? "Active",
            ActiveFlag       = r.ActiveFlag,
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipID))   { _modalErr = "설비ID를 입력하세요."; return; }
        if (string.IsNullOrWhiteSpace(_f.EquipName))  { _modalErr = "설비명을 입력하세요."; return; }
        if (Md.EquipmentExists(_f.EquipID.Trim()))    { _modalErr = $"설비ID '{_f.EquipID.Trim()}' 이 이미 존재합니다."; return; }
        _busy = true;
        try
        {
            Md.InsertEquipment(_f.EquipID.Trim(), _f.EquipName, NE(_f.EquipType),
                NE(_f.LineID), NE(_f.WCID), NE(_f.MakerModel),
                _f.InstallDate, _f.TheoreticalCycle, _f.TargetOEE,
                NE(_f.PlcAddress), NE(_f.Status), _f.ActiveFlag, _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.EquipName} 등록 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.EquipName)) { _modalErr = "설비명을 입력하세요."; return; }
        _busy = true;
        try
        {
            Md.UpdateEquipment(_sel.EquipID, _f.EquipName, NE(_f.EquipType),
                NE(_f.LineID), NE(_f.WCID), NE(_f.MakerModel),
                _f.InstallDate, _f.TheoreticalCycle, _f.TargetOEE,
                NE(_f.PlcAddress), NE(_f.Status), _f.ActiveFlag, _actor);
            var name = _f.EquipName;
            CloseModal(); Reload();
            ShowMsg($"{name} 수정 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.EquipName ?? _sel.EquipID;
            Md.DeleteEquipment(_sel.EquipID);
            CloseModal(); Reload();
            ShowMsg($"{name} 삭제 완료.", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   EquipID          { get; set; } = "";
        public string   EquipName        { get; set; } = "";
        public string   EquipType        { get; set; } = "";
        public string   LineID           { get; set; } = "";
        public string   WCID             { get; set; } = "";
        public string   MakerModel       { get; set; } = "";
        public DateOnly? InstallDate     { get; set; }
        public decimal? TheoreticalCycle { get; set; }
        public decimal? TargetOEE        { get; set; }
        public string   PlcAddress       { get; set; } = "";
        public string   Status           { get; set; } = "Active";
        public bool     ActiveFlag       { get; set; } = true;
    }
}
