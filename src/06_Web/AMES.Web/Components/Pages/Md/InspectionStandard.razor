@page "/md/inspection-standard"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject AuthenticationStateProvider Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["MD.InspStd.Title"] · AMES</PageTitle>

<AmesPageHeader Code="MD-017" TitleKey="MD.InspStd.Title" />

<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Lbl.Total"]</div>
        <div class="ames-kpi-v">@_allRows.Count</div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["Lbl.Active"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.Status == "Active")</div>
    </div>
    <div class="ames-kpi warn">
        <div class="ames-kpi-l">@L["MD.InspStd.Kpi.Ctq"]</div>
        <div class="ames-kpi-v">@_allRows.Count(r => r.IsCTQ)</div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["Kpi.ProcessCount"]</div>
        <div class="ames-kpi-v">@_allRows.Select(r => r.ProcessCode).Where(p => p != null).Distinct().Count()</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <div class="ames-alert @(_isErr ? "bad" : "ok")">@_msg</div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["MD.InspStd.List"] · @_rows.Count @L["Lbl.Items"]@if (_rows.Count < _allRows.Count) { <text> / @L["Lbl.TotalOf"] @_allRows.Count</text> }</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:180px;padding:4px 8px;"
                   placeholder='@L["MD.InspStd.Ph.Search"]' @bind="_fSearch" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") ApplyFilter(); }' autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Type"]</span>
            <select class="ames-input" style="width:120px;padding:4px 8px;" @bind="_fType">
                <option value="">@L["Filter.AllInspectionTypes"]</option>
                @foreach (var t in _allRows.Select(r => r.InspType).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@t">@t</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Process"]</span>
            <select class="ames-input" style="width:110px;padding:4px 8px;" @bind="_fProcess">
                <option value="">@L["Filter.AllProcesses"]</option>
                @foreach (var p in _allRows.Select(r => r.ProcessCode).Where(x => x != null).Distinct().OrderBy(x => x))
                {
                    <option value="@p">@p</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Col.Status"]</span>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_fStatus">
                <option value="">@L["Filter.AllStatus"]</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
            <button class="ames-btn ok" @onclick="ApplyFilter">@L["Btn.Search"]</button>
            <button class="ames-btn" @onclick="OpenCreate">@L["Btn.Create"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["MD.InspStd.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.StandardId"]</th><th>@L["Col.ItemNo"]</th><th>@L["Col.ProcessName"]</th><th>@L["Col.InspType"]</th><th>@L["Col.CharName"]</th>
                    <th style="text-align:right;">@L["Col.Nominal"]</th>
                    <th style="text-align:right;">@L["Col.LSL"]</th>
                    <th style="text-align:right;">@L["Col.USL"]</th>
                    <th>@L["Col.Uom"]</th><th>@L["Col.SamplingPlan"]</th><th>@L["Col.InspMethod"]</th>
                    <th style="text-align:center;">@L["Col.CTQ"]</th>
                    <th>@L["Col.EffectiveDate"]</th><th>@L["Col.Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr class="ames-row-link" @onclick="() => OpenEdit(r)">
                        <td class="code">@r.InspStdID</td>
                        <td class="dim">@(r.ItemID ?? "—")</td>
                        <td class="dim">@(r.ProcessCode ?? "—")</td>
                        <td><span class="pill">@(r.InspType ?? "—")</span></td>
                        <td>@(r.CharName ?? "—")</td>
                        <td style="text-align:right;">@(r.SpecNominal?.ToString("G6") ?? "—")</td>
                        <td style="text-align:right;" class="dim">@(r.SpecLSL?.ToString("G6") ?? "—")</td>
                        <td style="text-align:right;" class="dim">@(r.SpecUSL?.ToString("G6") ?? "—")</td>
                        <td class="dim">@(r.UOM ?? "—")</td>
                        <td class="dim">@(r.SamplingPlan ?? "—")</td>
                        <td class="dim">@(r.InspMethod ?? "—")</td>
                        <td style="text-align:center;">
                            @if (r.IsCTQ) { <span class="pill warn">CTQ</span> }
                            else { <span class="dim">—</span> }
                        </td>
                        <td class="dim">@(r.EffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>
                            <span class="pill @(r.Status == "Active" ? "ok" : "bad")">@(r.Status ?? "—")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────── *@
@if (_modal == "create")
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.InspStd.Title"] — @L["Btn.Create"]</div>

            <label>@L["Col.InspStdId"] * <span style="font-weight:400;color:#64748b;font-size:.85em;">(예: IS-INJ-001)</span></label>
            <input class="ames-input" @bind="_f.InspStdID" placeholder="IS-INJ-001" autocomplete="off" />

            <label>@L["Col.ItemId"]</label>
            <input class="ames-input" @bind="_f.ItemID" placeholder="ITEM-001" maxlength="20" autocomplete="off" />

            <label>@L["Col.ProcessCode"]</label>
            <input class="ames-input" @bind="_f.ProcessCode" placeholder="INJ, QC 등" maxlength="10" autocomplete="off" />

            <label>@L["Col.InspType"]</label>
            <input class="ames-input" @bind="_f.InspType" placeholder="INCOMING, INPROC 등" maxlength="10" autocomplete="off" />

            <label>@L["Col.CharName"] *</label>
            <input class="ames-input" @bind="_f.CharName" placeholder='@L["MD.InspStd.Ph.CharName"]' autocomplete="off" />

            <label>@L["Col.Nominal"]</label>
            <input class="ames-input" type="number" step="0.0001" @bind="_f.SpecNominal" placeholder="0.0000" autocomplete="off" />

            <label>@L["Col.LSL"]</label>
            <input class="ames-input" type="number" step="0.0001" @bind="_f.SpecLSL" placeholder="0.0000" autocomplete="off" />

            <label>@L["Col.USL"]</label>
            <input class="ames-input" type="number" step="0.0001" @bind="_f.SpecUSL" placeholder="0.0000" autocomplete="off" />

            <label>@L["Col.Uom"]</label>
            <input class="ames-input" @bind="_f.UOM" placeholder="mm, kg 등" maxlength="10" autocomplete="off" />

            <label>@L["Col.SamplingPlan"]</label>
            <input class="ames-input" @bind="_f.SamplingPlan" placeholder="AQL-1.0" maxlength="20" autocomplete="off" />

            <label>@L["Col.InspMethod"]</label>
            <input class="ames-input" @bind="_f.InspMethod" placeholder='@L["MD.InspStd.Ph.InspMethod"]' autocomplete="off" />

            <label>@L["Col.EffectiveDate"]</label>
            <input class="ames-input" type="date" @bind="_f.EffectiveDate" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.IsCTQ" />
                <span>@L["MD.InspStd.CtqLabel"]</span>
            </label>

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn" @onclick="SaveCreate" disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Create"])</button>
                <button class="ames-btn ghost" @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@* ── Edit Modal ───────────────────────────────────────────────────── *@
@if (_modal == "edit" && _sel is not null)
{
    <div class="ames-modal-bg" @onmousedown="OnBgMouseDown" @onclick="OnBgClick">
        <div class="ames-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="ames-modal-h">@L["MD.InspStd.Title"] — @L["Btn.Edit"] <span class="dim" style="font-weight:400;font-size:.9em;">@_sel.InspStdID</span></div>

            <label>@L["Col.ItemId"]</label>
            <input class="ames-input" @bind="_f.ItemID" maxlength="20" autocomplete="off" />

            <label>@L["Col.ProcessCode"]</label>
            <input class="ames-input" @bind="_f.ProcessCode" maxlength="10" autocomplete="off" />

            <label>@L["Col.InspType"]</label>
            <input class="ames-input" @bind="_f.InspType" maxlength="10" autocomplete="off" />

            <label>@L["Col.CharName"] *</label>
            <input class="ames-input" @bind="_f.CharName" autocomplete="off" />

            <label>@L["Col.Nominal"]</label>
            <input class="ames-input" type="number" step="0.0001" @bind="_f.SpecNominal" autocomplete="off" />

            <label>@L["Col.LSL"]</label>
            <input class="ames-input" type="number" step="0.0001" @bind="_f.SpecLSL" autocomplete="off" />

            <label>@L["Col.USL"]</label>
            <input class="ames-input" type="number" step="0.0001" @bind="_f.SpecUSL" autocomplete="off" />

            <label>@L["Col.Uom"]</label>
            <input class="ames-input" @bind="_f.UOM" maxlength="10" autocomplete="off" />

            <label>@L["Col.SamplingPlan"]</label>
            <input class="ames-input" @bind="_f.SamplingPlan" maxlength="20" autocomplete="off" />

            <label>@L["Col.InspMethod"]</label>
            <input class="ames-input" @bind="_f.InspMethod" autocomplete="off" />

            <label>@L["Col.EffectiveDate"]</label>
            <input class="ames-input" type="date" @bind="_f.EffectiveDate" autocomplete="off" />

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input type="checkbox" @bind="_f.IsCTQ" />
                <span>@L["MD.InspStd.CtqLabel"]</span>
            </label>

            <label>@L["Col.Status"]</label>
            <select class="ames-input" @bind="_f.Status">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

            @if (_confirmDelete)
            {
                <div class="ames-delete-confirm">
                    <span>@L["Msg.Confirm.Delete"]</span>
                    <button class="ames-btn ghost" @onclick='() => _confirmDelete = false'>@L["Msg.No"]</button>
                    <button class="ames-btn bad" @onclick="SaveDelete" disabled="@_busy">@(_busy ? @L["Msg.Deleting"] : @L["Msg.Yes"])</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_modalErr))
            { <div class="ames-alert bad">@_modalErr</div> }

            <div class="ames-modal-footer">
                <button class="ames-btn"  @onclick="SaveEdit"   disabled="@_busy">@(_busy ? @L["Msg.Saving"] : @L["Btn.Edit"])</button>
                <button class="ames-btn bad" @onclick='() => { _confirmDelete = true; _modalErr = ""; }' disabled="@_busy">@L["Btn.Delete"]</button>
                <button class="ames-btn ghost"     @onclick="CloseModal">@L["Btn.Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    List<AMES.Data.Repositories.MasterDataRepository.InspectionStandardRow> _allRows = new();
    List<AMES.Data.Repositories.MasterDataRepository.InspectionStandardRow> _rows    = new();
    AMES.Data.Repositories.MasterDataRepository.InspectionStandardRow? _sel;
    int _page = 0;
    const int _pageSize = 20;

    string _fSearch = "", _fType = "", _fProcess = "", _fStatus = "";

    string _modal = "";
    bool _busy, _confirmDelete, _bgMouseDownOnSelf;
    string _msg = "", _modalErr = "";
    bool _isErr;
    string _actor = "system";
    FormModel _f = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _actor = auth.User.Identity?.Name ?? "system";
        Reload();
    }

    void Reload() { _allRows = Md.ListInspectionStandards(); ApplyFilter(); }

    void ApplyFilter() { _page = 0; _rows = _allRows.Where(r =>
        (string.IsNullOrEmpty(_fSearch) ||
            r.InspStdID.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.CharName   ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemID     ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_fType)    || r.InspType    == _fType) &&
        (string.IsNullOrEmpty(_fProcess) || r.ProcessCode == _fProcess) &&
        (string.IsNullOrEmpty(_fStatus)  || r.Status      == _fStatus)
    ).ToList(); }

    void OpenCreate() { _f = new() { Status = "Active" }; _modalErr = ""; _confirmDelete = false; _modal = "create"; }

    void OpenEdit(AMES.Data.Repositories.MasterDataRepository.InspectionStandardRow r)
    {
        _sel = r; _modalErr = ""; _confirmDelete = false;
        _f = new()
        {
            InspStdID     = r.InspStdID,
            ItemID        = r.ItemID        ?? "",
            ProcessCode   = r.ProcessCode   ?? "",
            InspType      = r.InspType      ?? "",
            CharName      = r.CharName      ?? "",
            SpecNominal   = r.SpecNominal,
            SpecLSL       = r.SpecLSL,
            SpecUSL       = r.SpecUSL,
            UOM           = r.UOM           ?? "",
            SamplingPlan  = r.SamplingPlan  ?? "",
            InspMethod    = r.InspMethod    ?? "",
            IsCTQ         = r.IsCTQ,
            EffectiveDate = r.EffectiveDate,
            Status        = r.Status        ?? "Active",
        };
        _modal = "edit";
    }

    void CloseModal() { _modal = ""; _sel = null; _modalErr = ""; _confirmDelete = false; }

    void OnBgMouseDown() => _bgMouseDownOnSelf = true;
    void OnBgClick() { if (_bgMouseDownOnSelf) CloseModal(); _bgMouseDownOnSelf = false; }

    static string? NE(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    void SaveCreate()
    {
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.InspStdID)) { _modalErr = L["Err.InspStdIdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_f.CharName))  { _modalErr = L["Err.CharNameRequired"]; return; }
        if (Md.InspectionStandardExists(_f.InspStdID.Trim())) { _modalErr = $"기준 ID '{_f.InspStdID.Trim()}' 이 {L["Err.AlreadyExists"]}"; return; }
        _busy = true;
        try
        {
            Md.InsertInspectionStandard(_f.InspStdID.Trim(), NE(_f.ItemID), NE(_f.ProcessCode),
                NE(_f.InspType), _f.CharName, _f.SpecNominal, _f.SpecLSL, _f.SpecUSL,
                NE(_f.UOM), NE(_f.SamplingPlan), NE(_f.InspMethod), _f.IsCTQ,
                _f.EffectiveDate, NE(_f.Status), _actor);
            CloseModal(); Reload();
            ShowMsg($"{_f.CharName} {L["Msg.Created"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveEdit()
    {
        if (_sel is null) return;
        _modalErr = "";
        if (string.IsNullOrWhiteSpace(_f.CharName)) { _modalErr = L["Err.CharNameRequired"]; return; }
        _busy = true;
        try
        {
            Md.UpdateInspectionStandard(_sel.InspStdID, NE(_f.ItemID), NE(_f.ProcessCode),
                NE(_f.InspType), _f.CharName, _f.SpecNominal, _f.SpecLSL, _f.SpecUSL,
                NE(_f.UOM), NE(_f.SamplingPlan), NE(_f.InspMethod), _f.IsCTQ,
                _f.EffectiveDate, NE(_f.Status), _actor);
            var name = _f.CharName;
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Updated"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; }
        finally { _busy = false; }
    }

    void SaveDelete()
    {
        if (_sel is null) return;
        _busy = true;
        try
        {
            var name = _sel.CharName ?? _sel.InspStdID;
            Md.DeleteInspectionStandard(_sel.InspStdID);
            CloseModal(); Reload();
            ShowMsg($"{name} {L["Msg.Deleted"]}", false);
        }
        catch (Exception ex) { _modalErr = ex.Message; _confirmDelete = false; }
        finally { _busy = false; }
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }

    class FormModel
    {
        public string   InspStdID     { get; set; } = "";
        public string   ItemID        { get; set; } = "";
        public string   ProcessCode   { get; set; } = "";
        public string   InspType      { get; set; } = "";
        public string   CharName      { get; set; } = "";
        public decimal? SpecNominal   { get; set; }
        public decimal? SpecLSL       { get; set; }
        public decimal? SpecUSL       { get; set; }
        public string   UOM           { get; set; } = "";
        public string   SamplingPlan  { get; set; } = "";
        public string   InspMethod    { get; set; } = "";
        public bool     IsCTQ         { get; set; }
        public DateOnly? EffectiveDate { get; set; }
        public string   Status        { get; set; } = "Active";
    }
}
