@inject IStringLocalizer<SharedResources> L
@page "/portal/box-labels"
@layout EmptyLayout
@rendermode InteractiveServer
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject BoxLabelSelection Selection
@inject PortalQuantityFormat QtyFormat
@inject ILogger<BoxLabels> Logger
<PageTitle>@L["Portal.Text.BoxLabels"] · AMES</PageTitle>
<div class="label-tools">
    <a href="/portal/deliveries">@L["Portal.Text.BackToDeliveryManagement"]</a>
    @if(_boxes.Count>0){
        <button type="button" data-delivery-note-print data-no-busy>@L["Btn.Print"]</button>
    }
    @if(_message.Length>0){<p role="alert">@_message</p>}
</div>
@if(_boxes.Count>0){
<BoxLabelSheet Boxes="_boxes" QuantityText="@((decimal q,string u)=>QtyFormat.Text(q,u))" />
}
@code {
    [SupplyParameterFromQuery(Name="delivery")] public string? Delivery {get;set;}
    [SupplyParameterFromQuery(Name="ids")] public string? Ids {get;set;}
    List<ScmRepository.DeliveryBox> _boxes=[];
    string _message="";
    protected override async Task OnInitializedAsync()
    {
        var u=(await Authentication.GetAuthenticationStateAsync()).User;
        var user=u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if(string.IsNullOrEmpty(user)||!PortalAuth.IsPortalUser(u))return;
        var delivery=Delivery??Selection.Delivery;
        var ids=Ids is null ? Selection.Ids : Ids.Split(',',StringSplitOptions.RemoveEmptyEntries).Select(x=>long.TryParse(x,out var id)?id:0).Where(x=>x>0).ToHashSet();
        if(ids.Count==0){_message=L["Portal.Text.SelectLabelsFromTheBoxList"];return;}
        try{
            _boxes=Scm.ListDeliveryBoxes(delivery,user).Where(b=>ids.Contains(b.Id)).ToList();
            if(_boxes.Count!=ids.Count){_boxes=[];_message=L["Portal.Text.TheDeliveryChangedOrWasCancelledSelectBoxesAgain"];}
        }catch(Exception ex){Logger.LogError(ex,"Box labels read failed");_message=L["Portal.Text.UnableToLoadLabels"];}
    }
}
