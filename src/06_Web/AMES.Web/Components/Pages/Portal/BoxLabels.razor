@inject IStringLocalizer<SharedResources> L
@page "/portal/box-labels"
@layout EmptyLayout
@rendermode InteractiveServer
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject BoxLabelSelection Selection
@inject PortalQuantityFormat QtyFormat
@inject ILogger<BoxLabels> Logger
<DeliveryPrintMessages />
<PageTitle>@L["Portal.Text.BoxLabels"] · AMES</PageTitle>
<div class="label-tools">
    <a href="/portal/deliveries">@L["Portal.Text.BackToDeliveryManagement"]</a>
    @if(_boxes.Count>0){
        <button data-delivery-note-print>@L["Portal.Text.PrintSavePDF"]</button>
        <button data-delivery-note-download="@($"BOX-LABELS-{Selection.Delivery}")">@L["Portal.Text.DownloadPrintableFile"]</button>
    }
    <p data-delivery-note-status>@_message</p>
</div>
@if(_boxes.Count>0){
<BoxLabelSheet Boxes="_boxes" QuantityText="@((decimal q,string u)=>QtyFormat.Text(q,u))" />
}
@code {
    List<ScmRepository.DeliveryBox> _boxes=[];
    string _message="";
    protected override async Task OnInitializedAsync()
    {
        var u=(await Authentication.GetAuthenticationStateAsync()).User;
        var user=u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if(string.IsNullOrEmpty(user)||!PortalAuth.IsPortalUser(u))return;
        if(Selection.Ids.Count==0){_message=L["Portal.Text.SelectLabelsFromTheBoxList"];return;}
        try{
            _boxes=Scm.ListDeliveryBoxes(Selection.Delivery,user).Where(b=>Selection.Ids.Contains(b.Id)).ToList();
            if(_boxes.Count!=Selection.Ids.Count){_boxes=[];_message=L["Portal.Text.TheDeliveryChangedOrWasCancelledSelectBoxesAgain"];}
        }catch(Exception ex){Logger.LogError(ex,"Box labels read failed");_message=L["Portal.Text.UnableToLoadLabels"];}
    }
}
