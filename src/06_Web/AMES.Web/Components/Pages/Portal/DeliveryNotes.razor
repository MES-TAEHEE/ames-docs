@inject IStringLocalizer<SharedResources> L
@page "/portal/delivery-notes"
@rendermode InteractiveServer
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Nav
@inject ILogger<DeliveryNotes> Logger

<PageTitle>@L["Portal.Text.DeliveryNote"] · AMES</PageTitle>
<AmesPageHeader Code="PORTAL-004" Title='@L["Portal.Text.DeliveryNoteInquiryIssue"]' />
<div class="note-actions">
    <RadzenButton Text='@L["Btn.Refresh"]' Icon="refresh" Click="Reload" />
</div>
@if (_error.Length>0) { <p role="alert">@_error</p> }
<div class="note-panel">
    <h3>@L["Portal.Text.SelectShippedDeliveries"]</h3>
    <p>@L["Portal.Text.SelectDeliveriesForTheSameSupplierToIssueOne"]</p>
    <div class="note-actions"><span>@L["Scm.Text.SelectLabel"] @_selected.Count</span><RadzenButton Text='@L["Portal.Text.IssueNoteForSelectedDeliveries"]' Icon="print" Disabled="@(_selected.Count==0 || _busy)" Click="Issue" /></div>
    <div class="note-scroll"><table><thead><tr><th>@L["Scm.Text.SelectLabel"]</th><th>@L["Portal.Text.DeliveryNumber"]</th><th>@L["Scm.Text.Supplier"]</th><th>@L["Portal.Text.PurchaseOrder"]</th><th>@L["Scm.Text.ShipDate"]</th></tr></thead>
    <tbody>@foreach(var d in _rows.Where(x=>x.NoteNumber is null))
    {
        <tr><td><input type="checkbox" aria-label='@L["Portal.Accessibility.SelectDelivery", d.Number]' checked="@_selected.Contains(d.Number)" disabled="@(_busy || (_selected.Count>0 && !_selected.Contains(d.Number) && _rows.First(x=>_selected.Contains(x.Number)).Vendor!=d.Vendor))" @onchange="e=>Toggle(d.Number,e.Value is true)" /></td><td>@d.Number</td><td>@d.Vendor</td><td>@d.Order</td><td>@d.ShipDate?.ToString("yyyy-MM-dd")</td></tr>
    }</tbody></table></div>
    @if (!_rows.Any(x=>x.NoteNumber is null)) { <p>@L["Portal.Text.NoDeliveriesAvailableForIssue"]</p> }
</div>
<div class="note-panel">
    <h3>@L["Portal.Text.IssuedDeliveryNotes"]</h3>
    <div class="note-scroll"><table><thead><tr><th>@L["Portal.Text.DocumentNumberBarcode"]</th><th>@L["Scm.Text.Supplier"]</th><th>@L["Portal.Text.IncludedDeliveries"]</th><th>@L["Portal.Text.Print"]</th></tr></thead>
    <tbody>@foreach(var group in _rows.Where(x=>x.NoteNumber is not null).GroupBy(x=>x.NoteNumber))
    {
        <tr><td>@group.Key</td><td>@group.First().Vendor</td><td>@string.Join(", ",group.Select(x=>x.Number))</td><td><a href="@($"/portal/delivery-note/{Uri.EscapeDataString(group.Key!)}")">@L["Portal.Text.ViewReprint"]</a></td></tr>
    }</tbody></table></div>
</div>

@code {
    string IssueError(string message) => message switch
    {
        "납품서를 조회할 권한이 없습니다." => L["Portal.Text.YouCannotAccessThisDelivery"],
        "출하 완료 납품서만 발행할 수 있습니다." => L["Portal.Text.OnlyShippedDeliveriesCanBeIssued"],
        "기존에 발행된 납품서입니다. 기존 문서를 재출력해 주세요." => L["Portal.Text.AlreadyIssuedReprintTheExistingDocument"],
        "같은 협력업체의 납품서만 묶을 수 있습니다." => L["Portal.Text.OnlyDeliveriesForTheSameSupplierCanBeGrouped"],
        "이미 다른 문서에 포함된 납품서입니다." => L["Portal.Text.ADeliveryIsAlreadyIncludedInAnotherDocument"],
        "이미 발행된 납품서는 다른 문서에 중복 포함할 수 없습니다." => L["Portal.Text.AnIssuedDeliveryCannotBeIncludedInAnotherDocument"],
        "납품 품목이 없습니다." => L["Portal.Text.ThereAreNoDeliveryItems"],
        _ => L["Portal.Text.UnableToIssueRefreshAndCheckVendorAccessAnd"]
    };

    List<ScmRepository.NoteDeliveryChoice> _rows=[];
    HashSet<string> _selected=[];
    string _user="",_actor="",_error="";
    bool _allowed,_busy;
    protected override async Task OnInitializedAsync()
    {
        var user=(await Authentication.GetAuthenticationStateAsync()).User;
        _allowed=PortalAuth.IsPortalUser(user);
        _user=user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value??"";
        _actor=ActorCode.Of(user); Reload();
    }
    void Toggle(string n,bool value) { if(value)_selected.Add(n);else _selected.Remove(n); }
    void Reload()
    {
        _rows=[];_selected.Clear();_error="";
        if(!_allowed || _user.Length==0){_error=L["Portal.Text.YouDoNotHavePermissionToViewThisPage"];return;}
        try{_rows=Scm.ListNoteDeliveries(_user);}
        catch(Exception ex){Logger.LogWarning(ex,"Delivery notes load failed");_error=L["Portal.Text.UnableToLoadTheList"];}
    }
    void Issue()
    {
        if(_busy||!_allowed||_selected.Count==0)return;
        _busy=true;_error="";
        try { var note=Scm.IssueDeliveryNote(_selected.ToArray(),_user,_actor);Nav.NavigateTo($"/portal/delivery-note/{note.Number}"); }
        catch(InvalidOperationException ex){_error=IssueError(ex.Message);}
        catch(Exception ex){Logger.LogWarning(ex,"Batch note issue failed");_error=L["Portal.Text.UnableToIssueRefreshAndCheckVendorAccessAnd"];}
        finally{_busy=false;}
    }
}
