@page "/portal/delivery-boxes"
@rendermode InteractiveServer
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject PortalQuantityFormat QtyFormat
@inject NavigationManager Nav
@inject ILogger<DeliveryBoxes> Logger
@inject IStringLocalizer<SharedResources> L
@if(!Embedded)
{
<PageTitle>@L["Portal.Text.BoxBarcodePrinting"] · AMES</PageTitle>
<AmesPageHeader Code="PORTAL-003" Title='@L["Portal.Text.BoxBarcodePrinting"]' />
<div class="box-toolbar"><RadzenButton Text='@L["Portal.Text.BackToDeliveryManagement"]' Icon="arrow_back" Click="BackToDeliveries" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" class="ames-rz-btn" /><RadzenButton Text='@L["Btn.Refresh"]' Icon="refresh" Click="Load" Size="ButtonSize.Small" class="ames-rz-btn" /></div>
}
@if(_error.Length>0){<RadzenAlert AlertStyle="AlertStyle.Warning">@_error</RadzenAlert>}
<div class="box-layout @(Embedded?"embedded":"")">
    @if(!Embedded)
    {
    <div class="ames-card">
        <div class="ames-card-h">@L["Portal.Text.Deliveries"] · @_rows.Count</div>
        <RadzenTextBox @bind-Value="_search" Immediate="true" Placeholder='@L["Portal.DeliveryBoxes.Ph.Search"]' aria-label='@L["Portal.Text.SearchDeliveries"]' class="ames-rz-input" Style="width:100%" />
        <RadzenDataGrid TItem="ScmRepository.BoxDelivery" Data="@Rows" Class="ames-rz-grid" AllowPaging="true" PageSize="15" RowClick="@(e=>{if(e.Data is not null)Select(e.Data);})" EmptyText='@L["Portal.Text.NoDeliveries"]'>
            <Columns>
                <RadzenDataGridColumn TItem="ScmRepository.BoxDelivery" Title='@L["Portal.Text.Delivery"]'><Template Context="d"><button class="box-document" @onclick="()=>Select(d)">@d.Number</button><div class="dim">@d.Vendor · @d.Date.ToString("yyyy-MM-dd")</div></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ScmRepository.BoxDelivery" Title='@L["Col.Status"]'><Template Context="d">@Status(d.Status)</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ScmRepository.BoxDelivery" Property="Boxes" Title='@L["Portal.Text.Boxes.fb6660"]' TextAlign="TextAlign.Right" />
            </Columns>
        </RadzenDataGrid>
    </div>
    }
    <div class="ames-card">
        <div class="ames-card-h">@L["Portal.Text.Boxes"] @(_document?.Number) · @_boxes.Count</div>
        <div class="box-toolbar">
            <RadzenButton Text='@L["Portal.Text.SelectAll"]' Click="SelectAll" Disabled="@(_boxes.Count==0)" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text='@L["Portal.Text.ClearSelection"]' Click="()=>_selected.Clear()" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text='@L["Portal.Text.PrintSelectedLabels"]' Icon="print" Click="Print" Disabled="@(_selected.Count==0)" Size="ButtonSize.Small" />
            <span>@L["Scm.Text.SelectLabel"] @_selected.Count</span>
        </div>
        @if(_document is not null && _boxes.Count==0){<p class="dim">@(_document.Status=="Cancelled"?L["Portal.Text.ThisDeliveryIsCancelledLabelsCannotBePrinted"]:L["Portal.Text.NoSavedBoxesBoxesAreNotAutomaticallyGeneratedFor"])</p>}
        <RadzenDataGrid TItem="ScmRepository.DeliveryBox" Data="@_boxes" Class="ames-rz-grid" AllowPaging="true" PageSize="20" EmptyText='@L["Portal.Text.SelectADelivery"]'>
            <Columns>
                <RadzenDataGridColumn TItem="ScmRepository.DeliveryBox" Title='@L["Scm.Text.SelectLabel"]' Width="55px"><Template Context="b"><input type="checkbox" aria-label='@L["Portal.Accessibility.SelectBox", b.Number]' checked="@_selected.Contains(b.Id)" @onchange="e=>Toggle(b.Id,e.Value is true)" /></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ScmRepository.DeliveryBox" Property="Item" Title='@L["Portal.Text.ItemCode"]' />
                <RadzenDataGridColumn TItem="ScmRepository.DeliveryBox" Property="Name" Title='@L["Scm.Text.Description"]' />
                <RadzenDataGridColumn TItem="ScmRepository.DeliveryBox" Property="Number" Title='@L["Portal.Text.BoxNumber"]' />
                <RadzenDataGridColumn TItem="ScmRepository.DeliveryBox" Property="Sequence" Title='@L["Portal.Text.Sequence"]' Width="65px" />
                <RadzenDataGridColumn TItem="ScmRepository.DeliveryBox" Title='@L["Col.Quantity"]' TextAlign="TextAlign.Right"><Template Context="b">@QtyFormat.Text(b.Quantity,b.Unit)</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ScmRepository.DeliveryBox" Property="Unit" Title='@L["Scm.Text.Unit"]' Width="65px" />
            </Columns>
        </RadzenDataGrid>
    </div>
</div>
@code {
    void BackToDeliveries() => Nav.NavigateTo("/portal/deliveries");
    [Parameter] public bool Embedded {get;set;}
    [Parameter, SupplyParameterFromQuery] public string? Number {get;set;}
    List<ScmRepository.BoxDelivery> _rows=[];
    List<ScmRepository.DeliveryBox> _boxes=[];
    ScmRepository.BoxDelivery? _document;
    HashSet<long> _selected=[];
    string _user="",_search="",_error="";
    bool _allowed;
    IEnumerable<ScmRepository.BoxDelivery> Rows=>_rows.Where(d=>$"{d.Number} {d.Vendor} {d.Order}".Contains(_search,StringComparison.OrdinalIgnoreCase));
    string Status(string s) => s switch { "Registered" => L["Portal.Text.Registered"], "Shipped" => L["Scm.Text.ShippedLabel"], "Received" => L["Portal.Text.Received.a5320e"], "Cancelled" => L["Scm.Text.Cancelled.7cc538"], _ => s };
    protected override async Task OnParametersSetAsync()
    {
        var u=(await Authentication.GetAuthenticationStateAsync()).User;
        _user=u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value??"";
        _allowed=PortalAuth.IsPortalUser(u);
        Load();
        if(_rows.Find(d=>d.Number==Number) is {} d)Select(d);
    }
    void Load()
    {
        _rows=[];_boxes=[];_selected.Clear();_document=null;_error="";
        if(!_allowed||_user.Length==0)return;
        try{_rows=Scm.ListBoxDeliveries(_user);}
        catch(Exception ex){Logger.LogError(ex,"Box delivery list failed");_error=L["Portal.Text.UnableToLoadDeliveries"];}
    }
    void Select(ScmRepository.BoxDelivery d)
    {
        _document=d;_boxes=[];_selected.Clear();_error="";
        try{_boxes=Scm.ListDeliveryBoxes(d.Number,_user);}
        catch(Exception ex){Logger.LogError(ex,"Box list failed");_error=L["Portal.Text.UnableToLoadBoxes"];}
    }
    void Toggle(long id,bool selected){if(selected)_selected.Add(id);else _selected.Remove(id);}
    void SelectAll()=>_selected=_boxes.Select(b=>b.Id).ToHashSet();
    void Print()
    {
        if(_document is null||_selected.Count==0)return;
        // Keep the selection server-side; the print page rechecks current vendor access and active boxes.
        Selection.Delivery=_document.Number;Selection.Ids=_selected.ToHashSet();
        Nav.NavigateTo("/portal/box-labels");
    }
    [Inject] public BoxLabelSelection Selection {get;set;}=default!;
}
