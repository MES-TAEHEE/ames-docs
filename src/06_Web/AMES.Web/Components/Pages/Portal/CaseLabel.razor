@page "/portal/case-label/{Number}"
@layout EmptyLayout
@rendermode InteractiveServer
@inject UomFormat UomFmt
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject ILogger<CaseLabel> Logger
@inject PortalQuantityFormat QtyFormat
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Portal.CaseLabel.Title"] · @Number</PageTitle>
<div class="label-tools portal-print-toolbar">
    <a href="/portal/deliveries">@L["Portal.Text.BackToDeliveryManagement"]</a>
    @if (_case is not null)
    {
        <button type="button" class="ames-btn" data-delivery-note-print data-no-busy>@L["Btn.Print"]</button>
    }
    @if(_message.Length>0){<p role="alert">@_message</p>}
</div>
@if (_case is not null)
{
    <article class="delivery-note case-labels">
    @foreach (var page in _case.Boxes.GroupBy(b => new { b.Item, b.Name, b.Unit })
        .Select(g => new { g.Key.Item, g.Key.Name, g.Key.Unit, Boxes = g.Count(), Qty = g.Sum(b => b.Quantity) }).Chunk(14))
    {
        <section class="case-label">
            <header><strong>SHIPPING UNIT</strong><span>@_case.VendorName</span></header>
            <div class="case-barcode"><Code128Barcode Value="@_case.Number" Height="85" /><strong>@_case.Number</strong></div>
            <div class="case-info">
                <span>Delivery Note<strong>@(string.IsNullOrEmpty(_case.NoteNumber) ? "—" : _case.NoteNumber)</strong></span>
                <span>Purchase Order<strong>@_case.Order</strong></span>
                <span>Boxes<strong>@_case.Boxes.Count</strong></span>
            </div>
            <table><thead><tr><th>Part No</th><th>Part Name</th><th>Boxes</th><th>Qty</th><th>Unit</th></tr></thead>
                <tbody>@foreach (var item in page) { <tr><td>@item.Item</td><td>@item.Name</td><td>@item.Boxes</td><td>@QtyFormat.Text(item.Qty,item.Unit)</td><td>@UomFmt.Sym(item.Unit)</td></tr> }</tbody>
            </table>
        </section>
    }
    </article>
}
@code {
    [Parameter] public string Number { get; set; } = "";
    ScmRepository.DeliveryCase? _case;
    string _message = "";
    protected override async Task OnParametersSetAsync()
    {
        _case = null; _message = "";
        var u = (await Authentication.GetAuthenticationStateAsync()).User;
        var id = u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!PortalAuth.IsPortalUser(u) || string.IsNullOrWhiteSpace(id)) { _message = L["Portal.Note.AccessDenied"]; return; }
        try
        {
            _case = Scm.GetDeliveryCase(Number, id);
            if (_case is null || _case.Boxes.Count == 0) { _case = null; _message = L["Portal.CaseLabel.Err.NotFound"]; }
        }
        catch (Exception ex) { Logger.LogError(ex, "Case label lookup failed"); _message = L["Portal.CaseLabel.Err.Load"]; }
    }
}
