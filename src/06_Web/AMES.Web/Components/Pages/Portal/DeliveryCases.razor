@page "/portal/delivery-cases"
@page "/portal/delivery-entry"
@rendermode InteractiveServer
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject ILogger<DeliveryCases> Logger
@inject PortalQuantityFormat QtyFormat
@inject UomFormat UomFmt
@inject AuditLogger Audit
@inject IStringLocalizer<SharedResources> L

<div data-no-busy>
@if(!Embedded)
{
    <PageTitle>@L["Portal.Create.Title"] · AMES</PageTitle>
    <AmesPageHeader Code="PORTAL-002" Title='@L["Portal.Create.Title"]' />
    <a href="/portal/due-orders">@L["Portal.Create.BackToList"]</a>
}
@if(_error.Length>0){<RadzenAlert AlertStyle="AlertStyle.Warning">@_error</RadzenAlert>}
@if(_message.Length>0){<RadzenAlert AlertStyle="AlertStyle.Success">@_message</RadzenAlert>}
@if(_createdNote.Length>0)
{
    <p><a href="@($"/portal/delivery-note/{Uri.EscapeDataString(_createdNote)}")" target="_blank" rel="noopener">@L["Portal.Create.PrintNote"] · @_createdNote</a></p>
}
@if(_allowed && !_editingCase)
{
    <section class="ames-card">
        <div class="ames-card-h">@L["Portal.Create.Items"] · @_draftCases.Count</div>
        <div class="case-cards">
            @foreach(var item in _draftCases)
            {
                <RadzenButton class="@($"case-tile {(_activeCase==item?"active":"")}")" Click="()=>SelectDraftCase(item)" Disabled="@_busy" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small">
                    <RadzenIcon Icon="inventory_2" /><strong>@L["SCM.Preview.Lbl.Case"] @(_draftCases.IndexOf(item)+1)</strong><span>@L["Portal.ShippingUnit.ContentsCount", item.Count]</span>
                </RadzenButton>
            }
            <RadzenButton class="case-tile case-add" Click="AddShippingUnit" Disabled="@_busy" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small">
                <RadzenIcon Icon="add_box" /><strong>@L["Portal.Create.AddCase"]</strong>
            </RadzenButton>
        </div>
        @if(_activeCase is {} detail)
        {
            <div class="case-detail">
                <div class="case-toolbar"><strong>@L["SCM.Preview.Lbl.Case"] @(_draftCases.IndexOf(detail)+1)</strong>
                    <RadzenButton Text='@L["Portal.Create.RemoveCase"]' ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="()=>RemoveDraftCase(detail)" Disabled="@_busy" />
                </div>
                <div class="case-table-scroll"><table class="ames-table">
                    <thead><tr><th>@L["Portal.Create.Box"]</th><th>@L["SCM.Preview.Col.PoNo"]</th><th>@L["SCM.Preview.Col.PartNoName"]</th><th>@L["Col.Qty"]</th></tr></thead>
                    <tbody>@foreach(var box in detail)
                    {
                        <tr><td>@(detail.IndexOf(box)+1)</td><td>@box.Row.Order</td><td>@box.Row.Part.Item<div class="dim">@box.Row.Part.Name</div></td><td>@QtyWithContents(box.Quantity,box.Row.Part)</td></tr>
                    }</tbody>
                </table></div>
            </div>
        }
    </section>
    @if(NoteBoxes.Any())
    {
        <section class="ames-card case-review">
            <div class="ames-card-h">@L["Portal.Create.ReviewFmt", _draftCases.Count, NoteBoxCount]</div>
            <div class="case-table-scroll"><table class="ames-table">
                <thead><tr><th>@L["SCM.Preview.Col.PoNo"]</th><th>@L["SCM.Preview.Col.PartNoName"]</th><th>@L["Portal.Create.Col.SelectedQty"]</th><th>@L["Portal.Create.Col.BoxesParts"]</th></tr></thead>
                <tbody>@foreach(var item in NoteBoxes.GroupBy(b=>new { b.Row.Order, b.Row.Part.Item, b.Row.Part.Name, b.Row.Part.Unit }))
                {
                    <tr><td class="case-po-code">@item.Key.Order</td><td><strong>@item.Key.Item</strong><div class="dim">@item.Key.Name</div></td>
                        <td>@QtyWithContents(item.Sum(b=>b.Quantity),item.First().Row.Part)</td>
                        <td>@item.Count()</td></tr>
                }</tbody>
            </table></div>
        </section>
    }
    <div class="case-toolbar case-create-footer">
        <label>@L["Scm.Text.DeliveryDate.246618"] <input type="date" class="ames-input" @bind="_deliveryDate" @bind:format="yyyy-MM-dd" disabled="@_busy" /></label>
        <RadzenButton Text='@L["SCM.Preview.Btn.CreateNote"]' Icon="description" Click="CreateNote" Disabled="@(_busy || _draftCases.Count==0)" />
    </div>
}
@if(_allowed && _editingCase)
{
    <section class="ames-card">
        <div class="ames-card-h">@L["Portal.Create.AddHeadFmt", L["SCM.Preview.Lbl.Case"]]</div>
        <div class="case-po-scroll"><table class="ames-table">
            <thead><tr><th></th><th>@L["SCM.Preview.Col.PoNo"]</th><th>@L["Scm.Text.OrderDate"] ↑</th><th>@L["Scm.Text.Supplier"]</th><th>@L["Scm.Text.Destination"]</th><th>@L["Scm.Text.DueDate"]</th><th>@L["Col.Status"]</th></tr></thead>
            <tbody>@foreach(var order in _orders.OrderBy(o=>o.Ordered).ThenBy(o=>o.Number))
            {
                var expanded=_expandedOrders.Contains(order.Number);
                var boxes=_draft.Where(b=>b.Row.Order==order.Number).ToList();
                <tr class="case-po-row @(expanded?"case-po-open":"")" @onclick="()=>ToggleOrder(order.Number)">
                    <td><button type="button" class="case-expand" aria-label='@L["Portal.Create.ExpandFmt", order.Number]' aria-expanded="@expanded" disabled="@_busy">@(expanded?"▾":"▸")</button></td>
                    <td><strong class="case-po-code">@order.Number</strong></td><td>@order.Ordered.ToString(DateFmt.Date)</td><td>@order.VendorName</td><td>@order.Destination</td><td>@order.Due.ToString(DateFmt.Date)</td><td><span class="case-confirmed">@L["Scm.Text.Confirmed"]</span></td>
                </tr>
                @if(expanded)
                {
                    <tr class="case-po-content"><td colspan="7">
                        <section class="case-step">
                        <div class="case-step-heading"><span class="case-step-number">1</span><div><h3>@L["Portal.Create.Step1"]</h3><p>@L["Portal.Create.Step1Hint.Boxes"]</p></div></div>
                        <div class="case-table-scroll case-part-table"><table class="ames-table">
                            <thead><tr><th>@L["SCM.Preview.Col.PartNoName"]</th><th>@L["SCM.Preview.Col.QtyToDeliver"]</th><th>@L["Portal.Create.Col.TotalQty"]</th><th>@L["Portal.Create.Col.BoxesNeeded"]</th></tr></thead>
                            <tbody>@foreach(var row in _parts.Where(p=>p.Order==order.Number))
                            {
                                <tr @key="row.Part.PoID" class="@(Available(row)<=0?"case-part-unavailable":"")"><td>@row.Part.Item<div class="dim">@row.Part.Name</div></td>
                                    <td>
                                        <strong>@QtyWithContents(Available(row),row.Part)</strong>
                                        @if(Available(row)<=0)
                                        {
                                            var documents=_deliveries.Where(d=>d.PoID==row.Part.PoID && d.Status!="Cancelled").Select(d=>d.Number).Distinct().ToArray();
                                            @if(documents.Length>0){<div class="case-allocation">@string.Join(", ",documents) · @L["Portal.Create.AlreadyRegistered"]</div>}
                                            @foreach(var item in VisibleCases.Where(c=>c.Boxes.Any(b=>b.PoID==row.Part.PoID)))
                                            {<div class="case-allocation">@item.Number · @L["Portal.Create.AlreadyPacked"]</div>}
                                            @foreach(var draftCase in _draftCases.Where(c=>c.Any(b=>b.Row.Part.PoID==row.Part.PoID)))
                                            {<div class="case-allocation">@L["SCM.Preview.Lbl.Case"] @(_draftCases.IndexOf(draftCase)+1) · @L["Portal.Create.AddedToNote"]</div>}
                                            @if(documents.Length==0 && row.Part.Prepared==0){<div class="dim">@(row.Part.Received>0?L["Portal.Create.AlreadyReceived"]:L["Portal.Create.NothingLeft"])</div>}
                                        }
                                    </td>
                                    <td><label class="case-quantity-editor"><input class="ames-input" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" placeholder="0"
                                        @bind:get="row.QuantityText" @bind:set="value=>ChangeQuantity(row,value)" @bind:event="oninput" disabled="@(_busy || Available(row)<=0)"
                                        aria-invalid="@(!row.InputValid || row.Quantity>Available(row)?"true":"false")" aria-label='@(L["Portal.Create.Col.TotalQty"] + " " + row.Order + " " + row.Part.Item)' /></label>
                                        @if(Available(row)>0 && !CanPack(row)){<div class="case-input-message">@IssueText(row.Part.Issue)</div>}
                                        else if(!row.InputValid){<div class="case-input-message">@L["Portal.Create.Err.WholeNumber"]</div>}
                                    </td>
                                    <td><div class="case-box-result"><strong>@(PackSize(row)>0?decimal.Ceiling(row.Quantity/PackSize(row)):0)</strong>
                                        @if(PackSize(row)>0){<span>(@BoxCapacityText(row))</span>}
                                    </div>
                                        @if(PackSize(row)<=0 && Available(row)>0)
                                        {
                                            <strong>@L["Portal.Text.NotSet"]</strong>
                                            @if(row.Part.Issue is "Packing quantity missing" or "Vendor mapping missing")
                                            {
                                                <div class="case-packing-editor">
                                                    <input class="ames-input" type="number" min="1" step="1" @bind="row.NewPackingQty" placeholder='@L["Portal.Create.Ph.QtyPerBox"]' aria-label='@(L["Portal.Create.Ph.QtyPerBox"] + " " + row.Part.Item)' disabled="@_busy" />
                                                    <RadzenButton Text='@L["Portal.Create.Btn.SaveBoxSize"]' Size="ButtonSize.ExtraSmall" Click="()=>SavePacking(row)" Disabled="@_busy" />
                                                </div>
                                            }
                                            else { <div class="case-input-message">@IssueText(row.Part.Issue). @L["Portal.Create.AskEos"]</div> }
                                        }
                                    </td></tr>
                            }</tbody>
                        </table></div>
                        </section>
                        <section class="case-step">
                        <div class="case-step-heading"><span class="case-step-number">2</span><div><h3>@L["Portal.Create.Step2.Boxes"]</h3><p>@L["Portal.Create.Step2Hint.Boxes"]</p></div></div>
                        @if(boxes.Count==0){<p class="case-step-empty">@L["Portal.Create.Step2Empty.Boxes"]</p>}
                        else
                        {
                        <div class="case-toolbar case-box-actions">
                            <label><input type="checkbox" checked="@(boxes.Count>0 && boxes.All(b=>b.Selected))" @onchange="e=>SelectOrderBoxes(order,e.Value is true)" disabled="@(_busy || boxes.Count==0 || !CanSelectOrder(order))" /> @L["Portal.Text.SelectAll"]</label>
                            <span>@L["Portal.Create.SelectedFmt", boxes.Count(b=>b.Selected), boxes.Count, SelectedQuantityText(boxes)]</span>
                        </div>
                        <div class="case-table-scroll case-box-table"><table class="ames-table"><thead><tr><th>@L["Scm.Text.Select"]</th><th>@L["Portal.Create.Col.BoxesParts"]</th><th>@L["SCM.Preview.Col.PartNoName"]</th><th>@L["Col.Qty"]</th></tr></thead>
                            <tbody>@foreach(var box in boxes)
                            {
                                <tr><td><input type="checkbox" checked="@box.Selected" @onchange="e=>SelectBox(box,e.Value is true)" disabled="@(_busy || !CanSelectOrder(order))" aria-label='@(L["Scm.Text.Select"] + " " + order.Number + " " + box.Row.Part.Item + " " + box.Sequence)' /></td>
                                    <td>@box.Sequence</td><td>@box.Row.Part.Item<div class="dim">@box.Row.Part.Name</div></td><td>@QtyWithContents(box.Quantity,box.Row.Part)</td></tr>
                            }</tbody>
                        </table></div>
                        }
                        </section>
                    </td></tr>
                }
            }</tbody>
        </table></div>
        @if(_orders.Count==0){<p class="case-empty">@L["Portal.Create.NoOrders"]</p>}
    </section>
    @if(_draft.Any(b=>b.Selected))
    {
        <section class="ames-card case-review">
            <div class="ames-card-h">@L["Portal.Create.SelectedForFmt", L["SCM.Preview.Lbl.Case"]]</div>
            <div class="case-table-scroll"><table class="ames-table">
                <thead><tr><th>@L["SCM.Preview.Col.PoNo"]</th><th>@L["SCM.Preview.Col.PartNoName"]</th><th>@L["Portal.Create.Col.QtyToAdd"]</th><th>@L["Portal.Create.Col.BoxesParts"]</th></tr></thead>
                <tbody>@foreach(var item in _draft.Where(b=>b.Selected).GroupBy(b=>new { b.Row.Order, b.Row.Part.Item, b.Row.Part.Name, b.Row.Part.Unit }))
                {
                    <tr><td class="case-po-code">@item.Key.Order</td><td><strong>@item.Key.Item</strong><div class="dim">@item.Key.Name</div></td>
                        <td>@QtyWithContents(item.Sum(b=>b.Quantity),item.First().Row.Part)</td><td>@item.Count()</td></tr>
                }</tbody>
            </table></div>
        </section>
    }
}
@if(_allowed && _editingCase)
{
    <div class="case-toolbar case-create-footer">
        <span>@L["Portal.Create.FooterFmt", _draft.Count(b=>b.Selected), _draft.Where(b=>b.Selected).Select(b=>b.Row.Part.Item).Distinct().Count()]</span>
        <RadzenButton Text='@L["Btn.Cancel"]' ButtonStyle="ButtonStyle.Light" Click="CancelCase" Disabled="@_busy" />
        <RadzenButton Text='@L["Portal.Create.Btn.Done"]' Icon="check" Click="CompleteCase" Disabled="@(_busy || _quantityError || !_draft.Any(b=>b.Selected))" />
    </div>
}

</div>
@code {
    [Parameter] public bool Embedded {get;set;}
    [Parameter] public string? InitialOrder {get;set;}
    [Parameter] public EventCallback Changed {get;set;}
    [SupplyParameterFromQuery] public string? Order {get;set;}
    [SupplyParameterFromQuery] public string? OrderNumber {get;set;}
    sealed class PartEdit(string order,ScmRepository.CasePart part)
    {
        public string Order {get;}=order;
        public ScmRepository.CasePart Part {get;}=part;
        public decimal Quantity {get;set;}
        public string QuantityText {get;set;}="";
        public bool InputValid {get;set;}=true;
        public decimal? NewPackingQty {get;set;}
    }
    sealed class DraftBox(PartEdit row,decimal quantity,int sequence)
    {
        public PartEdit Row {get;}=row;
        public decimal Quantity {get;}=quantity;
        public int Sequence {get;}=sequence;
        public bool Selected {get;set;}
    }
    List<ScmRepository.PurchaseOrder> _orders=[];
    List<PartEdit> _parts=[];
    List<DraftBox> _draft=[];
    List<ScmRepository.DeliveryCase> _cases=[];
    List<ScmRepository.SupplierDelivery> _deliveries=[];
    HashSet<string> _selectedOrders=new(StringComparer.OrdinalIgnoreCase);
    HashSet<string> _expandedOrders=new(StringComparer.OrdinalIgnoreCase);
    IEnumerable<ScmRepository.DeliveryCase> VisibleCases => _cases.Where(c=>c.Status=="Prepared" && c.NoteNumber.Length==0 && c.Delivery is null
        && c.Boxes.Any(b=>_selectedOrders.Contains(b.Order))).OrderBy(c=>c.CreatedAt).ThenBy(c=>c.Number);
    DateTime _deliveryDate=DbClock.Today;
    string _user="",_actor="",_error="",_message="",_createdNote="";
    List<List<DraftBox>> _draftCases=[];
    IEnumerable<DraftBox> NoteBoxes => _draftCases.SelectMany(c=>c);
    int NoteBoxCount => _draftCases.Sum(c=>c.Count);
    string SelectedQuantityText(IEnumerable<DraftBox> boxes)
    {
        var quantities=boxes.Where(b=>b.Selected).GroupBy(b=>b.Row.Part.Unit)
            .Select(g=>$"{QtyFormat.Text(g.Sum(b=>b.Quantity),g.Key)} {UomFmt.Sym(g.Key)}");
        return string.Join(" / ",quantities) is { Length: >0 } text ? text : "0";
    }
    List<DraftBox>? _activeCase;
    bool _editingCase;
    decimal Available(PartEdit row)=>Math.Max(0,row.Part.Available-_draftCases.SelectMany(c=>c).Where(b=>b.Row.Part.PoID==row.Part.PoID).Sum(b=>b.Quantity));
    decimal PackSize(PartEdit row)=>row.Part.PackingQty;
    string BoxCapacityText(PartEdit row)=>L["Portal.Create.PerBoxFmt", $"{QtyFormat.Text(PackSize(row),row.Part.Unit)} {UomFmt.Sym(row.Part.Unit)}"];
    // 저장소 SQL 이 영어 문장으로 넘기는 품목 문제(CasePart.Issue) — 비교 코드로도 쓰여 그대로 두고 표시만 바꾼다
    string IssueText(string issue)=>issue switch {
        "Item master missing"=>L["Portal.Issue.ItemMissing"], "Item inactive"=>L["Portal.Issue.ItemInactive"],
        "Vendor mapping inactive"=>L["Portal.Issue.VendorInactive"], "Vendor mapping missing"=>L["Portal.Issue.VendorMissing"],
        "Packing quantity missing"=>L["Portal.Issue.PackingMissing"], _=>issue };
    string QtyWithContents(decimal qty,ScmRepository.CasePart part)
        =>$"{QtyFormat.Text(qty,part.Unit)} {UomFmt.Sym(part.Unit)}";
    bool CanPack(PartEdit row)=>row.Part.Issue.Length==0;
    bool _allowed,_busy,_quantityError;
    string? _loadedKey;
    protected override async Task OnParametersSetAsync()
    {
        var user=(await Authentication.GetAuthenticationStateAsync()).User;
        _allowed=PortalAuth.IsPortalUser(user);
        _user=user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value??"";
        _actor=ActorCode.Of(user);
        if(!_allowed||_user.Length==0){_allowed=false;_error=L["Portal.Text.YouDoNotHavePermissionToViewThisPage"];return;}
        var order=InitialOrder??Order??OrderNumber??"";
        var key=$"{_user}|{order}";if(_loadedKey==key)return;_loadedKey=key;
        _selectedOrders.Clear();_expandedOrders.Clear();
        if(order.Length>0){_selectedOrders.Add(order);_expandedOrders.Add(order);}
        await Reload();
    }
    async Task Reload()
    {
        if(!_allowed)return;
        _error="";_message="";
        try
        {
            var data=await Task.Run(()=>(Orders:Scm.ListPurchaseOrders(true,_user,confirmedOnly:true,packableOnly:true),Cases:Scm.ListDeliveryCases(null,_user),Deliveries:Scm.ListSupplierDeliveries(true,_user)));
            _orders=data.Orders.Where(o=>o.Status is "Open" or "Partial" && o.SupplierConfirmedAt.HasValue && o.Lines.Any(l=>l.ItemExists && MasterDataRepository.IsQuantityUnit(l.Unit))).ToList();
            _selectedOrders.RemoveWhere(n=>!_orders.Any(p=>p.Number==n));
            _cases=data.Cases;_deliveries=data.Deliveries;
            await LoadParts();
        }
        catch(Exception ex){_orders=[];_cases=[];_deliveries=[];_parts=[];_draft=[];Fail(ex,L["Portal.Create.Err.Load"]);}
    }
    bool CanSelectOrder(ScmRepository.PurchaseOrder order)
    {
        var selectedOrder=_draftCases.SelectMany(c=>c).FirstOrDefault()?.Row.Order
            ?? _draft.FirstOrDefault(b=>b.Selected)?.Row.Order;
        var first=_orders.FirstOrDefault(o=>o.Number==selectedOrder);
        return first is null||(first.Vendor==order.Vendor && first.Destination==order.Destination);
    }
    async Task ToggleOrder(string order)
    {
        if(_busy)return;
        if(_expandedOrders.Remove(order))return;
        _expandedOrders.Add(order);
        if(!_selectedOrders.Add(order))return;
        try{await LoadParts(true);}catch(Exception ex){_parts=[];_draft=[];Fail(ex,L["Portal.Create.Err.LoadItems"]);}
    }
    int _partsLoadId;
    async Task LoadParts(bool preserve=false)
    {
        var request=++_partsLoadId;
        var orders=_selectedOrders.Order(StringComparer.Ordinal).ToArray();
        var parts=await Task.Run(()=>orders.SelectMany(order=>Scm.ListCaseParts(order,_user)
            .Where(p=>p.Available>0 && MasterDataRepository.IsQuantityUnit(p.Unit)).Select(p=>(Order:order,Part:p))).ToList());
        if(request!=_partsLoadId)return;
        var previous=_parts.ToDictionary(p=>p.Part.PoID);
        _parts=parts.Select(p=>new PartEdit(p.Order,p.Part)
            {
                Quantity=preserve&&previous.TryGetValue(p.Part.PoID,out var old)?old.Quantity:0,
                QuantityText=preserve&&previous.TryGetValue(p.Part.PoID,out var text)?text.QuantityText:"",
                InputValid=!preserve||!previous.TryGetValue(p.Part.PoID,out var valid)||valid.InputValid
            }).ToList();
        RebuildBoxes();
    }
    void ChangeQuantity(PartEdit row,string? text)
    {
        row.QuantityText=text??"";
        var valid=decimal.TryParse(row.QuantityText,System.Globalization.NumberStyles.None,System.Globalization.CultureInfo.InvariantCulture,out var qty);
        row.Quantity=valid?qty:0;row.InputValid=row.QuantityText.Length==0||valid;RebuildBoxes();
    }
    async Task SavePacking(PartEdit row)
    {
        if(_busy||!_allowed||row.Part.Unit=="BOX")return;
        if(row.NewPackingQty is null or <=0 || decimal.Truncate(row.NewPackingQty.Value)!=row.NewPackingQty.Value)
        {_error=L["Portal.Create.Err.BoxQty"];return;}
        var order=_orders.FirstOrDefault(o=>o.Number==row.Order);
        if(order is null)return;
        _busy=true;
        try
        {
            if(!await Task.Run(()=>Scm.CreatePortalPackingQuantity(_user,row.Part.Item,order.Vendor,row.NewPackingQty.Value)))
            {_error=L["Portal.Create.Err.PackingChanged"];return;}
            Audit.Updated("PORTAL-004", "SCM_ItemVendor", $"{order.Vendor}/{row.Part.Item}",
                new { PackingQty=row.Part.PackingQty }, new { PackingQty=row.NewPackingQty });
            await LoadParts(true);_message=L["Portal.Create.Ok.BoxQtyFmt", row.Part.Item];
        }
        catch(Exception ex){Fail(ex,L["Portal.Create.Err.SaveBoxQty"]);}
        finally{_busy=false;}
    }
    void RebuildBoxes()
    {
        var selected=_draft.Where(b=>b.Selected).Select(b=>(b.Row.Part.PoID,b.Sequence,b.Quantity)).ToHashSet();
        _draft=[];_error="";
        bool Valid(PartEdit p)=>p.InputValid&&p.Quantity>=0&&p.Quantity<=Available(p)&&decimal.Truncate(p.Quantity)==p.Quantity&&
            (p.Quantity==0||(PackSize(p)>0&&CanPack(p)));
        _quantityError=_parts.Any(p=>!Valid(p));
        if(_quantityError)_error=L["Portal.Create.Err.Quantities"];
        if(_parts.Where(Valid).Sum(p=>PackSize(p)>0?decimal.Ceiling(p.Quantity/PackSize(p)):0)+_draftCases.Sum(c=>c.Count)>1000)
        {_quantityError=true;_error=L["Portal.Create.Err.MaxBoxes"];return;}
        foreach(var row in _parts.Where(p=>Valid(p)&&p.Quantity>0))
        {
            var index=0;
            for(decimal left=row.Quantity;left>0;left-=PackSize(row))
            {
                var qty=Math.Min(left,PackSize(row));
                _draft.Add(new(row,qty,++index){Selected=selected.Contains((row.Part.PoID,index,qty))});
            }
        }
    }
    void SelectBox(DraftBox box,bool value)
    {
        if(_busy)return;
        if(!value || _orders.Any(o=>o.Number==box.Row.Order&&CanSelectOrder(o)))box.Selected=value;
    }
    void SelectOrderBoxes(ScmRepository.PurchaseOrder order,bool value)
    {
        if(_busy || (value&&!CanSelectOrder(order)))return;
        foreach(var box in _draft.Where(b=>b.Row.Order==order.Number))box.Selected=value;
    }
    void AddShippingUnit()
    {
        if(_busy)return;
        _error="";_message="";_draft=[];_parts=[];_selectedOrders.Clear();_expandedOrders.Clear();
        _editingCase=true;_quantityError=false;
    }
    void CancelCase()
    {
        ++_partsLoadId;_editingCase=false;_draft=[];_parts=[];_error="";
    }
    void CompleteCase()
    {
        if(_busy||!_allowed||_quantityError||!_draft.Any(b=>b.Selected))return;
        _activeCase=_draft.Where(b=>b.Selected).ToList();_draftCases.Add(_activeCase);
        CancelCase();
    }
    void RemoveDraftCase(List<DraftBox> item)
    {
        if(_busy)return;
        _draftCases.Remove(item);_activeCase=null;
    }
    void SelectDraftCase(List<DraftBox> item){_activeCase=_activeCase==item?null:item;}
    async Task CreateNote()
    {
        if(_busy||!_allowed||_editingCase||_draftCases.Count==0)return;_busy=true;_createdNote="";
        try
        {
            var cases=_draftCases.Select(boxes=>new ScmRepository.CaseDraftInput(
                boxes.Select(b=>b.Row.Order).Distinct().ToArray(),
                boxes.Select(b=>new ScmRepository.CaseBoxInput(b.Row.Part.PoID,b.Quantity)).ToArray())).ToArray();
            var date=_deliveryDate;
            var note=await Task.Run(()=>Scm.CreateDeliveryNoteFromDraftCases(cases,date,_user,_actor));
            _draftCases.Clear();_activeCase=null;await Reload();_createdNote=note.Number;_message=L["Portal.Create.Ok.CreatedFmt", note.Number];
            LogCreated(note);await Changed.InvokeAsync();
        }
        catch(Exception ex){Fail(ex,L["Portal.Create.Err.Create"]);}
        finally{_busy=false;}
    }
    void LogCreated(ScmRepository.DeliveryNote note)
    {try{Audit.Created("PORTAL-002","SCM_DeliveryNote",note.Number,new {note.Number,Status="Shipped",note.ShipDate});}catch(Exception ex){Logger.LogError(ex,"Creation audit failed for {Number}",note.Number);}}
    void Fail(Exception ex,string message){Logger.LogError(ex,"Delivery creation failed");_error=ex is InvalidOperationException or ArgumentException?ex.Message:message;}
}
