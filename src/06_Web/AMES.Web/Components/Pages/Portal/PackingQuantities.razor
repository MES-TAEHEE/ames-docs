@inject PortalQuantityFormat QtyFormat
@page "/portal/packing-quantities"
@rendermode InteractiveServer
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject ILogger<PackingQuantities> Logger
@inject AuditLogger Audit
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Portal.Text.PackingQuantities"] · AMES</PageTitle>
<AmesPageHeader Code="PORTAL-004" Title='@L["Portal.Text.PackingQuantities"]' />
<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["Portal.Text.LinkedItems"]</div><div class="ames-kpi-v">@_rows.Count</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["Portal.Text.PackingQuantitySet"]</div><div class="ames-kpi-v">@_rows.Count(r=>r.Source.CanSave && r.Source.PackingQty>0)</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["Portal.PackingQty.Kpi.NeedsSetup"]</div><div class="ames-kpi-v">@_rows.Count(r=>!r.Source.CanSave || r.Source.PackingQty is null or <=0)</div></div>
</div>
@if (_message.Length>0) { <RadzenAlert AlertStyle="@(_error?AlertStyle.Warning:AlertStyle.Success)" Variant="Variant.Flat">@_message</RadzenAlert> }
<div class="ames-card">
    <div class="ames-card-h packing-toolbar">
        <span style="white-space:nowrap;">▼ @L["Portal.Text.PackingQuantities"] · @Rows.Count @L["Lbl.Items"]</span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_search" Immediate="true" Placeholder='@L["Portal.PackingQty.Ph.Search"]' aria-label='@L["Portal.Text.SearchItems"]' InputSize="InputSize.Small" class="ames-rz-input" Style="width:220px;" />
            <RadzenButton Text='@L["Btn.Search"]' Icon="search" Click="Load" Disabled="@_rows.Any(r=>r.Dirty)" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" class="ames-rz-btn" />
        </RadzenStack>
    </div>
    <div class="packing-hint dim">@L["Portal.PackingQty.Hint"]</div>
    <RadzenDataGrid @ref="_grid" TItem="EditRow" Data="@Rows" AllowSorting="true" AllowPaging="true" PageSize="@_pageRows" PagerHorizontalAlign="HorizontalAlign.Center"
        PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" PagingSummaryFormat='@L["Pager.Summary"]' PageSizeText='@L["Pager.PageSize"]' PageSizeChanged="@(s => _pageRows = s)"
        EmptyText='@L["Portal.Text.NoLinkedItems"]' Class="ames-rz-grid ames-grid-fixed" Style="@($"--ames-page-rows:{_pageRows}")">
        <Columns>
            <RadzenDataGridColumn TItem="EditRow" Title='@L["Col.RowNo"]' Width="60px" MinWidth="60px" Sortable="false" TextAlign="TextAlign.Center"><Template Context="r">@GridRowNo.Of(_grid,r)</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EditRow" Property="Source.VendorName" Title='@L["Scm.Text.Supplier"]' Width="190px" MinWidth="190px" CssClass="packing-nowrap"><Template Context="r"><span class="code">@r.Source.VendorID</span> @r.Source.VendorName</Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EditRow" Property="Source.ItemNo" Title='@L["Portal.Text.ItemCode"]' Width="180px" MinWidth="180px" TextAlign="TextAlign.Center"><Template Context="r"><span class="code">@r.Source.ItemNo</span></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EditRow" MinWidth="200px" Property="Source.ItemName" Title='@L["Scm.Text.Description"]'>
                <Template Context="r">@r.Source.ItemName
                    @if(!r.Source.CanSave){<div class="packing-issue" role="status">@IssueText(r.Source.Issue)</div>}
                    else if(r.Source.PackingQty is null or <=0){<div class="dim">@L["Portal.PackingQty.NotSetHint"]</div>}
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EditRow" Property="Source.Unit" Title='@L["Scm.Text.Unit"]' Width="100px" MinWidth="100px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn TItem="EditRow" Title='@L["Scm.Text.PackingQuantity"]' Width="240px" MinWidth="240px" Sortable="false">
                <Template Context="r"><RadzenNumeric TValue="decimal?" @bind-Value="r.Quantity" Disabled="@(!r.Source.CanSave || r.Saving)" Format="@QtyFormat.Format(r.Source.Unit)" Min="0.001m" Max="999999999999999.999m" Step="0.001" ShowUpDown="false" Placeholder='@L["Portal.Text.NotSet"]' aria-label='@L["Portal.Accessibility.PackingQuantity", r.Source.ItemNo]' Style="width:100%;" class="ames-rz-input" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EditRow" Width="130px" MinWidth="130px" Title="" Sortable="false">
                <Template Context="r">
                    <RadzenButton Text='@L["Btn.Save"]' Icon="save" Click="@(()=>Save(r))" Disabled="@(!r.Dirty || !r.Source.CanSave || r.Saving)" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" class="ames-rz-btn" />
                    <RadzenButton Icon="undo" aria-label='@L["Portal.Text.DiscardChanges"]' Click="@(()=>r.Quantity=r.Source.PackingQty)" Disabled="@(!r.Dirty)" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" class="ames-rz-btn" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>
@code {
    sealed class EditRow(ScmRepository.PackingQuantityRow source)
    {
        public ScmRepository.PackingQuantityRow Source { get; set; }=source;
        public decimal? Quantity { get; set; }=source.PackingQty;
        public bool Dirty=>Quantity!=Source.PackingQty;
        public bool Saving { get; set; }
    }
    List<EditRow> _rows=[];
    RadzenDataGrid<EditRow>? _grid;
    IEnumerable<int> _pageSizeOptions=new int[]{25,50,100};
    int _pageRows=25;
    string _user="",_search="",_message="";
    bool _allowed,_error;
    // 저장소 SQL 이 영어 문장으로 넘기는 품목 문제(PackingQuantityRow.Issue) — 표시만 바꾼다
    string IssueText(string issue)=>issue switch {
        "Item master missing. Ask EOS to register this part in Material Item Master."=>L["Portal.PackingQty.Issue.ItemMissing"],
        "Item is inactive. Ask EOS to check the item master."=>L["Portal.PackingQty.Issue.ItemInactive"],
        "Not a material item. Ask EOS to check the item type."=>L["Portal.PackingQty.Issue.NotMaterial"],
        "Supplier link is inactive. Ask EOS to check the supplier mapping."=>L["Portal.PackingQty.Issue.LinkInactive"],
        _=>issue };
    List<EditRow> Rows=>_rows.Where(r=>string.Join(" ",r.Source.ItemNo,r.Source.ItemName,r.Source.VendorID,r.Source.VendorName).Contains(_search,StringComparison.OrdinalIgnoreCase)).ToList();
    protected override async Task OnInitializedAsync()
    {
        var u=(await Authentication.GetAuthenticationStateAsync()).User;
        _user=u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value??"";
        _allowed=PortalAuth.IsPortalUser(u);
        await Load();
    }
    async Task Load()
    {
        _rows=[];_message="";_error=false;
        if(!_allowed||_user.Length==0){_error=true;_message=L["Portal.Text.YouDoNotHavePermissionToViewThisPage"];return;}
        try{_rows=(await Task.Run(()=>Scm.ListPortalPackingQuantities(_user))).Select(r=>new EditRow(r)).ToList();}
        catch(Exception ex){Logger.LogError(ex,"Packing quantity load failed");_error=true;_message=L["Portal.Text.UnableToLoadDataPleaseRetry"];}
    }
    async Task Save(EditRow row)
    {
        if(!_allowed||!row.Dirty||!row.Source.CanSave||row.Saving)return;
        _error=true;
        if(row.Quantity is null or <=0 || decimal.Round(row.Quantity.Value,3)!=row.Quantity.Value)
        {_message=L["Portal.Text.EnterAPositivePackingQuantityWithUpToThree"];return;}
        row.Saving=true;
        var quantity=row.Quantity;
        try
        {
            var saved=await Task.Run(()=>Scm.SavePortalPackingQuantity(_user,row.Source.ItemNo,row.Source.VendorID,quantity,row.Source.PackingQty));
            if(!saved)
            {_message=L["Portal.Text.TheItemMappingOrPackingQuantityChangedDiscardChanges"];return;}
            Audit.Updated("PORTAL-004", "SCM_ItemVendor", $"{row.Source.VendorID}/{row.Source.ItemNo}",
                new { PackingQty=row.Source.PackingQty }, new { PackingQty=quantity });
            row.Source=row.Source with {PackingQty=quantity,Linked=true};
            _error=false;_message=L["Portal.Text.Saved"];
        }
        catch(Exception ex){Logger.LogError(ex,"Packing quantity save failed");_message=L["Portal.Text.UnableToSaveCheckYourEntriesAndRetry"];}
        finally{row.Saving=false;}
    }
}
