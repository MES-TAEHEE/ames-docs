@inject IStringLocalizer<SharedResources> L
@inject PortalQuantityFormat QtyFormat
@page "/portal/delivery-note/{Number}"
@layout EmptyLayout
@rendermode InteractiveServer
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject ILogger<DeliveryNote> Logger
@inject UomFormat UomFmt

<PageTitle>@L["Portal.Text.DeliveryNote"] · @Number</PageTitle>
<HeadContent>
    <style>@@media print { body { background: white !important; } #blazor-error-ui { display: none !important; } }</style>
</HeadContent>
<DeliveryPrintMessages />
<div class="note-toolbar">
    <a href="/portal/delivery-notes">@L["Portal.Note.Back"]</a>
    @if (_note is not null)
    {
        <div class="note-actions">
            <button type="button" class="rz-button rz-button-md rz-primary" data-delivery-note-print>@L["Portal.Text.PrintSavePDF"]</button>
            <button type="button" class="rz-button rz-button-md rz-secondary" data-delivery-note-download="@_note.Number">@L["Portal.Text.DownloadPrintableFile"]</button>
        </div>
    }
</div>
<p class="note-help" role="status" data-delivery-note-status>@L["Portal.Note.Help"]</p>
@if (_error is not null)
{
    <p role="alert" class="note-error">@_error</p>
}
@if (_note is { } n)
{
    <article class="delivery-note">
        <header><strong>@n.Buyer</strong><h1>@L["Portal.Text.DeliveryNote"]</h1><p>@L["Portal.Text.Delivery"] · @n.Number</p></header>
        <div class="note-barcode"><Code128Barcode Value="@n.Number" /><div>@n.Number</div></div>
        <dl>
            <dt>@L["Scm.Text.Supplier"]</dt><dd>@n.VendorName (@n.Vendor)</dd>
            <dt>@L["Portal.Note.Buyer"]</dt><dd>@n.Buyer</dd>
            <dt>@L["Portal.Note.Destination"]</dt><dd>@n.Destination</dd>
            <dt>@L["Portal.Text.PurchaseOrder"]</dt><dd>@n.OrderNumber</dd>
            <dt>@L["Scm.Text.ShipDate"]</dt><dd>@string.Join(", ", n.Lines.Select(l => (l.ShipDate ?? n.ShipDate).ToString("yyyy-MM-dd")).Distinct())</dd>
            <dt>@L["Portal.Note.IssuedAt"]</dt><dd>@n.IssuedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        </dl>
        <table>
            <thead><tr><th>@L["Portal.Note.OrderLine"]</th><th>@L["Portal.Text.ItemCode"]</th><th>@L["Portal.Text.Description"]</th><th>@L["Scm.Text.Unit"]</th><th>@L["Portal.Note.ShippedQuantity"]</th></tr></thead>
            <tbody>@foreach (var group in n.Lines.GroupBy(l => l.DeliveryNumber))
            {
                @if (!string.IsNullOrEmpty(group.Key))
                {
                    <tr class="delivery-group"><td colspan="5"><strong>@group.Key</strong> · @group.First().OrderNumber · @group.First().ShipDate?.ToString("yyyy-MM-dd")<br />@string.Join(" / ", group.Select(l => l.Destination).Distinct())</td></tr>
                }
                @foreach (var line in group)
                {
                    <tr><td>@line.Line</td><td>@line.Item</td><td>@line.Name</td><td>@line.Unit</td><td class="quantity">@QtyFormat.Text(line.Quantity,line.Unit)</td></tr>
                }
            }</tbody>
        </table>
        <p class="totals">@L["Portal.Note.Total"]: @string.Join(" · ", n.Lines.GroupBy(l => l.Unit).Select(g => $"{QtyFormat.Text(g.Sum(l => l.Quantity),g.Key)} {g.Key}"))</p>
        <p>@L["Portal.Note.IssuedBy"]: @n.IssuedBy</p>
        <div class="signatures"><p>@L["Portal.Note.ShippedBy"]<br /><br />____________________</p><p>@L["Portal.Note.ReceivedBy"]<br /><br />____________________</p><p>@L["Portal.Note.ReceivedDate"]<br /><br />____________________</p></div>
        <footer>@n.Number · @L["Portal.Note.Disclaimer"]</footer>
    </article>
}

@code {
    [Parameter] public string Number { get; set; } = "";
    ScmRepository.DeliveryNote? _note;
    string? _error;
    protected override async Task OnParametersSetAsync()
    {
        _note = null; _error = null;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var id = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(id) || !PortalAuth.IsPortalUser(user))
        { _error = L["Portal.Note.AccessDenied"]; return; }
        try
        {
            _note = Scm.GetDeliveryNote(Number, id);
            if (_note is null) _error = L["Portal.Note.NotIssued"];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Delivery note read failed: {Number}", Number);
            _error = L["Portal.Note.Unavailable"];
        }
    }
}
