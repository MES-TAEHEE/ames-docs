@inject IStringLocalizer<SharedResources> L
@inject PortalQuantityFormat QtyFormat
@page "/portal/delivery-note/{Number}"
@layout EmptyLayout
@rendermode InteractiveServer
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject ILogger<DeliveryNote> Logger

<PageTitle>Delivery Note · @Number</PageTitle>
<HeadContent>
    <style>@@media print { body { background: white !important; } #blazor-error-ui { display: none !important; } }</style>
</HeadContent>
<DeliveryPrintMessages />
<div class="note-toolbar">
    <a href="/portal/deliveries">Back to Delivery Management</a>
    @if (_note is not null)
    {
        <div class="note-actions">
            <button type="button" class="rz-button rz-button-md rz-primary" data-delivery-note-print>Print / Save PDF</button>
            <button type="button" class="rz-button rz-button-md rz-secondary" data-delivery-note-download="@_note.Number">Download Printable File</button>
        </div>
    }
</div>
<p class="note-help" role="status" data-delivery-note-status>Check the details, then print or save as PDF.</p>
@if (_error is not null)
{
    <p role="alert" class="note-error">@_error</p>
}
@if (_note is { } n)
{
    <article class="delivery-note">
        <header class="document-head"><div><h1>Delivery Note</h1><span>@n.Number</span></div><div class="note-barcode"><Code128Barcode Value="@n.Number" /><strong>@n.Number</strong></div></header>
        <section class="note-parties">
            <div><span class="field-label">Sender</span><strong>@n.VendorName</strong><span>@n.Vendor</span></div>
            <div><span class="field-label">Recipient</span><strong>@n.Buyer</strong><span>@n.Destination</span></div>
        </section>
        <dl class="note-details">
            <div><dt>Purchase Order</dt><dd>@n.OrderNumber</dd></div>
            <div><dt>Delivery Date</dt><dd>@string.Join(", ", n.Lines.Select(l => (l.ShipDate ?? n.ShipDate).ToString("yyyy-MM-dd")).Distinct())</dd></div>
            <div><dt>Issued At</dt><dd>@n.IssuedAt.ToString("yyyy-MM-dd HH:mm")</dd></div>
        </dl>
        <h2>Items</h2>
        <table class="note-items">
            <thead><tr><th>No</th><th>Part No</th><th>Description</th><th>PO No</th><th>Quantity</th></tr></thead>
            <tbody>@foreach (var line in n.Lines)
            {
                <tr><td>@line.Line</td><td>@line.Item</td><td>@line.Name</td><td>@line.OrderNumber</td><td class="quantity">@QtyFormat.Text(line.Quantity,line.Unit) @line.Unit</td></tr>
            }</tbody>
        </table>
        <p class="totals">Total: @string.Join(" · ", n.Lines.GroupBy(l => l.Unit).Select(g => $"{QtyFormat.Text(g.Sum(l => l.Quantity),g.Key)} {g.Key}"))</p>
        @if (_cases.Count > 0)
        {
            <section class="case-manifest">
                <h2>Handling Units / Cases</h2>
                <table>
                    <thead><tr><th>Case No</th><th>Boxes</th><th>Quantity</th></tr></thead>
                    <tbody>
                        @foreach (var item in _cases)
                        {
                            <tr>
                                <td class="case-number">@item.Number</td>
                                <td class="quantity">@item.Boxes.Count</td>
                                <td>@string.Join(" · ", item.Boxes.GroupBy(b => b.Unit).Select(g => $"{QtyFormat.Text(g.Sum(b => b.Quantity), g.Key)} {g.Key}"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    </article>
}

@code {
    [Parameter] public string Number { get; set; } = "";
    ScmRepository.DeliveryNote? _note;
    List<ScmRepository.DeliveryCase> _cases = [];
    string? _error;
    protected override async Task OnParametersSetAsync()
    {
        _note = null; _cases = []; _error = null;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var id = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(id) || !PortalAuth.IsPortalUser(user))
        { _error = L["Portal.Note.AccessDenied"]; return; }
        try
        {
            _note = Scm.GetDeliveryNote(Number, id);
            if (_note is null) _error = L["Portal.Note.NotIssued"];
            else _cases = Scm.ListDeliveryCases(null, id, note: Number).OrderBy(c => c.Number).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Delivery note read failed: {Number}", Number);
            _note = null;
            _cases = [];
            _error = L["Portal.Note.Unavailable"];
        }
    }
}
