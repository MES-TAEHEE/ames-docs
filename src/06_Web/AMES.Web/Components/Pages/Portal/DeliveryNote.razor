@inject IStringLocalizer<SharedResources> L
@page "/portal/delivery-note/{Number}"
@layout EmptyLayout
@rendermode AmesRender.Server
@inject ScmRepository Scm
@inject AuthenticationStateProvider Authentication
@inject ILogger<DeliveryNote> Logger
@inject IJSRuntime JS

<PageTitle>@L["SCM.Preview.Print.Note"] · @Number</PageTitle>
<HeadContent>
    <style>@@media print { body { background: white !important; } #blazor-error-ui { display: none !important; } }</style>
</HeadContent>
<div class="note-toolbar portal-print-toolbar">
    <a href="/portal/deliveries">@L["Portal.Text.BackToDeliveryManagement"]</a>
    @if (_note is not null)
    {
        <div class="note-actions">
            <ShippingLabelPrint LoadLabels="ReloadNoteLabels" BrowserPrint="PrintNote" />
        </div>
    }
</div>
@if (_error is not null)
{
    <p role="alert" class="note-error">@_error</p>
}
@if (_note is { } n)
{
    <DeliveryNoteDocument Note="n" ShippingUnits="_cases" />
}

@code {
    Task PrintNote()=>JS.InvokeVoidAsync("amesPrintLabels",".delivery-note-document","A4 portrait",true).AsTask();
    async Task<IReadOnlyList<ShippingLabel>> ReloadNoteLabels()
    {
        var user=(await Authentication.GetAuthenticationStateAsync()).User;
        var id=user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if(!PortalAuth.IsPortalUser(user)||string.IsNullOrWhiteSpace(id))throw new InvalidOperationException(L["Portal.Note.AccessDenied"]);
        var note=await Task.Run(()=>Scm.GetDeliveryNote(Number,id));
        if(note is null)throw new InvalidOperationException(L["Portal.Note.Unavailable"]);
        return new[] { EnglishPrint.DeliveryNote(note) };
    }
    [Parameter] public string Number { get; set; } = "";
    ScmRepository.DeliveryNote? _note;
    List<ScmRepository.DeliveryCase> _cases = [];
    string? _error;
    protected override async Task OnParametersSetAsync()
    {
        _note = null; _cases = []; _error = null;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var id = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(id) || !PortalAuth.IsPortalUser(user))
        { _error = L["Portal.Note.AccessDenied"]; return; }
        try
        {
            _note = Scm.GetDeliveryNote(Number, id);
            if (_note is null) _error = L["Portal.Note.NotIssued"];
            else _cases = Scm.ListDeliveryCases(null, id, note: Number).OrderBy(c => c.CreatedAt).ThenBy(c => c.Number).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Delivery note read failed: {Number}", Number);
            _note = null;
            _cases = [];
            _error = L["Portal.Note.Unavailable"];
        }
    }
}
