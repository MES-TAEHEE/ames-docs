@page "/rpt/schedule-adherence"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-008 @L["RPT.ScheduleAdherence.Title"] · AMES</PageTitle>

<AmesPageHeader Code="RPT-008" TitleKey="RPT.ScheduleAdherence.Title" />

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.ScheduleAdherence.Kpi.Count"]</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">day × line</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.ScheduleAdherence.Kpi.Plan"]</div>
        <div class="ames-kpi-v">@_plan.ToString("N0")</div><div class="ames-kpi-s">planned qty</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["RPT.ScheduleAdherence.Kpi.Prod"]</div>
        <div class="ames-kpi-v">@_prod.ToString("N0")</div><div class="ames-kpi-s">actual qty</div></div>
    <div class="ames-kpi @(_adh >= 95m ? "ok" : _adh >= 85m ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.ScheduleAdherence.Kpi.Adh"]</div>
        <div class="ames-kpi-v">@_adh.ToString("0.0")%</div>
        <div class="ames-kpi-s">overall</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.ScheduleAdherence.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <select class="ames-input" style="width:140px;" @bind="_fLine">
                <option value="">@L["Filter.All"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">@l.LineID@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Period"]</label>
            <select class="ames-input" style="width:100px;" @bind="_daysBack">
                <option value="7">7@(L["Lbl.Days"])</option>
                <option value="14">14@(L["Lbl.Days"])</option>
                <option value="30">30@(L["Lbl.Days"])</option>
                <option value="60">60@(L["Lbl.Days"])</option>
                <option value="90">90@(L["Lbl.Days"])</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["RPT.ScheduleAdherence.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.Date"]</th><th>@L["Col.Line"]</th>
                    <th class="num">@L["RPT.ScheduleAdherence.Col.Plan"]</th><th class="num">@L["RPT.ScheduleAdherence.Col.Prod"]</th>
                    <th class="num">@L["RPT.ScheduleAdherence.Col.Adh"]</th><th>@L["RPT.ScheduleAdherence.Col.Bar"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr>
                        <td class="dim">@r.Day.ToString("MM-dd (ddd)")</td>
                        <td>@(r.LineId ?? "—")</td>
                        <td class="num">@r.PlannedQty.ToString("N0")</td>
                        <td class="num">@r.ProducedQty.ToString("N0")</td>
                        <td class="num">
                            <span class="pill @(r.AdherencePct >= 95m ? "ok" : r.AdherencePct >= 85m ? "warn" : "bad")">
                                @r.AdherencePct.ToString("0.0")%
                            </span>
                        </td>
                        <td>
                            <div style="background:@(r.AdherencePct >= 95m ? "rgba(134,239,172,.25)" : r.AdherencePct >= 85m ? "rgba(251,191,36,.25)" : "rgba(252,165,165,.25)");
                                        border:1px solid rgba(255,255,255,.15);
                                        height:14px;border-radius:4px;
                                        width:@(Math.Min(r.AdherencePct, 120m).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.ScheduleAdherenceRow> _allRows = new();
    List<AMES.Data.Repositories.RptRepository.ScheduleAdherenceRow> _rows    = new();
    int _page = 0;
    const int _pageSize = 20;

    List<AMES.Data.Repositories.MasterDataRepository.LineRow> _lineList = new();
    int     _daysBack = 14;
    string  _fLine    = "";
    decimal _plan, _prod, _adh;

    protected override void OnInitialized()
    {
        try { _lineList = Md.ListLines(); } catch { }
        Reload();
    }

    void Reload()
    {
        try { _allRows = Rpt.ListScheduleAdherence(_daysBack); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _page = 0;
        _rows = string.IsNullOrEmpty(_fLine)
            ? _allRows
            : _allRows.Where(r => r.LineId == _fLine).ToList();
        _plan = _rows.Sum(r => r.PlannedQty);
        _prod = _rows.Sum(r => r.ProducedQty);
        _adh  = _plan > 0 ? _prod / _plan * 100m : 0m;
    }
}
