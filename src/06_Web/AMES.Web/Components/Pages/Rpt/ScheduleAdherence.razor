@page "/rpt/schedule-adherence"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt

<PageTitle>RPT-08 계획 준수율 · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-08</div>
    <div class="ames-page-t">계획 준수율</div>
    <div class="ames-page-sub">생산 계획 대비 실생산 — 일별·라인별</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">집계 건수</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">day × line</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">계획 수량</div>
        <div class="ames-kpi-v">@_plan.ToString("N0")</div><div class="ames-kpi-s">planned qty</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">실생산</div>
        <div class="ames-kpi-v">@_prod.ToString("N0")</div><div class="ames-kpi-s">actual qty</div></div>
    <div class="ames-kpi @(_adh >= 95m ? "ok" : _adh >= 85m ? "warn" : "bad")">
        <div class="ames-kpi-l">계획 준수율</div>
        <div class="ames-kpi-v">@_adh.ToString("0.0")%</div>
        <div class="ames-kpi-s">overall</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ 일별 집계 · @_rows.Count 건@(_rows.Count < _allRows.Count ? $" / 전체 {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:120px;padding:4px 8px;"
                   placeholder="라인 검색" @bind="_fLine" autocomplete="off" />
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">조회 기간</label>
            <select class="ames-input" style="width:80px;padding:4px 8px;" @bind="_daysBack">
                <option value="7">7일</option>
                <option value="14">14일</option>
                <option value="30">30일</option>
                <option value="60">60일</option>
                <option value="90">90일</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">조회</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">해당 기간에 계획 또는 생산 데이터가 없습니다.</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>날짜</th><th>라인</th>
                    <th class="num">계획 수량</th><th class="num">실생산</th>
                    <th class="num">준수율</th><th>비율 바</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td class="dim">@r.Day.ToString("MM-dd (ddd)")</td>
                        <td>@(r.LineId ?? "—")</td>
                        <td class="num">@r.PlannedQty.ToString("N0")</td>
                        <td class="num">@r.ProducedQty.ToString("N0")</td>
                        <td class="num">
                            <span class="pill @(r.AdherencePct >= 95m ? "ok" : r.AdherencePct >= 85m ? "warn" : "bad")">
                                @r.AdherencePct.ToString("0.0")%
                            </span>
                        </td>
                        <td>
                            <div style="background:@(r.AdherencePct >= 95m ? "rgba(134,239,172,.25)" : r.AdherencePct >= 85m ? "rgba(251,191,36,.25)" : "rgba(252,165,165,.25)");
                                        border:1px solid rgba(255,255,255,.15);
                                        height:14px;border-radius:4px;
                                        width:@(Math.Min(r.AdherencePct, 120m).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.ScheduleAdherenceRow> _allRows = new();
    List<AMES.Data.Repositories.RptRepository.ScheduleAdherenceRow> _rows    = new();

    int     _daysBack = 14;
    string  _fLine    = "";
    decimal _plan, _prod, _adh;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Rpt.ListScheduleAdherence(_daysBack); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = string.IsNullOrWhiteSpace(_fLine)
            ? _allRows
            : _allRows.Where(r => (r.LineId ?? "").Contains(_fLine, StringComparison.OrdinalIgnoreCase)).ToList();
        _plan = _rows.Sum(r => r.PlannedQty);
        _prod = _rows.Sum(r => r.ProducedQty);
        _adh  = _plan > 0 ? _prod / _plan * 100m : 0m;
    }
}
