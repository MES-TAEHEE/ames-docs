@page "/rpt/inventory"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using Radzen

@attribute [Authorize]

@inject RptRepository Rpt
@inject MasterDataRepository MD
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-005 @L["RPT.Inventory.Title"] · AMES</PageTitle>
<AmesPageHeader Code="RPT-005" TitleKey="RPT.Inventory.Title" />

@* ── KPI strip: SKU · 재고 금액 · 안전재고 미달 · 과잉 · 회전율 ───────── *@
<div class="ames-kpis">
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["RPT.Inventory.Kpi.Sku"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_rows.Count</div>
            <div class="ames-kpi-s">@L["RPT.Inventory.Kpi.SkuSub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["RPT.Inventory.Kpi.Value"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@(HasCost ? TotalValue.ToString("N0") : "—")</div>
            <div class="ames-kpi-s">@(HasCost ? L["RPT.Inventory.Kpi.ValueSub"].Value : L["RPT.Inventory.Kpi.ValueNone"].Value)</div>
        </div>
    </div>
    <div class="ames-kpi @(LowCount > 0 ? "bad" : "ok")">
        <div class="ames-kpi-l">@L["RPT.Inventory.Kpi.Low"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@LowCount</div>
            <div class="ames-kpi-s">@L["RPT.Inventory.Kpi.LowSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(OverCount > 0 ? "warn" : "")">
        <div class="ames-kpi-l">@L["RPT.Inventory.Kpi.Over"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@OverCount</div>
            <div class="ames-kpi-s">@L["RPT.Inventory.Kpi.OverSub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["RPT.Inventory.Kpi.Turnover"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@(AvgTurnover is { } t ? t.ToString("0.0") : "—")</div>
            <div class="ames-kpi-s">@(AvgTurnover is { } ? L["RPT.Inventory.Kpi.TurnoverSub"].Value : L["RPT.Inventory.Kpi.TurnoverNone"].Value)</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

@* ── 조회 조건: 검색 · 창고 · 카테고리 · 조회 · 인쇄 · 내보내기 ──────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:0;">
        <span style="white-space:nowrap;">▼ @L["RPT.Inventory.Filter.Title"] <span class="dim" style="font-weight:400;font-size:.85em;margin-left:6px;">@L["RPT.Inventory.AsOf"] · @(_loadedAt.ToString("HH:mm:ss")) · @(_fWh is null ? L["Filter.All"].Value : WhLabel(_fWh))</span></span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="_fSearch" Change="@OnSearchChanged" @onkeydown="OnSearchKeyDown" Immediate="true" Placeholder="@L["RPT.Inventory.Ph.Search"]" InputSize="InputSize.Small" class="ames-rz-input" Style="width:200px;" />
            <RadzenLabel Text="@L["RPT.Inventory.Col.Warehouse"]" Component="DropDownWh" />
            <RadzenDropDown Name="DropDownWh" @bind-Value="_fWh" Data="@WhFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:170px;" />
            <RadzenLabel Text="@L["Col.Category"]" Component="DropDownCat" />
            <RadzenDropDown Name="DropDownCat" @bind-Value="_fCat" Data="@CatFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:170px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="@L["RPT.Inventory.Btn.Print"]" Icon="print" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@Print" class="ames-rz-btn" />
            <RadzenButton Text="@L["RPT.Inventory.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@ExportXlsx" class="ames-rz-btn" />
        </RadzenStack>
    </div>
</div>

@* ── 카테고리별 분포 + 창고별 재고 ────────────────────────────────── *@
<div class="rpt-sh-grid2">
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;">
            <span>▼ @L["RPT.Inventory.ByCat.Title"]</span>
            <span class="mnt-db-hint">@(HasCost ? L["RPT.Inventory.ByCat.Value"].Value : L["RPT.Inventory.ByCat.Qty"].Value)</span>
        </div>
        @if (_byCat.Count == 0)
        {
            <div class="mnt-db-empty">@L["RPT.Inventory.Empty"]</div>
        }
        else
        {
            @for (int i = 0; i < _byCat.Count; i++)
            {
                var c = _byCat[i];
                <div class="mnt-dt-row" style="grid-template-columns:130px 1fr 100px;">
                    <span class="lbl" title="@c.Code">@c.Label</span>
                    <div class="mnt-dt-track"><div class="mnt-dt-fill" style="width:@(_byCat[0].Metric > 0 ? Math.Max(2, (int)Math.Round(100.0 * (double)c.Metric / (double)_byCat[0].Metric)) : 0)%;background:@CatColor(i);"></div></div>
                    <span class="mnt-dt-val"><b>@c.Metric.ToString("N0")</b></span>
                </div>
            }
        }
    </div>

    <div class="ames-card">
        <div class="ames-card-h">▼ @L["RPT.Inventory.ByWh.Title"]</div>
        @if (_byWh.Count == 0)
        {
            <div class="mnt-db-empty">@L["RPT.Inventory.Empty"]</div>
        }
        else
        {
            @foreach (var w in _byWh)
            {
                <div class="rpt-inv-wh">
                    <div class="ic">@(w.Code == "FG" ? "📦" : "🧱")</div>
                    <div class="t">
                        <b>@WhLabel(w.Code)</b>
                        <span>@string.Format(L["RPT.Inventory.ByWh.Fmt"].Value, w.Sku, w.Low)</span>
                    </div>
                    <div class="v">@(HasCost ? w.Value.ToString("N0") : w.Qty.ToString("N0"))</div>
                </div>
            }
        }
    </div>
</div>

@* ── 품목별 재고 상세 ─────────────────────────────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.Inventory.Detail.Title"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _all.Count ? $" / {L["Lbl.TotalOf"]} {_all.Count}" : "")</span>
    </div>

    <RadzenDataGrid TItem="Sku" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" EmptyText="@L["RPT.Inventory.Empty"]" Class="ames-rz-grid rpt-dp-grid">
        <Columns>
            <RadzenDataGridColumn TItem="Sku" Property="ItemNo" Title="@L["RPT.Inventory.Col.ItemCode"]" Width="150px">
                <Template Context="r"><span class="code">@r.ItemNo</span></Template>
                <FooterTemplate><b>@string.Format(L["RPT.Inventory.TotalFmt"].Value, _rows.Count)</b></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Sku" Property="ItemName" Title="@L["RPT.Inventory.Col.ItemName"]">
                <Template Context="r"><span style="white-space:nowrap;">@(r.ItemName ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Sku" Property="CatLabel" Title="@L["Col.Category"]" Width="120px">
                <Template Context="r"><span class="dim">@r.CatLabel</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Sku" Property="Source" Title="@L["RPT.Inventory.Col.Warehouse"]" Width="140px">
                <Template Context="r"><span>@WhLabel(r.Source)</span><span class="dim code" style="font-size:.8em;margin-left:6px;">@r.Locations</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Sku" Property="Qty" Title="@L["RPT.Inventory.Col.OnHand"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r"><b class="code">@r.Qty.ToString("N0")</b></Template>
                <FooterTemplate><span class="code">@_rows.Sum(x => x.Qty).ToString("N0")</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Sku" Property="Safety" Title="@L["RPT.Inventory.Col.Safety"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r"><span class="code dim">@(r.Safety?.ToString("N0") ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Sku" Property="Value" Title="@L["RPT.Inventory.Col.Value"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r"><span class="code">@(r.Value is { } v ? v.ToString("N0") : "—")</span></Template>
                <FooterTemplate><span class="code">@(HasCost ? TotalValue.ToString("N0") : "—")</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Sku" Property="Turnover" Title="@L["RPT.Inventory.Col.Turnover"]" TextAlign="TextAlign.Right" Width="80px">
                <Template Context="r"><span class="code">@(r.Turnover is { } t ? t.ToString("0.0") : "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Sku" Property="State" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="r"><span class="pill @StateCls(r.State)">@StateLabel(r.State)</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;

    List<RptRepository.InventorySkuRow>     _raw       = new();
    Dictionary<string, decimal>             _issued    = new();
    List<Sku>                               _all       = new();
    List<Sku>                               _rows      = new();
    List<CatAgg>                            _byCat     = new();
    List<WhAgg>                             _byWh      = new();
    List<MasterDataRepository.CodeItemRow>  _itemTypes = new();

    string  _fSearch = "";
    string? _fWh, _fCat;
    string  _msg = "";
    bool    _isErr;
    DateTime _loadedAt = DateTime.Now;

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    public sealed class Sku
    {
        public string Source = ""; public string ItemNo = ""; public string? ItemName; public string? Cat; public string CatLabel = "";
        public string Locations = ""; public decimal Qty; public decimal? Safety; public decimal? Max; public decimal? UnitCost;
        public decimal? Value => UnitCost is { } c ? Qty * c : null;
        public decimal? Turnover;
        public string State = "normal";
    }
    public sealed record CatAgg(string Code, string Label, decimal Metric);
    public sealed record WhAgg(string Code, int Sku, int Low, decimal Qty, decimal Value);

    IEnumerable<DropDownItem> WhFilterOptions  => new[] { "WH", "FG" }.Select(w => new DropDownItem { Value = w, Text = WhLabel(w) });
    IEnumerable<DropDownItem> CatFilterOptions => _all.Select(s => s.Cat ?? "").Distinct().OrderBy(c => c).Select(c => new DropDownItem { Value = c.Length == 0 ? "-" : c, Text = CatLabel(c.Length == 0 ? null : c) });

    // ── KPI ────────────────────────────────────────────────────────────
    bool     HasCost     => _rows.Any(r => r.UnitCost is { });
    decimal  TotalValue  => _rows.Sum(r => r.Value ?? 0m);
    int      LowCount    => _rows.Count(r => r.State is "low" or "out");
    int      OverCount   => _rows.Count(r => r.State == "over");
    decimal? AvgTurnover => _rows.Where(r => r.Turnover is { }).Select(r => r.Turnover!.Value).DefaultIfEmpty().Average() is var a && _rows.Any(r => r.Turnover is { }) ? a : null;

    protected override void OnInitialized()
    {
        try { _itemTypes = MD.ListCodeItems("ITEM_TYPE"); } catch { }
        Reload();
    }

    void Reload()
    {
        try { _raw = Rpt.ListInventorySku(); }
        catch (Exception ex) { _raw = new(); ShowMsg(ex.Message, true); }
        try { _issued = Rpt.IssuedQtyByItem(30); } catch { _issued = new(); }
        _loadedAt = DateTime.Now;

        // SKU = 품목 × 창고(자재/완성품). 위치는 묶어서 표시
        _all = _raw.GroupBy(r => (r.Source, r.ItemNo))
            .Select(g =>
            {
                var f = g.First();
                var qty = g.Sum(r => r.Qty);
                var s = new Sku
                {
                    Source = g.Key.Source, ItemNo = g.Key.ItemNo,
                    ItemName = MasterDataRepository.LocalName(f.ItemName, f.ItemNameEn) is { Length: > 0 } nm ? nm : null,
                    Cat = f.ItemType, CatLabel = CatLabel(f.ItemType),
                    Locations = string.Join(", ", g.Select(r => r.Location).Where(l => !string.IsNullOrEmpty(l)).Distinct()),
                    Qty = qty, Safety = f.SafetyStock, Max = f.MaxStock,
                    UnitCost = g.Select(r => r.UnitCost).FirstOrDefault(c => c is { }),
                    Turnover = g.Key.Source == "WH" && _issued.TryGetValue(g.Key.ItemNo, out var iss) && qty > 0 ? iss / qty : null,
                };
                s.State = qty <= 0 ? "out"
                        : s.Safety is { } sf && qty < sf ? "low"
                        : s.Max is { } mx && mx > 0 && qty > mx ? "over" : "normal";
                return s;
            })
            .OrderBy(s => s.Source == "WH" ? 0 : 1).ThenBy(s => s.ItemNo).ToList();

        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = _all.Where(s =>
            (string.IsNullOrEmpty(_fSearch) ||
                s.ItemNo.Contains(_fSearch, StringComparison.OrdinalIgnoreCase) ||
                (s.ItemName ?? "").Contains(_fSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_fWh)  || s.Source == _fWh) &&
            (string.IsNullOrEmpty(_fCat) || (_fCat == "-" ? string.IsNullOrEmpty(s.Cat) : s.Cat == _fCat))
        ).ToList();

        // 분포 지표: 원가가 있으면 금액, 없으면 수량
        var byValue = _rows.Any(r => r.UnitCost is { });
        _byCat = _rows.GroupBy(r => r.Cat ?? "")
            .Select(g => new CatAgg(g.Key, CatLabel(g.Key.Length == 0 ? null : g.Key), byValue ? g.Sum(r => r.Value ?? 0m) : g.Sum(r => r.Qty)))
            .OrderByDescending(c => c.Metric).ToList();
        _byWh = _rows.GroupBy(r => r.Source)
            .Select(g => new WhAgg(g.Key, g.Count(), g.Count(r => r.State is "low" or "out"), g.Sum(r => r.Qty), g.Sum(r => r.Value ?? 0m)))
            .OrderBy(w => w.Code == "WH" ? 0 : 1).ToList();
    }

    void OnSearchChanged(string v) => _fSearch = v ?? "";
    void OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") ApplyFilter(); }

    // ── 표시 헬퍼 ─────────────────────────────────────────────────────
    string WhLabel(string code) => code == "FG" ? L["RPT.Inventory.Wh.FG"].Value : L["RPT.Inventory.Wh.WH"].Value;
    string CatLabel(string? code) =>
        string.IsNullOrEmpty(code) ? L["RPT.Inventory.Cat.None"].Value
        : _itemTypes.FirstOrDefault(c => c.CodeValue == code) is { } c ? MasterDataRepository.LocalName(c) : code;
    static string CatColor(int i) => i switch { 0 => "#0891b2", 1 => "#f59e0b", 2 => "#059669", 3 => "#8b5cf6", _ => "#94a3b8" };

    string StateLabel(string s) => s switch
    {
        "low"  => L["RPT.Inventory.Status.Low"].Value,
        "over" => L["RPT.Inventory.Status.Over"].Value,
        "out"  => L["RPT.Inventory.Status.Out"].Value,
        _      => L["RPT.Inventory.Status.Normal"].Value,
    };
    static string StateCls(string s) => s switch { "low" => "warn", "over" => "info", "out" => "bad", _ => "ok" };

    async Task Print()
    {
        try { await JS.InvokeVoidAsync("print"); } catch { }
    }

    // 상세 표(필터 적용분)를 .xlsx 로 내려받는다 — 화면 컬럼 순서 그대로 + 합계 행
    async Task ExportXlsx()
    {
        if (_rows.Count == 0) { ShowMsg(L["RPT.Inventory.Err.NoExport"], true); return; }
        var headers = new[]
        {
            L["RPT.Inventory.Col.ItemCode"].Value, L["RPT.Inventory.Col.ItemName"].Value, L["Col.Category"].Value, L["RPT.Inventory.Col.Warehouse"].Value,
            L["RPT.Inventory.Col.Location"].Value, L["RPT.Inventory.Col.OnHand"].Value, L["RPT.Inventory.Col.Safety"].Value,
            L["RPT.Inventory.Col.Value"].Value, L["RPT.Inventory.Col.Turnover"].Value, L["Col.Status"].Value,
        };
        var data = _rows.Select(r => (IReadOnlyList<object?>)new object?[]
        {
            r.ItemNo, r.ItemName, r.CatLabel, WhLabel(r.Source), r.Locations, r.Qty, r.Safety, r.Value, r.Turnover is { } t ? Math.Round(t, 1) : null, StateLabel(r.State),
        }).Append(new object?[]
        {
            string.Format(L["RPT.Inventory.TotalFmt"].Value, _rows.Count), null, null, null, null, _rows.Sum(x => x.Qty), null, HasCost ? TotalValue : null, null, null,
        });
        var bytes = AMES.Web.Services.XlsxWriter.Build(L["RPT.Inventory.Title"].Value, headers, data);
        var name  = $"Inventory_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["RPT.Inventory.Ok.Exported"].Value, _rows.Count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
