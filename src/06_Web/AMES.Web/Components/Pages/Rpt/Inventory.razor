@page "/rpt/inventory"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-005 @L["RPT.Inventory.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-005</div>
    <div class="ames-page-t">@L["RPT.Inventory.Title"]</div>
    <div class="ames-page-sub">@L["RPT.Inventory.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.Inventory.Kpi.Count"]</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">item × location</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["RPT.Inventory.Kpi.Qty"]</div>
        <div class="ames-kpi-v">@_qty.ToString("N0")</div><div class="ames-kpi-s">on hand</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">@L["RPT.Inventory.Kpi.HoldQty"]</div>
        <div class="ames-kpi-v">@_hold.ToString("N0")</div><div class="ames-kpi-s">QC hold</div></div>
    <div class="ames-kpi @(_holdPct < 5 ? "ok" : _holdPct < 15 ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.Inventory.Kpi.HoldPct"]</div>
        <div class="ames-kpi-v">@_holdPct.ToString("0.0")%</div>
        <div class="ames-kpi-s">of on hand</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.Inventory.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:140px;padding:4px 8px;"
                   placeholder="@L["RPT.Inventory.Ph.Item"]" @bind="_fItem" autocomplete="off" />
            <span class="dim" style="font-size:.82em;white-space:nowrap;">Top</span>
            <select class="ames-input" style="width:70px;" @bind="_topN">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["RPT.Inventory.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["RPT.Inventory.Col.ItemNo"]</th><th>@L["RPT.Inventory.Col.Location"]</th>
                    <th class="num">@L["RPT.Inventory.Col.Lots"]</th><th class="num">@L["RPT.Inventory.Col.Qty"]</th>
                    <th class="num">@L["RPT.Inventory.Col.HoldLots"]</th><th class="num">@L["RPT.Inventory.Col.HoldQty"]</th>
                    <th class="num">@L["RPT.Inventory.Kpi.HoldPct"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    var hp = r.Qty > 0 ? r.HoldQty / r.Qty * 100m : 0m;
                    <tr>
                        <td class="code">@(r.ItemNo ?? "—")</td>
                        <td class="dim">@(r.Location ?? "—")</td>
                        <td class="num">@r.LotCount</td>
                        <td class="num">@r.Qty.ToString("N0")</td>
                        <td class="num">@r.HoldLots</td>
                        <td class="num">@r.HoldQty.ToString("N0")</td>
                        <td class="num">
                            @if (hp > 0m)
                            {
                                <span class="pill @(hp < 5m ? "ok" : hp < 15m ? "warn" : "bad")">@hp.ToString("0.0")%</span>
                            }
                            else
                            {
                                <span class="dim">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.InventoryRow> _allRows = new();
    List<AMES.Data.Repositories.RptRepository.InventoryRow> _rows    = new();
    int _page = 0;
    const int _pageSize = 20;

    int     _topN  = 100;
    string  _fItem = "";
    decimal _qty, _hold, _holdPct;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Rpt.ListInventory(_topN); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _page = 0;
        _rows = string.IsNullOrWhiteSpace(_fItem)
            ? _allRows
            : _allRows.Where(r => (r.ItemNo ?? "").Contains(_fItem, StringComparison.OrdinalIgnoreCase)).ToList();
        _qty  = _rows.Sum(r => r.Qty);
        _hold = _rows.Sum(r => r.HoldQty);
        _holdPct = _qty > 0 ? _hold / _qty * 100m : 0m;
    }
}
