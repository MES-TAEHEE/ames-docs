@page "/rpt/daily-production"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using Radzen

@attribute [Authorize]

@inject RptRepository Rpt
@inject MasterDataRepository MD
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-001 @L["RPT.DailyProduction.Title"] · AMES</PageTitle>
<AmesPageHeader Code="RPT-001" TitleKey="RPT.DailyProduction.Title" />

@* ── KPI strip: 실적 · 달성률 · 양품률 · 불량 · 계획 ─────────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.Actual"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@TotalActual.ToString("N0")</div>
            <div class="ames-kpi-s">@L["RPT.DailyProduction.Kpi.ActualSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(Achievement is null ? "" : Achievement >= 100 ? "ok" : Achievement >= 90 ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.Achievement"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@Pct(Achievement)</div>
            <div class="ames-kpi-s">@L["RPT.DailyProduction.Kpi.AchievementSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @YieldCls(Yield)">
        <div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.Yield"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@Pct(Yield)</div>
            <div class="ames-kpi-s">@L["RPT.DailyProduction.Kpi.YieldSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(TotalDefect > 0 ? "bad" : "ok")">
        <div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.DefectQty"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@TotalDefect.ToString("N0")</div>
            <div class="ames-kpi-s">@L["RPT.DailyProduction.Kpi.DefectSub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.Plan"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@TotalPlan.ToString("N0")</div>
            <div class="ames-kpi-s">@L["RPT.DailyProduction.Kpi.PlanSub"]</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

@* ── 조회 조건: 일자 · 라인 · 교대 · 조회 · 인쇄 · 내보내기 ─────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:0;">
        <span style="white-space:nowrap;">▼ @L["RPT.DailyProduction.Filter.Title"] <span class="dim" style="font-weight:400;font-size:.85em;margin-left:6px;">@FilterSummary</span></span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Date"]" Component="DatePickerDay" />
            <RadzenDatePicker TValue="DateTime" Name="DatePickerDay" @bind-Value="_fDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenLabel Text="@L["Col.Line"]" Component="DropDownLine" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownLine" @bind-Value="_fLine" Data="@LineFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:240px;" />
            <RadzenLabel Text="@L["Col.Shift"]" Component="DropDownShift" />
            <RadzenDropDown Name="DropDownShift" @bind-Value="_fShift" Data="@ShiftFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="@L["RPT.DailyProduction.Btn.Print"]" Icon="print" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@Print" class="ames-rz-btn" />
            <RadzenButton Text="@L["RPT.DailyProduction.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ExportXlsx" class="ames-rz-btn" />
        </RadzenStack>
    </div>
</div>

@* ── 시간대별 추이 (2) + 교대별 요약 (1) ─────────────────────────────── *@
<div class="rpt-dp-grid2">
    <div class="ames-card">
        <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;">
            <span>▼ @L["RPT.DailyProduction.Hourly.Title"]</span>
            <span class="mnt-db-hint">@L["RPT.DailyProduction.Hourly.Hint"]</span>
        </div>
        @if (TotalActual == 0)
        {
            <div class="mnt-db-empty">@L["RPT.DailyProduction.Hourly.Empty"]</div>
        }
        else
        {
            <RadzenChart class="rpt-dp-chart" Style="width:100%;height:250px;">
                <RadzenChartTooltipOptions Visible="true" />
                <RadzenLegend Position="LegendPosition.Bottom" />
                <RadzenCategoryAxis Padding="8" />
                <RadzenValueAxis Min="0" FormatString="{0:N0}">
                    <RadzenGridLines Visible="true" />
                </RadzenValueAxis>
                <RadzenStackedColumnSeries TItem="HourPoint" Data="@_hours" CategoryProperty="Label" ValueProperty="Good" Title="@L["Col.Good"]" Fill="#10b981" />
                <RadzenStackedColumnSeries TItem="HourPoint" Data="@_hours" CategoryProperty="Label" ValueProperty="Defect" Title="@L["RPT.DailyProduction.Col.DefectQty"]" Fill="#dc2626" />
            </RadzenChart>
        }
    </div>

    <div class="ames-card">
        <div class="ames-card-h">▼ @L["RPT.DailyProduction.Shift.Title"]</div>
        @if (_shifts.Count == 0)
        {
            <div class="mnt-db-empty">@L["RPT.DailyProduction.Shift.Empty"]</div>
        }
        else
        {
            var maxShift = _shifts.Max(s => s.Total);
            @foreach (var s in _shifts)
            {
                <div class="rpt-dp-shift">
                    <div class="h">
                        <b>@ShiftLabel(s.Code)</b>
                        <span class="v">@s.Total.ToString("N0") EA</span>
                    </div>
                    <div class="mnt-dt-track"><div class="mnt-dt-fill" style="width:@(maxShift > 0 ? Math.Max(2, (int)Math.Round(100.0 * s.Total / maxShift)) : 0)%;background:#10b981;"></div></div>
                    <div class="f">
                        <span>@string.Format(L["RPT.DailyProduction.Shift.GoodDefect"].Value, s.Good.ToString("N0"), s.Defect.ToString("N0"))</span>
                        <span>@string.Format(L["RPT.DailyProduction.Shift.Yield"].Value, Pct(s.Yield))</span>
                    </div>
                </div>
            }
        }
    </div>
</div>

@* ── 라인별 생산 ─────────────────────────────────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.DailyProduction.ByLine.Title"] · @_lines.Count @L["Lbl.Items"]</span>
    </div>

    <RadzenDataGrid TItem="LineAgg" Data="@_lines" AllowPaging="false" AllowSorting="true" EmptyText="@L["RPT.DailyProduction.Empty"]" Class="ames-rz-grid rpt-dp-grid">
        <Columns>
            <RadzenDataGridColumn TItem="LineAgg" Property="LineId" Title="@L["Col.Line"]" Width="140px">
                <Template Context="r"><span class="code">@r.LineId</span></Template>
                <FooterTemplate><b>@L["RPT.DailyProduction.Total"]</b></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="LineName" Title="@L["Col.Name"]" Width="150px" Sortable="false">
                <Template Context="r"><span style="white-space:nowrap;">@r.LineName</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="ItemName" Title="@L["RPT.DailyProduction.Col.Product"]">
                <Template Context="r"><span style="white-space:nowrap;">@r.ItemName</span>@if (!string.IsNullOrEmpty(r.ItemNo)) { <span class="dim code" style="font-size:.85em;margin-left:6px;">@r.ItemNo</span> }</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Plan" Title="@L["Col.Plan"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r"><span class="code">@r.Plan.ToString("N0")</span></Template>
                <FooterTemplate><span class="code">@TotalPlan.ToString("N0")</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Actual" Title="@L["RPT.DailyProduction.Col.Actual"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r"><b class="code">@r.Actual.ToString("N0")</b></Template>
                <FooterTemplate><span class="code">@TotalActual.ToString("N0")</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Achievement" Title="@L["RPT.DailyProduction.Col.Achievement"]" TextAlign="TextAlign.Right" Width="100px">
                <Template Context="r"><span class="code" style="color:@AchColor(r.Achievement);">@Pct(r.Achievement)</span></Template>
                <FooterTemplate><span class="code" style="color:@AchColor(Achievement);">@Pct(Achievement)</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Good" Title="@L["Col.Good"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r"><span class="code">@r.Good.ToString("N0")</span></Template>
                <FooterTemplate><span class="code">@TotalGood.ToString("N0")</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Defect" Title="@L["RPT.DailyProduction.Col.DefectQty"]" TextAlign="TextAlign.Right" Width="80px">
                <Template Context="r"><span class="code" style="@(r.Defect > 0 ? "color:#f87171;" : "")">@r.Defect.ToString("N0")</span></Template>
                <FooterTemplate><span class="code" style="@(TotalDefect > 0 ? "color:#f87171;" : "")">@TotalDefect.ToString("N0")</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LineAgg" Property="Yield" Title="@L["RPT.DailyProduction.Col.Yield"]" Width="150px">
                <Template Context="r">@(r.Yield is { } y ? Bar(y) : Dash)</Template>
                <FooterTemplate>@(Yield is { } y ? Bar(y) : Dash)</FooterTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    List<RptRepository.ProdHourRow>         _raw        = new();
    List<RptRepository.PlanRow>             _plan       = new();
    List<LineAgg>                           _lines      = new();
    List<HourPoint>                         _hours      = new();
    List<ShiftAgg>                          _shifts     = new();
    List<MasterDataRepository.LineRow>      _lineList   = new();
    List<MasterDataRepository.CodeItemRow>  _shiftItems = new();
    List<(string Code, int From, int To)>   _shiftRanges = new();

    DateTime _fDate = DateTime.Today;
    string?  _fLine, _fShift;
    string   _msg = "";
    bool     _isErr;

    static readonly MarkupString Dash = new("<span class=\"dim\">—</span>");

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    public sealed class LineAgg
    {
        public string LineId = ""; public string LineName = ""; public string? ItemNo; public string ItemName = "";
        public decimal Plan; public int Actual; public int Good; public int Defect;
        public decimal? Achievement => Plan > 0 ? 100m * Actual / Plan : null;
        public decimal? Yield => Actual > 0 ? 100m * Good / Actual : null;
    }
    public sealed record HourPoint(string Label, int Good, int Defect);
    public sealed record ShiftAgg(string Code, int Good, int Defect) { public int Total => Good + Defect; public decimal? Yield => Total > 0 ? 100m * Good / Total : null; }

    IEnumerable<DropDownItem> LineFilterOptions  => _lineList.Select(l => new DropDownItem { Value = l.LineID, Text = MasterDataRepository.LocalName(l.LineName, l.LineNameEn) is { Length: > 0 } nm ? $"[{l.LineID}] {nm}" : $"[{l.LineID}]" });
    IEnumerable<DropDownItem> ShiftFilterOptions => _shiftItems.Where(c => c.UseFlag).Select(c => new DropDownItem { Value = c.CodeValue ?? "", Text = $"[{c.CodeValue}] {MasterDataRepository.LocalName(c)}" });

    // ── KPI (필터 적용 집합) ────────────────────────────────────────────
    int      TotalGood   => _lines.Sum(l => l.Good);
    int      TotalDefect => _lines.Sum(l => l.Defect);
    int      TotalActual => _lines.Sum(l => l.Actual);
    decimal  TotalPlan   => _lines.Sum(l => l.Plan);
    decimal? Achievement => TotalPlan > 0 ? 100m * TotalActual / TotalPlan : null;
    decimal? Yield       => TotalActual > 0 ? 100m * TotalGood / TotalActual : null;

    string FilterSummary =>
        $"{_fDate.ToString(DateFmt.Date)} · {(_fLine is null ? L["Filter.All"].Value : _fLine)} · {(_fShift is null ? L["Filter.All"].Value : ShiftLabel(_fShift))}";

    protected override void OnInitialized()
    {
        try { _lineList   = MD.ListLines(); } catch { }
        try { _shiftItems = MD.ListCodeItems("WORK_SHIFT"); } catch { }
        _shiftRanges = ParseShiftRanges(_shiftItems);

        // 기본 일자: 오늘. 오늘 실적이 없으면 마지막 실적일
        try
        {
            var (_, mx) = Rpt.ProductionDateExtent();
            if (mx is { } m && m.Date < DateTime.Today) _fDate = m.Date;
        }
        catch { }

        Reload();
    }

    void Reload()
    {
        try { _raw  = Rpt.ListProductionByHour(_fDate, _fLine); }
        catch (Exception ex) { _raw = new(); ShowMsg(ex.Message, true); }
        try { _plan = Rpt.ListPlanByDate(_fDate, _fLine); }
        catch { _plan = new(); }
        Rebuild();
    }

    void Rebuild()
    {
        // 교대 필터는 실적(시간대)에만 걸린다. 계획은 라인 스케줄에 교대 정보가 없어 일 단위 그대로 둔다
        var rows = _raw.Where(r => string.IsNullOrEmpty(_fShift) || ShiftOf(r.Hour) == _fShift).ToList();

        _hours = Enumerable.Range(0, 24)
            .Select(h => new HourPoint(h.ToString("00"), rows.Where(r => r.Hour == h).Sum(r => r.GoodQty), rows.Where(r => r.Hour == h).Sum(r => r.DefectQty)))
            .ToList();

        _shifts = rows.GroupBy(r => ShiftOf(r.Hour))
            .Select(g => new ShiftAgg(g.Key, g.Sum(r => r.GoodQty), g.Sum(r => r.DefectQty)))
            .OrderBy(s => ShiftOrder(s.Code)).ToList();

        // 라인×품목: 실적 ∪ 계획 키
        var keys = rows.Select(r => (Line: r.LineId ?? "—", Item: r.ItemNo))
            .Concat(_plan.Select(p => (Line: p.LineId ?? "—", Item: p.ItemNo)))
            .Distinct().ToList();
        _lines = keys.Select(k =>
        {
            var act = rows.Where(r => (r.LineId ?? "—") == k.Line && r.ItemNo == k.Item).ToList();
            var pln = _plan.Where(p => (p.LineId ?? "—") == k.Line && p.ItemNo == k.Item).ToList();
            var nmKo = act.Select(r => r.ItemName).Concat(pln.Select(p => p.ItemName)).FirstOrDefault(n => !string.IsNullOrEmpty(n));
            var nmEn = act.Select(r => r.ItemNameEn).Concat(pln.Select(p => p.ItemNameEn)).FirstOrDefault(n => !string.IsNullOrEmpty(n));
            var itemName = MasterDataRepository.LocalName(nmKo, nmEn);
            return new LineAgg
            {
                LineId = k.Line, LineName = LineName(k.Line), ItemNo = k.Item,
                ItemName = string.IsNullOrEmpty(itemName) ? (k.Item ?? L["RPT.DailyProduction.Item.Unknown"].Value) : itemName,
                Plan = pln.Sum(p => p.PlannedQty),
                Good = act.Sum(r => r.GoodQty), Defect = act.Sum(r => r.DefectQty),
                Actual = act.Sum(r => r.GoodQty) + act.Sum(r => r.DefectQty),
            };
        }).OrderBy(l => l.LineId).ThenBy(l => l.ItemNo).ToList();
    }

    // ── 교대 판정: WORK_SHIFT Attribute1 "HHMM-HHMM" 을 시간 구간으로 파싱 (없으면 A 08-16 / B 16-24 / C 그 외) ──
    static List<(string Code, int From, int To)> ParseShiftRanges(List<MasterDataRepository.CodeItemRow> items)
    {
        var list = new List<(string, int, int)>();
        foreach (var c in items.Where(c => c.UseFlag && !string.IsNullOrEmpty(c.CodeValue)))
        {
            var a = (c.Attribute1 ?? "").Split('-');
            if (a.Length == 2 && a[0].Length >= 2 && a[1].Length >= 2
                && int.TryParse(a[0][..2], out var f) && int.TryParse(a[1][..2], out var t))
                list.Add((c.CodeValue!, f, t == 0 ? 24 : t));
        }
        return list.Count > 0 ? list : new() { ("A", 8, 16), ("B", 16, 24), ("C", 0, 8) };
    }

    string ShiftOf(int hour)
    {
        foreach (var (code, from, to) in _shiftRanges)
        {
            if (from < to ? hour >= from && hour < to : hour >= from || hour < to) return code;
        }
        return _shiftRanges.Count > 0 ? _shiftRanges[^1].Code : "—";
    }
    int ShiftOrder(string code) => _shiftRanges.FindIndex(r => r.Code == code) is var i && i >= 0 ? i : 99;

    string ShiftLabel(string code) =>
        _shiftItems.FirstOrDefault(c => c.CodeValue == code) is { } c ? MasterDataRepository.LocalName(c) : code;

    string LineName(string id) =>
        _lineList.FirstOrDefault(l => l.LineID == id) is { } l ? MasterDataRepository.LocalName(l.LineName, l.LineNameEn) : "";

    // ── 표시 헬퍼 ─────────────────────────────────────────────────────
    static string Pct(decimal? v) => v is { } x ? $"{x:0.0}%" : "—";
    static string YieldCls(decimal? v) => v is not { } x ? "" : x >= 98m ? "ok" : x >= 95m ? "warn" : "bad";
    static string AchColor(decimal? v) => v is not { } x ? "inherit" : x >= 100m ? "#60a5fa" : x >= 90m ? "#fbbf24" : "#f87171";

    // 양품률 막대: PP-OEE A/P/Q 막대와 같은 구조 (Mnt/Mold 소진율 막대 CSS 재사용)
    static MarkupString Bar(decimal v)
    {
        var cls = v >= 98m ? "ok" : v >= 95m ? "warn" : "crit";
        var w = Math.Min(100m, Math.Max(0m, v)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        return new MarkupString(
            $"<div class=\"mnt-mold-bar\"><div class=\"mnt-mold-track\"><i class=\"mnt-mold-fill-{cls}\" style=\"width:{w}%\"></i></div>" +
            $"<span class=\"mnt-mold-bar-val\">{v:F1}%</span></div>");
    }

    async Task Print()
    {
        try { await JS.InvokeVoidAsync("print"); } catch { }
    }

    // 라인별 표(필터 적용분)를 .xlsx 로 내려받는다 — 화면 컬럼 순서 그대로 + 합계 행
    async Task ExportXlsx()
    {
        if (_lines.Count == 0) { ShowMsg(L["RPT.DailyProduction.Err.NoExport"], true); return; }

        var headers = new[]
        {
            L["Col.Line"].Value, L["Col.Name"].Value, L["RPT.DailyProduction.Col.Product"].Value, L["Col.Item"].Value,
            L["Col.Plan"].Value, L["RPT.DailyProduction.Col.Actual"].Value, L["RPT.DailyProduction.Col.Achievement"].Value,
            L["Col.Good"].Value, L["RPT.DailyProduction.Col.DefectQty"].Value, L["RPT.DailyProduction.Col.Yield"].Value,
        };
        var data = _lines.Select(l => (IReadOnlyList<object?>)new object?[]
        {
            l.LineId, l.LineName, l.ItemName, l.ItemNo,
            l.Plan, l.Actual, l.Achievement is { } a ? Math.Round(a, 1) : null,
            l.Good, l.Defect, l.Yield is { } y ? Math.Round(y, 1) : null,
        }).Append(new object?[]
        {
            L["RPT.DailyProduction.Total"].Value, null, null, null,
            TotalPlan, TotalActual, Achievement is { } ta ? Math.Round(ta, 1) : null,
            TotalGood, TotalDefect, Yield is { } ty ? Math.Round(ty, 1) : null,
        });

        var bytes = AMES.Web.Services.XlsxWriter.Build($"{L["RPT.DailyProduction.Title"].Value} {_fDate:yyyy-MM-dd}", headers, data);
        var name  = $"DailyProduction_{_fDate:yyyyMMdd}_{DateTime.Now:HHmmss}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["RPT.DailyProduction.Ok.Exported"].Value, _lines.Count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
