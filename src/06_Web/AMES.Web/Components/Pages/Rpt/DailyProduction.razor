@page "/rpt/daily-production"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-01 @L["RPT.DailyProduction.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-01</div>
    <div class="ames-page-t">@L["RPT.DailyProduction.Title"]</div>
    <div class="ames-page-sub">@L["RPT.DailyProduction.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.Days"]</div>
        <div class="ames-kpi-v">@_days</div><div class="ames-kpi-s">distinct days</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.Good"]</div>
        <div class="ames-kpi-v">@_good.ToString("N0")</div><div class="ames-kpi-s">good qty</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.Defect"]</div>
        <div class="ames-kpi-v">@_def.ToString("N0")</div><div class="ames-kpi-s">defect entries</div></div>
    <div class="ames-kpi @(_yld >= 99m ? "ok" : _yld >= 95m ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.DailyProduction.Kpi.Yield"]</div>
        <div class="ames-kpi-v">@_yld.ToString("0.00")%</div>
        <div class="ames-kpi-s">good / total</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.DailyProduction.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:120px;padding:4px 8px;"
                   placeholder="@L["RPT.DailyProduction.Ph.Line"]" @bind="_fLine" autocomplete="off" />
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Period"]</label>
            <select class="ames-input" style="width:80px;padding:4px 8px;" @bind="_daysBack">
                <option value="7">7@L["Lbl.Days"]</option>
                <option value="14">14@L["Lbl.Days"]</option>
                <option value="30">30@L["Lbl.Days"]</option>
                <option value="60">60@L["Lbl.Days"]</option>
                <option value="90">90@L["Lbl.Days"]</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["RPT.DailyProduction.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.Date"]</th><th>@L["Col.Line"]</th><th class="num">@L["RPT.DailyProduction.Col.Entries"]</th>
                    <th class="num">@L["RPT.DailyProduction.Col.Good"]</th><th class="num">@L["RPT.DailyProduction.Col.Defect"]</th><th class="num">@L["RPT.DailyProduction.Col.Yield"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td class="dim">@r.Day.ToString("MM-dd (ddd)")</td>
                        <td>@(r.LineId ?? "—")</td>
                        <td class="num">@r.Entries</td>
                        <td class="num">@r.GoodQty.ToString("N0")</td>
                        <td class="num">@r.DefectQty</td>
                        <td class="num">
                            <span class="pill @(r.YieldPct >= 99m ? "ok" : r.YieldPct >= 95m ? "warn" : "bad")">
                                @r.YieldPct.ToString("0.00")%
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.DailyProdRow> _allRows = new();
    List<AMES.Data.Repositories.RptRepository.DailyProdRow> _rows    = new();

    int     _daysBack = 14;
    string  _fLine    = "";
    int     _days;
    long    _good, _def;
    decimal _yld;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Rpt.ListDailyProduction(_daysBack); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = string.IsNullOrWhiteSpace(_fLine)
            ? _allRows
            : _allRows.Where(r => (r.LineId ?? "").Contains(_fLine, StringComparison.OrdinalIgnoreCase)).ToList();
        _days = _rows.Select(r => r.Day).Distinct().Count();
        _good = _rows.Sum(r => (long)r.GoodQty);
        _def  = _rows.Sum(r => (long)r.DefectQty);
        var tot = _good + _def;
        _yld = tot > 0 ? (decimal)_good / tot * 100m : 0m;
    }
}
