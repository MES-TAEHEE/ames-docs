@page "/rpt/monthly-kpi"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-007 @L["RPT.MonthlyKpi.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-007</div>
    <div class="ames-page-t">@L["RPT.MonthlyKpi.Title"]</div>
    <div class="ames-page-sub">@L["RPT.MonthlyKpi.Sub"]</div>
</div>

@if (_rows.Count > 0)
{
    var cur = _rows[^1];
    <div class="ames-kpis">
        <div class="ames-kpi ok"><div class="ames-kpi-l">@L["RPT.MonthlyKpi.Kpi.GoodQty"]</div>
            <div class="ames-kpi-v">@cur.ProductionGoodQty.ToString("N0")</div>
            <div class="ames-kpi-s">@cur.Year-@cur.Month.ToString("00")</div></div>
        <div class="ames-kpi @(cur.YieldPct >= 99m ? "ok" : cur.YieldPct >= 95m ? "warn" : "bad")">
            <div class="ames-kpi-l">@L["RPT.MonthlyKpi.Kpi.Yield"]</div>
            <div class="ames-kpi-v">@cur.YieldPct.ToString("0.0")%</div>
            <div class="ames-kpi-s">current month</div></div>
        <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.MonthlyKpi.Kpi.ShipOrders"]</div>
            <div class="ames-kpi-v">@cur.ShipmentOrders</div>
            <div class="ames-kpi-s">shipped</div></div>
        <div class="ames-kpi bad"><div class="ames-kpi-l">@L["RPT.MonthlyKpi.Kpi.Failures"]</div>
            <div class="ames-kpi-v">@cur.FailureCount</div>
            <div class="ames-kpi-s">MNT events</div></div>
    </div>
}
else
{
    <div class="ames-kpis">
        <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.MonthlyKpi.Kpi.GoodQty"]</div><div class="ames-kpi-v">—</div></div>
        <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.MonthlyKpi.Kpi.Yield"]</div><div class="ames-kpi-v">—</div></div>
        <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.MonthlyKpi.Kpi.ShipOrders"]</div><div class="ames-kpi-v">—</div></div>
        <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.MonthlyKpi.Kpi.Failures"]</div><div class="ames-kpi-v">—</div></div>
    </div>
}

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.MonthlyKpi.List"] · @_rows.Count @L["RPT.MonthlyKpi.ListSuffix"]</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Lbl.Period"]</span>
            <select class="ames-input" style="width:110px;padding:4px 8px;" @bind="_monthsBack">
                <option value="3">3@(L["RPT.MonthlyKpi.ListSuffix"])</option>
                <option value="6">6@(L["RPT.MonthlyKpi.ListSuffix"])</option>
                <option value="12">12@(L["RPT.MonthlyKpi.ListSuffix"])</option>
                <option value="24">24@(L["RPT.MonthlyKpi.ListSuffix"])</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["RPT.MonthlyKpi.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["RPT.MonthlyKpi.Col.Period"]</th>
                    <th class="num">@L["RPT.MonthlyKpi.Col.GoodQty"]</th><th class="num">@L["RPT.MonthlyKpi.Col.DefectQty"]</th>
                    <th class="num">@L["RPT.MonthlyKpi.Col.Yield"]</th><th class="num">@L["RPT.MonthlyKpi.Col.ShipOrders"]</th>
                    <th class="num">@L["RPT.MonthlyKpi.Col.Failures"]</th><th class="num">@L["RPT.MonthlyKpi.Col.AvgOee"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr>
                        <td class="code">@r.Year-@r.Month.ToString("00")</td>
                        <td class="num">@r.ProductionGoodQty.ToString("N0")</td>
                        <td class="num">@r.DefectQty</td>
                        <td class="num">
                            <span class="pill @(r.YieldPct >= 99m ? "ok" : r.YieldPct >= 95m ? "warn" : "bad")">
                                @r.YieldPct.ToString("0.0")%
                            </span>
                        </td>
                        <td class="num">@r.ShipmentOrders</td>
                        <td class="num">@r.FailureCount</td>
                        <td class="num">@(r.AvgOee > 0m ? r.AvgOee.ToString("0.0") + "%" : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.MonthlyKpiRow> _rows = new();
    int _page = 0;
    const int _pageSize = 20;
    int _monthsBack = 6;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        _page = 0;
        try { _rows = Rpt.ListMonthlyKpi(_monthsBack); } catch { _rows = new(); }
    }
}
