@page "/rpt/on-time"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-004 @L["RPT.OnTime.Title"] · AMES</PageTitle>

<AmesPageHeader Code="RPT-004" TitleKey="RPT.OnTime.Title" />

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.OnTime.Kpi.Total"]</div>
        <div class="ames-kpi-v">@_total</div><div class="ames-kpi-s">total shipped</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["RPT.OnTime.Kpi.OnTime"]</div>
        <div class="ames-kpi-v">@_ok</div><div class="ames-kpi-s">on schedule</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">@L["RPT.OnTime.Kpi.Late"]</div>
        <div class="ames-kpi-v">@_late</div><div class="ames-kpi-s">missed date</div></div>
    <div class="ames-kpi @(_pct >= 95 ? "ok" : _pct >= 85 ? "warn" : "bad")">
        <div class="ames-kpi-l">OTD%</div>
        <div class="ames-kpi-v">@_pct.ToString("0.0")%</div>
        <div class="ames-kpi-s">overall</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.OnTime.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Lbl.Period"]</span>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_daysBack">
                <option value="7">7@(L["Lbl.Days"])</option>
                <option value="14">14@(L["Lbl.Days"])</option>
                <option value="30">30@(L["Lbl.Days"])</option>
                <option value="60">60@(L["Lbl.Days"])</option>
                <option value="90">90@(L["Lbl.Days"])</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["RPT.OnTime.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.Date"]</th><th class="num">@L["RPT.OnTime.Kpi.Total"]</th>
                    <th class="num">@L["RPT.OnTime.Kpi.OnTime"]</th><th class="num">@L["RPT.OnTime.Kpi.Late"]</th>
                    <th class="num">@L["Col.OtdPct"]</th><th>@L["RPT.OnTime.Col.Trend"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows.Skip(_page * _pageSize).Take(_pageSize))
                {
                    <tr>
                        <td class="dim">@r.Day.ToString("MM-dd (ddd)")</td>
                        <td class="num">@r.TotalOrders</td>
                        <td class="num">@r.OnTime</td>
                        <td class="num">@r.Late</td>
                        <td class="num">
                            <span class="pill @(r.OnTimePct >= 95 ? "ok" : r.OnTimePct >= 85 ? "warn" : "bad")">
                                @r.OnTimePct.ToString("0.0")%
                            </span>
                        </td>
                        <td>
                            <div style="background:rgba(134,239,172,.25);border:1px solid rgba(134,239,172,.5);
                                        height:14px;border-radius:4px;
                                        width:@(r.OnTimePct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.OtdRow> _rows = new();
    int _page = 0;
    const int _pageSize = 20;

    int     _daysBack = 30;
    int     _total, _ok, _late;
    decimal _pct;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        _page = 0;
        try { _rows = Rpt.ListOtd(_daysBack); } catch { _rows = new(); }
        _total = _rows.Sum(r => r.TotalOrders);
        _ok    = _rows.Sum(r => r.OnTime);
        _late  = _rows.Sum(r => r.Late);
        _pct   = _total > 0 ? (decimal)_ok / _total * 100m : 0m;
    }
}
