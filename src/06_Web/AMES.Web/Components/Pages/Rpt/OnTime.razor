@page "/rpt/on-time"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt

<PageTitle>RPT-04 On-Time Delivery · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-04</div>
    <div class="ames-page-t">On-Time Delivery</div>
    <div class="ames-page-sub">납기 준수율 (OTD%) — 최근 30일</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">ORDERS</div>
        <div class="ames-kpi-v">@_total</div><div class="ames-kpi-s">total shipped</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">ON TIME</div>
        <div class="ames-kpi-v">@_ok</div><div class="ames-kpi-s">delivered on schedule</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">LATE</div>
        <div class="ames-kpi-v">@_late</div><div class="ames-kpi-s">missed promised date</div></div>
    <div class="ames-kpi @(_pct >= 95 ? "ok" : _pct >= 85 ? "warn" : "bad")">
        <div class="ames-kpi-l">OTD 30D</div>
        <div class="ames-kpi-v">@_pct.ToString("0.0")%</div>
        <div class="ames-kpi-s">overall</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h">Daily OTD breakdown</div>
    <table class="ames-table">
        <thead>
            <tr>
                <th>Day</th><th class="num">Total</th>
                <th class="num">On time</th><th class="num">Late</th>
                <th class="num">OTD %</th><th>Trend</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _rows)
            {
                <tr>
                    <td class="dim">@r.Day.ToString("MM-dd ddd")</td>
                    <td class="num">@r.TotalOrders</td>
                    <td class="num">@r.OnTime</td>
                    <td class="num">@r.Late</td>
                    <td class="num"><span class="pill @(r.OnTimePct >= 95 ? "ok" : r.OnTimePct >= 85 ? "warn" : "bad")">@r.OnTimePct.ToString("0.0")%</span></td>
                    <td>
                        <div style="background:rgba(134,239,172,.25);
                                    border:1px solid rgba(134,239,172,.5);
                                    height:14px;
                                    width:@(r.OnTimePct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;
                                    border-radius:4px;"></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (_rows.Count == 0) { <div class="ames-empty">No shipments to evaluate.</div> }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.OtdRow> _rows = new();
    int _total, _ok, _late;
    decimal _pct;
    protected override void OnInitialized()
    {
        try { _rows = Rpt.ListOtd(); } catch { }
        _total = _rows.Sum(r => r.TotalOrders);
        _ok    = _rows.Sum(r => r.OnTime);
        _late  = _rows.Sum(r => r.Late);
        _pct   = _total > 0 ? (decimal)_ok / _total * 100m : 0m;
    }
}
