@page "/rpt/on-time"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using Radzen

@attribute [Authorize]

@inject PpRepository Pp
@inject MasterDataRepository MD
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-004 @L["RPT.OnTime.Title"] · AMES</PageTitle>
<AmesPageHeader Code="RPT-004" TitleKey="RPT.OnTime.Title" />

@* ── KPI strip: 종합 OTD · 준수 · 지연 · 평균 지연일 · 미달 고객 ───────── *@
<div class="ames-kpis">
    <div class="ames-kpi @OtdCls(OverallOtd)">
        <div class="ames-kpi-l">@L["RPT.OnTime.Kpi.Overall"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@Pct(OverallOtd)</div>
            <div class="ames-kpi-s">@L["RPT.OnTime.Kpi.OverallSub"]</div>
        </div>
    </div>
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["RPT.OnTime.Kpi.OnTime"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@OnTimeCount.ToString("N0")</div>
            <div class="ames-kpi-s">@L["RPT.OnTime.Kpi.OnTimeSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(LateCount > 0 ? "bad" : "ok")">
        <div class="ames-kpi-l">@L["RPT.OnTime.Kpi.Late"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@LateCount.ToString("N0")</div>
            <div class="ames-kpi-s">@L["RPT.OnTime.Kpi.LateSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(AvgDelay is null ? "" : AvgDelay <= 2 ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.OnTime.Kpi.AvgDelay"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@(AvgDelay is { } d ? string.Format(L["RPT.OnTime.DaysFmt"].Value, d.ToString("0.0")) : "—")</div>
            <div class="ames-kpi-s">@L["RPT.OnTime.Kpi.AvgDelaySub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(BelowTarget > 0 ? "warn" : "ok")">
        <div class="ames-kpi-l">@L["RPT.OnTime.Kpi.Below"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@BelowTarget</div>
            <div class="ames-kpi-s">@L["RPT.OnTime.Kpi.BelowSub"]</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

@* ── 조회 조건: 기간 · 고객사 · 조회 · 인쇄 · 내보내기 ──────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:0;">
        <span style="white-space:nowrap;">▼ @L["RPT.OnTime.Filter.Title"] <span class="dim" style="font-weight:400;font-size:.85em;margin-left:6px;">@string.Format(L["RPT.OnTime.Lbl.Range"].Value, _fFrom.ToString(DateFmt.Date), _fTo.ToString(DateFmt.Date)) · @(_fCustomer is null ? L["Filter.All"].Value : CustomerLabel(_fCustomer))</span></span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Lbl.Period"]" Component="DatePickerFrom" />
            <RadzenDatePicker TValue="DateTime" Name="DatePickerFrom" @bind-Value="_fFrom" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <span class="dim">~</span>
            <RadzenDatePicker TValue="DateTime" Name="DatePickerTo" @bind-Value="_fTo" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />
            <RadzenLabel Text="@L["Col.Customer"]" Component="DropDownCustomer" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownCustomer" @bind-Value="_fCustomer" Data="@CustomerFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:260px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="@L["RPT.OnTime.Btn.Print"]" Icon="print" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@Print" class="ames-rz-btn" />
            <RadzenButton Text="@L["RPT.OnTime.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ExportXlsx" class="ames-rz-btn" />
        </RadzenStack>
    </div>
</div>

@* ── 고객사 × 월 히트맵 ─────────────────────────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span>▼ @L["RPT.OnTime.Heat.Title"]</span>
        <span class="mnt-db-hint">@L["RPT.OnTime.Heat.Hint"]</span>
    </div>
    @if (_months.Count == 0 || _heat.Count == 0)
    {
        <div class="mnt-db-empty">@L["RPT.OnTime.Empty"]</div>
    }
    else
    {
        <div class="rpt-ot-heat" style="grid-template-columns:170px repeat(@_months.Count, minmax(70px, 1fr)) minmax(80px, 1fr);">
            <div class="hd l">@L["RPT.OnTime.Heat.Customer"]</div>
            @foreach (var m in _months) { <div class="hd">@m.ToString("yy-MM")</div> }
            <div class="hd">@L["RPT.OnTime.Heat.Avg"]</div>

            @foreach (var h in _heat)
            {
                <div class="rl" title="@h.CustomerId">@h.Label</div>
                @foreach (var m in _months)
                {
                    var v = h.ByMonth.TryGetValue(m, out var x) ? x : null;
                    <div class="rpt-ot-cell @HeatCls(v)" title="@(v is { } ? $"{h.Label} {m:yy-MM} · {v:0.0}%" : "")">@(v is { } y ? y.ToString("0.#") : "—")</div>
                }
                <div class="rpt-ot-cell avg">@(h.Avg is { } a ? a.ToString("0.#") : "—")</div>
            }

            <div class="rl ov">@L["RPT.OnTime.Heat.Overall"]</div>
            @foreach (var m in _months)
            {
                var v = _monthAvg.TryGetValue(m, out var x) ? x : null;
                <div class="rpt-ot-cell @HeatCls(v)">@(v is { } y ? y.ToString("0.#") : "—")</div>
            }
            <div class="rpt-ot-cell avg">@(OverallOtd is { } o ? o.ToString("0.#") : "—")</div>
        </div>
        <div class="rpt-ot-legend">
            <span><i style="background:#059669;"></i>@L["RPT.OnTime.Legend.Ex"]</span>
            <span><i style="background:#65a30d;"></i>@L["RPT.OnTime.Legend.Good"]</span>
            <span><i style="background:#f59e0b;"></i>@L["RPT.OnTime.Legend.Caution"]</span>
            <span><i style="background:#dc2626;"></i>@L["RPT.OnTime.Legend.Low"]</span>
        </div>
    }
</div>

@* ── 품목별 납기 성과 ─────────────────────────────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.OnTime.Item.Title"] · @_items.Count @L["Lbl.Items"]</span>
    </div>

    <RadzenDataGrid TItem="ItemAgg" Data="@_items" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" EmptyText="@L["RPT.OnTime.Empty"]" Class="ames-rz-grid rpt-dp-grid">
        <Columns>
            <RadzenDataGridColumn TItem="ItemAgg" Property="ItemName" Title="@L["Col.Item"]">
                <Template Context="r"><b style="white-space:nowrap;">@r.ItemName</b><span class="dim code" style="font-size:.85em;margin-left:6px;">@r.ItemNo</span></Template>
                <FooterTemplate><b>@L["RPT.OnTime.Total"]</b></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemAgg" Property="CustomerId" Title="@L["Col.Customer"]" Width="200px">
                <Template Context="r"><span class="code">@r.CustomerId</span><span class="dim" style="font-size:.85em;margin-left:6px;">@CustomerName(r.CustomerId)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemAgg" Property="Deliveries" Title="@L["RPT.OnTime.Col.Deliveries"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r"><span class="code">@r.Deliveries</span></Template>
                <FooterTemplate><span class="code">@_items.Sum(i => i.Deliveries)</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemAgg" Property="OnTime" Title="@L["RPT.OnTime.Col.OnTime"]" TextAlign="TextAlign.Right" Width="80px">
                <Template Context="r"><span class="code" style="color:#34d399;">@r.OnTime</span></Template>
                <FooterTemplate><span class="code" style="color:#34d399;">@_items.Sum(i => i.OnTime)</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemAgg" Property="Late" Title="@L["RPT.OnTime.Col.Late"]" TextAlign="TextAlign.Right" Width="80px">
                <Template Context="r"><span class="code" style="@(r.Late > 0 ? "color:#f87171;" : "")">@r.Late</span></Template>
                <FooterTemplate><span class="code" style="@(LateCount > 0 ? "color:#f87171;" : "")">@_items.Sum(i => i.Late)</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemAgg" Property="AvgDelay" Title="@L["RPT.OnTime.Col.AvgDelay"]" TextAlign="TextAlign.Right" Width="110px">
                <Template Context="r"><span class="code">@(r.AvgDelay is { } d ? string.Format(L["RPT.OnTime.DaysFmt"].Value, d.ToString("0.0")) : "—")</span></Template>
                <FooterTemplate><span class="code">@(AvgDelay is { } d ? string.Format(L["RPT.OnTime.DaysFmt"].Value, d.ToString("0.0")) : "—")</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemAgg" Property="Otd" Title="@L["Col.OtdPct"]" TextAlign="TextAlign.Center" Width="90px">
                <Template Context="r"><span class="pill @OtdCls(r.Otd)">@Pct(r.Otd)</span></Template>
                <FooterTemplate><span class="pill @OtdCls(OverallOtd)">@Pct(OverallOtd)</span></FooterTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;

    List<PpRepository.OtdRow>               _rows      = new();
    List<DateTime>                          _months    = new();
    List<HeatRow>                           _heat      = new();
    Dictionary<DateTime, decimal?>          _monthAvg  = new();
    List<ItemAgg>                           _items     = new();
    List<MasterDataRepository.CustomerRow>  _customers = new();

    DateTime _fFrom = FirstOfMonth(DateTime.Today).AddMonths(-5), _fTo = FirstOfMonth(DateTime.Today).AddMonths(1).AddDays(-1);
    string?  _fCustomer;
    string   _msg = "";
    bool     _isErr;

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    public sealed class HeatRow { public string CustomerId = ""; public string Label = ""; public Dictionary<DateTime, decimal?> ByMonth = new(); public decimal? Avg; }
    public sealed class ItemAgg
    {
        public string ItemNo = ""; public string ItemName = ""; public string CustomerId = "";
        public int Deliveries; public int OnTime; public int Late; public decimal? AvgDelay;
        public decimal? Otd => Deliveries > 0 ? 100m * OnTime / Deliveries : null;
    }

    IEnumerable<DropDownItem> CustomerFilterOptions => _customers
        .Where(c => c.Status is null || c.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase))
        .Select(c => new DropDownItem { Value = c.CustomerID, Text = $"[{c.CustomerID}] {MasterDataRepository.LocalName(c.CustomerName, c.CustomerNameEn)}".TrimEnd() });

    // ── KPI — PP-OTD(Delivery) 와 같은 정의: 지연 = 미출하 + 요청납기 경과, 나머지는 준수 ──
    int      LateCount   => _rows.Count(r => r.IsLate);
    int      OnTimeCount => _rows.Count - LateCount;
    decimal? OverallOtd  => Otd(_rows);
    decimal? AvgDelay    => _rows.Where(r => r.IsLate).Select(r => (decimal?)r.DaysLate).DefaultIfEmpty(null).Average();
    int      BelowTarget => _heat.Count(h => h.Avg is { } a && a < 98m);

    static decimal? Otd(IEnumerable<PpRepository.OtdRow> rows)
    {
        var list = rows as IList<PpRepository.OtdRow> ?? rows.ToList();
        return list.Count > 0 ? 100m * (list.Count - list.Count(r => r.IsLate)) / list.Count : null;
    }
    static DateTime FirstOfMonth(DateTime d) => new(d.Year, d.Month, 1);

    protected override void OnInitialized()
    {
        try { _customers = MD.ListCustomers(); } catch { }

        // 기본 기간: 최근 6개월(당월 포함). 그 안에 요청납기가 없으면 마지막 요청납기 월 기준 6개월
        try
        {
            var (_, mx) = Pp.OtdDateExtent();
            if (mx is { } m && m.Date < _fFrom) { _fTo = FirstOfMonth(m).AddMonths(1).AddDays(-1); _fFrom = FirstOfMonth(m).AddMonths(-5); }
        }
        catch { }

        Reload();
    }

    void Reload()
    {
        if (_fTo < _fFrom) (_fFrom, _fTo) = (_fTo, _fFrom);
        try { _rows = Pp.ListOtdFiltered(_fFrom, _fTo, _fCustomer, null, 5000).Where(r => r.RequestedDeliveryDate is { }).ToList(); }
        catch (Exception ex) { _rows = new(); ShowMsg(ex.Message, true); }
        Rebuild();
    }

    void Rebuild()
    {
        // 월 축: 조회 기간의 모든 달 (데이터 없는 달도 칸을 둔다)
        _months = new();
        for (var m = FirstOfMonth(_fFrom); m <= _fTo; m = m.AddMonths(1)) _months.Add(m);

        _heat = _rows.GroupBy(r => r.CustomerId ?? "—")
            .Select(g => new HeatRow
            {
                CustomerId = g.Key, Label = CustomerLabel(g.Key),
                ByMonth = g.GroupBy(r => FirstOfMonth(r.RequestedDeliveryDate!.Value)).ToDictionary(x => x.Key, x => Otd(x)),
                Avg = Otd(g),
            })
            .OrderBy(h => h.Label).ToList();

        _monthAvg = _rows.GroupBy(r => FirstOfMonth(r.RequestedDeliveryDate!.Value)).ToDictionary(g => g.Key, g => Otd(g));

        _items = _rows.GroupBy(r => (r.ItemNo, Cust: r.CustomerId ?? "—"))
            .Select(g =>
            {
                var first = g.First();
                var nm = MasterDataRepository.LocalName(first.ItemName, first.ItemNameEn);
                var late = g.Where(r => r.IsLate).ToList();
                return new ItemAgg
                {
                    ItemNo = g.Key.ItemNo, CustomerId = g.Key.Cust,
                    ItemName = string.IsNullOrEmpty(nm) ? (string.IsNullOrEmpty(g.Key.ItemNo) ? L["RPT.OnTime.Item.Unknown"].Value : g.Key.ItemNo) : nm,
                    Deliveries = g.Count(), Late = late.Count, OnTime = g.Count() - late.Count,
                    AvgDelay = late.Count > 0 ? (decimal)late.Average(r => r.DaysLate) : null,
                };
            })
            .OrderBy(i => i.CustomerId).ThenByDescending(i => i.Deliveries).ToList();
    }

    // ── 표시 헬퍼 ─────────────────────────────────────────────────────
    string CustomerName(string id) =>
        _customers.FirstOrDefault(c => c.CustomerID == id || c.CustomerCode == id) is { } c ? MasterDataRepository.LocalName(c.CustomerName, c.CustomerNameEn) : "";
    string CustomerLabel(string id) => CustomerName(id) is { Length: > 0 } nm ? nm : id;

    static string Pct(decimal? v) => v is { } x ? $"{x:0.0}%" : "—";
    // 등급 임계는 히트맵 범례와 동일: ≥98 우수 / ≥96 양호 / ≥92 주의 / 그 외 미달
    static string OtdCls(decimal? v)  => v is not { } x ? "mute" : x >= 98m ? "ok" : x >= 92m ? "warn" : "bad";
    static string HeatCls(decimal? v) => v is not { } x ? "none" : x >= 98m ? "ex" : x >= 96m ? "good" : x >= 92m ? "caut" : "low";

    async Task Print()
    {
        try { await JS.InvokeVoidAsync("print"); } catch { }
    }

    // 히트맵 + 품목별 표를 하나의 시트로 내려받는다 (히트맵 → 빈 줄 → 품목 표)
    async Task ExportXlsx()
    {
        if (_rows.Count == 0) { ShowMsg(L["RPT.OnTime.Err.NoExport"], true); return; }

        var headers = new List<string> { L["RPT.OnTime.Heat.Customer"].Value };
        headers.AddRange(_months.Select(m => m.ToString("yy-MM")));
        headers.Add(L["RPT.OnTime.Heat.Avg"].Value);

        var data = new List<IReadOnlyList<object?>>();
        foreach (var h in _heat)
        {
            var row = new List<object?> { h.Label };
            row.AddRange(_months.Select(m => (object?)(h.ByMonth.TryGetValue(m, out var v) && v is { } x ? Math.Round(x, 1) : null)));
            row.Add(h.Avg is { } a ? Math.Round(a, 1) : null);
            data.Add(row);
        }
        var ov = new List<object?> { L["RPT.OnTime.Heat.Overall"].Value };
        ov.AddRange(_months.Select(m => (object?)(_monthAvg.TryGetValue(m, out var v) && v is { } x ? Math.Round(x, 1) : null)));
        ov.Add(OverallOtd is { } o ? Math.Round(o, 1) : null);
        data.Add(ov);
        data.Add(new object?[0]);
        data.Add(new object?[] { L["Col.Item"].Value, L["Col.ItemName"].Value, L["Col.Customer"].Value, L["RPT.OnTime.Col.Deliveries"].Value, L["RPT.OnTime.Col.OnTime"].Value, L["RPT.OnTime.Col.Late"].Value, L["RPT.OnTime.Col.AvgDelay"].Value, L["Col.OtdPct"].Value });
        data.AddRange(_items.Select(i => (IReadOnlyList<object?>)new object?[] { i.ItemNo, i.ItemName, i.CustomerId, i.Deliveries, i.OnTime, i.Late, i.AvgDelay is { } d ? Math.Round(d, 1) : null, i.Otd is { } t ? Math.Round(t, 1) : null }));
        data.Add(new object?[] { L["RPT.OnTime.Total"].Value, null, null, _items.Sum(i => i.Deliveries), _items.Sum(i => i.OnTime), _items.Sum(i => i.Late), AvgDelay is { } ad ? Math.Round(ad, 1) : null, OverallOtd is { } oo ? Math.Round(oo, 1) : null });

        var bytes = AMES.Web.Services.XlsxWriter.Build(L["RPT.OnTime.Title"].Value, headers, data);
        var name  = $"OnTimeDelivery_{_fFrom:yyyyMMdd}-{_fTo:yyyyMMdd}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["RPT.OnTime.Ok.Exported"].Value, _items.Count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
