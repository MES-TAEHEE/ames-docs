@page "/rpt/defect-pareto"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt

<PageTitle>RPT-02 Defect Pareto · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-02</div>
    <div class="ames-page-t">Defect Pareto</div>
    <div class="ames-page-sub">불량 코드 파레토 — 최근 30일, top 20</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">CODES</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">distinct defect codes</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">TOTAL QTY</div>
        <div class="ames-kpi-v">@_total.ToString("N0")</div><div class="ames-kpi-s">defect units</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">EVENTS</div>
        <div class="ames-kpi-v">@_evts.ToString("N0")</div><div class="ames-kpi-s">defect log rows</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">TOP CODE</div>
        <div class="ames-kpi-v">@(_rows.Count > 0 ? _rows[0].DefectCode ?? "—" : "—")</div>
        <div class="ames-kpi-s">@(_rows.Count > 0 ? _rows[0].PercentOfTotal.ToString("0.0") + "% share" : "no data")</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h">Pareto table</div>
    <table class="ames-table">
        <thead>
            <tr>
                <th>Rank</th><th>Defect code</th>
                <th class="num">Qty</th><th class="num">Events</th>
                <th class="num">% share</th><th class="num">Cumulative %</th>
                <th>Bar</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < _rows.Count; i++)
            {
                var r = _rows[i];
                <tr>
                    <td class="code">#@(i + 1)</td>
                    <td><span class="pill bad">@(r.DefectCode ?? "—")</span></td>
                    <td class="num">@r.TotalQty.ToString("N0")</td>
                    <td class="num">@r.EventCount</td>
                    <td class="num">@r.PercentOfTotal.ToString("0.0")%</td>
                    <td class="num">@r.CumulativePct.ToString("0.0")%</td>
                    <td>
                        <div style="background:rgba(252,165,165,.25);
                                    border:1px solid rgba(252,165,165,.5);
                                    height:14px;width:@(Math.Min(r.PercentOfTotal * 3m, 100m).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;
                                    border-radius:4px;"></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (_rows.Count == 0) { <div class="ames-empty">No defects logged in the last 30 days.</div> }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.DefectParetoRow> _rows = new();
    long _total, _evts;
    protected override void OnInitialized()
    {
        try { _rows = Rpt.ListDefectPareto(); } catch { }
        _total = _rows.Sum(r => (long)r.TotalQty);
        _evts  = _rows.Sum(r => (long)r.EventCount);
    }
}
