@page "/rpt/defect-pareto"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-002 @L["RPT.DefectPareto.Title"] · AMES</PageTitle>

<AmesPageHeader Code="RPT-002" TitleKey="RPT.DefectPareto.Title" />

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.DefectPareto.Kpi.Codes"]</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">distinct codes</div></div>
    <div class="ames-kpi bad"><div class="ames-kpi-l">@L["RPT.DefectPareto.Kpi.Total"]</div>
        <div class="ames-kpi-v">@_total.ToString("N0")</div><div class="ames-kpi-s">defect units</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["RPT.DefectPareto.Kpi.Events"]</div>
        <div class="ames-kpi-v">@_evts.ToString("N0")</div><div class="ames-kpi-s">log rows</div></div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["RPT.DefectPareto.Kpi.Top"]</div>
        <div class="ames-kpi-v">@(_rows.Count > 0 ? _rows[0].DefectCode ?? "—" : "—")</div>
        <div class="ames-kpi-s">@(_rows.Count > 0 ? _rows[0].PercentOfTotal.ToString("0.0") + L["RPT.DefectPareto.Kpi.TopPct"].Value : "no data")</div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.DefectPareto.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Period"]</label>
            <select class="ames-input" style="width:100px;" @bind="_daysBack">
                <option value="7">7@(L["Lbl.Days"])</option>
                <option value="14">14@(L["Lbl.Days"])</option>
                <option value="30">30@(L["Lbl.Days"])</option>
                <option value="60">60@(L["Lbl.Days"])</option>
                <option value="90">90@(L["Lbl.Days"])</option>
            </select>
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">Top</label>
            <select class="ames-input" style="width:70px;" @bind="_topN">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["RPT.DefectPareto.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["RPT.DefectPareto.Col.Rank"]</th><th>@L["RPT.DefectPareto.Col.DefectCode"]</th>
                    <th class="num">@L["RPT.DefectPareto.Col.Qty"]</th><th class="num">@L["RPT.DefectPareto.Col.Events"]</th>
                    <th class="num">@L["RPT.DefectPareto.Col.Pct"]</th><th class="num">@L["RPT.DefectPareto.Col.CumPct"]</th>
                    <th>@L["RPT.DefectPareto.Col.Bar"]</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = _page * _pageSize; i < Math.Min(_rows.Count, (_page + 1) * _pageSize); i++)
                {
                    var r = _rows[i];
                    <tr>
                        <td class="code">#@(i + 1)</td>
                        <td><span class="pill bad">@(r.DefectCode ?? "—")</span></td>
                        <td class="num">@r.TotalQty.ToString("N0")</td>
                        <td class="num">@r.EventCount</td>
                        <td class="num">@r.PercentOfTotal.ToString("0.0")%</td>
                        <td class="num">@r.CumulativePct.ToString("0.0")%</td>
                        <td>
                            <div style="background:rgba(252,165,165,.25);border:1px solid rgba(252,165,165,.5);
                                        height:14px;border-radius:4px;
                                        width:@(Math.Min(r.PercentOfTotal * 3m, 100m).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.DefectParetoRow> _rows = new();
    int _page = 0;
    const int _pageSize = 20;

    int     _daysBack = 30;
    int     _topN     = 20;
    long    _total, _evts;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        _page = 0;
        try { _rows = Rpt.ListDefectPareto(_daysBack, _topN); } catch { _rows = new(); }
        _total = _rows.Sum(r => (long)r.TotalQty);
        _evts  = _rows.Sum(r => (long)r.EventCount);
    }
}
