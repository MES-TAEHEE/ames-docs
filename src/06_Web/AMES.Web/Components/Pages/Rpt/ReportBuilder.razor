@page "/rpt/report-builder"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-010 @L["RPT.ReportBuilder.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-010</div>
    <div class="ames-page-t">@L["RPT.ReportBuilder.Title"]</div>
    <div class="ames-page-sub">@L["RPT.ReportBuilder.Sub"]</div>
</div>

<div class="ames-card">
    <div class="ames-card-h">▼ @L["RPT.ReportBuilder.Preview"]</div>
    <p style="color:rgba(255,255,255,.7);font-size:13px;line-height:1.6;margin-bottom:18px">
        @L["RPT.ReportBuilder.Desc"]
    </p>

    <div class="ames-form" style="max-width:520px">
        <label>DATA SOURCE</label>
        <select disabled>
            <option>PR_ProductionResult — @L["RPT.ReportBuilder.Ds.Production"]</option>
            <option>FG_ShipmentOrder   — @L["RPT.ReportBuilder.Ds.Shipment"]</option>
            <option>MNT_OEELog         — @L["RPT.ReportBuilder.Ds.OEE"]</option>
            <option>QC_Inspection      — @L["RPT.ReportBuilder.Ds.QC"]</option>
            <option>PP_LineSchedule    — @L["RPT.ReportBuilder.Ds.LineSchedule"]</option>
        </select>

        <label>DIMENSIONS</label>
        <select disabled multiple style="height:90px">
            <option selected>Day</option>
            <option>Line</option>
            <option>Shift</option>
            <option>Equip</option>
            <option>Item</option>
            <option>Customer</option>
        </select>

        <label>MEASURES</label>
        <select disabled multiple style="height:90px">
            <option selected>SUM(GoodQty)</option>
            <option>COUNT(*)</option>
            <option>AVG(OEE)</option>
            <option>SUM(DefectQty)</option>
        </select>

        <label>DATE RANGE</label>
        <select disabled>
            <option>Last 7 days</option>
            <option selected>Last 14 days</option>
            <option>Last 30 days</option>
            <option>Custom...</option>
        </select>

        <div style="display:flex;gap:10px;margin-top:14px">
            <button class="ames-btn" disabled>RUN QUERY</button>
            <button class="ames-btn ghost" disabled>SAVE TEMPLATE</button>
            <button class="ames-btn ghost" disabled>EXPORT CSV</button>
        </div>
    </div>
</div>

<div class="ames-card">
    <div class="ames-card-h">▼ @L["RPT.ReportBuilder.Gallery"]</div>
    <div class="ames-tiles">
        <a class="ames-tile rpt" href="rpt/daily-production">
            <div class="ames-tile-ic">📈</div>
            <div class="ames-tile-h">DAILY PROD BY LINE</div>
            <div class="ames-tile-sub">RPT-001 ·  ready-made template</div>
        </a>
        <a class="ames-tile rpt" href="rpt/defect-pareto">
            <div class="ames-tile-ic">📉</div>
            <div class="ames-tile-h">TOP-20 DEFECT</div>
            <div class="ames-tile-sub">RPT-002 ·  pareto chart</div>
        </a>
        <a class="ames-tile rpt" href="rpt/equipment-oee">
            <div class="ames-tile-ic">⚙</div>
            <div class="ames-tile-h">EQUIPMENT OEE</div>
            <div class="ames-tile-sub">RPT-006 ·  30d ranking</div>
        </a>
        <a class="ames-tile rpt" href="rpt/on-time">
            <div class="ames-tile-ic">🚚</div>
            <div class="ames-tile-h">OTD TREND</div>
            <div class="ames-tile-sub">RPT-004 ·  daily on-time %</div>
        </a>
    </div>
</div>
