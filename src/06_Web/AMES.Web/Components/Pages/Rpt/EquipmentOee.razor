@page "/rpt/equipment-oee"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt
@inject AMES.Data.Repositories.MasterDataRepository Md
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-006 @L["RPT.EquipmentOee.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-006</div>
    <div class="ames-page-t">@L["RPT.EquipmentOee.Title"]</div>
    <div class="ames-page-sub">@L["RPT.EquipmentOee.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.EquipmentOee.Kpi.EquipCount"]</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">distinct units</div></div>
    <div class="ames-kpi @(_a >= 85 ? "ok" : _a >= 75 ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.EquipmentOee.Kpi.AvgA"]</div>
        <div class="ames-kpi-v">@_a.ToString("0.0")%</div>
        <div class="ames-kpi-s">availability</div></div>
    <div class="ames-kpi @(_p >= 85 ? "ok" : _p >= 75 ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.EquipmentOee.Kpi.AvgP"]</div>
        <div class="ames-kpi-v">@_p.ToString("0.0")%</div>
        <div class="ames-kpi-s">performance</div></div>
    <div class="ames-kpi @(_oee >= 85 ? "ok" : _oee >= 75 ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.EquipmentOee.Kpi.AvgOee"]</div>
        <div class="ames-kpi-v">@_oee.ToString("0.0")%</div>
        <div class="ames-kpi-s">overall</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.EquipmentOee.List"] · @_rows.Count @L["Lbl.Items"]@(_rows.Count < _allRows.Count ? $" / {L["Lbl.TotalOf"]} {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <select class="ames-input" style="width:140px;padding:4px 8px;" @bind="_fLine">
                <option value="">@L["Filter.AllLines"]</option>
                @foreach (var l in _lineList)
                {
                    <option value="@l.LineID">@l.LineID@(l.LineName != null ? $" {l.LineName}" : "")</option>
                }
            </select>
            <span class="dim" style="font-size:.82em;white-space:nowrap;">@L["Lbl.Period"]</span>
            <select class="ames-input" style="width:100px;padding:4px 8px;" @bind="_daysBack">
                <option value="7">7@(L["Lbl.Days"])</option>
                <option value="14">14@(L["Lbl.Days"])</option>
                <option value="30">30@(L["Lbl.Days"])</option>
                <option value="60">60@(L["Lbl.Days"])</option>
                <option value="90">90@(L["Lbl.Days"])</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["RPT.EquipmentOee.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["RPT.DefectPareto.Col.Rank"]</th><th>@L["Col.Equip"]</th><th>@L["Col.Line"]</th>
                    <th class="num">@L["Col.Availability"]</th><th class="num">@L["Col.Performance"]</th>
                    <th class="num">@L["Col.Quality"]</th><th class="num">@L["Col.OEE"]</th>
                    <th class="num">@L["RPT.EquipmentOee.Col.Days"]</th><th>@L["RPT.EquipmentOee.Col.Bar"]</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = _page * _pageSize; i < Math.Min(_rows.Count, (_page + 1) * _pageSize); i++)
                {
                    var r = _rows[i];
                    <tr>
                        <td class="code">#@(i + 1)</td>
                        <td>@(r.EquipId ?? "—")</td>
                        <td class="dim">@(r.LineId ?? "—")</td>
                        <td class="num">@r.AvgAvailability.ToString("0.0")</td>
                        <td class="num">@r.AvgPerformance.ToString("0.0")</td>
                        <td class="num">@r.AvgQuality.ToString("0.0")</td>
                        <td class="num">
                            <span class="pill @(r.AvgOee >= 85 ? "ok" : r.AvgOee >= 75 ? "warn" : "bad")">
                                @r.AvgOee.ToString("0.0")%
                            </span>
                        </td>
                        <td class="num dim">@r.Days</td>
                        <td>
                            <div style="background:rgba(147,197,253,.25);border:1px solid rgba(147,197,253,.5);
                                        height:14px;border-radius:4px;
                                        width:@(r.AvgOee.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="_page" Total="_rows.Count" PageSize="_pageSize" OnPageChange="p => _page = p" />
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.EquipmentOeeRow> _allRows = new();
    List<AMES.Data.Repositories.RptRepository.EquipmentOeeRow> _rows    = new();
    int _page = 0;
    const int _pageSize = 20;

    List<AMES.Data.Repositories.MasterDataRepository.LineRow> _lineList = new();
    int     _daysBack = 30;
    string  _fLine    = "";
    decimal _a, _p, _q, _oee;

    protected override void OnInitialized()
    {
        try { _lineList = Md.ListLines(); } catch { }
        Reload();
    }

    void Reload()
    {
        try { _allRows = Rpt.ListEquipmentOee(_daysBack); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _page = 0;
        _rows = string.IsNullOrEmpty(_fLine)
            ? _allRows
            : _allRows.Where(r => r.LineId == _fLine).ToList();
        if (_rows.Count > 0)
        {
            _a   = _rows.Average(r => r.AvgAvailability);
            _p   = _rows.Average(r => r.AvgPerformance);
            _q   = _rows.Average(r => r.AvgQuality);
            _oee = _rows.Average(r => r.AvgOee);
        }
        else { _a = _p = _q = _oee = 0m; }
    }
}
