@page "/rpt/equipment-oee"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt

<PageTitle>RPT-06 설비 OEE · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-06</div>
    <div class="ames-page-t">설비 OEE</div>
    <div class="ames-page-sub">설비별 가동률(A) · 성능률(P) · 품질률(Q) · OEE 집계</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">설비 수</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">distinct units</div></div>
    <div class="ames-kpi @(_a >= 85 ? "ok" : _a >= 75 ? "warn" : "bad")">
        <div class="ames-kpi-l">평균 A</div>
        <div class="ames-kpi-v">@_a.ToString("0.0")%</div>
        <div class="ames-kpi-s">availability</div></div>
    <div class="ames-kpi @(_p >= 85 ? "ok" : _p >= 75 ? "warn" : "bad")">
        <div class="ames-kpi-l">평균 P</div>
        <div class="ames-kpi-v">@_p.ToString("0.0")%</div>
        <div class="ames-kpi-s">performance</div></div>
    <div class="ames-kpi @(_oee >= 85 ? "ok" : _oee >= 75 ? "warn" : "bad")">
        <div class="ames-kpi-l">평균 OEE</div>
        <div class="ames-kpi-v">@_oee.ToString("0.0")%</div>
        <div class="ames-kpi-s">overall</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ 설비 순위 · @_rows.Count 건@(_rows.Count < _allRows.Count ? $" / 전체 {_allRows.Count}" : "")</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input class="ames-input" style="width:120px;padding:4px 8px;"
                   placeholder="라인 검색" @bind="_fLine" autocomplete="off" />
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">조회 기간</label>
            <select class="ames-input" style="width:80px;padding:4px 8px;" @bind="_daysBack">
                <option value="7">7일</option>
                <option value="14">14일</option>
                <option value="30">30일</option>
                <option value="60">60일</option>
                <option value="90">90일</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">조회</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">해당 기간에 OEE 데이터가 없습니다.</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>순위</th><th>설비</th><th>라인</th>
                    <th class="num">A%</th><th class="num">P%</th>
                    <th class="num">Q%</th><th class="num">OEE%</th>
                    <th class="num">일수</th><th>비율 바</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _rows.Count; i++)
                {
                    var r = _rows[i];
                    <tr>
                        <td class="code">#@(i + 1)</td>
                        <td>@(r.EquipId ?? "—")</td>
                        <td class="dim">@(r.LineId ?? "—")</td>
                        <td class="num">@r.AvgAvailability.ToString("0.0")</td>
                        <td class="num">@r.AvgPerformance.ToString("0.0")</td>
                        <td class="num">@r.AvgQuality.ToString("0.0")</td>
                        <td class="num">
                            <span class="pill @(r.AvgOee >= 85 ? "ok" : r.AvgOee >= 75 ? "warn" : "bad")">
                                @r.AvgOee.ToString("0.0")%
                            </span>
                        </td>
                        <td class="num dim">@r.Days</td>
                        <td>
                            <div style="background:rgba(147,197,253,.25);border:1px solid rgba(147,197,253,.5);
                                        height:14px;border-radius:4px;
                                        width:@(r.AvgOee.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.EquipmentOeeRow> _allRows = new();
    List<AMES.Data.Repositories.RptRepository.EquipmentOeeRow> _rows    = new();

    int     _daysBack = 30;
    string  _fLine    = "";
    decimal _a, _p, _q, _oee;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _allRows = Rpt.ListEquipmentOee(_daysBack); } catch { _allRows = new(); }
        ApplyFilter();
    }

    void ApplyFilter()
    {
        _rows = string.IsNullOrWhiteSpace(_fLine)
            ? _allRows
            : _allRows.Where(r => (r.LineId ?? "").Contains(_fLine, StringComparison.OrdinalIgnoreCase) ||
                                  (r.EquipId ?? "").Contains(_fLine, StringComparison.OrdinalIgnoreCase)).ToList();
        if (_rows.Count > 0)
        {
            _a   = _rows.Average(r => r.AvgAvailability);
            _p   = _rows.Average(r => r.AvgPerformance);
            _q   = _rows.Average(r => r.AvgQuality);
            _oee = _rows.Average(r => r.AvgOee);
        }
        else { _a = _p = _q = _oee = 0m; }
    }
}
