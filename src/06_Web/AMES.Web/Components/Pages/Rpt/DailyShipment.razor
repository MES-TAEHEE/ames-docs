@page "/rpt/daily-shipment"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using AMES.Data.Repositories
@using Radzen

@attribute [Authorize]

@inject RptRepository Rpt
@inject MasterDataRepository MD
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-003 @L["RPT.DailyShipment.Title"] · AMES</PageTitle>
<AmesPageHeader Code="RPT-003" TitleKey="RPT.DailyShipment.Title" />

@* ── KPI strip: 출하 수량 · 건수 · 정시율 · 지연 · 금액 ─────────────── *@
<div class="ames-kpis">
    <div class="ames-kpi ok">
        <div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.ShippedQty"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@ShippedQty.ToString("N0")</div>
            <div class="ames-kpi-s">@L["RPT.DailyShipment.Kpi.ShippedQtySub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.Shipments"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@_orders.Count</div>
            <div class="ames-kpi-s">@L["RPT.DailyShipment.Kpi.ShipmentsSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(OnTimeRate is null ? "" : OnTimeRate >= 98 ? "ok" : OnTimeRate >= 90 ? "warn" : "bad")">
        <div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.OnTime"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@(OnTimeRate is { } r ? $"{r:0.0}%" : "—")</div>
            <div class="ames-kpi-s">@L["RPT.DailyShipment.Kpi.OnTimeSub"]</div>
        </div>
    </div>
    <div class="ames-kpi @(LateCount > 0 ? "bad" : "ok")">
        <div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.Late"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@LateCount</div>
            <div class="ames-kpi-s">@L["RPT.DailyShipment.Kpi.LateSub"]</div>
        </div>
    </div>
    <div class="ames-kpi">
        <div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.Amount"]</div>
        <div class="ames-kpi-row">
            <div class="ames-kpi-v">@Amount.ToString("N0")</div>
            <div class="ames-kpi-s">@L["RPT.DailyShipment.Kpi.AmountSub"]</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_msg))
{
    <RadzenAlert AlertStyle="@(_isErr ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat">@_msg</RadzenAlert>
}

@* ── 조회 조건: 일자 · 고객사 · 운송사 · 조회 · 인쇄 · 내보내기 ──────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:0;">
        <span style="white-space:nowrap;">▼ @L["RPT.DailyShipment.Filter.Title"] <span class="dim" style="font-weight:400;font-size:.85em;margin-left:6px;">@FilterSummary</span></span>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="@L["Col.Date"]" Component="DatePickerDay" />
            <RadzenDatePicker TValue="DateTime" Name="DatePickerDay" @bind-Value="_fDate" DateFormat="@DateFmt.Date" InputSize="InputSize.Small" class="ames-rz-input" Style="width:140px;" />
            <RadzenLabel Text="@L["Col.Customer"]" Component="DropDownCustomer" />
            <RadzenDropDown AllowFiltering="true" Name="DropDownCustomer" @bind-Value="_fCustomer" Data="@CustomerFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:240px;" />
            <RadzenLabel Text="@L["Col.Carrier"]" Component="DropDownCarrier" />
            <RadzenDropDown Name="DropDownCarrier" @bind-Value="_fCarrier" Data="@CarrierFilterOptions" TextProperty="Text" ValueProperty="Value" Placeholder="@L["Filter.All"]" AllowClear="true" InputSize="InputSize.Small" class="ames-rz-input" Style="width:130px;" />

            <RadzenButton Text="@L["Btn.Search"]" Icon="search" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@Reload" class="ames-rz-btn" />
            <RadzenButton Text="@L["RPT.DailyShipment.Btn.Print"]" Icon="print" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@Print" class="ames-rz-btn" />
            <RadzenButton Text="@L["RPT.DailyShipment.Btn.Export"]" Icon="download" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@ExportXlsx" class="ames-rz-btn" />
        </RadzenStack>
    </div>
</div>

@* ── 고객사별 출하 (누적 막대) + 운송사별 요약 ─────────────────────── *@
<div class="rpt-sh-grid2">
    <div class="ames-card">
        <div class="ames-card-h">▼ @L["RPT.DailyShipment.ByCustomer.Title"]</div>
        @if (_byCust.Count == 0)
        {
            <div class="mnt-db-empty">@L["RPT.DailyShipment.Empty"]</div>
        }
        else
        {
            @foreach (var c in _byCust)
            {
                var tot = Math.Max(1, c.OnTime + c.Late + c.Pending);
                <div class="rpt-sh-cust">
                    <div class="h">
                        <span>@CustomerText(c.Code)</span>
                        <span class="v">@string.Format(L["RPT.DailyShipment.ByCustomer.Fmt"].Value, c.Qty.ToString("N0"), c.OnTime + c.Late + c.Pending)</span>
                    </div>
                    <div class="rpt-sh-stack">
                        <i class="on" style="width:@(100.0 * c.OnTime / tot)%"></i><i class="lt" style="width:@(100.0 * c.Late / tot)%"></i><i class="pd" style="width:@(100.0 * c.Pending / tot)%"></i>
                    </div>
                    <div class="rpt-sh-legend">
                        <span><b style="background:#10b981;"></b>@L["RPT.DailyShipment.Legend.OnTime"] @c.OnTime</span>
                        <span><b style="background:#dc2626;"></b>@L["RPT.DailyShipment.Legend.Late"] @c.Late</span>
                        <span><b style="background:#f59e0b;"></b>@L["RPT.DailyShipment.Legend.Pending"] @c.Pending</span>
                    </div>
                </div>
            }
        }
    </div>

    <div class="ames-card">
        <div class="ames-card-h">▼ @L["RPT.DailyShipment.ByCarrier.Title"]</div>
        @if (_byCarrier.Count == 0)
        {
            <div class="mnt-db-empty">@L["RPT.DailyShipment.Empty"]</div>
        }
        else
        {
            <div class="rpt-sh-rounds">
                @foreach (var cr in _byCarrier)
                {
                    <div class="rpt-sh-round">
                        <div class="t">@cr.Code</div>
                        <div class="v">@cr.Qty.ToString("N0")</div>
                        <div class="s">@string.Format(L["RPT.DailyShipment.ByCarrier.Fmt"].Value, cr.Shipped, cr.Total)</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ── 출하 상세 (라인 단위) ─────────────────────────────────────────── *@
<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.DailyShipment.Detail.Title"] — <span style="color:#34d399;">@string.Format(L["RPT.DailyShipment.Records"].Value, _rows.Count)</span></span>
    </div>

    <RadzenDataGrid TItem="ShipLine" Data="@_rows" AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center" AllowSorting="true"
                    PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="@_showPagerSummary" EmptyText="@L["RPT.DailyShipment.Empty"]" Class="ames-rz-grid rpt-dp-grid">
        <Columns>
            <RadzenDataGridColumn TItem="ShipLine" Property="ShipNo" Title="@L["RPT.DailyShipment.Col.ShipNo"]" Width="140px">
                <Template Context="r"><span class="code">@r.ShipNo</span></Template>
                <FooterTemplate><b>@L["RPT.DailyShipment.Total"]</b></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShipLine" Property="CustomerCode" Title="@L["Col.Customer"]" Width="170px">
                <Template Context="r"><span class="code">@r.CustomerCode</span><span class="dim" style="font-size:.85em;margin-left:6px;">@CustomerName(r.CustomerCode)</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShipLine" Property="Carrier" Title="@L["Col.Carrier"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="dim">@(r.Carrier ?? "—")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShipLine" Property="ItemName" Title="@L["Col.Item"]">
                <Template Context="r"><span style="white-space:nowrap;">@r.ItemName</span>@if (!string.IsNullOrEmpty(r.ItemNo)) { <span class="dim code" style="font-size:.85em;margin-left:6px;">@r.ItemNo</span> }</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShipLine" Property="Qty" Title="@L["Col.Qty"]" TextAlign="TextAlign.Right" Width="90px">
                <Template Context="r"><b class="code">@r.Qty.ToString("N0")</b></Template>
                <FooterTemplate><span class="code">@_rows.Sum(x => x.Qty).ToString("N0")</span></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShipLine" Property="ShipTime" Title="@L["RPT.DailyShipment.Col.ShipTime"]" TextAlign="TextAlign.Center" Width="190px">
                <Template Context="r">
                    <span class="code">@(r.ShipTime?.ToString("HH:mm") ?? "—")</span>
                    @if (r.State == "late") { <span style="color:#f87171;font-size:.8em;margin-left:4px;">@string.Format(L["RPT.DailyShipment.Col.PlanFmt"].Value, r.PlanDate?.ToString("MM-dd") ?? "—")</span> }
                </Template>
                <FooterTemplate><b>@string.Format(L["RPT.DailyShipment.Completed"].Value, _orders.Count(o => o.Shipped))</b></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShipLine" Property="Vehicle" Title="@L["RPT.DailyShipment.Col.Vehicle"]" TextAlign="TextAlign.Center" Width="110px">
                <Template Context="r"><span class="code dim">@(r.Vehicle ?? (r.State == "pending" ? L["RPT.DailyShipment.Legend.Pending"].Value : "—"))</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShipLine" Property="State" Title="@L["Col.Status"]" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="r"><span class="pill @StateCls(r.State)">@StateLabel(r.State)</span></Template>
                <FooterTemplate><span class="code">@Amount.ToString("N0")</span></FooterTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    IEnumerable<int> _pageSizeOptions = new int[] { 15, 30, 50, 100 };
    bool _showPagerSummary = true;

    List<RptRepository.ShipmentDetailRow>   _raw       = new();
    List<ShipLine>                          _rows      = new();
    List<OrderAgg>                          _orders    = new();
    List<CustAgg>                           _byCust    = new();
    List<CarrierAgg>                        _byCarrier = new();
    List<MasterDataRepository.CustomerRow>  _customers = new();

    DateTime _fDate = DateTime.Today;
    string?  _fCustomer, _fCarrier;
    string   _msg = "";
    bool     _isErr;

    public class DropDownItem { public string Text { get; set; } = ""; public string Value { get; set; } = ""; }
    public sealed class ShipLine
    {
        public int OrderId; public string ShipNo = ""; public string CustomerCode = ""; public string? Carrier;
        public string? ItemNo; public string ItemName = ""; public decimal Qty; public decimal Amount;
        public DateTime? ShipTime; public DateTime? PlanDate; public string? Vehicle; public string State = "pending";
    }
    public sealed record OrderAgg(int OrderId, string CustomerCode, string? Carrier, string State, decimal Qty) { public bool Shipped => State != "pending"; }
    public sealed record CustAgg(string Code, decimal Qty, int OnTime, int Late, int Pending);
    public sealed record CarrierAgg(string Code, decimal Qty, int Shipped, int Total);

    IEnumerable<DropDownItem> CustomerFilterOptions => _customers
        .Where(c => !string.IsNullOrEmpty(c.CustomerCode))
        .Select(c => new DropDownItem { Value = c.CustomerCode!, Text = $"[{c.CustomerCode}] {MasterDataRepository.LocalName(c.CustomerName, c.CustomerNameEn)}".TrimEnd() });
    IEnumerable<DropDownItem> CarrierFilterOptions => _raw.Select(r => r.CarrierCode).Where(c => !string.IsNullOrEmpty(c)).Distinct().OrderBy(c => c).Select(c => new DropDownItem { Value = c!, Text = c! });

    // ── KPI (오더 단위 상태, 라인 단위 수량) ───────────────────────────
    decimal  ShippedQty => _rows.Where(r => r.State != "pending").Sum(r => r.Qty);
    int      LateCount  => _orders.Count(o => o.State == "late");
    decimal? OnTimeRate => _orders.Count(o => o.Shipped) is var n && n > 0 ? 100m * _orders.Count(o => o.State == "ontime") / n : null;
    decimal  Amount     => _rows.Sum(r => r.Amount);

    string FilterSummary =>
        $"{_fDate.ToString(DateFmt.Date)} · {(_fCustomer is null ? L["Filter.All"].Value : CustomerText(_fCustomer))} · {(_fCarrier ?? L["Filter.All"].Value)}";

    protected override void OnInitialized()
    {
        try { _customers = MD.ListCustomers(); } catch { }

        // 기본 일자: 오늘. 오늘 출하가 없으면 마지막 출하 예정일
        try
        {
            var (_, mx) = Rpt.ShipmentDateExtent();
            if (mx is { } m && m.Date < DateTime.Today) _fDate = m.Date;
        }
        catch { }

        Reload();
    }

    void Reload()
    {
        try { _raw = Rpt.ListShipmentDetail(_fDate, _fCustomer); }
        catch (Exception ex) { _raw = new(); ShowMsg(ex.Message, true); }
        Rebuild();
    }

    void Rebuild()
    {
        var rows = _raw.Where(r => string.IsNullOrEmpty(_fCarrier) || r.CarrierCode == _fCarrier).ToList();

        // 라인 → 화면 행. 수량은 배정수량(AllocatedQty)이 있으면 그 값, 없으면 주문수량
        _rows = rows.Select(r =>
        {
            var qty   = r.AllocatedQty > 0 ? r.AllocatedQty : r.OrderedQty;
            var state = StateOf(r);
            var nm    = MasterDataRepository.LocalName(r.ItemName, r.ItemNameEn);
            return new ShipLine
            {
                OrderId = r.ShipmentOrderId, ShipNo = r.ShipOrderNumber ?? $"#{r.ShipmentOrderId}", CustomerCode = r.CustomerCode ?? "—",
                Carrier = r.CarrierCode, ItemNo = r.ItemNo,
                ItemName = string.IsNullOrEmpty(nm) ? (r.ItemNo ?? L["RPT.DailyShipment.Item.Unknown"].Value) : nm,
                Qty = qty, Amount = qty * (r.UnitCost ?? 0m),
                ShipTime = ShipTimeOf(r), PlanDate = r.ShipDate, Vehicle = r.LicensePlate, State = state,
            };
        }).OrderBy(x => x.ShipNo).ToList();

        _orders = _rows.GroupBy(x => x.OrderId)
            .Select(g => new OrderAgg(g.Key, g.First().CustomerCode, g.First().Carrier, g.First().State, g.Sum(x => x.Qty))).ToList();

        _byCust = _orders.GroupBy(o => o.CustomerCode)
            .Select(g => new CustAgg(g.Key, g.Sum(o => o.Qty), g.Count(o => o.State == "ontime"), g.Count(o => o.State == "late"), g.Count(o => o.State == "pending")))
            .OrderByDescending(c => c.Qty).ToList();

        _byCarrier = _orders.GroupBy(o => o.Carrier ?? "—")
            .Select(g => new CarrierAgg(g.Key, g.Sum(o => o.Qty), g.Count(o => o.Shipped), g.Count()))
            .OrderBy(c => c.Code).ToList();
    }

    // ── 출하 상태 판정: 출하 완료(Shipped/Loaded 또는 상차 출발 기록) → 정시/지연, 그 외 대기 ──
    static DateTime? ShipTimeOf(RptRepository.ShipmentDetailRow r) => r.DepartureTs ?? r.LoadConfirmedAt ?? r.OrderConfirmedAt;
    static bool IsShipped(RptRepository.ShipmentDetailRow r) =>
        (r.Status ?? "").ToUpperInvariant() is "SHIPPED" or "LOADED" or "CLOSED" || r.DepartureTs is { };
    static string StateOf(RptRepository.ShipmentDetailRow r)
    {
        if (!IsShipped(r)) return "pending";
        var flag = (r.LoadOtd ?? r.OtdFlag ?? "").ToUpperInvariant();
        if (flag == "LATE") return "late";
        if (flag == "ONTIME") return "ontime";
        return ShipTimeOf(r) is { } t && r.ShipDate is { } p && t.Date > p.Date ? "late" : "ontime";
    }

    // ── 표시 헬퍼 ─────────────────────────────────────────────────────
    string CustomerName(string code) =>
        _customers.FirstOrDefault(c => c.CustomerCode == code || c.CustomerID == code) is { } c ? MasterDataRepository.LocalName(c.CustomerName, c.CustomerNameEn) : "";
    string CustomerText(string code) => CustomerName(code) is { Length: > 0 } nm ? $"{code} ({nm})" : code;

    string StateLabel(string s) => s switch
    {
        "ontime" => L["RPT.DailyShipment.Legend.OnTime"].Value,
        "late"   => L["RPT.DailyShipment.Legend.Late"].Value,
        _        => L["RPT.DailyShipment.Legend.Pending"].Value,
    };
    static string StateCls(string s) => s switch { "ontime" => "ok", "late" => "bad", _ => "warn" };

    async Task Print()
    {
        try { await JS.InvokeVoidAsync("print"); } catch { }
    }

    // 상세 표(필터 적용분)를 .xlsx 로 내려받는다 — 화면 컬럼 순서 그대로 + 합계 행
    async Task ExportXlsx()
    {
        if (_rows.Count == 0) { ShowMsg(L["RPT.DailyShipment.Err.NoExport"], true); return; }
        var headers = new[]
        {
            L["RPT.DailyShipment.Col.ShipNo"].Value, L["Col.Customer"].Value, L["Col.CustomerName"].Value, L["Col.Carrier"].Value,
            L["Col.Item"].Value, L["Col.ItemName"].Value, L["Col.Qty"].Value, L["RPT.DailyShipment.Col.ShipTime"].Value,
            L["Col.Date"].Value, L["RPT.DailyShipment.Col.Vehicle"].Value, L["Col.Status"].Value, L["RPT.DailyShipment.Kpi.Amount"].Value,
        };
        var data = _rows.Select(r => (IReadOnlyList<object?>)new object?[]
        {
            r.ShipNo, r.CustomerCode, CustomerName(r.CustomerCode), r.Carrier,
            r.ItemNo, r.ItemName, r.Qty, r.ShipTime?.ToString(DateFmt.DateTime),
            r.PlanDate?.ToString(DateFmt.Date), r.Vehicle, StateLabel(r.State), r.Amount,
        }).Append(new object?[]
        {
            L["RPT.DailyShipment.Total"].Value, null, null, null, null, null, _rows.Sum(x => x.Qty),
            string.Format(L["RPT.DailyShipment.Completed"].Value, _orders.Count(o => o.Shipped)), null, null, null, Amount,
        });
        var bytes = AMES.Web.Services.XlsxWriter.Build($"{L["RPT.DailyShipment.Title"].Value} {_fDate:yyyy-MM-dd}", headers, data);
        var name  = $"DailyShipment_{_fDate:yyyyMMdd}_{DateTime.Now:HHmmss}.xlsx";
        await JS.InvokeVoidAsync("amesDownload", name, Convert.ToBase64String(bytes),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        ShowMsg(string.Format(L["RPT.DailyShipment.Ok.Exported"].Value, _rows.Count), false);
    }

    void ShowMsg(string msg, bool isErr)
    {
        _msg = msg; _isErr = isErr;
        _ = Task.Delay(4000).ContinueWith(_ => { _msg = ""; InvokeAsync(StateHasChanged); });
    }
}
