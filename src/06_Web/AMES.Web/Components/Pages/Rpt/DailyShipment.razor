@page "/rpt/daily-shipment"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AMES.Data.Repositories.RptRepository Rpt
@inject IStringLocalizer<SharedResources> L

<PageTitle>RPT-03 @L["RPT.DailyShipment.Title"] · AMES</PageTitle>

<div class="ames-page-h">
    <div class="ames-page-id">RPT-03</div>
    <div class="ames-page-t">@L["RPT.DailyShipment.Title"]</div>
    <div class="ames-page-sub">@L["RPT.DailyShipment.Sub"]</div>
</div>

<div class="ames-kpis">
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.Days"]</div>
        <div class="ames-kpi-v">@_rows.Count</div><div class="ames-kpi-s">distinct ship days</div></div>
    <div class="ames-kpi ok"><div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.Orders"]</div>
        <div class="ames-kpi-v">@_orders.ToString("N0")</div><div class="ames-kpi-s">shipment orders</div></div>
    <div class="ames-kpi"><div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.OrderQty"]</div>
        <div class="ames-kpi-v">@_ord.ToString("N0")</div><div class="ames-kpi-s">total ordered</div></div>
    <div class="ames-kpi warn"><div class="ames-kpi-l">@L["RPT.DailyShipment.Kpi.AllocQty"]</div>
        <div class="ames-kpi-v">@_alloc.ToString("N0")</div><div class="ames-kpi-s">total allocated</div></div>
</div>

<div class="ames-card">
    <div class="ames-card-h" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
        <span style="white-space:nowrap;">▼ @L["RPT.DailyShipment.List"] · @_rows.Count @L["Lbl.Items"]</span>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <label style="font-size:.85rem;color:#64748b;white-space:nowrap;">@L["Lbl.Period"]</label>
            <select class="ames-input" style="width:80px;padding:4px 8px;" @bind="_daysBack">
                <option value="7">7@L["Lbl.Days"]</option>
                <option value="14">14@L["Lbl.Days"]</option>
                <option value="30">30@L["Lbl.Days"]</option>
                <option value="60">60@L["Lbl.Days"]</option>
                <option value="90">90@L["Lbl.Days"]</option>
            </select>
            <button class="ames-btn ok" @onclick="Reload">@L["Btn.Reload"]</button>
        </div>
    </div>

    @if (_rows.Count == 0)
    {
        <div class="ames-empty">@L["RPT.DailyShipment.Empty"]</div>
    }
    else
    {
        <table class="ames-table">
            <thead>
                <tr>
                    <th>@L["Col.Date"]</th><th class="num">@L["RPT.DailyShipment.Col.Orders"]</th>
                    <th class="num">@L["RPT.DailyShipment.Col.OrderQty"]</th><th class="num">@L["RPT.DailyShipment.Col.AllocQty"]</th>
                    <th class="num">@L["RPT.DailyShipment.Col.FillRate"]</th><th class="num">@L["RPT.DailyShipment.Col.Customers"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    var fill = r.OrderedQty > 0 ? r.AllocatedQty / r.OrderedQty * 100m : 0m;
                    <tr>
                        <td class="dim">@r.Day.ToString("MM-dd (ddd)")</td>
                        <td class="num">@r.Orders</td>
                        <td class="num">@r.OrderedQty.ToString("N0")</td>
                        <td class="num">@r.AllocatedQty.ToString("N0")</td>
                        <td class="num">
                            <span class="pill @(fill >= 100m ? "ok" : fill >= 90m ? "warn" : "bad")">
                                @fill.ToString("0.0")%
                            </span>
                        </td>
                        <td class="num">@r.CustomerCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<AMES.Data.Repositories.RptRepository.DailyShipmentRow> _rows = new();

    int     _daysBack = 14;
    long    _orders;
    decimal _ord, _alloc;

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        try { _rows = Rpt.ListDailyShipment(_daysBack); } catch { _rows = new(); }
        _orders = _rows.Sum(r => (long)r.Orders);
        _ord    = _rows.Sum(r => r.OrderedQty);
        _alloc  = _rows.Sum(r => r.AllocatedQty);
    }
}
