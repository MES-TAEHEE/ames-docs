<?xml version="1.0" encoding="utf-8"?>
<!-- IIS 배포용 Publish Profile
     대상: C:\inetpub\ames-web
     방식: Framework-Dependent (ASP.NET Core 9 Hosting Bundle 필요)
     실행: dotnet publish -p:PublishProfile=IIS -->
<Project>
  <PropertyGroup>
    <PublishProvider>FileSystem</PublishProvider>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishUrl>C:\inetpub\ames-web</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>x64</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <EnvironmentName>Production</EnvironmentName>
    <ProjectGuid>e9de5683-cc2e-4d38-bf39-c7ade4d98076</ProjectGuid>
  </PropertyGroup>
</Project>
