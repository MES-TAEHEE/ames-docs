<Project>

  <!-- 솔루션 전체 공통 빌드 설정 (각 프로젝트가 상위로 올라오며 자동 임포트) -->
  <PropertyGroup>
    <!--
      NU1900: NuGet 취약성 감사(NuGetAudit)가 취약성 데이터(api.nuget.org)를
      가져오지 못할 때 발생하는 복원 경고. 네트워크/방화벽 제약 환경에서 발생하며
      실제 취약성 탐지 결과(NU1901~NU1904)와는 무관하므로 억제한다.
      (온라인이면 감사는 그대로 동작한다.)
    -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

</Project>
